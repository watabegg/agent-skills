{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.herdr.dev/herdr-dev-loop/review-group-state.schema.json",
  "title": "Herdr Dev Loop Review Group State",
  "type": "object",
  "required": [
    "status",
    "gate_status",
    "mode",
    "review_plan",
    "review_providers",
    "head_sha",
    "review_path"
  ],
  "properties": {
    "status": {"type": "string"},
    "gate_status": {"type": "string"},
    "mode": {"enum": ["single", "swarm", "dual", "dual-swarm"]},
    "head_sha": {"type": "string", "minLength": 1},
    "review_plan": {
      "type": "object",
      "required": ["mode", "head_sha", "providers", "budget"]
    },
    "review_providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["codex", "claude"]}
    },
    "review_path": {"type": "string", "minLength": 1},
    "manifest_path": {"type": "string", "minLength": 1},
    "provider_report_paths": {
      "type": "object",
      "propertyNames": {"enum": ["codex", "claude"]},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "provider_artifact_statuses": {
      "type": "object",
      "propertyNames": {"enum": ["codex", "claude"]},
      "additionalProperties": {"enum": ["reported", "blocked", "failed"]}
    },
    "manifest_complete": {"type": "boolean"},
    "manifest_issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "confirmed_finding_fingerprints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "single"}}},
      "then": {"properties": {"review_providers": {"maxItems": 1}}}
    },
    {
      "if": {
        "properties": {
          "mode": {"enum": ["swarm", "dual", "dual-swarm"]},
          "gate_status": {"enum": ["reported", "triaged"]}
        }
      },
      "then": {
        "required": [
          "manifest_path",
          "provider_report_paths",
          "provider_artifact_statuses",
          "manifest_complete",
          "manifest_issues",
          "confirmed_finding_fingerprints"
        ]
      }
    }
  ],
  "additionalProperties": true
}
