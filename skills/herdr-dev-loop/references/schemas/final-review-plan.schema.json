{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr Dev Loop Manual Final Review Plan",
  "type": "object",
  "required": [
    "certification_id",
    "base_sha",
    "target_sha",
    "scope_revision",
    "source_snapshot_revision",
    "source_digest",
    "execution_kind",
    "protocol_key",
    "protocol",
    "execution",
    "process_plan",
    "final_coordinator_config",
    "lane_plan",
    "verification_policy"
  ],
  "properties": {
    "certification_id": {"type": "string", "minLength": 1},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "base_ref": {"type": "string"},
    "base_sha": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string"},
    "target_sha": {"type": "string", "minLength": 1},
    "scope_source": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "scope_revision": {"type": "integer", "minimum": 0},
    "source_snapshot_revision": {"type": "integer", "minimum": 0},
    "source_digest": {"$ref": "#/$defs/digest"},
    "execution_kind": {"const": "manual-final"},
    "protocol_key": {"const": "review.manual_final_protocol"},
    "protocol": {"const": "codex-review-multi-v2"},
    "execution": {"$ref": "#/$defs/execution"},
    "process_plan": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/processPlan"}
    },
    "final_coordinator_config": {"$ref": "#/$defs/coordinatorConfig"},
    "lane_plan": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/lane"}
    },
    "verification_policy": {"$ref": "#/$defs/verificationPolicy"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$"
    },
    "agentIdentityValues": {
      "type": "object",
      "required": ["provider", "model", "effort"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "agentIdentity": {
      "type": "object",
      "required": ["requested", "observed", "attested", "status", "verified", "issues"],
      "properties": {
        "requested": {"$ref": "#/$defs/agentIdentityValues"},
        "observed": {"$ref": "#/$defs/agentIdentityValues"},
        "attested": {"$ref": "#/$defs/agentIdentityValues"},
        "status": {"enum": ["attested", "requested-only", "unavailable", "mismatch"]},
        "verified": {"type": "boolean"},
        "issues": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "processPlan": {
      "type": "object",
      "required": [
        "process_id",
        "process_kind",
        "agent_label",
        "provider",
        "model",
        "effort",
        "config_sources",
        "config_provenance",
        "agent_identity",
        "attestation_required"
      ],
      "properties": {
        "process_id": {"type": "string", "minLength": 1},
        "process_kind": {"enum": ["coordinator", "discovery", "verifier"]},
        "agent_label": {"type": "string", "minLength": 1},
        "provider": {"enum": ["codex", "claude"]},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "config_sources": {"$ref": "#/$defs/configSources"},
        "config_provenance": {"$ref": "#/$defs/configProvenance"},
        "agent_identity": {"$ref": "#/$defs/agentIdentity"},
        "attestation_required": {"const": true}
      },
      "additionalProperties": false
    },
    "configSources": {
      "type": "object",
      "required": ["provider", "model", "effort"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "configProvenance": {
      "type": "object",
      "required": ["provider", "model", "effort"],
      "properties": {
        "provider": {"type": "array", "items": {"type": "object"}},
        "model": {"type": "array", "items": {"type": "object"}},
        "effort": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "coordinatorConfig": {
      "type": "object",
      "required": ["provider", "model", "effort", "sources", "provenance"],
      "properties": {
        "provider": {"enum": ["codex", "claude"]},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "sources": {"type": "object"},
        "provenance": {"type": "object"}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "execution_policy",
        "execution_id",
        "source_kind",
        "source_execution_id",
        "source_artifact_ref",
        "source_artifact_digest",
        "target_sha",
        "protocol_adapter"
      ],
      "properties": {
        "execution_policy": {"enum": ["independent", "reuse_epoch_reviewer"]},
        "execution_id": {"type": "string", "pattern": "^R[0-9]{3}$"},
        "source_kind": {"enum": ["pre-final-review", "review-epoch-reviewer"]},
        "source_execution_id": {"type": "string", "pattern": "^R[0-9]{3}$"},
        "source_artifact_ref": {"type": "string", "minLength": 1},
        "source_artifact_digest": {"$ref": "#/$defs/digest"},
        "target_sha": {"type": "string", "minLength": 1},
        "protocol_adapter": {"$ref": "#/$defs/protocolAdapter"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"execution_policy": {"const": "independent"}},
            "required": ["execution_policy"]
          },
          "then": {
            "properties": {"source_kind": {"const": "pre-final-review"}}
          }
        },
        {
          "if": {
            "properties": {"execution_policy": {"const": "reuse_epoch_reviewer"}},
            "required": ["execution_policy"]
          },
          "then": {
            "properties": {"source_kind": {"const": "review-epoch-reviewer"}}
          }
        }
      ],
      "additionalProperties": false
    },
    "protocolAdapter": {
      "type": "object",
      "required": [
        "record_type",
        "protocol",
        "source",
        "version",
        "content_digest",
        "capabilities"
      ],
      "properties": {
        "record_type": {"const": "external_review_protocol_adapter"},
        "protocol": {"const": "codex-review-multi-v2"},
        "source": {"type": "string", "minLength": 1},
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "content_digest": {"$ref": "#/$defs/digest"},
        "capabilities": {
          "type": "array",
          "contains": {"const": "externally-planned-v1"},
          "minContains": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "lane": {
      "type": "object",
      "required": ["provider", "lane_id", "purpose", "agent_label"],
      "properties": {
        "provider": {"enum": ["codex", "claude"]},
        "lane_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "agent_label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "verificationPolicy": {
      "type": "object",
      "required": [
        "required_passes",
        "critical_passes",
        "critical_severities",
        "require_independent",
        "require_cross_provider_for_critical",
        "max_parallel_verifiers",
        "max_verifications",
        "time_limit_seconds",
        "provider_limits"
      ],
      "properties": {
        "required_passes": {"type": "integer", "minimum": 1, "maximum": 2},
        "critical_passes": {"type": "integer", "minimum": 1, "maximum": 2},
        "critical_severities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["P0", "P1", "P2", "P3"]}
        },
        "require_independent": {"type": "boolean"},
        "require_cross_provider_for_critical": {"type": "boolean"},
        "max_parallel_verifiers": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_verifications": {"type": "integer", "minimum": 1},
        "time_limit_seconds": {"type": "integer", "minimum": 1},
        "provider_limits": {
          "type": "object",
          "propertyNames": {"enum": ["codex", "claude"]},
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": false
    }
  }
}
