{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr Dev Loop Manual Final Review Manifest",
  "type": "object",
  "required": [
    "review_id",
    "mode",
    "head_sha",
    "budget",
    "providers",
    "findings",
    "verification",
    "completeness",
    "certification_id",
    "prepared_plan_digest",
    "base_sha",
    "target_sha",
    "scope_revision",
    "source_snapshot_revision",
    "source_digest",
    "execution_kind",
    "protocol_key",
    "protocol",
    "execution",
    "process_identities",
    "final_coordinator_config",
    "manifest_complete",
    "verified_actionable_findings",
    "patch_verdict"
  ],
  "properties": {
    "review_id": {"type": "string", "pattern": "^R[0-9]{3}$"},
    "mode": {"enum": ["single", "swarm", "dual", "dual-swarm"]},
    "head_sha": {"type": "string", "minLength": 1},
    "budget": {"$ref": "review-manifest.schema.json#/$defs/budget"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "review-manifest.schema.json#/$defs/provider"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "review-finding.schema.json"}
    },
    "verification": {"$ref": "review-manifest.schema.json#/$defs/verification"},
    "completeness": {"$ref": "review-manifest.schema.json#/$defs/completeness"},
    "certification_id": {"type": "string", "minLength": 1},
    "prepared_plan_digest": {"$ref": "#/$defs/digest"},
    "base_sha": {"type": "string", "minLength": 1},
    "target_sha": {"type": "string", "minLength": 1},
    "scope_revision": {"type": "integer", "minimum": 0},
    "source_snapshot_revision": {"type": "integer", "minimum": 0},
    "source_digest": {"$ref": "#/$defs/digest"},
    "execution_kind": {"const": "manual-final"},
    "protocol_key": {"const": "review.manual_final_protocol"},
    "protocol": {"const": "codex-review-multi-v2"},
    "execution": {"$ref": "final-review-plan.schema.json#/$defs/execution"},
    "process_identities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/processIdentity"}
    },
    "final_coordinator_config": {
      "$ref": "final-review-plan.schema.json#/$defs/coordinatorConfig"
    },
    "manifest_complete": {"type": "boolean"},
    "verified_actionable_findings": {"type": "integer", "minimum": 0},
    "patch_verdict": {"enum": ["passed", "failed", "incomplete"]}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"enum": ["single", "swarm"]}}},
      "then": {"properties": {"providers": {"minItems": 1, "maxItems": 1}}}
    },
    {
      "if": {"properties": {"mode": {"enum": ["dual", "dual-swarm"]}}},
      "then": {"properties": {"providers": {"minItems": 2, "maxItems": 2}}}
    },
    {
      "if": {"properties": {"mode": {"enum": ["single", "dual"]}}},
      "then": {
        "properties": {
          "providers": {
            "items": {
              "properties": {
                "required_lanes": {"minItems": 1, "maxItems": 1}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"mode": {"enum": ["swarm", "dual-swarm"]}}},
      "then": {
        "properties": {
          "providers": {
            "items": {
              "properties": {
                "required_lanes": {"minItems": 4, "maxItems": 8}
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$"
    },
    "processIdentity": {
      "type": "object",
      "required": ["process_id", "agent_identity"],
      "properties": {
        "process_id": {"type": "string", "minLength": 1},
        "agent_identity": {
          "$ref": "final-review-plan.schema.json#/$defs/agentIdentity"
        }
      },
      "additionalProperties": false
    }
  }
}
