{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr Dev Loop State",
  "type": "object",
  "required": [
    "state_format_version",
    "schema_revision",
    "goal_id",
    "run_id",
    "skill_version",
    "namespace",
    "loop_path",
    "persistence",
    "worktree_setup_commands",
    "worker_setup_commands",
    "reviewer_setup_commands",
    "gap_setup_commands",
    "advisor_setup_commands",
    "phase",
    "base_branch",
    "integration_branch",
    "worktree_root",
    "branch_strategy",
    "worker_qa_profile",
    "manager_qa_profile",
    "manager_qa_status",
    "worker_protocol",
    "review_protocol",
    "worker_agent_provider",
    "worker_agent_model",
    "worker_agent_effort",
    "worker_claude_permission_mode",
    "reviewer_agent_provider",
    "reviewer_agent_model",
    "reviewer_agent_effort",
    "reviewer_claude_permission_mode",
    "gap_agent_provider",
    "gap_agent_model",
    "gap_agent_effort",
    "gap_claude_permission_mode",
    "review_lanes",
    "cycle",
    "max_workers",
    "max_reviewers",
    "max_gap_auditors",
    "tasks",
    "batches",
    "reviews",
    "gaps",
    "advice",
    "decisions"
  ],
  "$defs": {
    "specialVerificationRecord": {
      "type": "object",
      "required": ["target_sha", "status", "references"],
      "properties": {
        "target_sha": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["passed", "verified", "failed", "blocked"]},
        "references": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "recorded_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "batchPerformanceRecord": {
      "type": "object",
      "properties": {
        "batch_id": {"type": "string"},
        "worker_count": {"type": "integer", "minimum": 0},
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "phase_wall_time_seconds": {"type": "number", "minimum": 0},
        "worker_runtime_seconds": {"type": "number", "minimum": 0},
        "worker_runtime_total_seconds": {"type": "number", "minimum": 0},
        "effective_parallelism": {"type": ["number", "null"], "minimum": 0},
        "longest_worker_seconds": {"type": "number", "minimum": 0},
        "validation_time_seconds": {"type": "number", "minimum": 0},
        "review_wait_time_seconds": {"type": "number", "minimum": 0},
        "warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "replan_required": {"type": "boolean"},
        "conflict_graph_digest": {"type": "string"}
      },
      "additionalProperties": true
    },
    "writeScopeConflictGraph": {
      "type": "object",
      "required": ["version", "task_ids", "nodes", "edges", "conflicts", "digest", "generated_at"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "batch_id": {"type": "string"},
        "task_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "nodes": {"type": "object", "additionalProperties": {"type": "object"}},
        "edges": {"type": "array", "items": {"type": "object"}},
        "conflicts": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "digest": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "acceptedRiskAuthorization": {
      "type": "object",
      "required": [
        "decision_id",
        "status",
        "finding_fingerprint",
        "target_sha",
        "authorized_by",
        "risk",
        "reason"
      ],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^D[0-9]{3}$"},
        "status": {"const": "accepted"},
        "finding_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "target_sha": {"type": "string", "minLength": 1},
        "authorized_by": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string"},
        "reconsider_condition": {"type": "string"}
      },
      "anyOf": [
        {
          "required": ["expires_at"],
          "properties": {"expires_at": {"type": "string", "minLength": 1}}
        },
        {
          "required": ["reconsider_condition"],
          "properties": {
            "reconsider_condition": {"type": "string", "minLength": 1}
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "state_format_version": {"const": 3},
    "schema_revision": {"type": "integer", "minimum": 1},
    "goal_id": {"type": "string"},
    "run_id": {"type": "string"},
    "skill_version": {"type": "string"},
    "namespace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "loop_path": {"type": "string", "pattern": "^\\.ai/herdr-dev-loop/loops/"},
    "persistence": {"type": "string", "enum": ["local-only", "branch-history"]},
    "config_source": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": {"type": "string"},
        "path": {"type": "string"}
      },
      "additionalProperties": false
    },
    "resolved_config": {"type": "object"},
    "release_scope": {
      "type": "object",
      "required": [
        "status",
        "locked_at",
        "source_refs",
        "source_digests",
        "scope_revision",
        "source_snapshot_revision",
        "last_user_input_id",
        "amendment_refs"
      ],
      "properties": {
        "status": {"type": "string", "enum": ["unlocked", "locked", "legacy-unlocked"]},
        "locked_at": {"type": "string"},
        "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_digests": {"type": "object", "additionalProperties": {"type": "string"}},
        "scope_digest": {"type": "string"},
        "scope_revision": {"type": "integer", "minimum": 0},
        "source_snapshot_revision": {"type": "integer", "minimum": 0},
        "last_user_input_id": {"type": "string"},
        "amendment_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "plan_item_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "requirement_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "release_scope_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "finding_inventory": {
      "type": "object",
      "required": ["fingerprints", "finding_ids", "records"],
      "properties": {
        "fingerprints": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "finding_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "records": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["fingerprint", "finding_ids", "head_sha", "source_refs", "confirmed"],
            "properties": {
              "fingerprint": {"type": "string"},
              "finding_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "target_sha": {"type": "string", "minLength": 1},
              "head_sha": {"type": "string"},
              "scope_revision": {"type": "integer", "minimum": 0},
              "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "confirmed": {"type": "boolean"},
              "policy_axes_explicit": {"type": "boolean"},
              "policy_axes": {
                "type": "object",
                "properties": {
                  "fact_status": {"enum": ["confirmed", "refuted", "insufficient_evidence"]},
                  "severity": {"enum": ["P0", "P1", "P2", "P3"]},
                  "origin": {"enum": ["introduced", "diff-expanded-pre-existing", "unrelated-pre-existing", "unknown"]},
                  "contract_relation": {"enum": ["in_scope", "outside_release", "ambiguous"]},
                  "decision_requirement": {"enum": ["none", "spec", "user"]},
                  "disposition": {"enum": ["fix_now", "defer_follow_up", "disable_feature", "mark_experimental", "user_decision", "accepted_risk", "discard"]},
                  "release_effect": {"enum": ["blocking", "non_blocking"]}
                },
                "additionalProperties": false
              },
              "fact_status": {"enum": ["confirmed", "refuted", "insufficient_evidence"]},
              "severity": {"enum": ["P0", "P1", "P2", "P3"]},
              "origin": {"enum": ["introduced", "diff-expanded-pre-existing", "unrelated-pre-existing", "unknown"]},
              "contract_relation": {"enum": ["in_scope", "outside_release", "ambiguous"]},
              "decision_requirement": {"enum": ["none", "spec", "user"]},
              "disposition": {"enum": ["fix_now", "defer_follow_up", "disable_feature", "mark_experimental", "user_decision", "accepted_risk", "discard"]},
              "release_effect": {"enum": ["blocking", "non_blocking"]},
              "requirement_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "scope_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "why_fix_now": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "updated_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "dispatch_freeze": {
      "type": "object",
      "required": ["status", "reason", "frozen_at", "source_input_id", "allowed_running_role_ids"],
      "properties": {
        "status": {"type": "string", "enum": ["inactive", "active"]},
        "reason": {"type": "string"},
        "frozen_at": {"type": "string"},
        "source_input_id": {"type": "string"},
        "allowed_running_role_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "review_policy": {
      "type": "object",
      "required": [
        "cadence",
        "pre_final_protocol",
        "manual_final_protocol",
        "max_fix_rounds",
        "scope_expansion_action",
        "final_required",
        "lane_count"
      ],
      "properties": {
        "cadence": {"type": "string", "enum": ["batch", "merge-count"]},
        "pre_final_protocol": {"type": "string", "enum": ["native", "codex-review-multi-v2"]},
        "manual_final_protocol": {"type": "string", "enum": ["native", "codex-review-multi-v2"]},
        "max_fix_rounds": {"type": "integer", "minimum": 0, "maximum": 2},
        "scope_expansion_action": {
          "type": "string",
          "enum": ["follow_up", "disable_feature", "mark_experimental", "user_decision"]
        },
        "final_required": {"type": "string", "enum": ["complete_zero_verified_actionable_findings"]},
        "lane_count": {
          "anyOf": [
            {"const": "auto"},
            {"type": "integer", "minimum": 4, "maximum": 8}
          ]
        }
      },
      "additionalProperties": true
    },
    "special_verification_evidence": {
      "type": "object",
      "properties": {
        "migration": {"$ref": "#/$defs/specialVerificationRecord"},
        "schema": {"$ref": "#/$defs/specialVerificationRecord"},
        "public-docs": {"$ref": "#/$defs/specialVerificationRecord"},
        "security-boundary": {"$ref": "#/$defs/specialVerificationRecord"}
      },
      "additionalProperties": false
    },
    "review_convergence": {
      "type": "object",
      "required": [
        "status",
        "target_sha",
        "fix_round",
        "authorized_extra_rounds",
        "extra_round_authorization_refs",
        "verified_actionable_findings",
        "artifact_refs"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "not-started", "prepared", "running", "converged", "exhausted"]
        },
        "target_sha": {"type": "string"},
        "fix_round": {"type": "integer", "minimum": 0},
        "authorized_extra_rounds": {"type": "integer", "minimum": 0},
        "extra_round_authorization_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "verified_actionable_findings": {"type": ["integer", "null"], "minimum": 0},
        "artifact_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "manual_final_review": {
      "type": "object",
      "required": [
        "status",
        "certification_id",
        "target_sha",
        "prepared_plan",
        "prepared_plan_digest",
        "manifest",
        "report",
        "manifest_complete",
        "verified_actionable_findings",
        "attempt_history"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "prepared", "running", "passed", "failed", "incomplete", "not-required-for-legacy-run"]
        },
        "certification_id": {"type": "string"},
        "target_sha": {"type": "string"},
        "prepared_plan": {"type": "string"},
        "prepared_plan_digest": {"type": "string"},
        "manifest": {"type": "string"},
        "report": {"type": "string"},
        "manifest_complete": {"type": ["boolean", "null"]},
        "verified_actionable_findings": {"type": ["integer", "null"], "minimum": 0},
        "accepted_risk_authorizations": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/acceptedRiskAuthorization"}
        },
        "attempt_history": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "follow_ups": {
      "type": "object",
      "required": ["next_id", "open_count", "artifact_refs", "issue_keys", "issue_key_aliases"],
      "properties": {
        "next_id": {"type": "integer", "minimum": 1},
        "open_count": {"type": "integer", "minimum": 0},
        "artifact_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "issue_keys": {"type": "object", "additionalProperties": true},
        "issue_key_aliases": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "manager_invocation": {
      "type": "object",
      "required": ["provider", "model", "reasoning_effort", "recorded_at"],
      "properties": {
        "provider": {"type": "string", "enum": ["", "codex", "claude"]},
        "model": {"type": "string"},
        "reasoning_effort": {"type": "string"},
        "recorded_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "execution_metrics": {
      "type": "object",
      "required": [
        "planned_task_count",
        "remediation_task_count",
        "task_origin_counts",
        "review_fix_rounds",
        "finding_disposition_counts",
        "stale_review_count",
        "aborted_review_count",
        "stale_gap_count",
        "aborted_gap_count",
        "scope_expansion_started_at",
        "effective_parallelism"
      ],
      "properties": {
        "planned_task_count": {"type": "integer", "minimum": 0},
        "remediation_task_count": {"type": "integer", "minimum": 0},
        "task_origin_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "review_fix_rounds": {"type": "integer", "minimum": 0},
        "finding_disposition_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "stale_review_count": {"type": "integer", "minimum": 0},
        "aborted_review_count": {"type": "integer", "minimum": 0},
        "stale_gap_count": {"type": "integer", "minimum": 0},
        "aborted_gap_count": {"type": "integer", "minimum": 0},
        "scope_expansion_started_at": {"type": "string"},
        "effective_parallelism": {"type": ["number", "null"], "minimum": 0},
        "worker_runtime_seconds": {"type": "number", "minimum": 0},
        "batch_id": {"type": "string"},
        "batch_metrics": {
          "type": "array",
          "items": {"$ref": "#/$defs/batchPerformanceRecord"}
        }
      },
      "additionalProperties": true
    },
    "last_provider_preflight": {"type": "object", "additionalProperties": true},
    "worktree_setup_commands": {"type": "array", "items": {"type": "string"}},
    "worker_setup_commands": {"type": "array", "items": {"type": "string"}},
    "reviewer_setup_commands": {"type": "array", "items": {"type": "string"}},
    "gap_setup_commands": {"type": "array", "items": {"type": "string"}},
    "advisor_setup_commands": {"type": "array", "items": {"type": "string"}},
    "min_free_bytes": {"type": "integer", "minimum": 0},
    "min_free_inodes": {"type": "integer", "minimum": 0},
    "phase": {"type": "string"},
    "base_branch": {"type": "string"},
    "integration_branch": {"type": "string"},
    "worktree_root": {"type": "string"},
    "branch_strategy": {"type": "string", "enum": ["integration", "pr-per-task", "custom"]},
    "worker_qa_profile": {"type": "string", "enum": ["repo-default", "local", "staging", "preview", "none", "custom"]},
    "manager_qa_profile": {"type": "string", "enum": ["repo-default", "local", "staging", "preview", "none", "custom"]},
    "manager_qa_status": {"type": "string", "enum": ["pending", "passed", "accepted-risk", "blocked", "failed", "not-required"]},
    "manager_qa_evidence_path": {"type": "string", "pattern": "^\\.ai/herdr-dev-loop/loops/"},
    "qa_profile": {"type": "string", "enum": ["repo-default", "local", "staging", "preview", "none", "custom"], "description": "Deprecated alias for worker_qa_profile."},
    "worker_protocol": {"type": "string", "enum": ["native", "codex-impl"]},
    "review_protocol": {"type": "string", "enum": ["native", "codex-review-multi-v2"]},
    "worker_agent_provider": {"type": "string", "enum": ["codex", "claude"]},
    "worker_agent_model": {"type": "string"},
    "worker_agent_effort": {"type": "string"},
    "worker_claude_permission_mode": {"type": "string"},
    "reviewer_agent_provider": {"type": "string", "enum": ["codex", "claude"]},
    "reviewer_agent_model": {"type": "string"},
    "reviewer_agent_effort": {"type": "string"},
    "reviewer_claude_permission_mode": {"type": "string"},
    "gap_agent_provider": {"type": "string", "enum": ["codex", "claude"]},
    "gap_agent_model": {"type": "string"},
    "gap_agent_effort": {"type": "string"},
    "gap_claude_permission_mode": {"type": "string"},
    "advisor_enabled": {"type": "boolean"},
    "advisor_mode": {"type": "string", "enum": ["single", "dialogue"]},
    "advisor_max_rounds": {"type": "integer", "minimum": 1},
    "advisor_agent_provider": {"type": "string", "enum": ["codex", "claude"]},
    "advisor_agent_model": {"type": "string"},
    "review_lanes": {"type": "array", "items": {"type": "string"}},
    "cycle": {"type": "integer", "minimum": 0},
    "max_workers": {"type": "integer", "minimum": 1},
    "max_reviewers": {"type": "integer", "minimum": 0},
    "max_gap_auditors": {"type": "integer", "minimum": 0},
    "session_cleanup": {"type": "string", "enum": ["archive", "none", "delete"]},
    "review_wait_ms": {"type": "integer", "minimum": 0},
    "gap_wait_ms": {"type": "integer", "minimum": 0},
    "review_after_merges": {"type": "integer", "minimum": 1},
    "gap_after_merges": {"type": "integer", "minimum": 1},
    "unreviewed_merge_count": {"type": "integer", "minimum": 0},
    "ungapped_merge_count": {"type": "integer", "minimum": 0},
    "reviewer_runner": {"type": "string", "enum": ["tui", "exec"]},
    "gap_runner": {"type": "string", "enum": ["tui", "exec"]},
    "spec_sources": {"type": "array", "items": {"type": "string"}},
    "current_batch_id": {"type": "string", "pattern": "^B[0-9]{3}$"},
    "validation_stale": {"type": "boolean"},
    "validation_stale_reason": {"type": "string"},
    "validation_history": {"type": "array", "items": {"type": "object"}},
    "write_scope_conflict_graph": {"$ref": "#/$defs/writeScopeConflictGraph"},
    "next_batch_replan": {"type": "object", "additionalProperties": true},
    "progress_projection": {"type": "object", "additionalProperties": true},
    "artifact_policy": {"type": "object"},
    "resume_requirements": {"type": "array", "items": {"type": "object"}},
    "pending_fix_task_drafts": {"type": "array", "items": {"type": "string"}},
    "final_gate": {
      "type": ["object", "null"],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["armed", "disarmed"]},
        "target_sha": {"type": "string"},
        "armed_at": {"type": "string"},
        "armed_by": {"type": "string"},
        "disarmed_at": {"type": "string"},
        "disarmed_by": {"type": "string"},
        "disarm_reason": {"type": "string"}
      },
      "required": ["generation", "status", "target_sha", "armed_at", "armed_by"],
      "additionalProperties": false
    },
    "attempt_history": {"type": "array", "items": {"type": "object"}},
    "cleanup_history": {"type": "array", "items": {"type": "object"}},
    "lifecycle_diagnostics": {"type": "array", "items": {"type": "object"}},
    "tasks": {"type": "object"},
    "batches": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "performance": {"$ref": "#/$defs/batchPerformanceRecord"},
          "metrics": {"$ref": "#/$defs/batchPerformanceRecord"},
          "write_scope_conflict_graph": {"$ref": "#/$defs/writeScopeConflictGraph"}
        },
        "additionalProperties": true
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "mode": {"type": "string", "enum": ["single", "swarm", "dual", "dual-swarm"]}
        },
        "additionalProperties": true
      }
    },
    "gaps": {"type": "object"},
    "advice": {"type": "object"},
    "decisions": {"type": "object"},
    "accepted_risk_authorizations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/acceptedRiskAuthorization"}
    }
  },
  "additionalProperties": true
}
