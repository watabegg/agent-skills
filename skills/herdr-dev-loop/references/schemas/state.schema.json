{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr Dev Loop State",
  "type": "object",
  "required": ["goal_id", "phase", "base_branch", "integration_branch", "cycle", "max_workers", "max_reviewers", "tasks", "reviews", "blocking_decisions"],
  "properties": {
    "goal_id": {"type": "string"},
    "phase": {"type": "string"},
    "base_branch": {"type": "string"},
    "integration_branch": {"type": "string"},
    "cycle": {"type": "integer", "minimum": 0},
    "max_workers": {"type": "integer", "minimum": 1},
    "max_reviewers": {"type": "integer", "minimum": 0},
    "max_gap_auditors": {"type": "integer", "minimum": 0},
    "session_cleanup": {"type": "string", "enum": ["archive", "none", "delete"]},
    "review_wait_ms": {"type": "integer", "minimum": 0},
    "gap_wait_ms": {"type": "integer", "minimum": 0},
    "review_after_merges": {"type": "integer", "minimum": 1},
    "gap_after_merges": {"type": "integer", "minimum": 1},
    "unreviewed_merge_count": {"type": "integer", "minimum": 0},
    "ungapped_merge_count": {"type": "integer", "minimum": 0},
    "reviewer_runner": {"type": "string", "enum": ["tui", "exec"]},
    "gap_runner": {"type": "string", "enum": ["tui", "exec"]},
    "spec_sources": {"type": "array", "items": {"type": "string"}},
    "tasks": {"type": "object"},
    "reviews": {"type": "object"},
    "gaps": {"type": "object"},
    "blocking_decisions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
