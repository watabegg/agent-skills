{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr Dev Loop Task Frontmatter",
  "type": "object",
  "required": ["id", "kind", "status", "branch", "base_ref", "base_sha", "write_allow", "acceptance"],
  "properties": {
    "id": {"type": "string", "pattern": "^T[0-9]{3}$"},
    "kind": {"type": "string"},
    "status": {"type": "string"},
    "branch": {"type": "string"},
    "base_ref": {"type": "string"},
    "base_sha": {"type": "string"},
    "write_allow": {"type": "array", "items": {"type": "string"}},
    "write_deny": {"type": "array", "items": {"type": "string"}},
    "acceptance": {"type": "array", "items": {"type": "string"}},
    "validation_minimum": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "string"}, "minItems": 1}
      ]
    },
    "worker_protocol": {"type": "string", "enum": ["native", "codex-impl"]},
    "worker_qa_profile": {"type": "string", "enum": ["repo-default", "local", "staging", "preview", "none", "custom"]},
    "qa_profile": {"type": "string", "enum": ["repo-default", "local", "staging", "preview", "none", "custom"], "description": "Deprecated alias for worker_qa_profile."}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {"enum": ["implementation", "fix"]}
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "write_allow": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "required": ["write_allow"]
      }
    }
  ],
  "additionalProperties": true
}
