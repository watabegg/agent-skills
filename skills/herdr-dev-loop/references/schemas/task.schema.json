        "write_allow",
        "acceptance",
        "preserved_invariants",
        "regression_checks",
        "risk_class",
        "required_gates",
        "worker_agent_effort"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^T[0-9]{3}$"},
        "run_id": {"type": "string", "minLength": 1},
