def require_role_snapshot(
    repo: Path,
    state: dict[str, Any],
    ref: str,
    paths: list[Path],
) -> None:
    if state_persistence(state) == "branch-history":
        require_files_committed_at_ref(repo, ref, paths)


def prepare_role_worktree(
    repo: Path,
    worktree: Path,
    state: dict[str, Any],
    *,
    role: str,
    agent_id: str,
) -> None:
    copy_local_loop_snapshot(repo, worktree, state)
    run_worktree_setup_commands(repo, worktree, state, role=role, agent_id=agent_id)


def git_common_dir(worktree: Path) -> Path:
    raw = git(worktree, ["rev-parse", "--path-format=absolute", "--git-common-dir"])
    return Path(raw).resolve()


def rollback_failed_role_start(
    repo: Path,
    worktree: Path,
    *,
    created_worktree: bool,
    branch: str = "",
    created_branch: bool = False,
) -> None:
    if created_worktree and worktree.exists():
        run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(repo), "worktree", "remove", "--force", str(worktree)],
            check=False,
        )
    if created_branch and branch and branch_exists(repo, branch):
        run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "branch", "-D", branch], check=False)


def close_pane_best_effort(pane_id: str) -> None:
    if pane_id:
        run_cmd(["herdr", "pane", "close", pane_id], check=False)


def cleanup_review_worktree(
    repo: Path,
    review_id: str,
    review_state: dict[str, Any],
    *,
    dry_run: bool = False,
    best_effort: bool = False,
) -> None:
    worktree_raw = review_state.get("worktree")
    if not worktree_raw:
        return
    worktree = Path(worktree_raw).resolve()
    if not worktree.exists() or worktree == repo or review_state.get("worktree_cleaned_at"):
        return
    if dry_run:
        print(f"DRY RUN git worktree remove --force {worktree}")
        return
    try:
        cleanup_hloop_prompt_file(worktree, review_id, "reviewer")
        git(repo, ["worktree", "remove", "--force", str(worktree)])
    except (HLoopError, subprocess.CalledProcessError) as exc:
        if best_effort:
            record_worktree_cleanup_failure(repo, review_state, f"Reviewer {review_id}", exc)
            return
        raise
    review_state["worktree_cleanup_status"] = "removed"
    review_state["worktree_cleaned_at"] = now_iso()


def cleanup_gap_worktree(
    repo: Path,
    gap_id: str,
    gap_state: dict[str, Any],
    *,
    dry_run: bool = False,
    best_effort: bool = False,
) -> None:
    worktree_raw = gap_state.get("worktree")
    if not worktree_raw:
        return
    worktree = Path(worktree_raw).resolve()
    if not worktree.exists() or worktree == repo or gap_state.get("worktree_cleaned_at"):
        return
    if dry_run:
        print(f"DRY RUN git worktree remove --force {worktree}")
        return
    try:
        cleanup_hloop_prompt_file(worktree, gap_id, "gap")
        git(repo, ["worktree", "remove", "--force", str(worktree)])
    except (HLoopError, subprocess.CalledProcessError) as exc:
        if best_effort:
            record_worktree_cleanup_failure(repo, gap_state, f"Gap Auditor {gap_id}", exc)
            return
        raise
    gap_state["worktree_cleanup_status"] = "removed"
    gap_state["worktree_cleaned_at"] = now_iso()


def cleanup_advisor_worktree(
    repo: Path,
    advice_id: str,
    participant: dict[str, Any],
    *,
    dry_run: bool = False,
    best_effort: bool = False,
) -> None:
    worktree_raw = participant.get("worktree")
    if not worktree_raw:
        return
    worktree = Path(worktree_raw).resolve()
    if not worktree.exists() or worktree == repo or participant.get("worktree_cleaned_at"):
        return
    participant_id = str(participant.get("participant_id") or "P1")
    if dry_run:
        print(f"DRY RUN git worktree remove --force {worktree}")
        return
    try:
        cleanup_hloop_prompt_file(worktree, f"{advice_id}-{participant_id}", "advisor")
        git(repo, ["worktree", "remove", "--force", str(worktree)])
    except (HLoopError, subprocess.CalledProcessError) as exc:
        if best_effort:
            record_worktree_cleanup_failure(repo, participant, f"Advisor {advice_id}/{participant_id}", exc)
            return
        raise
    participant["worktree_cleanup_status"] = "removed"
    participant["worktree_cleaned_at"] = now_iso()


def start_pane_launcher(
    *,
    manager_pane: str,
    direction: str,
    cwd: Path,
    command: str,
) -> str:
    split_cmd = [
        "herdr",
        "pane",
        "split",
        manager_pane,
        "--direction",
        direction,
        "--cwd",
        str(cwd),
        "--no-focus",
    ]
    pane_id = extract_pane_id(json_from_cmd(split_cmd))
    proc = run_cmd(["herdr", "pane", "run", pane_id, command], check=False, capture=True)
    if proc.returncode != 0:
        close_pane_best_effort(pane_id)
        raise HLoopError((proc.stderr or proc.stdout or "failed to start role pane").strip())
    return pane_id


def start_agent_launcher(
    *,
    name: str,
    direction: str,
    cwd: Path,
    command: str,
) -> str:
    cmd = ["herdr", "agent", "start", name, "--cwd", str(cwd)]
    workspace_id = current_workspace_id()
    if workspace_id:
        cmd.extend(["--workspace", workspace_id])
    cmd.extend(["--split", direction, "--no-focus", "--", "bash", "-lc", command])
    return extract_pane_id(json_from_cmd(cmd))


def agent_provider_invocation(
    *,
    provider: str,
    model: str,
    runner: str,
    sandbox: str,
    prompt_rel: Path,
    cwd: Path,
    output_rel: Path | None = None,
    effort: str = DEFAULT_AGENT_EFFORT,
    writable_dirs: list[Path] | None = None,
    claude_permission_mode: str = DEFAULT_CLAUDE_PERMISSION_MODE,
) -> hloop_providers.ProviderInvocation:
    """Resolve one provider launch to its argv via ``hloop_providers``.

    This is the single source of provider flags shared by preflight, launch,
    and the persisted ``provider_invocation`` evidence, so they never diverge.
    """

    provider = normalize_agent_provider(provider)
    model = normalize_agent_model(model)
    if runner not in AGENT_RUNNERS:
        raise HLoopError(f"unsupported runner: {runner}")
    base = Path(cwd).resolve()
    prompt_abs = (base / prompt_rel).resolve()
    output_abs = (base / output_rel).resolve() if output_rel is not None else None
    permission_mode = claude_permission_mode if provider == "claude" else "auto"
    try:
        return hloop_providers.build_provider_invocation(
            provider=provider,
            runner=runner,
            sandbox=sandbox,
            prompt_path=prompt_abs,
            model=model,
            effort=effort,
            permission_mode=permission_mode,
            output_path=output_abs if runner == "exec" and provider == "codex" else None,
            writable_dirs=writable_dirs or (),
        )
    except hloop_providers.ProviderError as exc:
        raise HLoopError(str(exc)) from exc


def agent_command_from_invocation(
    invocation: hloop_providers.ProviderInvocation,
    *,
    provider: str,
    runner: str,
    prompt_rel: Path,
    output_rel: Path | None = None,
) -> str:
    prompt_ref = shlex.quote(str(prompt_rel))
    argv = list(invocation.argv)
    if runner == "exec":
        command = f"{shlex.join(argv)} < {prompt_ref}"
        if output_rel is not None and provider == "claude":
            command = f"{command} > {shlex.quote(str(output_rel))}"
    else:
        command = f"{shlex.join(argv)} \"$(cat {prompt_ref})\""
    return command


def agent_command_for_prompt(
    *,
    provider: str,
    model: str,
    runner: str,
    sandbox: str,
    prompt_rel: Path,
    cwd: Path | None = None,
    output_rel: Path | None = None,
    effort: str = DEFAULT_AGENT_EFFORT,
    writable_dirs: list[Path] | None = None,
    claude_permission_mode: str = DEFAULT_CLAUDE_PERMISSION_MODE,
) -> str:
    provider = normalize_agent_provider(provider)
    invocation = agent_provider_invocation(
        provider=provider,
        model=model,
        runner=runner,
        sandbox=sandbox,
        prompt_rel=prompt_rel,
        cwd=cwd or Path.cwd(),
        output_rel=output_rel,
        effort=effort,
        writable_dirs=writable_dirs,
        claude_permission_mode=claude_permission_mode,
    )
    return agent_command_from_invocation(
        invocation, provider=provider, runner=runner, prompt_rel=prompt_rel, output_rel=output_rel
    )


def role_agent_command(
    repo: Path,
    config: dict[str, str],
    *,
    runner: str,
    prompt_rel: Path,
    cwd: Path,
    output_rel: Path | None = None,
) -> tuple[str, hloop_providers.ProviderInvocation]:
    writable = [git_common_dir(repo)] if config["provider"] == "codex" else []
    provider = normalize_agent_provider(config["provider"])
    invocation = agent_provider_invocation(
        provider=provider,
        model=config["model"],
        runner=runner,
        sandbox="workspace-write",
        prompt_rel=prompt_rel,
        cwd=cwd,
        output_rel=output_rel,
        effort=config.get("effort", DEFAULT_AGENT_EFFORT),
        writable_dirs=writable,
        claude_permission_mode=config.get(
            "claude_permission_mode", DEFAULT_CLAUDE_PERMISSION_MODE
        ),
    )
    command = agent_command_from_invocation(
        invocation, provider=provider, runner=runner, prompt_rel=prompt_rel, output_rel=output_rel
    )
    return command, invocation


def ensure_worker_attempt(
    task_id: str,
    task_state: dict[str, Any],
    task_meta: dict[str, Any],
    integration: str,
    current_base_sha: str,
) -> tuple[str, str]:
    if not task_state.get("active_attempt_id"):
        attempt_no = normalize_int(task_state.get("attempt_no"), 0) + 1
        task_state["attempt_no"] = attempt_no
        task_state["active_attempt_id"] = f"{task_id}-A{attempt_no:03d}"
        task_state["worker_base_sha"] = current_base_sha
        task_state["base_sha"] = current_base_sha
    task_state["base_ref"] = integration
    base_sha = str(task_state.get("worker_base_sha") or task_state.get("base_sha") or "")
    if not base_sha:
        raise HLoopError(f"worker base is missing for {task_id}")
    task_meta["base_ref"] = integration
    task_meta["base_sha"] = base_sha
    task_meta["attempt_id"] = task_state["active_attempt_id"]
    return str(task_state["active_attempt_id"]), base_sha


def cmd_worker_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    if task_state.get("status") not in {"queued", "failed_validation"}:
        raise HLoopError(f"task is not startable: {task_id} status={task_state.get('status')}")
    task_meta = read_frontmatter(task_file(repo, task_id))
    if getattr(args, "agent_provider", None):
        task_meta["agent_provider"] = args.agent_provider
    if getattr(args, "agent_model", None):
        task_meta["agent_model"] = args.agent_model
    branch = task_state.get("branch") or task_meta["branch"]
    task_state.setdefault("root_branch", branch)
    integration = state["integration_branch"]
    current_base_sha = git(repo, ["rev-parse", integration])
    ensure_worker_attempt(task_id, task_state, task_meta, integration, current_base_sha)
    require_role_snapshot(repo, state, integration, worker_snapshot_paths(task_id))
    worktree = Path(args.worktree).resolve() if args.worktree else default_worktree(repo, task_id, state)
    prompt = render_worker_prompt(task_id, task_meta, worktree, branch, state)
    prompt_rel = LOOP_DIR / "prompts" / f"{task_id}.worker.md"
    runner = args.runner or state.get("worker_runner", "tui")
    agent_config = role_agent_config(
        state,
        "worker",
        overrides={
            **task_meta,
            "agent_provider": getattr(args, "agent_provider", None),
            "agent_model": getattr(args, "agent_model", None),
        },
    )
    agent_command, preview_invocation = role_agent_command(
        repo, agent_config, runner=runner, prompt_rel=prompt_rel, cwd=worktree
    )
    command = f"cd {shlex.quote(str(worktree))} && {agent_command}"
    if args.dry_run:
        print(f"DRY RUN worktree: git worktree add {worktree} -b {branch} {integration}")
        print(f"DRY RUN prompt: {worktree / prompt_rel}")
        print(f"DRY RUN {args.launcher}/{runner} command: {command}")
        return 0
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_agent_invocation=preview_invocation,
        require_integration_branch=True,
    )
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    if task_state.get("status") not in {"queued", "failed_validation"}:
        raise HLoopError(f"task is not startable: {task_id} status={task_state.get('status')}")
    task_meta = read_frontmatter(task_file(repo, task_id))
    if getattr(args, "agent_provider", None):
        task_meta["agent_provider"] = args.agent_provider
    if getattr(args, "agent_model", None):
        task_meta["agent_model"] = args.agent_model
    branch = task_state.get("branch") or task_meta["branch"]
    task_state.setdefault("root_branch", branch)
    integration = state["integration_branch"]
    current_base_sha = git(repo, ["rev-parse", integration])
    attempt_id, worker_base_sha = ensure_worker_attempt(
        task_id, task_state, task_meta, integration, current_base_sha
    )
    worktree = Path(args.worktree).resolve() if args.worktree else default_worktree(repo, task_id, state)
    task_contract_digest = hashlib.sha256(task_file(repo, task_id).read_bytes()).hexdigest()
    runner = args.runner or state.get("worker_runner", "tui")
    agent_config = role_agent_config(
        state,
        "worker",
        overrides={
            **task_meta,
            "agent_provider": getattr(args, "agent_provider", None),
            "agent_model": getattr(args, "agent_model", None),
        },
    )
    agent_command, provider_invocation = role_agent_command(
        repo, agent_config, runner=runner, prompt_rel=prompt_rel, cwd=worktree
    )
    command = f"cd {shlex.quote(str(worktree))} && {agent_command}"
    if not branch_exists(repo, integration):
        raise HLoopError(
            f"integration branch does not exist: {integration}. "
            "Run `hloop init --create-branch` or create it before starting Workers."
        )
    require_role_snapshot(repo, state, integration, worker_snapshot_paths(task_id))
    task_state["worktree"] = str(worktree)
    save_state(repo, state)
    branch_preexisting = branch_exists(repo, branch)
    worktree_preexisting = worktree.exists()
    if not worktree_preexisting:
        if branch_preexisting:
            git(repo, ["worktree", "add", str(worktree), branch])
        else:
            git(repo, ["worktree", "add", str(worktree), "-b", branch, integration])
    try:
        prepare_role_worktree(repo, worktree, state, role="worker", agent_id=task_id)
        ensure_task_visible_in_worktree(worktree, task_id)
        ensure_worktree_parent_dirs(worktree, prompt_rel, LOOP_DIR / "results" / task_id / "result.md")
        report_credential_file, initial_ack_floor = register_role_report_identity_and_ack_floor(
            repo,
            state,
            role_id=task_id,
            attempt_id=attempt_id,
            task_contract_digest=task_contract_digest,
        )
        prompt = render_worker_prompt(
            task_id,
            task_meta,
            worktree,
            branch,
            state,
            report_credential_file=str(report_credential_file),
            task_contract_digest=task_contract_digest,
        )
        write_text(worktree / prompt_rel, prompt)
        if args.launcher == "agent":
            pane_id = start_agent_launcher(
                name=f"hloop-{state['goal_id']}-{task_id}-worker",
                direction=args.direction,
                cwd=worktree,
                command=command,
            )
        else:
            manager_pane = args.manager_pane or current_pane_id()
            pane_id = start_pane_launcher(
                manager_pane=manager_pane,
                direction=args.direction,
                cwd=worktree,
                command=command,
            )
    except (
        HLoopError,
        hloop_broker.BrokerStorageError,
        OSError,
        subprocess.CalledProcessError,
    ):
        try:
            rollback_failed_role_start(
                repo,
                worktree,
                created_worktree=not worktree_preexisting,
                branch=branch,
                created_branch=not branch_preexisting,
            )
        finally:
            revoke_active_role_report_identity(repo, state, task_id)
        raise
    task_state.update(
        {
            "status": "running",
            "pane_id": pane_id,
            "worktree": str(worktree),
            "prompt": str(worktree / prompt_rel),
            "runner": runner,
            "agent_provider": agent_config["provider"],
            "agent_model": agent_config["model"],
            "agent_effort": agent_config["effort"],
            "claude_permission_mode": agent_config["claude_permission_mode"],
            "attempt_id": attempt_id,
            "worker_base_sha": worker_base_sha,
            "fallback_provider": agent_config["fallback_provider"],
            "skill_version": SKILL_VERSION,
            "sandbox": "workspace-write",
            "started_at": now_iso(),
            "provider_invocation": provider_invocation.as_record(),
            "task_contract_digest": task_contract_digest,
        }
    )
    arm_initial_semantic_ack_barrier(
        task_state,
        attempt_id=attempt_id,
        contract_digest=task_contract_digest,
        required_reack_after_sequence=initial_ack_floor,
    )
    state["phase"] = "running"
    save_state(repo, state)
    journal(repo, f"Started Worker `{task_id}` in pane `{pane_id}` and worktree `{worktree}`.")
    print(f"started {task_id} in pane {pane_id}")
    return 0


def cmd_worker_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    block_reason = semantic_ack_barrier_blocking(task_state)
    if block_reason:
        raise HLoopError(f"cannot harvest {task_id}: {block_reason}")
    worktree = Path(task_state.get("worktree") or default_worktree(repo, task_id, state)).resolve()
    result = result_file(worktree, task_id)
    if not result.exists():
        raise HLoopError(f"result not found: {result}")
    meta = read_frontmatter(result)
    identity_error = artifact_identity_error(state, task_id, "worker", task_state, meta)
    if identity_error:
        raise HLoopError(f"stale or mismatched Worker artifact: {identity_error}: {result}")
    status = str(meta.get("status", ""))
    if status not in TASK_STATUSES_FINAL:
        raise HLoopError(f"invalid result status in {result}: {status}")
    reported_task_id = str(meta.get("task_id") or "")
    if reported_task_id and reported_task_id != task_id:
        raise HLoopError(f"result task_id mismatch: expected {task_id}, got {reported_task_id}")
    raw_head_sha = str(meta.get("head_sha") or "")
    head_sha = git(worktree, ["rev-parse", "HEAD"]) if raw_head_sha in {"", "HEAD"} else raw_head_sha
    manager_base_sha = str(task_state.get("base_sha") or "")
    reported_base_sha = str(meta.get("base_sha") or "")
    base_sha = manager_base_sha
    if not base_sha:
        raise HLoopError(f"manager base_sha is missing for {task_id}")
    committed_result = require_committed_result(worktree, task_id, head_sha)
    final_result = result_file(repo, task_id)
    files = normalize_list(meta.get("changed_files")) or changed_files(worktree, base_sha, head_sha)
    validation_recorded = result_validation_recorded(meta)
    reported_merge_ready = normalize_bool(meta.get("merge_ready"))
    validation_error = worker_validation_error(
        meta,
        require_recorded=reported_merge_ready,
        require_passing=reported_merge_ready,
    )
    if validation_error:
        raise HLoopError(f"invalid Worker validation in {result}: {validation_error}")
    if result.resolve() != final_result.resolve():
        write_text(final_result, read_text(result))
        task_state["worktree_result_path_harvested"] = str(result)
    task_state.update(
        {
            "status": "result_reported" if status == "done" else status,
            "result_status": status,
            "merge_ready": reported_merge_ready,
            "head_sha": head_sha,
            "base_sha": base_sha,
            "reported_base_sha": reported_base_sha,
            "changed_files": files,
            "blocking_questions": normalize_list(meta.get("blocking_questions")),
            "validation_recorded": validation_recorded,
            "validation_commands": normalize_list(meta.get("validation_commands")),
            "validation_results": normalize_list(meta.get("validation_results")),
            "validation_summary": str(meta.get("validation_summary") or ""),
            "result_path": committed_result,
            "committed_result_path": committed_result,
            "harvested_at": now_iso(),
        }
    )
    cleanup_completed_agent_pane(
        repo,
        task_state,
        label=f"Worker {task_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    revoke_active_role_report_identity(repo, state, task_id)
    state["phase"] = "harvesting"
    save_state(repo, state)
    journal(repo, f"Harvested Worker `{task_id}` with status `{status}`.")
    print(f"harvested {task_id}: {status}")
    return 0


def send_manager_message_and_record(
    repo: Path,
    state: dict[str, Any],
    agent_state: dict[str, Any],
    *,
    role: str,
    agent_id: str,
    pane_id: str,
    message: str,
    source: str,
    args: argparse.Namespace,
) -> int:
    """Envelope, (re-)arm the semantic ACK barrier if needed, send, and record.

    Shared by the Worker/Reviewer/Gap/Advisor `message` commands so the three
    delivery outcomes -- `delivered`, `undelivered`, `unknown` -- are recorded
    identically everywhere a Manager message is sent.
    """

    contract_changing = bool(getattr(args, "contract_changing", False))
    message_id, message = manager_message_envelope(
        state, agent_id, agent_state, message, contract_changing=contract_changing
    )
    if contract_changing:
        existing_barrier = agent_state.get("semantic_ack_barrier")
        pending_task_contract = (
            isinstance(existing_barrier, dict)
            and str(existing_barrier.get("kind") or "") == "task-contract"
            and str(existing_barrier.get("status") or "") != "approved"
        )
        if not pending_task_contract:
            arm_semantic_ack_barrier(
                agent_state,
                message_id=message_id,
                digest=message_digest(message),
                required_reack_after_sequence=latest_semantic_ack_sequence(
                    repo, state, role_id=agent_id, agent_state=agent_state
                ),
            )
    try:
        send_agent_tui_message(
            str(agent_state.get("agent_provider") or agent_state.get("provider") or DEFAULT_AGENT_PROVIDER),
            pane_id,
            message,
            args.timeout_ms,
            args.input_settle_ms,
            args.submit_verify_ms,
            args.submit_attempts,
        )
    except ManagerMessageDeliveryUnknown as exc:
        return record_unknown_manager_message(
            repo,
            state,
            agent_state,
            role=role,
            agent_id=agent_id,
            source=source,
            message=message,
            error=exc,
        )
    except HLoopError as exc:
        return record_pending_manager_message(
            repo,
            state,
            agent_state,
            role=role,
            agent_id=agent_id,
            pane_id=pane_id,
            source=source,
            message=message,
            error=exc,
        )
    record_manager_message(agent_state, source, message)
    save_state(repo, state)
    journal(repo, f"Sent Manager message to {role} `{agent_id}` in pane `{pane_id}` from {source}.")
    print(f"sent manager message to {agent_id} in pane {pane_id}")
    return 0


def cmd_worker_message(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    if task_state.get("status") != "running":
        raise HLoopError(f"worker is not running: {task_id} status={task_state.get('status')}")
    pane_id = str(task_state.get("pane_id") or "")
    if not pane_id:
        raise HLoopError(f"worker has no pane_id: {task_id}")
    message, source = manager_message_from_args(args)
    if not message.strip():
        raise HLoopError("manager message is empty")
    return send_manager_message_and_record(
        repo,
        state,
        task_state,
        role="Worker",
        agent_id=task_id,
        pane_id=pane_id,
        message=message,
        source=source,
        args=args,
    )


def cmd_message_drain(args: argparse.Namespace) -> int:
    """Resend every running role's undelivered Manager messages."""

    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_herdr=True)
    agent_states = [
        *state.get("tasks", {}).values(),
        *state.get("reviews", {}).values(),
        *state.get("gaps", {}).values(),
        *(
            participant
            for advice in state.get("advice", {}).values()
            for participant in advice.get("participants", [])
        ),
    ]
    total_drained = 0
    total_remaining = 0
    for agent_state in agent_states:
        if agent_state.get("status") != "running" and agent_state.get("gate_status") != "running":
            continue
        drained, remaining = resend_pending_manager_messages(
            repo,
            agent_state,
            timeout_ms=args.timeout_ms,
            input_settle_ms=args.input_settle_ms,
            submit_verify_ms=args.submit_verify_ms,
            submit_attempts=args.submit_attempts,
        )
        total_drained += drained
        total_remaining += remaining
    save_state(repo, state)
    journal(
        repo,
        f"Drained pending Manager messages: {total_drained} resent, {total_remaining} still pending.",
    )
    print(f"drained {total_drained} pending message(s); {total_remaining} still pending")
    return 0


def cmd_message_resolve(args: argparse.Namespace) -> int:
    """Durably record transport ACK, applied result, or explicit resolution."""

    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    role, agent_state = resolve_agent_state(state, args.agent_id)
    entry = manager_message_by_id(agent_state, args.message_id)
    if entry is None:
        raise HLoopError(
            f"unknown Manager message for {args.agent_id}: {args.message_id}"
        )
    transition_manager_message(
        agent_state,
        entry,
        delivery_status=args.status,
        result=getattr(args, "result", None),
        error=getattr(args, "error", None),
    )
    if args.status in {"acknowledged", "applied", "superseded"}:
        agent_state["unknown_manager_messages"] = [
            item
            for item in agent_state.get("unknown_manager_messages") or []
            if item.get("message_id") != args.message_id
        ]
    save_state(repo, state)
    journal(
        repo,
        f"Resolved Manager message `{args.message_id}` for {role} `{args.agent_id}` "
        f"as `{args.status}`.",
    )
    print(f"{args.agent_id}/{args.message_id}: {args.status}")
    return 0


def cmd_worker_watch(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    pane_id = str(task_state.get("pane_id") or "")
    if not pane_id:
        raise HLoopError(f"worker has no pane_id: {task_id}")
    proc = run_cmd(
        [
            "herdr",
            "pane",
            "read",
            pane_id,
            "--source",
            args.source,
            "--lines",
            str(args.lines),
        ],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    print(proc.stdout.rstrip())
    return 0


def complete_merge_state(repo: Path, state: dict[str, Any], task_id: str, mode: str) -> None:
    task_state = state["tasks"][task_id]
    task_state["status"] = "merged"
    task_state["merged_at"] = now_iso()
    task_state["merge_mode"] = mode
    task_state["cleanup_pending"] = True
    task_state.pop("merge_error", None)
    state.pop("active_merge", None)
    state.pop("last_merge_error", None)
    state["needs_validation"] = True
    state["last_merged_task"] = task_id
    state["unreviewed_merge_count"] = normalize_int(state.get("unreviewed_merge_count"), 0) + 1
    state["ungapped_merge_count"] = normalize_int(state.get("ungapped_merge_count"), 0) + 1
    if manager_qa_required(state):
        state["manager_qa_status"] = "pending"
        state.pop("manager_qa_head_sha", None)
    state["phase"] = "validating"
    save_state(repo, state)
    journal(repo, f"Merged Worker `{task_id}` from `{task_state.get('branch', '')}`.")


def merge_transaction_index_state(repo: Path, target: str) -> str:
    return git(repo, ["rev-parse", f"{target}^{{tree}}"])


def build_merge_transaction(
    *,
    task_id: str,
    attempt_id: str,
    branch: str,
    pre_merge_head: str,
    worker_head: str,
    index_state: str,
    changed_paths: Sequence[str],
    status: str = MERGE_ACTIVE,
    mode: str = "squash",
    source_commits: Sequence[str] = (),
) -> MergeTransaction:
    return MergeTransaction(
        transaction_id=f"M-{task_id}-{attempt_id}",
        task_id=task_id,
        attempt_id=attempt_id,
        branch=branch,
        pre_merge_head=pre_merge_head,
        worker_head=worker_head,
        result_head=worker_head,
        index_state=index_state,
        changed_paths=tuple(changed_paths),
        status=status,
        mode=mode,
        source_commits=tuple(source_commits),
        applied_head=pre_merge_head,
    )


def merge_git_dir(repo: Path) -> Path:
    return Path(git(repo, ["rev-parse", "--path-format=absolute", "--git-dir"])).resolve()


def cherry_pick_todo_commits(repo: Path, todo_path: Path) -> tuple[str, ...]:
    commits: list[str] = []
    for raw_line in read_text(todo_path).splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split(maxsplit=2)
        if len(fields) < 2 or fields[0] != "pick":
            raise HLoopError("cherry-pick sequencer todo was modified outside HLoop")
        commits.append(git(repo, ["rev-parse", f"{fields[1]}^{{commit}}"]))
    return tuple(commits)


def observe_cherry_pick_progress(
    repo: Path,
    transaction: MergeTransaction,
    *,
    allow_completed: bool,
) -> tuple[tuple[str, ...], str]:
    """Bind live sequencer state to the immutable source commit sequence."""

    start_head = transaction.pre_merge_head
    current_head = git(repo, ["rev-parse", "HEAD"])
    git_dir = merge_git_dir(repo)
    sequencer = git_dir / "sequencer"
    source_commits = transaction.source_commits
    if sequencer.is_dir():
        try:
            sequencer_head = read_text(sequencer / "head").strip()
            abort_safety = read_text(sequencer / "abort-safety").strip()
            remaining = cherry_pick_todo_commits(repo, sequencer / "todo")
        except HLoopError:
            raise
        except OSError as exc:
            raise HLoopError("cherry-pick sequencer metadata is incomplete") from exc
        if sequencer_head != start_head:
            raise HLoopError("cherry-pick sequencer start HEAD does not match the transaction")
        if abort_safety != current_head:
            raise HLoopError("cherry-pick sequencer abort-safety was modified outside HLoop")
        applied_count = len(source_commits) - len(remaining)
        if applied_count < 0 or remaining != source_commits[applied_count:]:
            raise HLoopError("cherry-pick sequencer todo is not the expected source suffix")
        cherry_pick_head = git_dir / "CHERRY_PICK_HEAD"
        if cherry_pick_head.exists():
            current_source = read_text(cherry_pick_head).strip()
            if not remaining or current_source != remaining[0]:
                raise HLoopError("CHERRY_PICK_HEAD does not match the sequencer todo")
        elif transaction.status == MERGE_CONTENT_CONFLICT:
            raise HLoopError("conflicted cherry-pick is missing CHERRY_PICK_HEAD")
        applied = source_commits[:applied_count]
    else:
        if transaction.status == MERGE_CONTENT_CONFLICT and not allow_completed:
            raise HLoopError("conflicted cherry-pick sequencer is missing")
        if current_head == start_head:
            applied = ()
        elif allow_completed:
            applied = source_commits
        else:
            raise HLoopError("cherry-pick HEAD advanced without an active sequencer")
    if not is_ancestor(repo, start_head, current_head):
        raise HLoopError("cherry-pick HEAD is no longer descended from the transaction start")
    applied_count = int(
        git(repo, ["rev-list", "--first-parent", "--count", f"{start_head}..{current_head}"])
    )
    if applied_count != len(applied):
        raise HLoopError(
            "cherry-pick applied prefix does not match first-parent HEAD progress"
        )
    return tuple(applied), current_head


def observed_merge_transaction(
    repo: Path,
    transaction: MergeTransaction,
    *,
    allow_completed: bool = False,
) -> MergeTransaction:
    """Recompute the transaction's Git-observed identity fields right now.

    Used to detect an out-of-band reset, manual commit, or Worker-branch merge
    that happened outside the transaction while a merge was active or conflicted.
    """

    worker_head = (
        git(repo, ["rev-parse", transaction.branch])
        if branch_exists(repo, transaction.branch)
        else transaction.worker_head
    )
    if transaction.mode == "cherry-pick":
        applied_commits, applied_head = observe_cherry_pick_progress(
            repo, transaction, allow_completed=allow_completed
        )
    else:
        applied_commits = transaction.applied_commits
        applied_head = git(repo, ["rev-parse", "HEAD"])
    return dataclass_replace(
        transaction,
        worker_head=worker_head,
        applied_commits=applied_commits,
        applied_head=applied_head,
    )


def preflight_merge_transaction(repo: Path, active: dict[str, Any], op: str) -> MergeTransaction:
    """Transaction-aware preflight shared by abort, continue, and retry.

    Rejects the operation when it is not legal for the transaction's current
    status, and stops with ``manual-integration-trace`` when live Git
    observations no longer match the recorded transaction identity.
    """

    record = dict(active)
    if str(record.get("mode") or "squash") == "cherry-pick" and not record.get(
        "source_commits"
    ):
        # A pre-0.5 transaction already stored the immutable Worker base and
        # head but not the source sequence.  Reconstruct that sequence before
        # validating live progress so an in-flight recovery can be upgraded
        # without weakening the prefix/sequencer checks.
        worker_base = str(record.get("worker_base_sha") or "")
        worker_head = str(record.get("worker_head") or "")
        if not worker_base or not worker_head:
            raise HLoopError(
                "legacy cherry-pick transaction is missing Worker base/head identity"
            )
        record["source_commits"] = git(
            repo, ["rev-list", "--reverse", f"{worker_base}..{worker_head}"]
        ).splitlines()
    try:
        prior = MergeTransaction.from_record(record)
    except (TypeError, ValueError) as exc:
        raise HLoopError(f"merge transaction record is invalid: {exc}") from exc
    allowed = allowed_merge_operations(prior.status)
    if op not in allowed:
        raise HLoopError(
            f"`{op}` is not allowed for merge transaction status `{prior.status}`; "
            f"allowed operations: {', '.join(allowed)}"
        )
    observed = observed_merge_transaction(repo, prior)
    drift = validate_merge_transaction(prior, observed)
    if not drift.ok:
        raise HLoopError(
            "merge transaction drifted from recorded Git observations: "
            + "; ".join(issue.message for issue in drift.issues)
        )
    return prior


def transition_merge_transaction(
    repo: Path,
    state: dict[str, Any],
    prior: MergeTransaction,
    status: str,
    *,
    observed: MergeTransaction | None = None,
) -> MergeTransaction:
    candidate = dataclass_replace(observed or prior, status=status)
    result = validate_merge_transaction(prior, candidate)
    result.raise_for_errors()
    if status in (MERGE_ABORTED, MERGE_COMPLETED):
        state.pop("active_merge", None)
    else:
        existing = state.get("active_merge") or {}
        extra = {key: value for key, value in existing.items() if key not in candidate.to_record()}
        state["active_merge"] = {**extra, **candidate.to_record()}
    return candidate


def record_squash_tree(
    repo: Path,
    state: dict[str, Any],
    transaction: MergeTransaction,
) -> MergeTransaction:
    observed = dataclass_replace(transaction, squash_tree=git(repo, ["write-tree"]))
    recorded = transition_merge_transaction(
        repo,
        state,
        transaction,
        transaction.status,
        observed=observed,
    )
    save_state(repo, state)
    return recorded


def reconcile_completed_squash_merge(
    repo: Path,
    state: dict[str, Any],
    task_id: str,
) -> bool:
    """Finish STATE bookkeeping after a squash commit won the crash race."""

    active = state.get("active_merge") or {}
    if str(active.get("task_id") or "") != task_id:
        return False
    try:
        transaction = MergeTransaction.from_record(active)
    except (TypeError, ValueError) as exc:
        raise HLoopError(f"merge transaction record is invalid: {exc}") from exc
    if transaction.mode != "squash" or transaction.status not in {
        MERGE_ACTIVE,
        MERGE_CONTENT_CONFLICT,
    }:
        return False

    current_head = git(repo, ["rev-parse", "HEAD"])
    if current_head == transaction.pre_merge_head:
        return False

    expected_message = f"ai-loop({task_id}): squash {transaction.branch}"
    parents = git(repo, ["rev-list", "--parents", "-n", "1", current_head]).split()
    commit_tree = merge_transaction_index_state(repo, current_head)
    index_diff = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "diff", "--cached", "--quiet", current_head, "--"],
        check=False,
    )
    if index_diff.returncode not in {0, 1}:
        raise HLoopError(
            (index_diff.stderr or index_diff.stdout or "failed to compare the merge index").strip()
        )
    integration_head = git(repo, ["rev-parse", str(state["integration_branch"])])
    commit_subject = git(repo, ["show", "-s", "--format=%s", current_head])
    worker_head = (
        git(repo, ["rev-parse", transaction.branch])
        if branch_exists(repo, transaction.branch)
        else ""
    )
    mismatches: list[str] = []
    if not transaction.squash_tree:
        mismatches.append("transaction has no recorded squash tree")
    elif commit_tree != transaction.squash_tree:
        mismatches.append("commit tree differs from the recorded squash tree")
    if parents != [current_head, transaction.pre_merge_head]:
        mismatches.append("commit is not the single child of the pre-merge HEAD")
    if index_diff.returncode != 0:
        mismatches.append("index differs from the landed commit tree")
    if integration_head != current_head:
        mismatches.append("integration branch does not point at the landed commit")
    if commit_subject != expected_message:
        mismatches.append("commit subject does not identify the active squash transaction")
    if worker_head != transaction.worker_head:
        mismatches.append("Worker branch head differs from the active transaction")
    if mismatches:
        raise HLoopError(
            "active squash merge HEAD advanced without matching the recorded transaction: "
            + "; ".join(mismatches)
        )

    transition_merge_transaction(repo, state, transaction, MERGE_COMPLETED)
    complete_merge_state(repo, state, task_id, "squash")
    journal(repo, f"Reconciled landed squash commit `{current_head}` for Worker `{task_id}`.")
    return True


def cmd_merge_abort(repo: Path, state: dict[str, Any], task_id: str) -> int:
    active = state.get("active_merge") or {}
    if str(active.get("task_id") or "") != task_id:
        raise HLoopError(f"no active merge transaction for {task_id}")
    prior = preflight_merge_transaction(repo, active, "abort")
    if prior.mode == "cherry-pick" and (merge_git_dir(repo) / "sequencer").is_dir():
        git(repo, ["cherry-pick", "--abort"])
    else:
        git(repo, ["reset", "--merge", prior.pre_merge_head])
    restored_head = git(repo, ["rev-parse", "HEAD"])
    if restored_head != prior.pre_merge_head:
        raise HLoopError("merge abort did not restore the transaction start HEAD")
    transition_merge_transaction(repo, state, prior, MERGE_ABORTED)
    state["tasks"][task_id]["status"] = "result_reported"
    state["tasks"][task_id].pop("merge_error", None)
    state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Aborted merge transaction for `{task_id}` and restored `{prior.pre_merge_head}`.")
    print(f"aborted merge {task_id}")
    return 0


def cmd_merge_continue(repo: Path, state: dict[str, Any], task_id: str) -> int:
    active = state.get("active_merge") or {}
    if str(active.get("task_id") or "") != task_id:
        raise HLoopError(f"no active merge transaction for {task_id}")
    prior = preflight_merge_transaction(repo, active, "continue")
    unmerged = git(repo, ["diff", "--name-only", "--diff-filter=U"])
    if unmerged.strip():
        raise HLoopError("merge still has unresolved paths: " + ", ".join(unmerged.splitlines()))
    staged = git(repo, ["diff", "--cached", "--name-only"]).splitlines()
    violations = validate_change_scope(task_id, state["tasks"][task_id], staged)
    if violations:
        raise HLoopError("write-scope violations after conflict resolution: " + "; ".join(violations))
    if not staged:
        raise HLoopError("merge continue has no staged changes")
    mode = str(active.get("mode") or state.get("merge_mode") or "squash")
    if mode == "cherry-pick":
        try:
            git(repo, ["cherry-pick", "--continue"])
        except subprocess.CalledProcessError as exc:
            observed = observed_merge_transaction(repo, prior)
            transition_merge_transaction(
                repo,
                state,
                prior,
                MERGE_CONTENT_CONFLICT,
                observed=observed,
            )
            state["tasks"][task_id]["status"] = "blocked_merge_conflict"
            state["tasks"][task_id]["merge_error"] = command_error_detail(exc)
            state["phase"] = "blocked_conflict"
            save_state(repo, state)
            journal(
                repo,
                f"Cherry-pick continue for `{task_id}` reached another conflict after "
                f"{len(observed.applied_commits)} applied commit(s).",
            )
            raise
        observed = observed_merge_transaction(repo, prior, allow_completed=True)
        transition_merge_transaction(
            repo, state, prior, MERGE_COMPLETED, observed=observed
        )
    else:
        prior = record_squash_tree(repo, state, prior)
        git(repo, ["commit", "-m", f"ai-loop({task_id}): {mode} {state['tasks'][task_id]['branch']}"])
        transition_merge_transaction(repo, state, prior, MERGE_COMPLETED)
    complete_merge_state(repo, state, task_id, mode)
    print(f"continued merge {task_id}")
    return 0


def cmd_merge(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    task_id = args.task_id
    recovery_op = (
        "abort"
        if getattr(args, "abort", False)
        else "continue" if getattr(args, "continue_merge", False) else "retry" if getattr(args, "retry", False) else None
    )
    preexisting_active = (load_state(repo).get("active_merge") or {}) if recovery_op else {}
    recovering_active_transaction = bool(recovery_op) and str(preexisting_active.get("task_id") or "") == task_id
    # A conflicted or environment-failed merge transaction leaves the working
    # tree dirty on purpose; the transaction-aware preflight below is the
    # correct authority for abort/continue/retry, not the blanket dirty check.
    state = preflight_loop(
        repo,
        require_integration_branch=True,
        skip_dirty_check=recovering_active_transaction,
    )
    if reconcile_completed_squash_merge(repo, state, task_id):
        print(f"reconciled merge {task_id}")
        return 0
    if getattr(args, "abort", False):
        return cmd_merge_abort(repo, state, task_id)
    if getattr(args, "continue_merge", False):
        return cmd_merge_continue(repo, state, task_id)
    if getattr(args, "retry", False):
        active = state.get("active_merge") or {}
        if active:
            if str(active.get("task_id") or "") != task_id:
                raise HLoopError(f"no active merge transaction for {task_id}")
            preflight_merge_transaction(repo, active, "retry")
            cmd_merge_abort(repo, state, task_id)
            state = preflight_loop(repo, require_integration_branch=True)
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    block_reason = semantic_ack_barrier_blocking(task_state)
    if block_reason:
        raise HLoopError(f"cannot merge {task_id}: {block_reason}")
    if task_state.get("result_status") != "done" or task_state.get("merge_ready") is not True:
        raise HLoopError(f"task is not merge ready: {task_id}")
    if normalize_list(task_state.get("blocking_questions")):
        raise HLoopError(f"task has blocking questions: {task_id}")
    validation_error = worker_validation_error(
        task_state,
        require_recorded=True,
        require_passing=True,
    )
    if validation_error:
        raise HLoopError(f"task validation does not permit merge for {task_id}: {validation_error}")
    branch = task_state["branch"]
    mode = getattr(args, "mode", None) or state.get("merge_mode", "squash")
    if mode not in {"squash", "cherry-pick"}:
        raise HLoopError(f"unsupported merge mode: {mode}")
    if state_persistence(state) == "local-only" and mode != "squash":
        raise HLoopError("local-only persistence requires squash merge so loop artifacts stay local")
    actual_head = git(repo, ["rev-parse", branch])
    reported_head = str(task_state.get("head_sha") or "")
    if reported_head and reported_head != actual_head:
        if not args.dry_run:
            task_state["status"] = "blocked_head_mismatch"
            state["phase"] = "blocked_conflict"
            save_state(repo, state)
        raise HLoopError(
            f"worker head mismatch for {task_id}: result={reported_head} actual={actual_head}"
        )
    rel_result = (LOOP_DIR / "results" / task_id / "result.md").as_posix()
    git_show(repo, f"{actual_head}:{rel_result}")
    base_sha = str(task_state.get("worker_base_sha") or task_state.get("base_sha") or "")
    if not base_sha:
        raise HLoopError(f"manager base_sha is missing for {task_id}")
    reported_base_sha = str(task_state.get("reported_base_sha") or "")
    if reported_base_sha and reported_base_sha != base_sha:
        if not args.dry_run:
            task_state["status"] = "blocked_base_mismatch"
            state["phase"] = "blocked_conflict"
            save_state(repo, state)
        raise HLoopError(
            f"worker base mismatch for {task_id}: result={reported_base_sha} attempt={base_sha}"
        )
    if not is_ancestor(repo, base_sha, actual_head):
        raise HLoopError(f"worker base is not an ancestor of Worker head for {task_id}")
    integration_head = git(repo, ["rev-parse", str(state["integration_branch"])])
    if not is_ancestor(repo, base_sha, integration_head):
        raise HLoopError(f"worker base is not an ancestor of integration head for {task_id}")
    files = changed_files(repo, base_sha, actual_head)
    task_state["head_sha"] = actual_head
    task_state["changed_files"] = files
    files = normalize_list(task_state.get("changed_files"))
    violations = validate_change_scope(task_id, task_state, files)
    if violations:
        if not args.dry_run:
            task_state["status"] = "blocked_write_scope"
            state["phase"] = "blocked_conflict"
            save_state(repo, state)
        raise HLoopError("write-scope violations: " + "; ".join(violations))
    if args.dry_run:
        if mode == "squash":
            print(f"DRY RUN git merge --squash {branch}")
            print(f"DRY RUN git commit -m 'ai-loop({task_id}): squash {branch}'")
        else:
            commits = git(repo, ["rev-list", "--reverse", f"{base_sha}..{actual_head}"])
            print(f"DRY RUN git cherry-pick {' '.join(commits.splitlines())}")
        return 0
    commits = (
        git(repo, ["rev-list", "--reverse", f"{base_sha}..{actual_head}"]).splitlines()
        if mode == "cherry-pick"
        else []
    )
    if mode == "cherry-pick" and not commits:
        raise HLoopError(f"no commits to cherry-pick for {task_id}")
    attempt_id = str(task_state.get("active_attempt_id") or task_state.get("attempt_id") or f"{task_id}-A001")
    pre_merge_head = git(repo, ["rev-parse", "HEAD"])
    transaction = build_merge_transaction(
        task_id=task_id,
        attempt_id=attempt_id,
        branch=branch,
        pre_merge_head=pre_merge_head,
        worker_head=actual_head,
        index_state=merge_transaction_index_state(repo, "HEAD"),
        changed_paths=files,
        mode=mode,
        source_commits=commits,
    )
    state["active_merge"] = {
        **transaction.to_record(),
        "worker_base_sha": base_sha,
        "mode": mode,
        "started_at": now_iso(),
    }
    save_state(repo, state)
    try:
        staged = run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "diff", "--cached", "--quiet"], check=False)
        if staged.returncode != 0:
            raise HLoopError("index has staged changes; commit or unstage them before integration")
        if mode == "squash":
            git(repo, ["merge", "--squash", branch])
            if state_persistence(state) == "local-only":
                reset_loop = run_cmd(
                    [TRUSTED_GIT_PATH, "-C", str(repo), "reset", "HEAD", "--", LOOP_DIR.as_posix()],
                    check=False,
                )
                if reset_loop.returncode != 0:
                    raise HLoopError(
                        (reset_loop.stderr or reset_loop.stdout or "failed to unstage local-only loop artifacts").strip()
                    )
            transaction = record_squash_tree(repo, state, transaction)
            git(repo, ["commit", "-m", f"ai-loop({task_id}): squash {branch}"])
        else:
            git(repo, ["cherry-pick", *commits])
    except subprocess.CalledProcessError as exc:
        detail = command_error_detail(exc)
        observed = observed_merge_transaction(repo, transaction)
        if is_environment_git_error(detail):
            transition_merge_transaction(
                repo,
                state,
                transaction,
                MERGE_ENVIRONMENT_FAILURE,
                observed=observed,
            )
            task_state["status"] = "blocked_environment"
            task_state["merge_error"] = detail
            state["phase"] = "blocked_environment"
            state["last_merge_error"] = {"task_id": task_id, "at": now_iso(), "reason": detail}
            save_state(repo, state)
            journal(repo, f"Merge for `{task_id}` was blocked by git/environment state: {detail}")
            append_text(
                loop_path(repo) / "USER_ACTION_REQUIRED.md",
                f"\n## Merge environment blocker for {task_id}\n\n"
                f"Git could not update the integration worktree for `{branch}`:\n\n"
                f"```text\n{detail}\n```\n",
            )
            raise HLoopError(f"merge blocked by git/environment state for {task_id}: {detail}") from exc
        transition_merge_transaction(
            repo,
            state,
            transaction,
            MERGE_CONTENT_CONFLICT,
            observed=observed,
        )
        task_state["status"] = "blocked_merge_conflict"
        state["phase"] = "blocked_conflict"
        save_state(repo, state)
        journal(repo, f"Merge failed for `{task_id}` from `{branch}`. Resolve or abort manually.")
        append_text(
            loop_path(repo) / "USER_ACTION_REQUIRED.md",
            f"\n## Merge conflict for {task_id}\n\nResolve or abort the merge for `{branch}`.\n",
        )
        raise exc
    if mode == "cherry-pick":
        observed = observed_merge_transaction(repo, transaction, allow_completed=True)
        transition_merge_transaction(
            repo, state, transaction, MERGE_COMPLETED, observed=observed
        )
    else:
        transition_merge_transaction(repo, state, transaction, MERGE_COMPLETED)
    complete_merge_state(repo, state, task_id, mode)
    print(f"merged {task_id}")
    return 0


def cleanup_task(
    repo: Path,
    task_id: str,
    task_state: dict[str, Any],
    state: dict[str, Any] | None = None,
    dry_run: bool = False,
    best_effort: bool = False,
) -> None:
    branch = task_state.get("branch")
    worktree_raw = task_state.get("worktree")
    worktree = Path(worktree_raw).resolve() if worktree_raw else default_worktree(repo, task_id, state)
    try:
        if worktree.exists() and worktree != repo:
            if dry_run:
                print(f"DRY RUN git worktree remove {worktree}")
            else:
                cleanup_hloop_prompt_file(worktree, task_id, "worker")
                git(repo, ["worktree", "remove", str(worktree)])
        if branch and branch_exists(repo, branch):
            if dry_run:
                print(f"DRY RUN git branch -D {branch}")
            else:
                git(repo, ["branch", "-D", branch])
    except (HLoopError, subprocess.CalledProcessError) as exc:
        if best_effort:
            record_worktree_cleanup_failure(repo, task_state, f"Worker {task_id}", exc)
            return
        raise
    if not dry_run:
        task_state["cleanup_pending"] = False
        task_state["cleanup_done"] = True
        task_state["cleaned_at"] = now_iso()
        task_state.pop("worktree_cleanup_status", None)
        task_state.pop("worktree_cleanup_error", None)
        task_state.pop("worktree_cleanup_error_fingerprint", None)


def cleanup_merged_tasks(repo: Path, state: dict[str, Any], dry_run: bool = False) -> None:
    for task_id, task in state.get("tasks", {}).items():
        if task.get("status") == "merged" and task.get("cleanup_pending"):
            cleanup_completed_agent_pane(
                repo,
                task,
                label=f"Worker {task_id}",
                session_cleanup=str(state.get("session_cleanup", "archive")),
                dry_run=dry_run,
            )
            cleanup_task(repo, task_id, task, state, dry_run=dry_run, best_effort=True)


def iter_all_roles(state: dict[str, Any]):
    """Yield ``(role_kind, role_id, role_state)`` for every Worker, Reviewer,
    Gap Auditor, Advisor participant, Specification Scout, and Decision
    Liaison so the finish gate and ``cleanup resolve`` can address any role by
    a single ID."""

    for task_id, task in state.get("tasks", {}).items():
        yield "worker", task_id, task
    for review_id, review in state.get("reviews", {}).items():
        yield "reviewer", review_id, review
    for gap_id, gap in state.get("gaps", {}).items():
        yield "gap", gap_id, gap
    for advice_id, advice in state.get("advice", {}).items():
        if not isinstance(advice, dict):
            continue
        for participant in advice.get("participants", []):
            participant_id = str(participant.get("participant_id") or "P1")
            yield "advisor", f"{advice_id}/{participant_id}", participant
    scout = state.get("specification_scout_run")
    if isinstance(scout, dict) and scout:
        yield "specification-scout", "S001", scout
    for decision_id, liaison in (state.get("decision_liaisons") or {}).items():
        if isinstance(liaison, dict):
            yield "decision-liaison", f"L-{decision_id}", liaison


def role_cleanup_failures(role_state: dict[str, Any]) -> dict[str, tuple[str, str]]:
    """Map failure kind (``worktree``, ``pane``, ``session``) to ``(detail, fingerprint)``."""

    failures: dict[str, tuple[str, str]] = {}
    if role_state.get("worktree_cleanup_status") == "failed":
        failures["worktree"] = (
            str(role_state.get("worktree_cleanup_error") or ""),
            str(role_state.get("worktree_cleanup_error_fingerprint") or ""),
        )
    if role_state.get("pane_cleanup_status") == "failed":
        failures["pane"] = (
            str(role_state.get("pane_cleanup_error") or ""),
            str(role_state.get("pane_cleanup_error_fingerprint") or ""),
        )
    if role_state.get("agent_session_cleanup_error"):
        failures["session"] = (
            str(role_state.get("agent_session_cleanup_error") or ""),
            str(role_state.get("agent_session_cleanup_error_fingerprint") or ""),
        )
    return failures


def unresolved_cleanup_failures(role_state: dict[str, Any]) -> dict[str, tuple[str, str]]:
    """Active failures minus those covered by a matching cleaned/accepted-risk resolution.

    A provider or environment that does not support a cleanup step records
    ``skipped:...`` or ``unsupported`` statuses, which never reach here since
    only ``failed`` statuses and session errors are considered failures.
    """

    failures = role_cleanup_failures(role_state)
    resolutions = role_state.get("cleanup_resolutions") or {}
    unresolved: dict[str, tuple[str, str]] = {}
    for kind, (detail, fingerprint) in failures.items():
        resolution = resolutions.get(kind)
        if isinstance(resolution, dict) and fingerprint and resolution.get("error_fingerprint") == fingerprint:
            continue
        unresolved[kind] = (detail, fingerprint)
    return unresolved


def find_role_for_cleanup(state: dict[str, Any], role_id: str) -> tuple[str, str, dict[str, Any]]:
    if role_id in state.get("tasks", {}):
        return "worker", role_id, state["tasks"][role_id]
    if role_id in state.get("reviews", {}):
        return "reviewer", role_id, state["reviews"][role_id]
    if role_id in state.get("gaps", {}):
        return "gap", role_id, state["gaps"][role_id]
    advice_id, _, participant_id = role_id.partition("/")
    advice = state.get("advice", {}).get(advice_id)
    if isinstance(advice, dict):
        participants = advice.get("participants", [])
        if participant_id:
            return "advisor", role_id, find_advisor_participant(advice, participant_id)
        if len(participants) == 1:
            only = participants[0]
            resolved_id = f"{advice_id}/{only.get('participant_id') or 'P1'}"
            return "advisor", resolved_id, only
        raise HLoopError(
            f"advisor request `{advice_id}` has multiple participants; "
            "specify `<advice-id>/<participant-id>`"
        )
    raise HLoopError(f"unknown role id: {role_id}")


def retry_role_cleanup(
    repo: Path, state: dict[str, Any], role_kind: str, role_id: str, role_state: dict[str, Any]
) -> None:
    label = f"{role_kind.capitalize()} {role_id}"
    session_cleanup = str(state.get("session_cleanup", "archive"))
    if role_state.get("pane_cleanup_status") == "failed" and role_state.get("pane_id"):
        cleanup_completed_agent_pane(repo, role_state, label=label, session_cleanup=session_cleanup)
    if role_state.get("agent_session_cleanup_error"):
        session_id = str(role_state.get("agent_session_id") or "")
        provider = str(
            role_state.get("agent_session_provider") or role_state.get("agent_provider") or DEFAULT_AGENT_PROVIDER
        )
        if session_id:
            retry_agent_session_cleanup(
                repo, role_state, label=label, provider=provider, session_id=session_id, session_cleanup=session_cleanup
            )
    if role_state.get("worktree_cleanup_status") == "failed":
        if role_kind == "worker":
            cleanup_task(repo, role_id, role_state, state, best_effort=True)
        elif role_kind == "reviewer":
            cleanup_review_worktree(repo, role_id, role_state, best_effort=True)
        elif role_kind == "gap":
            cleanup_gap_worktree(repo, role_id, role_state, best_effort=True)
        elif role_kind == "advisor":
            advice_id, _, _participant_id = role_id.partition("/")
            cleanup_advisor_worktree(repo, advice_id, role_state, best_effort=True)


def cmd_cleanup_resolve(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, mark_blocked=False, skip_dirty_check=True)
    role_kind, role_id, role_state = find_role_for_cleanup(state, args.role_id)
    status = args.status
    if status not in {"cleaned", "accepted-risk"}:
        raise HLoopError("--status must be cleaned or accepted-risk")
    reason = str(args.reason or "").strip()
    if not reason:
        raise HLoopError("--reason is required")
    before = role_cleanup_failures(role_state)
    if not before:
        raise HLoopError(f"no active cleanup failure for {role_kind} {role_id}")
    manager_identity = str(os.environ.get("HLOOP_MANAGER_IDENTITY") or os.environ.get("USER") or "manager")
    resolutions = role_state.setdefault("cleanup_resolutions", {})
    history = state.setdefault("cleanup_history", [])
    resolved_at = now_iso()
    attempt_id = str(
        role_state.get("attempt_id") or role_state.get("active_attempt_id") or f"{role_id}-A001"
    )
    run_id = str(state.get("run_id") or "local")

    def audit(kind: str, detail: str, fingerprint: str, record_status: str) -> dict[str, Any]:
        record = cleanup_resolution_record(
            run_id=run_id,
            role_id=role_id,
            attempt_id=attempt_id,
            status=record_status,
            reason=reason,
            manager_identity=manager_identity,
            resolved_at=resolved_at,
            error_fingerprint=fingerprint or cleanup_error_fingerprint(kind, detail),
        )
        return record.to_record()

    if status == "cleaned":
        retry_role_cleanup(repo, state, role_kind, role_id, role_state)
        remaining = role_cleanup_failures(role_state)
        for kind, (detail, fingerprint) in before.items():
            if kind in remaining:
                continue
            history.append(audit(kind, detail, fingerprint, "cleaned"))
            resolutions.pop(kind, None)
        save_state(repo, state)
        if remaining:
            raise HLoopError(
                f"cleanup retry did not clear all failures for {role_kind} {role_id}: "
                + ", ".join(sorted(remaining))
                + "; use `--status accepted-risk` to proceed intentionally"
            )
    else:
        for kind, (detail, fingerprint) in before.items():
            record = audit(kind, detail, fingerprint, "accepted-risk")
            resolutions[kind] = record
            history.append(record)
        save_state(repo, state)
    journal(repo, f"Resolved cleanup for {role_kind} `{role_id}` as `{status}`: {reason}")
    print(f"resolved cleanup for {role_id}: {status}")
    return 0


def validation_log_rel(state: dict[str, Any], index: int) -> Path:
    cycle = int(state.get("cycle", 0))
    return LOOP_DIR / "validation" / f"cycle-{cycle:04d}-{index:02d}.log"


def normalize_validation_log_output(output: str) -> str:
    if not output:
        return ""
    pieces: list[str] = []
    for line in output.splitlines(keepends=True):
        newline = ""
        body = line
        if line.endswith("\r\n"):
            body = line[:-2]
            newline = "\n"
        elif line.endswith("\n") or line.endswith("\r"):
            body = line[:-1]
            newline = "\n"
        pieces.append(body.rstrip() + newline)
    return "".join(pieces)


def cmd_validate(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_integration_branch=True,
        mark_blocked=not args.dry_run,
    )
    commands = getattr(args, "validation_command", None) or state.get("validation_commands") or []
    if not commands:
        raise HLoopError(
            "integration validation is not configured; use `hloop validation configure --command ...`"
        )
    head_sha = git(repo, ["rev-parse", str(state["integration_branch"])])
    state["integration_head_sha"] = head_sha
    state["completion_target_sha"] = head_sha
    results = []
    failed = False
    for index, command in enumerate(commands, start=1):
        if args.dry_run:
            print(f"DRY RUN {command}")
            results.append({"command": command, "result": "dry-run"})
            continue
        validation_env = os.environ.copy()
        validation_env["PYTHONDONTWRITEBYTECODE"] = "1"
        proc = subprocess.run(
            command,
            cwd=str(repo),
            text=True,
            shell=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=validation_env,
        )
        output = proc.stdout or ""
        if output:
            sys.stdout.write(output)
            if not output.endswith("\n"):
                sys.stdout.write("\n")
        log_rel = validation_log_rel(state, index)
        completed_at = now_iso()
        header = (
            f"command: {command}\nhead_sha: {head_sha}\ncompleted_at: {completed_at}\n"
            f"returncode: {proc.returncode}\n\n"
        )
        write_text(repo / log_rel, header + normalize_validation_log_output(output))
        result = "passed" if proc.returncode == 0 else f"failed:{proc.returncode}"
        results.append(
            {
                "command": command,
                "result": result,
                "returncode": proc.returncode,
                "log": log_rel.as_posix(),
            }
        )
        if proc.returncode != 0:
            failed = True
            break
    if not args.dry_run:
        state["last_validation"] = {"at": now_iso(), "head_sha": head_sha, "results": results}
        state["needs_validation"] = failed
        if failed:
            state["phase"] = "failed_validation"
        else:
            if not getattr(args, "no_cleanup", False):
                cleanup_merged_tasks(repo, state)
            if should_open_gap_gate(state):
                state["needs_gap_check"] = True
            if should_open_review_gate(state):
                state["needs_review"] = True
            if state.get("needs_gap_check"):
                state["phase"] = "gap_checking"
            elif state.get("needs_review"):
                state["phase"] = "reviewing"
            else:
                state["phase"] = "dispatching"
        save_state(repo, state)
        journal(repo, f"Validation results: {results}")
    return 1 if failed else 0


def cmd_validation_configure(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    commands = normalize_list(args.validation_command)
    if not commands:
        raise HLoopError("provide at least one --command")
    state["validation_commands"] = commands
    save_state(repo, state)
    journal(repo, f"Configured integration validation commands: {commands}")
    print("configured integration validation")
    return 0


def cmd_reviewer_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    topology = resolved_reviewer_topology(
        state,
        mode=getattr(args, "mode", None),
        providers=getattr(args, "providers", None),
        probe_count=getattr(args, "probe_count", None),
        probes_per_provider=getattr(args, "probes_per_provider", None),
    )
    mode = topology["mode"]
    review_id = args.review_id or next_id("R", state.setdefault("reviews", {}))
    if review_id in state["reviews"]:
        raise HLoopError(f"review already exists: {review_id}")
    base = args.base or state["base_branch"]
    head = args.head or state["integration_branch"]
    base_sha = git(repo, ["rev-parse", base])
    head_sha = git(repo, ["rev-parse", head])
    require_role_snapshot(repo, state, head_sha, audit_snapshot_paths(repo))
    worktree_arg = getattr(args, "worktree", None)
    worktree = Path(worktree_arg).resolve() if worktree_arg else default_review_worktree(repo, review_id, state)
    prompt_rel = LOOP_DIR / "prompts" / f"{review_id}.reviewer.md"
    prompt_path = worktree / prompt_rel
    runner = args.runner or state.get("reviewer_runner", "tui")
    agent_config = role_agent_config(
        state,
        "reviewer",
        overrides={
            "agent_provider": getattr(args, "agent_provider", None),
            "agent_model": getattr(args, "agent_model", None),
        },
    )
    review_plan = build_reviewer_group_plan(mode, head_sha, agent_config, topology=topology)
    # Numeric-only preview: this runs even for --dry-run, before any provider
    # is required to be installed. The real per-provider capability probe
    # only runs on the actual launch path below, after `--dry-run` returns.
    hloop_providers.check_review_capacity(
        hloop_review.required_provider_capacity(review_plan),
        limits=state.get("review_capacity_limits"),
    )
    review_rel = (
        LOOP_DIR / "reviews" / review_id / "FINAL.md"
        if mode != "single"
        else LOOP_DIR / "reviews" / f"{review_id}.md"
    )
    worktree_review_path = worktree / review_rel
    review_path = (
        review_final_file(repo, review_id)
        if mode != "single"
        else review_file(repo, review_id)
    )
    prompt = render_reviewer_prompt(
        review_id,
        base,
        head,
        state,
        agent_config=agent_config,
        head_sha=head_sha,
        review_plan=review_plan,
    )
    agent_command, preview_invocation = role_agent_command(
        repo,
        agent_config,
        runner=runner,
        prompt_rel=prompt_rel,
        cwd=worktree,
        output_rel=review_rel if runner == "exec" and mode == "single" else None,
    )
    command = f"cd {shlex.quote(str(worktree))} && {agent_command}"
    if args.dry_run:
        print(f"DRY RUN worktree: git worktree add --detach {worktree} {head_sha}")
        print(f"DRY RUN prompt: {prompt_path}")
        print(f"DRY RUN {args.launcher}/{runner} command: {command}")
        return 0
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_agent_invocation=preview_invocation,
        require_integration_branch=True,
    )
    if review_id in state["reviews"]:
        raise HLoopError(f"review already exists: {review_id}")
    base = args.base or state["base_branch"]
    head = args.head or state["integration_branch"]
    base_sha = git(repo, ["rev-parse", base])
    head_sha = git(repo, ["rev-parse", head])
    require_role_snapshot(repo, state, head_sha, audit_snapshot_paths(repo))
    worktree_arg = getattr(args, "worktree", None)
    worktree = Path(worktree_arg).resolve() if worktree_arg else default_review_worktree(repo, review_id, state)
    prompt_path = worktree / prompt_rel
    runner = args.runner or state.get("reviewer_runner", "tui")
    agent_config = role_agent_config(
        state,
        "reviewer",
        overrides={
            "agent_provider": getattr(args, "agent_provider", None),
            "agent_model": getattr(args, "agent_model", None),
        },
    )
    review_plan = build_reviewer_group_plan(mode, head_sha, agent_config, topology=topology)
    capacity_check = hloop_providers.check_review_capacity(
        hloop_review.required_provider_capacity(review_plan),
        limits=state.get("review_capacity_limits"),
        capability=review_capacity_evidence(review_plan),
    )
    review_rel = (
        LOOP_DIR / "reviews" / review_id / "FINAL.md"
        if mode != "single"
        else LOOP_DIR / "reviews" / f"{review_id}.md"
    )
    worktree_review_path = worktree / review_rel
    review_path = (
        review_final_file(repo, review_id)
        if mode != "single"
        else review_file(repo, review_id)
    )
    attempt_id = f"{review_id}-A001"
    prompt_without_identity = render_reviewer_prompt(
        review_id,
        base,
        head,
        state,
        agent_config=agent_config,
        head_sha=head_sha,
        review_plan=review_plan,
    )
    task_contract_digest = prompt_contract_digest(prompt_without_identity)
    agent_command, provider_invocation = role_agent_command(
        repo,
        agent_config,
        runner=runner,
        prompt_rel=prompt_rel,
        cwd=worktree,
        output_rel=review_rel if runner == "exec" and mode == "single" else None,
    )
    command = f"cd {shlex.quote(str(worktree))} && {agent_command}"
    require_role_snapshot(repo, state, head_sha, audit_snapshot_paths(repo))
    worktree_preexisting = worktree.exists()
    if not worktree_preexisting:
        git(repo, ["worktree", "add", "--detach", str(worktree), head_sha])
    try:
        prepare_role_worktree(repo, worktree, state, role="reviewer", agent_id=review_id)
        ensure_review_visible_in_worktree(worktree)
        ensure_worktree_parent_dirs(worktree, prompt_rel, review_rel)
        report_credential_file, initial_ack_floor = register_role_report_identity_and_ack_floor(
            repo,
            state,
            role_id=review_id,
            attempt_id=attempt_id,
            task_contract_digest=task_contract_digest,
        )
        prompt = render_reviewer_prompt(
            review_id,
            base,
            head,
            state,
            agent_config=agent_config,
            head_sha=head_sha,
            review_plan=review_plan,
            report_credential_file=str(report_credential_file),
            task_contract_digest=task_contract_digest,
            attempt_id=attempt_id,
        )
        write_text(prompt_path, prompt)
        baseline_dirty = porcelain_paths(worktree)
        if args.launcher == "agent":
            pane_id = start_agent_launcher(
                name=f"hloop-{state['goal_id']}-{review_id}-reviewer",
                direction=args.direction,
                cwd=worktree,
                command=command,
            )
        else:
            manager_pane = args.manager_pane or current_pane_id()
            pane_id = start_pane_launcher(
                manager_pane=manager_pane,
                direction=args.direction,
                cwd=worktree,
                command=command,
            )
    except (
        HLoopError,
        hloop_broker.BrokerStorageError,
        OSError,
        subprocess.CalledProcessError,
    ):
        try:
            rollback_failed_role_start(
                repo, worktree, created_worktree=not worktree_preexisting
            )
        finally:
            revoke_active_role_report_identity(repo, state, review_id)
        raise
    state["reviews"][review_id] = {
        "status": "running",
        "gate_status": "running",
        "mode": mode,
        "review_plan": review_plan.to_record(),
        "review_providers": list(review_plan.providers),
        "capacity_check": [result.as_record() for result in capacity_check],
        "base": base,
        "head": head,
        "base_sha": base_sha,
        "head_sha": head_sha,
        "pane_id": pane_id,
        "runner": runner,
        "agent_provider": agent_config["provider"],
        "agent_model": agent_config["model"],
        "agent_effort": agent_config["effort"],
        "claude_permission_mode": agent_config["claude_permission_mode"],
        "attempt_id": attempt_id,
        "fallback_provider": agent_config["fallback_provider"],
        "skill_version": SKILL_VERSION,
        "sandbox": "workspace-write",
        "worktree": str(worktree),
        "prompt": str(prompt_path),
        "review_path": str(review_path),
        "worktree_review_path": str(worktree_review_path),
        "baseline_dirty_files": baseline_dirty,
        "started_at": now_iso(),
        "provider_invocation": provider_invocation.as_record(),
    }
    arm_initial_semantic_ack_barrier(
        state["reviews"][review_id],
        attempt_id=attempt_id,
        contract_digest=task_contract_digest,
        required_reack_after_sequence=initial_ack_floor,
    )
    state["phase"] = "reviewing"
    save_state(repo, state)
    journal(repo, f"Started Reviewer `{review_id}` in pane `{pane_id}` and worktree `{worktree}`.")
    print(f"started {review_id} in pane {pane_id}; watch with `hloop reviewer watch {review_id}`")
    return 0


def cmd_reviewer_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    review_id = args.review_id
    review_state = state.get("reviews", {}).get(review_id)
    if not review_state:
        raise HLoopError(f"unknown review: {review_id}")
    block_reason = semantic_ack_barrier_blocking(review_state)
    if block_reason:
        raise HLoopError(f"cannot harvest {review_id}: {block_reason}")
    path = review_artifact_path(repo, review_id, review_state)
    if not path.exists() or not read_text(path).strip():
        raise HLoopError(f"review artifact not found or empty: {path}")
    meta = read_frontmatter(path)
    identity_error = artifact_identity_error(state, review_id, "reviewer", review_state, meta)
    if identity_error:
        raise HLoopError(f"stale or mismatched Reviewer artifact: {identity_error}: {path}")
    artifact_status = str(meta.get("status", ""))
    if artifact_status not in REVIEW_ARTIFACT_STATUSES:
        raise HLoopError(f"invalid review artifact status in {path}: {artifact_status}")
    reported_review_id = str(meta.get("review_id") or "")
    if reported_review_id and reported_review_id != review_id:
        raise HLoopError(f"review_id mismatch: expected {review_id}, got {reported_review_id}")
    if is_directory_review(review_state):
        worktree_raw = str(review_state.get("worktree") or "")
        if not worktree_raw:
            raise HLoopError(f"directory review has no worktree: {review_id}")
        worktree = Path(worktree_raw).resolve()
        manifest_source = review_manifest_file(worktree, review_id)
        manifest = load_review_manifest(manifest_source)
        if manifest.review_id != review_id:
            raise HLoopError(
                f"review manifest id mismatch: expected {review_id}, got {manifest.review_id}"
            )
        try:
            expected_plan = hloop_review.ReviewGroupPlan.from_record(
                review_state.get("review_plan")
            )
        except hloop_review.ReviewModelError as exc:
            raise HLoopError(f"stored review plan is invalid for {review_id}: {exc}") from exc
        if manifest.plan != expected_plan:
            raise HLoopError(
                f"review manifest plan drift for {review_id}; the started topology or target SHA changed"
            )
        provider_sources: dict[str, Path] = {}
        provider_statuses: dict[str, str] = {}
        for provider in expected_plan.providers:
            provider_path = review_provider_file(worktree, review_id, provider)
            if not provider_path.exists() or not read_text(provider_path).strip():
                raise HLoopError(
                    f"review provider artifact not found or empty: {provider_path}"
                )
            provider_meta = read_frontmatter(provider_path)
            provider_identity_error = artifact_identity_error(
                state, review_id, "reviewer", review_state, provider_meta
            )
            if provider_identity_error:
                raise HLoopError(
                    "stale or mismatched review provider artifact: "
                    f"{provider_identity_error}: {provider_path}"
                )
            if str(provider_meta.get("provider") or "") != provider:
                raise HLoopError(
                    f"review provider mismatch: expected {provider}, "
                    f"got {provider_meta.get('provider')}: {provider_path}"
                )
            provider_status = str(provider_meta.get("status") or "")
            if provider_status not in REVIEW_ARTIFACT_STATUSES:
                raise HLoopError(f"invalid provider artifact status in {provider_path}")
            provider_sources[provider] = provider_path
            provider_statuses[provider] = provider_status

        final_path = review_final_file(repo, review_id)
        manifest_path = review_manifest_file(repo, review_id)
        write_text(final_path, read_text(path))
        write_text(
            manifest_path,
            json.dumps(manifest.to_record(), ensure_ascii=False, indent=2, sort_keys=True)
            + "\n",
        )
        provider_paths = {}
        for provider, provider_source in provider_sources.items():
            provider_target = review_provider_file(repo, review_id, provider)
            write_text(provider_target, read_text(provider_source))
            provider_paths[provider] = str(provider_target)
        review_state["manifest_path"] = str(manifest_path)
        review_state["provider_report_paths"] = provider_paths
        review_state["provider_artifact_statuses"] = provider_statuses
        review_state["manifest_complete"] = manifest.completeness.complete
        review_state["manifest_issues"] = list(manifest.completeness.issues)
        review_state["confirmed_finding_fingerprints"] = list(
            manifest.confirmed_fingerprints
        )
    else:
        final_path = review_file(repo, review_id)
        if path.resolve() != final_path.resolve():
            write_text(final_path, read_text(path))
    if path.resolve() != final_path.resolve():
        review_state["worktree_review_path_harvested"] = str(path)
        review_state.pop("worktree_review_path", None)
    worktree_raw = review_state.get("worktree")
    violations: list[str] = []
    if worktree_raw:
        worktree = Path(worktree_raw).resolve()
        if worktree.exists():
            violations = validate_reviewer_worktree_scope(review_id, review_state, worktree)
    review_state["write_scope_violations"] = violations
    review_state["review_path"] = str(final_path)
    review_state["status"] = "reported"
    review_state["gate_status"] = "reported"
    review_state["artifact_status"] = artifact_status
    review_state["harvested_at"] = now_iso()
    cleanup_completed_agent_pane(
        repo,
        review_state,
        label=f"Reviewer {review_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    revoke_active_role_report_identity(repo, state, review_id)
    state["last_review_id"] = review_id
    state["needs_review"] = True
    if violations:
        review_state["status"] = "blocked_write_scope"
        review_state["gate_status"] = "blocked_write_scope"
        state["phase"] = "blocked_conflict"
        save_state(repo, state)
        journal(
            repo,
            f"Harvested Reviewer `{review_id}` but blocked because it changed files outside the review artifact: {violations}",
        )
        append_text(
            loop_path(repo) / "USER_ACTION_REQUIRED.md",
            f"\n## Reviewer write-scope violation for {review_id}\n\n"
            f"Review artifact was copied to `{final_path}` but the review worktree has unexpected changes:\n"
            + "\n".join(f"- {item}" for item in violations)
            + "\n",
        )
        print(f"blocked {review_id}: reviewer changed files outside the review artifact")
        return 2
    cleanup_review_worktree(repo, review_id, review_state, best_effort=True)
    state["phase"] = "reviewing"
    save_state(repo, state)
    journal(repo, f"Harvested Reviewer `{review_id}`; Manager triage is required.")
    print(f"harvested {review_id}; run `hloop reviewer close {review_id} --verdict <verdict>` after triage")
    return 0


def enforce_review_manifest_gate(
    repo: Path, review_id: str, review_state: dict[str, Any]
) -> None:
    """Refuse to close non-single-mode reviews with an incomplete review manifest."""

    mode = str(review_state.get("mode") or "single")
    if mode == "single":
        return
    manifest = load_review_manifest(
        recorded_path(
            repo,
            review_state.get("manifest_path"),
            review_manifest_file(repo, review_id),
        )
    )
    try:
        expected_plan = hloop_review.ReviewGroupPlan.from_record(
            review_state.get("review_plan")
        )
    except hloop_review.ReviewModelError as exc:
        raise HLoopError(f"stored review plan is invalid for {review_id}: {exc}") from exc
    if manifest.review_id != review_id or manifest.plan != expected_plan:
        raise HLoopError(f"review manifest identity or immutable plan mismatch for {review_id}")
    completeness = manifest.completeness
    provider_statuses = review_state.get("provider_artifact_statuses") or {}
    non_reported_artifacts = [
        f"provider-artifact:{provider}:{provider_statuses.get(provider, 'missing')}"
        for provider in expected_plan.providers
        if provider_statuses.get(provider) != "reported"
    ]
    if str(review_state.get("artifact_status") or "") != "reported":
        non_reported_artifacts.append(
            f"final-artifact:{review_state.get('artifact_status') or 'missing'}"
        )
    if non_reported_artifacts:
        raise HLoopError(
            f"review manifest incomplete for {review_id} (mode={mode}): "
            + "; ".join(non_reported_artifacts)
        )
    if not completeness.complete:
        raise HLoopError(
            f"review manifest incomplete for {review_id} (mode={mode}): "
            + "; ".join(completeness.issues)
        )


def cmd_reviewer_close(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    review_id = args.review_id
    review_state = state.get("reviews", {}).get(review_id)
    if not review_state:
        raise HLoopError(f"unknown review: {review_id}")
    if agent_gate_status(review_state) not in {"reported", "triaged"}:
        raise HLoopError(f"review is not ready for close: {review_id}")
    enforce_review_manifest_gate(repo, review_id, review_state)
    cleanup_completed_agent_pane(
        repo,
        review_state,
        label=f"Reviewer {review_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    cleanup_review_worktree(repo, review_id, review_state, best_effort=True)
    review_state["status"] = "triaged"
    review_state["gate_status"] = "triaged"
    review_state["verdict"] = args.verdict
    review_state["triage_reason"] = args.reason
    review_state["triaged_at"] = now_iso()
    review_state["closed_head_sha"] = review_state.get("head_sha")
    if args.verdict == "blocked":
        state["needs_review"] = True
        state["phase"] = "blocked_user_decision"
    else:
        state["needs_review"] = False
        state["unreviewed_merge_count"] = 0
        if args.verdict == "fix-tasks-created":
            state["phase"] = "dispatching"
        elif state.get("needs_gap_check"):
            state["phase"] = "gap_checking"
        else:
            state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Closed Reviewer `{review_id}` with verdict `{args.verdict}`: {args.reason}")
    print(f"closed {review_id}: {args.verdict}")
    return 0


def cmd_reviewer_watch(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    review_id = args.review_id
    review_state = state.get("reviews", {}).get(review_id)
    if not review_state:
        raise HLoopError(f"unknown review: {review_id}")
    pane_id = str(review_state.get("pane_id") or "")
    print(f"review: {review_id}")
    print(f"status: {review_state.get('status')}")
    print(f"gate_status: {agent_gate_status(review_state)}")
    print(f"artifact_status: {review_state.get('artifact_status', '')}")
    print(f"runner: {review_state.get('runner')}")
    print(f"worktree: {review_state.get('worktree', '')}")
    print(f"artifact: {review_artifact_path(repo, review_id, review_state)}")
    if not pane_id:
        print("pane: none")
        return 0
    print(f"pane: {pane_id}")
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        print("pane output unavailable: not inside Herdr")
        return 0
    info = pane_info(pane_id)
    if info is None:
        print("pane output unavailable: pane is closed or missing")
        return 0
    print(f"agent_status: {info.get('agent_status', 'unknown')}")
    proc = run_cmd(
        [
            "herdr",
            "pane",
            "read",
            pane_id,
            "--source",
            args.source,
            "--lines",
            str(args.lines),
        ],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    print(proc.stdout.rstrip())
    return 0


def cmd_reviewer_message(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    review_id = args.review_id
    review_state = state.get("reviews", {}).get(review_id)
    if not review_state:
        raise HLoopError(f"unknown review: {review_id}")
    if agent_gate_status(review_state) != "running":
        raise HLoopError(f"reviewer is not running: {review_id} status={review_state.get('status')}")
    pane_id = str(review_state.get("pane_id") or "")
    if not pane_id:
        raise HLoopError(f"reviewer has no pane_id: {review_id}")
    message, source = manager_message_from_args(args)
    if not message.strip():
        raise HLoopError("manager message is empty")
    return send_manager_message_and_record(
        repo,
        state,
        review_state,
        role="Reviewer",
        agent_id=review_id,
        pane_id=pane_id,
        message=message,
        source=source,
        args=args,
    )


def cmd_gap_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    gap_id = args.gap_id or next_id("G", state.setdefault("gaps", {}))
    if gap_id in state["gaps"]:
        raise HLoopError(f"gap audit already exists: {gap_id}")
    base = args.base or state["base_branch"]
    head = args.head or state["integration_branch"]
    base_sha = git(repo, ["rev-parse", base])
    head_sha = git(repo, ["rev-parse", head])
    require_role_snapshot(repo, state, head_sha, audit_snapshot_paths(repo))
    worktree_arg = getattr(args, "worktree", None)
    worktree = Path(worktree_arg).resolve() if worktree_arg else default_gap_worktree(repo, gap_id, state)
    spec_sources = normalize_list(getattr(args, "spec_source", None)) or normalize_list(
        state.get("spec_sources")
    )
    prompt_rel = LOOP_DIR / "prompts" / f"{gap_id}.gap.md"
    gap_rel = LOOP_DIR / "gaps" / f"{gap_id}.md"
    prompt_path = worktree / prompt_rel
    worktree_gap_path = worktree / gap_rel
    final_gap_path = gap_file(repo, gap_id)
    runner = args.runner or state.get("gap_runner", "tui")
    agent_config = role_agent_config(
        state,
        "gap",
        overrides={
            "agent_provider": getattr(args, "agent_provider", None),
            "agent_model": getattr(args, "agent_model", None),
        },
    )
    attempt_id = f"{gap_id}-A001"
    prompt_without_identity = render_gap_prompt(
        gap_id, base, head, spec_sources, state, agent_config=agent_config, head_sha=head_sha
    )
    agent_command, preview_invocation = role_agent_command(
        repo,
        agent_config,
        runner=runner,
        prompt_rel=prompt_rel,
        cwd=worktree,
        output_rel=gap_rel if runner == "exec" else None,
    )
    command = f"cd {shlex.quote(str(worktree))} && {agent_command}"
    if args.dry_run:
        print(f"DRY RUN worktree: git worktree add --detach {worktree} {head_sha}")
        print(f"DRY RUN prompt: {prompt_path}")
        print(f"DRY RUN {args.launcher}/{runner} command: {command}")
        return 0
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_agent_invocation=preview_invocation,
        require_integration_branch=True,
    )
    if gap_id in state.setdefault("gaps", {}):
        raise HLoopError(f"gap audit already exists: {gap_id}")
    base = args.base or state["base_branch"]
    head = args.head or state["integration_branch"]
    base_sha = git(repo, ["rev-parse", base])
    head_sha = git(repo, ["rev-parse", head])
    worktree_arg = getattr(args, "worktree", None)
    worktree = Path(worktree_arg).resolve() if worktree_arg else default_gap_worktree(repo, gap_id, state)
    spec_sources = normalize_list(getattr(args, "spec_source", None)) or normalize_list(
        state.get("spec_sources")
    )
    prompt_path = worktree / prompt_rel
    worktree_gap_path = worktree / gap_rel
    final_gap_path = gap_file(repo, gap_id)
    runner = args.runner or state.get("gap_runner", "tui")
    agent_config = role_agent_config(
        state,
        "gap",
        overrides={
            "agent_provider": getattr(args, "agent_provider", None),
            "agent_model": getattr(args, "agent_model", None),
        },
    )
    prompt_without_identity = render_gap_prompt(
        gap_id, base, head, spec_sources, state, agent_config=agent_config, head_sha=head_sha
    )
    task_contract_digest = prompt_contract_digest(prompt_without_identity)
    agent_command, provider_invocation = role_agent_command(
        repo,
        agent_config,
        runner=runner,
        prompt_rel=prompt_rel,
        cwd=worktree,
        output_rel=gap_rel if runner == "exec" else None,
    )
    command = f"cd {shlex.quote(str(worktree))} && {agent_command}"
    require_role_snapshot(repo, state, head_sha, audit_snapshot_paths(repo))
    worktree_preexisting = worktree.exists()
    if not worktree_preexisting:
        git(repo, ["worktree", "add", "--detach", str(worktree), head_sha])
    try:
        prepare_role_worktree(repo, worktree, state, role="gap", agent_id=gap_id)
        ensure_gap_visible_in_worktree(worktree)
        ensure_worktree_parent_dirs(worktree, prompt_rel, gap_rel)
        report_credential_file, initial_ack_floor = register_role_report_identity_and_ack_floor(
            repo,
            state,
            role_id=gap_id,
            attempt_id=attempt_id,
            task_contract_digest=task_contract_digest,
        )
        prompt = render_gap_prompt(
            gap_id,
            base,
            head,
            spec_sources,
            state,
            agent_config=agent_config,
            head_sha=head_sha,
            report_credential_file=str(report_credential_file),
            task_contract_digest=task_contract_digest,
            attempt_id=attempt_id,
        )
        write_text(prompt_path, prompt)
        baseline_dirty = porcelain_paths(worktree)
        if args.launcher == "agent":
            pane_id = start_agent_launcher(
                name=f"hloop-{state['goal_id']}-{gap_id}-gap",
                direction=args.direction,
                cwd=worktree,
                command=command,
            )
        else:
            manager_pane = args.manager_pane or current_pane_id()
            pane_id = start_pane_launcher(
                manager_pane=manager_pane,
                direction=args.direction,
                cwd=worktree,
                command=command,
            )
    except (
        HLoopError,
        hloop_broker.BrokerStorageError,
        OSError,
        subprocess.CalledProcessError,
    ):
        try:
            rollback_failed_role_start(
                repo, worktree, created_worktree=not worktree_preexisting
            )
        finally:
            revoke_active_role_report_identity(repo, state, gap_id)
        raise
    state["gaps"][gap_id] = {
        "status": "running",
        "gate_status": "running",
        "base": base,
        "head": head,
        "base_sha": base_sha,
        "head_sha": head_sha,
        "spec_sources": spec_sources,
        "pane_id": pane_id,
        "runner": runner,
        "agent_provider": agent_config["provider"],
        "agent_model": agent_config["model"],
        "agent_effort": agent_config["effort"],
        "claude_permission_mode": agent_config["claude_permission_mode"],
        "attempt_id": attempt_id,
        "fallback_provider": agent_config["fallback_provider"],
        "skill_version": SKILL_VERSION,
        "sandbox": "workspace-write",
        "worktree": str(worktree),
        "prompt": str(prompt_path),
        "gap_path": str(final_gap_path),
        "worktree_gap_path": str(worktree_gap_path),
        "baseline_dirty_files": baseline_dirty,
        "started_at": now_iso(),
        "provider_invocation": provider_invocation.as_record(),
    }
    arm_initial_semantic_ack_barrier(
        state["gaps"][gap_id],
        attempt_id=attempt_id,
        contract_digest=task_contract_digest,
        required_reack_after_sequence=initial_ack_floor,
    )
    state["phase"] = "gap_checking"
    save_state(repo, state)
    journal(repo, f"Started Gap Auditor `{gap_id}` in pane `{pane_id}` and worktree `{worktree}`.")
    print(f"started {gap_id} in pane {pane_id}; watch with `hloop gap watch {gap_id}`")
    return 0


def cmd_gap_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    gap_id = args.gap_id
    gap_state = state.get("gaps", {}).get(gap_id)
    if not gap_state:
        raise HLoopError(f"unknown gap audit: {gap_id}")
    block_reason = semantic_ack_barrier_blocking(gap_state)
    if block_reason:
        raise HLoopError(f"cannot harvest {gap_id}: {block_reason}")
    path = gap_artifact_path(repo, gap_id, gap_state)
    if not path.exists() or not read_text(path).strip():
        raise HLoopError(f"gap artifact not found or empty: {path}")
    meta = read_frontmatter(path)
    identity_error = artifact_identity_error(state, gap_id, "gap", gap_state, meta)
    if identity_error:
        raise HLoopError(f"stale or mismatched Gap artifact: {identity_error}: {path}")
    artifact_status = str(meta.get("status", ""))
    if artifact_status not in GAP_ARTIFACT_STATUSES:
        raise HLoopError(f"invalid gap artifact status in {path}: {artifact_status}")
    reported_gap_id = str(meta.get("gap_id") or "")
    if reported_gap_id and reported_gap_id != gap_id:
        raise HLoopError(f"gap_id mismatch: expected {gap_id}, got {reported_gap_id}")
    final_path = gap_file(repo, gap_id)
    if path.resolve() != final_path.resolve():
        write_text(final_path, read_text(path))
        gap_state["worktree_gap_path_harvested"] = str(path)
        gap_state.pop("worktree_gap_path", None)
    worktree_raw = gap_state.get("worktree")
    violations: list[str] = []
    if worktree_raw:
        worktree = Path(worktree_raw).resolve()
        if worktree.exists():
            violations = validate_gap_worktree_scope(gap_id, gap_state, worktree)
    gap_state["write_scope_violations"] = violations
    gap_state["gap_path"] = str(final_path)
    gap_state["status"] = "reported"
    gap_state["gate_status"] = "reported"
    gap_state["artifact_status"] = artifact_status
    gap_state["gap_count"] = meta.get("gap_count", "")
    gap_state["harvested_at"] = now_iso()
    cleanup_completed_agent_pane(
        repo,
        gap_state,
        label=f"Gap Auditor {gap_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    revoke_active_role_report_identity(repo, state, gap_id)
    state["last_gap_id"] = gap_id
    state["needs_gap_check"] = True
    if violations:
        gap_state["status"] = "blocked_write_scope"
        gap_state["gate_status"] = "blocked_write_scope"
        state["phase"] = "blocked_conflict"
        save_state(repo, state)
        journal(
            repo,
            f"Harvested Gap Auditor `{gap_id}` but blocked because it changed files outside the gap artifact: {violations}",
        )
        append_text(
            loop_path(repo) / "USER_ACTION_REQUIRED.md",
            f"\n## Gap Auditor write-scope violation for {gap_id}\n\n"
            f"Gap artifact was copied to `{final_path}` but the gap worktree has unexpected changes:\n"
            + "\n".join(f"- {item}" for item in violations)
            + "\n",
        )
        print(f"blocked {gap_id}: gap auditor changed files outside the gap artifact")
        return 2
    cleanup_gap_worktree(repo, gap_id, gap_state, best_effort=True)
    state["phase"] = "gap_checking"
    save_state(repo, state)
    journal(repo, f"Harvested Gap Auditor `{gap_id}`; Manager triage is required.")
    print(f"harvested {gap_id}; run `hloop gap close {gap_id} --verdict <verdict>` after triage")
    return 0


def cmd_gap_close(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    gap_id = args.gap_id
    gap_state = state.get("gaps", {}).get(gap_id)
    if not gap_state:
        raise HLoopError(f"unknown gap audit: {gap_id}")
    if agent_gate_status(gap_state) not in {"reported", "triaged"}:
        raise HLoopError(f"gap audit is not ready for close: {gap_id}")
    cleanup_completed_agent_pane(
        repo,
        gap_state,
        label=f"Gap Auditor {gap_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    cleanup_gap_worktree(repo, gap_id, gap_state, best_effort=True)
    gap_state["status"] = "triaged"
    gap_state["gate_status"] = "triaged"
    gap_state["verdict"] = args.verdict
    gap_state["triage_reason"] = args.reason
    gap_state["triaged_at"] = now_iso()
    gap_state["closed_head_sha"] = gap_state.get("head_sha")
    if args.verdict in {"blocked", "decision-needed"}:
        state["needs_gap_check"] = True
        state["phase"] = "blocked_user_decision"
    else:
        state["needs_gap_check"] = False
        state["ungapped_merge_count"] = 0
        if args.verdict == "fix-tasks-created":
            state["needs_review"] = False
            state["phase"] = "dispatching"
        elif last_validation_passed(state) and should_open_review_gate(state):
            state["needs_review"] = True
            state["phase"] = "reviewing"
        else:
            state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Closed Gap Auditor `{gap_id}` with verdict `{args.verdict}`: {args.reason}")
    print(f"closed {gap_id}: {args.verdict}")
    return 0


def cmd_gap_watch(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    gap_id = args.gap_id
    gap_state = state.get("gaps", {}).get(gap_id)
    if not gap_state:
        raise HLoopError(f"unknown gap audit: {gap_id}")
    pane_id = str(gap_state.get("pane_id") or "")
    print(f"gap: {gap_id}")
    print(f"status: {gap_state.get('status')}")
    print(f"gate_status: {agent_gate_status(gap_state)}")
    print(f"artifact_status: {gap_state.get('artifact_status', '')}")
    print(f"runner: {gap_state.get('runner')}")
    print(f"worktree: {gap_state.get('worktree', '')}")
    print(f"artifact: {gap_artifact_path(repo, gap_id, gap_state)}")
    if not pane_id:
        print("pane: none")
        return 0
    print(f"pane: {pane_id}")
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        print("pane output unavailable: not inside Herdr")
        return 0
    info = pane_info(pane_id)
    if info is None:
        print("pane output unavailable: pane is closed or missing")
        return 0
    print(f"agent_status: {info.get('agent_status', 'unknown')}")
    proc = run_cmd(
        [
            "herdr",
            "pane",
            "read",
            pane_id,
            "--source",
            args.source,
            "--lines",
            str(args.lines),
        ],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    print(proc.stdout.rstrip())
    return 0


def cmd_gap_message(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    gap_id = args.gap_id
    gap_state = state.get("gaps", {}).get(gap_id)
    if not gap_state:
        raise HLoopError(f"unknown gap audit: {gap_id}")
    if agent_gate_status(gap_state) != "running":
        raise HLoopError(f"gap auditor is not running: {gap_id} status={gap_state.get('status')}")
    pane_id = str(gap_state.get("pane_id") or "")
    if not pane_id:
        raise HLoopError(f"gap auditor has no pane_id: {gap_id}")
    message, source = manager_message_from_args(args)
    if not message.strip():
        raise HLoopError("manager message is empty")
    return send_manager_message_and_record(
        repo,
        state,
        gap_state,
        role="Gap Auditor",
        agent_id=gap_id,
        pane_id=pane_id,
        message=message,
        source=source,
        args=args,
    )


def require_advice_state(state: dict[str, Any], advice_id: str) -> dict[str, Any]:
    advice = state.setdefault("advice", {}).get(advice_id)
    if not isinstance(advice, dict):
        raise HLoopError(f"unknown advice request: {advice_id}")
    return advice


def find_advisor_participant(advice_state: dict[str, Any], participant_id: str) -> dict[str, Any]:
    for participant in advice_state.get("participants", []):
        if str(participant.get("participant_id") or "") == participant_id:
            return participant
    raise HLoopError(f"unknown advisor participant: {participant_id}")


def normalize_advisor_max_rounds(value: Any) -> int:
    try:
        rounds = int(value or DEFAULT_ADVISOR_MAX_ROUNDS)
    except (TypeError, ValueError) as exc:
        raise HLoopError(f"invalid advisor max rounds: {value}") from exc
    if rounds < 1:
        raise HLoopError("advisor max rounds must be at least 1")
    return rounds


def advisor_max_rounds(state: dict[str, Any], advice_state: dict[str, Any]) -> int:
    return normalize_advisor_max_rounds(
        advice_state.get("max_rounds")
        or state.get("advisor_max_rounds")
        or DEFAULT_ADVISOR_MAX_ROUNDS
    )


def advisor_dialogue_mode(advice_state: dict[str, Any]) -> bool:
    return str(advice_state.get("mode") or DEFAULT_ADVISOR_MODE) == "dialogue"


_DELIVERED_MESSAGE_STATUSES = frozenset({"delivered", "acknowledged", "applied"})


def advisor_delivered_followup_count(participant: dict[str, Any]) -> int:
    return sum(
        1
        for item in participant.get("manager_messages", [])
        if str(item.get("delivery_status") or "delivered") in _DELIVERED_MESSAGE_STATUSES
    )


def prepare_advisor_dialogue_start(
    state: dict[str, Any],
    advice_state: dict[str, Any],
    participant: dict[str, Any],
) -> None:
    max_rounds = advisor_max_rounds(state, advice_state)
    advice_state["max_rounds"] = max_rounds
    participant["dialogue_max_rounds"] = max_rounds
    if advisor_dialogue_mode(advice_state):
        current_round = int(participant.get("dialogue_round") or 0)
        if current_round >= max_rounds and participant.get("status") != "failed":
            raise HLoopError(
                f"advisor dialogue round limit reached for {participant.get('participant_id')}: "
                f"{current_round}/{max_rounds}"
            )
        participant["dialogue_round"] = max(1, current_round)


def enforce_advisor_message_round_limit(
    state: dict[str, Any],
    advice_state: dict[str, Any],
    participant: dict[str, Any],
) -> tuple[int, int]:
    max_rounds = advisor_max_rounds(state, advice_state)
    advice_state["max_rounds"] = max_rounds
    participant["dialogue_max_rounds"] = max_rounds
    if not advisor_dialogue_mode(advice_state):
        return advisor_delivered_followup_count(participant), max_rounds
    followups = advisor_delivered_followup_count(participant)
    allowed_followups = max_rounds - 1
    if followups >= allowed_followups:
        raise HLoopError(
            f"advisor dialogue follow-up limit reached for {participant.get('participant_id')}: "
            f"{followups}/{allowed_followups} delivered follow-up(s), max_rounds={max_rounds}"
        )
    return followups, max_rounds


def cmd_advisor_request(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    advice_id = args.advice_id or next_id("A", state.setdefault("advice", {}))
    if advice_id in state.setdefault("advice", {}):
        raise HLoopError(f"advice request already exists: {advice_id}")
    mode = args.mode or state.get("advisor_mode") or DEFAULT_ADVISOR_MODE
    if mode not in ADVISOR_MODES:
        raise HLoopError(f"unsupported advisor mode: {mode}")
    max_rounds = normalize_advisor_max_rounds(
        getattr(args, "max_rounds", None)
        or state.get("advisor_max_rounds")
        or DEFAULT_ADVISOR_MAX_ROUNDS
    )
    participants = advisor_participants_from_args(args, state)
    if mode == "dialogue" and len(participants) < 2:
        fallback = DEFAULT_AGENT_PROVIDER
        primary = participants[0]["provider"]
        if primary == fallback and command_exists("claude"):
            fallback = "claude"
        participants.append(
            {
                "participant_id": "P2",
                "provider": fallback,
                "model": DEFAULT_AGENT_MODEL,
                "status": "queued",
            }
        )
    for participant in participants:
        participant["dialogue_round"] = 0
        participant["dialogue_max_rounds"] = max_rounds
    advice_state = {
        "status": "requested",
        "gate_status": "requested",
        "topic": args.topic,
        "mode": mode,
        "max_rounds": max_rounds,
        "source_refs": args.source or [],
        "participants": participants,
        "created_at": now_iso(),
    }
    state["advice"][advice_id] = advice_state
    write_text(
        advice_file(repo, advice_id),
        frontmatter(
            {
                "advice_id": advice_id,
                "status": "requested",
                "mode": mode,
                "max_rounds": max_rounds,
                "participants": [
                    f"{item['participant_id']}:{item['provider']}:{item['model']}"
                    for item in participants
                ],
                "source_refs": args.source or [],
            }
        )
        + f"\n# Advice Request {advice_id}\n\n## Topic\n{args.topic}\n",
    )
    state["phase"] = "advising"
    save_state(repo, state)
    journal(repo, f"Created Advisor request `{advice_id}`: {args.topic}")
    print(f"created {advice_id}: {advice_file(repo, advice_id)}")
    return 0


def cmd_advisor_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    advice_id = args.advice_id
    advice_state = require_advice_state(state, advice_id)
    participant_id = args.participant_id
    participant = find_advisor_participant(advice_state, participant_id)
    if participant.get("status") not in {"queued", "failed"}:
        raise HLoopError(
            f"advisor participant is not startable: {advice_id}/{participant_id} status={participant.get('status')}"
        )
    base = args.base or state["base_branch"]
    head = args.head or state["integration_branch"]
    head_sha = git(repo, ["rev-parse", head])
    require_role_snapshot(repo, state, head_sha, audit_snapshot_paths(repo))
    worktree_arg = getattr(args, "worktree", None)
    worktree = (
        Path(worktree_arg).resolve()
        if worktree_arg
        else default_advisor_worktree(repo, advice_id, participant_id, state)
    )
    prompt_rel = LOOP_DIR / "prompts" / f"{advice_id}-{participant_id}.advisor.md"
    advice_rel = LOOP_DIR / "advice" / f"{advice_id}-{participant_id}.md"
    prompt_path = worktree / prompt_rel
    worktree_advice_path = worktree / advice_rel
    final_path = advice_file(repo, advice_id, participant_id)
    runner = args.runner or state.get("advisor_runner", "tui")
    agent_config = role_agent_config(
        state,
        "advisor",
        overrides={
            "agent_provider": getattr(args, "agent_provider", None) or participant.get("provider"),
            "agent_model": getattr(args, "agent_model", None) or participant.get("model"),
        },
    )
    participant["provider"] = agent_config["provider"]
    participant["model"] = agent_config["model"]
    prepare_advisor_dialogue_start(state, advice_state, participant)
    prompt = render_advisor_prompt(
        advice_id, participant, advice_state, state, advice_rel, head_sha=head_sha
    )
    agent_command, preview_invocation = role_agent_command(
        repo,
        agent_config,
        runner=runner,
        prompt_rel=prompt_rel,
        cwd=worktree,
        output_rel=advice_rel if runner == "exec" else None,
    )
    command = f"cd {shlex.quote(str(worktree))} && {agent_command}"
    if args.dry_run:
        print(f"DRY RUN worktree: git worktree add --detach {worktree} {head_sha}")
        print(f"DRY RUN prompt: {prompt_path}")
        print(f"DRY RUN {args.launcher}/{runner} command: {command}")
        return 0
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_agent_invocation=preview_invocation,
        require_integration_branch=True,
    )
    advice_state = require_advice_state(state, advice_id)
    participant = find_advisor_participant(advice_state, participant_id)
    participant["provider"] = agent_config["provider"]
    participant["model"] = agent_config["model"]
    prepare_advisor_dialogue_start(state, advice_state, participant)
    require_role_snapshot(repo, state, head_sha, audit_snapshot_paths(repo))
    role_id = f"{advice_id}/{participant_id}"
    attempt_id = f"{advice_id}-{participant_id}-A001"
    prompt_without_identity = render_advisor_prompt(
        advice_id,
        participant,
        advice_state,
        state,
        advice_rel,
        head_sha=head_sha,
    )
    task_contract_digest = prompt_contract_digest(prompt_without_identity)
    agent_command, provider_invocation = role_agent_command(
        repo,
        agent_config,
        runner=runner,
        prompt_rel=prompt_rel,
        cwd=worktree,
        output_rel=advice_rel if runner == "exec" else None,
    )
    command = f"cd {shlex.quote(str(worktree))} && {agent_command}"
    worktree_preexisting = worktree.exists()
    if not worktree_preexisting:
        git(repo, ["worktree", "add", "--detach", str(worktree), head_sha])
    try:
        prepare_role_worktree(
            repo, worktree, state, role="advisor", agent_id=f"{advice_id}/{participant_id}"
        )
        ensure_advisor_visible_in_worktree(worktree)
        ensure_worktree_parent_dirs(worktree, prompt_rel, advice_rel)
        report_credential_file, initial_ack_floor = register_role_report_identity_and_ack_floor(
            repo,
            state,
            role_id=role_id,
            attempt_id=attempt_id,
            task_contract_digest=task_contract_digest,
        )
        prompt = render_advisor_prompt(
            advice_id,
            participant,
            advice_state,
            state,
            advice_rel,
            head_sha=head_sha,
            report_credential_file=str(report_credential_file),
            task_contract_digest=task_contract_digest,
            attempt_id=attempt_id,
        )
        write_text(prompt_path, prompt)
        baseline_dirty = porcelain_paths(worktree)
        if args.launcher == "agent":
            pane_id = start_agent_launcher(
                name=f"hloop-{state['goal_id']}-{advice_id}-{participant_id}-advisor",
                direction=args.direction,
                cwd=worktree,
                command=command,
            )
        else:
            manager_pane = args.manager_pane or current_pane_id()
            pane_id = start_pane_launcher(
                manager_pane=manager_pane,
                direction=args.direction,
                cwd=worktree,
                command=command,
            )
    except (
        HLoopError,
        hloop_broker.BrokerStorageError,
        OSError,
        subprocess.CalledProcessError,
    ):
        try:
            rollback_failed_role_start(
                repo, worktree, created_worktree=not worktree_preexisting
            )
        finally:
            revoke_active_role_report_identity(repo, state, role_id)
        raise
    participant.update(
        {
            "status": "running",
            "gate_status": "running",
            "base": base,
            "head": head,
            "head_sha": head_sha,
            "pane_id": pane_id,
            "runner": runner,
            "agent_provider": agent_config["provider"],
            "agent_model": agent_config["model"],
            "agent_effort": agent_config["effort"],
            "claude_permission_mode": agent_config["claude_permission_mode"],
            "attempt_id": attempt_id,
            "fallback_provider": agent_config["fallback_provider"],
            "skill_version": SKILL_VERSION,
            "sandbox": "workspace-write",
            "worktree": str(worktree),
            "prompt": str(prompt_path),
            "advice_path": str(final_path),
            "worktree_advice_path": str(worktree_advice_path),
            "baseline_dirty_files": baseline_dirty,
            "started_at": now_iso(),
            "provider_invocation": provider_invocation.as_record(),
        }
    )
    arm_initial_semantic_ack_barrier(
        participant,
        attempt_id=attempt_id,
        contract_digest=task_contract_digest,
        required_reack_after_sequence=initial_ack_floor,
    )
    advice_state["status"] = "running"
    advice_state["gate_status"] = "running"
    state["phase"] = "advising"
    save_state(repo, state)
    journal(repo, f"Started Advisor `{advice_id}/{participant_id}` in pane `{pane_id}` and worktree `{worktree}`.")
    print(f"started {advice_id}/{participant_id} in pane {pane_id}")
    return 0


def cmd_advisor_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_herdr=True, require_integration_branch=True)
    advice_id = args.advice_id
    participant_id = args.participant_id
    advice_state = require_advice_state(state, advice_id)
    participant = find_advisor_participant(advice_state, participant_id)
    block_reason = semantic_ack_barrier_blocking(participant)
    if block_reason:
        raise HLoopError(
            f"cannot harvest {advice_id}/{participant_id}: {block_reason}"
        )
    path = advice_artifact_path(repo, advice_id, participant)
    if not path.exists() or not read_text(path).strip():
        raise HLoopError(f"advisor artifact not found or empty: {path}")
    meta = read_frontmatter(path)
    identity_error = artifact_identity_error(state, advice_id, "advisor", participant, meta)
    if identity_error:
        raise HLoopError(f"stale or mismatched Advisor artifact: {identity_error}: {path}")
    artifact_status = str(meta.get("status") or "")
    if artifact_status not in ADVISOR_ARTIFACT_STATUSES:
        raise HLoopError(f"invalid advisor artifact status in {path}: {artifact_status}")
    final_path = advice_file(repo, advice_id, participant_id)
    if path.resolve() != final_path.resolve():
        write_text(final_path, read_text(path))
        participant["worktree_advice_path_harvested"] = str(path)
        participant.pop("worktree_advice_path", None)
    violations: list[str] = []
    worktree_raw = participant.get("worktree")
    if worktree_raw:
        worktree = Path(worktree_raw).resolve()
        if worktree.exists():
            violations = validate_advisor_worktree_scope(advice_id, participant, worktree)
    participant["write_scope_violations"] = violations
    participant["advice_path"] = str(final_path)
    participant["status"] = "reported"
    participant["gate_status"] = "reported"
    participant["artifact_status"] = artifact_status
    participant["harvested_at"] = now_iso()
    cleanup_completed_agent_pane(
        repo,
        participant,
        label=f"Advisor {advice_id}/{participant_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    revoke_active_role_report_identity(
        repo, state, f"{advice_id}/{participant_id}"
    )
    if violations:
        participant["status"] = "blocked_write_scope"
        participant["gate_status"] = "blocked_write_scope"
        advice_state["status"] = "blocked_write_scope"
        advice_state["gate_status"] = "blocked_write_scope"
        state["phase"] = "blocked_conflict"
        save_state(repo, state)
        append_text(
            loop_path(repo) / "USER_ACTION_REQUIRED.md",
            f"\n## Advisor write-scope violation for {advice_id}/{participant_id}\n\n"
            f"Advisor artifact was copied to `{final_path}` but the worktree has unexpected changes:\n"
            + "\n".join(f"- {item}" for item in violations)
            + "\n",
        )
        print(f"blocked {advice_id}/{participant_id}: advisor changed files outside the advice artifact")
        return 2
    cleanup_advisor_worktree(repo, advice_id, participant, best_effort=True)
    if all(str(item.get("gate_status") or item.get("status")) == "reported" for item in advice_state.get("participants", [])):
        advice_state["status"] = "reported"
        advice_state["gate_status"] = "reported"
    state["phase"] = "advising"
    save_state(repo, state)
    journal(repo, f"Harvested Advisor `{advice_id}/{participant_id}`; Manager review is required.")
    print(f"harvested {advice_id}/{participant_id}; close with `hloop advisor close {advice_id} --verdict <verdict>`")
    return 0


def cmd_advisor_close(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_herdr=True, require_integration_branch=True)
    advice_state = require_advice_state(state, args.advice_id)
    gate_status = str(advice_state.get("gate_status") or advice_state.get("status"))
    if gate_status == "triaged":
        if (
            str(advice_state.get("verdict") or "") == args.verdict
            and str(advice_state.get("triage_reason") or "") == args.reason
        ):
            print(f"already closed {args.advice_id}: {args.verdict}")
            return 0
        raise HLoopError(
            f"advice request is already closed with a different verdict or reason: {args.advice_id}"
        )
    if gate_status != "reported":
        raise HLoopError(
            f"advice request is not ready for close: {args.advice_id}; "
            "harvest participant artifacts before closing"
        )
    triaged_at = now_iso()
    for participant in advice_state.get("participants", []):
        participant_status = str(
            participant.get("gate_status") or participant.get("status") or ""
        )
        if participant_status == "reported":
            participant["status"] = "consumed"
            participant["gate_status"] = "consumed"
            participant["consumed_at"] = triaged_at
    advice_state["status"] = "triaged"
    advice_state["gate_status"] = "triaged"
    advice_state["verdict"] = args.verdict
    advice_state["triage_reason"] = args.reason
    advice_state["triaged_at"] = triaged_at
    state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Closed Advisor request `{args.advice_id}` with verdict `{args.verdict}`: {args.reason}")
    print(f"closed {args.advice_id}: {args.verdict}")
    return 0


def cmd_advisor_watch(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    advice_state = require_advice_state(state, args.advice_id)
    participant = find_advisor_participant(advice_state, args.participant_id)
    pane_id = str(participant.get("pane_id") or "")
    print(f"advice: {args.advice_id}/{args.participant_id}")
    print(f"status: {participant.get('status')}")
    print(f"gate_status: {agent_gate_status(participant)}")
    print(f"artifact_status: {participant.get('artifact_status', '')}")
    print(f"agent: {agent_display({'provider': str(participant.get('agent_provider') or participant.get('provider') or DEFAULT_AGENT_PROVIDER), 'model': str(participant.get('agent_model') or participant.get('model') or DEFAULT_AGENT_MODEL)})}")
    print(f"worktree: {participant.get('worktree', '')}")
    print(f"artifact: {advice_artifact_path(repo, args.advice_id, participant)}")
    if not pane_id:
        print("pane: none")
        return 0
    print(f"pane: {pane_id}")
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        print("pane output unavailable: not inside Herdr")
        return 0
    info = pane_info(pane_id)
    if info is None:
        print("pane output unavailable: pane is closed or missing")
        return 0
    print(f"agent_status: {info.get('agent_status', 'unknown')}")
    proc = run_cmd(
        [
            "herdr",
            "pane",
            "read",
            pane_id,
            "--source",
            args.source,
            "--lines",
            str(args.lines),
        ],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    print(proc.stdout.rstrip())
    return 0


def cmd_advisor_message(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_herdr=True, require_integration_branch=True)
    advice_state = require_advice_state(state, args.advice_id)
    participant = find_advisor_participant(advice_state, args.participant_id)
    if agent_gate_status(participant) != "running":
        raise HLoopError(
            f"advisor is not running: {args.advice_id}/{args.participant_id} status={participant.get('status')}"
        )
    pane_id = str(participant.get("pane_id") or "")
    if not pane_id:
        raise HLoopError(f"advisor has no pane_id: {args.advice_id}/{args.participant_id}")
    message, source = manager_message_from_args(args)
    if not message.strip():
        raise HLoopError("manager message is empty")
    contract_changing = bool(getattr(args, "contract_changing", False))
    message_id, message = manager_message_envelope(
        state,
        f"{args.advice_id}/{args.participant_id}",
        participant,
        message,
        contract_changing=contract_changing,
    )
    if contract_changing:
        advisor_role_id = f"{args.advice_id}/{args.participant_id}"
        arm_semantic_ack_barrier(
            participant,
            message_id=message_id,
            digest=message_digest(message),
            required_reack_after_sequence=latest_semantic_ack_sequence(
                repo,
                state,
                role_id=advisor_role_id,
                agent_state=participant,
            ),
        )
    followups_before, max_rounds = enforce_advisor_message_round_limit(
        state, advice_state, participant
    )
    try:
        send_agent_tui_message(
            str(participant.get("agent_provider") or participant.get("provider") or DEFAULT_AGENT_PROVIDER),
            pane_id,
            message,
            args.timeout_ms,
            args.input_settle_ms,
            args.submit_verify_ms,
            args.submit_attempts,
        )
    except ManagerMessageDeliveryUnknown as exc:
        return record_unknown_manager_message(
            repo,
            state,
            participant,
            role="Advisor",
            agent_id=f"{args.advice_id}/{args.participant_id}",
            source=source,
            message=message,
            error=exc,
        )
    except HLoopError as exc:
        return record_pending_manager_message(
            repo,
            state,
            participant,
            role="Advisor",
            agent_id=f"{args.advice_id}/{args.participant_id}",
            pane_id=pane_id,
            source=source,
            message=message,
            error=exc,
        )
    record_manager_message(participant, source, message)
    participant["advisor_followup_count"] = followups_before + 1
    participant["dialogue_max_rounds"] = max_rounds
    if advisor_dialogue_mode(advice_state):
        participant["dialogue_round"] = min(max_rounds, 2 + followups_before)
    save_state(repo, state)
    journal(repo, f"Sent Manager message to Advisor `{args.advice_id}/{args.participant_id}` in pane `{pane_id}` from {source}.")
    print(f"sent manager message to {args.advice_id}/{args.participant_id} in pane {pane_id}")
    return 0


def render_fix_task_draft(
    source_type: str,
    source_id: str,
    artifact_path: Path,
    candidates: list[dict[str, Any]],
    rejected_candidates: list[dict[str, Any]] | None = None,
) -> str:
    rejected_candidates = rejected_candidates or []
    fields = {
        "source_type": source_type,
        "source_id": source_id,
        "status": "draft",
        "candidate_count": len(candidates),
        "rejected_candidate_count": len(rejected_candidates),
    }
    lines = [
        frontmatter(fields).rstrip(),
        "",
        f"# Fix Task Drafts For {source_id}",
        "",
        f"- Source artifact: `{artifact_path}`",
        f"- Valid candidate count: {len(candidates)}",
        f"- Rejected candidate count: {len(rejected_candidates)}",
        "",
    ]
    if not candidates and not rejected_candidates:
        lines.extend(
            [
                "No machine-readable fix task candidates were found.",
                "",
                "Manager action:",
                "- Read the source artifact directly.",
                "- Create fix tasks manually with `hloop task new` if findings are actionable.",
                "- Close the gate as passed, accepted risk, decision needed, or fix tasks created.",
            ]
        )
    elif not candidates:
        lines.extend(
            [
                "No valid fix task candidates were found. Inspect rejected candidates below before creating tasks manually.",
                "",
            ]
        )
    else:
        lines.append("## Candidates")
        lines.append("")
        for index, candidate in enumerate(candidates, start=1):
            lines.extend(
                [
                    f"### F{index:03d}: {candidate['title']}",
                    "",
                    f"- Priority: {candidate['priority']}",
                    f"- Source finding: {candidate['source_finding']}",
                    f"- Rationale: {candidate['rationale']}",
                    "- Write allow:",
                    *[f"  - `{item}`" for item in candidate["write_allow"]],
                    "- Acceptance:",
                    *[f"  - {item}" for item in candidate["acceptance"]],
                    "",
                    "Create command:",
                    "",
                    "```bash",
                ]
            )
            cmd = [
                "python3",
                "<this-skill>/scripts/hloop",
                "task",
                "new",
                candidate["title"],
                "--kind",
                candidate["kind"],
                "--priority",
                candidate["priority"],
            ]
            for item in candidate["write_allow"]:
                cmd.extend(["--write-allow", item])
            for item in candidate["write_deny"]:
                cmd.extend(["--write-deny", item])
            for item in candidate["acceptance"]:
                cmd.extend(["--acceptance", item])
            for item in candidate["depends_on"]:
                cmd.extend(["--depends-on", item])
            lines.append(shlex.join(cmd))
            lines.extend(["```", ""])
    if rejected_candidates:
        lines.append("## Rejected Candidates")
        lines.append("")
        for index, candidate in enumerate(rejected_candidates, start=1):
            lines.extend(
                [
                    f"### X{index:03d}: {candidate['title']}",
                    "",
                    "Reasons:",
                    *[f"- {reason}" for reason in normalize_list(candidate.get("reasons"))],
                    "",
                ]
            )
            raw = str(candidate.get("raw") or "").strip()
            if raw:
                lines.extend(["Raw block:", "", "```text", raw, "```", ""])
    return "\n".join(lines)


def cmd_triage_source(args: argparse.Namespace, source_type: str) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_integration_branch=True,
        mark_blocked=not args.dry_run,
    )
    source_id = args.source_id
    if source_type == "review":
        source_state = state.get("reviews", {}).get(source_id)
        if not source_state:
            raise HLoopError(f"unknown review: {source_id}")
        artifact_path = review_artifact_path(repo, source_id, source_state)
        created_from = f"reviews/{source_id}"
    elif source_type == "gap":
        source_state = state.get("gaps", {}).get(source_id)
        if not source_state:
            raise HLoopError(f"unknown gap audit: {source_id}")
        artifact_path = gap_file(repo, source_id)
        created_from = f"gaps/{source_id}"
    else:
        raise HLoopError(f"unsupported triage source: {source_type}")
    if not artifact_path.exists() or not read_text(artifact_path).strip():
        raise HLoopError(f"source artifact not found or empty: {artifact_path}")
    text = read_text(artifact_path)
    candidates, rejected_candidates = extract_fix_task_candidates(text, source_id)
    if source_type == "review" and is_directory_review(source_state):
        manifest = load_review_manifest(
            recorded_path(
                repo,
                source_state.get("manifest_path"),
                review_manifest_file(repo, source_id),
            )
        )
        candidates, rejected_candidates = confirmed_review_fix_task_candidates(
            manifest, candidates, rejected_candidates
        )
    draft_path = triage_draft_file(repo, source_id)
    draft = render_fix_task_draft(
        source_type,
        source_id,
        artifact_path,
        candidates,
        rejected_candidates,
    )
    if args.dry_run:
        print(draft)
        return 0
    write_text(draft_path, draft)
    source_state.setdefault("triage_drafts", [])
    if str(draft_path) not in source_state["triage_drafts"]:
        source_state["triage_drafts"].append(str(draft_path))
    created_task_ids: list[str] = []
    if args.create_tasks:
        if rejected_candidates and not candidates:
            raise HLoopError(
                f"no valid fix task candidates for {source_id}; inspect rejected candidates in {draft_path}"
            )
        existing_created = normalize_list(source_state.get("created_fix_tasks"))
        if existing_created:
            raise HLoopError(
                f"fix tasks already created for {source_id}: {', '.join(existing_created)}"
            )
        missing_write_allow = [
            candidate["title"] for candidate in candidates if not candidate["write_allow"]
        ]
        if missing_write_allow and not args.allow_no_write:
            raise HLoopError(
                "candidate is missing write_allow; inspect draft first: "
                + ", ".join(missing_write_allow)
            )
        for candidate in candidates:
            task_id = create_loop_task(
                repo,
                state,
                title=candidate["title"],
                kind=candidate["kind"],
                priority=candidate["priority"],
                write_allow=candidate["write_allow"],
                write_deny=candidate["write_deny"],
                acceptance=candidate["acceptance"],
                depends_on=candidate["depends_on"],
                created_from=created_from,
                allow_no_write=args.allow_no_write,
            )
            created_task_ids.append(task_id)
        source_state.setdefault("created_fix_tasks", [])
        source_state["created_fix_tasks"].extend(created_task_ids)
        state["phase"] = "dispatching"
    source_state["last_triaged_at"] = now_iso()
    source_state["fix_task_candidate_count"] = len(candidates)
    source_state["rejected_fix_task_candidate_count"] = len(rejected_candidates)
    draft_rel = str(draft_path.relative_to(repo))
    pending_drafts = normalize_list(state.get("pending_fix_task_drafts"))
    if candidates and not created_task_ids:
        state["pending_fix_task_drafts"] = list(dict.fromkeys([*pending_drafts, draft_rel]))
    else:
        state["pending_fix_task_drafts"] = [
            item for item in pending_drafts if item != draft_rel
        ]
    save_state(repo, state)
    journal(
        repo,
        f"Triage draft for `{source_id}` wrote `{draft_path}` with {len(candidates)} valid "
        f"candidate(s) and {len(rejected_candidates)} rejected candidate(s)"
        + (f" and created tasks: {', '.join(created_task_ids)}" if created_task_ids else "."),
    )
    print(f"wrote {draft_path}")
    if rejected_candidates:
        print(f"rejected fix task candidates: {len(rejected_candidates)}")
    if created_task_ids:
        print("created fix tasks: " + ", ".join(created_task_ids))
    elif candidates:
        print("draft contains fix task candidates; rerun with --create-tasks after Manager approval")
    else:
        print("no machine-readable fix task candidates found")
    return 0


def cmd_triage_review(args: argparse.Namespace) -> int:
    return cmd_triage_source(args, "review")


def cmd_triage_gap(args: argparse.Namespace) -> int:
    return cmd_triage_source(args, "gap")


def write_sets_overlap(a: list[str], b: list[str]) -> bool:
    for left in a:
        for right in b:
            if left == right or path_matches_pattern(left, right) or path_matches_pattern(right, left):
                return True
    return False


def queued_dispatchable_tasks(state: dict[str, Any]) -> list[str]:
    decision_blocked = set(build_decision_scheduler(state).decision_blocked_task_ids)
    running_sets = [
        normalize_list(task.get("write_allow"))
        for task in state.get("tasks", {}).values()
        if task.get("status") == "running"
    ]
    dispatchable = []
    for task_id, task in state.get("tasks", {}).items():
        if task.get("status") != "queued":
            continue
        if task_id in decision_blocked:
            continue
        depends = normalize_list(task.get("depends_on"))
        if any(state["tasks"].get(dep, {}).get("status") != "merged" for dep in depends):
            continue
        write_allow = normalize_list(task.get("write_allow"))
        if any(write_sets_overlap(write_allow, active) for active in running_sets):
            continue
        dispatchable.append(task_id)
        running_sets.append(write_allow)
    return dispatchable


def cmd_tick(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
        mark_blocked=not args.dry_run,
    )
    if str(state.get("phase") or "") == "paused":
        print("loop is paused; run `hloop resume` before tick/pump")
        return 0
    if str(state.get("phase") or "") in RUN_TERMINAL_PHASES:
        print(f"loop is terminal: phase={state.get('phase')}")
        return 0
    if str(state.get("phase") or "") in {
        "blocked_environment",
        "blocked_conflict",
        "failed_validation",
        "failed_manager_qa",
        "no_progress",
    }:
        print(f"blocked: phase is {state.get('phase')}")
        return 2
    if not normalize_list(state.get("validation_commands")) and any(
        task.get("status") == "queued"
        and str(task.get("kind") or "implementation") in {"implementation", "fix"}
        for task in state.get("tasks", {}).values()
    ):
        raise HLoopError(
            "integration validation is not configured; use `hloop validation configure --command ...`"
        )
    if not args.dry_run:
        state["cycle"] = int(state.get("cycle", 0)) + 1
        save_state(repo, state)
    scheduler_decision = build_decision_scheduler(state)
    if scheduler_decision.loop_blocked:
        blocking_ids = ", ".join(scheduler_decision.blocking_decision_ids) or "unknown"
        if args.dry_run:
            print(f"DRY RUN blocked: pending user decision ({blocking_ids})")
            return 2
        for decision_id in scheduler_decision.blocking_decision_ids:
            record = require_decision(state, decision_id)
            liaison = (state.get("decision_liaisons") or {}).get(decision_id) or {}
            if str(liaison.get("status") or "") not in {
                "running",
                "waiting-manager",
                "responded",
                "completed",
            }:
                start_decision_liaison(repo, state, record, args)
                state = load_state(repo)
        state["phase"] = "blocked_user_decision"
        save_state(repo, state)
        journal(
            repo,
            "Loop blocked: every queued task depends on unresolved decision(s) "
            f"{blocking_ids} and no other safe work remains.",
        )
        print(f"blocked: pending user decision ({blocking_ids})")
        return 2
    if scheduler_decision.decision_blocked_task_ids and not args.dry_run:
        for evaluation in scheduler_decision.evaluations:
            if evaluation.blocked_by_decision:
                journal(
                    repo,
                    f"Skipping task `{evaluation.task_id}`: blocked by unresolved "
                    f"decision(s) {', '.join(evaluation.blocking_decision_ids)}.",
                )

    if state.get("needs_validation") or state.get("phase") == "validating":
        return cmd_validate(args)

    # Harvest any running worker with a visible result artifact.
    for task_id, task in state.get("tasks", {}).items():
        if task.get("status") == "running":
            worktree = Path(task.get("worktree") or default_worktree(repo, task_id, state))
            result = result_file(worktree, task_id)
            if artifact_readiness(repo, state, task_id, "worker", task, result)[0]:
                if args.dry_run:
                    print(f"DRY RUN harvest worker {task_id}")
                    return 0
                args.task_id = task_id
                return cmd_worker_harvest(args)

    # Merge one ready task unless a Reviewer or Gap Auditor is reading the integration head.
    if not running_review_exists(state) and not running_gap_exists(state):
        for task_id, task in state.get("tasks", {}).items():
            if task.get("status") == "result_reported" and task.get("merge_ready"):
                branch_strategy = state_value(state, "branch_strategy", DEFAULT_BRANCH_STRATEGY)
                if branch_strategy != "integration":
                    if not args.dry_run:
                        state["phase"] = "branch_handoff"
                        state["branch_handoff_task"] = task_id
                        save_state(repo, state)
                        journal(
                            repo,
                            f"Worker `{task_id}` is merge-ready, but branch_strategy `{branch_strategy}` requires Manager handoff.",
                        )
                    print(
                        f"branch handoff required for {task_id}: "
                        f"branch_strategy={branch_strategy}; follow PROFILE.md and PLAN.md"
                    )
                    return 0
                args.task_id = task_id
                return cmd_merge(args)

    # Harvest any reported gap artifact.
    for gap_id, gap in state.get("gaps", {}).items():
        if agent_gate_status(gap) == "running":
            path = gap_artifact_path(repo, gap_id, gap)
            if artifact_readiness(repo, state, gap_id, "gap", gap, path)[0]:
                if args.dry_run:
                    print(f"DRY RUN harvest gap {gap_id}")
                    return 0
                args.gap_id = gap_id
                return cmd_gap_harvest(args)

    # Harvest any reported review artifact.
    for review_id, review in state.get("reviews", {}).items():
        if agent_gate_status(review) == "running":
            path = review_artifact_path(repo, review_id, review)
            if artifact_readiness(repo, state, review_id, "reviewer", review, path)[0]:
                if args.dry_run:
                    print(f"DRY RUN harvest reviewer {review_id}")
                    return 0
                args.review_id = review_id
                return cmd_reviewer_harvest(args)

    if state.get("needs_gap_check") and reported_gap_exists(state):
        print("gap triage required")
        return 0

    if state.get("needs_review") and reported_review_exists(state):
        print("review triage required")
        return 0

    if (
        state.get("needs_gap_check")
        and int(state.get("max_gap_auditors", DEFAULT_MAX_GAP_AUDITORS)) > 0
        and not pending_gap_exists(state)
    ):
        args.gap_id = None
        args.base = None
        args.head = None
        args.spec_source = None
        args.worktree = None
        args.runner = args.gap_runner
        args.agent_provider = getattr(args, "gap_agent_provider", None)
        args.agent_model = getattr(args, "gap_agent_model", None)
        return cmd_gap_start(args)

    if (
        state.get("needs_review")
        and int(state.get("max_reviewers", DEFAULT_MAX_REVIEWERS)) > 0
        and not pending_review_exists(state)
    ):
        args.review_id = None
        args.base = None
        args.head = None
        args.worktree = None
        args.runner = args.reviewer_runner
        args.agent_provider = getattr(args, "reviewer_agent_provider", None)
        args.agent_model = getattr(args, "reviewer_agent_model", None)
        return cmd_reviewer_start(args)

    scout_required, scout_reasons = specification_scout_required(state)
    scout_run = state.get("specification_scout_run") or {}
    scout_status = str(scout_run.get("status") or "")
    if scout_required:
        if scout_status in {"running", "waiting-manager", "reported"}:
            print(
                "Specification Scout requires Manager attention before implementation dispatch: "
                f"status={scout_status}"
            )
            return 0
        if args.dry_run:
            print("DRY RUN start Specification Scout: " + ", ".join(scout_reasons))
            return 0
        args.force = False
        args.worktree = None
        args.runner = "tui"
        args.agent_provider = getattr(args, "advisor_agent_provider", None)
        args.agent_model = getattr(args, "advisor_agent_model", None)
        return cmd_specification_scout_start(args)

    running_count = sum(1 for t in state.get("tasks", {}).values() if t.get("status") == "running")
    max_workers = args.max_workers or state.get("max_workers", DEFAULT_MAX_WORKERS)
    slots = max(0, max_workers - running_count)
    dispatchable = queued_dispatchable_tasks(state)[:slots]
    if dispatchable and args.dry_run:
        for task_id in dispatchable:
            print(f"DRY RUN start worker {task_id}")
        return 0
    started = []
    while slots > 0:
        state = load_state(repo)
        dispatchable = queued_dispatchable_tasks(state)
        if not dispatchable:
            break
        task_id = dispatchable[0]
        args.task_id = task_id
        args.worktree = None
        args.runner = args.worker_runner
        args.agent_provider = getattr(args, "worker_agent_provider", None)
        args.agent_model = getattr(args, "worker_agent_model", None)
        rc = cmd_worker_start(args)
        if rc != 0:
            return rc
        started.append(task_id)
        slots -= 1
    if started:
        print(f"started workers: {', '.join(started)}")
        return 0

    if state.get("needs_gap_check") and running_gap_exists(state):
        wait_ms = gap_wait_ms(args, state)
        for gap_id, gap in state.get("gaps", {}).items():
            if agent_gate_status(gap) != "running":
                continue
            if args.dry_run:
                print(f"DRY RUN wait gap {gap_id} for {wait_ms}ms")
                return 0
            if wait_for_running_gap(repo, state, gap_id, gap, wait_ms):
                save_state(repo, state)
                args.gap_id = gap_id
                return cmd_gap_harvest(args)
            save_state(repo, state)
            journal(
                repo,
                f"Gap Auditor `{gap_id}` still running after waiting {wait_ms}ms; Manager may continue other work.",
            )
            state["phase"] = "waiting_gap"
            save_state(repo, state)
            print(
                f"gap auditor {gap_id} still running after {wait_ms}ms; "
                f"inspect with `hloop gap watch {gap_id}` or tick again"
            )
            return 0

    if state.get("needs_review") and running_review_exists(state):
        wait_ms = review_wait_ms(args, state)
        for review_id, review in state.get("reviews", {}).items():
            if agent_gate_status(review) != "running":
                continue
            if args.dry_run:
                print(f"DRY RUN wait reviewer {review_id} for {wait_ms}ms")
                return 0
            if wait_for_running_review(repo, state, review_id, review, wait_ms):
                save_state(repo, state)
                args.review_id = review_id
                return cmd_reviewer_harvest(args)
            save_state(repo, state)
            journal(
                repo,
                f"Reviewer `{review_id}` still running after waiting {wait_ms}ms; Manager may continue other work.",
            )
            state["phase"] = "waiting_review"
            save_state(repo, state)
            print(
                f"reviewer {review_id} still running after {wait_ms}ms; "
                f"inspect with `hloop reviewer watch {review_id}` or tick again"
            )
            return 0

    if (
        all_tasks_merged(state)
        and not state.get("needs_validation")
        and not state.get("needs_gap_check")
        and not state.get("needs_review")
        and not running_gap_exists(state)
        and not running_review_exists(state)
        and last_validation_passed(state)
        and gap_gate_passed(state)
        and review_gate_passed(state)
    ):
        if not manager_qa_passed(state):
            if args.dry_run:
                print(
                    "DRY RUN manager final QA required: "
                    f"profile={state_manager_qa_profile(state)} "
                    f"status={state.get('manager_qa_status', 'pending')}"
                )
                return 0
            state["phase"] = "manager_qa"
            state["manager_qa_status"] = state.get("manager_qa_status") or "pending"
            save_state(repo, state)
            print(
                "manager final QA required before done: "
                f"profile={state_manager_qa_profile(state)}; "
                "record with `hloop qa record --status passed --summary ...`"
            )
            return 0
        if args.dry_run:
            print("DRY RUN ready_to_finish: all completion gates are closed")
            return 0
        state["phase"] = "ready_to_finish"
        save_state(repo, state)
        print("ready to finish: run `hloop finish`")
        return 0

    running_workers = [
        task_id
        for task_id, task in state.get("tasks", {}).items()
        if task.get("status") == "running"
    ]
    if running_workers:
        if not args.dry_run:
            state["phase"] = "waiting_worker"
            save_state(repo, state)
        print("waiting for worker result: " + ", ".join(running_workers))
        return 0

    if not args.dry_run:
        state["phase"] = "no_progress"
        state["last_no_progress_at"] = now_iso()
        save_state(repo, state)
        journal(repo, "No progressable transition found; Manager inspection is required.")
    print("no progressable transition found")
    return 2


def pump_stop_reason(state: dict[str, Any], args: argparse.Namespace) -> tuple[str, int] | None:
    phase = str(state.get("phase") or "")
    if build_decision_scheduler(state).loop_blocked:
        return ("pending user decision", 2)
    retryable_preflight_block = active_preflight_environment_block(state) and str(
        state.get("last_preflight_error", {}).get("previous_phase") or "dispatching"
    ) not in {
        "blocked_user_decision",
        "blocked_environment",
        "blocked_conflict",
        "failed_validation",
        "failed_manager_qa",
        "no_progress",
    }
    if phase in {
        "blocked_user_decision",
        "blocked_environment",
        "blocked_conflict",
        "failed_validation",
        "failed_manager_qa",
        "no_progress",
    } and not retryable_preflight_block:
        return (f"phase is {phase}", 2)
    if phase in RUN_TERMINAL_PHASES:
        return (f"loop is terminal: {phase}", 0)
    if phase == "ready_to_finish":
        return ("loop is ready; run hloop finish", 0)
    if phase == "paused":
        return ("loop is paused", 0)
    if phase == "blocked_agent":
        return ("an agent terminated without an artifact", 2)
    if phase == "branch_handoff":
        return ("branch handoff required", 0)
    if phase == "manager_qa":
        return ("manager final QA required", 0)
    if getattr(args, "stop_on_triage", True):
        if state.get("needs_gap_check") and reported_gap_exists(state):
            return ("gap triage required", 0)
        if state.get("needs_review") and reported_review_exists(state):
            return ("review triage required", 0)
    if getattr(args, "stop_on_waiting", True) and phase in {
        "waiting_worker",
        "waiting_gap",
        "waiting_review",
    }:
        return (f"waiting in phase {phase}", 0)
    return None


def cmd_pump(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    transitions = 0
    max_transitions = max(1, int(args.max_transitions))
    while transitions < max_transitions:
        state = load_state(repo)
        stop = pump_stop_reason(state, args)
        if stop:
            reason, rc = stop
            print(f"pump stopped: {reason}")
            return rc
        tick_args = argparse.Namespace(**vars(args))
        tick_args.once = True
        tick_args.dry_run = args.dry_run
        tick_args.stop_on_user_decision = True
        if not args.wait:
            if tick_args.review_wait_ms is None:
                tick_args.review_wait_ms = 0
            if tick_args.gap_wait_ms is None:
                tick_args.gap_wait_ms = 0
        rc = cmd_tick(tick_args)
        transitions += 1
        if rc != 0:
            print(f"pump stopped after {transitions} transition(s): tick returned {rc}")
            return rc
        state = load_state(repo)
        stop = pump_stop_reason(state, args)
        if stop:
            reason, rc = stop
            print(f"pump stopped after {transitions} transition(s): {reason}")
            return rc
        if args.sleep_ms > 0:
            time.sleep(args.sleep_ms / 1000)
    print(f"pump stopped: reached max transitions ({max_transitions})")
    return 0


def cmd_harvest(args: argparse.Namespace) -> int:
    agent_id = str(args.agent_id)
    if agent_id.startswith("T"):
        args.task_id = agent_id
        return cmd_worker_harvest(args)
    if agent_id.startswith("R"):
        args.review_id = agent_id
        return cmd_reviewer_harvest(args)
    if agent_id.startswith("G"):
        args.gap_id = agent_id
        return cmd_gap_harvest(args)
    if agent_id.startswith("A"):
        advice_id, participant_id = split_advice_target(agent_id, getattr(args, "participant_id", None))
        args.advice_id = advice_id
        args.participant_id = participant_id
        return cmd_advisor_harvest(args)
    raise HLoopError(f"cannot infer harvest target from id: {agent_id}; use T..., R..., G..., or A...")


def split_advice_target(agent_id: str, participant_id: str | None = None) -> tuple[str, str]:
    if "/" in agent_id:
        advice_id, participant = agent_id.split("/", 1)
        return advice_id, participant or "P1"
    if ":" in agent_id:
        advice_id, participant = agent_id.split(":", 1)
        return advice_id, participant or "P1"
    return agent_id, participant_id or "P1"


def resolve_agent_state(state: dict[str, Any], agent_id: str) -> tuple[str, dict[str, Any]]:
    if agent_id.startswith("T"):
        agent = state.get("tasks", {}).get(agent_id)
        if agent:
            return "worker", agent
    if agent_id.startswith("R"):
        agent = state.get("reviews", {}).get(agent_id)
        if agent:
            return "reviewer", agent
    if agent_id.startswith("G"):
        agent = state.get("gaps", {}).get(agent_id)
        if agent:
            return "gap", agent
    if agent_id.startswith("A"):
        advice_id, participant_id = split_advice_target(agent_id)
        advice = state.get("advice", {}).get(advice_id)
        if isinstance(advice, dict):
            return "advisor", find_advisor_participant(advice, participant_id)
    raise HLoopError(f"unknown agent id: {agent_id}")


def product_dirty_paths_for_agent(worktree: Path) -> list[str]:
    loop_root = LOOP_DIR.as_posix()
    loop_prefix = loop_root + "/"
    return [
        path
        for path in safe_porcelain_paths(worktree)
        if path != loop_root and not path.startswith(loop_prefix)
    ]


def cleanup_agent_worktree_for_lifecycle(
    repo: Path,
    agent: dict[str, Any],
    *,
    force: bool,
) -> None:
    worktree_raw = str(agent.get("worktree") or "")
    if not worktree_raw:
        return
    worktree = Path(worktree_raw).resolve()
    if not worktree.exists() or worktree == repo:
        return
    dirty = product_dirty_paths_for_agent(worktree)
    if dirty and not force:
        raise HLoopError(
            "agent worktree has product changes; rerun with --force-cleanup to discard them: "
            + ", ".join(dirty)
        )
    git(repo, ["worktree", "remove", "--force", str(worktree)])
    agent["worktree_cleanup_status"] = "removed"
    agent["worktree_cleaned_at"] = now_iso()


def cmd_agent_abort(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    role, agent = resolve_agent_state(state, args.agent_id)
    lifecycle_status = str(agent.get("gate_status") or agent.get("status") or "")
    if lifecycle_status in {"merged", "triaged", "closed"}:
        raise HLoopError(f"cannot abort completed {role} {args.agent_id}: {lifecycle_status}")
    cleanup_completed_agent_pane(
        repo,
        agent,
        label=f"{role} {args.agent_id}",
        session_cleanup=str(state.get("session_cleanup") or "archive"),
    )
    if not args.keep_worktree:
        cleanup_agent_worktree_for_lifecycle(repo, agent, force=args.force_cleanup)
    revoke_active_role_report_identity(repo, state, args.agent_id)
    supersede_pending_manager_messages(repo, agent)
    agent["status"] = "aborted"
    if role != "worker":
        agent["gate_status"] = "aborted"
    agent["abort_reason"] = args.reason
    agent["aborted_at"] = now_iso()
    state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Aborted {role} `{args.agent_id}`: {args.reason}")
    print(f"aborted {args.agent_id}: {args.reason}")
    return 0


def cmd_agent_ack_resolve(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    role, agent = resolve_agent_state(state, args.agent_id)
    attempt_id = str(agent.get("attempt_id") or agent.get("active_attempt_id") or "")
    if not attempt_id:
        raise HLoopError(f"active attempt identity is missing for {args.agent_id}")
    store = _open_broker_store(repo)
    with store.transaction() as transaction:
        latest_ack = store.latest_role_event(
            transaction,
            run_id=str(state.get("run_id") or "local"),
            role_id=args.agent_id,
            attempt_id=attempt_id,
            report_type="ack",
        )
    barrier = resolve_semantic_ack_barrier(
        agent,
        decision=args.decision,
        reason=args.reason,
        latest_ack=latest_ack,
    )
    save_state(repo, state)
    journal(
        repo,
        f"Resolved semantic ACK barrier for {role} `{args.agent_id}` "
        f"(message `{barrier.get('message_id')}`) as `{barrier['status']}`: {args.reason}",
    )
    print(f"{args.agent_id}: semantic ACK barrier {barrier['status']}")
    pane_id = str(agent.get("pane_id") or "")
    if pane_id:
        if barrier["status"] == "approved":
            notice = (
                f"Semantic ACK {barrier.get('ack_event_id')} is approved. "
                "Resume the contracted material work."
            )
        else:
            notice = (
                f"Semantic ACK barrier is {barrier['status']}: {args.reason}. "
                "Remain stopped and submit a corrected new ACK event."
            )
        delivery_args = argparse.Namespace(
            contract_changing=False,
            timeout_ms=30_000,
            input_settle_ms=DEFAULT_MANAGER_MESSAGE_INPUT_SETTLE_MS,
            submit_verify_ms=DEFAULT_MANAGER_MESSAGE_SUBMIT_VERIFY_MS,
            submit_attempts=DEFAULT_MANAGER_MESSAGE_SUBMIT_ATTEMPTS,
        )
        return send_manager_message_and_record(
            repo,
            state,
            agent,
            role=role.title(),
            agent_id=args.agent_id,
            pane_id=pane_id,
            message=notice,
            source="semantic-ack-resolution",
            args=delivery_args,
        )
    return 0


def cmd_agent_requeue(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    role, agent = resolve_agent_state(state, args.agent_id)
    lifecycle_status = str(agent.get("gate_status") or agent.get("status") or "")
    if lifecycle_status in {"merged", "triaged", "closed"}:
        raise HLoopError(f"cannot requeue completed {role} {args.agent_id}: {lifecycle_status}")
    previous = json.loads(json.dumps(agent))
    cleanup_completed_agent_pane(
        repo,
        agent,
        label=f"{role} {args.agent_id}",
        session_cleanup=str(state.get("session_cleanup") or "archive"),
    )
    cleanup_agent_worktree_for_lifecycle(repo, agent, force=args.force_cleanup)
    revoke_active_role_report_identity(repo, state, args.agent_id)
    superseded_messages = supersede_pending_manager_messages(repo, agent)
    history = {
        "agent_id": args.agent_id,
        "role": role,
        "previous_status": agent.get("status"),
        "reason": args.reason,
        "at": now_iso(),
        "attempt_id": previous.get("attempt_id") or previous.get("active_attempt_id"),
        "attempt_no": previous.get("attempt_no"),
        "branch": previous.get("branch"),
        "worker_base_sha": previous.get("worker_base_sha") or previous.get("base_sha"),
        "head_sha": previous.get("head_sha"),
        "worktree": previous.get("worktree"),
        "pane_id": previous.get("pane_id"),
        "superseded_manager_messages": superseded_messages,
    }
    state.setdefault("agent_attempt_history", []).append(history)
    agent.setdefault("attempts", []).append(history)
    if role == "worker":
        old_branch = str(previous.get("branch") or "")
        root_branch = str(previous.get("root_branch") or old_branch)
        if old_branch and branch_exists(repo, old_branch):
            integration = str(state.get("integration_branch") or "")
            old_head = git(repo, ["rev-parse", old_branch])
            integrated = bool(integration) and is_ancestor(repo, old_head, integration)
            if not integrated:
                archive_branch = (
                    f"{old_branch}-archive-a{normalize_int(previous.get('attempt_no'), 0):03d}-"
                    f"{datetime.now(timezone.utc).strftime('%Y%m%d%H%M%S')}"
                )
                git(repo, ["branch", "-m", old_branch, archive_branch])
                history["archived_branch"] = archive_branch
            else:
                git(repo, ["branch", "-D", old_branch])
        next_attempt = normalize_int(previous.get("attempt_no"), 0) + 1
        for key in (
            "pane_id",
            "pane_closed_at",
            "pane_cleanup_status",
            "pane_cleanup_error",
            "prompt",
            "worktree",
            "worktree_cleaned_at",
            "worktree_cleanup_status",
            "started_at",
            "result_status",
            "merge_ready",
            "artifact",
            "head_sha",
            "active_attempt_id",
            "attempt_id",
            "worker_base_sha",
            "base_sha",
            "reported_base_sha",
            "reported_base_sha_was_ancestor",
            "reported_base_sha_note",
            "agent_session_id",
            "codex_session_id",
            "agent_session_cleanup",
            "codex_session_cleanup",
            "manager_messages",
            "pending_manager_messages",
            "unknown_manager_messages",
            "semantic_ack_barrier",
        ):
            agent.pop(key, None)
        agent["root_branch"] = root_branch
        agent["branch"] = f"{root_branch}-a{next_attempt:03d}"
        agent["status"] = "queued"
        agent["requeued_at"] = now_iso()
        agent["requeue_reason"] = args.reason
    elif role == "reviewer":
        state.get("reviews", {}).pop(args.agent_id, None)
    elif role == "gap":
        state.get("gaps", {}).pop(args.agent_id, None)
    else:
        advice_id, participant_id = split_advice_target(args.agent_id)
        advice = require_advice_state(state, advice_id)
        advice["participants"] = [
            item
            for item in advice.get("participants", [])
            if str(item.get("participant_id") or "") != participant_id
        ]
        advice["participants"].append(
            {
                "participant_id": participant_id,
                "provider": agent.get("provider") or agent.get("agent_provider") or DEFAULT_AGENT_PROVIDER,
                "model": agent.get("model") or agent.get("agent_model") or DEFAULT_AGENT_MODEL,
                "status": "queued",
            }
        )
    state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Requeued {role} `{args.agent_id}`: {args.reason}")
    print(f"requeued {args.agent_id}: {args.reason}")
    return 0


def cmd_runtime_trust_git(args: argparse.Namespace) -> int:
    """Re-trust a new git executable identity after a legitimate upgrade.

    Refuses while any role is running or a merge transaction is active so the
    trust boundary cannot move underneath in-flight work; ``preflight_loop``
    blocks every other command on drift until this runs.
    """

    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    if any_active_roles(state):
        raise HLoopError("cannot trust a new git identity while a role is running")
    if state.get("active_merge"):
        raise HLoopError("cannot trust a new git identity during an active merge transaction")
    previous = state.get("git_identity")
    current = git_executable_identity()
    state["git_identity"] = current
    save_state(repo, state)
    journal(
        repo,
        f"Trusted new git executable identity ({args.reason}); "
        f"previous={json.dumps(previous, sort_keys=True)} new={json.dumps(current, sort_keys=True)}",
    )
    print(f"trusted git identity: {current['path']} sha256={current['sha256']}")
    return 0


def broker_transport_root(repo: Path) -> Path:
    """Shared broker storage root common to every worktree of one repository.

    Detached roles (Workers, Reviewers, ...) run in their own `git worktree`
    checkout, each with an independent `LOOP_DIR`. `--git-common-dir` resolves
    to the same physical path from any worktree of the same repository, so
    anchoring broker storage there lets every role reach the Manager's one
    broker transport without copying local-sensitive loop state into each
    worktree (`copy_local_loop_snapshot` only ever touches `LOOP_DIR`, which
    this path deliberately sits outside of).
    """

    return git_common_dir(repo) / "herdr-dev-loop-broker" / LOOP_NAMESPACE


def report_credential_root(repo: Path) -> Path:
    """Return the private, worktree-shared directory for role credentials."""

    directory = broker_transport_root(repo) / "credentials"
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    if directory.is_symlink():
        raise HLoopError("report credential directory must not be a symlink")
    try:
        directory.chmod(0o700)
    except OSError as exc:
        raise HLoopError(f"cannot secure report credential directory: {exc}") from exc
    metadata = directory.lstat()
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        raise HLoopError("report credential directory must be owned by the current user with mode 0700")
    return directory


def role_report_credential_path(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    attempt_id: str,
) -> Path:
    identity = "\0".join(
        (
            LOOP_NAMESPACE,
            str(state.get("run_id") or "local"),
            role_id,
            attempt_id,
        )
    )
    name = hashlib.sha256(identity.encode("utf-8")).hexdigest() + ".json"
    return report_credential_root(repo) / name


def role_report_outbox_path(
    repo: Path, *, run_id: str, role_id: str, attempt_id: str
) -> Path:
    """Return the private, worktree-shared path for one attempt's outbox.

    Anchored beside the report credential directory (`broker_transport_root`)
    so every worktree of the repository resolves the same path, and stored
    outside `LOOP_DIR` like the credential and spool directories.
    """

    identity = "\0".join((LOOP_NAMESPACE, run_id, role_id, attempt_id))
    name = hashlib.sha256(identity.encode("utf-8")).hexdigest() + ".json"
    return broker_transport_root(repo) / "outbox" / name


def write_role_report_credential(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    attempt_id: str,
    token: str,
) -> Path:
    """Atomically persist one attempt credential without a world-readable window."""

    destination = role_report_credential_path(
        repo, state, role_id=role_id, attempt_id=attempt_id
    )
    payload = {
        "schema_version": 1,
        "namespace": LOOP_NAMESPACE,
        "run_id": str(state.get("run_id") or "local"),
        "role_id": role_id,
        "attempt_id": attempt_id,
        "token": token,
    }
    temporary = destination.with_name(f".{destination.name}.{uuid.uuid4().hex}.tmp")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(temporary, flags, 0o600)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            descriptor = -1
            json.dump(payload, stream, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, destination)
        destination.chmod(0o600)
    except BaseException:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
        raise
    return destination.resolve()


def read_role_report_credential(
    repo: Path,
    credential_file: str,
    *,
    run_id: str,
    role_id: str,
    attempt_id: str,
) -> str:
    """Load and bind a private credential without echoing its secret in errors."""

    root = report_credential_root(repo).resolve()
    path = Path(credential_file).expanduser().resolve()
    try:
        path.relative_to(root)
    except ValueError as exc:
        raise HLoopError("report credential file is outside the local credential store") from exc
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise HLoopError(f"cannot open report credential file: {exc.strerror or exc}") from exc
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise HLoopError("report credential file must be a regular file")
        if metadata.st_uid != os.geteuid() or stat.S_IMODE(metadata.st_mode) != 0o600:
            raise HLoopError(
                "report credential file must be owned by the current user with mode 0600"
            )
        with os.fdopen(descriptor, "r", encoding="utf-8") as stream:
            descriptor = -1
            payload = json.load(stream)
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise HLoopError("report credential file is unreadable or invalid") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    expected = {
        "schema_version": 1,
        "namespace": LOOP_NAMESPACE,
        "run_id": run_id,
        "role_id": role_id,
        "attempt_id": attempt_id,
    }
    if not isinstance(payload, dict) or any(payload.get(key) != value for key, value in expected.items()):
        raise HLoopError("report credential identity does not match this report")
    token = str(payload.get("token") or "")
    if not re.fullmatch(r"[0-9a-f]{64}", token):
        raise HLoopError("report credential token is invalid")
    return token


def remove_role_report_credential(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    attempt_id: str,
) -> None:
    path = role_report_credential_path(repo, state, role_id=role_id, attempt_id=attempt_id)
    try:
        path.unlink()
    except FileNotFoundError:
        pass


def broker_root(repo: Path) -> Path:
    return broker_transport_root(repo) / "store"


def broker_spool_dir(repo: Path) -> Path:
    # Deliberately a sibling of broker_root(), not nested under it, so a
    # locked-down or corrupted broker directory cannot also block the
    # fallback spool path used when the broker itself is unavailable.
    directory = broker_transport_root(repo) / "spool"
    directory.mkdir(parents=True, exist_ok=True)
    return directory


def _open_broker_store(repo: Path) -> "hloop_broker.BrokerStore":
    return hloop_broker.BrokerStore(broker_root(repo))


def any_active_roles(state: dict[str, Any]) -> bool:
    """True while any Worker, Reviewer, Gap Auditor, or Advisor is running."""

    tasks = state.get("tasks", {}).values()
    reviews = state.get("reviews", {}).values()
    gaps = state.get("gaps", {}).values()
    participants = [
        participant
        for advice in state.get("advice", {}).values()
        for participant in advice.get("participants", [])
    ]
    return (
        any(item.get("status") == "running" for item in tasks)
        or any(item.get("gate_status") == "running" for item in reviews)
        or any(item.get("gate_status") == "running" for item in gaps)
        or any(
            item.get("gate_status") == "running" or item.get("status") == "running"
            for item in participants
        )
    )


def default_hooks_settings_path(repo: Path, provider: str) -> Path:
    if provider == "claude":
        return repo / ".claude" / "settings.json"
    raise HLoopError(
        f"no default hooks settings path for provider {provider!r}; pass --settings-path"
    )


def hooks_settings_path(repo: Path, args: argparse.Namespace) -> Path:
    if getattr(args, "settings_path", None):
        return Path(args.settings_path).resolve()
    return default_hooks_settings_path(repo, args.provider)


def load_hook_settings(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise HLoopError(f"cannot read hook settings {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise HLoopError(f"hook settings must be a JSON object: {path}")
    return value


def write_hook_settings(path: Path, settings: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    write_text(path, json.dumps(settings, indent=2, sort_keys=True) + "\n")


def cmd_hooks_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    path = hooks_settings_path(repo, args)
    settings = load_hook_settings(path)
    owned = hloop_hooks.owned_stop_hook_count(settings, provider=args.provider)
    print(
        json.dumps(
            {"provider": args.provider, "settings_path": str(path), "owned_stop_hooks": owned},
            sort_keys=True,
        )
    )
    return 0


def cmd_hooks_install(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    path = hooks_settings_path(repo, args)
    plan = hloop_hooks.plan_stop_hook(
        provider=args.provider,
        helper_path=Path(__file__).resolve(),
        namespace=LOOP_NAMESPACE,
        enabled=True,
        codex_continuation_capability=args.codex_continuation_capability,
    )
    if not plan.installable:
        print(f"not installed: {plan.reason}")
        return 0
    existing = load_hook_settings(path)
    if path.exists():
        write_text(path.with_name(f"{path.name}.bak"), json.dumps(existing, indent=2, sort_keys=True) + "\n")
    change = hloop_hooks.merge_stop_hook(existing, plan)
    write_hook_settings(path, change.settings)
    journal(repo, f"Installed HLoop Stop hook guard for provider {args.provider} at {path}.")
    print(f"installed Stop hook guard for {args.provider} at {path}")
    if plan.trust_required:
        print("this provider requires an explicit trust/approval step before the hook runs")
    if plan.reload_required:
        print("a settings reload or session restart may be required for the hook to take effect")
    return 0


def cmd_hooks_uninstall(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    path = hooks_settings_path(repo, args)
    existing = load_hook_settings(path)
    change = hloop_hooks.uninstall_stop_hook(existing, provider=args.provider)
    if not change.changed:
        print(f"no owned Stop hook to remove for {args.provider} at {path}")
        return 0
    write_hook_settings(path, change.settings)
    journal(repo, f"Uninstalled HLoop Stop hook guard for provider {args.provider} at {path}.")
    print(f"uninstalled Stop hook guard for {args.provider} at {path}")
    return 0


def cmd_hooks_guard(args: argparse.Namespace) -> int:
    """Invoked by the installed Stop hook itself; never called directly by a user."""

    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    run_id = str(state.get("run_id") or "local")
    active = any_active_roles(state)
    valid_lease = False
    try:
        store = _open_broker_store(repo)
        with store.transaction() as txn:
            lease = store.current_lease(txn, run_id=run_id)
            if lease is not None:
                valid_lease = store.lease_generation_matches(
                    txn, run_id=run_id, generation=int(lease["generation"])
                )
    except (hloop_broker.BrokerStorageError, OSError):
        valid_lease = False
    response = hloop_hooks.render_stop_guard_response(
        provider=args.provider, active_roles=active, valid_wake_lease=valid_lease
    )
    print(json.dumps(response))
    return 0


def revoke_active_role_report_identity(repo: Path, state: dict[str, Any], role_id: str) -> None:
    """Revoke a role before completing a lifecycle transition, or fail closed."""

    attempt_id = ""
    try:
        store = _open_broker_store(repo)
        with store.transaction() as txn:
            current = store._latest_active_role(  # noqa: SLF001 - same-runtime storage contract
                txn,
                run_id=str(state.get("run_id") or "local"),
                role_id=role_id,
            )
            if current is not None:
                attempt_id = str(current.get("attempt_id") or "")
            store.revoke_active_role(
                txn, run_id=str(state.get("run_id") or "local"), role_id=role_id
            )
    except (hloop_broker.BrokerStorageError, OSError) as exc:
        raise HLoopError(
            f"could not revoke report identity for {role_id}; lifecycle transition is blocked: {exc}"
        ) from exc
    if attempt_id:
        try:
            remove_role_report_credential(
                repo, state, role_id=role_id, attempt_id=attempt_id
            )
        except OSError as exc:
            raise HLoopError(
                f"could not remove report credential for {role_id}: {exc.strerror or exc}"
            ) from exc


_AGENT_REPORT_CONTENT_ARGS = (
    "type",
    "stage",
    "summary",
    "next",
    "evidence_ref",
    "understood_goal",
    "scope",
    "acceptance",
    "approach",
    "risk",
    "impact",
    "attempted",
    "option_text",
    "recommendation",
    "blocked_scope",
    "artifact",
    "head_sha",
    "validation_result_ref",
    "residual_risk",
    "handoff",
)


def _read_agent_report_body(args: argparse.Namespace) -> dict[str, Any] | None:
    """Read a schema-validated JSON report body from --file or stdin.

    Returns ``None`` when neither is used, so the caller falls back to the
    individual report content flags kept as compatibility input.
    """

    file_path = getattr(args, "file", None)
    use_stdin = bool(getattr(args, "stdin", False))
    if not file_path and not use_stdin:
        return None
    if file_path:
        raw = read_text(Path(file_path).resolve())
        source = "file"
    else:
        raw = sys.stdin.read()
        source = "stdin"
    try:
        body = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise HLoopError(f"invalid report JSON ({source}): {exc}") from exc
    if not isinstance(body, dict):
        raise HLoopError(f"report JSON ({source}) must be a JSON object")
    unknown = set(body) - hloop_events.REPORT_CONTENT_FIELDS
    if unknown:
        raise HLoopError(
            "report JSON contains unknown fields: " + ", ".join(sorted(unknown))
        )
    return body


def cmd_agent_report(args: argparse.Namespace) -> int:
    """Submit an agent report; spools to disk when the broker is unavailable."""

    repo = repo_root(Path(args.repo).resolve())
    # A detached role's own worktree deliberately has no local STATE.json (the
    # broker transport lives outside `LOOP_DIR`, see `broker_transport_root`),
    # so only fall back to reading it when the caller omitted --run-id.
    run_id = args.run_id or (str(load_state(repo).get("run_id") or "local") if _has_local_state(repo) else "local")
    direct_token = str(getattr(args, "report_token", None) or "")
    credential_file = str(getattr(args, "report_credential_file", None) or "")
    if direct_token and credential_file:
        raise HLoopError("use only one report credential source")
    report_token = direct_token
    if credential_file:
        report_token = read_role_report_credential(
            repo,
            credential_file,
            run_id=run_id,
            role_id=str(args.role_id or ""),
            attempt_id=str(args.attempt_id or ""),
        )

    body = _read_agent_report_body(args)
    if body is not None:
        used_flags = sorted(
            name for name in _AGENT_REPORT_CONTENT_ARGS if getattr(args, name, None)
        )
        if used_flags:
            raise HLoopError(
                "use only one of --file/--stdin or individual report content "
                "flags (found: " + ", ".join(used_flags) + ")"
            )
        report_type = body.get("type")
        content = dict(body)
    else:
        report_type = args.type
        if not report_type:
            raise HLoopError("--type is required unless --file or --stdin is used")
        if args.stage is None:
            raise HLoopError("--stage is required unless --file or --stdin is used")
        if args.summary is None:
            raise HLoopError("--summary is required unless --file or --stdin is used")
        if args.next is None:
            raise HLoopError("--next is required unless --file or --stdin is used")
        content = {
            "stage": args.stage,
            "summary": args.summary,
            "next": args.next,
            "evidence_refs": args.evidence_ref or [],
        }
        if report_type == "ack":
            content.update(
                understood_goal=args.understood_goal or args.summary,
                scope=args.scope or [],
                acceptance=args.acceptance or [],
                approach=args.approach or args.summary,
            )
        elif report_type == "milestone":
            content["risks"] = args.risk or []
        elif report_type == "attention":
            content.update(
                impact=args.impact or args.summary,
                attempted=args.attempted or [],
                options=args.option_text or [],
                recommendation=args.recommendation or "",
                blocked_scope=args.blocked_scope or [],
            )
        elif report_type == "completion":
            content.update(
                artifact=args.artifact or "",
                head_sha=args.head_sha or "",
                validation_results=args.validation_result_ref or [],
                residual_risks=args.residual_risk or [],
                handoff=args.handoff or "",
            )

    report: dict[str, Any] = {
        "run_id": run_id,
        "role_id": args.role_id,
        "attempt_id": args.attempt_id or args.role_id,
        "task_contract_digest": args.task_contract_digest
        or hashlib.sha256(args.role_id.encode("utf-8")).hexdigest(),
        "type": report_type,
        "needs_manager": report_type in {"ack", "attention"},
        "created_at": now_iso(),
    }
    report.update(content)

    try:
        normalized = hloop_events.validate_report(report)
    except hloop_events.ReportValidationError as exc:
        raise HLoopError(f"invalid report: {exc}") from exc
    digest = hloop_events.payload_digest(normalized)
    requested_event_id = None
    raw_event_id = getattr(args, "event_id", None)
    if raw_event_id:
        try:
            requested_event_id = hloop_events.normalize_event_id(raw_event_id)
        except hloop_events.ReportValidationError as exc:
            raise HLoopError(f"invalid report: {exc}") from exc
    outbox_path = role_report_outbox_path(
        repo,
        run_id=str(report["run_id"]),
        role_id=str(report["role_id"]),
        attempt_id=str(report["attempt_id"]),
    )
    resolved_event_id = hloop_broker.role_outbox_event_id(
        outbox_path,
        payload_digest=digest,
        requested_event_id=requested_event_id,
    )
    try:
        client_event = hloop_events.prepare_client_event(report, event_id=resolved_event_id)
    except hloop_events.ReportValidationError as exc:
        raise HLoopError(f"invalid report: {exc}") from exc

    class _Unauthenticated(RuntimeError):
        pass

    try:
        store = _open_broker_store(repo)
        with store.transaction() as txn:
            if not report_token or not store.authenticate_role_report(
                txn,
                run_id=client_event["run_id"],
                role_id=client_event["role_id"],
                attempt_id=client_event["attempt_id"],
                task_contract_digest=client_event["task_contract_digest"],
                token=report_token,
            ):
                raise _Unauthenticated(
                    "report does not match a registered active "
                    "run/role/attempt/digest/token identity "
                    f"for role {client_event['role_id']}"
                )
            stored = store.accept_report(txn, client_event)
            lease = store.current_lease(txn, run_id=stored.event["run_id"])
            if lease is not None and stored.event["type"] in REPORT_WAKE_TYPES:
                try:
                    store.enqueue_wake(
                        txn,
                        event_id=stored.event["event_id"],
                        lease_generation=int(lease["generation"]),
                        manager_session_id=lease.get("manager_session_id"),
                        pane_id=lease.get("pane_id"),
                    )
                except hloop_broker.LeaseGenerationMismatch:
                    pass
            owner = store.current_owner(
                txn, namespace=LOOP_NAMESPACE, run_id=stored.event["run_id"]
            )
    except _Unauthenticated as exc:
        raise HLoopError(str(exc)) from exc
    except (hloop_broker.BrokerStorageError, OSError) as exc:
        spool_path = hloop_broker.spool_client_event(
            broker_spool_dir(repo),
            client_event,
            authentication={
                "run_id": client_event["run_id"],
                "role_id": client_event["role_id"],
                "attempt_id": client_event["attempt_id"],
                "task_contract_digest": client_event["task_contract_digest"],
                "token": report_token,
            },
        )
        try:
            hloop_supervisor.signal_supervisor(
                hloop_broker.derive_runtime_socket_path(
                    LOOP_NAMESPACE, client_event["run_id"]
                )
            )
        except (OSError, hloop_supervisor.SupervisorError):
            pass
        print(f"spooled {client_event['event_id']} (broker unavailable: {exc})")
        return 0
    if owner is not None and stored.event["type"] in REPORT_WAKE_TYPES:
        try:
            hloop_supervisor.signal_supervisor(Path(owner["socket_path"]))
        except (OSError, hloop_supervisor.SupervisorError):
            pass
    print(f"accepted {stored.event['event_id']} (broker)")
    return 0


def cmd_inbox_list(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    store = _open_broker_store(repo)
    with store.transaction() as txn:
        rows = store.unconsumed_inbox(
            txn, run_id=str(state.get("run_id") or "local")
        )
    if not rows:
        print("inbox empty")
        return 0
    for row in rows:
        print(json.dumps(row, sort_keys=True))
    return 0


def cmd_inbox_show(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    store = _open_broker_store(repo)
    with store.transaction() as txn:
        event = store.get_event(txn, event_id=args.event_id)
    if event is None:
        raise HLoopError(f"no such broker event: {args.event_id}")
    print(json.dumps(event, sort_keys=True))
    return 0


def cmd_inbox_ack(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    store = _open_broker_store(repo)
    with store.transaction() as txn:
        result = store.acknowledge_inbox(
            txn,
            event_id=args.event_id,
            run_id=str(state.get("run_id") or "local"),
        )
    if not result.accepted:
        raise HLoopError(f"could not ack {args.event_id}: {result.reason}")
    journal(repo, f"Acked inbox event `{args.event_id}`.")
    print(f"acked {args.event_id}")
    return 0


def cmd_manager_sleep(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    run_id = str(state.get("run_id") or "local")
    if isinstance(args.ttl_seconds, bool) or args.ttl_seconds <= 0:
        raise HLoopError("--ttl-seconds must be positive")
    store = _open_broker_store(repo)
    manager_session_id = (
        args.manager_session_id or os.environ.get("HERDR_SESSION_ID") or "manager"
    )
    pane_id = args.pane_id or os.environ.get("HERDR_PANE_ID") or "manager"
    fallback_watches: list[hloop_supervisor.FallbackWatch] = []
    role_states = [
        *state.get("tasks", {}).values(),
        *state.get("reviews", {}).values(),
        *state.get("gaps", {}).values(),
        *(
            participant
            for advice in state.get("advice", {}).values()
            for participant in advice.get("participants", [])
        ),
    ]
    for role_state in role_states:
        if (
            role_state.get("status") != "running"
            and role_state.get("gate_status") != "running"
        ):
            continue
        role_pane = str(role_state.get("pane_id") or "")
        if not role_pane:
            continue
        fallback_watches.extend(
            hloop_supervisor.FallbackWatch(role_pane, status)
            for status in sorted(hloop_supervisor.FALLBACK_STATUSES)
        )
    result = hloop_supervisor.ManagerSleepSupervisor(
        store,
        namespace=LOOP_NAMESPACE,
        run_id=run_id,
        runtime_version=SKILL_VERSION,
        manager_session_id=manager_session_id,
        pane_id=pane_id,
        spool_directory=broker_spool_dir(repo),
    ).sleep(
        timeout_seconds=float(args.ttl_seconds),
        fallback_watches=fallback_watches,
    )
    state["broker_lease"] = {
        "run_id": run_id,
        "generation": result.lease_generation,
        "manager_session_id": manager_session_id,
        "pane_id": pane_id,
        "status": "returned",
        "reason": result.reason,
        "returned_at": now_iso(),
    }
    state["last_manager_sleep"] = {
        "reason": result.reason,
        "event_ids": list(result.event_ids),
        "drained_reports": result.drained_reports,
        "fallback": (
            {
                "pane_id": result.fallback.pane_id,
                "status": result.fallback.status,
                "returncode": result.fallback.returncode,
            }
            if result.fallback is not None
            else None
        ),
    }
    save_state(repo, state)
    journal(
        repo,
        f"Manager sleep returned `{result.reason}` at lease generation "
        f"{result.lease_generation}; events={','.join(result.event_ids) or 'none'}.",
    )
    print(f"manager sleep returned: {result.reason}")
    print(f"lease generation: {result.lease_generation}")
    for event_id in result.event_ids:
        print(f"event_id: {event_id}")
    if result.fallback is not None:
        print(
            f"fallback: {result.fallback.pane_id} "
            f"status={result.fallback.status}"
        )
    return 0


def cmd_manager_next(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    store = _open_broker_store(repo)
    spool_dir = broker_spool_dir(repo)
    if hloop_broker.spool_has_entries(spool_dir):
        with store.transaction() as txn:
            replayed = store.replay_spool(txn, spool_dir)
        quarantined = hloop_broker.spool_quarantine_count(spool_dir)
        journal(
            repo,
            f"Replayed {len(replayed)} spooled report(s) into the broker; "
            f"{quarantined} quarantined poison entrie(s) total.",
        )
        print(f"replayed {len(replayed)} spooled report(s); re-run to see pending wakes")
        return 0
    with store.transaction() as txn:
        unread = store.unconsumed_inbox(
            txn, run_id=str(state.get("run_id") or "local")
        )
    if not unread:
        print("no pending wakes")
        return 0
    for row in unread:
        print(json.dumps(row, sort_keys=True))
    return 0


def cmd_broker_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    run_id = str(state.get("run_id") or "local")
    store = _open_broker_store(repo)
    with store.transaction() as txn:
        events = store.events(txn)
        inbox_rows = store.inbox(txn)
        owner = store.current_owner(txn, namespace=LOOP_NAMESPACE, run_id=run_id)
    spool_dir = broker_spool_dir(repo)
    spooled = list(hloop_broker.iter_spooled_events(spool_dir))
    status = {
        "events": len(events),
        "inbox": len(inbox_rows),
        "spooled": len(spooled),
        "spool_quarantined": hloop_broker.spool_quarantine_count(spool_dir),
        "owner": owner,
        "lease": state.get("broker_lease"),
    }
    print(json.dumps(status, sort_keys=True, default=str))
    return 0


def cmd_broker_recover(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    store = _open_broker_store(repo)
    spool_dir = broker_spool_dir(repo)
    with store.transaction() as txn:
        replayed = store.replay_spool(txn, spool_dir)
    quarantined = hloop_broker.spool_quarantine_count(spool_dir)
    journal(
        repo,
        f"Broker recover replayed {len(replayed)} spooled report(s); "
        f"{quarantined} quarantined poison entrie(s) total.",
    )
    print(f"replayed {len(replayed)} spooled report(s)")
    print(f"quarantined {quarantined} poison entrie(s) total")
    return 0


def next_input_id(existing: dict[str, Any]) -> str:
    nums = [int(key[1:]) for key in existing if re.fullmatch(r"U[0-9]{4}", key)]
    return f"U{(max(nums) if nums else 0) + 1:04d}"


def next_requirement_id(existing: dict[str, Any]) -> str:
    nums = [int(key[4:]) for key in existing if re.fullmatch(r"REQ-[0-9]{3}", key)]
    return f"REQ-{(max(nums) if nums else 0) + 1:03d}"


def next_requirement_draft_id(existing: dict[str, Any]) -> str:
    nums = [int(key[4:]) for key in existing if re.fullmatch(r"DRQ-[0-9]{3}", key)]
    return f"DRQ-{(max(nums) if nums else 0) + 1:03d}"


def local_sensitive_input_dir(repo: Path) -> Path:
    directory = repo / LOOP_DIR / "inputs"
    directory.mkdir(parents=True, exist_ok=True)
    return directory


def requirement_progress_from_state(
    state: dict[str, Any], requirement_id: str
) -> hloop_requirements.RequirementProgress:
    raw = (state.get("requirements") or {}).get(requirement_id, {}).get("progress")
    if raw:
        return hloop_requirements.RequirementProgress.from_record(raw)
    requirement = require_requirement(state, requirement_id)
    status = "superseded" if requirement.status == "superseded" else "not_started"
    return hloop_requirements.RequirementProgress(
        requirement_id=requirement_id, status=status
    )


def write_requirement_artifacts(repo: Path, state: dict[str, Any]) -> None:
    """Refresh the accepted ledger and user-facing progress status."""

    requirements_dir = loop_path(repo) / "requirements"
    requirements_dir.mkdir(parents=True, exist_ok=True)
    records = [
        require_requirement(state, requirement_id)
        for requirement_id in sorted((state.get("requirements") or {}).keys())
    ]
    ledger_lines = [
        "# Requirements",
        "",
        "| ID | Priority | Status | Source | Acceptance | Dependencies | Supersedes |",
        "|---|---|---|---|---|---|---|",
    ]
    for record in records:
        ledger_lines.append(
            "| "
            + " | ".join(
                (
                    record.requirement_id,
                    record.priority,
                    record.status,
                    ", ".join(record.source_inputs),
                    "<br>".join(record.acceptance),
                    ", ".join(record.dependencies) or "-",
                    ", ".join(record.supersedes) or "-",
                )
            )
            + " |"
        )
    if not records:
        ledger_lines.append("| - | - | - | - | No requirements accepted. | - | - |")
    write_text(requirements_dir / "REQUIREMENTS.md", "\n".join(ledger_lines) + "\n")

    progress_rows = [
        requirement_progress_from_state(state, record.requirement_id) for record in records
    ]
    counts = {
        status: sum(item.status == status for item in progress_rows)
        for status in sorted(hloop_requirements.PROGRESS_STATUSES)
    }
    summary = (
        f"{len(progress_rows)}要件中{counts['verified']}件を検証済み、"
        f"{counts['implemented_unverified']}件は実装済み・未検証、"
        f"{counts['blocked']}件は判断または外部条件待ちです。"
    )
    status_lines = [
        "# Requirement Status",
        "",
        summary,
        "",
        "| Requirement | Status | Tasks | Evidence | Remaining work / blockers |",
        "|---|---|---|---|---|",
    ]
    for item in progress_rows:
        evidence = "<br>".join(ref.reference for ref in item.evidence) or "-"
        remaining = item.remaining_work or "; ".join(item.blockers) or "-"
        status_lines.append(
            f"| {item.requirement_id} | {item.status} | "
            f"{', '.join(item.task_ids) or '-'} | {evidence} | {remaining} |"
        )
    if not progress_rows:
        status_lines.append("| - | not_started | - | - | Accept requirements first. |")
    write_text(requirements_dir / "STATUS.md", "\n".join(status_lines) + "\n")


def next_progress_id(state: dict[str, Any]) -> str:
    sequence = int(state.get("progress_sequence") or 0) + 1
    state["progress_sequence"] = sequence
    return f"P{sequence:04d}"


def write_progress_artifact(repo: Path, state: dict[str, Any]) -> Path:
    progress_id = next_progress_id(state)
    snapshot = hloop_requirements.ProgressSnapshot(
        progress_id=progress_id,
        created_at=now_iso(),
        requirements=tuple(
            requirement_progress_from_state(state, requirement_id)
            for requirement_id in sorted((state.get("requirements") or {}).keys())
        ),
    )
    progress_dir = loop_path(repo) / "progress"
    progress_dir.mkdir(parents=True, exist_ok=True)
    lines = ["# Progress", "", snapshot.summary(), "", "## Requirements", ""]
    for item in snapshot.requirements:
        suffix = item.remaining_work or "; ".join(item.blockers) or "完了条件を確認中"
        lines.append(f"- {item.requirement_id}: `{item.status}` — {suffix}")
    if not snapshot.requirements:
        lines.append("- 受け入れ済み要件はありません。")
    path = progress_dir / f"{progress_id}.md"
    content = frontmatter(
        {
            "progress_id": progress_id,
            "created_at": snapshot.created_at,
            "requirement_count": len(snapshot.requirements),
        }
    ) + "\n" + "\n".join(lines) + "\n"
    write_text(path, content)
    write_text(progress_dir / "LATEST.md", content)
    state["latest_progress_artifact"] = path.relative_to(repo).as_posix()
    return path


def write_manager_context_artifact(repo: Path, state: dict[str, Any]) -> Path:
    context_dir = loop_path(repo) / "context"
    context_dir.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Manager Context",
        "",
        "繰り返し参照する制約・判断・repository 固有の注意だけを記録します。",
        "",
    ]
    for item in state.get("manager_context") or []:
        lines.extend(
            [
                f"## {item['id']}",
                "",
                item["text"],
                "",
                f"Source: `{item['source']}` / recorded `{item['recorded_at']}`",
                "",
            ]
        )
    if not state.get("manager_context"):
        lines.append("繰り返し参照する Manager context はまだありません。\n")
    path = context_dir / "MANAGER_CONTEXT.md"
    write_text(path, "\n".join(lines))
    return path


def cmd_input_record(args: argparse.Namespace) -> int:
    """Capture raw user input as a redacted, checkpoint-excluded local record."""

    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    inputs_index = state.setdefault("inputs_index", {})
    input_id = next_input_id(inputs_index)
    if getattr(args, "file", None):
        source_path = Path(args.file).expanduser().resolve()
        try:
            raw_input = source_path.read_text(encoding="utf-8")
        except OSError as exc:
            raise HLoopError(f"cannot read input file {source_path}: {exc}") from exc
    else:
        raw_input = str(getattr(args, "text", None) or "")
    try:
        record = hloop_requirements.InputRecord.capture(
            input_id=input_id,
            received_at=now_iso(),
            source=args.source,
            raw_input=raw_input,
        )
    except hloop_requirements.RequirementModelError as exc:
        raise HLoopError(str(exc)) from exc

    input_path = local_sensitive_input_dir(repo) / f"{input_id}.json"
    relative_path = input_path.relative_to(repo).as_posix()
    if not hloop_requirements.checkpoint_inclusion_allowed(
        relative_path, artifact_class=record.artifact_class
    ):
        # Expected: this path is deliberately excluded from `hloop checkpoint`
        # and any product commit; it stays local-only on disk.
        pass
    input_path.write_text(
        json.dumps(record.to_record(), indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    input_md = local_sensitive_input_dir(repo) / f"{input_id}.md"
    write_text(
        input_md,
        frontmatter(
            {
                "input_id": input_id,
                "received_at": record.received_at,
                "source": record.source,
                "prompt_digest": record.prompt_digest,
                "artifact_class": record.artifact_class,
                "checkpoint_included": False,
                "product_commit_included": False,
            }
        )
        + "\n# User Input\n\n"
        + record.raw_input
        + "\n",
    )
    inputs_index[input_id] = {
        "prompt_digest": record.prompt_digest,
        "redactions": list(record.redactions),
        "received_at": record.received_at,
        "source": record.source,
    }
    save_state(repo, state)
    journal(repo, f"Captured local input `{input_id}` from {record.source} (local-sensitive, not checkpointed).")
    print(f"captured {input_id}")
    return 0


def require_requirement(state: dict[str, Any], requirement_id: str) -> hloop_requirements.Requirement:
    raw = state.get("requirements", {}).get(requirement_id)
    if raw is None:
        raise HLoopError(f"unknown requirement: {requirement_id}")
    return hloop_requirements.Requirement.from_record(raw)


def accept_requirement_into_state(
    state: dict[str, Any],
    *,
    requirement_id: str,
    source_inputs: tuple[str, ...],
    acceptance: tuple[str, ...],
    priority: str,
    dependencies: tuple[str, ...] = (),
    supersedes: tuple[str, ...] = (),
) -> hloop_requirements.Requirement:
    """Promote one Manager-confirmed requirement into the immutable ledger."""

    requirements_state = state.setdefault("requirements", {})
    if requirement_id in requirements_state:
        raise HLoopError(f"requirement already exists: {requirement_id}")
    unknown_inputs = sorted(
        set(source_inputs) - set((state.get("inputs_index") or {}).keys())
    )
    if unknown_inputs:
        raise HLoopError(
            "requirement source input is not recorded: " + ", ".join(unknown_inputs)
        )
    try:
        requirement = hloop_requirements.Requirement(
            requirement_id=requirement_id,
            source_inputs=source_inputs,
            acceptance=acceptance,
            priority=priority,
            dependencies=dependencies,
            accepted_at=now_iso(),
            supersedes=supersedes,
        )
        existing_records = tuple(
            hloop_requirements.Requirement.from_record(raw)
            for raw in requirements_state.values()
        )
        ledger = hloop_requirements.RequirementLedger(existing_records).accept(
            requirement
        )
    except hloop_requirements.RequirementModelError as exc:
        raise HLoopError(str(exc)) from exc
    prior_progress = {
        key: raw.get("progress")
        for key, raw in requirements_state.items()
        if isinstance(raw, dict) and raw.get("progress")
    }
    requirements_state.clear()
    for item in ledger.requirements:
        raw = item.to_record()
        if item.requirement_id in prior_progress:
            progress = hloop_requirements.RequirementProgress.from_record(
                prior_progress[item.requirement_id]
            )
            if item.status == "superseded" and progress.status != "superseded":
                progress = hloop_requirements.transition_progress(
                    progress, "superseded", blockers=()
                )
            raw["progress"] = progress.to_record()
        requirements_state[item.requirement_id] = raw
    return requirement


def cmd_requirement_new(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    requirements_state = state.setdefault("requirements", {})
    requirement_id = args.id or next_requirement_id(requirements_state)
    requirement = accept_requirement_into_state(
        state,
        requirement_id=requirement_id,
        source_inputs=tuple(args.source_input),
        acceptance=tuple(args.acceptance),
        priority=args.priority,
        dependencies=tuple(args.depends_on or ()),
        supersedes=tuple(getattr(args, "supersedes", None) or ()),
    )
    write_requirement_artifacts(repo, state)
    save_state(repo, state)
    journal(repo, f"Accepted requirement `{requirement_id}` ({requirement.priority}).")
    print(f"created {requirement_id}")
    return 0


def requirement_draft_file(repo: Path, draft_id: str) -> Path:
    return loop_path(repo) / "requirements" / "drafts" / f"{draft_id}.json"


def cmd_requirements_extract(args: argparse.Namespace) -> int:
    """Create a non-accepted draft from recorded, already-redacted input."""

    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    source_inputs = tuple(args.input)
    raw_records: list[hloop_requirements.InputRecord] = []
    for input_id in source_inputs:
        if input_id not in (state.get("inputs_index") or {}):
            raise HLoopError(f"unknown input: {input_id}")
        path = local_sensitive_input_dir(repo) / f"{input_id}.json"
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
            raw_records.append(hloop_requirements.InputRecord.from_record(payload))
        except (OSError, json.JSONDecodeError, hloop_requirements.RequirementModelError) as exc:
            raise HLoopError(f"cannot load recorded input {input_id}: {exc}") from exc
    acceptance = tuple(
        args.acceptance
        or [record.raw_input.strip() for record in raw_records if record.raw_input.strip()]
    )
    if not acceptance:
        raise HLoopError("requirement draft acceptance is empty")
    drafts = state.setdefault("requirement_drafts", {})
    draft_id = args.id or next_requirement_draft_id(drafts)
    if draft_id in drafts:
        raise HLoopError(f"requirement draft already exists: {draft_id}")
    draft = {
        "id": draft_id,
        "status": "draft",
        "source_inputs": list(source_inputs),
        "acceptance": list(acceptance),
        "priority": args.priority,
        "dependencies": list(args.depends_on or ()),
        "supersedes": list(args.supersedes or ()),
        "extracted_at": now_iso(),
        "confirmation_required": True,
    }
    drafts[draft_id] = draft
    write_text(
        requirement_draft_file(repo, draft_id),
        json.dumps(draft, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
    )
    save_state(repo, state)
    journal(
        repo,
        f"Extracted requirement draft `{draft_id}` from {', '.join(source_inputs)}; "
        "Manager acceptance is still required.",
    )
    print(f"drafted {draft_id}; inspect and run `hloop requirements accept --draft {draft_id}`")
    return 0


def cmd_requirements_accept(args: argparse.Namespace) -> int:
    """Promote exactly one reviewed draft after explicit Manager confirmation."""

    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    drafts = state.setdefault("requirement_drafts", {})
    draft = drafts.get(args.draft)
    if not isinstance(draft, dict):
        raise HLoopError(f"unknown requirement draft: {args.draft}")
    if str(draft.get("status") or "") != "draft":
        raise HLoopError(
            f"requirement draft is not pending confirmation: {args.draft} "
            f"status={draft.get('status')}"
        )
    requirement_id = args.id or next_requirement_id(state.setdefault("requirements", {}))
    requirement = accept_requirement_into_state(
        state,
        requirement_id=requirement_id,
        source_inputs=tuple(draft.get("source_inputs") or ()),
        acceptance=tuple(args.acceptance or draft.get("acceptance") or ()),
        priority=args.priority or str(draft.get("priority") or "P1"),
        dependencies=tuple(args.depends_on or draft.get("dependencies") or ()),
        supersedes=tuple(args.supersedes or draft.get("supersedes") or ()),
    )
    draft["status"] = "accepted"
    draft["accepted_requirement_id"] = requirement_id
    draft["accepted_at"] = requirement.accepted_at
    write_text(
        requirement_draft_file(repo, args.draft),
        json.dumps(draft, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
    )
    write_requirement_artifacts(repo, state)
    save_state(repo, state)
    journal(repo, f"Accepted requirement draft `{args.draft}` as `{requirement_id}`.")
    print(f"accepted {args.draft} as {requirement_id}")
    return 0


def cmd_requirement_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    write_requirement_artifacts(repo, state)
    path = loop_path(repo) / "requirements" / "STATUS.md"
    if getattr(args, "json", False):
        payload = {
            requirement_id: requirement_progress_from_state(state, requirement_id).to_record()
            for requirement_id in sorted((state.get("requirements") or {}).keys())
        }
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(path)
    return 0


def cmd_context_update(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    if not str(args.source or "").strip() or not str(args.text or "").strip():
        raise HLoopError("context source and text must not be empty")
    context = state.setdefault("manager_context", [])
    item_id = f"CTX-{len(context) + 1:03d}"
    safe_text, redactions = hloop_requirements.redact_sensitive_text_with_kinds(
        args.text.strip()
    )
    context.append(
        {
            "id": item_id,
            "source": args.source,
            "text": safe_text,
            "redactions": list(redactions),
            "recorded_at": now_iso(),
        }
    )
    path = write_manager_context_artifact(repo, state)
    save_state(repo, state)
    journal(repo, f"Updated Manager context `{item_id}` from `{args.source}`.")
    print(path)
    return 0


def cmd_progress_record(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    requirement = require_requirement(state, args.requirement_id)
    requirements_state = state.setdefault("requirements", {})
    raw_progress = requirements_state[requirement.requirement_id].get("progress")
    current = (
        hloop_requirements.RequirementProgress.from_record(raw_progress)
        if raw_progress
        else hloop_requirements.RequirementProgress(requirement_id=requirement.requirement_id)
    )
    evidence = list(current.evidence)
    if args.evidence_kind:
        try:
            evidence.append(
                hloop_requirements.EvidenceRef(
                    kind=args.evidence_kind,
                    reference=args.evidence_ref,
                    verified_by=args.verified_by or "",
                    head_sha=args.head_sha or "",
                    result=args.result or "",
                )
            )
        except hloop_requirements.ProgressEvidenceError as exc:
            raise HLoopError(str(exc)) from exc
    clear_blockers = bool(getattr(args, "clear_blockers", False))
    if clear_blockers and args.blocker:
        raise HLoopError("--clear-blockers cannot be combined with --blocker")
    if clear_blockers:
        blockers: tuple[str, ...] = ()
    elif args.blocker:
        blockers = tuple(args.blocker)
    else:
        blockers = current.blockers
    try:
        updated = hloop_requirements.transition_progress(
            current,
            args.status,
            task_ids=tuple(args.task_id) if args.task_id else current.task_ids,
            evidence=tuple(evidence),
            remaining_work=args.remaining_work if args.remaining_work is not None else current.remaining_work,
            blockers=blockers,
        )
    except (hloop_requirements.RequirementModelError, hloop_requirements.ProgressEvidenceError) as exc:
        raise HLoopError(str(exc)) from exc
    requirements_state[requirement.requirement_id]["progress"] = updated.to_record()
    write_requirement_artifacts(repo, state)
    progress_path = write_progress_artifact(repo, state)
    save_state(repo, state)
    journal(
        repo,
        f"Requirement `{requirement.requirement_id}` progress -> {updated.status} "
        f"({len(updated.evidence)} evidence ref(s)).",
    )
    print(f"{requirement.requirement_id}: {updated.status} ({progress_path.name})")
    return 0


def cmd_outcome_show(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    requirement = require_requirement(state, args.requirement_id)
    raw_progress = state.get("requirements", {})[requirement.requirement_id].get("progress")
    progress = (
        hloop_requirements.RequirementProgress.from_record(raw_progress)
        if raw_progress
        else hloop_requirements.RequirementProgress(requirement_id=requirement.requirement_id)
    )
    outcome = {
        "requirement": requirement.to_record(),
        "progress": progress.to_record(),
    }
    print(json.dumps(outcome, indent=2, sort_keys=True))
    return 0


def cmd_outcome_blocked(args: argparse.Namespace) -> int:
    """Finalize BLOCKED only from a concrete loop-level blocking phase."""

    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    phase = str(state.get("phase") or "")
    blocker_phases = {
        "blocked_user_decision",
        "blocked_environment",
        "blocked_conflict",
        "blocked_agent",
        "failed_validation",
        "failed_manager_qa",
        "no_progress",
    }
    if phase not in blocker_phases and not build_decision_scheduler(state).loop_blocked:
        raise HLoopError(
            "external blocked outcome requires a concrete loop-level blocker; "
            f"current phase is {phase or 'unknown'}"
        )
    report = build_outcome_report(
        repo, state, kind="BLOCKED", blocking_reason=args.reason
    )
    write_requirement_artifacts(repo, state)
    write_progress_artifact(repo, state)
    path = write_outcome_report(repo, report)
    state["phase"] = "blocked"
    state["terminal_outcome"] = {
        "status": "blocked",
        "reason": args.reason,
        "target_sha": report.integration_target_sha,
        "recorded_at": report.generated_at,
        "report": path.relative_to(repo).as_posix(),
    }
    save_state(repo, state)
    journal(repo, f"Finalized external blocked outcome: {args.reason}")
    print(path)
    return 0


def running_agent_ids(state: dict[str, Any]) -> list[str]:
    ids: list[str] = []
    ids.extend(
        task_id
        for task_id, task in state.get("tasks", {}).items()
        if task.get("status") == "running"
    )
    ids.extend(
        review_id
        for review_id, review in state.get("reviews", {}).items()
        if agent_gate_status(review) == "running"
    )
    ids.extend(
        gap_id
        for gap_id, gap in state.get("gaps", {}).items()
        if agent_gate_status(gap) == "running"
    )
    for advice_id, advice in state.get("advice", {}).items():
        if not isinstance(advice, dict):
            continue
        for participant in advice.get("participants", []):
            if agent_gate_status(participant) == "running":
                ids.append(f"{advice_id}/{participant.get('participant_id', 'P1')}")
    scout = state.get("specification_scout_run")
    if isinstance(scout, dict) and agent_gate_status(scout) == "running":
        ids.append("S001")
    for decision_id, liaison in (state.get("decision_liaisons") or {}).items():
        if isinstance(liaison, dict) and agent_gate_status(liaison) == "running":
            ids.append(f"L-{decision_id}")
    return ids


def agent_artifact_path(
    repo: Path,
    state: dict[str, Any],
    agent_id: str,
    role: str,
    agent: dict[str, Any],
) -> Path:
    if role == "worker":
        return worker_artifact_path(repo, state, agent_id, agent)
    if role == "reviewer":
        return review_artifact_path(repo, agent_id, agent)
    if role == "gap":
        return gap_artifact_path(repo, agent_id, agent)
    if role == "advisor":
        advice_id, participant_id = split_advice_target(agent_id)
        return advice_artifact_path(repo, advice_id, {**agent, "participant_id": participant_id})
    raise HLoopError(f"unsupported agent role: {role}")


def artifact_identity_error(
    state: dict[str, Any],
    agent_id: str,
    role: str,
    agent: dict[str, Any],
    meta: dict[str, Any],
) -> str:
    id_field = {
        "worker": "task_id",
        "reviewer": "review_id",
        "gap": "gap_id",
        "advisor": "advice_id",
    }[role]
    expected_id = agent_id.split("/", 1)[0]
    if str(meta.get(id_field) or "") != expected_id:
        return f"{id_field} mismatch"
    if role == "advisor":
        expected_participant = str(agent.get("participant_id") or "P1")
        if str(meta.get("participant_id") or "") != expected_participant:
            return "participant_id mismatch"
    expected_run = str(state.get("run_id") or "")
    if expected_run and str(meta.get("run_id") or "") != expected_run:
        return "run_id mismatch"
    expected_version = str(agent.get("skill_version") or state.get("skill_version") or "")
    if expected_version not in {"", "unversioned"} and str(meta.get("skill_version") or "") != expected_version:
        return "skill_version mismatch"
    if role in {"reviewer", "gap", "advisor"}:
        expected_head = str(agent.get("head_sha") or "")
        if expected_head and str(meta.get("head_sha") or "") != expected_head:
            return "head_sha mismatch"
    return ""


def artifact_readiness(
    repo: Path,
    state: dict[str, Any],
    agent_id: str,
    role: str,
    agent: dict[str, Any],
    path: Path,
) -> tuple[bool, str]:
    if not path.exists() or not path.is_file():
        return False, "missing"
    try:
        text = read_text(path)
        meta = parse_frontmatter_text(text)
    except HLoopError as exc:
        return False, f"invalid:{exc}"
    if not text.strip() or not meta:
        return False, "empty-or-missing-frontmatter"
    identity_error = artifact_identity_error(state, agent_id, role, agent, meta)
    if identity_error:
        return False, identity_error
    if role == "worker":
        status = str(meta.get("status") or "")
        if status not in TASK_STATUSES_FINAL:
            return False, "invalid-status"
        merge_ready = normalize_bool(meta.get("merge_ready"))
        validation_error = worker_validation_error(
            meta,
            require_recorded=merge_ready,
            require_passing=merge_ready,
        )
        if validation_error:
            return False, f"invalid-worker-validation:{validation_error}"
        if artifact_was_harvested(agent):
            if not agent.get("committed_result_path"):
                return False, "harvested-without-committed-result"
        else:
            worktree = Path(agent.get("worktree") or path.parents[4]).resolve()
            commit_state = safe_result_commit_state(
                worktree, agent_id, str(meta.get("head_sha") or "HEAD")
            )
            if commit_state != "committed":
                return False, commit_state
    elif role == "reviewer" and str(meta.get("status") or "") not in REVIEW_ARTIFACT_STATUSES:
        return False, "invalid-status"
    elif role == "gap" and str(meta.get("status") or "") not in GAP_ARTIFACT_STATUSES:
        return False, "invalid-status"
    elif role == "advisor" and str(meta.get("status") or "") not in ADVISOR_ARTIFACT_STATUSES:
        return False, "invalid-status"
    return True, "ready"


def agent_wait_status(repo: Path, state: dict[str, Any], agent_id: str) -> dict[str, Any]:
    role, agent = resolve_agent_state(state, agent_id)
    path = agent_artifact_path(repo, state, agent_id, role, agent)
    pane_id = str(agent.get("pane_id") or "")
    pane_status = ""
    terminal_status = ""
    if pane_id and os.environ.get("HERDR_ENV") == "1" and command_exists("herdr"):
        info = pane_info(pane_id)
        if info is not None:
            pane_status = str(info.get("agent_status") or "")
            try:
                terminal_status = terminal_status_from_text(
                    pane_text(pane_id, 120),
                    run_id=str(state.get("run_id") or ""),
                    agent_id=agent_id,
                    attempt_id=str(agent.get("attempt_id") or agent.get("active_attempt_id") or ""),
                )
            except HLoopError:
                terminal_status = ""
        else:
            pane_status = "missing-or-closed"
    status = agent_gate_status(agent) if role in {"reviewer", "gap", "advisor"} else str(agent.get("status") or "")
    ready, readiness_reason = artifact_readiness(repo, state, agent_id, role, agent, path)
    return {
        "id": agent_id,
        "role": role,
        "status": status,
        "pane_id": pane_id,
        "pane_status": pane_status,
        "terminal_status": terminal_status,
        "terminal_without_artifact": bool(terminal_status and not ready),
        "artifact_path": path,
        "artifact_ready": ready,
        "readiness_reason": readiness_reason,
    }


def wait_targets(state: dict[str, Any], target: str) -> list[str]:
    if target == "next":
        return running_agent_ids(state)
    return [target]


def cmd_wait(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    timeout_ms = max(0, int(args.timeout_ms))
    poll_ms = max(250, int(args.poll_ms))
    deadline = time.monotonic() + timeout_ms / 1000
    last_statuses: list[dict[str, Any]] = []
    while True:
        state = load_state(repo)
        targets = wait_targets(state, str(args.target))
        if not targets:
            print("no running agents to wait for")
            return 2
        last_statuses = [agent_wait_status(repo, state, agent_id) for agent_id in targets]
        ready = [item for item in last_statuses if item["artifact_ready"]]
        if ready:
            item = ready[0]
            artifact = item["artifact_path"]
            print(f"ready {item['id']} ({item['role']}): {artifact}")
            if args.harvest:
                harvest_args = argparse.Namespace(**vars(args))
                harvest_args.agent_id = item["id"]
                with loop_lock(repo):
                    assert_mutating_state_schema_compatible(repo)
                    return cmd_harvest(harvest_args)
            print(f"harvest with: hloop harvest {item['id']}")
            return 0
        terminal = [item for item in last_statuses if item.get("terminal_without_artifact")]
        if terminal:
            item = terminal[0]
            print(
                f"terminal without artifact: {item['id']} status={item['terminal_status']}; "
                f"run `hloop agent abort {item['id']} --reason ...` then requeue",
                file=sys.stderr,
            )
            return 2
        if time.monotonic() >= deadline:
            print(f"timeout waiting for artifact: {args.target}")
            for item in last_statuses:
                pane_suffix = f" pane={item['pane_status']}" if item.get("pane_status") else ""
                print(
                    f"  {item['id']}: {item['role']} status={item['status']}{pane_suffix} "
                    f"artifact={item['artifact_path']} readiness={item['readiness_reason']}"
                )
            return 1
        if not args.quiet:
            summary = ", ".join(
                f"{item['id']}:{item['status']}:{item['readiness_reason']}"
                + (f"/{item['pane_status']}" if item.get("pane_status") else "")
                for item in last_statuses
            )
            print(f"waiting for artifact ({summary})")
        time.sleep(poll_ms / 1000)


def checkpoint_paths(repo: Path, args: argparse.Namespace) -> list[str]:
    if args.path:
        paths: list[str] = []
        for pathspec in args.path:
            paths.extend(porcelain_paths_for(repo, pathspec))
            if args.force:
                paths.extend(ignored_untracked_paths_for(repo, pathspec))
    else:
        paths = porcelain_paths_for(repo, LOOP_DIR.as_posix())
        if args.force:
            paths.extend(ignored_untracked_paths_for(repo, LOOP_DIR.as_posix()))
    filtered = []
    loop_root = LOOP_DIR.as_posix()
    loop_prefix = f"{loop_root}/"
    for path in dict.fromkeys(paths):
        normalized = normalize_match_path(path)
        if normalized != loop_root and not normalized.startswith(loop_prefix):
            raise HLoopError(f"checkpoint refuses non-loop path: {normalized}")
        if normalized == (LOOP_DIR / "LOCK").as_posix() and not args.include_lock:
            continue
        if normalized.startswith((LOOP_DIR / "prompts").as_posix() + "/") and not args.include_prompts:
            continue
        # Local-sensitive artifacts (raw/redacted user input, the report
        # broker's durable store and outage spool) are never checkpointed,
        # matching hloop_lib.requirements.is_local_sensitive_path's model and
        # the "local-only" artifact_policy recorded in STATE.json.
        relative = normalized[len(loop_prefix):] if normalized.startswith(loop_prefix) else ""
        if hloop_requirements.is_local_sensitive_path(relative or normalized):
            continue
        if relative.split("/", 1)[0] in {"broker", "broker-spool"}:
            continue
        filtered.append(normalized)
    return filtered


def ignored_untracked_paths_for(repo: Path, pathspec: str) -> list[str]:
    proc = run_cmd(
        [
            TRUSTED_GIT_PATH,
            "-C",
            str(repo),
            "ls-files",
            "--others",
            "--ignored",
            "--exclude-standard",
            "--",
            pathspec,
        ],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "git ls-files failed").strip())
    return [
        normalize_match_path(line)
        for line in (proc.stdout or "").splitlines()
        if line.strip()
    ]


def staged_paths(repo: Path) -> list[str]:
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "diff", "--cached", "--name-only"], check=False)
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "git diff --cached failed").strip())
    return [normalize_match_path(line) for line in (proc.stdout or "").splitlines() if line.strip()]


def ensure_checkpoint_staged_scope(staged: list[str], allowed_paths: list[str]) -> None:
    allowed = set(allowed_paths)
    unexpected = [path for path in staged if path not in allowed]
    if unexpected:
        raise HLoopError(
            "checkpoint refuses to commit already-staged paths outside its loop path set: "
            + ", ".join(unexpected)
        )


def commit_message_has_trailer(message: str, key: str, value: str) -> bool:
    expected = f"{key}: {value}"
    return any(line.strip() == expected for line in message.splitlines())


def checkpoint_commit_message(message: str, batch_id: str) -> str:
    base = message.rstrip()
    if not batch_id:
        return base
    trailers = [
        f"{CHECKPOINT_TRAILER_KIND}: {CHECKPOINT_KIND_LOOP_STATE}",
        f"{CHECKPOINT_TRAILER_BATCH}: {batch_id}",
    ]
    existing = {line.strip() for line in base.splitlines()}
    missing = [line for line in trailers if line not in existing]
    if not missing:
        return base
    separator = "\n\n" if base else ""
    return base + separator + "\n".join(missing)


def head_reachable_from_upstream(repo: Path) -> bool:
    upstream = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"],
        check=False,
    )
    if upstream.returncode != 0:
        return False
    ref = (upstream.stdout or "").strip()
    return bool(ref) and is_ancestor(repo, "HEAD", ref)


def head_changed_paths(repo: Path) -> list[str]:
    proc = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "diff-tree", "--root", "--no-commit-id", "--name-only", "-r", "HEAD"],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "git diff-tree failed").strip())
    return [normalize_match_path(line) for line in (proc.stdout or "").splitlines() if line.strip()]


def checkpoint_amend_blocker(repo: Path, batch_id: str) -> str:
    if not batch_id:
        return "no batch id"
    head = run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "rev-parse", "--verify", "HEAD"], check=False)
    if head.returncode != 0:
        return "repository has no HEAD commit"
    message = git(repo, ["log", "-1", "--format=%B"])
    if not commit_message_has_trailer(message, CHECKPOINT_TRAILER_KIND, CHECKPOINT_KIND_LOOP_STATE):
        return "HEAD is not an hloop loop-state checkpoint"
    if not commit_message_has_trailer(message, CHECKPOINT_TRAILER_BATCH, batch_id):
        return f"HEAD checkpoint belongs to another batch, not {batch_id}"
    if head_reachable_from_upstream(repo):
        return "HEAD is already reachable from upstream"
    loop_root = LOOP_DIR.as_posix()
    loop_prefix = f"{loop_root}/"
    non_loop = [
        path for path in head_changed_paths(repo)
        if path != loop_root and not path.startswith(loop_prefix)
    ]
    if non_loop:
        return "HEAD checkpoint includes non-loop paths: " + ", ".join(non_loop)
    return ""


def resolve_checkpoint_batch_id(state: dict[str, Any], args: argparse.Namespace) -> str:
    batch_id = validate_batch_id(args.batch) if args.batch else ""
    if not batch_id and args.rollup:
        batch_id = current_batch_id(state)
    if batch_id:
        require_batch(state, batch_id)
    if args.rollup and not batch_id:
        raise HLoopError("checkpoint --rollup requires --batch or an active current batch")
    return batch_id


def cmd_checkpoint(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=not args.no_branch_check, mark_blocked=False)
    batch_id = resolve_checkpoint_batch_id(state, args)
    paths = checkpoint_paths(repo, args)
    if not paths:
        print(f"no {LOOP_DIR.as_posix()} changes to checkpoint")
        return 0
    if args.dry_run:
        print("DRY RUN checkpoint paths:")
        for path in paths:
            print(f"  {path}")
        if batch_id:
            print(f"DRY RUN checkpoint batch: {batch_id}")
        if args.rollup:
            blocker = checkpoint_amend_blocker(repo, batch_id)
            print("DRY RUN rollup: " + ("would amend HEAD" if not blocker else f"would create new commit ({blocker})"))
        return 0
    add_cmd = [TRUSTED_GIT_PATH, "-C", str(repo), "add"]
    if args.force:
        add_cmd.append("-f")
    add_cmd.extend(["--", *paths])
    run_cmd(add_cmd, check=True)
    ensure_checkpoint_staged_scope(staged_paths(repo), paths)
    diff_proc = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "diff", "--cached", "--quiet", "--", *paths],
        check=False,
    )
    if diff_proc.returncode not in {0, 1}:
        raise HLoopError((diff_proc.stderr or diff_proc.stdout or "git diff --cached failed").strip())
    if diff_proc.returncode == 0:
        print(f"no staged {LOOP_DIR.as_posix()} changes to checkpoint")
        return 0
    commit_message = checkpoint_commit_message(args.message, batch_id)
    amend_blocker = checkpoint_amend_blocker(repo, batch_id) if args.rollup else "rollup disabled"
    if args.rollup and not amend_blocker:
        run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(repo), "commit", "--amend", "-m", commit_message],
            check=True,
            capture=False,
        )
        sha = git(repo, ["rev-parse", "--short", "HEAD"])
        print(f"checkpoint amended {sha}")
        return 0
    run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "commit", "-m", commit_message], check=True, capture=False)
    sha = git(repo, ["rev-parse", "--short", "HEAD"])
    print(f"checkpoint committed {sha}")
    if args.rollup and amend_blocker:
        print(f"rollup started a new checkpoint: {amend_blocker}")
    return 0


def cmd_qa_record(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True)
    previous_phase = str(state.get("phase") or "")
    previous_qa_status = str(state.get("manager_qa_status") or "")
    profile = str(args.profile or state_manager_qa_profile(state))
    head_sha = git(repo, ["rev-parse", str(state["integration_branch"])])
    state["integration_head_sha"] = head_sha
    state["completion_target_sha"] = head_sha
    if profile == "none" and args.status == "skipped":
        recorded_status = "not-required"
    else:
        recorded_status = args.status
    if profile != "none" and recorded_status == "skipped":
        raise HLoopError(
            "manager final QA is required; use --status passed, accepted-risk, blocked, or failed"
        )
    if args.profile:
        state["manager_qa_profile"] = profile
    evidence = args.evidence or []
    fields = {
        "manager_qa_profile": profile,
        "status": recorded_status,
        "recorded_at": now_iso(),
        "summary": args.summary,
        "head_sha": head_sha,
        "evidence": evidence,
    }
    lines = [
        "# Manager Final QA",
        "",
        f"- Profile: {profile}",
        f"- Status: {recorded_status}",
        f"- Summary: {args.summary}",
        "",
        "## Evidence",
    ]
    if evidence:
        lines.extend(f"- {item}" for item in evidence)
    else:
        lines.append("- No evidence paths or URLs recorded.")
    if args.notes:
        lines.extend(["", "## Notes", "", args.notes])
    path = manager_qa_file(repo)
    write_text(path, frontmatter(fields) + "\n" + "\n".join(lines) + "\n")
    state["manager_qa_status"] = recorded_status
    state["manager_qa_recorded_at"] = fields["recorded_at"]
    state["manager_qa_head_sha"] = head_sha
    state["manager_qa_artifact"] = str(path.relative_to(repo))
    if recorded_status in {"passed", "accepted-risk", "not-required"}:
        if previous_phase in {"manager_qa", "failed_manager_qa"} or previous_qa_status in {
            "pending",
            "blocked",
            "failed",
        }:
            state["phase"] = "ready_to_finish" if all_tasks_merged(state) else "dispatching"
    elif recorded_status == "blocked":
        state["phase"] = "blocked_environment"
        append_text(
            loop_path(repo) / "USER_ACTION_REQUIRED.md",
            f"\n## Manager final QA blocked\n\n{args.summary}\n",
        )
    elif recorded_status == "failed":
        state["phase"] = "failed_manager_qa"
    save_state(repo, state)
    journal(repo, f"Recorded Manager final QA `{recorded_status}` for profile `{profile}`: {args.summary}")
    print(path)
    return 0


def assert_run_terminal_transition_safe(state: dict[str, Any]) -> None:
    active = running_agent_ids(state)
    if active:
        raise HLoopError(
            "cannot record a run-level outcome while roles are running: "
            + ", ".join(active)
        )
    if state.get("active_merge"):
        raise HLoopError("cannot record a run-level outcome during an active merge")


def record_run_terminal_outcome(
    repo: Path,
    state: dict[str, Any],
    *,
    status: str,
    reason: str,
    target_sha: str,
    next_namespace: str = "",
) -> Path:
    if not str(reason or "").strip():
        raise HLoopError("run-level outcome reason must not be empty")
    previous = state.get("terminal_outcome")
    if previous:
        state.setdefault("terminal_outcome_history", []).append(previous)
    recorded_at = now_iso()
    filename = {
        "superseded": "SUPERSEDED.md",
        "handoff": "HANDOFF.md",
        "abandoned_by_user": "ABANDONED.md",
    }[status]
    path = loop_path(repo) / "reports" / filename
    fields = {
        "run_id": str(state.get("run_id") or ""),
        "status": status,
        "target_sha": target_sha,
        "reason": reason,
        "recorded_at": recorded_at,
        "next_namespace": next_namespace,
    }
    title = {
        "superseded": "Superseded Run",
        "handoff": "Run Handoff",
        "abandoned_by_user": "Run Abandoned by User",
    }[status]
    body = [
        f"# {title}",
        "",
        f"- Reason: {reason}",
        f"- Target SHA: `{target_sha}`",
    ]
    if next_namespace:
        body.append(f"- Next namespace: `{next_namespace}`")
    write_text(path, frontmatter(fields) + "\n" + "\n".join(body) + "\n")
    state["phase"] = status
    state["terminal_outcome"] = {
        **fields,
        "report": path.relative_to(repo).as_posix(),
    }
    save_state(repo, state)
    journal(repo, f"Recorded run-level outcome `{status}`: {reason}")
    return path


def cmd_completion_supersede(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    if str(state.get("phase") or "") != "done":
        raise HLoopError("only a completed run can be superseded")
    assert_run_terminal_transition_safe(state)
    current = git(repo, ["rev-parse", str(state["integration_branch"])])
    if args.head_sha != current:
        raise HLoopError(
            f"--head-sha must match the current integration head {current}"
        )
    if args.next_namespace and not re.fullmatch(
        r"[a-z0-9][a-z0-9._-]{0,63}", args.next_namespace
    ):
        raise HLoopError("invalid successor namespace")
    path = record_run_terminal_outcome(
        repo,
        state,
        status="superseded",
        reason=args.reason,
        target_sha=current,
        next_namespace=args.next_namespace or "",
    )
    print(path)
    return 0


def cmd_completion_handoff(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    if str(state.get("phase") or "") in RUN_TERMINAL_PHASES:
        raise HLoopError(f"run is already terminal: {state.get('phase')}")
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,63}", args.next_namespace):
        raise HLoopError("invalid successor namespace")
    assert_run_terminal_transition_safe(state)
    current = git(repo, ["rev-parse", str(state["integration_branch"])])
    head_sha = args.head_sha or current
    if head_sha != current:
        raise HLoopError(f"handoff SHA must match the current integration head {current}")
    path = record_run_terminal_outcome(
        repo,
        state,
        status="handoff",
        reason=args.reason,
        target_sha=current,
        next_namespace=args.next_namespace,
    )
    print(path)
    return 0


def cmd_completion_abandon(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    if str(state.get("phase") or "") in RUN_TERMINAL_PHASES:
        raise HLoopError(f"run is already terminal: {state.get('phase')}")
    assert_run_terminal_transition_safe(state)
    current = git(repo, ["rev-parse", str(state["integration_branch"])])
    path = record_run_terminal_outcome(
        repo,
        state,
        status="abandoned_by_user",
        reason=args.reason,
        target_sha=current,
    )
    print(path)
    return 0


def cmd_pause(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    if str(state.get("phase") or "") in RUN_TERMINAL_PHASES:
        raise HLoopError(f"cannot pause a terminal loop: {state.get('phase')}")
    state["phase"] = "paused"
    state["pause_reason"] = args.reason
    state["paused_at"] = now_iso()
    save_state(repo, state)
    journal(repo, f"Paused loop: {args.reason}")
    print("paused")
    return 0


def cmd_resume(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    if str(state.get("phase") or "") != "paused":
        raise HLoopError(f"loop is not paused: {state.get('phase')}")
    requirements = lifecycle_resume_requirements(repo, state)
    if requirements:
        state["resume_requirements"] = requirements
        save_state(repo, state)
        raise HLoopError(
            "cannot resume: " + "; ".join(item["reason"] for item in requirements)
        )
    state["phase"] = "dispatching"
    state["resumed_at"] = now_iso()
    state.pop("pause_reason", None)
    state["resume_requirements"] = []
    save_state(repo, state)
    journal(repo, "Resumed loop after preflight.")
    print("resumed")
    return 0


def completion_errors(repo: Path, state: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    target = git(repo, ["rev-parse", str(state["integration_branch"])])
    state["integration_head_sha"] = target
    state["completion_target_sha"] = target
    if not all_tasks_merged(state):
        errors.append("not all tasks are merged")
    if running_agent_ids(state):
        errors.append("role agents are still running")
    if unsafe_dirty_paths(repo):
        errors.append("Manager checkout has non-loop dirty files")
    if not last_validation_passed(state):
        errors.append("current completion target lacks passing validation")
    if not review_gate_passed(state):
        errors.append("current completion target lacks a closed review gate")
    if not gap_gate_passed(state):
        errors.append("current completion target lacks a closed gap gate")
    if not manager_qa_passed(state):
        errors.append("current completion target lacks passing Manager QA")
    unresolved_decisions = [
        record.decision_id
        for record in decision_records_from_state(state).values()
        if record.unresolved
    ]
    if unresolved_decisions:
        errors.append(
            "unresolved specification decisions remain: "
            + ", ".join(unresolved_decisions)
        )
    scout_run = state.get("specification_scout_run") or {}
    if scout_run and str(scout_run.get("status") or "") not in {"completed", "skipped"}:
        errors.append(
            "Specification Scout has not completed Manager triage: "
            + str(scout_run.get("status") or "unknown")
        )
    requirement_ids = sorted((state.get("requirements") or {}).keys())
    if not requirement_ids:
        errors.append("no accepted requirements are recorded")
    for requirement_id in requirement_ids:
        try:
            progress = requirement_progress_from_state(state, requirement_id)
        except hloop_requirements.RequirementModelError as exc:
            errors.append(f"invalid requirement progress for {requirement_id}: {exc}")
            continue
        if progress.status not in hloop_reports.TERMINAL_REQUIREMENT_STATUSES:
            errors.append(
                f"requirement {requirement_id} is not terminal: {progress.status}"
            )
    cleanup_pending = [
        task_id for task_id, task in state.get("tasks", {}).items() if task.get("cleanup_pending")
    ]
    if cleanup_pending:
        errors.append("worktree cleanup has not run yet: " + ", ".join(cleanup_pending))
    for role_kind, role_id, role_state in iter_all_roles(state):
        unresolved = unresolved_cleanup_failures(role_state)
        if unresolved:
            errors.append(
                f"cleanup is unresolved for {role_kind} `{role_id}` ({', '.join(sorted(unresolved))}); "
                "run `hloop cleanup resolve` with --status cleaned or accepted-risk"
            )
    if state.get("active_merge"):
        errors.append("a merge transaction is active")
    final_gate = final_gate_from_state(state)
    if final_gate is None or final_gate.status != "armed":
        errors.append("final gates are not armed")
    else:
        arm_validation = validate_final_gate_arm(
            final_gate, current_target_sha=target
        )
        errors.extend(item.message for item in arm_validation.issues)
    for task_id, task in state.get("tasks", {}).items():
        if artifact_was_harvested(task) and not worker_artifact_path(
            repo, state, task_id, task
        ).is_file():
            errors.append(f"harvested Worker artifact is missing: {task_id}")
    for review_id, review in state.get("reviews", {}).items():
        if artifact_was_harvested(review) and not review_artifact_path(
            repo, review_id, review
        ).is_file():
            errors.append(f"harvested Reviewer artifact is missing: {review_id}")
    for gap_id, gap in state.get("gaps", {}).items():
        if artifact_was_harvested(gap) and not gap_artifact_path(repo, gap_id, gap).is_file():
            errors.append(f"harvested Gap artifact is missing: {gap_id}")
    for advice_id, advice in state.get("advice", {}).items():
        if not isinstance(advice, dict):
            continue
        for participant in advice.get("participants", []):
            if artifact_was_harvested(participant) and not advice_artifact_path(
                repo, advice_id, participant
            ).is_file():
                participant_id = str(participant.get("participant_id") or "P1")
                errors.append(
                    f"harvested Advisor artifact is missing: {advice_id}/{participant_id}"
                )
    return errors


def outcome_gate(
    name: str,
    *,
    status: str,
    target_sha: str,
    evidence_refs: list[str] | tuple[str, ...] = (),
    required: bool = True,
) -> hloop_reports.OutcomeGate:
    verified_by = "hloop" if status in {"passed", "accepted-risk"} else ""
    return hloop_reports.OutcomeGate(
        name=name,
        status=status,
        evidence_refs=tuple(dict.fromkeys(evidence_refs)),
        target_sha=target_sha if status != "not-required" else "",
        verified_by=verified_by,
        required=required,
    )


def build_outcome_report(
    repo: Path,
    state: dict[str, Any],
    *,
    kind: str,
    blocking_reason: str = "",
) -> hloop_reports.OutcomeReport:
    target = git(repo, ["rev-parse", str(state["integration_branch"])])
    current = git(repo, ["rev-parse", "HEAD"])
    validation_results = list((state.get("last_validation") or {}).get("results") or [])
    validation_refs = [
        str(item.get("log") or item.get("command") or "validation")
        for item in validation_results
    ]
    validation_status = "passed" if last_validation_passed(state) else (
        "failed"
        if any(validation_result_failed(item.get("result")) for item in validation_results)
        else "pending"
    )
    gates = [
        outcome_gate(
            "integration-validation",
            status=validation_status,
            target_sha=target,
            evidence_refs=validation_refs,
        )
    ]

    review_required = int(state.get("max_reviewers", DEFAULT_MAX_REVIEWERS)) > 0
    review_refs = [
        str(review.get("review_path") or review_id)
        for review_id, review in (state.get("reviews") or {}).items()
        if agent_gate_status(review) in {"triaged", "passed"}
    ]
    gates.append(
        outcome_gate(
            "review",
            status=(
                "not-required"
                if not review_required
                else "passed" if review_gate_passed(state) else "pending"
            ),
            target_sha=target,
            evidence_refs=review_refs,
            required=review_required,
        )
    )

    gap_required = int(state.get("max_gap_auditors", DEFAULT_MAX_GAP_AUDITORS)) > 0
    gap_refs = [
        str(gap.get("gap_path") or gap_id)
        for gap_id, gap in (state.get("gaps") or {}).items()
        if agent_gate_status(gap) in {"triaged", "passed"}
    ]
    gates.append(
        outcome_gate(
            "gap-audit",
            status=(
                "not-required"
                if not gap_required
                else "passed" if gap_gate_passed(state) else "pending"
            ),
            target_sha=target,
            evidence_refs=gap_refs,
            required=gap_required,
        )
    )

    qa_required = manager_qa_required(state)
    qa_status = str(state.get("manager_qa_status") or "pending")
    gates.append(
        outcome_gate(
            "manager-qa",
            status="not-required" if not qa_required else qa_status,
            target_sha=target,
            evidence_refs=[str(state.get("manager_qa_artifact") or "")]
            if state.get("manager_qa_artifact")
            else [],
            required=qa_required,
        )
    )

    final_gate = final_gate_from_state(state)
    final_gate_passed = final_gate is not None and final_gate.status == "armed"
    gates.append(
        outcome_gate(
            "final-gate-arm",
            status="passed" if final_gate_passed else "pending",
            target_sha=target,
            evidence_refs=["STATE.json:final_gate"] if final_gate_passed else [],
        )
    )
    cleanup_ok = not running_agent_ids(state) and not any(
        unresolved_cleanup_failures(role_state)
        for _, _, role_state in iter_all_roles(state)
    )
    gates.append(
        outcome_gate(
            "cleanup",
            status="passed" if cleanup_ok else "pending",
            target_sha=target,
            evidence_refs=["STATE.json:cleanup"] if cleanup_ok else [],
        )
    )
    if kind == "BLOCKED":
        gates.append(
            outcome_gate(
                "external-goal",
                status="blocked",
                target_sha=target,
                evidence_refs=["USER_ACTION_REQUIRED.md"],
            )
        )

    requirement_progress = tuple(
        requirement_progress_from_state(state, requirement_id)
        for requirement_id in sorted((state.get("requirements") or {}).keys())
    )
    validation_evidence = tuple(
        hloop_requirements.EvidenceRef(
            kind="test",
            reference=str(item.get("log") or item.get("command") or "validation"),
            verified_by="hloop",
            head_sha=target,
            result=str(item.get("result") or ""),
        )
        for item in validation_results
    )
    resolved_decisions: list[str] = []
    unresolved_decisions: list[str] = []
    for record in decision_records_from_state(state).values():
        summary = f"{record.decision_id}: {record.question} ({record.status})"
        (unresolved_decisions if record.unresolved else resolved_decisions).append(summary)
    user_changes = list(
        dict.fromkeys(
            str(task.get("title") or f"Task {task_id}")
            for task_id, task in (state.get("tasks") or {}).items()
            if str(task.get("status") or "") == "merged"
        )
    )
    review_findings: list[str] = []
    review_fixes: list[str] = []
    accepted_risks: list[str] = []
    tasks = state.get("tasks") or {}
    for review_id, review in (state.get("reviews") or {}).items():
        if not isinstance(review, dict):
            continue
        for fingerprint in normalize_list(review.get("confirmed_finding_fingerprints")):
            review_findings.append(f"{review_id}: {fingerprint}")
        for task_id in normalize_list(review.get("created_fix_tasks")):
            task = tasks.get(task_id) or {}
            title = str(task.get("title") or task_id)
            status = str(task.get("status") or "unknown")
            review_fixes.append(f"{review_id}/{task_id}: {title} ({status})")
        if str(review.get("verdict") or "") == "accepted-risk":
            accepted_risks.append(
                f"{review_id}: {review.get('triage_reason') or 'review risk accepted'}"
            )
    for gap_id, gap in (state.get("gaps") or {}).items():
        if isinstance(gap, dict) and str(gap.get("verdict") or "") == "accepted-risk":
            accepted_risks.append(
                f"{gap_id}: {gap.get('triage_reason') or 'gap risk accepted'}"
            )
    if str(state.get("manager_qa_status") or "") == "accepted-risk":
        accepted_risks.append(
            "Manager QA: " + str(state.get("manager_qa_summary") or "risk accepted")
        )
    for role_kind, role_id, role_state in iter_all_roles(state):
        for resolution in (role_state.get("cleanup_resolutions") or {}).values():
            if isinstance(resolution, dict) and resolution.get("status") == "accepted-risk":
                accepted_risks.append(
                    f"{role_kind} {role_id} cleanup: "
                    + str(resolution.get("reason") or "risk accepted")
                )
    kwargs = {
        "run_id": str(state.get("run_id") or "local"),
        "goal": str(state.get("goal") or state.get("goal_id") or "HLoop goal"),
        "generated_at": now_iso(),
        "requirement_progress": requirement_progress,
        "gates": tuple(gates),
        "integration_target_sha": target,
        "current_branch_sha": current,
        "user_changes": tuple(user_changes),
        "validation_evidence": validation_evidence,
        "review_findings": tuple(dict.fromkeys(review_findings)),
        "review_fixes": tuple(dict.fromkeys(review_fixes)),
        "accepted_risks": tuple(dict.fromkeys(accepted_risks)),
        "decisions": tuple(resolved_decisions),
        "unresolved_items": tuple(unresolved_decisions),
        "cleanup_status": "passed" if cleanup_ok else "pending",
        "session_status": "closed" if not running_agent_ids(state) else "active",
        "next_user_actions": (
            ("Resolve the recorded blocking condition and start or resume a run.",)
            if kind == "BLOCKED"
            else (f"Review the integration branch {state.get('integration_branch')}",)
        ),
        "blocking_reason": blocking_reason,
    }
    try:
        if kind == "FINAL":
            return hloop_reports.final_outcome(**kwargs)
        if kind == "BLOCKED":
            return hloop_reports.blocked_outcome(
                external_goal_blocked=True, **kwargs
            )
        return hloop_reports.draft_outcome(**kwargs)
    except hloop_reports.OutcomeModelError as exc:
        raise HLoopError(f"cannot build {kind} outcome: {exc}") from exc


def write_outcome_report(repo: Path, report: hloop_reports.OutcomeReport) -> Path:
    filename = {
        "DRAFT": "DRAFT.md",
        "FINAL": "FINAL.md",
        "BLOCKED": "BLOCKED.md",
    }[report.kind]
    path = loop_path(repo) / "reports" / filename
    write_text(path, hloop_reports.render_outcome_markdown(report))
    return path


def cmd_finish(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True)
    target = git(repo, ["rev-parse", str(state["integration_branch"])])
    if str(state.get("phase") or "") == "done":
        final_target = str(state.get("final_target_sha") or "")
        diagnostic = diagnose_done_target_drift(
            phase="done",
            final_target_sha=final_target,
            current_target_sha=target,
            commit_count=advancing_commit_count(repo, final_target, target),
        )
        if diagnostic is None:
            print(f"already finished at {target}")
            return 0
        raise HLoopError(str(diagnostic.message))
    if str(state.get("phase") or "") in RUN_TERMINAL_PHASES:
        raise HLoopError(f"cannot finish a terminal run: {state.get('phase')}")
    errors = completion_errors(repo, state)
    if errors:
        state["phase"] = "ready_to_finish" if not errors else state.get("phase", "dispatching")
        save_state(repo, state)
        raise HLoopError("cannot finish: " + "; ".join(errors))
    outcome = build_outcome_report(repo, state, kind="FINAL")
    write_requirement_artifacts(repo, state)
    write_progress_artifact(repo, state)
    state["phase"] = "done"
    state["final_target_sha"] = target
    state["finished_at"] = now_iso()
    state["terminal_outcome"] = {
        "status": "done",
        "target_sha": target,
        "recorded_at": state["finished_at"],
        "report": (LOOP_DIR / "reports" / "FINAL.md").as_posix(),
    }
    report_path = write_outcome_report(repo, outcome)
    save_state(repo, state)
    journal(repo, f"Finished loop at `{target}` after all completion gates passed.")
    print(f"finished at {target}; report: {report_path}")
    return 0


def cmd_report(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True)
    outcome = build_outcome_report(repo, state, kind="DRAFT")
    path = write_outcome_report(repo, outcome)
    print(path)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="hloop",
        description="File-backed Herdr multi-agent Manager loop helper.",
        epilog=(
            "Safe first run: python3 /path/to/herdr-dev-loop/scripts/hloop "
            "--repo /path/to/repo init --goal-id demo --goal '...' "
            "--base main --create-branch"
        ),
    )
    parser.add_argument("--repo", default=".", help="repository path")
    parser.add_argument(
        "--namespace",
        default=os.environ.get("HLOOP_NAMESPACE", DEFAULT_LOOP_NAMESPACE),
        help="explicit loop namespace below .ai/herdr-dev-loop/loops (default: default)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    version = sub.add_parser("version", help="show runtime and current-loop skill versions")
    version.add_argument("--json", action="store_true")
    version.set_defaults(func=cmd_version)

    namespaces = sub.add_parser("namespaces", help="list namespaced loops and report ignored legacy state")
    namespaces.add_argument("--json", action="store_true")
    namespaces.set_defaults(func=cmd_namespace_list)

    doctor = sub.add_parser("doctor", help="check local Herdr/agent/skill dependencies")
    doctor.add_argument("--json", action="store_true")
    doctor.add_argument("--strict-skills", action="store_true")
    doctor.add_argument("--sessions", action="store_true", help="include loop session inventory when STATE.json exists")
    doctor.add_argument("--session-lines", type=int, default=80, help="pane output lines used by --sessions")
    doctor.set_defaults(func=cmd_doctor)

    selftest = sub.add_parser("selftest", help="lint skill-local schemas and artifact contracts")
    selftest.add_argument("--skill-dir", help="skill directory; defaults to this hloop script's parent skill")
    selftest.add_argument("--json", action="store_true")
    selftest.set_defaults(func=cmd_selftest)

    migrate = sub.add_parser("migrate", help="migrate an older namespaced STATE.json")
    migrate_mode = migrate.add_mutually_exclusive_group()
    migrate_mode.add_argument(
        "--dry-run",
        action="store_true",
        help="show the migration summary without writing (default)",
    )
    migrate_mode.add_argument(
        "--apply",
        action="store_true",
        help="write the migrated state after creating a backup",
    )
    migrate.set_defaults(func=cmd_migrate)

    config = sub.add_parser("config", help="inspect and initialize hierarchical TOML configuration")
    config_sub = config.add_subparsers(dest="config_command", required=True)
    config_path = config_sub.add_parser("path", help="show config discovery and selected path")
    config_path.add_argument("--json", action="store_true")
    config_path.set_defaults(func=cmd_config_path)
    config_validate = config_sub.add_parser("validate", help="validate the selected config file")
    config_validate.add_argument("--path", help="validate this config file instead of discovery")
    config_validate.add_argument("--json", action="store_true")
    config_validate.set_defaults(func=cmd_config_validate)
    config_explain = config_sub.add_parser("explain", help="explain resolved values and sources")
    config_explain.add_argument("--repo", dest="config_repo", help="repository or directory to match")
    config_explain.add_argument("--json", action="store_true")
    config_explain.set_defaults(func=cmd_config_explain)
    config_init = config_sub.add_parser("init", help="create a minimal secret-free config template")
    config_init.add_argument("--path", help="write this path instead of the discovered default")
    config_init.add_argument("--force", action="store_true")
    config_init.add_argument("--json", action="store_true")
    config_init.set_defaults(func=cmd_config_init)
    config_apply = config_sub.add_parser(
        "apply", help="preview or explicitly apply resolved config to an idle loop"
    )
    config_apply_mode = config_apply.add_mutually_exclusive_group(required=True)
    config_apply_mode.add_argument(
        "--dry-run", action="store_true", help="show snapshot changes without writing"
    )
    config_apply_mode.add_argument(
        "--apply", action="store_true", help="write the new snapshot after safety checks"
    )
    config_apply.set_defaults(func=cmd_config_apply)

    init = sub.add_parser("init", help="initialize one namespaced loop")
    init.add_argument("--goal-id")
    init.add_argument("--goal", required=True)
    init.add_argument("--base")
    init.add_argument("--integration")
    init.add_argument(
        "--worktree-root",
        help="root directory for all role worktrees; relative paths resolve from the repository root",
    )
    init.add_argument("--max-workers", type=int)
    init.add_argument("--max-reviewers", type=int, default=DEFAULT_MAX_REVIEWERS)
    init.add_argument("--max-gap-auditors", type=int, default=DEFAULT_MAX_GAP_AUDITORS)
    init.add_argument("--merge-mode", choices=["squash", "cherry-pick"], default="squash")
    init.add_argument("--branch-strategy", choices=sorted(BRANCH_STRATEGIES), default=DEFAULT_BRANCH_STRATEGY)
    init.add_argument("--worker-qa-profile", choices=sorted(QA_PROFILES))
    init.add_argument("--manager-qa-profile", choices=sorted(QA_PROFILES), default=DEFAULT_MANAGER_QA_PROFILE)
    init.add_argument(
        "--qa-profile",
        choices=sorted(QA_PROFILES),
        help="deprecated alias for --worker-qa-profile",
    )
    init.add_argument("--worker-protocol", choices=sorted(WORKER_PROTOCOLS), default=DEFAULT_WORKER_PROTOCOL)
    init.add_argument("--review-protocol", choices=sorted(REVIEW_PROTOCOLS), default=DEFAULT_REVIEW_PROTOCOL)
    init.add_argument("--worker-agent-provider", choices=sorted(AGENT_PROVIDERS))
    init.add_argument("--worker-agent-model")
    init.add_argument("--worker-agent-effort")
    init.add_argument("--worker-claude-permission-mode", default=DEFAULT_CLAUDE_PERMISSION_MODE)
