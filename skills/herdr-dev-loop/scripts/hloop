    final_review = sub.add_parser("final-review", help="prepare, record, and inspect manual final review certification")
    final_review_sub = final_review.add_subparsers(dest="final_review_command", required=True)
    for command_name, func, help_text in (
        ("prepare", cmd_final_review_prepare, "freeze the manual final-review plan and evidence paths"),
        ("record", cmd_final_review_record, "recompute manual final-review completeness"),
    ):
        command_parser = final_review_sub.add_parser(command_name, help=help_text)
        command_parser.add_argument("--mode", choices=sorted(hloop_review.REVIEW_MODES), default=None)
        command_parser.add_argument("--providers", nargs="+", choices=sorted(AGENT_PROVIDERS))
        command_parser.add_argument("--probe-count", type=int)
        command_parser.add_argument("--probes-per-provider", type=int)
        command_parser.add_argument("--json", action="store_true")
        command_parser.add_argument("--dry-run", action="store_true")
        if command_name == "prepare":
            command_parser.add_argument("--certification-id")
        else:
            command_parser.add_argument("--manifest")
            command_parser.add_argument("--report")
        command_parser.set_defaults(func=func)
    final_review_status = final_review_sub.add_parser("status", help="show current manual final-review certification status")
    final_review_status.add_argument("--json", action="store_true")
    final_review_status.set_defaults(func=cmd_final_review_status)

    dispatch = sub.add_parser("dispatch", help="control new role dispatch without pausing safe Manager operations")
