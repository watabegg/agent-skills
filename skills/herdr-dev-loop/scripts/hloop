    tick.set_defaults(func=cmd_tick)

    pump = sub.add_parser("pump", help="run multiple safe tick transitions until triage, blocked, done, or max transitions")
    pump.add_argument("--max-transitions", type=int, default=20)
    pump.add_argument("--max-workers", type=int)
    pump.add_argument("--manager-pane")
    pump.add_argument("--direction", choices=["right", "down"], default="right")
    pump.add_argument("--launcher", choices=["pane", "agent"], default="pane")
    pump.add_argument("--worker-runner", choices=["tui", "exec"])
    pump.add_argument("--reviewer-runner", choices=["exec", "tui"])
    pump.add_argument("--gap-runner", choices=["exec", "tui"])
    pump.add_argument("--keep-pane", action="store_true")
    pump.add_argument("--session-cleanup", choices=sorted(SESSION_CLEANUP_MODES))
    pump.add_argument("--review-wait-ms", type=int)
    pump.add_argument("--gap-wait-ms", type=int)
    pump.add_argument("--wait", action="store_true", help="use configured review/gap wait times instead of forcing 0ms waits")
    pump.add_argument("--sleep-ms", type=int, default=DEFAULT_PUMP_SLEEP_MS)
    pump.add_argument("--dry-run", action="store_true")
    pump.add_argument("--stop-on-triage", dest="stop_on_triage", action="store_true", default=True)
    pump.add_argument("--no-stop-on-triage", dest="stop_on_triage", action="store_false")
    pump.add_argument("--stop-on-waiting", dest="stop_on_waiting", action="store_true", default=False)
    pump.add_argument("--no-stop-on-waiting", dest="stop_on_waiting", action="store_false")
    pump.set_defaults(func=cmd_pump)

    report = sub.add_parser("report", help="write reports/FINAL.md")
    report.set_defaults(func=cmd_report)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if command_requires_loop_lock(args):
            repo = repo_root(Path(args.repo).resolve())
            with loop_lock(repo):
                return int(args.func(args))
        return int(args.func(args))
    except HLoopError as exc:
        print(f"hloop: {exc}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as exc:
        stderr = (exc.stderr or "").strip()
        stdout = (exc.stdout or "").strip()
        detail = stderr or stdout or str(exc)
        print(f"hloop: command failed: {detail}", file=sys.stderr)
        return exc.returncode or 1


if __name__ == "__main__":
    raise SystemExit(main())
