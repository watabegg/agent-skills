#!/usr/bin/env python3
"""Herdr Dev Loop helper.

This script keeps the Herdr/Codex multi-agent loop file-backed and bounded.
It intentionally avoids non-stdlib dependencies so it can run inside arbitrary
repositories.
"""

from __future__ import annotations

import argparse
import fnmatch
import fcntl
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


LOOP_DIR = Path(".ai") / "loop"
TASK_STATUSES_FINAL = {"done", "partial", "blocked", "failed", "abandoned"}
SESSION_CLEANUP_MODES = {"none", "archive", "delete"}
DEFAULT_REVIEW_WAIT_MS = 600_000
DEFAULT_GAP_WAIT_MS = 600_000
DEFAULT_MAX_WORKERS = 3
DEFAULT_MAX_REVIEWERS = 1
DEFAULT_MAX_GAP_AUDITORS = 1
DEFAULT_REVIEW_AFTER_MERGES = 1
DEFAULT_GAP_AFTER_MERGES = 3
DEFAULT_BRANCH_STRATEGY = "integration"
DEFAULT_WORKER_QA_PROFILE = "repo-default"
DEFAULT_MANAGER_QA_PROFILE = "none"
DEFAULT_WORKER_PROTOCOL = "native"
DEFAULT_REVIEW_PROTOCOL = "native"
DEFAULT_REVIEW_LANES = [
    "integration-contract",
    "correctness",
    "risk",
    "validation-qa",
]
BRANCH_STRATEGIES = {"integration", "pr-per-task", "custom"}
QA_PROFILES = {"repo-default", "local", "staging", "preview", "none", "custom"}
MANAGER_QA_PASSING_STATUSES = {"passed", "accepted-risk", "not-required"}
WORKER_PROTOCOLS = {"native", "codex-impl"}
REVIEW_PROTOCOLS = {"native", "codex-review-multi-v2"}
DEFAULT_MANAGER_MESSAGE_INPUT_SETTLE_MS = 1_000
DEFAULT_MANAGER_MESSAGE_SUBMIT_VERIFY_MS = 5_000
