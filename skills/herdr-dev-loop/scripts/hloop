def print_policy_payload(payload: dict[str, Any], *, as_json: bool, label: str) -> None:
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return
    print(label)
    for key, value in payload.items():
        if isinstance(value, (dict, list)):
            rendered = json.dumps(value, ensure_ascii=False, sort_keys=True)
        else:
            rendered = str(value)
        print(f"{key}: {rendered}")


def cmd_release_scope_lock(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    current = release_scope_from_state(state)
    if current.status == "locked":
        raise HLoopError("release scope is already locked; use release-scope amend")
    source_refs = _arg_list(args, "source_ref") or [
        "MISSION.md",
        "PLAN.md",
    ]
    sources = read_scope_sources(repo, source_refs)
    available_plan_item_refs = hloop_release_scope.discover_plan_item_refs(sources)
    accepted_refs = accepted_requirement_ids(state)
    try:
        scope = hloop_release_scope.ReleaseScope.lock(
            source_refs=source_refs,
            source_contents=sources,
            scope_revision=1,
            source_snapshot_revision=1,
            locked_at=now_iso(),
            plan_item_refs=_arg_list(args, "plan_item_ref"),
            requirement_refs=_arg_list(args, "requirement_ref"),
            release_scope_refs=_arg_list(args, "scope_ref", "release_scope_ref")
            or source_refs,
            available_plan_item_refs=available_plan_item_refs,
            accepted_requirement_refs=accepted_refs,
        )
    except hloop_release_scope.ReleaseScopeError as exc:
        raise HLoopError(f"cannot lock release scope: {exc}") from exc
    state["release_scope"] = scope.to_record()
    state.setdefault("dispatch_freeze", dispatch_freeze_record(state))
    state.setdefault(
        "follow_ups",
        {"next_id": 1, "open_count": 0, "artifact_refs": [], "issue_keys": {}, "issue_key_aliases": {}},
    )
    save_state(repo, state)
    journal(repo, f"Locked release scope revision {scope.scope_revision} from {', '.join(source_refs)}.")
    payload = {"status": "locked", "scope": scope.to_record()}
    print_policy_payload(payload, as_json=bool(getattr(args, "json", False)), label="release scope locked")
    return 0


def cmd_release_scope_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    scope = release_scope_from_state(state)
    drift: list[str] = []
    if scope.status == "locked":
        try:
            drift = list(scope.source_drift(read_scope_sources(repo, scope.source_refs)))
        except HLoopError as exc:
            drift = [str(exc)]
    payload = {
        "status": scope.status,
        "enabled": release_scope_enabled(state),
        "scope": scope.to_record(),
        "source_drift": drift,
        "source_snapshot_ok": not drift,
    }
    print_policy_payload(payload, as_json=bool(getattr(args, "json", False)), label="release scope status")
    return 0


def cmd_release_scope_amend(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    # An amendment is the explicit escape hatch for a changed source
    # snapshot, so do not reject the very drift this command is meant to
    # record.  The immutable previous digest is carried by the core module.
    scope = release_scope_from_state(state)
    if scope.status != "locked":
        raise HLoopError("release-scope amend requires a locked release scope")
    source_refs = _arg_list(args, "source_ref") or list(scope.source_refs)
    sources = read_scope_sources(repo, source_refs)
    amendment_refs = {ref: True for ref in scope.amendment_refs}
    amendment_id = next_id("A", amendment_refs)
    try:
        amendment = hloop_release_scope.create_amendment(
            scope,
            amendment_id=amendment_id,
            kind=args.kind,
            reason=args.reason,
            new_source_contents=sources,
            basis_refs=_arg_list(args, "basis_ref"),
            user_input_id=str(
                getattr(args, "user_input_id", None)
                or getattr(args, "authorization_input_id", None)
                or ""
            ),
            affected_task_ids=_arg_list(args, "affected_task_id"),
            created_at=now_iso(),
            captured_input_ids=state.get("inputs_index"),
        )
        updated_scope = scope.apply_amendment(amendment)
    except hloop_release_scope.ReleaseScopeError as exc:
        raise HLoopError(f"cannot amend release scope: {exc}") from exc
    amendment_path = loop_path(repo) / "release-scope" / "amendments" / f"{amendment_id}.json"
    write_text(amendment_path, json.dumps(amendment.to_record(), ensure_ascii=False, indent=2) + "\n")
    state["release_scope"] = updated_scope.to_record()
    _record_scope_expansion_metric(state, amendment.to_record())
    invalidate_review_gates_for_change(
        state,
        reason=f"release-scope-amendment:{amendment_id}",
        target_sha=current_integration_target(repo, state),
    )
    save_state(repo, state)
    journal(repo, f"Applied release-scope amendment `{amendment_id}` ({amendment.kind}).")
    payload = {
        "status": "amended",
        "amendment": amendment.to_record(),
        "scope": updated_scope.to_record(),
        "artifact": str(amendment_path),
    }
    print_policy_payload(payload, as_json=bool(getattr(args, "json", False)), label=f"release scope amended: {amendment_id}")
    return 0


def cmd_dispatch_freeze(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    freeze = dispatch_freeze_record(state)
    if str(freeze.get("status") or "inactive") == "active":
        raise HLoopError("dispatch is already frozen")
    source_input_id = str(
        getattr(args, "source_input_id", None)
        or getattr(args, "user_input_id", None)
        or ""
    )
    if source_input_id and not re.fullmatch(r"U[0-9]{4}", source_input_id):
        raise HLoopError("source_input_id must match U0001-style input ids")
    allowed = _arg_list(args, "allowed_running_role_id") or role_ids_running(state)
    state["dispatch_freeze"] = {
        "status": "active",
        "reason": str(args.reason).strip(),
        "frozen_at": now_iso(),
        "source_input_id": source_input_id,
        "allowed_running_role_ids": allowed,
    }
    save_state(repo, state)
    journal(repo, f"Froze new dispatch: {args.reason}")
    payload = {"status": "active", "dispatch_freeze": state["dispatch_freeze"]}
    print_policy_payload(payload, as_json=bool(getattr(args, "json", False)), label="dispatch frozen")
    return 0


def cmd_dispatch_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    freeze = dispatch_freeze_record(state)
    payload = {
        "status": freeze.get("status", "inactive"),
        "active": dispatch_is_frozen(state),
        "dispatch_freeze": freeze,
    }
    print_policy_payload(payload, as_json=bool(getattr(args, "json", False)), label="dispatch status")
    return 0


def cmd_dispatch_unfreeze(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    reason = str(getattr(args, "reason", None) or "").strip()
    source_input_id = str(
        getattr(args, "source_input_id", None)
        or getattr(args, "user_input_id", None)
        or ""
    )
    if not reason and not source_input_id:
        raise HLoopError("dispatch unfreeze requires --reason or --user-input-id")
    if source_input_id and not re.fullmatch(r"U[0-9]{4}", source_input_id):
        raise HLoopError("source_input_id must match U0001-style input ids")
    current = dispatch_freeze_record(state)
    blocked_phase = review_failure_phase(state)
    if blocked_phase:
        raise HLoopError(
            f"dispatch unfreeze is not allowed from {blocked_phase}; "
            "use `hloop review reopen` with explicit user authorization"
        )
    state["dispatch_freeze"] = {
        **current,
        "status": "inactive",
        "reason": "",
        "frozen_at": "",
        "source_input_id": "",
        "allowed_running_role_ids": [],
        "unfrozen_at": now_iso(),
        "unfreeze_reason": reason,
        "unfreeze_input_id": source_input_id,
    }
    save_state(repo, state)
    journal(repo, f"Unfroze dispatch: {reason or source_input_id}")
    payload = {"status": "inactive", "dispatch_freeze": state["dispatch_freeze"]}
    print_policy_payload(payload, as_json=bool(getattr(args, "json", False)), label="dispatch unfrozen")
    return 0


def _follow_up_state(state: dict[str, Any]) -> dict[str, Any]:
    value = state.setdefault("follow_ups", {})
    if not isinstance(value, dict):
        raise HLoopError("STATE.json follow_ups must be an object")
    value.setdefault("next_id", 1)
    value.setdefault("open_count", 0)
    value.setdefault("artifact_refs", [])
    value.setdefault("issue_keys", {})
    value.setdefault("issue_key_aliases", {})
    value.setdefault("export_paths", [])
    return value


def _follow_up_artifact(repo: Path, follow_up_id: str) -> Path:
    if not re.fullmatch(r"F[0-9]{3}", follow_up_id):
        raise HLoopError(f"invalid follow-up id: {follow_up_id}")
    return loop_path(repo) / "follow-ups" / f"{follow_up_id}.md"


def _follow_up_records(repo: Path, state: dict[str, Any]) -> list[dict[str, Any]]:
    records: list[dict[str, Any]] = []
    for raw_ref in normalize_list(_follow_up_state(state).get("artifact_refs")):
        path = repo / raw_ref if not Path(raw_ref).is_absolute() else Path(raw_ref)
        if path.is_file():
            record = read_frontmatter(path)
            if record:
                record["artifact"] = str(path)
                records.append(record)
    return records


def _refresh_follow_up_count(state: dict[str, Any]) -> None:
    follow_ups = _follow_up_state(state)
    follow_ups["open_count"] = sum(
        1 for record in state.get("_follow_up_records_cache", [])
        if str(record.get("status") or "") in {"open", "active", "deferred"}
    )
    state.pop("_follow_up_records_cache", None)


def _follow_up_issue_key_maps(
    state: dict[str, Any],
) -> tuple[dict[str, Any], dict[str, Any]]:
    follow_ups = _follow_up_state(state)
    issue_keys = follow_ups.get("issue_keys")
    aliases = follow_ups.get("issue_key_aliases")
    if not isinstance(issue_keys, dict):
        raise HLoopError("STATE.json follow_ups.issue_keys must be an object")
    if not isinstance(aliases, dict):
        raise HLoopError("STATE.json follow_ups.issue_key_aliases must be an object")
    return issue_keys, aliases


def _follow_up_record_for_id(
    repo: Path, state: dict[str, Any], follow_up_id: str
) -> dict[str, Any] | None:
    for record in _follow_up_records(repo, state):
        if str(record.get("id") or "") == follow_up_id:
            return record
    return None


def _follow_up_key_for_id(
    repo: Path, state: dict[str, Any], follow_up_id: str
) -> str:
    record = _follow_up_record_for_id(repo, state, follow_up_id)
    if record and record.get("issue_key"):
        return str(record["issue_key"])
    issue_keys, _aliases = _follow_up_issue_key_maps(state)
    for issue_key, value in issue_keys.items():
        if str(value) == follow_up_id:
            return str(issue_key)
    raise HLoopError(f"follow-up has no issue key: {follow_up_id}")


def _follow_up_known_issue_keys(
    repo: Path, state: dict[str, Any]
) -> tuple[str, ...]:
    issue_keys, aliases = _follow_up_issue_key_maps(state)
    values = set(str(key) for key in issue_keys)
    values.update(str(key) for key in aliases)
    values.update(str(value) for value in aliases.values())
    values.update(
        str(record.get("issue_key"))
        for record in _follow_up_records(repo, state)
        if record.get("issue_key")
    )
    return tuple(sorted(values))


def _follow_up_target_key(
    repo: Path, state: dict[str, Any], raw_target: str
) -> str:
    value = str(raw_target or "").strip()
    if re.fullmatch(r"F[0-9]{3}", value):
        value = _follow_up_key_for_id(repo, state, value)
    try:
        return hloop_review_policy.resolve_issue_key_alias(
            value, _follow_up_issue_key_maps(state)[1]
        )
    except hloop_review_policy.ReviewPolicyError as exc:
        raise HLoopError(f"invalid follow-up relation target: {exc}") from exc


def _follow_up_relation_request(args: argparse.Namespace) -> tuple[str, str] | None:
    requested: list[tuple[str, str]] = []
    for relation, name in (
        ("alias_of", "alias_of"),
        ("duplicate_of", "duplicate_of"),
        ("supersedes", "supersedes"),
    ):
        value = str(getattr(args, name, None) or "").strip()
        if value:
            requested.append((relation, value))
    explicit_relation = str(getattr(args, "relation", None) or "").strip()
    explicit_target = str(getattr(args, "target_issue_key", None) or "").strip()
    if explicit_relation:
        if not explicit_target:
            raise HLoopError("--relation requires --target-issue-key")
        requested.append((explicit_relation, explicit_target))
    elif explicit_target:
        raise HLoopError("--target-issue-key requires --relation")
    if len(requested) > 1:
        raise HLoopError("follow-up relation options are mutually exclusive")
    return requested[0] if requested else None


def _follow_up_set_alias(
    aliases: dict[str, Any], source_key: str, target_key: str
) -> None:
    source = str(source_key).strip()
    target = str(target_key).strip()
    if source == target:
        raise HLoopError("follow-up issue-key alias cannot target itself")
    try:
        canonical_target = hloop_review_policy.resolve_issue_key_alias(target, aliases)
        aliases[source] = canonical_target
        hloop_review_policy.resolve_issue_key_alias(source, aliases)
    except hloop_review_policy.ReviewPolicyError as exc:
        aliases.pop(source, None)
        raise HLoopError(f"invalid follow-up issue-key alias: {exc}") from exc


def _merge_follow_up_values(*values: Any) -> list[str]:
    merged: list[str] = []
    for value in values:
        for item in normalize_list(value):
            if item and item not in merged:
                merged.append(item)
    return merged


def _follow_up_structured_value(
    args: argparse.Namespace, name: str
) -> dict[str, Any] | list[Any] | None:
    raw = getattr(args, name, None)
    if raw is None:
        return None
    if isinstance(raw, (dict, list)):
        value = raw
    else:
        try:
            value = json.loads(str(raw))
        except json.JSONDecodeError as exc:
            option = "--" + name.replace("_", "-")
            raise HLoopError(f"{option} must be a JSON object or array: {exc}") from exc
    if not isinstance(value, (dict, list)):
        option = "--" + name.replace("_", "-")
        raise HLoopError(f"{option} must be a JSON object or array")
    return value


def cmd_follow_up_add(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    follow_ups = _follow_up_state(state)
    if args.recommended_action != "defer_follow_up":
        raise HLoopError("follow-up add requires recommended_action=defer_follow_up")
    if args.disposition != "defer_follow_up":
        raise HLoopError(
            "follow-up add accepts only defer_follow_up; accepted risk requires a decision record"
        )
    try:
        key = hloop_review_policy.build_follow_up_issue_key(
            component=args.component,
            trigger_class=args.trigger_class,
            product_impact=args.product_impact,
            root_cause=args.root_cause,
        )
        disposition = hloop_review_policy.FindingDisposition(
            fact_status=args.fact_status,
            origin=args.origin,
            contract_relation=args.contract_relation,
            decision_requirement=args.decision_requirement,
            severity=args.severity,
            disposition=args.disposition,
            release_effect=args.release_effect,
            requirement_refs=tuple(_arg_list(args, "requirement_ref")),
            why_fix_now=args.why_fix_now or "",
            remediation_round=args.remediation_round,
        )
        hloop_review_policy.validate_disposition(
            disposition,
            acceptance_can_be_met_without_decision=bool(args.acceptance_can_be_met_without_decision),
            safety_critical=bool(args.safety_critical),
            scope_change_authorized=bool(args.scope_change_authorized),
        )
    except hloop_review_policy.ReviewPolicyError as exc:
        raise HLoopError(f"follow-up policy rejected: {exc}") from exc
    if not args.source_review_fingerprint:
        raise HLoopError("follow-up requires at least one --source-review-fingerprint")
    if not args.evidence:
        raise HLoopError("follow-up requires at least one --evidence")
    if not args.affected_path and not args.symbol:
        raise HLoopError("follow-up requires --affected-path or --symbol")
    fingerprints = []
    for raw in args.source_review_fingerprint:
        value = str(raw).strip().lower()
        if not re.fullmatch(r"sha256:[0-9a-f]{64}", value):
            raise HLoopError("source review fingerprints must use sha256:<64 hex chars>")
        if value not in fingerprints:
            fingerprints.append(value)
    issue_key = key.key
    issue_keys, aliases = _follow_up_issue_key_maps(state)
    relation_request = _follow_up_relation_request(args)
    relation: hloop_review_policy.FollowUpRelation | None = None
    target_key = ""
    target_id = ""
    if relation_request:
        relation_kind, raw_target = relation_request
        target_key = _follow_up_target_key(repo, state, raw_target)
        relation = hloop_review_policy.FollowUpRelation(
            relation=relation_kind,
            target_issue_key=target_key,
            source_issue_key=issue_key,
        )
        try:
            hloop_review_policy.validate_follow_up_relation(
                relation,
                known_issue_keys=_follow_up_known_issue_keys(repo, state),
                aliases=aliases,
            )
        except hloop_review_policy.ReviewPolicyError as exc:
            raise HLoopError(f"follow-up relation rejected: {exc}") from exc
        target_id = str(issue_keys.get(target_key) or "")
        if not target_id:
            target_record = _follow_up_record_for_id(repo, state, raw_target)
            if target_record:
                target_id = str(target_record.get("id") or "")
        if not target_id:
            raise HLoopError(f"follow-up relation target is not recorded: {target_key}")

    canonical_key = hloop_review_policy.resolve_issue_key_alias(issue_key, aliases)
    existing_id = str(issue_keys.get(canonical_key) or issue_keys.get(issue_key) or "")
    promoted = False
    duplicate = bool(existing_id)
    relation_kind = relation.relation if relation else ""

    if relation_kind in {"alias_of", "duplicate_of"}:
        target_record = _follow_up_record_for_id(repo, state, target_id)
        target_record_key = (
            str(target_record.get("issue_key") or target_key)
            if target_record
            else target_key
        )
        if relation_kind == "alias_of" and not key.provisional and target_record:
            # A resolved root cause promotes the provisional artifact instead
            # of creating F002.  All old aliases are rewired to the final key
            # so every spelling resolves to one canonical FNNN.
            if bool(target_record.get("provisional")):
                promoted = True
                existing_id = target_id
                duplicate = True
                for alias_key, mapped_key in list(aliases.items()):
                    try:
                        mapped_canonical = hloop_review_policy.resolve_issue_key_alias(
                            str(mapped_key), aliases
                        )
                    except hloop_review_policy.ReviewPolicyError as exc:
                        raise HLoopError(f"invalid stored follow-up alias: {exc}") from exc
                    if alias_key == target_record_key or mapped_canonical == target_record_key:
                        aliases[alias_key] = issue_key
                aliases[target_record_key] = issue_key
                issue_keys.pop(target_record_key, None)
                issue_keys[issue_key] = existing_id
                canonical_key = issue_key
            else:
                _follow_up_set_alias(aliases, issue_key, target_key)
                canonical_key = target_key
                existing_id = target_id
                duplicate = True
                issue_keys.pop(issue_key, None)
        else:
            _follow_up_set_alias(aliases, issue_key, target_key)
            canonical_key = target_key
            existing_id = target_id
            duplicate = True
            issue_keys.pop(issue_key, None)
    elif relation_kind == "supersedes":
        _follow_up_set_alias(aliases, target_key, issue_key)
        canonical_key = issue_key
        issue_keys.pop(target_key, None)
        issue_keys[issue_key] = existing_id
        duplicate = bool(existing_id)

    existing_follow_up_ids = {
        str(record.get("id"))
        for record in _follow_up_records(repo, state)
        if re.fullmatch(r"F[0-9]{3}", str(record.get("id") or ""))
    }
    if existing_id:
        follow_up_id = existing_id
    else:
        candidate_number = max(normalize_int(follow_ups.get("next_id"), 1), 1)
        while f"F{candidate_number:03d}" in existing_follow_up_ids:
            candidate_number += 1
        follow_up_id = f"F{candidate_number:03d}"
    if not existing_id:
        issue_keys[canonical_key] = follow_up_id
    path = _follow_up_artifact(repo, follow_up_id)
    previous = read_frontmatter(path) if path.exists() else {}
    created_at = str(previous.get("created_at") or now_iso())
    previous_fingerprints = normalize_list(previous.get("source_review_fingerprints"))
    previous_evidence = normalize_list(previous.get("evidence"))
    previous_aliases = normalize_list(previous.get("aliases"))
    previous_history = previous.get("history")
    if not isinstance(previous_history, list):
        previous_history = []
    previous_relations = previous.get("relations")
    if not isinstance(previous_relations, list):
        previous_relations = []
    structured_values = {
        name: _follow_up_structured_value(args, name)
        for name in FOLLOW_UP_INPUT_JSON_FIELDS
    }

    if canonical_key == issue_key:
        key_record = key.to_record()
    else:
        try:
            key_record = hloop_review_policy.FollowUpIssueKey.from_record(previous).to_record()
        except hloop_review_policy.ReviewPolicyError:
            key_record = key.to_record()
    if key_record.get("root_cause") is None:
        key_record["root_cause"] = ""

    relation_record = relation.to_record() if relation else None
    if relation_record:
        relation_record["target_issue_key"] = target_key
    recorded_aliases = list(previous_aliases)
    if relation_kind in {"alias_of", "duplicate_of"} and issue_key != canonical_key:
        if issue_key not in recorded_aliases:
            recorded_aliases.append(issue_key)
    if promoted and target_key not in recorded_aliases:
        recorded_aliases.append(target_key)
    if relation_kind == "supersedes" and target_key not in recorded_aliases:
        recorded_aliases.append(target_key)

    event_action = (
        "promote_provisional"
        if promoted
        else relation_kind or ("update" if previous else "create")
    )
    history_event: dict[str, Any] = {
        "at": now_iso(),
        "action": event_action,
        "issue_key": issue_key,
        "canonical_issue_key": canonical_key,
        "source_review_fingerprints": fingerprints,
        "evidence": list(args.evidence),
    }
    if relation_record:
        history_event["relation"] = relation_record
        previous_relations.append(relation_record)

    requirement_refs = _merge_follow_up_values(
        previous.get("requirement_refs"), _arg_list(args, "requirement_ref")
    )
    record: dict[str, Any] = {
        "id": follow_up_id,
        "title": args.title or str(previous.get("title") or "Follow-up"),
        "status": str(previous.get("status") or args.status),
        **key_record,
        "aliases": recorded_aliases,
        "source_review_fingerprints": _merge_follow_up_values(
            previous_fingerprints, fingerprints
        ),
        "discovered_head": args.discovered_head
        or str(previous.get("discovered_head") or "")
        or git(repo, ["rev-parse", state["integration_branch"]]),
        "evidence": _merge_follow_up_values(previous_evidence, args.evidence),
        "impact": args.impact or str(previous.get("impact") or ""),
        "fact_status": args.fact_status,
        "severity": args.severity,
        "origin": args.origin,
        "contract_relation": args.contract_relation,
        "decision_requirement": args.decision_requirement,
        "disposition": args.disposition,
        "release_effect": args.release_effect,
        "requirement_refs": requirement_refs,
        "recommended_action": args.recommended_action,
        "deferred_reason": args.deferred_reason,
        "reconsider_condition": args.reconsider_condition,
        "created_at": created_at,
        "updated_at": now_iso(),
        "history": [*previous_history, history_event],
        "relations": list(dict.fromkeys(json.dumps(item, sort_keys=True) for item in previous_relations)),
    }
    record["relations"] = [json.loads(item) for item in record["relations"]]
    if relation_record:
        record["duplicate_relation"] = relation_record
    elif previous.get("duplicate_relation"):
        record["duplicate_relation"] = previous["duplicate_relation"]
    for name in (
        "source_review",
        "source_gap",
        "source_task",
        "source_finding",
        "affected_path",
        "symbol",
        "target_version",
        "milestone",
    ):
        value = getattr(args, name, None) or previous.get(name)
        if value:
            record[name] = value
    for name, value in structured_values.items():
        if value is not None:
            record[name] = value
        elif name in previous:
            record[name] = previous[name]

    target_path: Path | None = None
    target_record: dict[str, Any] | None = None
    if relation_kind == "supersedes" and target_id:
        target_path = _follow_up_artifact(repo, target_id)
        target_record = read_frontmatter(target_path)
        target_record["status"] = "superseded"
        target_record["updated_at"] = now_iso()
        target_record["duplicate_relation"] = relation_record
        target_history = target_record.get("history")
        if not isinstance(target_history, list):
            target_history = []
        target_history.append(
            {
                "at": now_iso(),
                "action": "superseded",
                "issue_key": target_key,
                "canonical_issue_key": issue_key,
                "relation": relation_record,
            }
        )
        target_record["history"] = target_history

    artifact_text = (
        frontmatter(record) + f"\n# {record['title']}\n\n{record['impact']}\n"
    )
    target_text = None
    if target_path is not None and target_record is not None:
        target_text = (
            frontmatter(target_record)
            + f"\n# {target_record.get('title') or target_id}\n\n"
            + f"{target_record.get('impact') or ''}\n"
        )

    artifact_ref = str(path.relative_to(repo))
    refs = normalize_list(follow_ups.get("artifact_refs"))
    if artifact_ref not in refs:
        refs.append(artifact_ref)
    follow_ups["artifact_refs"] = refs
    if not duplicate:
        follow_ups["next_id"] = max(
            normalize_int(follow_ups.get("next_id"), 1),
            int(follow_up_id[1:]) + 1,
        )
    # Keep only canonical keys in issue_keys.  Historical spellings are
    # resolved through issue_key_aliases and remain auditable in the artifact.
    issue_keys[canonical_key] = follow_up_id
    for alias_key in list(issue_keys):
        if alias_key != canonical_key:
            try:
                if hloop_review_policy.resolve_issue_key_alias(alias_key, aliases) != alias_key:
                    issue_keys.pop(alias_key, None)
            except hloop_review_policy.ReviewPolicyError as exc:
                raise HLoopError(f"invalid stored follow-up alias: {exc}") from exc
    for alias_key in list(aliases):
        try:
            hloop_review_policy.resolve_issue_key_alias(alias_key, aliases)
        except hloop_review_policy.ReviewPolicyError as exc:
            raise HLoopError(f"invalid stored follow-up alias: {exc}") from exc
    state_file = state_path(repo)
    journal_file = loop_path(repo) / "JOURNAL.md"
    persistence_paths = [path]
    if target_path is not None:
        persistence_paths.append(target_path)
    persistence_paths.extend((state_file, journal_file))
    previous_files = {
        candidate: candidate.read_bytes() if candidate.exists() else None
        for candidate in dict.fromkeys(persistence_paths)
    }
    try:
        write_text(path, artifact_text)
        if target_path is not None and target_text is not None:
            write_text(target_path, target_text)
        state["_follow_up_records_cache"] = _follow_up_records(repo, state)
        _refresh_follow_up_count(state)
        save_state(repo, state)
        journal(
            repo,
            f"{'Updated' if duplicate else 'Recorded'} follow-up `{follow_up_id}` ({canonical_key}).",
        )
    except Exception as exc:
        rollback_errors: list[str] = []
        for candidate, previous_bytes in reversed(tuple(previous_files.items())):
            try:
                if previous_bytes is None:
                    try:
                        candidate.unlink()
                    except FileNotFoundError:
                        pass
                else:
                    candidate.parent.mkdir(parents=True, exist_ok=True)
                    candidate.write_bytes(previous_bytes)
            except Exception as rollback_exc:
                rollback_errors.append(f"{candidate}: {rollback_exc}")
        if rollback_errors:
            raise HLoopError(
                "follow-up persistence failed and bounded rollback failed: "
                + "; ".join(rollback_errors)
            ) from exc
        raise HLoopError(f"follow-up persistence failed: {exc}") from exc
    payload = {
        "status": "deduplicated" if duplicate else "created",
        "follow_up": record,
        "artifact": str(path),
        "canonical_issue_key": canonical_key,
        "relation": relation_record,
    }
    print_policy_payload(
        payload,
        as_json=bool(getattr(args, "json", False)),
        label=f"follow-up {'updated' if duplicate else 'created'}: {follow_up_id}",
    )
    return 0


def resolve_follow_up_id(state: dict[str, Any], raw_id: str) -> str:
    value = str(raw_id or "").strip()
    if re.fullmatch(r"F[0-9]{3}", value):
        return value
    issue_keys, aliases = _follow_up_issue_key_maps(state)
    try:
        canonical = hloop_review_policy.resolve_issue_key_alias(value, aliases)
    except hloop_review_policy.ReviewPolicyError as exc:
        raise HLoopError(f"unknown follow-up: {value}: {exc}") from exc
    if canonical in issue_keys:
        return str(issue_keys[canonical])
    if value in issue_keys:
        return str(issue_keys[value])
    raise HLoopError(f"unknown follow-up: {value}")


def cmd_follow_up_list(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    records = _follow_up_records(repo, state)
    if getattr(args, "status", None):
        records = [record for record in records if record.get("status") == args.status]
    if getattr(args, "json", False):
        print(json.dumps(records, ensure_ascii=False, indent=2))
    else:
        for record in records:
            print(f"{record.get('id')}: {record.get('status')} {record.get('title')} [{record.get('issue_key')}]")
        if not records:
            print("no follow-ups")
    return 0


def cmd_follow_up_show(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    follow_up_id = resolve_follow_up_id(state, args.follow_up_id)
    path = _follow_up_artifact(repo, follow_up_id)
    if not path.is_file():
        raise HLoopError(f"follow-up artifact does not exist: {follow_up_id}")
    if getattr(args, "json", False):
        print(json.dumps(read_frontmatter(path), ensure_ascii=False, indent=2))
    else:
        print(read_text(path), end="")
    return 0


def cmd_follow_up_export(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    records = _follow_up_records(repo, state)
    output = Path(args.output) if args.output else repo / "docs" / f"{datetime.now(timezone.utc).date().isoformat()}-{slugify(str(state.get('goal_id') or 'release'), 40)}-follow-ups.md"
    if not output.is_absolute():
        output = repo / output
    try:
        output.resolve().relative_to(repo.resolve())
    except ValueError as exc:
        raise HLoopError("follow-up export path must remain inside the repository") from exc
    output.parent.mkdir(parents=True, exist_ok=True)
    lines = [f"# Follow-ups for {state.get('goal_id') or 'release'}", "", f"Generated: {now_iso()}", ""]
    if not records:
        lines.append("No follow-ups recorded.")
    for record in records:
        lines.extend(
            [
                f"## {record.get('id')}: {record.get('title')}",
                "",
                f"- Status: {record.get('status')}",
                f"- Issue key: `{record.get('issue_key')}`",
                f"- Component: {record.get('component')}",
                f"- Impact: {record.get('impact')}",
                f"- Reconsider: {record.get('reconsider_condition')}",
                "",
            ]
        )
    write_text(output, "\n".join(lines) + "\n")
    follow_ups = _follow_up_state(state)
    exports = normalize_list(follow_ups.get("export_paths"))
    ref = str(output.relative_to(repo))
    if ref not in exports:
        exports.append(ref)
    follow_ups["export_paths"] = exports
    save_state(repo, state)
    journal(repo, f"Exported {len(records)} follow-up(s) to `{ref}`.")
    payload = {"status": "exported", "artifact": str(output), "count": len(records)}
    print_policy_payload(payload, as_json=bool(getattr(args, "json", False)), label=f"follow-ups exported: {output}")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    if getattr(args, "raw_state", False):
        state = load_state(repo)
        print(json.dumps(state, ensure_ascii=False, indent=2))
        return 0
    inventory = collect_loop_inventory(
        repo,
        probe_panes=not getattr(args, "no_pane_probe", False),
        lines=getattr(args, "lines", 80),
        include_output=False,
    )
    if args.json:
        print(json.dumps(inventory, ensure_ascii=False, indent=2))
        return 0
    loop = inventory["loop"]
    counts = inventory["counts"]
    print(f"goal_id: {loop.get('goal_id')}")
    print(f"phase: {loop.get('phase')}")
    print(f"base: {loop.get('base_branch')} {loop.get('base_sha')}")
    print(f"integration: {loop.get('integration_branch')} {loop.get('integration_sha')}")
    print(f"current_branch: {loop.get('current_branch')}")
    print(f"branch_strategy: {loop.get('branch_strategy')}")
    print(f"worker_protocol: {loop.get('worker_protocol')}")
    print(f"review_protocol: {loop.get('review_protocol')}")
    print(f"worker_qa_profile: {loop.get('worker_qa_profile')}")
    print(f"manager_qa_profile: {loop.get('manager_qa_profile')}")
    print(f"manager_qa_status: {loop.get('manager_qa_status')}")
    print(f"release_scope_status: {loop.get('release_scope', {}).get('status')}")
    print(f"dispatch_freeze_status: {loop.get('dispatch_freeze', {}).get('status')}")
    print(f"current_batch_id: {loop.get('current_batch_id') or '-'}")
    print(
        "review_queue: "
        f"{loop.get('review_queue', {}).get('count')}/"
        f"{loop.get('review_queue', {}).get('threshold')}"
    )
    print(
        "gap_queue: "
        f"{loop.get('gap_queue', {}).get('count')}/"
        f"{loop.get('gap_queue', {}).get('threshold')}"
    )
    print(
        "agents: "
        f"workers {counts.get('workers_running')}/{counts.get('workers')} running, "
        f"reviewers {counts.get('reviewers_running')}/{counts.get('reviewers')} running, "
        f"gaps {counts.get('gaps_running')}/{counts.get('gaps')} running"
    )
    print(f"issues: {counts.get('issues')} ({counts.get('p0_p1_issues')} P0/P1)")
    for item in inventory["issues"][:10]:
        print(
            f"  {item.get('severity')} {item.get('subject')} "
            f"{item.get('code')}: {item.get('message')}"
        )
    return 0


def item_agent_status(item: dict[str, Any]) -> str:
    pane = item.get("pane", {})
    if not isinstance(pane, dict):
        return ""
    if pane.get("present"):
        return str(pane.get("agent_status") or "")
    reason = pane.get("reason")
    return f"pane:{reason}" if reason else ""


def item_artifact_state(item: dict[str, Any]) -> str:
    artifact = item.get("artifact", {})
    if not isinstance(artifact, dict):
        return ""
    state = str(artifact.get("state") or "")
    status = str(artifact.get("status") or artifact.get("artifact_status") or "")
    if item.get("role") in {"reviewer", "gap"}:
        status = str(item.get("artifact_status") or "")
    commit_state = str(artifact.get("commit_state") or "")
    if (
        item.get("role") == "worker"
        and item.get("status") == "merged"
        and state == "missing"
        and status
    ):
        state = "cleaned" if item.get("cleanup_done") else "state"
        if artifact.get("committed_path") and not commit_state:
            commit_state = "committed"
    parts = [part for part in [state, status, commit_state] if part]
    return "/".join(parts)


def print_agent_rows(title: str, items: list[dict[str, Any]]) -> None:
    print(title + ":")
    if not items:
        print("  none")
        return
    for item in items:
        agent_id = item.get("id")
        role = item.get("role")
        status = item.get("gate_status") or item.get("status")
        pane_id = item.get("pane", {}).get("pane_id", "")
        pane_status = item_agent_status(item)
        artifact = item_artifact_state(item)
        issue_count = len(item.get("issues", []))
        suffix = f" issues={issue_count}" if issue_count else ""
        print(
            f"  {agent_id}: {role} status={status} pane={pane_id or '-'} "
            f"agent={pane_status or '-'} artifact={artifact or '-'}{suffix}"
        )


def print_inventory_dashboard(inventory: dict[str, Any]) -> None:
    loop = inventory["loop"]
    counts = inventory["counts"]
    print(f"HLoop dashboard: {loop.get('goal_id')} phase={loop.get('phase')} cycle={loop.get('cycle')}")
    print(
        f"repo={inventory.get('repo')} current={loop.get('current_branch')} "
        f"integration={loop.get('integration_branch')}@{loop.get('integration_sha')}"
    )
    print(
        "queues: "
        f"review {loop.get('review_queue', {}).get('count')}/{loop.get('review_queue', {}).get('threshold')}, "
        f"gap {loop.get('gap_queue', {}).get('count')}/{loop.get('gap_queue', {}).get('threshold')}, "
        f"validation={'yes' if loop.get('needs_validation') else 'no'}"
    )
    print(f"batch: current={loop.get('current_batch_id') or '-'} total={counts.get('batches')}")
    print(
        "counts: "
        f"workers={counts.get('workers')} running={counts.get('workers_running')} "
        f"queued={counts.get('workers_queued')} merge_ready={counts.get('workers_merge_ready')}; "
        f"reviewers={counts.get('reviewers')} running={counts.get('reviewers_running')} reported={counts.get('reviewers_reported')}; "
        f"gaps={counts.get('gaps')} running={counts.get('gaps_running')} reported={counts.get('gaps_reported')}; "
        f"advisors={counts.get('advisors')} running={counts.get('advisors_running')} reported={counts.get('advisors_reported')}"
    )
    print_agent_rows("Workers", inventory["workers"])
    print_agent_rows("Reviewers", inventory["reviewers"])
    print_agent_rows("Gaps", inventory["gaps"])
    print_agent_rows("Advisors", inventory.get("advisors", []))
    print("Issues:")
    if not inventory["issues"]:
        print("  none")
    for item in inventory["issues"]:
        print(
            f"  {item.get('severity')} {item.get('subject')} "
            f"{item.get('code')}: {item.get('message')}"
        )
        if item.get("action"):
            print(f"    action: {item.get('action')}")
    if inventory.get("next_actions"):
        print("Next actions:")
        for action in inventory["next_actions"]:
            print(f"  - {action}")


def cmd_dashboard(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    inventory = collect_loop_inventory(
        repo,
        probe_panes=not args.no_pane_probe,
        lines=args.lines,
        include_output=args.include_output,
    )
    if args.json:
        print(json.dumps(inventory, ensure_ascii=False, indent=2))
        return 0
    print_inventory_dashboard(inventory)
    return 0


def cmd_conductor(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    inventory = collect_loop_inventory(
        repo,
        probe_panes=not args.no_pane_probe,
        lines=args.lines,
        include_output=args.include_output,
    )
    blocking = [
        item for item in inventory["issues"] if item.get("severity") in {"P0", "P1"}
    ]
    result = {
        "ok": not blocking,
        "blocking_issue_count": len(blocking),
        "issues": inventory["issues"],
        "next_actions": inventory["next_actions"],
        "inventory": inventory,
    }
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print(
            f"conductor: {'ok' if result['ok'] else 'attention'} "
            f"({len(inventory['issues'])} issue(s), {len(blocking)} P0/P1)"
        )
        if inventory["issues"]:
            print("issues:")
            for item in inventory["issues"]:
                print(
                    f"  {item.get('severity')} {item.get('subject')} "
                    f"{item.get('code')}: {item.get('message')}"
                )
                if item.get("action"):
                    print(f"    action: {item.get('action')}")
        if inventory["next_actions"]:
            print("next actions:")
            for action in inventory["next_actions"]:
                print(f"  - {action}")
    return 0 if args.no_fail or not blocking else 2


def validate_batch_id(batch_id: str) -> str:
    value = str(batch_id or "").strip()
    if not BATCH_ID_RE.fullmatch(value):
        raise HLoopError(f"invalid batch id: {batch_id}; expected BNNN")
    return value


def state_batches(state: dict[str, Any]) -> dict[str, Any]:
    batches = state.setdefault("batches", {})
    if not isinstance(batches, dict):
        raise HLoopError("STATE.json batches must be an object")
    return batches


def current_batch_id(state: dict[str, Any]) -> str:
    value = str(state.get("current_batch_id") or "")
    return validate_batch_id(value) if value else ""


def require_batch(state: dict[str, Any], batch_id: str) -> dict[str, Any]:
    batch_id = validate_batch_id(batch_id)
    batches = state_batches(state)
    batch = batches.get(batch_id)
    if not isinstance(batch, dict):
        raise HLoopError(f"unknown batch: {batch_id}")
    return batch


def batch_task_ids(state: dict[str, Any], batch_id: str) -> list[str]:
    batch = require_batch(state, batch_id)
    ids = list(normalize_list(batch.get("task_ids")))
    for task_id, task_state in state.get("tasks", {}).items():
        if isinstance(task_state, dict) and str(task_state.get("batch_id") or "") == batch_id:
            ids.append(task_id)
    return sorted(dict.fromkeys(ids))


def write_batch_artifact(repo: Path, state: dict[str, Any], batch_id: str) -> None:
    batch = require_batch(state, batch_id)
    task_ids = batch_task_ids(state, batch_id)
    batch["task_ids"] = task_ids
    performance = batch.get("performance") or batch.get("metrics") or {}
    if not isinstance(performance, Mapping):
        performance = {}
    effective_parallelism = performance.get("effective_parallelism")
    replan_requirement = batch.get("replan_requirement") or {}
    if not isinstance(replan_requirement, Mapping):
        replan_requirement = {}
    fields = {
        "id": batch_id,
        "title": str(batch.get("title") or batch_id),
        "status": str(batch.get("status") or "active"),
        "task_ids": task_ids,
        "started_at": str(batch.get("started_at") or batch.get("created_at") or ""),
        "closed_at": str(batch.get("closed_at") or ""),
        "checkpoint_mode": str(batch.get("checkpoint_mode") or "rollup"),
        "summary": str(batch.get("summary") or ""),
        "wall_time_seconds": performance.get("wall_time_seconds", 0.0),
        "worker_runtime_seconds": performance.get("worker_runtime_seconds", 0.0),
        "effective_parallelism": (
            effective_parallelism if effective_parallelism is not None else ""
        ),
        "longest_worker_seconds": performance.get("longest_worker_seconds", 0.0),
        "validation_time_seconds": performance.get("validation_time_seconds", 0.0),
        "review_wait_time_seconds": performance.get("review_wait_time_seconds", 0.0),
        "warnings": normalize_list(performance.get("warnings")),
        "replan_required": bool(performance.get("replan_required", False)),
        "replan_source_batch_id": str(replan_requirement.get("source_batch_id") or ""),
        "replan_warnings": normalize_list(replan_requirement.get("warnings")),
        "replan_acknowledged_by_batch_id": str(
            replan_requirement.get("acknowledged_by_batch_id") or ""
        ),
        "conflict_graph_digest": str(
            performance.get("conflict_graph_digest")
            or (batch.get("write_scope_conflict_graph") or {}).get("digest")
            or ""
        ),
    }
    task_lines = [f"- {task_id}" for task_id in task_ids] or ["- No tasks assigned."]
    body = f"""# Batch {batch_id}: {fields["title"]}

## Purpose
{fields["title"]}

## Tasks
{chr(10).join(task_lines)}

## Commit Policy
Use `hloop checkpoint --batch {batch_id} --rollup --message "ai-loop({batch_id}): ..."` for loop-state-only commits while this batch is active. Rollup may amend only an unpushed namespaced loop checkpoint commit for the same batch.

## Summary
{fields["summary"] or "TBD by Manager."}

## Performance
- Wall time: {fields["wall_time_seconds"]} seconds
- Worker runtime: {fields["worker_runtime_seconds"]} seconds
- Effective parallelism: {fields["effective_parallelism"]}
- Longest Worker: {fields["longest_worker_seconds"]} seconds
- Validation time: {fields["validation_time_seconds"]} seconds
- Review wait time: {fields["review_wait_time_seconds"]} seconds
- Replan required: {str(fields["replan_required"]).lower()}
- Replan source batch: {fields["replan_source_batch_id"] or "-"}
- Replan acknowledged by batch: {fields["replan_acknowledged_by_batch_id"] or "-"}
- Conflict graph digest: {fields["conflict_graph_digest"] or "-"}
{chr(10).join(f"- Warning: {warning}" for warning in fields["warnings"]) or "- Warnings: none"}
{chr(10).join(f"- Replan warning: {warning}" for warning in fields["replan_warnings"]) if fields["replan_warnings"] else ""}
"""
    write_text(batch_file(repo, batch_id), frontmatter(fields) + "\n" + body)


def assign_tasks_to_batch(repo: Path, state: dict[str, Any], batch_id: str, task_ids: list[str]) -> None:
    batch = require_batch(state, batch_id)
    tasks = state.setdefault("tasks", {})
    existing = set(normalize_list(batch.get("task_ids")))
    for task_id in task_ids:
        if task_id not in tasks:
            raise HLoopError(f"unknown task: {task_id}")
        task_state = tasks[task_id]
        if not isinstance(task_state, dict):
            raise HLoopError(f"task state must be an object: {task_id}")
        task_state["batch_id"] = batch_id
        task_path = task_file(repo, task_id)
        if task_path.exists():
            replace_frontmatter(task_path, {"batch_id": batch_id})
        existing.add(task_id)
    batch["task_ids"] = sorted(existing)


def cmd_batch_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    batches = state_batches(state)
    batch_id = validate_batch_id(args.id) if args.id else next_id("B", batches)
    if batch_id in batches:
        raise HLoopError(f"batch already exists: {batch_id}")
    now = now_iso()
    batches[batch_id] = {
        "title": args.title,
        "status": "active",
        "task_ids": [],
        "created_at": now,
        "started_at": now,
        "checkpoint_mode": "rollup",
    }
    batch = batches[batch_id]
    if args.task:
        assign_tasks_to_batch(repo, state, batch_id, args.task)
    replan = state.get("next_batch_replan")
    if isinstance(replan, Mapping) and normalize_bool(replan.get("required")):
        batch["replan_requirement"] = dict(replan)
        state["next_batch_replan"] = {
            **dict(replan),
            "required": False,
            "acknowledged_by_batch_id": batch_id,
            "acknowledged_at": now,
        }
    persist_write_scope_conflict_graph(state, batch_id=batch_id)
    if not args.no_current:
        state["current_batch_id"] = batch_id
    write_batch_artifact(repo, state, batch_id)
    save_state(repo, state)
    journal(repo, f"Started batch `{batch_id}`: {args.title}")
    print(f"started {batch_id}: {batch_file(repo, batch_id)}")
    return 0


def cmd_batch_assign(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    batch_id = validate_batch_id(args.batch_id)
    require_batch(state, batch_id)
    assign_tasks_to_batch(repo, state, batch_id, args.task_id)
    persist_write_scope_conflict_graph(state, batch_id=batch_id)
    write_batch_artifact(repo, state, batch_id)
    save_state(repo, state)
    journal(repo, f"Assigned tasks to batch `{batch_id}`: {', '.join(args.task_id)}")
    print(f"assigned {len(args.task_id)} task(s) to {batch_id}")
    return 0


def cmd_batch_close(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    batch_id = validate_batch_id(args.batch_id or current_batch_id(state))
    batch = require_batch(state, batch_id)
    batch["status"] = args.status
    closed_at = now_iso()
    batch["closed_at"] = closed_at
    batch["summary"] = args.summary
    if current_batch_id(state) == batch_id:
        state.pop("current_batch_id", None)
    persist_write_scope_conflict_graph(state, batch_id=batch_id)
    performance = _refresh_batch_performance(state, batch_id, closed_at=closed_at)
    if performance.get("replan_required"):
        state["next_batch_replan"] = {
            "required": True,
            "source_batch_id": batch_id,
            "warnings": list(performance.get("warnings") or []),
            "recorded_at": closed_at,
            "acknowledged_by_batch_id": "",
            "acknowledged_at": "",
        }
    write_batch_artifact(repo, state, batch_id)
    write_progress_artifact(repo, state)
    save_state(repo, state)
    journal(repo, f"Closed batch `{batch_id}` as `{args.status}`: {args.summary}")
    print(f"closed {batch_id}")
    return 0


def cmd_batch_list(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    current = current_batch_id(state)
    rows = []
    for batch_id, batch in sorted(state_batches(state).items()):
        if not isinstance(batch, dict):
            continue
        rows.append(
            {
                "id": batch_id,
                "status": batch.get("status", ""),
                "title": batch.get("title", ""),
                "task_ids": batch_task_ids(state, batch_id),
                "current": batch_id == current,
            }
        )
    if args.json:
        print(json.dumps({"current_batch_id": current, "batches": rows}, ensure_ascii=False, indent=2))
        return 0
    if not rows:
        print("no batches")
        return 0
    for row in rows:
        marker = "*" if row["current"] else " "
        tasks = ",".join(row["task_ids"]) or "-"
        print(f"{marker} {row['id']} {row['status']} tasks={tasks} {row['title']}")
    return 0


def cmd_batch_show(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    batch_id = validate_batch_id(args.batch_id or current_batch_id(state))
    batch = require_batch(state, batch_id)
    payload = {
        "id": batch_id,
        "current": current_batch_id(state) == batch_id,
        "artifact": str(batch_file(repo, batch_id)),
        "state": batch,
        "task_ids": batch_task_ids(state, batch_id),
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0
    print(f"{batch_id}: {batch.get('status', '')} {batch.get('title', '')}")
    print(f"artifact: {payload['artifact']}")
    print(f"current: {'yes' if payload['current'] else 'no'}")
    print("tasks: " + (", ".join(payload["task_ids"]) or "-"))
    if batch.get("summary"):
        print(f"summary: {batch.get('summary')}")
    return 0


def require_decision(state: dict[str, Any], decision_id: str) -> DecisionRecord:
    raw = state.setdefault("decisions", {}).get(decision_id)
    if raw is None:
        raise HLoopError(f"unknown decision: {decision_id}")
    try:
        return DecisionRecord.from_record(raw)
    except DecisionValidationError as exc:
        raise HLoopError(f"invalid decision record {decision_id}: {exc}") from exc


def decision_question_text(record: DecisionRecord, state: dict[str, Any]) -> str:
    option_lines: list[str] = []
    for index, option in enumerate(record.options, 1):
        option_lines.extend(
            [
                f"{index}. {option.label}",
                *[f"   - 利点・注意点: {tradeoff}" for tradeoff in option.tradeoffs],
            ]
        )
    recommended = next(
        item.label
        for item in record.options
        if item.option_id == record.recommendation.option_id
    )
    blocked = set(build_decision_scheduler(state).decision_blocked_task_ids)
    queued = {
        task_id
        for task_id, task in (state.get("tasks") or {}).items()
        if str(task.get("status") or "") == "queued"
    }
    independent = sorted(queued - blocked)
    if independent:
        later = (
            "この判断に依存しない作業は継続できます。"
            f" 現在は {len(independent)} 件の独立した作業を進められます。"
        )
    else:
        later = "安全に進められる独立作業がなくなるため、回答を待ちます。"
    reason = {
        DECISION_ADVISORY: "元の仕様を変えない範囲の選択ですが、理由を残す必要があります。",
        DECISION_DEFERRED_USER: "影響する作業だけを保留し、その他の作業を安全に続けるためです。",
        DECISION_BLOCKING_USER: "影響する作業を推測で進めず、安全な範囲を確定するためです。",
    }[record.decision_class]
    return "\n".join(
        [
            "# 判断のお願い",
            "",
            "## 何が決まっていないか",
            "",
            record.question,
            "",
            "## 今決める必要がある理由",
            "",
            reason,
            "",
            "## 選択肢",
            "",
            *option_lines,
            "",
            "## 推奨案",
            "",
            f"{recommended} — {record.recommendation.rationale}",
            "",
            "## 判断を後回しにした場合",
            "",
            later,
            "",
            "## 回答方法",
            "",
            "上の選択肢を選ぶか、希望する進め方を自由入力で伝えてください。",
            "",
        ]
    )


SPECIFICATION_RISK_MARKERS = (
    "user-visible",
    "public contract",
    "security",
    "authorization",
    "privacy",
    "credential",
    "data",
    "schema",
    "migration",
    "rollback",
    "breaking",
    "利用者",
    "公開",
    "認証",
    "認可",
    "秘密",
    "データ",
    "スキーマ",
    "移行",
    "破壊",
    "ロールバック",
)


def specification_scout_reasons(state: dict[str, Any]) -> list[str]:
    """Return stable reasons for ``auto`` Scout dispatch."""

    requirements = state.get("requirements") or {}
    implementation_tasks = [
        task
        for task in (state.get("tasks") or {}).values()
        if str(task.get("kind") or "implementation") in {"implementation", "fix"}
        and str(task.get("status") or "") == "queued"
    ]
    if not implementation_tasks:
        return []
    reasons: list[str] = []
    if len(requirements) > 1:
        reasons.append("multiple accepted requirements may interact")
    text_parts = [str(state.get("goal") or state.get("goal_id") or "")]
    for requirement in requirements.values():
        if isinstance(requirement, dict):
            text_parts.extend(normalize_list(requirement.get("acceptance")))
            if normalize_list(requirement.get("dependencies")):
                reasons.append("accepted requirements have dependencies")
    for task in implementation_tasks:
        text_parts.append(str(task.get("title") or ""))
        text_parts.extend(normalize_list(task.get("acceptance")))
        text_parts.append(str(task.get("validation_minimum") or ""))
    searchable = "\n".join(text_parts).lower()
    for marker in SPECIFICATION_RISK_MARKERS:
        if marker.lower() in searchable:
            reasons.append(f"specification-risk marker: {marker}")
    return list(dict.fromkeys(reasons))


def specification_scout_required(state: dict[str, Any]) -> tuple[bool, list[str]]:
    policy = str(state.get("specification_scout") or DEFAULT_SPECIFICATION_SCOUT)
    if policy not in SPECIFICATION_SCOUT_MODES:
        raise HLoopError(f"invalid specification_scout policy: {policy}")
    run = state.get("specification_scout_run") or {}
    if str(run.get("status") or "") in {"completed", "skipped"}:
        return False, []
    if policy == "off":
        return False, ["policy is off"]
    implementation_queued = any(
        str(task.get("status") or "") == "queued"
        and str(task.get("kind") or "implementation") in {"implementation", "fix"}
        for task in (state.get("tasks") or {}).values()
    )
    if not implementation_queued:
        return False, []
    if policy == "always":
        return True, ["policy is always"]
    reasons = specification_scout_reasons(state)
    return bool(reasons), reasons


def specification_scout_file(repo: Path) -> Path:
    return loop_path(repo) / "decisions" / "SCOUT.md"


def decision_liaison_file(repo: Path, decision_id: str) -> Path:
    return loop_path(repo) / "decisions" / decision_id / "RESPONSE.md"


def render_specification_scout_prompt(
    state: dict[str, Any],
    *,
    head_sha: str,
    reasons: list[str],
    report_credential_file: str = "",
    task_contract_digest: str = "",
    attempt_id: str = "S001-A001",
) -> str:
    reason_lines = "\n".join(f"- {reason}" for reason in reasons) or "- Manager requested it."
    artifact = (LOOP_DIR / "decisions" / "SCOUT.md").as_posix()
    return f"""You are the Specification Scout for herdr-dev-loop {SKILL_VERSION}.

Inspect MISSION.md, PLAN.md, PROFILE.md, DECISIONS.md, accepted requirements,
queued implementation tasks, and repository evidence at `{head_sha}`. Do not
edit product code and do not decide user-visible specifications yourself.

The automatic trigger reasons were:
{reason_lines}

{report_contract_text("S001", attempt_id, state, report_credential_file=report_credential_file, task_contract_digest=task_contract_digest)}

Write only `{artifact}` with frontmatter containing `status: reported`,
`role_id: S001`, `attempt_id: {attempt_id}`, `skill_version: {SKILL_VERSION}`,
`head_sha: {head_sha}`, and `run_id: {state.get('run_id', '')}`. In the body,
report unresolved questions, why each decision is needed, affected requirement
or task candidates, two or three options with tradeoffs and rollback cost,
the repository-supported recommendation, safe work that can continue, and the
cost of delaying the decision. If no decision is needed, state that clearly.

Finish with `HERDR_LOOP_SCOUT_DONE:{state.get('run_id', '')}:S001:reported`.
"""


def render_decision_liaison_prompt(
    record: DecisionRecord,
    state: dict[str, Any],
    *,
    head_sha: str,
    report_credential_file: str = "",
    task_contract_digest: str = "",
    attempt_id: str = "",
) -> str:
    question = decision_question_text(record, state)
    artifact = (LOOP_DIR / "decisions" / record.decision_id / "RESPONSE.md").as_posix()
    return f"""あなたは Decision Liaison です。仕様を決めるのではなく、利用者が
判断できるよう、次の質問を平易な日本語で説明し、明示的な回答を受け取ってください。

利用者向け本文に decision ID、task ID、state machine 用語、論理式を出さないでください。
二つか三つの選択肢、利点と欠点、推奨案と根拠、後回しにした場合に進められる範囲、
自由入力できることを示してください。

Manager が semantic ACK を承認した後の最初の利用者向け turn では、質問、選択肢、
推奨案を提示するだけで応答を終えてください。その turn では `{artifact}` を作成せず、
completion report も完了 sentinel も送らないでください。提示した推奨案は利用者の同意では
ありません。同じ pane への次の明示的な利用者入力を待ってください。

semantic ACK の承認、あなた自身が提示した推奨案、無応答、system/developer/tool の出力、
および `Manager message id:` で始まる Manager message は利用者の回答ではありません。
これらを option 選択や自由記述として推測・補完してはいけません。質問提示後の同じ pane に
利用者が直接入力した option 選択または自由記述だけを回答として扱ってください。

{question}

{report_contract_text(f"L-{record.decision_id}", attempt_id, state, report_credential_file=report_credential_file, task_contract_digest=task_contract_digest)}

質問提示後の明示的な利用者入力を得た場合に限り `{artifact}` だけを書き、frontmatter に
`decision_id: {record.decision_id}`、`responded_by: liaison`、
`responded_at`、`attempt_id: {attempt_id}`、`run_id: {state.get('run_id', '')}`、
`skill_version: {SKILL_VERSION}`、`head_sha: {head_sha}`、
`response_source: explicit-user-input`、`response_channel: same-pane`、
`response_turn: after-question`、`user_input_received_at`、および
`user_input_kind: option` または `user_input_kind: free-text` を記録してください。
利用者が選択肢を明示した場合だけ `selected_option` を記録してください。選択肢を明示して
いない自由記述から、推奨 option を補完してはいけません。本文は `# 回答` の下に、
質問提示後に利用者が入力した option 選択または自由記述だけを日本語で記録してください。
対象 SHA は `{head_sha}` です。

有効な利用者入力を記録した後でのみ completion report を送り、
`HERDR_LOOP_LIAISON_DONE:{state.get('run_id', '')}:{record.decision_id}:responded`
を表示してください。それ以前は同じ pane で待機してください。
"""


def decision_attention_notice(
    repo: Path, state: dict[str, Any], record: DecisionRecord
) -> None:
    """Notify Manager once when a canonical user-decision question is created.

    The state record is persisted before calling Herdr so a retry after a crash
    cannot emit a duplicate tab notification. An interrupted or failed delivery
    remains auditable and the plain-language question is printed as the Manager
    fallback.
    """

    if not (
        record.unresolved
        and record.decision_class in hloop_decisions.USER_DECISION_CLASSES
    ):
        return
    notices = state.setdefault("decision_attention", {})
    previous = notices.get(record.decision_id)
    if isinstance(previous, dict):
        if previous.get("status") == "dispatching":
            previous["status"] = "unknown"
            previous["fallback_at"] = now_iso()
            previous["fallback_reason"] = (
                "previous notification delivery was interrupted and is intentionally not retried"
            )
            print(
                f"HERDR_LOOP_DECISION_ATTENTION_FALLBACK:{state.get('run_id', '')}:"
                f"{record.decision_id}"
            )
            print(decision_question_text(record, state).rstrip())
            save_state(repo, state)
        return

    question_rel = (
        LOOP_DIR / "decisions" / record.decision_id / "QUESTION.md"
    ).as_posix()
    manager_notice = (
        f"HERDR_LOOP_DECISION_ATTENTION:{state.get('run_id', '')}:"
        f"{record.decision_id}:{question_rel}"
    )
    notice = {
        "decision_id": record.decision_id,
        "status": "dispatching",
        "question_path": question_rel,
        "manager_notice": manager_notice,
        "attempted_at": now_iso(),
    }
    notices[record.decision_id] = notice
    save_state(repo, state)
    print(manager_notice)
    try:
        if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
            raise HLoopError("Herdr notification is unavailable")
        run_cmd(
            [
                "herdr",
                "notification",
                "show",
                f"HLoop decision {record.decision_id}",
                "--body",
                record.question,
                "--sound",
                "request",
            ],
            check=True,
            capture=True,
        )
        notice["status"] = "notified"
        notice["notified_at"] = now_iso()
        notice["herdr_tab_attention"] = True
    except (HLoopError, OSError, subprocess.CalledProcessError) as exc:
        notice["status"] = "manager-fallback"
        notice["fallback_at"] = now_iso()
        notice["fallback_reason"] = command_error_detail(exc)
        notice["herdr_tab_attention"] = False
        print(
            f"HERDR_LOOP_DECISION_ATTENTION_FALLBACK:{state.get('run_id', '')}:"
            f"{record.decision_id}"
        )
        print(decision_question_text(record, state).rstrip())
    state.setdefault("decision_attention_events", []).append(dict(notice))
    save_state(repo, state)


def write_decision_artifacts(repo: Path, state: dict[str, Any]) -> None:
    """Refresh canonical decision questions, responses, and Manager fallback."""

    records = decision_records_from_state(state)
    for decision_id, record in records.items():
        directory = loop_path(repo) / "decisions" / decision_id
        directory.mkdir(parents=True, exist_ok=True)
        question_fields = {
            "decision_id": decision_id,
            "class": record.decision_class,
            "status": record.status,
            "affected_task_ids": list(record.affected_task_ids),
            "source_findings": list(record.source_findings),
        }
        write_text(
            directory / "QUESTION.md",
            frontmatter(question_fields)
            + "\n"
            + decision_question_text(record, state),
        )
        decision_attention_notice(repo, state, record)
        if record.response is not None:
            response_fields = {
                "decision_id": decision_id,
                "responded_by": record.response.responded_by,
                "responded_at": record.response.responded_at,
            }
            if record.response.selected_option:
                response_fields["selected_option"] = record.response.selected_option
            liaison = (state.get("decision_liaisons") or {}).get(decision_id) or {}
            provenance = liaison.get("response_provenance") or {}
            if isinstance(provenance, dict):
                for field in (
                    "attempt_id",
                    "run_id",
                    "skill_version",
                    "head_sha",
                    "response_source",
                    "response_channel",
                    "response_turn",
                    "user_input_received_at",
                    "user_input_kind",
                ):
                    value = provenance.get(field)
                    if value:
                        response_fields[field] = value
            response_body = record.response.free_text or "選択肢を回答済みです。"
            write_text(
                directory / "RESPONSE.md",
                frontmatter(response_fields) + "\n# 回答\n\n" + response_body + "\n",
            )

    sections: dict[str, list[DecisionRecord]] = {
        "Pending Decisions": [],
        "Accepted Decisions": [],
        "Rejected Decisions": [],
        "Superseded Decisions": [],
    }
    for record in records.values():
        if record.status in {DECISION_PENDING, DECISION_ANSWERED}:
            sections["Pending Decisions"].append(record)
        elif record.status == DECISION_ACCEPTED:
            sections["Accepted Decisions"].append(record)
        elif record.status == DECISION_REJECTED:
            sections["Rejected Decisions"].append(record)
        else:
            sections["Superseded Decisions"].append(record)
    ledger = [
        "# Decisions",
        "",
        "Manager-owned record for specification choices and their scoped effects.",
        "",
    ]
    for heading, items in sections.items():
        ledger.extend([f"## {heading}", ""])
        if not items:
            ledger.extend(["None.", ""])
            continue
        for record in sorted(items, key=lambda item: item.decision_id):
            ledger.append(
                f"- `{record.decision_id}` [{record.decision_class}/{record.status}] "
                f"{record.question} (affects: {', '.join(record.affected_task_ids) or '-'})"
            )
        ledger.append("")
    write_text(loop_path(repo) / "DECISIONS.md", "\n".join(ledger))

    pending_user = [
        record
        for record in records.values()
        if record.unresolved and record.decision_class in hloop_decisions.USER_DECISION_CLASSES
    ]
    action_lines = ["# User Action Required", ""]
    if not pending_user:
        action_lines.append("利用者の判断待ちはありません。\n")
    else:
        action_lines.extend(
            [
                "次の判断を待っています。判断に依存しない作業は引き続き進めます。",
                "",
            ]
        )
        for record in sorted(pending_user, key=lambda item: item.decision_id):
            action_lines.extend(
                [
                    f"## {record.question}",
                    "",
                    f"詳しい選択肢: `decisions/{record.decision_id}/QUESTION.md`",
                    "",
                ]
            )
    write_text(loop_path(repo) / "USER_ACTION_REQUIRED.md", "\n".join(action_lines))

    state["decision_liaison"] = {
        "mode": "manager-fallback",
        "status": "waiting" if pending_user else "idle",
        "pending_decision_ids": [record.decision_id for record in pending_user],
        "updated_at": now_iso(),
    }


def default_decision_role_worktree(
    repo: Path, state: dict[str, Any], role_id: str, suffix: str
) -> Path:
    return configured_worktree_path(
        repo,
        state,
        role_id,
        f"{repo.name}.{slugify(role_id, 32)}-{suffix}",
    )


def next_decision_role_attempt(
    role_id: str, role_state: dict[str, Any]
) -> tuple[int, str]:
    attempt_no = normalize_int(role_state.get("attempt_no"), 0) + 1
    return attempt_no, f"{role_id}-A{attempt_no:03d}"


def cleanup_decision_role_worktree(
    repo: Path,
    role_id: str,
    role_state: dict[str, Any],
    *,
    prompt_suffix: str,
    best_effort: bool = False,
) -> None:
    worktree_raw = str(role_state.get("worktree") or "")
    if not worktree_raw:
        return
    worktree = Path(worktree_raw).resolve()
    if not worktree.exists() or role_state.get("worktree_cleaned_at"):
        return
    try:
        cleanup_hloop_prompt_file(worktree, role_id, prompt_suffix)
        git(repo, ["worktree", "remove", "--force", str(worktree)])
    except (HLoopError, subprocess.CalledProcessError) as exc:
        if best_effort:
            record_worktree_cleanup_failure(repo, role_state, role_id, exc)
            return
        raise
    role_state["worktree_cleanup_status"] = "removed"
    role_state["worktree_cleaned_at"] = now_iso()


def decision_role_fallback(
    repo: Path,
    state: dict[str, Any],
    role_state: dict[str, Any],
    *,
    role_label: str,
    reason: str,
    user_text: str,
) -> int:
    role_state.update(
        {
            "mode": "manager-fallback",
            "status": "waiting-manager",
            "gate_status": "waiting-manager",
            "fallback_reason": reason,
            "fallback_at": now_iso(),
        }
    )
    save_state(repo, state)
    journal(repo, f"{role_label} pane fallback activated: {reason}")
    print(f"{role_label} paneを開始できないため、Manager経由で続行します。")
    print(user_text.rstrip())
    return 0


def cmd_specification_scout_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    required, reasons = specification_scout_required(state)
    policy = str(state.get("specification_scout") or DEFAULT_SPECIFICATION_SCOUT)
    run = state.setdefault("specification_scout_run", {})
    if str(run.get("status") or "") in {"running", "reported", "completed"}:
        raise HLoopError(f"Specification Scout is already {run.get('status')}")
    if not required and not getattr(args, "force", False):
        run.update(
            {
                "status": "skipped",
                "gate_status": "skipped",
                "policy": policy,
                "reasons": reasons,
                "completed_at": now_iso(),
            }
        )
        save_state(repo, state)
        print("Specification Scout skipped: " + (", ".join(reasons) or "no auto trigger"))
        return 0
    if not reasons:
        reasons = ["Manager forced the Scout"]
    dispatch_start_preflight(repo, state, role_id="S001", role_kind="specification-scout")
    head_sha = git(repo, ["rev-parse", str(state["integration_branch"])])
    worktree_arg = getattr(args, "worktree", None)
    worktree = (
        Path(worktree_arg).resolve()
        if worktree_arg
        else default_decision_role_worktree(repo, state, "S001", "scout")
    )
    prompt_rel = LOOP_DIR / "prompts" / "S001.scout.md"
    artifact_rel = LOOP_DIR / "decisions" / "SCOUT.md"
    prompt = render_specification_scout_prompt(state, head_sha=head_sha, reasons=reasons)
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        return decision_role_fallback(
            repo,
            state,
            run,
            role_label="Specification Scout",
            reason="Herdr pane is unavailable",
            user_text=prompt,
        )
    role_id = "S001"
    attempt_no, attempt_id = next_decision_role_attempt(role_id, run)
    prompt_without_identity = render_specification_scout_prompt(
        state, head_sha=head_sha, reasons=reasons, attempt_id=attempt_id
    )
    task_contract_digest = prompt_contract_digest(prompt_without_identity)
    runner = getattr(args, "runner", None) or "tui"
    agent_config = role_agent_config(
        state,
        "advisor",
        overrides={
            "agent_provider": getattr(args, "agent_provider", None),
            "agent_model": getattr(args, "agent_model", None),
        },
    )
    command_text, invocation = role_agent_command(
        repo,
        agent_config,
        runner=runner,
        prompt_rel=prompt_rel,
        cwd=worktree,
        role_id=role_id,
        attempt_id=attempt_id,
        output_rel=artifact_rel if runner == "exec" else None,
    )
    command = f"cd {shlex.quote(str(worktree))} && {command_text}"
    worktree_preexisting = worktree.exists()
    try:
        if not worktree_preexisting:
            git(repo, ["worktree", "add", "--detach", str(worktree), head_sha])
        prepare_role_worktree(repo, worktree, state, role="advisor", agent_id=role_id)
        ensure_advisor_visible_in_worktree(worktree)
        ensure_worktree_parent_dirs(worktree, prompt_rel, artifact_rel)
        report_credential_file, initial_ack_floor = register_role_report_identity_and_ack_floor(
            repo,
            state,
            role_id=role_id,
            attempt_id=attempt_id,
            task_contract_digest=task_contract_digest,
        )
        prompt = render_specification_scout_prompt(
            state,
            head_sha=head_sha,
            reasons=reasons,
            report_credential_file=str(report_credential_file),
            task_contract_digest=task_contract_digest,
            attempt_id=attempt_id,
        )
        write_text(worktree / prompt_rel, prompt)
        baseline = role_scope_paths(worktree)
        if getattr(args, "launcher", "pane") == "agent":
            pane_id = start_agent_launcher(
                name=f"hloop-{state['goal_id']}-specification-scout",
                direction=getattr(args, "direction", "right"),
                cwd=worktree,
                command=command,
            )
        else:
            pane_id = start_pane_launcher(
                manager_pane=getattr(args, "manager_pane", None) or current_pane_id(),
                direction=getattr(args, "direction", "right"),
                cwd=worktree,
                command=command,
            )
    except (
        HLoopError,
        hloop_broker.BrokerStorageError,
        OSError,
        subprocess.CalledProcessError,
    ) as exc:
        try:
            rollback_failed_role_start(
                repo, worktree, created_worktree=not worktree_preexisting
            )
        finally:
            revoke_active_role_report_identity(repo, state, role_id)
        return decision_role_fallback(
            repo,
            state,
            run,
            role_label="Specification Scout",
            reason=command_error_detail(exc),
            user_text=prompt,
        )
    run.update(
        {
            "role_id": role_id,
            "status": "running",
            "gate_status": "running",
            "mode": "agent-pane",
            "policy": policy,
            "reasons": reasons,
            "head_sha": head_sha,
            "pane_id": pane_id,
            "worktree": str(worktree),
            "prompt": str(worktree / prompt_rel),
            "artifact_path": str(specification_scout_file(repo)),
            "worktree_artifact_path": str(worktree / artifact_rel),
            "baseline_dirty_files": baseline,
            "agent_provider": agent_config["provider"],
            "agent_model": agent_config["model"],
            "attempt_no": attempt_no,
            "attempt_id": attempt_id,
            "skill_version": SKILL_VERSION,
            "task_contract_digest": task_contract_digest,
            "runner": runner,
            "provider_invocation": invocation.as_record(),
            "started_at": now_iso(),
        }
    )
    arm_initial_semantic_ack_barrier(
        run,
        attempt_id=attempt_id,
        contract_digest=task_contract_digest,
        required_reack_after_sequence=initial_ack_floor,
    )
    state["phase"] = "specification_scout"
    save_state(repo, state)
    journal(repo, f"Started Specification Scout in pane `{pane_id}` at `{head_sha}`.")
    print(f"started Specification Scout in pane {pane_id}")
    return 0


def validate_decision_role_scope(
    worktree: Path,
    role_state: dict[str, Any],
    *,
    allowed: set[str],
) -> list[str]:
    baseline = set(normalize_list(role_state.get("baseline_dirty_files")))
    return [
        path
        for path in role_scope_paths(worktree)
        if path not in baseline and path not in allowed
    ]


def decision_role_artifact_identity_error(
    state: dict[str, Any],
    *,
    role_id: str,
    role_state: dict[str, Any],
    meta: dict[str, Any],
    decision_id: str = "",
) -> str:
    if decision_id:
        if str(meta.get("decision_id") or "") != decision_id:
            return "decision_id mismatch"
    elif str(meta.get("role_id") or "") != role_id:
        return "role_id mismatch"
    expected = {
        "run_id": str(state.get("run_id") or ""),
        "skill_version": str(role_state.get("skill_version") or SKILL_VERSION),
        "attempt_id": str(role_state.get("attempt_id") or ""),
        "head_sha": str(role_state.get("head_sha") or ""),
    }
    for field, value in expected.items():
        if value and str(meta.get(field) or "") != value:
            return f"{field} mismatch"
    return ""


def cmd_specification_scout_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    run = state.get("specification_scout_run") or {}
    if str(run.get("status") or "") != "running":
        raise HLoopError("Specification Scout is not running")
    block_reason = semantic_ack_barrier_blocking(run)
    if block_reason:
        raise HLoopError(f"cannot harvest S001: {block_reason}")
    worktree = Path(str(run.get("worktree") or "")).resolve()
    source = worktree / LOOP_DIR / "decisions" / "SCOUT.md"
    if not source.is_file() or not read_text(source).strip():
        raise HLoopError(f"Specification Scout artifact is missing: {source}")
    identity_error = decision_role_artifact_identity_error(
        state,
        role_id="S001",
        role_state=run,
        meta=read_frontmatter(source),
    )
    if identity_error:
        raise HLoopError(
            f"stale or mismatched Specification Scout artifact: {identity_error}: {source}"
        )
    violations = validate_decision_role_scope(
        worktree,
        run,
        allowed={
            (LOOP_DIR / "decisions" / "SCOUT.md").as_posix(),
            (LOOP_DIR / "prompts" / "S001.scout.md").as_posix(),
        },
    )
    if violations:
        raise HLoopError(
            "Specification Scout changed files outside its artifact: "
            + ", ".join(violations)
        )
    destination = specification_scout_file(repo)
    write_text(destination, read_text(source))
    run.update(
        {
            "status": "reported",
            "gate_status": "reported",
            "artifact_path": str(destination),
            "worktree_artifact_path_harvested": str(source),
            "harvested_at": now_iso(),
        }
    )
    cleanup_completed_agent_pane(
        repo,
        run,
        label="Specification Scout",
        session_cleanup=session_cleanup_mode(args, state),
    )
    cleanup_decision_role_worktree(
        repo, "S001", run, prompt_suffix="scout", best_effort=True
    )
    revoke_active_role_report_identity(repo, state, "S001")
    save_state(repo, state)
    journal(repo, "Harvested Specification Scout; Manager decision triage is required.")
    print(f"harvested Specification Scout: {destination}")
    return 0


def cmd_specification_scout_close(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    run = state.get("specification_scout_run") or {}
    block_reason = semantic_ack_barrier_blocking(run)
    if str(run.get("status") or "") == "running" and block_reason:
        raise HLoopError(f"cannot close S001: {block_reason}")
    if str(run.get("status") or "") not in {"reported", "waiting-manager"}:
        raise HLoopError("Specification Scout is not ready to close")
    run.update(
        {
            "status": "completed",
            "gate_status": "completed",
            "verdict": args.verdict,
            "triage_reason": args.reason,
            "completed_at": now_iso(),
        }
    )
    state["phase"] = "blocked_user_decision" if args.verdict == "blocked" else "dispatching"
    revoke_active_role_report_identity(repo, state, "S001")
    save_state(repo, state)
    journal(repo, f"Closed Specification Scout as `{args.verdict}`: {args.reason}")
    print(f"closed Specification Scout: {args.verdict}")
    return 0


def start_decision_liaison(
    repo: Path,
    state: dict[str, Any],
    record: DecisionRecord,
    args: argparse.Namespace,
) -> int:
    liaisons = state.setdefault("decision_liaisons", {})
    liaison = liaisons.setdefault(record.decision_id, {})
    if str(liaison.get("status") or "") in {"running", "responded", "completed"}:
        print(f"Decision Liaison already {liaison.get('status')}: {record.decision_id}")
        return 0
    dispatch_start_preflight(
        repo,
        state,
        role_id=f"L-{record.decision_id}",
        role_kind="decision-liaison",
    )
    head_sha = git(repo, ["rev-parse", str(state["integration_branch"])])
    prompt = render_decision_liaison_prompt(record, state, head_sha=head_sha)
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        return decision_role_fallback(
            repo,
            state,
            liaison,
            role_label="Decision Liaison",
            reason="Herdr pane is unavailable",
            user_text=decision_question_text(record, state),
        )
    role_id = f"L-{record.decision_id}"
    attempt_no, attempt_id = next_decision_role_attempt(role_id, liaison)
    worktree_arg = getattr(args, "worktree", None)
    worktree = (
        Path(worktree_arg).resolve()
        if worktree_arg
        else default_decision_role_worktree(repo, state, role_id, "liaison")
    )
    prompt_rel = LOOP_DIR / "prompts" / f"{role_id}.liaison.md"
    artifact_rel = LOOP_DIR / "decisions" / record.decision_id / "RESPONSE.md"
    prompt_without_identity = render_decision_liaison_prompt(
        record, state, head_sha=head_sha, attempt_id=attempt_id
    )
    task_contract_digest = prompt_contract_digest(prompt_without_identity)
    agent_config = role_agent_config(
        state,
        "advisor",
        overrides={
            "agent_provider": getattr(args, "agent_provider", None),
            "agent_model": getattr(args, "agent_model", None),
        },
    )
    command_text, invocation = role_agent_command(
        repo,
        agent_config,
        runner="tui",
        prompt_rel=prompt_rel,
        cwd=worktree,
        role_id=role_id,
        attempt_id=attempt_id,
    )
    command = f"cd {shlex.quote(str(worktree))} && {command_text}"
    worktree_preexisting = worktree.exists()
    try:
        if not worktree_preexisting:
            git(repo, ["worktree", "add", "--detach", str(worktree), head_sha])
        prepare_role_worktree(repo, worktree, state, role="advisor", agent_id=role_id)
        ensure_advisor_visible_in_worktree(worktree)
        ensure_worktree_parent_dirs(worktree, prompt_rel, artifact_rel)
        report_credential_file, initial_ack_floor = register_role_report_identity_and_ack_floor(
            repo,
            state,
            role_id=role_id,
            attempt_id=attempt_id,
            task_contract_digest=task_contract_digest,
        )
        prompt = render_decision_liaison_prompt(
            record,
            state,
            head_sha=head_sha,
            report_credential_file=str(report_credential_file),
            task_contract_digest=task_contract_digest,
            attempt_id=attempt_id,
        )
        write_text(worktree / prompt_rel, prompt)
        baseline = role_scope_paths(worktree)
        if getattr(args, "launcher", "pane") == "agent":
            pane_id = start_agent_launcher(
                name=f"hloop-{state['goal_id']}-{role_id}-liaison",
                direction=getattr(args, "direction", "right"),
                cwd=worktree,
                command=command,
            )
        else:
            pane_id = start_pane_launcher(
                manager_pane=getattr(args, "manager_pane", None) or current_pane_id(),
                direction=getattr(args, "direction", "right"),
                cwd=worktree,
                command=command,
            )
    except (
        HLoopError,
        hloop_broker.BrokerStorageError,
        OSError,
        subprocess.CalledProcessError,
    ) as exc:
        try:
            rollback_failed_role_start(
                repo, worktree, created_worktree=not worktree_preexisting
            )
        finally:
            revoke_active_role_report_identity(repo, state, role_id)
        return decision_role_fallback(
            repo,
            state,
            liaison,
            role_label="Decision Liaison",
            reason=command_error_detail(exc),
            user_text=decision_question_text(record, state),
        )
    liaison.update(
        {
            "role_id": role_id,
            "decision_id": record.decision_id,
            "status": "running",
            "gate_status": "running",
            "mode": "agent-pane",
            "head_sha": head_sha,
            "pane_id": pane_id,
            "worktree": str(worktree),
            "prompt": str(worktree / prompt_rel),
            "response_path": str(decision_liaison_file(repo, record.decision_id)),
            "worktree_response_path": str(worktree / artifact_rel),
            "baseline_dirty_files": baseline,
            "agent_provider": agent_config["provider"],
            "agent_model": agent_config["model"],
            "attempt_no": attempt_no,
            "attempt_id": attempt_id,
            "skill_version": SKILL_VERSION,
            "task_contract_digest": task_contract_digest,
            "provider_invocation": invocation.as_record(),
            "started_at": now_iso(),
        }
    )
    arm_initial_semantic_ack_barrier(
        liaison,
        attempt_id=attempt_id,
        contract_digest=task_contract_digest,
        required_reack_after_sequence=initial_ack_floor,
    )
    save_state(repo, state)
    journal(repo, f"Started Decision Liaison for `{record.decision_id}` in pane `{pane_id}`.")
    print(f"started Decision Liaison for {record.decision_id} in pane {pane_id}")
    return 0


def cmd_decision_liaison_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    record = require_decision(state, args.id)
    if record.decision_class not in hloop_decisions.USER_DECISION_CLASSES:
        raise HLoopError("Decision Liaison is only for user decision classes")
    return start_decision_liaison(repo, state, record, args)


def markdown_body_after_frontmatter(text: str) -> str:
    if not text.startswith("---\n"):
        return text.strip()
    marker = text.find("\n---\n", 4)
    return text[marker + 5 :].strip() if marker >= 0 else ""


def parse_liaison_response_timestamp(value: Any) -> datetime | None:
    text = str(value or "").strip()
    if not text:
        return None
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        return None
    return parsed


def decision_liaison_response_provenance_error(meta: dict[str, Any]) -> str:
    """Reject responses that do not attest a later, direct user turn.

    The Liaison prompt separates recommendation presentation from consent. This
    artifact contract makes that boundary fail closed at harvest: ACK approval,
    Manager messages, silence, and the recommendation itself cannot satisfy any
    of these exact provenance fields.
    """

    required_values = {
        "responded_by": "liaison",
        "response_source": "explicit-user-input",
        "response_channel": "same-pane",
        "response_turn": "after-question",
    }
    for field, expected in required_values.items():
        if str(meta.get(field) or "").strip() != expected:
            return f"{field} must be {expected}"
    input_kind = str(meta.get("user_input_kind") or "").strip()
    if input_kind not in {"option", "free-text"}:
        return "user_input_kind must be option or free-text"
    selected_option = str(meta.get("selected_option") or "").strip()
    if input_kind == "option" and not selected_option:
        return "selected_option is required for option user input"
    if input_kind == "free-text" and selected_option:
        return "selected_option must be absent for free-text user input"
    received_at = parse_liaison_response_timestamp(meta.get("user_input_received_at"))
    if received_at is None:
        return "user_input_received_at must be a timezone-aware ISO timestamp"
    responded_at = parse_liaison_response_timestamp(meta.get("responded_at"))
    if responded_at is None:
        return "responded_at must be a timezone-aware ISO timestamp"
    if responded_at < received_at:
        return "responded_at precedes user_input_received_at"
    return ""


def cmd_decision_liaison_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    record = require_decision(state, args.id)
    liaison = (state.get("decision_liaisons") or {}).get(args.id) or {}
    if str(liaison.get("status") or "") != "running":
        raise HLoopError(f"Decision Liaison is not running: {args.id}")
    block_reason = semantic_ack_barrier_blocking(liaison)
    if block_reason:
        raise HLoopError(f"cannot harvest L-{args.id}: {block_reason}")
    worktree = Path(str(liaison.get("worktree") or "")).resolve()
    role_id = str(liaison.get("role_id") or f"L-{args.id}")
    source = worktree / LOOP_DIR / "decisions" / args.id / "RESPONSE.md"
    if not source.is_file() or not read_text(source).strip():
        raise HLoopError(f"Decision Liaison response is missing: {source}")
    violations = validate_decision_role_scope(
        worktree,
        liaison,
        allowed={
            (LOOP_DIR / "decisions" / args.id / "RESPONSE.md").as_posix(),
            (LOOP_DIR / "prompts" / f"{role_id}.liaison.md").as_posix(),
        },
    )
    if violations:
        raise HLoopError(
            "Decision Liaison changed files outside its response: "
            + ", ".join(violations)
        )
    text = read_text(source)
    meta = read_frontmatter(source)
    identity_error = decision_role_artifact_identity_error(
        state,
        role_id=role_id,
        role_state=liaison,
        meta=meta,
        decision_id=args.id,
    )
    if identity_error:
        raise HLoopError(
            f"stale or mismatched Decision Liaison response: {identity_error}: {source}"
        )
    provenance_error = decision_liaison_response_provenance_error(meta)
    if provenance_error:
        raise HLoopError(
            "Decision Liaison response lacks explicit subsequent user input provenance: "
            f"{provenance_error}: {source}"
        )
    selected = str(meta.get("selected_option") or "").strip()
    body = markdown_body_after_frontmatter(text)
    body = re.sub(r"^# 回答\s*", "", body).strip()
    if not body:
        raise HLoopError("Decision Liaison response body is empty")
    try:
        updated = record_response(
            record,
            {
                "responded_by": str(meta.get("responded_by") or "liaison"),
                "responded_at": str(meta.get("responded_at") or now_iso()),
                "selected_option": selected,
                "free_text": body,
            },
        )
    except (DecisionValidationError, DecisionTransitionError) as exc:
        raise HLoopError(str(exc)) from exc
    state.setdefault("decisions", {})[args.id] = updated.to_record()
    destination = decision_liaison_file(repo, args.id)
    write_text(destination, text)
    liaison.update(
        {
            "status": "responded",
            "gate_status": "responded",
            "response_path": str(destination),
            "worktree_response_path_harvested": str(source),
            "response_provenance": {
                field: meta[field]
                for field in (
                    "attempt_id",
                    "run_id",
                    "skill_version",
                    "head_sha",
                    "response_source",
                    "response_channel",
                    "response_turn",
                    "user_input_received_at",
                    "user_input_kind",
                )
            },
            "harvested_at": now_iso(),
        }
    )
    cleanup_completed_agent_pane(
        repo,
        liaison,
        label=f"Decision Liaison {args.id}",
        session_cleanup=session_cleanup_mode(args, state),
    )
    cleanup_decision_role_worktree(
        repo, role_id, liaison, prompt_suffix="liaison", best_effort=True
    )
    revoke_active_role_report_identity(repo, state, role_id)
    write_decision_artifacts(repo, state)
    save_state(repo, state)
    journal(repo, f"Harvested Decision Liaison response for `{args.id}`.")
    print(f"harvested Decision Liaison response for {args.id}")
    return 0


def cmd_decision_new(args: argparse.Namespace) -> int:
    """Record one structured decision, ready for Liaison presentation."""

    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    decisions_state = state.setdefault("decisions", {})
    decision_id = args.id or next_id("D", decisions_state)
    if decision_id in decisions_state:
        raise HLoopError(f"decision already exists: {decision_id}")
    option_labels = args.option or ["推奨案を採用する", "別案を選ぶ"]
    if not 2 <= len(option_labels) <= 3:
        raise HLoopError("a decision requires 2 or 3 --option values")
    option_ids = [f"opt_{index}" for index in range(1, len(option_labels) + 1)]
    tradeoffs = getattr(args, "tradeoff", None) or option_labels
    if len(tradeoffs) != len(option_labels):
        raise HLoopError("provide exactly one --tradeoff for each --option")
    options = [
        {"id": option_id, "label": label, "tradeoffs": [tradeoff]}
        for option_id, label, tradeoff in zip(option_ids, option_labels, tradeoffs)
    ]
    recommend_option = args.recommend_option or option_ids[0]
    if recommend_option not in option_ids:
        raise HLoopError(f"--recommend-option must be one of {', '.join(option_ids)}")
    recommendation = {
        "option_id": recommend_option,
        "rationale": args.recommend_rationale
        or "repository evidence を踏まえ、最初の選択肢を暫定の推奨案とします。",
    }
    affected = normalize_list(args.affects)
    source_findings = list(getattr(args, "source_finding", None) or ())
    accepted_risk_authorization = None
    accepted_risk_fingerprint = str(
        getattr(args, "accepted_risk_fingerprint", "") or ""
    ).strip()
    accepted_risk_fields_present = any(
        str(getattr(args, field_name, "") or "").strip()
        for field_name in (
            "accepted_risk_fingerprint",
            "accepted_risk_target_sha",
            "accepted_risk_authorized_by",
            "accepted_risk_risk",
            "accepted_risk_reason",
            "accepted_risk_expires_at",
            "accepted_risk_reconsider_condition",
        )
    )
    if accepted_risk_fields_present:
        if accepted_risk_fingerprint and accepted_risk_fingerprint not in source_findings:
            source_findings.append(accepted_risk_fingerprint)
        try:
            accepted_risk_authorization = hloop_decisions.AcceptedRiskAuthorization(
                finding_fingerprint=accepted_risk_fingerprint,
                target_sha=getattr(args, "accepted_risk_target_sha", ""),
                authorized_by=getattr(args, "accepted_risk_authorized_by", ""),
                risk=getattr(args, "accepted_risk_risk", ""),
                reason=getattr(args, "accepted_risk_reason", ""),
                expires_at=getattr(args, "accepted_risk_expires_at", ""),
                reconsider_condition=getattr(
                    args, "accepted_risk_reconsider_condition", ""
                ),
            )
        except DecisionValidationError as exc:
            raise HLoopError(str(exc)) from exc
    try:
        record = DecisionRecord(
            decision_id=decision_id,
            decision_class=args.decision_class,
            status=DECISION_PENDING,
            question=args.title,
            options=tuple(options),
            recommendation=recommendation,
            affected_task_ids=tuple(affected),
            source_findings=tuple(source_findings),
            created_from=getattr(args, "created_from", None)
            or "specification-scout/manager fallback",
            accepted_risk_authorization=accepted_risk_authorization,
        )
    except DecisionValidationError as exc:
        raise HLoopError(str(exc)) from exc
    decisions_state[decision_id] = record.to_record()
    write_decision_artifacts(repo, state)
    save_state(repo, state)
    journal(
        repo,
        f"Opened decision `{decision_id}` ({record.decision_class}): {record.question}"
        + (f" (affects: {', '.join(affected)})" if affected else " (advisory scope; no task affected)"),
    )
    print(f"created {decision_id}")
    return 0


def cmd_decision_list(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    decisions_state = state.get("decisions") or {}
    rows = []
    for decision_id in sorted(decisions_state):
        try:
            record = DecisionRecord.from_record(decisions_state[decision_id])
        except DecisionValidationError:
            rows.append({"id": decision_id, "error": "invalid decision record"})
            continue
        rows.append(
            {
                "id": record.decision_id,
                "class": record.decision_class,
                "status": record.status,
                "question": record.question,
                "affected_task_ids": list(record.affected_task_ids),
                "blocks_affected_tasks": record.blocks_affected_tasks,
            }
        )
    if getattr(args, "json", False):
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0
    if not rows:
        print("no decisions")
        return 0
    for row in rows:
        if row.get("error"):
            print(f"{row['id']}: {row['error']}")
            continue
        affects = ",".join(row["affected_task_ids"]) or "-"
        blocking = " BLOCKING" if row["blocks_affected_tasks"] else ""
        print(
            f"{row['id']} [{row['class']}/{row['status']}]{blocking} "
            f"affects={affects} {row['question']}"
        )
    return 0


def cmd_decision_respond(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    decisions_state = state.setdefault("decisions", {})
    record = require_decision(state, args.id)
    liaison = (state.get("decision_liaisons") or {}).get(args.id)
    if isinstance(liaison, dict) and str(liaison.get("status") or "") == "running":
        block_reason = semantic_ack_barrier_blocking(liaison)
        if block_reason:
            raise HLoopError(f"cannot close L-{args.id}: {block_reason}")
    selected_option = args.option or record.recommendation.option_id
    response = {
        "responded_by": args.responded_by or "manager",
        "responded_at": now_iso(),
        "selected_option": selected_option,
        "free_text": args.text,
    }
    try:
        updated = record_response(record, response)
        if args.recommendation:
            payload = updated.to_record()
            payload["recommendation"]["rationale"] = args.recommendation
            updated = DecisionRecord.from_record(payload)
    except (DecisionValidationError, DecisionTransitionError) as exc:
        raise HLoopError(str(exc)) from exc
    decisions_state[args.id] = updated.to_record()
    if isinstance(liaison, dict):
        liaison["status"] = "responded"
        liaison["gate_status"] = "responded"
        liaison["responded_at"] = now_iso()
        if liaison.get("pane_id"):
            cleanup_completed_agent_pane(
                repo,
                liaison,
                label=f"Decision Liaison {args.id}",
                session_cleanup=session_cleanup_mode(args, state),
            )
        if liaison.get("worktree"):
            cleanup_decision_role_worktree(
                repo,
                str(liaison.get("role_id") or f"L-{args.id}"),
                liaison,
                prompt_suffix="liaison",
                best_effort=True,
            )
        revoke_active_role_report_identity(
            repo, state, str(liaison.get("role_id") or f"L-{args.id}")
        )
    write_decision_artifacts(repo, state)
    save_state(repo, state)
    journal(repo, f"Recorded response to decision `{args.id}`: {args.text}")
    print(f"responded {args.id}: status={updated.status}")
    return 0


def cmd_decision_resolve(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    decisions_state = state.setdefault("decisions", {})
    record = require_decision(state, args.id)
    rationale = args.note or f"Resolved via hloop decision resolve as {args.outcome}."
    try:
        updated = resolve_decision(
            record,
            outcome=args.outcome,
            rationale=rationale,
            resolved_by=args.resolved_by or "manager",
            resolved_at=now_iso(),
            selected_option=args.selected_option or "",
        )
    except (DecisionValidationError, DecisionTransitionError) as exc:
        raise HLoopError(str(exc)) from exc
    decisions_state[args.id] = updated.to_record()
    write_decision_artifacts(repo, state)
    save_state(repo, state)
    journal(repo, f"Resolved decision `{args.id}` as `{args.outcome}`: {rationale}")
    print(f"resolved {args.id}: status={updated.status}")
    return 0


def cmd_decision_reclassify(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    decisions_state = state.setdefault("decisions", {})
    record = require_decision(state, args.id)
    try:
        updated = reclassify_decision(record, args.decision_class)
    except (DecisionValidationError, DecisionTransitionError) as exc:
        raise HLoopError(str(exc)) from exc
    decisions_state[args.id] = updated.to_record()
    write_decision_artifacts(repo, state)
    save_state(repo, state)
    journal(repo, f"Reclassified decision `{args.id}` as `{args.decision_class}`.")
    print(f"reclassified {args.id}: class={updated.decision_class}")
    return 0


def revision_three_task_fields(
    state: dict[str, Any],
    *,
    preserved_invariants: Sequence[str] | None,
    regression_checks: Sequence[str] | None,
    risk_class: str | None,
    required_gates: Sequence[str] | None,
    worker_agent_effort: str | None,
    investigation_goal: str | None = None,
    implementation_ready_evidence: Sequence[str] | None = None,
    exploration_budget_minutes: int | None = None,
    history_search_allowed: bool | None = None,
) -> dict[str, Any]:
    if not v053_state_contracts_enabled(state):
        return {}
    invariants = [str(item).strip() for item in (preserved_invariants or []) if str(item).strip()]
    regressions = [str(item).strip() for item in (regression_checks or []) if str(item).strip()]
    if not invariants:
        raise HLoopError("revision 3 task creation requires --preserved-invariant")
    if not regressions:
        raise HLoopError("revision 3 task creation requires --regression-check")
    if risk_class not in hloop_task_contract.RISK_CLASSES:
        raise HLoopError(
            "revision 3 task creation requires --risk-class mechanical|normal|high"
        )
    gates = list(dict.fromkeys(str(item) for item in (required_gates or [])))
    invalid_gates = sorted(set(gates) - set(hloop_task_contract.REQUIRED_GATES))
    if invalid_gates:
        raise HLoopError("unsupported required gate(s): " + ", ".join(invalid_gates))
    effort = normalize_agent_effort(
        worker_agent_effort or state.get("worker_agent_effort") or DEFAULT_AGENT_EFFORT
    )
    fields: dict[str, Any] = {
        "contract_schema_revision": hloop_task_contract.V053_CONTRACT_SCHEMA_REVISION,
        "preserved_invariants": invariants,
        "regression_checks": regressions,
        "risk_class": str(risk_class),
        "required_gates": gates,
        "worker_agent_effort": effort,
    }
    if investigation_goal:
        fields["investigation_goal"] = str(investigation_goal).strip()
    if implementation_ready_evidence:
        fields["implementation_ready_evidence"] = [
            str(item).strip()
            for item in implementation_ready_evidence
            if str(item).strip()
        ]
    if exploration_budget_minutes is not None:
        if exploration_budget_minutes < 1:
            raise HLoopError("exploration_budget_minutes must be positive")
        fields["exploration_budget_minutes"] = exploration_budget_minutes
    if history_search_allowed is not None:
        fields["history_search_allowed"] = history_search_allowed
    return fields


def revision_three_projection(fields: Mapping[str, Any]) -> dict[str, Any]:
    return {
        key: fields[key]
        for key in (
            "contract_schema_revision",
            "preserved_invariants",
            "regression_checks",
            "risk_class",
            "required_gates",
            "worker_agent_effort",
            "investigation_goal",
            "implementation_ready_evidence",
            "exploration_budget_minutes",
            "history_search_allowed",
        )
        if key in fields
    }


def create_loop_task(
    repo: Path,
    state: dict[str, Any],
    *,
    title: str,
    kind: str,
    priority: str,
    write_allow: list[str],
    write_deny: list[str],
    acceptance: list[str],
    depends_on: list[str],
    created_from: str,
    validation_minimum: str = "L1",
    branch: str | None = None,
    batch_id: str | None = None,
    worker_agent_provider: str | None = None,
    worker_agent_model: str | None = None,
    worker_agent_effort: str | None = None,
    preserved_invariants: Sequence[str] | None = None,
    regression_checks: Sequence[str] | None = None,
    risk_class: str | None = None,
    required_gates: Sequence[str] | None = None,
    investigation_goal: str | None = None,
    implementation_ready_evidence: Sequence[str] | None = None,
    exploration_budget_minutes: int | None = None,
    history_search_allowed: bool | None = None,
    allow_no_write: bool = False,
    provenance: dict[str, Any] | None = None,
) -> str:
    assert_task_creation_dispatchable(state)
    if kind == "implementation" and not write_allow and not allow_no_write:
        raise HLoopError("implementation tasks require at least one write_allow")
    if kind == "fix" and not write_allow and not allow_no_write:
        raise HLoopError("fix tasks require at least one write_allow")
    task_id = next_id("T", state.setdefault("tasks", {}))
    title_slug = slugify(title)
    task_branch = branch or f"ai/{state['goal_id']}/{task_id}-{title_slug}"
    base_ref = state["integration_branch"]
    if not branch_exists(repo, base_ref):
        raise HLoopError(f"base_ref does not exist: {base_ref}")
    base_sha = git(repo, ["rev-parse", base_ref])
    resolved_batch_id = validate_batch_id(batch_id) if batch_id else current_batch_id(state)
    if resolved_batch_id:
        require_batch(state, resolved_batch_id)
    provenance_input = provenance or provenance_record_from_args(None, state)
    normalized_provenance = authorize_task_record(repo, state, provenance_input)
    v053_fields = revision_three_task_fields(
        state,
        preserved_invariants=preserved_invariants,
        regression_checks=regression_checks,
        risk_class=risk_class,
        required_gates=required_gates,
        worker_agent_effort=worker_agent_effort,
        investigation_goal=investigation_goal,
        implementation_ready_evidence=implementation_ready_evidence,
        exploration_budget_minutes=exploration_budget_minutes,
        history_search_allowed=history_search_allowed,
    )
    fields = {
        "id": task_id,
        "run_id": str(state.get("run_id") or ""),
        "skill_version": SKILL_VERSION,
        "kind": kind,
        "status": "queued",
        "created_from": created_from,
        "branch": task_branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "priority": priority,
        "depends_on": depends_on,
        "write_allow": write_allow,
        "write_deny": write_deny,
        "acceptance": acceptance or ["Task acceptance criteria are satisfied."],
        "validation_minimum": validation_minimum,
        "worker_protocol": state_value(state, "worker_protocol", DEFAULT_WORKER_PROTOCOL),
        "worker_qa_profile": state_worker_qa_profile(state),
        "worker_agent_provider": normalize_agent_provider(
            worker_agent_provider or state.get("worker_agent_provider") or DEFAULT_AGENT_PROVIDER
        ),
        "worker_agent_model": normalize_agent_model(
            worker_agent_model or state.get("worker_agent_model") or DEFAULT_AGENT_MODEL
        ),
        **v053_fields,
        **normalized_provenance.to_record(),
    }
    if resolved_batch_id:
        fields["batch_id"] = resolved_batch_id
    body = f"""# Task {task_id}: {title}

## Goal
{title}

## Context
Created from `{created_from}`.

Read:
- {LOOP_DIR.as_posix()}/MISSION.md
- {LOOP_DIR.as_posix()}/PLAN.md
- {LOOP_DIR.as_posix()}/DECISIONS.md
- {LOOP_DIR.as_posix()}/{created_from}.md if it exists

## Instructions
Follow this sequence:
1. Verify the referenced finding against the current code.
2. Implement the smallest safe fix.
3. Review your own diff.
4. Run targeted tests/build.
5. Write result artifact.
6. Commit your work.

Use the HLoop Worker Protocol from `{LOOP_DIR.as_posix()}/PROFILE.md` and your rendered worker prompt. Do not invoke an external implementation skill unless this task explicitly sets `worker_protocol: codex-impl`.

## Done when
{chr(10).join(f"- {item}" for item in fields["acceptance"])}
"""
    task_path = task_file(repo, task_id)
    write_text(task_path, frontmatter(fields) + "\n" + body)
    if v053_fields:
        validate_revision_three_task(read_frontmatter(task_path), task_id=task_id)
    task_contract_digest = hashlib.sha256(task_path.read_bytes()).hexdigest()
    state["tasks"][task_id] = {
        "status": "queued",
        "branch": task_branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "write_allow": fields["write_allow"],
        "write_deny": fields["write_deny"],
        "depends_on": fields["depends_on"],
        "created_from": created_from,
        "worker_protocol": fields["worker_protocol"],
        "worker_qa_profile": fields["worker_qa_profile"],
        "agent_provider": fields["worker_agent_provider"],
        "agent_model": fields["worker_agent_model"],
        **revision_three_projection(fields),
        **normalized_provenance.to_record(),
        "task_contract_digest": task_contract_digest,
        "created_at": now_iso(),
    }
    if resolved_batch_id:
        state["tasks"][task_id]["batch_id"] = resolved_batch_id
        batch = require_batch(state, resolved_batch_id)
        batch["task_ids"] = sorted(
            dict.fromkeys([*normalize_list(batch.get("task_ids")), task_id])
        )
        write_batch_artifact(repo, state, resolved_batch_id)
    persist_write_scope_conflict_graph(
        state, batch_id=resolved_batch_id or str(state.get("current_batch_id") or "")
    )
    invalidate_review_gates_for_change(
        state,
        reason=f"new task created: {task_id}",
        target_sha="",
    )
    disarm_final_gate_for_new_task(state, task_id)
    invalidate_planning_evidence(state, reason=f"task contract created: {task_id}")
    return task_id


def cmd_task_new(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(
        repo,
        require_integration_branch=True,
        mark_blocked=False,
    )
    assert_task_creation_dispatchable(state)
    if args.kind in {"implementation", "fix"} and not args.write_allow and not args.allow_no_write:
        raise HLoopError(f"{args.kind} tasks require at least one --write-allow")
    task_id = args.id or next_id("T", state.setdefault("tasks", {}))
    if task_id in state["tasks"]:
        raise HLoopError(f"task already exists: {task_id}")
    title_slug = slugify(args.title)
    branch = args.branch or f"ai/{state['goal_id']}/{task_id}-{title_slug}"
    base_ref = args.base_ref or state["integration_branch"]
    if not branch_exists(repo, base_ref):
        raise HLoopError(
            f"base_ref does not exist: {base_ref}. Run init with --create-branch "
            "or create/switch to the integration branch before adding tasks."
        )
    base_sha = args.base_sha or git(repo, ["rev-parse", base_ref])
    resolved_batch_id = validate_batch_id(args.batch_id) if args.batch_id else current_batch_id(state)
    if resolved_batch_id:
        require_batch(state, resolved_batch_id)
    requested_worker_qa_profile = getattr(args, "worker_qa_profile", None) or getattr(
        args, "qa_profile", None
    )
    validation_minimums = args.validation_minimum or ["L1"]
    validation_minimum: str | list[str]
    if len(validation_minimums) == 1:
        validation_minimum = validation_minimums[0]
    else:
        validation_minimum = validation_minimums
    normalized_provenance = authorize_task_record(
        repo,
        state,
        provenance_record_from_args(args, state),
    )
    v053_fields = revision_three_task_fields(
        state,
        preserved_invariants=getattr(args, "preserved_invariant", None),
        regression_checks=getattr(args, "regression_check", None),
        risk_class=getattr(args, "risk_class", None),
        required_gates=getattr(args, "required_gate", None),
        worker_agent_effort=getattr(args, "worker_agent_effort", None),
        investigation_goal=getattr(args, "investigation_goal", None),
        implementation_ready_evidence=getattr(
            args, "implementation_ready_evidence", None
        ),
        exploration_budget_minutes=getattr(args, "exploration_budget_minutes", None),
        history_search_allowed=getattr(args, "history_search_allowed", None),
    )
    fields = {
        "id": task_id,
        "run_id": str(state.get("run_id") or ""),
        "skill_version": SKILL_VERSION,
        "kind": args.kind,
        "status": "queued",
        "created_from": "PLAN.md",
        "branch": branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "priority": args.priority,
        "depends_on": args.depends_on or [],
        "write_allow": args.write_allow or [],
        "write_deny": args.write_deny or [],
        "acceptance": args.acceptance or ["Task acceptance criteria are satisfied."],
        "validation_minimum": validation_minimum,
        "worker_protocol": args.worker_protocol or state_value(state, "worker_protocol", DEFAULT_WORKER_PROTOCOL),
        "worker_qa_profile": args_worker_qa_profile(args)
        if requested_worker_qa_profile
        else state_worker_qa_profile(state),
        "worker_agent_provider": normalize_agent_provider(
            getattr(args, "worker_agent_provider", None)
            or state.get("worker_agent_provider")
            or DEFAULT_AGENT_PROVIDER
        ),
        "worker_agent_model": normalize_agent_model(
            getattr(args, "worker_agent_model", None)
            or state.get("worker_agent_model")
            or DEFAULT_AGENT_MODEL
        ),
        **v053_fields,
        **normalized_provenance.to_record(),
    }
    if resolved_batch_id:
        fields["batch_id"] = resolved_batch_id
    body = f"""# Task {task_id}: {args.title}

## Goal
{args.title}

## Context
Read:
- {LOOP_DIR.as_posix()}/MISSION.md
- {LOOP_DIR.as_posix()}/PLAN.md

## Instructions
Follow this sequence:
1. Gap-check the task against the current code.
2. Implement the smallest safe change.
3. Review your own diff.
4. Run targeted tests/build.
5. Write result artifact.
6. Commit your work.

Use the HLoop Worker Protocol from `{LOOP_DIR.as_posix()}/PROFILE.md` and your rendered worker prompt. Do not invoke an external implementation skill unless this task explicitly sets `worker_protocol: codex-impl`.

## Done when
{chr(10).join(f"- {item}" for item in fields["acceptance"])}
"""
    task_path = task_file(repo, task_id)
    write_text(task_path, frontmatter(fields) + "\n" + body)
    if v053_fields:
        validate_revision_three_task(read_frontmatter(task_path), task_id=task_id)
    task_contract_digest = hashlib.sha256(task_path.read_bytes()).hexdigest()
    state["tasks"][task_id] = {
        "status": "queued",
        "branch": branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "write_allow": fields["write_allow"],
        "write_deny": fields["write_deny"],
        "depends_on": fields["depends_on"],
        "worker_protocol": fields["worker_protocol"],
        "worker_qa_profile": fields["worker_qa_profile"],
        "agent_provider": fields["worker_agent_provider"],
        "agent_model": fields["worker_agent_model"],
        **revision_three_projection(fields),
        **normalized_provenance.to_record(),
        "task_contract_digest": task_contract_digest,
        "created_at": now_iso(),
    }
    if resolved_batch_id:
        state["tasks"][task_id]["batch_id"] = resolved_batch_id
        batch = require_batch(state, resolved_batch_id)
        batch["task_ids"] = sorted(
            dict.fromkeys([*normalize_list(batch.get("task_ids")), task_id])
        )
        write_batch_artifact(repo, state, resolved_batch_id)
    persist_write_scope_conflict_graph(
        state, batch_id=resolved_batch_id or str(state.get("current_batch_id") or "")
    )
    invalidate_review_gates_for_change(
        state,
        reason=f"new task created: {task_id}",
        target_sha="",
    )
    disarm_final_gate_for_new_task(state, task_id)
    invalidate_planning_evidence(state, reason=f"task contract created: {task_id}")
    state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Created task `{task_id}`: {args.title}")
    print(f"created {task_id}: {task_file(repo, task_id)}")
    return 0


def updated_list(
    current: Any,
    additions: list[str] | None,
    removals: list[str] | None,
    replacement: list[str] | None = None,
) -> list[str]:
    values = list(replacement) if replacement is not None else normalize_list(current)
    values.extend(additions or [])
    removed = set(removals or [])
    return [item for item in dict.fromkeys(values) if item not in removed]


def cmd_task_update(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"unknown task: {task_id}")
    path = task_file(repo, task_id)
    meta = read_frontmatter(path)
    updates: dict[str, Any] = {}
    list_specs = [
        ("write_allow", args.add_write_allow, args.remove_write_allow, None),
        ("write_deny", args.add_write_deny, args.remove_write_deny, None),
        (
            "acceptance",
            args.add_acceptance,
            None,
            args.set_acceptance if args.set_acceptance is not None else None,
        ),
        (
            "preserved_invariants",
            None,
            None,
            getattr(args, "set_preserved_invariant", None),
        ),
        (
            "regression_checks",
            None,
            None,
            getattr(args, "set_regression_check", None),
        ),
        (
            "required_gates",
            None,
            None,
            getattr(args, "set_required_gate", None),
        ),
        (
            "implementation_ready_evidence",
            None,
            None,
            getattr(args, "set_implementation_ready_evidence", None),
        ),
    ]
    for key, additions, removals, replacement in list_specs:
        if additions or removals or replacement is not None:
            updates[key] = updated_list(meta.get(key), additions, removals, replacement)
    scalar_updates = {
        "priority": args.priority,
        "validation_minimum": args.validation_minimum,
        "worker_protocol": args.worker_protocol,
        "worker_qa_profile": args.worker_qa_profile,
        "worker_agent_provider": args.worker_agent_provider,
        "worker_agent_model": args.worker_agent_model,
        "worker_agent_effort": getattr(args, "worker_agent_effort", None),
        "risk_class": getattr(args, "risk_class", None),
        "investigation_goal": getattr(args, "investigation_goal", None),
        "exploration_budget_minutes": getattr(args, "exploration_budget_minutes", None),
        "history_search_allowed": getattr(args, "history_search_allowed", None),
        "contract_schema_revision": getattr(args, "contract_schema_revision", None),
    }
    updates.update({key: value for key, value in scalar_updates.items() if value is not None})
    if not updates:
        raise HLoopError("task update has no changes")
    validate_task_update_provenance(repo, state, meta, updates)
    kind = str(meta.get("kind") or "implementation")
    next_allow = normalize_list(updates.get("write_allow", meta.get("write_allow")))
    if kind in {"implementation", "fix"} and not next_allow:
        raise HLoopError(f"{kind} task must keep a non-empty write_allow")
    next_meta = dict(meta)
    next_meta.update(updates)
    if (
        next_meta.get("contract_schema_revision")
        == hloop_task_contract.V053_CONTRACT_SCHEMA_REVISION
    ):
        next_meta.pop("migration_blocker", None)
        validate_revision_three_task(next_meta, task_id=task_id)
    replace_frontmatter_record(path, next_meta)
    for key in (
        "write_allow",
        "write_deny",
        "acceptance",
        "priority",
        "validation_minimum",
        "worker_protocol",
        "worker_qa_profile",
        "contract_schema_revision",
        "preserved_invariants",
        "regression_checks",
        "risk_class",
        "required_gates",
        "worker_agent_effort",
        "investigation_goal",
        "implementation_ready_evidence",
        "exploration_budget_minutes",
        "history_search_allowed",
    ):
        if key in updates:
            task_state[key] = updates[key]
    if "worker_agent_provider" in updates:
        task_state["agent_provider"] = normalize_agent_provider(updates["worker_agent_provider"])
    if "worker_agent_model" in updates:
        task_state["agent_model"] = normalize_agent_model(updates["worker_agent_model"])
    task_contract_digest = hashlib.sha256(path.read_bytes()).hexdigest()
    task_state["task_contract_digest"] = task_contract_digest
    task_state["contract_updated_at"] = now_iso()
    task_state.pop("candidate", None)
    task_state.pop("implementation_candidate", None)
    task_state.pop("candidate_seal", None)
    task_state.pop("candidate_artifact_digest", None)
    task_state.pop("candidate_sha", None)
    task_state.pop("candidate_tree_sha", None)
    task_state.pop("current_patch_review", None)
    task_state.pop("patch_review_decision", None)
    task_state.pop("active_patch_review_id", None)
    if task_state.get("candidate_lifecycle_status") in PATCH_REVIEW_TASK_STATUSES:
        task_state["candidate_lifecycle_status"] = "running"
    if task_state.get("status") == "running":
        attempt_id = str(task_state.get("active_attempt_id") or task_state.get("attempt_id") or "")
        if not attempt_id:
            raise HLoopError(f"running task has no active attempt identity: {task_id}")
        try:
            ack_floor = rebind_role_report_contract_digest(
                repo,
                state,
                role_id=task_id,
                attempt_id=attempt_id,
                task_contract_digest=task_contract_digest,
            )
        except (HLoopError, hloop_broker.BrokerStorageError, OSError) as exc:
            arm_semantic_ack_barrier(
                task_state,
                message_id=f"task-contract:{task_contract_digest}",
                digest=task_contract_digest,
                kind="task-contract",
            )
            task_state["semantic_ack_barrier"]["status"] = "identity_rebind_failed"
            task_state["semantic_ack_barrier"]["error"] = str(exc)
            save_state(repo, state)
            raise HLoopError(
                f"task contract changed but report identity rebinding failed for {task_id}; "
                "finalize, harvest, and merge remain blocked"
            ) from exc
        arm_semantic_ack_barrier(
            task_state,
            message_id=f"task-contract:{task_contract_digest}",
            digest=task_contract_digest,
            kind="task-contract",
            required_reack_after_sequence=ack_floor,
        )
    if "write_allow" in updates:
        batch_id = str(task_state.get("batch_id") or state.get("current_batch_id") or "")
        persist_write_scope_conflict_graph(state, batch_id=batch_id)
        if batch_id and batch_id in state_batches(state):
            write_batch_artifact(repo, state, batch_id)
    invalidate_planning_evidence(state, reason=f"task contract updated: {task_id}")
    save_state(repo, state)
    if task_state.get("status") == "running":
        refresh_running_worker_contract_snapshot(
            repo,
            state,
            task_id,
            task_state,
            task_contract_digest=task_contract_digest,
        )
    journal(repo, f"Updated task contract `{task_id}`: {', '.join(sorted(updates))}.")
    print(f"updated {task_id}: {', '.join(sorted(updates))}")
    if task_state.get("status") == "running":
        print(
            "Worker contract digest changed to "
            f"{task_contract_digest}; a corrected semantic ACK and Manager approval are required "
            "before finalize, harvest, or merge. Send the changed requirements with `hloop worker message`."
        )
    else:
        print("checkpoint required before starting this task")
    return 0


def commit_worker_candidate_product(
    repo: Path,
    task_id: str,
    meta: Mapping[str, Any],
    dirty_product: Sequence[str],
) -> None:
    if cached_diff_paths_no_renames(repo):
        raise HLoopError(
            "worker submit requires an unstaged canonical index before candidate commit"
        )
    violations = validate_change_scope(task_id, dict(meta), list(dirty_product))
    if violations:
        raise HLoopError("write-scope violations: " + "; ".join(violations))
    if not dirty_product:
        return
    try:
        git(repo, ["add", "-A", "--", *dirty_product])
        staged = cached_diff_paths_no_renames(repo)
        remaining = unstaged_product_paths(repo)
        if set(staged) != set(dirty_product) or remaining:
            raise HLoopError(
                "candidate commit scope changed while staging: "
                f"staged={sorted(staged)} remaining={sorted(remaining)}"
            )
        git(repo, ["commit", "-m", f"ai-loop({task_id}): implementation candidate"])
    except BaseException:
        if cached_diff_paths_no_renames(repo):
            git(repo, ["read-tree", "HEAD"])
        raise


def cmd_worker_submit(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    local_state = load_state(repo)
    task_id = args.task_id
    contract_repo, state = canonical_worker_contract_source(repo, task_id, local_state)
    task_state = (state.get("tasks") or {}).get(task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"unknown task: {task_id}")
    if str(task_state.get("status") or "") != "running":
        raise HLoopError(f"worker submit requires an active attempt: {task_id}")
    lifecycle = str(task_state.get("candidate_lifecycle_status") or "")
    if lifecycle and lifecycle not in {"running", "patch_fix_running"}:
        raise HLoopError(
            f"worker submit is not allowed from candidate lifecycle {lifecycle!r}"
        )
    expected_worktree = str(task_state.get("worktree") or "")
    if expected_worktree and repo != Path(expected_worktree).resolve():
        raise HLoopError(
            f"worker submit must run in the active attempt worktree: {expected_worktree}"
        )
    meta = read_frontmatter(task_file(contract_repo, task_id))
    if task_contract_revision(meta) != hloop_task_contract.V053_CONTRACT_SCHEMA_REVISION:
        raise HLoopError("worker submit is available only for revision 3 task contracts")
    validate_revision_three_task(meta, task_id=task_id)
    attempt_id = active_attempt_id(task_id, task_state)
    ack_event_id = approved_semantic_ack_event_id(task_id, task_state)
    _, labelled_contract_digest = exact_task_contract_digest(
        contract_repo, task_id, task_state
    )
    expected_branch = str(task_state.get("branch") or meta.get("branch") or "")
    branch = current_branch(repo)
    if expected_branch and branch != expected_branch:
        raise HLoopError(f"Worker branch mismatch: expected {expected_branch}, got {branch}")
    base_sha = str(task_state.get("worker_base_sha") or task_state.get("base_sha") or "")
    if not base_sha or not is_ancestor(repo, base_sha, "HEAD"):
        raise HLoopError(f"active attempt base is not an ancestor of HEAD: {base_sha}")
    if cached_diff_paths_no_renames(repo):
        raise HLoopError("worker submit refuses pre-staged changes")

    mode = str(
        args.completion_mode
        or task_state.get("completion_mode")
        or "commit"
    )
    if mode not in hloop_worker_candidate.COMPLETION_MODES:
        raise HLoopError(f"unsupported completion mode: {mode}")
    dirty_product = exact_product_dirty_paths(repo)
    if mode == "commit":
        commit_worker_candidate_product(repo, task_id, meta, dirty_product)
        dirty_product = exact_product_dirty_paths(repo)
        if dirty_product:
            raise HLoopError(
                "candidate commit left product changes dirty: "
                + ", ".join(dirty_product)
            )
        candidate_tree_sha = git(repo, ["rev-parse", "HEAD^{tree}"])
    else:
        violations = validate_change_scope(task_id, meta, dirty_product)
        if violations:
            raise HLoopError("write-scope violations: " + "; ".join(violations))
        candidate_tree_sha = proposed_worktree_tree(repo, dirty_product)

    files = candidate_changed_files(repo, base_sha, candidate_tree_sha)
    violations = validate_change_scope(task_id, meta, files)
    if violations:
        raise HLoopError("write-scope violations: " + "; ".join(violations))
    existing_revisions = candidate_revision_numbers(repo, task_id, attempt_id)
    expected_revision = (max(existing_revisions) if existing_revisions else 0) + 1
    requested_revision = args.candidate_revision or expected_revision
    if requested_revision != expected_revision:
        raise HLoopError(
            f"candidate revision must be the next revision {expected_revision}, "
            f"got {requested_revision}"
        )
    commands = normalize_list(args.validation_command)
    results = normalize_list(args.validation_result)
    if len(commands) != len(results):
        raise HLoopError("--validation-command and --validation-result counts must match")
    try:
        candidate = hloop_worker_candidate.ImplementationCandidate(
            run_id=str(state.get("run_id") or meta.get("run_id") or ""),
            skill_version=str(state.get("skill_version") or SKILL_VERSION),
            task_id=task_id,
            attempt_id=attempt_id,
            task_contract_digest=labelled_contract_digest,
            semantic_ack_event_id=ack_event_id,
            base_sha=base_sha,
            candidate_revision=requested_revision,
            completion_mode=mode,
            candidate_tree_sha=candidate_tree_sha,
            candidate_artifact_ref=candidate_artifact_ref(
                task_id, attempt_id, requested_revision
            ),
            changed_files=tuple(files),
            validation_commands=tuple(commands),
            validation_results=tuple(results),
            validation_summary=str(args.validation_summary or ""),
            invariant_evidence=tuple(normalize_list(args.invariant_evidence)),
            regression_evidence=tuple(normalize_list(args.regression_evidence)),
            self_review_summary=str(args.self_review_summary or ""),
            residual_risks=tuple(normalize_list(args.residual_risk)),
            unrun_checks=tuple(normalize_list(args.unrun_check)),
        )
    except hloop_worker_candidate.WorkerCandidateError as exc:
        raise HLoopError(f"invalid implementation candidate: {exc}") from exc
    artifact_path = implementation_candidate_file(
        repo, task_id, attempt_id, requested_revision
    )
    payload = exact_json_bytes(candidate.to_record())
    write_text(artifact_path, payload.decode("utf-8"), durable=True)
    print(
        f"submitted {task_id} candidate revision {requested_revision}: "
        f"mode={mode} tree={candidate_tree_sha} merge_ready=false"
    )
    return 0


def require_worker_pane_quiesced_preserved(
    task_id: str, task_state: Mapping[str, Any]
) -> None:
    pane_id = str(task_state.get("pane_id") or "")
    if not pane_id:
        raise HLoopError(
            f"cannot candidate-seal {task_id}: active Worker pane_id is missing"
        )
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        raise HLoopError(
            f"cannot candidate-seal {task_id}: Herdr is required to confirm "
            f"Worker pane {pane_id} is quiesced"
        )
    pane = pane_info(pane_id)
    if pane is None:
        raise HLoopError(
            f"cannot candidate-seal {task_id}: Worker pane {pane_id} is missing; "
            "candidate seal must preserve the pane"
        )
    provider = str(
        task_state.get("agent_provider")
        or task_state.get("provider")
        or DEFAULT_AGENT_PROVIDER
    )
    blocker = agent_tui_blocker(provider, pane, pane_text(pane_id, lines=200))
    if blocker:
        raise HLoopError(
            f"cannot candidate-seal {task_id}: Worker pane is not quiesced: {blocker}"
        )


def commit_handoff_candidate(
    worktree: Path,
    task_id: str,
    dirty_product: Sequence[str],
    expected_tree: str,
) -> str:
    if not dirty_product:
        raise HLoopError(f"handoff candidate has no pending product changes: {task_id}")
    if cached_diff_paths_no_renames(worktree):
        raise HLoopError("handoff candidate refuses pre-staged changes")
    expected_parent = git(worktree, ["rev-parse", "HEAD"])
    try:
        git(worktree, ["add", "-A", "--", *dirty_product])
        staged = cached_diff_paths_no_renames(worktree)
        remaining = unstaged_product_paths(worktree)
        observed_tree = git(worktree, ["write-tree"])
        if set(staged) != set(dirty_product) or remaining:
            raise HLoopError(
                "handoff candidate changed while staging: "
                f"staged={sorted(staged)} remaining={sorted(remaining)}"
            )
        if observed_tree != expected_tree:
            raise HLoopError(
                f"handoff candidate tree mismatch: submitted={expected_tree} "
                f"observed={observed_tree}"
            )
        git(
            worktree,
            ["commit", "-m", f"ai-loop({task_id}): seal implementation candidate"],
        )
    except BaseException:
        if cached_diff_paths_no_renames(worktree):
            git(worktree, ["read-tree", expected_parent])
        raise
    return git(worktree, ["rev-parse", "HEAD"])


def cmd_worker_candidate_seal(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo, require_herdr=True, require_integration_branch=True
    )
    task_id = args.task_id
    task_state = (state.get("tasks") or {}).get(task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"unknown task: {task_id}")
    if str(task_state.get("status") or "") != "running":
        raise HLoopError(f"cannot candidate-seal inactive task: {task_id}")
    lifecycle = str(task_state.get("candidate_lifecycle_status") or "")
    if lifecycle and lifecycle not in {"running", "patch_fix_running"}:
        raise HLoopError(
            f"candidate seal is not allowed from lifecycle {lifecycle!r}"
        )
    attempt_id = active_attempt_id(task_id, task_state)
    revision = args.candidate_revision
    if revision is None:
        revisions = candidate_revision_numbers(
            Path(task_state.get("worktree") or "").resolve(), task_id, attempt_id
        )
        if not revisions:
            raise HLoopError(f"no implementation candidate found for {task_id}")
        revision = max(revisions)
    worktree = Path(
        task_state.get("worktree") or default_worktree(repo, task_id, state)
    ).resolve()
    if not worktree.is_dir():
        raise HLoopError(f"worker worktree not found: {worktree}")
    require_worker_pane_quiesced_preserved(task_id, task_state)
    meta = read_frontmatter(task_file(repo, task_id))
    if task_contract_revision(meta) != hloop_task_contract.V053_CONTRACT_SCHEMA_REVISION:
        raise HLoopError("candidate seal is available only for revision 3 tasks")
    candidate, payload = load_candidate_artifact(
        worktree, task_id, attempt_id, revision
    )
    expected_revision = int((task_state.get("candidate_revision") or 0)) + 1
    if candidate.candidate_revision != expected_revision:
        raise HLoopError(
            f"candidate revision must advance from {expected_revision - 1} "
            f"to {expected_revision}"
        )
    raw_contract_digest, labelled_contract_digest = exact_task_contract_digest(
        repo, task_id, task_state
    )
    approved_ack = approved_semantic_ack_event_id(task_id, task_state)
    if candidate.task_contract_digest != labelled_contract_digest:
        raise HLoopError(f"candidate task contract is stale for {task_id}")
    if candidate.semantic_ack_event_id != approved_ack:
        raise HLoopError(f"candidate semantic ACK is stale for {task_id}")
    if candidate.attempt_id != attempt_id:
        raise HLoopError(f"candidate attempt is stale for {task_id}")
    base_sha = str(task_state.get("worker_base_sha") or task_state.get("base_sha") or "")
    if candidate.base_sha != base_sha:
        raise HLoopError(f"candidate base SHA is stale for {task_id}")
    dirty_product = exact_product_dirty_paths(worktree)
    if candidate.completion_mode == "commit":
        if dirty_product:
            raise HLoopError(
                "commit-mode candidate worktree has dirty product paths: "
                + ", ".join(dirty_product)
            )
        candidate_sha = git(worktree, ["rev-parse", "HEAD"])
        observed_tree = git(worktree, ["rev-parse", "HEAD^{tree}"])
    else:
        proposed_tree = proposed_worktree_tree(worktree, dirty_product)
        if proposed_tree != candidate.candidate_tree_sha:
            raise HLoopError(
                f"handoff candidate changed after submit: submitted="
                f"{candidate.candidate_tree_sha} observed={proposed_tree}"
            )
        if dirty_product:
            candidate_sha = commit_handoff_candidate(
                worktree,
                task_id,
                dirty_product,
                candidate.candidate_tree_sha,
            )
        else:
            # The product commit may already have landed before a Manager
            # crash, while the state projection below did not. The immutable
            # submitted tree makes this safe to reconcile idempotently.
            candidate_sha = git(worktree, ["rev-parse", "HEAD"])
        observed_tree = git(worktree, ["rev-parse", "HEAD^{tree}"])
    measured_files = candidate_changed_files(worktree, base_sha, observed_tree)
    if measured_files != list(candidate.changed_files):
        raise HLoopError(
            f"candidate changed_files mismatch: submitted={list(candidate.changed_files)} "
            f"observed={measured_files}"
        )
    violations = validate_change_scope(task_id, meta, measured_files)
    if violations:
        raise HLoopError("write-scope violations: " + "; ".join(violations))
    artifact_digest = _sha256_labelled(payload)
    try:
        seal = hloop_worker_candidate.seal_candidate(
            candidate,
            candidate_sha=candidate_sha,
            candidate_artifact_digest=artifact_digest,
            observed_tree_sha=observed_tree,
            active_attempt_id=attempt_id,
            active_task_contract_digest=labelled_contract_digest,
            approved_ack_event_id=approved_ack,
        )
    except hloop_worker_candidate.WorkerCandidateError as exc:
        raise HLoopError(f"candidate seal rejected: {exc}") from exc
    manager_path = implementation_candidate_file(
        repo, task_id, attempt_id, candidate.candidate_revision
    )
    worker_path = implementation_candidate_file(
        worktree, task_id, attempt_id, candidate.candidate_revision
    )
    if manager_path.exists() and manager_path.read_bytes() != payload:
        raise HLoopError(
            f"candidate revision already has different Manager artifact bytes: {manager_path}"
        )
    if manager_path.resolve() != worker_path.resolve():
        write_text(manager_path, payload.decode("utf-8"), durable=True)
    task_state.update(
        {
            "task_contract_digest": raw_contract_digest,
            "candidate_revision": candidate.candidate_revision,
            "implementation_candidate": candidate.to_record(),
            "candidate_seal": seal.to_record(),
            "candidate_artifact_digest": artifact_digest,
            "candidate_sha": candidate_sha,
            "candidate_tree_sha": observed_tree,
            "completion_mode": candidate.completion_mode,
            "merge_ready": False,
            "candidate_lifecycle_status": (
                "patch_review_pending"
                if "patch_review" in task_required_gates(meta)
                else "candidate_sealed"
            ),
            "candidate_sealed_at": now_iso(),
        }
    )
    task_state.pop("current_patch_review", None)
    task_state.pop("patch_review_decision", None)
    task_state.pop("active_patch_review_id", None)
    save_state(repo, state)
    journal(
        repo,
        f"Sealed nonterminal implementation candidate for `{task_id}` "
        f"revision {candidate.candidate_revision} at `{candidate_sha}`.",
    )
    print(
        f"candidate-sealed {task_id}: revision={candidate.candidate_revision} "
        f"sha={candidate_sha} merge_ready=false"
    )
    return 0


def apply_patch_review_record(
    repo: Path,
    state: dict[str, Any],
    task_id: str,
    task_state: dict[str, Any],
    review: hloop_worker_candidate.PatchReview,
) -> hloop_worker_candidate.PatchReviewDecision:
    candidate, seal, _ = current_candidate_evidence(
        repo, state, task_id, task_state
    )
    if review.review_artifact_ref != (
        Path("patch-reviews")
        / task_id
        / candidate.attempt_id
        / f"{review.review_attempt_id}.json"
    ).as_posix():
        raise HLoopError("Patch Review artifact ref is not canonical")
    history = task_patch_review_history(task_state)
    existing = next(
        (
            item
            for item in history
            if item.review_attempt_id == review.review_attempt_id
        ),
        None,
    )
    if existing is not None:
        if existing != review:
            raise HLoopError(
                "review_attempt_id was reused with different Patch Review content"
            )
    else:
        history.append(review)
    _, labelled_contract_digest = exact_task_contract_digest(repo, task_id, task_state)
    try:
        decision = hloop_worker_candidate.evaluate_patch_review_rounds(
            seal,
            history,
            current_task_contract_digest=labelled_contract_digest,
            max_rounds=patch_review_round_limit(state),
        )
    except hloop_worker_candidate.WorkerCandidateError as exc:
        raise HLoopError(f"Patch Review transition rejected: {exc}") from exc
    review_path = patch_review_file(
        repo, task_id, seal.attempt_id, review.review_attempt_id
    )
    review_payload = exact_json_bytes(review.to_record())
    if review_path.exists() and review_path.read_bytes() != review_payload:
        raise HLoopError(
            f"Patch Review artifact differs from its exact record: {review_path}"
        )
    write_text(review_path, review_payload.decode("utf-8"), durable=True)
    task_state["patch_review_history"] = [item.to_record() for item in history]
    task_state["current_patch_review"] = review.to_record()
    task_state["patch_review_decision"] = decision.to_record()
    task_state["candidate_lifecycle_status"] = {
        "finalize_allowed": "patch_review_passed",
        "patch_fix_running": "patch_fix_running",
        "user_decision_required": "blocked_patch_review",
        "candidate_resubmission_required": "patch_fix_running",
        "patch_review_pending": "patch_review_pending",
    }[decision.action]
    task_state["merge_ready"] = False
    if decision.requires_user_decision:
        state["phase"] = "blocked_user_decision"
        task_state["blocking_patch_review_findings"] = list(
            decision.unresolved_finding_fingerprints
        )
        task_state["blocking_patch_review_candidate_sha"] = (
            decision.last_candidate_sha
        )
        if existing is None:
            append_text(
                loop_path(repo) / "USER_ACTION_REQUIRED.md",
                f"\n## Patch Review limit reached for {task_id}\n\n"
                f"Candidate `{decision.last_candidate_sha}` retains unresolved findings:\n"
                + "".join(
                    f"- `{fingerprint}`\n"
                    for fingerprint in decision.unresolved_finding_fingerprints
                )
                + "\nA user decision is required; no scope-expanding task was created automatically.\n",
            )
    elif decision.action == "patch_fix_running":
        state["phase"] = "running"
    return decision


def patch_reviewer_agent_config(
    state: Mapping[str, Any], args: argparse.Namespace
) -> dict[str, str]:
    defaults = hloop_config.V053_BUILT_IN_CONFIG_DEFAULTS["patch_reviewer"]
    resolved = state.get("resolved_config")
    configured = (
        resolved.get("patch_reviewer")
        if isinstance(resolved, Mapping)
        and isinstance(resolved.get("patch_reviewer"), Mapping)
        else {}
    )
    provider = normalize_agent_provider(
        getattr(args, "agent_provider", None)
        or configured.get("provider")
        or defaults["provider"]
    )
    return {
        "provider": provider,
        "model": normalize_agent_model(
            getattr(args, "agent_model", None)
            or configured.get("model")
            or defaults["model"]
        ),
        "effort": normalize_agent_effort(
            getattr(args, "agent_effort", None)
            or configured.get("effort")
            or defaults["effort"]
        ),
        "claude_permission_mode": str(
            state.get("reviewer_claude_permission_mode")
            or DEFAULT_CLAUDE_PERMISSION_MODE
        ),
        "fallback_provider": "",
    }


def render_patch_reviewer_prompt(
    state: Mapping[str, Any],
    task_id: str,
    task_meta: Mapping[str, Any],
    seal: hloop_worker_candidate.CandidateSeal,
    *,
    review_attempt_id: str,
    review_round: int,
    agent_config: Mapping[str, str],
    attempt_id: str,
    task_contract_digest: str,
    report_credential_file: str = "",
) -> str:
    artifact_ref = (
        Path("patch-reviews")
        / task_id
        / seal.attempt_id
        / f"{review_attempt_id}.json"
    )
    artifact_path = LOOP_DIR / artifact_ref
    template = hloop_worker_candidate.record_patch_review(
        seal,
        review_attempt_id=review_attempt_id,
        review_round=review_round,
        reviewer_provider=agent_config["provider"],
        reviewer_model=agent_config["model"],
        reviewer_effort=agent_config["effort"],
        verdict="passed",
    ).to_record()
    return f"""# HLoop Patch Reviewer {review_attempt_id}

Review only task `{task_id}` at exact candidate `{seal.candidate_sha}`.
Read the task contract, the candidate diff, preserved invariants, regression
checks, related callers, and related tests. Do not perform a repository-wide
review and do not edit product files.

- task contract: `{task_file(Path('.'), task_id).as_posix()}`
- candidate artifact: `{(LOOP_DIR / seal.candidate_artifact_ref).as_posix()}`
- output artifact: `{artifact_path.as_posix()}`
- review round: {review_round}
- provider/model/effort: {agent_config['provider']}/{agent_config['model']}/{agent_config['effort']}
- preserved invariants: {json.dumps(normalize_list(task_meta.get('preserved_invariants')), ensure_ascii=False)}
- regression checks: {json.dumps(normalize_list(task_meta.get('regression_checks')), ensure_ascii=False)}

Write one strict Patch Review JSON record. Use verdict `passed` only when no
task-local finding remains. Use `fix_required` with one or more labelled
SHA-256 unresolved finding fingerprints otherwise. Put task-external findings
only in `follow_up_finding_fingerprints`; `automatic_task_ids` must remain [].

Immutable record fields:
```json
{json.dumps(template, ensure_ascii=False, indent=2, sort_keys=True)}
```

{report_contract_text(review_attempt_id, attempt_id, dict(state), report_credential_file=report_credential_file, task_contract_digest=task_contract_digest)}
"""


def cmd_patch_review_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    task_id = args.task_id
    task_state = (state.get("tasks") or {}).get(task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"unknown task: {task_id}")
    meta = read_frontmatter(task_file(repo, task_id))
    if "patch_review" not in task_required_gates(meta):
        raise HLoopError(f"task {task_id} does not require Patch Review")
    if task_state.get("candidate_lifecycle_status") != "patch_review_pending":
        raise HLoopError(
            f"Patch Review is not startable for {task_id}: "
            f"{task_state.get('candidate_lifecycle_status') or 'missing candidate'}"
        )
    _, seal, _ = current_candidate_evidence(repo, state, task_id, task_state)
    initial_candidate_sha = seal.candidate_sha
    initial_candidate_artifact_digest = seal.candidate_artifact_digest
    history = task_patch_review_history(task_state)
    round_number = len(history) + 1
    if round_number > patch_review_round_limit(state):
        raise HLoopError(f"Patch Review round limit reached for {task_id}")
    review_attempt_id = args.review_attempt_id or f"PR-{task_id}-R{round_number:03d}"
    existing_reviews = state.setdefault("patch_reviews", {})
    if review_attempt_id in existing_reviews:
        raise HLoopError(f"Patch Review already exists: {review_attempt_id}")
    agent_config = patch_reviewer_agent_config(state, args)
    attempt_id = f"{review_attempt_id}-A001"
    contract_material = {
        "task_contract_digest": seal.task_contract_digest,
        "candidate_sha": seal.candidate_sha,
        "candidate_artifact_digest": seal.candidate_artifact_digest,
        "review_attempt_id": review_attempt_id,
        "review_round": round_number,
    }
    review_contract_digest = hashlib.sha256(
        hloop_worker_candidate.canonical_json(contract_material).encode("utf-8")
    ).hexdigest()
    worktree = (
        Path(args.worktree).resolve()
        if args.worktree
        else configured_worktree_path(
            repo,
            state,
            review_attempt_id,
            f"{repo.name}.{task_id.lower()}-patch-review-{round_number}",
        )
    )
    prompt_rel = LOOP_DIR / "prompts" / f"{review_attempt_id}.patch-reviewer.md"
    review_rel = patch_review_rel(task_id, seal.attempt_id, review_attempt_id)
    prompt = render_patch_reviewer_prompt(
        state,
        task_id,
        meta,
        seal,
        review_attempt_id=review_attempt_id,
        review_round=round_number,
        agent_config=agent_config,
        attempt_id=attempt_id,
        task_contract_digest=review_contract_digest,
    )
    runner = args.runner or "tui"
    agent_command, preview_invocation = role_agent_command(
        repo,
        agent_config,
        runner=runner,
        prompt_rel=prompt_rel,
        cwd=worktree,
        role_id=review_attempt_id,
        attempt_id=attempt_id,
        output_rel=review_rel if runner == "exec" else None,
    )
    command = f"cd {shlex.quote(str(worktree))} && {agent_command}"
    if args.dry_run:
        print(
            f"DRY RUN worktree: git worktree add --detach {worktree} {seal.candidate_sha}"
        )
        print(f"DRY RUN prompt: {worktree / prompt_rel}")
        print(f"DRY RUN {args.launcher}/{runner} command: {command}")
        return 0
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_agent_invocation=preview_invocation,
        require_integration_branch=True,
    )
    task_state = (state.get("tasks") or {}).get(task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"Patch Review task disappeared before start: {task_id}")
    if task_state.get("candidate_lifecycle_status") != "patch_review_pending":
        raise HLoopError(
            f"Patch Review became non-startable for {task_id}: "
            f"{task_state.get('candidate_lifecycle_status') or 'missing candidate'}"
        )
    _, seal, _ = current_candidate_evidence(repo, state, task_id, task_state)
    if (
        seal.candidate_sha != initial_candidate_sha
        or seal.candidate_artifact_digest != initial_candidate_artifact_digest
    ):
        raise HLoopError(f"Patch Review target candidate changed before start: {task_id}")
    current_round = len(task_patch_review_history(task_state)) + 1
    if current_round != round_number:
        raise HLoopError(f"Patch Review round changed before start: {task_id}")
    if review_attempt_id in (state.get("patch_reviews") or {}):
        raise HLoopError(f"Patch Review already exists: {review_attempt_id}")
    state.setdefault("patch_reviews", {})
    worktree_preexisting = worktree.exists()
    if not worktree_preexisting:
        git(repo, ["worktree", "add", "--detach", str(worktree), seal.candidate_sha])
    try:
        prepare_role_worktree(
            repo, worktree, state, role="reviewer", agent_id=review_attempt_id
        )
        ensure_task_visible_in_worktree(worktree, task_id)
        ensure_worktree_parent_dirs(worktree, prompt_rel, review_rel)
        credential, ack_floor = register_role_report_identity_and_ack_floor(
            repo,
            state,
            role_id=review_attempt_id,
            attempt_id=attempt_id,
            task_contract_digest=review_contract_digest,
        )
        prompt = render_patch_reviewer_prompt(
            state,
            task_id,
            meta,
            seal,
            review_attempt_id=review_attempt_id,
            review_round=round_number,
            agent_config=agent_config,
            attempt_id=attempt_id,
            task_contract_digest=review_contract_digest,
            report_credential_file=str(credential),
        )
        write_text(worktree / prompt_rel, prompt)
        baseline_dirty = role_scope_paths(worktree)
        if args.launcher == "agent":
            pane_id = start_agent_launcher(
                name=f"hloop-{state['goal_id']}-{review_attempt_id}-patch-reviewer",
                direction=args.direction,
                cwd=worktree,
                command=command,
            )
        else:
            pane_id = start_pane_launcher(
                manager_pane=args.manager_pane or current_pane_id(),
                direction=args.direction,
                cwd=worktree,
                command=command,
            )
    except BaseException:
        try:
            rollback_failed_role_start(
                repo, worktree, created_worktree=not worktree_preexisting
            )
        finally:
            revoke_active_role_report_identity(repo, state, review_attempt_id)
        raise
    review_state = {
        "status": "running",
        "gate_status": "running",
        "task_id": task_id,
        "task_attempt_id": seal.attempt_id,
        "review_attempt_id": review_attempt_id,
        "review_round": round_number,
        "candidate_sha": seal.candidate_sha,
        "candidate_artifact_digest": seal.candidate_artifact_digest,
        "task_contract_digest": review_contract_digest,
        "sealed_task_contract_digest": seal.task_contract_digest,
        "attempt_id": attempt_id,
        "pane_id": pane_id,
        "worktree": str(worktree),
        "prompt": str(worktree / prompt_rel),
        "review_path": str(worktree / review_rel),
        "baseline_dirty_files": baseline_dirty,
        "agent_provider": agent_config["provider"],
        "agent_model": agent_config["model"],
        "agent_effort": agent_config["effort"],
        "runner": runner,
        "provider_invocation": preview_invocation.as_record(),
        "started_at": now_iso(),
    }
    arm_initial_semantic_ack_barrier(
        review_state,
        attempt_id=attempt_id,
        contract_digest=review_contract_digest,
        required_reack_after_sequence=ack_floor,
    )
    state["patch_reviews"][review_attempt_id] = review_state
    task_state["active_patch_review_id"] = review_attempt_id
    task_state["candidate_lifecycle_status"] = "patch_review_running"
    state["phase"] = "running"
    save_state(repo, state)
    journal(
        repo,
        f"Started Patch Reviewer `{review_attempt_id}` for `{task_id}` "
        f"at candidate `{seal.candidate_sha}`.",
    )
    print(f"started Patch Review {review_attempt_id} in pane {pane_id}")
    return 0


def cmd_patch_review_record(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    task_id = args.task_id
    task_state = (state.get("tasks") or {}).get(task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"unknown task: {task_id}")
    _, seal, _ = current_candidate_evidence(repo, state, task_id, task_state)
    history = task_patch_review_history(task_state)
    requested_attempt = args.review_attempt_id
    existing = next(
        (
            item
            for item in history
            if requested_attempt
            and item.review_attempt_id == requested_attempt
        ),
        None,
    )
    if (
        task_state.get("candidate_lifecycle_status")
        not in {"patch_review_pending", "patch_review_running"}
        and existing is None
    ):
        raise HLoopError(f"task {task_id} has no pending Patch Review")
    review_round = existing.review_round if existing is not None else len(history) + 1
    review_attempt_id = requested_attempt or f"PR-{task_id}-R{review_round:03d}"
    try:
        review = hloop_worker_candidate.record_patch_review(
            seal,
            review_attempt_id=review_attempt_id,
            review_round=review_round,
            reviewer_provider=args.reviewer_provider,
            reviewer_model=args.reviewer_model,
            reviewer_effort=args.reviewer_effort,
            verdict=args.verdict,
            unresolved_finding_fingerprints=normalize_list(
                args.unresolved_finding_fingerprint
            ),
            follow_up_finding_fingerprints=normalize_list(
                args.follow_up_finding_fingerprint
            ),
        )
    except hloop_worker_candidate.WorkerCandidateError as exc:
        raise HLoopError(f"invalid Patch Review: {exc}") from exc
    path = patch_review_file(
        repo, task_id, seal.attempt_id, review.review_attempt_id
    )
    payload = exact_json_bytes(review.to_record())
    if path.exists() and path.read_bytes() != payload:
        raise HLoopError(
            f"Patch Review attempt already has different artifact bytes: {path}"
        )
    write_text(path, payload.decode("utf-8"), durable=True)
    decision = apply_patch_review_record(
        repo, state, task_id, task_state, review
    )
    save_state(repo, state)
    journal(
        repo,
        f"Recorded Patch Review `{review.review_attempt_id}` for `{task_id}`: "
        f"{review.verdict}; next={decision.action}.",
    )
    print(
        f"recorded Patch Review {review.review_attempt_id}: "
        f"verdict={review.verdict} next={decision.action}"
    )
    return 2 if decision.requires_user_decision else 0


def cmd_patch_review_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo, require_herdr=True, require_integration_branch=True
    )
    review_attempt_id = args.review_attempt_id
    review_state = (state.get("patch_reviews") or {}).get(review_attempt_id)
    if not isinstance(review_state, dict):
        raise HLoopError(f"unknown Patch Review: {review_attempt_id}")
    block_reason = semantic_ack_barrier_blocking(review_state)
    if block_reason:
        raise HLoopError(f"cannot harvest {review_attempt_id}: {block_reason}")
    task_id = str(review_state.get("task_id") or "")
    task_state = state["tasks"].get(task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"Patch Review task is missing: {task_id}")
    _, seal, _ = current_candidate_evidence(repo, state, task_id, task_state)
    if str(review_state.get("candidate_sha") or "") != seal.candidate_sha:
        raise HLoopError(f"Patch Review target candidate is stale: {review_attempt_id}")
    expected_review_projection = {
        "task_attempt_id": seal.attempt_id,
        "candidate_artifact_digest": seal.candidate_artifact_digest,
        "sealed_task_contract_digest": seal.task_contract_digest,
    }
    for field, expected in expected_review_projection.items():
        if review_state.get(field) != expected:
            raise HLoopError(
                f"Patch Review target projection is stale: {field} changed"
            )
    worktree_raw = str(review_state.get("worktree") or "")
    if not worktree_raw:
        raise HLoopError(f"Patch Review worktree is missing: {review_attempt_id}")
    worktree = Path(worktree_raw).resolve()
    if not worktree.is_dir():
        raise HLoopError(f"Patch Review worktree is unavailable: {worktree}")
    if git(worktree, ["rev-parse", "HEAD"]) != seal.candidate_sha:
        raise HLoopError(
            f"Patch Review worktree no longer targets the sealed candidate: {review_attempt_id}"
        )
    source = patch_review_file(
        worktree, task_id, seal.attempt_id, review_attempt_id
    )
    if not source.is_file():
        raise HLoopError(f"Patch Review artifact is missing: {source}")
    payload = source.read_bytes()
    try:
        review = hloop_worker_candidate.PatchReview.from_record(json.loads(payload))
    except (
        json.JSONDecodeError,
        hloop_worker_candidate.WorkerCandidateError,
    ) as exc:
        raise HLoopError(f"invalid Patch Review artifact {source}: {exc}") from exc
    if review.review_attempt_id != review_attempt_id:
        raise HLoopError("Patch Review attempt identity mismatch")
    if review.review_round != int(review_state.get("review_round") or 0):
        raise HLoopError("Patch Review round identity mismatch")
    reviewer_identity = (
        review.reviewer_provider,
        review.reviewer_model,
        review.reviewer_effort,
    )
    expected_reviewer_identity = (
        str(review_state.get("agent_provider") or ""),
        str(review_state.get("agent_model") or ""),
        str(review_state.get("agent_effort") or ""),
    )
    if reviewer_identity != expected_reviewer_identity:
        raise HLoopError(
            "Patch Review reviewer identity mismatch: "
            f"expected={expected_reviewer_identity} observed={reviewer_identity}"
        )
    if exact_product_dirty_paths(worktree):
        raise HLoopError("Patch Reviewer changed product files")
    baseline = set(normalize_list(review_state.get("baseline_dirty_files")))
    current_paths = set(role_scope_paths(worktree))
    unexpected = current_paths - baseline - {patch_review_rel(task_id, seal.attempt_id, review_attempt_id).as_posix()}
    if unexpected:
        raise HLoopError(
            "Patch Reviewer changed files outside its artifact: "
            + ", ".join(sorted(unexpected))
        )
    target = patch_review_file(
        repo, task_id, seal.attempt_id, review_attempt_id
    )
    write_text(target, payload.decode("utf-8"), durable=True)
    decision = apply_patch_review_record(
        repo, state, task_id, task_state, review
    )
    review_state.update(
        {
            "status": "reported",
            "gate_status": "reported",
            "verdict": review.verdict,
            "artifact_path": str(target),
            "harvested_at": now_iso(),
        }
    )
    cleanup_completed_agent_pane(
        repo,
        review_state,
        label=f"Patch Reviewer {review_attempt_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    revoke_active_role_report_identity(repo, state, review_attempt_id)
    if worktree.exists() and worktree != repo:
        try:
            git(repo, ["worktree", "remove", "--force", str(worktree)])
            review_state["worktree_cleanup_status"] = "removed"
            review_state["worktree_cleaned_at"] = now_iso()
        except (HLoopError, subprocess.CalledProcessError) as exc:
            record_worktree_cleanup_failure(
                repo, review_state, f"Patch Reviewer {review_attempt_id}", exc
            )
    save_state(repo, state)
    journal(
        repo,
        f"Harvested Patch Review `{review_attempt_id}` for `{task_id}`: "
        f"{review.verdict}; next={decision.action}.",
    )
    print(
        f"harvested Patch Review {review_attempt_id}: "
        f"verdict={review.verdict} next={decision.action}"
    )
    return 2 if decision.requires_user_decision else 0


def cmd_patch_review_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    task_state = (state.get("tasks") or {}).get(args.task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"unknown task: {args.task_id}")
    payload = {
        "task_id": args.task_id,
        "candidate_lifecycle_status": task_state.get(
            "candidate_lifecycle_status", ""
        ),
        "candidate_revision": task_state.get("candidate_revision", 0),
        "candidate_sha": task_state.get("candidate_sha", ""),
        "active_patch_review_id": task_state.get("active_patch_review_id", ""),
        "history": task_state.get("patch_review_history", []),
        "decision": task_state.get("patch_review_decision", {}),
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(
            f"{args.task_id}: {payload['candidate_lifecycle_status'] or 'not-submitted'} "
            f"candidate={payload['candidate_sha'] or '-'} "
            f"reviews={len(payload['history'])}"
        )
    return 0


def cmd_worker_accept_legacy_result(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    if not v053_state_contracts_enabled(state):
        raise HLoopError("legacy result acceptance is available only after 0.5.3 migration")
    task_id = args.task_id
    task_state = (state.get("tasks") or {}).get(task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"unknown task: {task_id}")
    if str(task_state.get("status") or "") != "result_reported":
        raise HLoopError(f"legacy result is not awaiting merge: {task_id}")
    task_meta = read_frontmatter(task_file(repo, task_id))
    if task_contract_revision(task_meta) == hloop_task_contract.V053_CONTRACT_SCHEMA_REVISION:
        raise HLoopError("revision 3 results cannot use legacy acceptance")
    result_path = result_file(repo, task_id)
    if not result_path.is_file():
        raise HLoopError(f"legacy result artifact is missing: {result_path}")
    result_meta = read_frontmatter(result_path)
    try:
        migrated = hloop_task_contract.migrate_legacy_result_contract(result_meta)
    except hloop_task_contract.ContractValidationError as exc:
        raise HLoopError(f"legacy result contract is invalid: {exc}") from exc
    replace_frontmatter_record(result_path, migrated)
    task_digest = hashlib.sha256(task_file(repo, task_id).read_bytes()).hexdigest()
    result_digest = _sha256_labelled(result_path.read_bytes())
    acceptance = {
        "run_id": str(state.get("run_id") or ""),
        "task_id": task_id,
        "attempt_id": active_attempt_id(task_id, task_state),
        "task_contract_digest": _labelled_contract_digest(task_digest),
        "result_artifact_digest": result_digest,
        "head_sha": str(task_state.get("head_sha") or ""),
        "reason": str(args.reason or "").strip(),
        "accepted_at": now_iso(),
    }
    if not acceptance["reason"]:
        raise HLoopError("legacy result acceptance requires --reason")
    if not acceptance["head_sha"]:
        raise HLoopError("legacy result acceptance requires an exact harvested head SHA")
    task_state["contract_schema_revision"] = (
        hloop_task_contract.LEGACY_CONTRACT_SCHEMA_REVISION
    )
    task_state["legacy_result_acceptance"] = acceptance
    save_state(repo, state)
    journal(
        repo,
        f"Accepted legacy revision 2 result for `{task_id}` at "
        f"`{acceptance['head_sha']}`: {acceptance['reason']}",
    )
    print(f"accepted legacy result for {task_id} at {acceptance['head_sha']}")
    return 0


def assert_legacy_result_merge_accepted(
    repo: Path,
    state: Mapping[str, Any],
    task_id: str,
    task_state: Mapping[str, Any],
) -> None:
    acceptance = task_state.get("legacy_result_acceptance")
    if not isinstance(acceptance, Mapping):
        raise HLoopError(
            f"legacy result {task_id} requires explicit Manager acceptance or "
            "revision 3 gates before merge"
        )
    result_path = result_file(repo, task_id)
    if not result_path.is_file():
        raise HLoopError(f"accepted legacy result artifact is missing: {result_path}")
    expected = {
        "run_id": str(state.get("run_id") or ""),
        "task_id": task_id,
        "attempt_id": active_attempt_id(task_id, task_state),
        "task_contract_digest": _labelled_contract_digest(
            hashlib.sha256(task_file(repo, task_id).read_bytes()).hexdigest()
        ),
        "result_artifact_digest": _sha256_labelled(result_path.read_bytes()),
        "head_sha": str(task_state.get("head_sha") or ""),
    }
    for field, value in expected.items():
        if acceptance.get(field) != value:
            raise HLoopError(
                f"legacy result acceptance is stale for {task_id}: {field} changed"
            )
    if not str(acceptance.get("reason") or "").strip():
        raise HLoopError(f"legacy result acceptance reason is missing for {task_id}")


def combined_candidate_validation(
    candidate: hloop_worker_candidate.ImplementationCandidate,
    commands: Sequence[str],
    results: Sequence[str],
) -> tuple[list[str], list[str], bool]:
    if len(commands) != len(results):
        raise HLoopError("--validation-command and --validation-result counts must match")
    supplied_pairs = list(zip(commands, results))
    invalid = [result for _, result in supplied_pairs if result != "passed"]
    if invalid:
        raise HLoopError(
            "revision 3 finalization requires every validation to pass: "
            + ", ".join(invalid)
        )
    candidate_pairs = list(
        zip(candidate.validation_commands, candidate.validation_results)
    )
    combined = list(candidate_pairs)
    for pair in supplied_pairs:
        if pair not in combined:
            combined.append(pair)
    extra_gate = any(pair not in candidate_pairs for pair in supplied_pairs)
    return (
        [command for command, _ in combined],
        [result for _, result in combined],
        extra_gate,
    )


def validate_revision_three_final_gate(
    repo: Path,
    state: dict[str, Any],
    task_id: str,
    task_state: dict[str, Any],
    meta: Mapping[str, Any],
    *,
    validation_commands: Sequence[str],
    validation_results: Sequence[str],
) -> tuple[
    hloop_worker_candidate.ImplementationCandidate,
    hloop_worker_candidate.CandidateSeal,
    hloop_worker_candidate.PatchReview | None,
    list[str],
    list[str],
]:
    candidate, seal, payload = current_candidate_evidence(
        repo, state, task_id, task_state
    )
    lifecycle = str(task_state.get("candidate_lifecycle_status") or "")
    gates = task_required_gates(meta)
    if "patch_review" in gates and lifecycle != "patch_review_passed":
        raise HLoopError(
            f"required Patch Review has not passed for {task_id}: {lifecycle or 'missing'}"
        )
    if "patch_review" not in gates and lifecycle != "candidate_sealed":
        raise HLoopError(
            f"candidate is not sealed for finalization: {lifecycle or 'missing'}"
        )
    _, labelled_contract_digest = exact_task_contract_digest(repo, task_id, task_state)
    review = fresh_passed_patch_review(
        repo,
        task_id,
        task_state,
        seal,
        current_task_contract_digest=labelled_contract_digest,
    )
    if "patch_review" in gates and review is None:
        raise HLoopError(f"required Patch Review evidence is missing for {task_id}")
    combined_commands, combined_results, has_extra_gate = combined_candidate_validation(
        candidate, validation_commands, validation_results
    )
    if "full_suite" in gates and not has_extra_gate:
        raise HLoopError(
            "required full_suite evidence must add at least one passing validation "
            "command beyond the candidate L1 record"
        )
    if _sha256_labelled(payload) != seal.candidate_artifact_digest:
        raise HLoopError(f"candidate artifact digest changed for {task_id}")
    return candidate, seal, review, combined_commands, combined_results


def cmd_worker_finalize_v053(
    args: argparse.Namespace,
    repo: Path,
    contract_repo: Path,
    state: dict[str, Any],
    task_id: str,
    task_state: dict[str, Any],
    meta: Mapping[str, Any],
) -> int:
    validate_revision_three_task(meta, task_id=task_id)
    branch = current_branch(repo)
    expected_branch = str(task_state.get("branch") or meta.get("branch") or "")
    if expected_branch and branch != expected_branch:
        raise HLoopError(f"Worker branch mismatch: expected {expected_branch}, got {branch}")
    expected_worktree = str(task_state.get("worktree") or "")
    if expected_worktree and repo != Path(expected_worktree).resolve():
        raise HLoopError(
            f"worker finalize must run in the active attempt worktree: "
            f"expected {expected_worktree}, got {repo}"
        )
    status = str(args.status)
    handoff = bool(getattr(args, "handoff", False))
    if status == "done" and bool(getattr(args, "no_commit", False)) and not handoff:
        raise HLoopError(
            "revision 3 status done must commit the final result as an exact child "
            "of the sealed candidate"
        )
    result_rel = LOOP_DIR / "results" / task_id / "result.md"
    dirty_product = exact_product_dirty_paths(repo)
    if dirty_product:
        raise HLoopError(
            "revision 3 finalization requires the exact sealed candidate tree; "
            "dirty product paths: " + ", ".join(dirty_product)
        )
    commands = normalize_list(args.validation_command)
    results = normalize_list(args.validation_result)
    blocking_questions = normalize_list(args.blocking_question)
    candidate: hloop_worker_candidate.ImplementationCandidate | None = None
    seal: hloop_worker_candidate.CandidateSeal | None = None
    review: hloop_worker_candidate.PatchReview | None = None
    if status == "done":
        if blocking_questions:
            raise HLoopError("status done cannot retain blocking questions")
        candidate, seal, review, commands, results = validate_revision_three_final_gate(
            contract_repo,
            state,
            task_id,
            task_state,
            meta,
            validation_commands=commands,
            validation_results=results,
        )
        if repo != contract_repo:
            # Candidate evidence is Manager-owned, but the exact candidate commit
            # is checked in the active Worker worktree too.
            if git(repo, ["rev-parse", "HEAD"]) != seal.candidate_sha:
                raise HLoopError(
                    f"Worker HEAD is not the sealed candidate SHA: {seal.candidate_sha}"
                )
            observed_tree = git(repo, ["rev-parse", "HEAD^{tree}"])
            if observed_tree != seal.candidate_tree_sha:
                raise HLoopError("Worker candidate tree changed before finalization")
        if handoff != (candidate.completion_mode == "handoff"):
            raise HLoopError(
                "finalization mode must match the sealed candidate completion mode"
            )
        fields: dict[str, Any] = {
            "task_id": task_id,
            "run_id": candidate.run_id,
            "skill_version": candidate.skill_version,
            "contract_schema_revision": hloop_task_contract.V053_CONTRACT_SCHEMA_REVISION,
            "attempt_id": candidate.attempt_id,
            "status": "done",
            "merge_ready": True,
            "branch": branch,
            "head_sha": "HEAD",
            "base_sha": candidate.base_sha,
            "changed_files": list(candidate.changed_files),
            "validation_recorded": True,
            "validation_commands": commands,
            "validation_results": results,
            "validation_summary": str(args.validation_summary or candidate.validation_summary),
            "blocking_questions": [],
            "handoff": handoff,
            "invariant_evidence": list(candidate.invariant_evidence),
            "regression_evidence": list(candidate.regression_evidence),
            "self_review_summary": candidate.self_review_summary,
            "residual_risks": list(candidate.residual_risks),
            "unrun_checks": list(candidate.unrun_checks),
        }
        authenticity_record = dict(fields)
        authenticity_record["head_sha"] = seal.candidate_sha
        try:
            hloop_worker_candidate.validate_final_result_authenticity(
                candidate,
                seal,
                review,
                authenticity_record,
                candidate_artifact_digest=seal.candidate_artifact_digest,
                current_task_contract_digest=candidate.task_contract_digest,
                result_parent_candidate_sha=seal.candidate_sha,
                require_patch_review="patch_review" in task_required_gates(meta),
            )
        except hloop_worker_candidate.WorkerCandidateError as exc:
            raise HLoopError(f"final result authenticity gate rejected: {exc}") from exc
    else:
        if len(commands) != len(results):
            raise HLoopError("--validation-command and --validation-result counts must match")
        validation_recorded = bool(commands and results)
        validation_error = worker_validation_error(
            {
                "validation_recorded": validation_recorded,
                "validation_commands": commands,
                "validation_results": results,
            }
        )
        if validation_error:
            raise HLoopError(f"invalid Worker validation: {validation_error}")
        base_sha = str(task_state.get("worker_base_sha") or task_state.get("base_sha") or "")
        fields = {
            "task_id": task_id,
            "run_id": str(state.get("run_id") or meta.get("run_id") or ""),
            "skill_version": str(state.get("skill_version") or SKILL_VERSION),
            "contract_schema_revision": hloop_task_contract.V053_CONTRACT_SCHEMA_REVISION,
            "attempt_id": active_attempt_id(task_id, task_state),
            "status": status,
            "merge_ready": False,
            "branch": branch,
            "head_sha": "HEAD",
            "base_sha": base_sha,
            "changed_files": changed_files(repo, base_sha, "HEAD"),
            "validation_recorded": validation_recorded,
            "validation_commands": commands,
            "validation_results": results,
            "validation_summary": str(args.validation_summary or ""),
            "blocking_questions": blocking_questions,
            "handoff": handoff,
            "invariant_evidence": normalize_list(args.invariant_evidence),
            "regression_evidence": normalize_list(args.regression_evidence),
            "self_review_summary": str(args.self_review_summary or "not completed"),
            "residual_risks": normalize_list(args.residual_risk),
            "unrun_checks": normalize_list(args.unrun_check),
        }
        validation = hloop_task_contract.validate_result_contract(fields)
        if not validation.ok:
            raise HLoopError(
                "invalid revision 3 result: "
                + "; ".join(issue.message for issue in validation.issues)
            )
    body = f"# Worker Result {task_id}\n\nGenerated by `hloop worker finalize`.\n"
    write_text(repo / result_rel, frontmatter(fields) + "\n" + body)
    if handoff:
        print(
            "final result handoff recorded without terminal sentinel; ask the Manager "
            f"to run `{seal_required_action_text(task_id)}`"
        )
        return 0
    if not args.no_commit:
        git(repo, ["add", "-f", "--", result_rel.as_posix()])
        git(repo, ["commit", "-m", f"ai-loop({task_id}): finalize worker result"])
        result_head = git(repo, ["rev-parse", "HEAD"])
        if seal is not None:
            parents = commit_parent_shas(repo, result_head)
            if parents != (seal.candidate_sha,):
                raise HLoopError(
                    "final result commit is not an exact child of the sealed candidate"
                )
    print("finalized " + task_id + f": status={status} merge_ready={str(fields['merge_ready']).lower()}")
    print(
        f"HERDR_LOOP_ROLE_DONE:{fields['run_id']}:{task_id}:"
        f"{fields['attempt_id']}:{status}"
    )
    return 0


def cmd_worker_finalize(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    local_state = load_state(repo)
    task_id = args.task_id
    contract_repo, state = canonical_worker_contract_source(repo, task_id, local_state)
    task_state = state.get("tasks", {}).get(task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"unknown task: {task_id}")
    meta = read_frontmatter(task_file(contract_repo, task_id))
    if str(meta.get("id") or "") != task_id:
        raise HLoopError(f"task file mismatch for {task_id}")
    if task_contract_revision(meta) == hloop_task_contract.V053_CONTRACT_SCHEMA_REVISION:
        return cmd_worker_finalize_v053(
            args, repo, contract_repo, state, task_id, task_state, meta
        )
    branch = current_branch(repo)
    expected_branch = str(task_state.get("branch") or meta.get("branch") or "")
    if expected_branch and branch != expected_branch:
        raise HLoopError(f"Worker branch mismatch: expected {expected_branch}, got {branch}")
    expected_worktree = str(task_state.get("worktree") or "")
    if expected_worktree and repo.resolve() != Path(expected_worktree).resolve():
        raise HLoopError(
            f"worker finalize must run in the active attempt worktree: expected {expected_worktree}, got {repo}"
        )
    status = str(args.status)
    if str(task_state.get("result_status") or "") in {"blocked", "failed", "partial"} and status == "done":
        raise HLoopError("a terminal blocked/failed/partial attempt must be requeued before status done")
    if status == "done":
        block_reason = semantic_ack_barrier_blocking(task_state)
        if block_reason:
            raise HLoopError(f"cannot finalize status done for {task_id}: {block_reason}")
    result_rel = LOOP_DIR / "results" / task_id / "result.md"
    handoff = bool(getattr(args, "handoff", False))
    # Rename detection is disabled so a legitimate rename's source and
    # destination are both recorded as changed, rather than only the
    # destination surviving into `changed_files`.
    dirty_product = [path for path in porcelain_paths_no_renames(repo) if path != result_rel.as_posix()]
    if dirty_product and not handoff:
        raise HLoopError(
            "worker finalize requires product changes to be committed first; dirty paths: "
            + ", ".join(dirty_product)
        )
    if handoff:
        handoff_violations = validate_change_scope(task_id, meta, dirty_product)
        if handoff_violations:
            raise HLoopError("write-scope violations: " + "; ".join(handoff_violations))
    validation_commands = args.validation_command or []
    validation_results = args.validation_result or []
    blocking_questions = args.blocking_question or []
    validation_recorded = bool(validation_commands and validation_results)
    if len(validation_commands) != len(validation_results):
        raise HLoopError("--validation-command and --validation-result counts must match")
    validation_error = worker_validation_error(
        {
            "validation_recorded": validation_recorded,
            "validation_commands": validation_commands,
            "validation_results": validation_results,
        },
        require_recorded=status == "done",
        require_passing=status == "done",
    )
    if validation_error:
        raise HLoopError(f"invalid Worker validation for status {status}: {validation_error}")
    merge_ready = status == "done" and validation_recorded and not blocking_questions
    base_ref = str(task_state.get("base_ref") or meta.get("base_ref") or state.get("integration_branch") or "")
    if not base_ref:
        raise HLoopError(f"task base_ref is missing: {task_id}")
    base_proc = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "merge-base", "HEAD", base_ref], check=False
    )
    if base_proc.returncode != 0 or not (base_proc.stdout or "").strip():
        raise HLoopError(f"cannot resolve Worker branch point against {base_ref}")
    base_sha = str(task_state.get("worker_base_sha") or task_state.get("base_sha") or "")
    if not base_sha:
        base_sha = (base_proc.stdout or "").strip()
    if not is_ancestor(repo, base_sha, "HEAD"):
        raise HLoopError(f"active attempt base is not an ancestor of HEAD: {base_sha}")
    head_sha = git(repo, ["rev-parse", "HEAD"])
    files = changed_files(repo, base_sha, head_sha)
    files = list(dict.fromkeys([*files, *dirty_product, result_rel.as_posix()]))
    violations = validate_change_scope(task_id, meta, files)
    if violations:
        raise HLoopError("write-scope violations: " + "; ".join(violations))
    fields = {
        "task_id": task_id,
        "run_id": str(state.get("run_id") or meta.get("run_id") or ""),
        "skill_version": SKILL_VERSION,
        **(
            {
                "contract_schema_revision": hloop_task_contract.LEGACY_CONTRACT_SCHEMA_REVISION
            }
            if v053_state_contracts_enabled(state)
            else {}
        ),
        "attempt_id": str(task_state.get("active_attempt_id") or task_state.get("attempt_id") or ""),
        "status": status,
        "merge_ready": merge_ready,
        "branch": branch,
        "head_sha": "HEAD",
        "base_sha": base_sha,
        "changed_files": files,
        "validation_recorded": validation_recorded,
        "validation_commands": validation_commands,
        "validation_results": validation_results,
        "validation_summary": args.validation_summary or "",
        "blocking_questions": blocking_questions,
        "handoff": handoff,
    }
    body = f"# Worker Result {task_id}\n\nGenerated by `hloop worker finalize`.\n"
    write_text(repo / result_rel, frontmatter(fields) + "\n" + body)
    if handoff:
        print(
            "no Git metadata was written; ask the Manager to run "
            f"`{seal_required_action_text(task_id)}` to validate and commit this handoff"
        )
    if not handoff and not args.no_commit:
        # Loop artifacts are intentionally gitignored in some repositories. The
        # committed artifact is still the Worker/Manager hand-off contract, so
        # stage this one known path explicitly even in local-only loop setups.
        run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "add", "-f", "--", result_rel.as_posix()], check=True)
        staged = run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(repo), "diff", "--cached", "--quiet", "--", result_rel.as_posix()],
            check=False,
        )
        if staged.returncode == 1:
            run_cmd(
                [TRUSTED_GIT_PATH, "-C", str(repo), "commit", "-m", f"ai-loop({task_id}): finalize worker result"],
                check=True,
                capture=False,
            )
        elif staged.returncode != 0:
            raise HLoopError("failed to inspect staged result artifact")
    print(f"finalized {task_id}: status={status} merge_ready={str(merge_ready).lower()}")
    print(
        f"HERDR_LOOP_ROLE_DONE:{fields['run_id']}:{task_id}:{fields['attempt_id']}:{status}"
    )
    return 0


def seal_required_action_text(task_id: str) -> str:
    """The concrete command a Manager should run to seal a pending handoff.

    A status-`done` seal requires at least one Manager-measured
    `--validation-command`, so every seal-required user-facing action must
    show a concrete placeholder for it -- not just the bare `hloop worker
    seal <task-id>`, which a Manager could otherwise run and have fail on the
    missing-validation-command check without any hint why.
    """

    return f"hloop worker seal {task_id} --validation-command '<manager-approved-command>'"


def run_seal_validation_command(worktree: Path, command: str) -> tuple[bool, str]:
    validation_env = os.environ.copy()
    validation_env["PYTHONDONTWRITEBYTECODE"] = "1"
    proc = subprocess.run(
        command,
        cwd=str(worktree),
        text=True,
        shell=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        env=validation_env,
    )
    return proc.returncode == 0, proc.stdout or ""


def resolve_symlink_target(link_path: Path, target: str) -> str:
    """Fully canonicalize `target` (as read from `link_path`) to a real path.

    `os.path.realpath` resolves every symlink along the way, not just the
    textual `..` segments `os.path.normpath` alone would collapse. A target
    string that lexically looks contained under the worktree can still
    physically escape it if some directory component in the resolved path
    -- of the worktree itself, or of the target -- is a symlink pointing
    elsewhere (e.g. a symlinked temp-directory ancestor); canonicalizing
    both sides with `realpath` before comparing is the only way to judge
    containment correctly in either direction.
    """

    if os.path.isabs(target):
        candidate = target
    else:
        candidate = os.path.join(str(link_path.parent), target)
    return os.path.realpath(candidate)


def repair_tree_permissions(path: Path) -> None:
    """Give the current user enough permission to delete a disposable tree."""

    if not path.exists() and not path.is_symlink():
        return
    for root, dirnames, filenames in os.walk(path, topdown=False, followlinks=False):
        root_path = Path(root)
        for name in filenames:
            item = root_path / name
            if item.is_symlink():
                continue
            try:
                os.chmod(item, item.stat().st_mode | stat.S_IRUSR | stat.S_IWUSR)
            except FileNotFoundError:
                pass
        for name in dirnames:
            item = root_path / name
            if item.is_symlink():
                continue
            try:
                os.chmod(item, item.stat().st_mode | stat.S_IRUSR | stat.S_IWUSR | stat.S_IXUSR)
            except FileNotFoundError:
                pass
        if not root_path.is_symlink():
            try:
                os.chmod(
                    root_path,
                    root_path.stat().st_mode | stat.S_IRUSR | stat.S_IWUSR | stat.S_IXUSR,
                )
            except FileNotFoundError:
                pass


def remove_validation_snapshot(snapshot: Path) -> None:
    """Remove a snapshot, repairing read-only content and failing visibly.

    Validation is not successful while its supposedly disposable filesystem
    remains live.  In particular, formatter/build commands commonly create
    read-only artifacts, so retry once after repairing owner permissions and
    retain the path in the final error when deletion still fails.
    """

    if not snapshot.exists() and not snapshot.is_symlink():
        return
    first_error: Exception | None = None
    try:
        shutil.rmtree(snapshot)
        return
    except Exception as exc:  # permission repair is the deliberate fallback
        first_error = exc
    try:
        repair_tree_permissions(snapshot)
        shutil.rmtree(snapshot)
    except Exception as exc:
        raise HLoopError(
            f"failed to remove validation snapshot; retained path: {snapshot}; "
            f"initial error: {first_error}; retry error: {exc}"
        ) from exc


def git_metadata_path(worktree: Path, name: str) -> Path:
    raw = git(worktree, ["rev-parse", "--path-format=absolute", "--git-path", name])
    return Path(raw).resolve()


def noncanonical_index_flags(worktree: Path) -> dict[str, list[str]]:
    """Return assume-unchanged/skip-worktree entries in one Git index."""

    result: dict[str, list[str]] = {}
    for option, flag in (("-v", "assume-unchanged"), ("-t", "skip-worktree")):
        proc = run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(worktree), "ls-files", option, "-z"],
            check=False,
        )
        if proc.returncode != 0:
            raise HLoopError(
                f"cannot inspect Git index flags for {worktree}: "
                + (proc.stderr or proc.stdout or "git ls-files failed").strip()
            )
        for record in (proc.stdout or "").split("\0"):
            if len(record) < 3 or record[1] != " ":
                continue
            tag, path = record[0], record[2:]
            active = tag.islower() if flag == "assume-unchanged" else tag.upper() == "S"
            if active:
                result.setdefault(path, []).append(flag)
    return result


def assert_canonical_git_index(worktree: Path, *, label: str = "source") -> None:
    flagged = noncanonical_index_flags(worktree)
    if not flagged:
        return
    details = "; ".join(
        f"{path} ({', '.join(sorted(set(flags)))})" for path, flags in sorted(flagged.items())
    )
    paths = " ".join(shlex.quote(path) for path in sorted(flagged))
    raise HLoopError(
        f"cannot build an immutable seal from non-canonical {label} index flags: {details}. "
        "Clear them before retrying with "
        f"`git -C {shlex.quote(str(worktree))} update-index --no-assume-unchanged "
        f"--no-skip-worktree -- {paths}`"
    )


def discover_nested_git_worktrees(worktree: Path) -> list[Path]:
    """Find initialized Git worktrees below (but not including) `worktree`."""

    nested: list[Path] = []
    for root, dirnames, filenames in os.walk(worktree, topdown=True, followlinks=False):
        root_path = Path(root)
        if ".git" in dirnames:
            dirnames.remove(".git")
            if root_path != worktree:
                nested.append(root_path)
        elif ".git" in filenames and root_path != worktree:
            nested.append(root_path)
    return sorted(set(nested), key=lambda path: (len(path.parts), path.as_posix()))


def snapshot_symlink_target(worktree: Path, snapshot: Path, link_path: Path, target: str) -> str:
    """Return the target a symlink must carry inside the isolated snapshot.

    A symlink whose target resolves outside `worktree` could let a
    validation command read or write arbitrary filesystem paths through it,
    even from inside the disposable snapshot -- there is no way to isolate
    that, so fail closed before running anything rather than silently copy
    an escape hatch. A relative target that stays inside `worktree`
    continues to resolve correctly once the directory layout is reproduced
    structurally in the snapshot, so it is copied unchanged. An absolute
    target that points inside `worktree` is rewritten to the equivalent
    absolute path inside the snapshot, so following it lands on isolated
    content instead of leaking back into the original worktree.
    """

    worktree_real = os.path.realpath(str(worktree))
    resolved = resolve_symlink_target(link_path, target)
    if resolved != worktree_real and not resolved.startswith(worktree_real + os.sep):
        raise HLoopError(
            "cannot build isolated validation snapshot: symlink "
            f"{link_path.relative_to(worktree).as_posix()} targets {target!r}, which "
            "resolves outside the worktree and cannot be safely isolated"
        )
    if os.path.isabs(target):
        return str(snapshot) + resolved[len(worktree_real):]
    return target


def copy_worktree_tree_entry(worktree: Path, snapshot: Path, source: Path, destination: Path) -> None:
    """Reproduce `source` at `destination` inside `snapshot`, recursing into directories."""

    if source.is_symlink():
        if destination.exists() or destination.is_symlink():
            if destination.is_dir() and not destination.is_symlink():
                shutil.rmtree(destination)
            else:
                destination.unlink()
        target = os.readlink(source)
        destination.parent.mkdir(parents=True, exist_ok=True)
        os.symlink(snapshot_symlink_target(worktree, snapshot, source, target), destination)
    elif source.is_dir():
        if destination.is_symlink() or (destination.exists() and not destination.is_dir()):
            destination.unlink()
        destination.mkdir(parents=True, exist_ok=True)
        for entry in source.iterdir():
            if entry.name == ".git":
                continue
            copy_worktree_tree_entry(worktree, snapshot, entry, destination / entry.name)
        # Preserve directory mode/mtime too, once its content has finished
        # copying -- otherwise a later write into it above would bump mtime
        # again after copystat ran.
        shutil.copystat(source, destination, follow_symlinks=False)
    else:
        if destination.is_symlink() or (destination.exists() and destination.is_dir()):
            if destination.is_dir() and not destination.is_symlink():
                shutil.rmtree(destination)
            else:
                destination.unlink()
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)


def ignored_worktree_paths(worktree: Path) -> list[Path]:
    proc = run_cmd(
        [
            TRUSTED_GIT_PATH,
            "-C",
            str(worktree),
            "ls-files",
            "--others",
            "--ignored",
            "--exclude-standard",
            "--directory",
            "-z",
        ],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError(
            "cannot enumerate ignored validation dependencies: "
            + (proc.stderr or proc.stdout or "git ls-files failed").strip()
        )
    return [worktree / path for path in (proc.stdout or "").split("\0") if path]


def overlay_empty_directories(worktree: Path, snapshot: Path) -> None:
    for root, dirnames, filenames in os.walk(worktree, topdown=True, followlinks=False):
        if ".git" in dirnames:
            dirnames.remove(".git")
        root_path = Path(root)
        if root_path == worktree or dirnames or filenames:
            continue
        destination = snapshot / root_path.relative_to(worktree)
        destination.mkdir(parents=True, exist_ok=True)
        shutil.copystat(root_path, destination, follow_symlinks=False)


def isolate_materialized_tree_symlinks(worktree: Path, snapshot: Path) -> None:
    """Reject escaping tree symlinks and rewrite absolute internal targets."""

    snapshot_real = os.path.realpath(str(snapshot))
    for root, dirnames, filenames in os.walk(snapshot, topdown=True, followlinks=False):
        root_path = Path(root)
        if root_path == snapshot and ".git" in dirnames:
            dirnames.remove(".git")
        candidates: list[Path] = []
        for name in list(dirnames):
            item = root_path / name
            if item.is_symlink():
                dirnames.remove(name)
                candidates.append(item)
        candidates.extend(
            root_path / name for name in filenames if (root_path / name).is_symlink()
        )
        for link in candidates:
            target = os.readlink(link)
            relative = link.relative_to(snapshot)
            if os.path.isabs(target):
                isolated = snapshot_symlink_target(
                    worktree, snapshot, worktree / relative, target
                )
                if isolated != target:
                    link.unlink()
                    os.symlink(isolated, link)
                continue
            resolved = os.path.realpath(str(link.parent / target))
            if resolved != snapshot_real and not resolved.startswith(snapshot_real + os.sep):
                raise HLoopError(
                    "cannot build isolated validation snapshot: symlink "
                    f"{relative.as_posix()} targets {target!r}, which resolves outside "
                    "the worktree and cannot be safely isolated"
                )


def copy_status_relevant_git_config(source: Path, destination: Path) -> None:
    """Copy effective config that can affect status/diff interpretation."""

    keys = (
        "core.filemode",
        "core.ignorecase",
        "core.symlinks",
        "core.precomposeunicode",
        "core.excludesfile",
        "diff.ignoresubmodules",
    )
    for key in keys:
        value = git(source, ["config", "--get", key], check=False)
        if value:
            run_cmd(
                [TRUSTED_GIT_PATH, "-C", str(destination), "config", "--local", key, value],
                check=True,
            )
    submodule_config = run_cmd(
        [
            TRUSTED_GIT_PATH,
            "-C",
            str(source),
            "config",
            "--get-regexp",
            r"^submodule\..*\.ignore$",
        ],
        check=False,
    )
    for line in (submodule_config.stdout or "").splitlines():
        if not line.strip() or " " not in line:
            continue
        key, value = line.split(None, 1)
        run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(destination), "config", "--local", key, value],
            check=True,
        )


def remove_snapshot_remotes(snapshot_repo: Path) -> None:
    """Prevent an ordinary snapshot `git push` from targeting the source repo."""

    remotes = git(snapshot_repo, ["remote"], check=False).splitlines()
    for remote in remotes:
        if remote.strip():
            run_cmd(
                [TRUSTED_GIT_PATH, "-C", str(snapshot_repo), "remote", "remove", remote],
                check=True,
            )


def index_object_ids(worktree: Path) -> list[str]:
    output = git_bytes(worktree, ["ls-files", "--stage", "-z"])
    object_ids: list[str] = []
    for record in split_nul_records(output, command="git ls-files --stage -z"):
        match = re.match(rb"^([0-7]{6}) ([0-9a-f]{40,64}) [0-3]\t", record)
        if match and match.group(1) != b"160000":
            # A gitlink records a commit owned by the nested repository, not
            # necessarily by this superproject's object store.
            object_ids.append(match.group(2).decode("ascii"))
    return list(dict.fromkeys(object_ids))


def dissociate_snapshot_object_store(snapshot_repo: Path, protected_objects: list[str]) -> None:
    """Remove any copied alternates after packing every required object locally."""

    alternates = git_metadata_path(snapshot_repo, "objects/info/alternates")
    if not alternates.is_file():
        return
    temporary_refs: list[str] = []
    for index, object_id in enumerate(dict.fromkeys(protected_objects), start=1):
        if not object_id:
            continue
        reference = f"refs/hloop-snapshot/protected-{index}"
        run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(snapshot_repo), "update-ref", reference, object_id],
            check=True,
        )
        temporary_refs.append(reference)
    run_cmd([TRUSTED_GIT_PATH, "-C", str(snapshot_repo), "repack", "-a", "-d"], check=True)
    for reference in temporary_refs:
        run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(snapshot_repo), "update-ref", "-d", reference],
            check=True,
        )
    alternates.unlink()
    for object_id in protected_objects:
        if object_id:
            run_cmd(
                [TRUSTED_GIT_PATH, "-C", str(snapshot_repo), "cat-file", "-e", object_id],
                check=True,
            )


def git_status_diff_observation(worktree: Path) -> tuple[str, str, str]:
    commands = (
        ["status", "--porcelain=v1", "--untracked-files=all", "--no-renames"],
        ["diff", "--no-renames"],
        ["diff", "--cached", "--no-renames"],
    )
    return tuple(git(worktree, command, check=True) for command in commands)  # type: ignore[return-value]


def recreate_nested_git_worktree(source: Path, worktree: Path, snapshot: Path) -> None:
    """Overlay one nested worktree with an independent Git dir/index/store."""

    relative = source.relative_to(worktree)
    destination = snapshot / relative
    destination.mkdir(parents=True, exist_ok=True)
    for entry in source.iterdir():
        if entry.name == ".git":
            continue
        copy_worktree_tree_entry(worktree, snapshot, entry, destination / entry.name)

    source_head = git(source, ["rev-parse", "HEAD"])
    protected_objects = [source_head, *index_object_ids(source)]
    clone_target = Path(tempfile.mkdtemp(prefix="hloop-nested-", dir=str(snapshot / ".git")))
    clone = run_cmd(
        [
            TRUSTED_GIT_PATH,
            "clone",
            "--local",
            "--no-hardlinks",
            "--no-checkout",
            "--quiet",
            str(source),
            str(clone_target),
        ],
        check=False,
    )
    if clone.returncode != 0:
        raise HLoopError(
            f"failed to recreate nested Git worktree {relative.as_posix()}: "
            + (clone.stderr or clone.stdout or "git clone failed").strip()
        )
    dissociate_snapshot_object_store(clone_target, protected_objects)
    nested_git = destination / ".git"
    if nested_git.exists() or nested_git.is_symlink():
        raise HLoopError(
            f"validation snapshot unexpectedly materialized nested .git at {relative.as_posix()}"
        )
    shutil.move(str(clone_target / ".git"), str(nested_git))
    clone_target.rmdir()

    source_symbolic_head = git(source, ["symbolic-ref", "-q", "HEAD"], check=False)
    if source_symbolic_head:
        run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(destination), "update-ref", source_symbolic_head, source_head],
            check=True,
        )
        run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(destination), "symbolic-ref", "HEAD", source_symbolic_head],
            check=True,
        )
    else:
        run_cmd(
            [
                TRUSTED_GIT_PATH,
                "-C",
                str(destination),
                "update-ref",
                "--no-deref",
                "HEAD",
                source_head,
            ],
            check=True,
        )
    source_index = git_metadata_path(source, "index")
    if source_index.is_file():
        shutil.copy2(source_index, nested_git / "index")
        for shared_index in source_index.parent.glob("sharedindex.*"):
            if shared_index.is_file():
                shutil.copy2(shared_index, nested_git / shared_index.name)
    else:
        run_cmd([TRUSTED_GIT_PATH, "-C", str(destination), "read-tree", "HEAD"], check=True)
    remove_snapshot_remotes(destination)
    copy_status_relevant_git_config(source, destination)
    source_observation = git_status_diff_observation(source)
    snapshot_observation = git_status_diff_observation(destination)
    if snapshot_observation != source_observation:
        raise HLoopError(
            f"nested Git snapshot parity mismatch at {relative.as_posix()}: "
            f"source={source_observation!r} snapshot={snapshot_observation!r}"
        )


def build_validation_snapshot(worktree: Path, staged_tree: str, expected_parent: str) -> Path:
    """Build an immutable, Git-aware snapshot of one recorded seal tree.

    The root index and filesystem come from `staged_tree`, never from the
    mutable source worktree.  Only ignored files and empty directories are
    overlaid as validation dependencies.  Initialized repositories below the
    root (including linked-worktree submodules whose `.git` is a file) get a
    no-hardlink local clone, the exact source index and HEAD, and an exact
    working-filesystem overlay.  Thus status/diff remain useful at every
    repository boundary while validation-side index/ref/object mutations are
    confined to the snapshot.
    """

    nested = discover_nested_git_worktrees(worktree)
    assert_canonical_git_index(worktree)
    for nested_worktree in nested:
        assert_canonical_git_index(
            nested_worktree,
            label=f"nested {nested_worktree.relative_to(worktree).as_posix()}",
        )

    snapshot = Path(tempfile.mkdtemp(prefix="hloop-seal-validate-"))
    try:
        clone = run_cmd(
            [
                TRUSTED_GIT_PATH,
                "clone",
                "--local",
                "--no-hardlinks",
                "--no-checkout",
                "--quiet",
                str(worktree),
                str(snapshot),
            ],
            check=False,
        )
        if clone.returncode != 0:
            raise HLoopError(
                "failed to build isolated validation snapshot: "
                + (clone.stderr or clone.stdout or "git clone failed").strip()
            )
        dissociate_snapshot_object_store(snapshot, [expected_parent, staged_tree])
        tree_exists = run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(snapshot), "cat-file", "-e", f"{staged_tree}^{{tree}}"],
            check=False,
        )
        if tree_exists.returncode != 0:
            raise HLoopError(
                f"recorded staged tree {staged_tree} is unavailable in the independent snapshot"
            )
        run_cmd(
            [
                TRUSTED_GIT_PATH,
                "-C",
                str(snapshot),
                "update-ref",
                "--no-deref",
                "HEAD",
                expected_parent,
            ],
            check=True,
        )
        remove_snapshot_remotes(snapshot)
        run_cmd([TRUSTED_GIT_PATH, "-C", str(snapshot), "read-tree", staged_tree], check=True)
        run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(snapshot), "checkout-index", "--all", "--force"],
            check=True,
        )
        isolate_materialized_tree_symlinks(worktree, snapshot)
        copy_status_relevant_git_config(worktree, snapshot)
        for source in ignored_worktree_paths(worktree):
            if source.exists() or source.is_symlink():
                copy_worktree_tree_entry(
                    worktree,
                    snapshot,
                    source,
                    snapshot / source.relative_to(worktree),
                )
        overlay_empty_directories(worktree, snapshot)
        for nested_worktree in nested:
            recreate_nested_git_worktree(nested_worktree, worktree, snapshot)
        if git(snapshot, ["write-tree"]) != staged_tree:
            raise HLoopError(
                "validation snapshot index does not match the recorded staged tree: "
                f"expected {staged_tree}, got {git(snapshot, ['write-tree'])}"
            )
    except Exception:
        remove_validation_snapshot(snapshot)
        raise
    return snapshot


def worker_result_contract_error(
    state: dict[str, Any],
    task_id: str,
    task_state: dict[str, Any],
    meta: dict[str, Any],
    *,
    expected_attempt: str,
    artifact_noun: str = "result",
) -> str:
    """One shared, fail-closed validator for the Worker result artifact contract.

    Used identically by the seal precheck (`read_worker_handoff_artifact`),
    `artifact_readiness`, and `cmd_worker_harvest` so a Worker result
    artifact can never be treated as valid by one call site and invalid (or
    validated more loosely) by another. Checks identity (task_id/run_id/
    skill_version), the exact active `attempt_id`, presence and *strict* type
    of every field `references/schemas/result.schema.json` marks `required`
    (`task_id`, `run_id`, `skill_version`, `attempt_id`, `status`,
    `merge_ready`, `branch`, `head_sha`, `base_sha`, `changed_files`,
    `validation_recorded`, `blocking_questions`), the type of every optional
    field the schema constrains when present, internal validation-record
    consistency, and the schema's `merge_ready` guard (only true for a
    `done` status with `validation_recorded` true and non-empty,
    equal-length, all-`passed` `validation_commands`/`validation_results`).
    Deliberately does not use `normalize_bool`/`normalize_list`, which
    silently coerce near-miss values (e.g. the string `"true"`, or a dict)
    into a bool/list -- the runtime contract must reject those outright
    rather than accept them loosely. `artifact_noun` only changes wording
    (e.g. "handoff" vs "result") to match each call site's established
    messages. Returns an empty string when the contract holds, otherwise a
    short, machine-checkable reason.
    """

    identity_error = artifact_identity_error(state, task_id, "worker", task_state, meta)
    if identity_error:
        return f"stale or mismatched Worker {artifact_noun} artifact: {identity_error}"

    # Required string fields (schema `required`, `type: string`).
    # `attempt_id` is required too, but is validated below against the exact
    # active attempt instead of a bare presence/type check, so an empty or
    # mismatched value fails closed with a distinct, more specific reason.
    for field in ("task_id", "run_id", "skill_version", "status", "branch", "head_sha", "base_sha"):
        value = meta.get(field)
        if type(value) is not str or not value.strip():
            return f"missing or invalid {field} in {artifact_noun} artifact"

    # Both sides of the attempt binding are mandatory. A missing active
    # attempt in Manager state is not permission to skip identity checking,
    # and a whitespace-only artifact value is not a valid attempt id.
    if type(expected_attempt) is not str or not expected_attempt.strip():
        return f"missing or invalid active attempt for {artifact_noun} artifact"
    raw_attempt = meta.get("attempt_id")
    reported_attempt = raw_attempt if type(raw_attempt) is str else ""
    if not reported_attempt.strip():
        return f"missing or invalid attempt_id in {artifact_noun} artifact"
    if reported_attempt != expected_attempt:
        return (
            f"{artifact_noun} attempt_id mismatch: expected active attempt {expected_attempt}, "
            f"got {reported_attempt}"
        )

    # Required boolean fields (schema `required`, `type: boolean`).
    for field in ("merge_ready", "validation_recorded"):
        if type(meta.get(field)) is not bool:
            return f"missing or invalid {field} in {artifact_noun} artifact"

    # Required string-array fields (schema `required`, `type: array` of
    # `string`).
    for field in ("changed_files", "blocking_questions"):
        value = meta.get(field)
        if type(value) is not list or not all(type(item) is str for item in value):
            return f"missing or invalid {field} in {artifact_noun} artifact"

    # Optional fields the schema still constrains by type when present.
    if "validation_commands" in meta:
        value = meta.get("validation_commands")
        if type(value) is not list or not all(type(item) is str for item in value):
            return f"invalid validation_commands in {artifact_noun} artifact"
    if "validation_results" in meta:
        value = meta.get("validation_results")
        if type(value) is not list or not all(
            type(item) is str and item in WORKER_VALIDATION_RESULTS for item in value
        ):
            return f"invalid validation_results in {artifact_noun} artifact"
    if "validation_summary" in meta and type(meta.get("validation_summary")) is not str:
        return f"invalid validation_summary in {artifact_noun} artifact"
    if "handoff" in meta and type(meta.get("handoff")) is not bool:
        return f"invalid handoff in {artifact_noun} artifact"

    status = meta["status"]
    if status not in TASK_STATUSES_FINAL:
        return f"invalid {artifact_noun} status: {status}"

    commands = meta.get("validation_commands") or []
    results = meta.get("validation_results") or []
    validation_recorded = meta["validation_recorded"]
    if validation_recorded:
        if not commands or not results:
            return (
                f"invalid validation record in {artifact_noun} artifact: validation_recorded "
                "requires non-empty commands and results"
            )
        if len(commands) != len(results):
            return (
                f"invalid validation record in {artifact_noun} artifact: validation command "
                "and result counts do not match"
            )
    elif commands or results:
        return (
            f"invalid validation record in {artifact_noun} artifact: validation evidence is "
            "present while validation_recorded is false"
        )

    # Schema `merge_ready` guard: true only for a `done` status with a
    # complete, fully passing, count-matched validation record.
    merge_ready = meta["merge_ready"]
    if merge_ready:
        if status != "done":
            return f"merge_ready is true for a non-done {artifact_noun} status"
        if not validation_recorded:
            return f"merge_ready is true without validation_recorded in {artifact_noun} artifact"
        if not commands or not results or len(commands) != len(results):
            return (
                f"merge_ready is true without complete, matching validation commands/results "
                f"in {artifact_noun} artifact"
            )
        if any(result != "passed" for result in results):
            return f"merge_ready is true with a non-passed validation result in {artifact_noun} artifact"
    declared_revision = task_contract_revision(meta)
    if v053_state_contracts_enabled(state) and declared_revision is None:
        return f"missing or invalid contract_schema_revision in {artifact_noun} artifact"
    task_revision = task_contract_revision(task_state)
    if task_revision == hloop_task_contract.V053_CONTRACT_SCHEMA_REVISION:
        if declared_revision != hloop_task_contract.V053_CONTRACT_SCHEMA_REVISION:
            return f"revision 3 task has non-revision-3 {artifact_noun} artifact"
        validation = hloop_task_contract.validate_result_contract(meta)
        if not validation.ok:
            return (
                f"invalid revision 3 {artifact_noun} artifact: "
                + "; ".join(issue.message for issue in validation.issues)
            )
    elif (
        v053_state_contracts_enabled(state)
        and declared_revision != hloop_task_contract.LEGACY_CONTRACT_SCHEMA_REVISION
    ):
        return f"legacy task has non-revision-2 {artifact_noun} artifact"
    return ""


def read_worker_handoff_artifact(
    result_path: Path,
    result_rel: Path,
    state: dict[str, Any],
    task_id: str,
    task_state: dict[str, Any],
    expected_attempt: str,
) -> dict[str, Any]:
    """Read-only: parse and validate a handoff `result.md` without mutating anything.

    Used both before the Worker pane is touched (so a genuinely incomplete
    handoff never causes an in-progress Worker's pane to be closed) and again
    right after, to detect the artifact having changed underneath the close.
    """

    if not result_path.exists():
        raise HLoopError(f"no handoff result artifact found to seal: {result_rel.as_posix()}")
    handoff_meta = parse_frontmatter_text(read_text(result_path))
    if not handoff_meta:
        raise HLoopError(f"handoff result artifact has no frontmatter: {result_rel.as_posix()}")
    if not normalize_bool(handoff_meta.get("handoff")):
        raise HLoopError(
            f"result artifact is not a durable handoff (missing handoff: true): {result_rel.as_posix()}"
        )
    contract_error = worker_result_contract_error(
        state, task_id, task_state, handoff_meta, expected_attempt=expected_attempt, artifact_noun="handoff"
    )
    if contract_error:
        raise HLoopError(f"{contract_error}: {result_rel.as_posix()}")
    return handoff_meta


def validate_recorded_seal_commit(
    worktree: Path,
    commit_sha: str,
    expected_tree: str,
    expected_parent: str,
    commit_message: str,
) -> None:
    """Fail closed unless `commit_sha` is exactly the recorded seal commit."""

    if not re.fullmatch(r"[0-9a-f]{40,64}", commit_sha):
        raise HLoopError(f"recorded seal commit has an invalid object id: {commit_sha or '(empty)'}")
    tree = git(worktree, ["show", "-s", "--format=%T", commit_sha])
    parents = git(worktree, ["rev-list", "--parents", "-n", "1", commit_sha]).split()
    message = git(worktree, ["show", "-s", "--format=%B", commit_sha])
    mismatches: list[str] = []
    if tree != expected_tree:
        mismatches.append(f"tree {tree} != recorded {expected_tree}")
    if parents != [commit_sha, expected_parent]:
        mismatches.append("parent does not match the recorded expected parent")
    if message != commit_message:
        mismatches.append("message does not match the recorded seal transaction")
    if mismatches:
        raise HLoopError(
            f"recorded seal commit {commit_sha} does not match its transaction: "
            + "; ".join(mismatches)
        )


def reconcile_seal_index(
    worktree: Path,
    task_id: str,
    branch_ref: str,
    commit_sha: str,
) -> None:
    """Reconcile the index to `commit_sha` without ever moving `branch_ref`.

    The mutable index is only a staging/recovery aid; `branch_ref` was
    already advanced to `commit_sha` by the compare-and-swap in
    `commit_recorded_seal_tree`. `git reset --mixed <commit>` reconciles the
    index too, but as a side effect it also *sets* the current branch ref to
    `<commit>` -- harmless when the ref is already there, but if another
    process advances the ref during this reconciliation window, a mixed
    reset would silently move it back and discard that concurrent commit's
    ref position. `git read-tree <commit>` only replaces the index, leaving
    HEAD/`branch_ref` and the working tree untouched, so verify `branch_ref`
    still equals the recorded `commit_sha` immediately before and after
    reconciling instead of relying on a command that could move it.
    """

    pre_ref = git(worktree, ["rev-parse", "-q", "--verify", branch_ref], check=False)
    if pre_ref != commit_sha:
        raise HLoopError(
            f"seal index reconciliation aborted for {task_id}: {branch_ref} is "
            f"{pre_ref or '(missing)'}, not the recorded seal commit {commit_sha}; "
            "preserving the concurrent ref movement and leaving the seal transaction "
            "in place for inspection"
        )
    run_cmd([TRUSTED_GIT_PATH, "-C", str(worktree), "read-tree", commit_sha], check=True)
    post_ref = git(worktree, ["rev-parse", "-q", "--verify", branch_ref], check=False)
    if post_ref != commit_sha:
        raise HLoopError(
            f"seal index reconciliation aborted for {task_id}: {branch_ref} advanced to "
            f"{post_ref or '(missing)'} during index reconciliation; preserving that "
            "concurrent advance and leaving the seal transaction in place for inspection"
        )


def discard_unvalidated_seal_transaction(
    repo: Path,
    state: dict[str, Any],
    task_id: str,
    task_state: dict[str, Any],
    worktree: Path,
    *,
    restore_result_path: Path | None = None,
    restore_result_text: str | None = None,
) -> None:
    """Unstage an unvalidated transaction without moving its branch ref."""

    transaction = task_state.get("seal_transaction")
    if not isinstance(transaction, dict):
        return
    expected_parent = str(transaction.get("expected_parent") or "")
    branch_ref = str(transaction.get("branch_ref") or "")
    if not expected_parent or not branch_ref:
        raise HLoopError(
            f"cannot reconcile incomplete unvalidated seal transaction for {task_id}"
        )
    reconcile_seal_index(worktree, task_id, branch_ref, expected_parent)
    if restore_result_path is not None and restore_result_text is not None:
        write_text(restore_result_path, restore_result_text)
    task_state.pop("seal_transaction", None)
    save_state(repo, state)


def commit_recorded_seal_tree(
    repo: Path,
    state: dict[str, Any],
    task_id: str,
    task_state: dict[str, Any],
    worktree: Path,
    expected_branch: str,
) -> str:
    """Commit the immutable seal tree and CAS-advance the Worker branch.

    The mutable index is only a staging/recovery aid. The commit object is
    always constructed from the transaction's durable `staged_tree` and
    `expected_parent`, then installed with `git update-ref <new> <old>`.
    Finally an index-only reconciliation (`reconcile_seal_index`) brings the
    index in line with the landed commit while preserving any concurrent
    worktree content as ordinary unstaged changes and never moving the
    branch ref itself.
    """

    transaction = task_state.get("seal_transaction")
    if not isinstance(transaction, dict):
        raise HLoopError(f"seal transaction disappeared before commit for {task_id}")
    expected_tree = str(transaction.get("staged_tree") or "")
    expected_parent = str(transaction.get("expected_parent") or "")
    commit_message = str(transaction.get("commit_message") or "")
    branch_ref = str(transaction.get("branch_ref") or "")
    required_ref = f"refs/heads/{expected_branch}"
    if not expected_tree or not expected_parent or not commit_message:
        raise HLoopError(f"seal transaction is incomplete before commit for {task_id}")
    if branch_ref != required_ref:
        raise HLoopError(
            f"seal transaction branch ref mismatch for {task_id}: "
            f"expected {required_ref}, got {branch_ref or '(empty)'}"
        )
    symbolic_head = git(worktree, ["symbolic-ref", "-q", "HEAD"], check=False)
    if symbolic_head != branch_ref:
        raise HLoopError(
            f"Worker HEAD is no longer attached to the recorded branch ref for {task_id}: "
            f"expected {branch_ref}, got {symbolic_head or '(detached)'}"
        )

    commit_sha = str(transaction.get("commit_sha") or "")
    if commit_sha:
        validate_recorded_seal_commit(
            worktree, commit_sha, expected_tree, expected_parent, commit_message
        )
    else:
        commit_sha = git(
            worktree,
            ["commit-tree", expected_tree, "-p", expected_parent, "-m", commit_message],
        )
        validate_recorded_seal_commit(
            worktree, commit_sha, expected_tree, expected_parent, commit_message
        )
        # Persist the exact commit object before the ref CAS. If the process
        # dies after update-ref wins, the next seal invocation can recognize
        # and reconcile that already-landed transaction without recommitting.
        transaction["commit_sha"] = commit_sha
        save_state(repo, state)

    current_head = git(worktree, ["rev-parse", "HEAD"])
    if current_head != commit_sha:
        if current_head != expected_parent:
            raise HLoopError(
                f"seal commit aborted for {task_id}: Worker branch moved from recorded parent "
                f"{expected_parent} to {current_head}; refusing concurrent ref movement"
            )
        update = run_cmd(
            [
                TRUSTED_GIT_PATH,
                "-C",
                str(worktree),
                "update-ref",
                branch_ref,
                commit_sha,
                expected_parent,
            ],
            check=False,
        )
        if update.returncode != 0:
            observed = git(worktree, ["rev-parse", branch_ref], check=False)
            detail = (update.stderr or update.stdout or "compare-and-swap failed").strip()
            raise HLoopError(
                f"seal commit aborted for {task_id}: compare-and-swap refused branch ref "
                f"movement from {expected_parent} to {commit_sha}; current={observed or '(missing)'}; "
                f"{detail}"
            )

    landed_head = git(worktree, ["rev-parse", "HEAD"])
    if landed_head != commit_sha:
        raise HLoopError(
            f"seal commit ref update for {task_id} did not land at the recorded commit: "
            f"expected {commit_sha}, got {landed_head}"
        )

    # Never use `reset --hard` or `reset --mixed`: same-path content written
    # or re-staged after `staged_tree` was recorded must survive as an
    # unstaged worktree change, and a mixed reset would also move
    # `branch_ref` -- silently reverting it if another process advanced it
    # during this window. Reconcile the index only, and fail closed without
    # touching the ref if that has happened.
    reconcile_seal_index(worktree, task_id, branch_ref, commit_sha)
    return commit_sha


def resume_staged_seal_transaction(
    repo: Path,
    state: dict[str, Any],
    task_id: str,
    task_state: dict[str, Any],
    worktree: Path,
    expected_attempt: str,
    result_rel: Path,
    pre_staged: list[str],
) -> int | None:
    """Finish or reconcile a seal that crashed after its durable checkpoints.

    `cmd_worker_seal` records a `seal_transaction` marker in Worker state --
    the attempt, result path, exact staged paths, commit message, branch ref,
    and expected parent -- before staging, then the immutable tree and commit
    ids as later checkpoints. If the Manager process dies, the next `hloop
    worker seal` either completes the recorded commit-tree/ref-CAS operation
    from an exactly matching staged index or recognizes an already-landed
    commit and finishes index/state reconciliation. Neither path loses
    worktree content or re-runs Manager validation that already passed.
    Returns the seal exit code if this was a recognized, matching, and safely
    resumable transaction; returns ``None`` if the staged index cannot be
    attributed to a recorded transaction (including a partial `git add -A`
    that never finished) so the caller fails closed as before.
    """

    transaction = task_state.get("seal_transaction")
    if not isinstance(transaction, dict):
        return None
    if str(transaction.get("attempt_id") or "") != expected_attempt:
        return None
    if str(transaction.get("result_rel") or "") != result_rel.as_posix():
        return None
    expected_parent = str(transaction.get("expected_parent") or "")
    branch_ref = str(transaction.get("branch_ref") or "")
    expected_branch = str(task_state.get("branch") or "")
    if (
        not expected_parent
        or not expected_branch
        or branch_ref != f"refs/heads/{expected_branch}"
    ):
        return None
    current_head = git(worktree, ["rev-parse", "HEAD"])
    recorded_commit = str(transaction.get("commit_sha") or "")
    validation_passed = transaction.get("validation_passed") is True
    if not validation_passed:
        if recorded_commit:
            raise HLoopError(
                f"unvalidated seal transaction for {task_id} unexpectedly records commit "
                f"{recorded_commit}; refusing to move refs"
            )
        if current_head != expected_parent:
            raise HLoopError(
                f"seal resume aborted for {task_id}: Worker branch moved from recorded parent "
                f"{expected_parent} to {current_head}; preserving the unvalidated transaction"
            )
        # A crash before validation (or before the durable pass marker) may
        # leave a complete or partial index update.  The branch still points
        # at the recorded parent, so read-tree safely restores only the index;
        # every working-file byte survives and the normal path below reruns
        # validation from a newly recorded tree.
        discard_unvalidated_seal_transaction(
            repo, state, task_id, task_state, worktree
        )
        pre_staged.clear()
        return None

    expected_scope = normalize_list(transaction.get("staged_paths"))
    commit_message = str(transaction.get("commit_message") or "")
    expected_tree = str(transaction.get("staged_tree") or "")
    terminal_sentinel = str(transaction.get("terminal_sentinel") or "")
    if not expected_scope or not commit_message or not expected_tree:
        raise HLoopError(
            f"validated seal transaction is incomplete for {task_id}; refusing resume-commit"
        )
    if recorded_commit and current_head == recorded_commit:
        # update-ref won before a crash, but index reconciliation and state
        # cleanup did not. Validate the object and finish those idempotently.
        head_sha = commit_recorded_seal_tree(
            repo, state, task_id, task_state, worktree, expected_branch
        )
        task_state.pop("seal_transaction", None)
        save_state(repo, state)
        journal(
            repo,
            f"Reconciled already-landed Worker seal for `{task_id}` at attempt "
            f"`{expected_attempt}` ({head_sha}).",
        )
        print(
            f"sealed {task_id}: attempt={expected_attempt} head_sha={head_sha} "
            "(reconciled after crash)"
        )
        if terminal_sentinel:
            print(terminal_sentinel)
        return 0
    if current_head != expected_parent:
        raise HLoopError(
            f"seal resume aborted for {task_id}: Worker branch moved from recorded parent "
            f"{expected_parent} to {current_head}; refusing concurrent ref movement"
        )
    if set(pre_staged) != set(expected_scope):
        return None

    # `pre_staged` already matches the recorded scope exactly, so the prior
    # `git add -A` ran to completion before the crash. Working-file changes
    # after the durable validation marker are allowed: the recorded index
    # tree remains the sole commit source and reconciliation will preserve
    # those bytes as unstaged content.
    remaining_dirty = porcelain_paths_no_renames(worktree)
    cached_files = cached_diff_paths_no_renames(worktree)
    observed_tree = git(worktree, ["write-tree"])
    if set(cached_files) != set(expected_scope) or observed_tree != expected_tree:
        reconcile_seal_index(worktree, task_id, branch_ref, expected_parent)
        task_state.pop("seal_transaction", None)
        save_state(repo, state)
        if set(cached_files) == set(expected_scope) and observed_tree != expected_tree:
            # Same paths, different content: the index was re-staged (or
            # tampered with) after the crash to match the recorded path
            # names exactly, but the durable tree identity captured before
            # the crash no longer matches. Report this distinctly from an
            # ordinary "worktree changed" race so it is never mistaken for
            # routine churn.
            raise HLoopError(
                f"seal resume aborted for {task_id}: staged tree identity {observed_tree} does not "
                f"match the recorded transaction's tree {expected_tree} for the same staged paths "
                f"{sorted(expected_scope)}; refusing to trust re-staged or tampered content"
            )
        raise HLoopError(
            f"seal resume aborted for {task_id}: staged scope changed since the crashed seal "
            f"attempt (working changes preserved: {remaining_dirty}; staged "
            f"{sorted(cached_files)} != expected {sorted(expected_scope)}); inspect the "
            "worktree before retrying"
        )

    head_sha = commit_recorded_seal_tree(
        repo, state, task_id, task_state, worktree, expected_branch
    )
    task_state.pop("seal_transaction", None)
    save_state(repo, state)
    journal(
        repo,
        f"Resumed and sealed Worker handoff for `{task_id}` at attempt `{expected_attempt}` "
        f"after a crash left the seal transaction staged ({head_sha}).",
    )
    print(f"sealed {task_id}: attempt={expected_attempt} head_sha={head_sha} (resumed after crash)")
    if terminal_sentinel:
        print(terminal_sentinel)
    return 0


def cmd_worker_seal(args: argparse.Namespace) -> int:
    """Manager-only: validate and commit a Worker's uncommitted handoff.

    A workspace-write Codex Worker may run ``hloop worker finalize --handoff``
    to write ``result.md`` and leave in-scope product changes on disk without
    ever invoking Git. This command performs the Manager-side validation --
    quiesced/closed Worker pane, exact active attempt, semantic ACK,
    branch/worktree identity, full (committed + dirty, rename-source-aware)
    write scope, a non-stale artifact, and real Manager-measured validation
    for `status: done` -- fail-closed before staging or committing anything.
    A successful seal produces exactly the same shape of commit a
    self-committing Worker would have produced, so `hloop worker harvest`
    and merge require no changes.
    """

    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_herdr=True, require_integration_branch=True)
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"unknown task: {task_id}")
    if str(task_state.get("status") or "") != "running":
        raise HLoopError(f"cannot seal {task_id}: task has no active running attempt")
    block_reason = semantic_ack_barrier_blocking(task_state)
    if block_reason:
        raise HLoopError(f"cannot seal {task_id}: {block_reason}")
    expected_attempt = str(task_state.get("active_attempt_id") or task_state.get("attempt_id") or "")
    if not expected_attempt:
        raise HLoopError(f"cannot seal {task_id}: no active attempt is recorded")
    if args.attempt_id and args.attempt_id != expected_attempt:
        raise HLoopError(
            f"attempt mismatch for {task_id}: expected active attempt {expected_attempt}, "
            f"got {args.attempt_id}"
        )

    worktree = Path(task_state.get("worktree") or default_worktree(repo, task_id, state)).resolve()
    if not worktree.is_dir():
        raise HLoopError(f"worker worktree not found: {worktree}")
    expected_branch = str(task_state.get("branch") or "")
    branch = current_branch(worktree)
    if expected_branch and branch != expected_branch:
        raise HLoopError(f"Worker branch mismatch: expected {expected_branch}, got {branch}")

    # Status/scope scans are trustworthy only for a canonical index.  Git's
    # assume-unchanged and skip-worktree flags can hide real source changes,
    # so reject them before looking for staged or dirty paths.
    assert_canonical_git_index(worktree)
    for nested_worktree in discover_nested_git_worktrees(worktree):
        assert_canonical_git_index(
            nested_worktree,
            label=f"nested {nested_worktree.relative_to(worktree).as_posix()}",
        )

    result_rel = LOOP_DIR / "results" / task_id / "result.md"
    result_path = worktree / result_rel

    pre_staged = cached_diff_paths_no_renames(worktree)
    resumed = resume_staged_seal_transaction(
        repo, state, task_id, task_state, worktree, expected_attempt, result_rel, pre_staged
    )
    if resumed is not None:
        return resumed
    if pre_staged:
        raise HLoopError(
            f"cannot seal {task_id}: worktree index already has staged changes, which a "
            f"durable handoff must never produce: {sorted(pre_staged)}"
        )

    meta = read_frontmatter(task_file(repo, task_id))
    if str(meta.get("id") or "") != task_id:
        raise HLoopError(f"task file mismatch for {task_id}")
    revision_three_handoff = (
        task_contract_revision(meta)
        == hloop_task_contract.V053_CONTRACT_SCHEMA_REVISION
    )
    v053_candidate: hloop_worker_candidate.ImplementationCandidate | None = None
    v053_seal: hloop_worker_candidate.CandidateSeal | None = None
    v053_review: hloop_worker_candidate.PatchReview | None = None
    if revision_three_handoff:
        v053_candidate, v053_seal, _ = current_candidate_evidence(
            repo, state, task_id, task_state
        )
        if v053_candidate.completion_mode != "handoff":
            raise HLoopError(
                "worker seal cannot finalize a commit-mode revision 3 candidate"
            )

    # Read-only precheck: confirm there is a genuinely complete, well-formed
    # handoff before doing anything that could disrupt a Worker that has not
    # actually finished -- closing its pane chief among them.
    precheck_meta = read_worker_handoff_artifact(
        result_path, result_rel, state, task_id, task_state, expected_attempt
    )
    dirty = porcelain_paths_no_renames(worktree)
    result_pending = result_rel.as_posix() in dirty
    if not result_pending:
        # `git status` never reports a path that matches an ignore rule, even
        # when it is genuinely new or modified relative to HEAD -- if the
        # loop namespace is git-excluded in this repository, a result-only
        # handoff's `result.md` never shows up in `dirty` at all, and a
        # naive "worktree has no pending handoff changes" check below would
        # misreport `nothing to seal`. The read-only precheck above already
        # confirmed the artifact exists, is well-formed, and belongs to the
        # active attempt, so compare it directly against what HEAD already
        # has to tell a genuine pending handoff from one that was already
        # sealed with identical content.
        result_pending = safe_result_commit_state(worktree, task_id, "") != "committed"
    if not dirty and not result_pending:
        raise HLoopError(f"nothing to seal for {task_id}: worktree has no pending handoff changes")
    if result_pending and result_rel.as_posix() not in dirty:
        # It is force-staged below (`git add -f`) regardless of ignore
        # status; if it turns out to introduce no actual diff (e.g. it was
        # already sealed with identical content), the post-staging
        # re-verification below still fails closed on a staged/expected
        # mismatch.
        dirty = [*dirty, result_rel.as_posix()]

    # Only now that a real handoff is confirmed: make sure the Worker pane is
    # quiesced and close it, so nothing can still be mutating the worktree
    # while seal reads, stages, or commits it.
    require_worker_pane_quiesced_and_closed(repo, task_id, task_state)
    save_state(repo, state)

    # Re-read and re-validate the artifact now that the pane is closed. If it
    # changed during the close window, the precheck snapshot is stale --
    # refuse rather than seal a moving target.
    handoff_meta = read_worker_handoff_artifact(
        result_path, result_rel, state, task_id, task_state, expected_attempt
    )
    if handoff_meta != precheck_meta:
        raise HLoopError(
            f"handoff result artifact for {task_id} changed while closing the Worker pane; "
            "refusing to seal a moving target"
        )
    status = str(handoff_meta.get("status") or "")
    blocking_questions = normalize_list(handoff_meta.get("blocking_questions"))
    expected_parent = git(worktree, ["rev-parse", "HEAD"])
    if revision_three_handoff and v053_seal is not None:
        if expected_parent != v053_seal.candidate_sha:
            raise HLoopError(
                f"final handoff parent is not the sealed candidate SHA: "
                f"expected={v053_seal.candidate_sha} observed={expected_parent}"
            )
        dirty_product = exact_product_dirty_paths(worktree)
        if dirty_product:
            raise HLoopError(
                "revision 3 final handoff changed product files after candidate seal: "
                + ", ".join(dirty_product)
            )
        # Candidate, prompt, and review artifacts are local-only evidence and
        # must not be swept into the final commit. The result artifact is the
        # only permissible dirty path after an exact candidate seal.
        dirty = [result_rel.as_posix()]

    base_ref = str(task_state.get("base_ref") or meta.get("base_ref") or state.get("integration_branch") or "")
    if not base_ref:
        raise HLoopError(f"task base_ref is missing: {task_id}")
    base_sha = str(task_state.get("worker_base_sha") or task_state.get("base_sha") or "")
    if not base_sha:
        base_proc = run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(worktree), "merge-base", "HEAD", base_ref], check=False
        )
        if base_proc.returncode != 0 or not (base_proc.stdout or "").strip():
            raise HLoopError(f"cannot resolve Worker branch point against {base_ref}")
        base_sha = (base_proc.stdout or "").strip()
    if not is_ancestor(worktree, base_sha, expected_parent):
        raise HLoopError(f"active attempt base is not an ancestor of HEAD: {base_sha}")

    # The complete write scope is whatever the Worker already committed on top
    # of base_sha, plus whatever remains dirty in this durable handoff. Trust
    # neither in isolation: a partially self-committing Worker could still
    # leave out-of-scope files dirty, or could have committed out-of-scope
    # files before switching to a handoff for the rest. Rename detection is
    # disabled throughout so a rename's source path cannot escape scope
    # checking by hiding behind its destination.
    committed_files = changed_files(worktree, base_sha, expected_parent)
    full_scope = list(dict.fromkeys([*committed_files, *dirty]))

    declared_changed_files = normalize_list(handoff_meta.get("changed_files"))
    measured_declared_scope = (
        committed_files if revision_three_handoff else full_scope
    )
    if set(declared_changed_files) != set(measured_declared_scope):
        raise HLoopError(
            f"stale handoff artifact: declared changed_files does not match the measured write "
            f"scope for {task_id}; declared={sorted(declared_changed_files)} "
            f"measured={sorted(measured_declared_scope)}"
        )

    violations = validate_change_scope(task_id, meta, full_scope)
    if violations:
        raise HLoopError("write-scope violations: " + "; ".join(violations))

    manager_validation_commands: list[str] = []
    manager_validation_results: list[str] = []
    if status == "done":
        manager_validation_commands = normalize_list(getattr(args, "validation_command", None))
        if not manager_validation_commands:
            raise HLoopError(
                f"cannot seal {task_id} as status done without at least one Manager "
                "--validation-command"
            )
        if revision_three_handoff:
            if v053_candidate is None or v053_seal is None:
                raise HLoopError("revision 3 candidate evidence disappeared during final seal")
            (
                v053_candidate,
                v053_seal,
                v053_review,
                validation_commands,
                validation_results,
            ) = validate_revision_three_final_gate(
                repo,
                state,
                task_id,
                task_state,
                meta,
                validation_commands=[
                    *normalize_list(handoff_meta.get("validation_commands")),
                    *manager_validation_commands,
                ],
                validation_results=[
                    *normalize_list(handoff_meta.get("validation_results")),
                    *(["passed"] * len(manager_validation_commands)),
                ],
            )
            validation_recorded = True
        else:
            validation_recorded = bool(manager_validation_commands)
            validation_commands = manager_validation_commands
        # The result artifact is part of the immutable tree validated below.
        # Record the only result that is eligible to commit up front, then
        # commit that tree only if every real command earns the prediction.
        if not revision_three_handoff:
            validation_results = ["passed" for _ in manager_validation_commands]
        validation_summary = args.validation_summary or handoff_meta.get("validation_summary") or ""
    else:
        # Manager does not re-run validation for a `partial`/`blocked`/
        # `failed` handoff -- there is nothing to measure. Preserve the
        # Worker's own declared validation evidence exactly as reported,
        # after verifying it is internally consistent, rather than
        # overwriting it with an empty record and discarding whatever the
        # Worker actually ran.
        worker_validation_issue = worker_validation_error(handoff_meta)
        if worker_validation_issue:
            raise HLoopError(
                f"cannot seal {task_id}: Worker-reported validation is inconsistent: "
                f"{worker_validation_issue}"
            )
        validation_recorded = normalize_bool(handoff_meta.get("validation_recorded"))
        validation_commands = normalize_list(handoff_meta.get("validation_commands"))
        validation_results = normalize_list(handoff_meta.get("validation_results"))
        validation_summary = args.validation_summary or handoff_meta.get("validation_summary") or ""

    merge_ready = status == "done" and bool(manager_validation_commands) and not blocking_questions and all(
        result == "passed" for result in validation_results
    )
    original_result_text = read_text(result_path)
    replace_frontmatter(
        result_path,
        {
            "changed_files": (
                declared_changed_files if revision_three_handoff else full_scope
            ),
            "validation_recorded": validation_recorded,
            "validation_commands": validation_commands,
            "validation_results": validation_results,
            "validation_summary": validation_summary,
            "merge_ready": merge_ready,
        },
    )
    if revision_three_handoff:
        sealed_result_meta = read_frontmatter(result_path)
        authenticity_meta = dict(sealed_result_meta)
        authenticity_meta["head_sha"] = expected_parent
        if v053_candidate is None or v053_seal is None:
            raise HLoopError("revision 3 candidate evidence is missing at final seal")
        try:
            hloop_worker_candidate.validate_final_result_authenticity(
                v053_candidate,
                v053_seal,
                v053_review,
                authenticity_meta,
                candidate_artifact_digest=v053_seal.candidate_artifact_digest,
                current_task_contract_digest=v053_candidate.task_contract_digest,
                result_parent_candidate_sha=expected_parent,
                require_patch_review="patch_review" in task_required_gates(meta),
            )
        except hloop_worker_candidate.WorkerCandidateError as exc:
            raise HLoopError(f"final handoff authenticity gate rejected: {exc}") from exc
    if result_rel.as_posix() not in dirty:
        dirty = [*dirty, result_rel.as_posix()]

    commit_message = f"ai-loop({task_id}): seal worker handoff ({expected_attempt})"
    observed_parent = git(worktree, ["rev-parse", "HEAD"])
    if observed_parent != expected_parent:
        raise HLoopError(
            f"seal aborted for {task_id}: Worker branch moved before transaction record; "
            f"expected {expected_parent}, got {observed_parent}"
        )
    branch_ref = git(worktree, ["symbolic-ref", "-q", "HEAD"], check=False)
    expected_branch_ref = f"refs/heads/{expected_branch}"
    if branch_ref != expected_branch_ref:
        raise HLoopError(
            f"seal aborted for {task_id}: Worker HEAD is not attached to {expected_branch_ref}"
        )

    # Record identity before staging.  `validation_passed` is deliberately
    # false until the exact staged tree has been materialized, all commands
    # have passed in that tree's snapshot, cleanup has succeeded, and the
    # marker itself is durable.  A crash at any earlier point reconciles only
    # the index to `expected_parent` and reruns validation; it never commits.
    task_state["seal_transaction"] = {
        "attempt_id": expected_attempt,
        "result_rel": result_rel.as_posix(),
        "staged_paths": dirty,
        "commit_message": commit_message,
        "expected_parent": expected_parent,
        "branch_ref": branch_ref,
        "validation_required": status == "done",
        "validation_passed": False,
    }
    if revision_three_handoff:
        task_state["seal_transaction"]["terminal_sentinel"] = (
            f"HERDR_LOOP_ROLE_DONE:{state.get('run_id', '')}:{task_id}:"
            f"{expected_attempt}:{status}"
        )
    save_state(repo, state)

    # The namespaced result artifact is the Worker/Manager hand-off contract
    # and must land in the seal commit even in repositories that gitignore
    # `.ai` -- stage it explicitly with `-f`. Every other path keeps normal
    # `git add -A` semantics (respecting .gitignore, honoring deletions) so
    # product paths are never force-staged past a repository's own ignore
    # rules.
    try:
        other_paths = [path for path in dirty if path != result_rel.as_posix()]
        if other_paths:
            run_cmd(
                [TRUSTED_GIT_PATH, "-C", str(worktree), "add", "-A", "--", *other_paths],
                check=True,
            )
        run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(worktree), "add", "-f", "--", result_rel.as_posix()],
            check=True,
        )
    except Exception:
        discard_unvalidated_seal_transaction(
            repo,
            state,
            task_id,
            task_state,
            worktree,
            restore_result_path=result_path,
            restore_result_text=original_result_text,
        )
        raise

    # Re-verify nothing changed underneath staging (a genuine TOCTOU window,
    # however small) before committing: no unstaged/untracked path may
    # remain, and the staged (cached) diff must be exactly what was scanned.
    remaining_dirty = porcelain_paths_no_renames(worktree)
    if revision_three_handoff:
        loop_prefix = LOOP_DIR.as_posix() + "/"
        remaining_dirty = [
            path
            for path in remaining_dirty
            if path != LOOP_DIR.as_posix() and not path.startswith(loop_prefix)
        ]
    cached_files = cached_diff_paths_no_renames(worktree)
    if remaining_dirty or set(cached_files) != set(dirty):
        discard_unvalidated_seal_transaction(
            repo,
            state,
            task_id,
            task_state,
            worktree,
            restore_result_path=result_path,
            restore_result_text=original_result_text,
        )
        raise HLoopError(
            f"seal aborted for {task_id}: worktree changed while staging (remaining dirty: "
            f"{remaining_dirty}; staged {sorted(cached_files)} != expected {sorted(dirty)})"
        )

    # Persist the exact staged tree identity as a second durable checkpoint,
    # *after* staging is confirmed to match the scanned scope exactly. Only a
    # transaction carrying this hash is eligible for crash-recovery resume
    # (see `resume_staged_seal_transaction`): if the process dies before this
    # save lands, the next seal attempt finds no `staged_tree` and fails
    # closed instead of resume-committing an unverified tree.
    staged_tree = git(worktree, ["write-tree"])
    task_state["seal_transaction"]["staged_tree"] = staged_tree
    save_state(repo, state)

    if status == "done":
        snapshot: Path | None = None
        try:
            snapshot = build_validation_snapshot(worktree, staged_tree, expected_parent)
            for command in manager_validation_commands:
                passed, output = run_seal_validation_command(snapshot, command)
                manager_validation_results.append("passed" if passed else "failed")
                if not passed:
                    raise HLoopError(
                        f"Manager validation command failed, refusing to seal {task_id}: {command}\n"
                        + output
                    )
        except Exception:
            discard_unvalidated_seal_transaction(
                repo,
                state,
                task_id,
                task_state,
                worktree,
                restore_result_path=result_path,
                restore_result_text=original_result_text,
            )
            raise
        finally:
            if snapshot is not None:
                remove_validation_snapshot(snapshot)

        observed_parent = git(worktree, ["rev-parse", "HEAD"])
        if observed_parent != expected_parent:
            raise HLoopError(
                f"Worker branch moved during Manager validation for {task_id}: "
                f"expected {expected_parent}, got {observed_parent}; preserving the staged "
                "transaction without marking validation passed"
            )
        expected_manager_results = ["passed"] * len(manager_validation_commands)
        if manager_validation_results != expected_manager_results:
            raise HLoopError(
                f"Manager validation result mismatch for {task_id}: "
                f"measured={manager_validation_results} recorded={expected_manager_results}"
            )

    # Non-done handoffs have no Manager validation gate; for done handoffs
    # this assignment happens only after every command and snapshot cleanup
    # completed.  Saving the marker is the resume-commit boundary.
    task_state["seal_transaction"]["validation_passed"] = True
    save_state(repo, state)

    head_sha = commit_recorded_seal_tree(
        repo, state, task_id, task_state, worktree, expected_branch
    )
    task_state.pop("seal_transaction", None)
    save_state(repo, state)
    journal(repo, f"Sealed Worker handoff for `{task_id}` at attempt `{expected_attempt}` ({head_sha}).")
    print(f"sealed {task_id}: attempt={expected_attempt} head_sha={head_sha}")
    if revision_three_handoff:
        print(
            f"HERDR_LOOP_ROLE_DONE:{state.get('run_id', '')}:{task_id}:"
            f"{expected_attempt}:{status}"
        )
    return 0


def default_worktree(repo: Path, task_id: str, state: dict[str, Any] | None = None) -> Path:
    return configured_worktree_path(repo, state, task_id, f"{repo.name}.{task_id.lower()}")


def default_review_worktree(repo: Path, review_id: str, state: dict[str, Any] | None = None) -> Path:
    return configured_worktree_path(
        repo, state, review_id, f"{repo.name}.{review_id.lower()}-review"
    )


def default_gap_worktree(repo: Path, gap_id: str, state: dict[str, Any] | None = None) -> Path:
    return configured_worktree_path(repo, state, gap_id, f"{repo.name}.{gap_id.lower()}-gap")


def default_advisor_worktree(
    repo: Path,
    advice_id: str,
    participant_id: str,
    state: dict[str, Any] | None = None,
) -> Path:
    name = f"{advice_id}-{participant_id}"
    legacy = f"{repo.name}.{advice_id.lower()}-{participant_id.lower()}-advisor"
    return configured_worktree_path(repo, state, name, legacy)


def cleanup_hloop_prompt_file(worktree: Path, agent_id: str, suffix: str) -> None:
    prompt = worktree / LOOP_DIR / "prompts" / f"{agent_id}.{suffix}.md"
    try:
        if prompt.exists() or prompt.is_symlink():
            prompt.unlink()
        prompts_dir = prompt.parent
        if prompts_dir.exists():
            try:
                prompts_dir.rmdir()
            except OSError:
                pass
    except OSError as exc:
        raise HLoopError(f"failed to remove generated prompt {prompt}: {exc}") from exc


def cleanup_error_fingerprint(kind: str, detail: str) -> str:
    return hashlib.sha256(f"{kind}:{detail}".encode("utf-8")).hexdigest()[:16]


def record_worktree_cleanup_failure(
    repo: Path,
    agent_state: dict[str, Any],
    label: str,
    exc: BaseException,
) -> None:
    detail = command_error_detail(exc)
    agent_state["worktree_cleanup_status"] = "failed"
    agent_state["worktree_cleanup_error"] = detail
    agent_state["worktree_cleanup_error_fingerprint"] = cleanup_error_fingerprint("worktree", detail)
    agent_state["worktree_cleanup_failed_at"] = now_iso()
    journal(repo, f"Failed to remove {label} worktree: {detail}")
    print(f"warning: failed to remove {label} worktree: {detail}", file=sys.stderr)


def ensure_task_visible_in_worktree(worktree: Path, task_id: str) -> None:
    missing = [
        loop_path(worktree) / "MISSION.md",
        loop_path(worktree) / "PLAN.md",
        loop_path(worktree) / "PROFILE.md",
        loop_path(worktree) / "DECISIONS.md",
        task_file(worktree, task_id),
    ]
    absent = [str(path) for path in missing if not path.exists()]
    if absent:
        raise HLoopError(
            f"worker worktree does not contain required {LOOP_DIR.as_posix()} files. "
            "Use local-only snapshot copying or commit Manager-owned loop changes first. "
            f"Missing: {', '.join(absent)}"
        )


def ensure_review_visible_in_worktree(worktree: Path) -> None:
    missing = [
        loop_path(worktree) / "MISSION.md",
        loop_path(worktree) / "PLAN.md",
        loop_path(worktree) / "PROFILE.md",
        loop_path(worktree) / "DECISIONS.md",
    ]
    absent = [str(path) for path in missing if not path.exists()]
    if absent:
        raise HLoopError(
            f"review worktree does not contain required {LOOP_DIR.as_posix()} files. "
            "Use local-only snapshot copying or commit Manager-owned loop changes first. "
            f"Missing: {', '.join(absent)}"
        )


def ensure_gap_visible_in_worktree(worktree: Path) -> None:
    missing = [
        loop_path(worktree) / "MISSION.md",
        loop_path(worktree) / "PLAN.md",
        loop_path(worktree) / "PROFILE.md",
        loop_path(worktree) / "DECISIONS.md",
    ]
    absent = [str(path) for path in missing if not path.exists()]
    if absent:
        raise HLoopError(
            f"gap audit worktree does not contain required {LOOP_DIR.as_posix()} files. "
            "Use local-only snapshot copying or commit Manager-owned loop changes first. "
            f"Missing: {', '.join(absent)}"
        )


def ensure_advisor_visible_in_worktree(worktree: Path) -> None:
    missing = [
        loop_path(worktree) / "MISSION.md",
        loop_path(worktree) / "PLAN.md",
        loop_path(worktree) / "PROFILE.md",
