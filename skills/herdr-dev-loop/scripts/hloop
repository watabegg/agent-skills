def manager_qa_file(repo: Path) -> Path:
    return loop_path(repo) / "qa" / "FINAL.md"


def normalize_list(value: Any) -> list[str]:
    if value is None:
        return []
    if isinstance(value, list):
        return [str(v) for v in value]
    return [str(value)]


def normalize_bool(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() in {"1", "true", "yes", "on"}
    return bool(value)


def normalize_int(value: Any, default: int) -> int:
    if value is None:
        return default
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def changed_files(repo: Path, base_sha: str, head_sha: str) -> list[str]:
    if not base_sha or not head_sha:
        return []
    out = git(repo, ["diff", "--name-only", f"{base_sha}..{head_sha}"], check=False)
    return [line for line in out.splitlines() if line.strip()]


def git_show(repo: Path, ref_path: str) -> str:
    proc = run_cmd(["git", "-C", str(repo), "show", ref_path], check=False)
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    return proc.stdout or ""


def require_committed_result(worktree: Path, task_id: str, head_sha: str) -> str:
    rel = (LOOP_DIR / "results" / task_id / "result.md").as_posix()
    ref = f"{head_sha}:{rel}"
    try:
        committed = git_show(worktree, ref)
    except HLoopError as exc:
        disk_path = worktree / rel
        if disk_path.exists():
            raise HLoopError(
                "result artifact exists on disk but is not committed at worker HEAD: "
                f"{rel}. Ask Worker {task_id} to commit the result artifact in `{worktree}` "
                f"and rerun `hloop worker harvest {task_id}`."
            ) from exc
        raise
    disk = read_text(worktree / rel)
    if committed != disk:
        raise HLoopError(f"result artifact differs between worktree and committed HEAD: {rel}")
    return rel


def result_validation_recorded(meta: dict[str, Any]) -> bool:
    return normalize_bool(meta.get("validation_recorded"))


def escape_literal_brackets(pattern: str) -> str:
    pieces = []
    for char in pattern:
        if char == "[":
            pieces.append("[[]")
        elif char == "]":
            pieces.append("[]]")
        else:
            pieces.append(char)
    return "".join(pieces)


def normalize_match_path(value: str) -> str:
    value = str(value).replace("\\", "/")
    if value.startswith("./"):
        return value[2:]
    return value


def path_matches_pattern(path: str, pattern: str) -> bool:
    normalized_path = normalize_match_path(path)
    normalized_pattern = normalize_match_path(pattern)
    if fnmatch.fnmatchcase(normalized_path, normalized_pattern):
        return True
    escaped_pattern = escape_literal_brackets(normalized_pattern)
    return escaped_pattern != normalized_pattern and fnmatch.fnmatchcase(
        normalized_path,
        escaped_pattern,
    )


def matches_any(path: str, patterns: list[str]) -> bool:
    return any(path_matches_pattern(path, pattern) for pattern in patterns)


def validate_change_scope(task_id: str, task_meta: dict[str, Any], files: list[str]) -> list[str]:
    allow = normalize_list(task_meta.get("write_allow"))
    deny = normalize_list(task_meta.get("write_deny"))
    result_pattern = f".ai/loop/results/{task_id}/**"
    violations = []
    for path in files:
        allowed = matches_any(path, allow) or path_matches_pattern(path, result_pattern)
        denied = matches_any(path, deny)
        if not allowed or denied:
            suffix = "denied" if denied else "not allowed"
            violations.append(f"{path} ({suffix})")
    return violations


def porcelain_paths(repo: Path) -> list[str]:
    proc = run_cmd(
        ["git", "-C", str(repo), "status", "--porcelain", "--untracked-files=all"],
        check=False,
    )
    return parse_porcelain_paths(proc.stdout or "")


def parse_porcelain_paths(text: str) -> list[str]:
    paths = []
    for line in text.splitlines():
        if not line:
            continue
        path = line[3:] if len(line) > 3 else ""
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        if path:
            paths.append(path)
    return paths


def porcelain_paths_for(repo: Path, pathspec: str) -> list[str]:
    proc = run_cmd(
        ["git", "-C", str(repo), "status", "--porcelain", "--untracked-files=all", "--", pathspec],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    return parse_porcelain_paths(proc.stdout or "")


def unsafe_dirty_paths(repo: Path, *, allow_loop_dirty: bool = True) -> list[str]:
    paths = porcelain_paths(repo)
    if not allow_loop_dirty:
        return paths
    loop_prefix = f"{LOOP_DIR.as_posix()}/"
    return [path for path in paths if path != LOOP_DIR.as_posix() and not path.startswith(loop_prefix)]


def mark_blocked_environment(repo: Path, state: dict[str, Any], reason: str) -> None:
    state["phase"] = "blocked_environment"
    state["last_preflight_error"] = {"at": now_iso(), "reason": reason}
    save_state(repo, state)
    journal(repo, f"Blocked by preflight: {reason}")


def preflight_loop(
    repo: Path,
    *,
    require_herdr: bool = False,
    require_codex: bool = False,
    require_integration_branch: bool = False,
    allow_loop_dirty: bool = True,
    mark_blocked: bool = True,
) -> dict[str, Any]:
    state = load_state(repo)

    def fail(reason: str) -> None:
        if mark_blocked:
            mark_blocked_environment(repo, state, reason)
        raise HLoopError(reason)

    if not command_exists("git"):
        fail("git command not found")
    if require_herdr:
        if os.environ.get("HERDR_ENV") != "1":
            fail("HERDR_ENV=1 is required")
        if not command_exists("herdr"):
            fail("herdr command not found")
    if require_codex and not command_exists("codex"):
        fail("codex command not found")
    if require_integration_branch:
        expected = str(state.get("integration_branch") or "")
        actual = current_branch(repo)
        if not expected:
            fail("integration_branch is missing from STATE.json")
        if actual != expected:
            fail(f"current branch must be integration branch {expected}; currently {actual}")
    dirty = unsafe_dirty_paths(repo, allow_loop_dirty=allow_loop_dirty)
    if dirty:
        fail("working tree has non-loop dirty files: " + ", ".join(dirty))
    return state


def make_issue(
    severity: str,
    code: str,
    subject: str,
    message: str,
    action: str = "",
) -> dict[str, str]:
    return {
        "severity": severity,
        "code": code,
        "subject": subject,
        "message": message,
        "action": action,
    }


def issue_sort_key(item: dict[str, Any]) -> tuple[int, str, str]:
    return (
        ISSUE_SEVERITY_RANK.get(str(item.get("severity") or "P3"), 3),
        str(item.get("subject") or ""),
        str(item.get("code") or ""),
    )


def safe_current_branch(repo: Path) -> str:
    try:
        return current_branch(repo)
    except HLoopError:
        return ""


def safe_short_sha(repo: Path, ref: str) -> str:
    if not ref:
        return ""
    proc = run_cmd(["git", "-C", str(repo), "rev-parse", "--short", ref], check=False)
    if proc.returncode != 0:
        return ""
    return (proc.stdout or "").strip()


def safe_porcelain_paths(repo: Path) -> list[str]:
    try:
        return porcelain_paths(repo)
    except HLoopError:
        return []


def safe_frontmatter(path: Path) -> tuple[dict[str, Any], str]:
    if not path.exists():
        return {}, "missing"
    try:
        text = read_text(path)
    except HLoopError as exc:
        return {}, f"read-error:{exc}"
    if not text.strip():
        return {}, "empty"
    return parse_frontmatter_text(text), "present"


def safe_result_commit_state(worktree: Path, task_id: str, head_sha: str) -> str:
    rel = (LOOP_DIR / "results" / task_id / "result.md").as_posix()
    disk_path = worktree / rel
    if not disk_path.exists():
        return "missing"
    resolved_head = head_sha
    if not resolved_head or resolved_head == "HEAD":
        proc = run_cmd(["git", "-C", str(worktree), "rev-parse", "HEAD"], check=False)
        if proc.returncode != 0:
            return "head-unreadable"
        resolved_head = (proc.stdout or "").strip()
    proc = run_cmd(["git", "-C", str(worktree), "show", f"{resolved_head}:{rel}"], check=False)
    if proc.returncode != 0:
        return "not-committed"
    try:
        disk = read_text(disk_path)
    except HLoopError:
        return "disk-unreadable"
    return "committed" if (proc.stdout or "") == disk else "mismatch"


def pane_marker(role: str, agent_id: str) -> str:
    if role == "worker":
        return f"HERDR_LOOP_TASK_DONE:{agent_id}:"
    if role == "reviewer":
        return f"HERDR_LOOP_REVIEW_DONE:{agent_id}:"
    if role == "gap":
        return f"HERDR_LOOP_GAP_DONE:{agent_id}:"
    return ""


def pane_snapshot(
    pane_id: str,
    *,
    role: str,
    agent_id: str,
    lines: int = 80,
    include_output: bool = False,
) -> dict[str, Any]:
    snapshot: dict[str, Any] = {
        "pane_id": pane_id,
        "available": False,
        "present": False,
        "signals": [],
    }
    if not pane_id:
        snapshot["reason"] = "none"
        return snapshot
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        snapshot["reason"] = "not-in-herdr"
        return snapshot
    snapshot["available"] = True
    info = pane_info(pane_id)
    if info is None:
        snapshot["reason"] = "missing-or-closed"
        return snapshot
    snapshot["present"] = True
    snapshot["agent"] = info.get("agent", "")
    snapshot["agent_status"] = info.get("agent_status", "unknown")
    session_id = extract_agent_session_id(info)
    if session_id:
        snapshot["codex_session_id"] = session_id
    text = pane_text(pane_id, max(1, lines))
    marker = pane_marker(role, agent_id)
    signals: list[str] = []
    if marker and marker in text:
        signals.append("done-marker")
    if "Do you trust the contents of this directory?" in text:
        signals.append("trust-prompt")
    if "Press enter to continue" in text:
        signals.append("press-enter")
    if "esc to interrupt" in text or "• Working" in text:
        signals.append("working-text")
    if "command not found" in text and "hloop" in text:
        signals.append("hloop-command-not-found")
    if contains_dangerous_agent_marker(text):
        signals.append("dangerous-agent-command")
    if include_output:
        snapshot["output_tail"] = text
    snapshot["signals"] = signals
    return snapshot


def pane_issue_for_running(
    role: str,
    agent_id: str,
    pane: dict[str, Any],
) -> dict[str, str] | None:
    subject = f"{role}:{agent_id}"
    pane_id = str(pane.get("pane_id") or "")
    watch_cmd = f"hloop {role} watch {agent_id}" if role != "worker" else f"hloop worker watch {agent_id}"
    if pane_id and pane.get("reason") == "not-in-herdr":
        return None
    if pane_id and not pane.get("present"):
        return make_issue(
            "P1",
            "pane-missing",
            subject,
            f"Running {role} has no readable Herdr pane: {pane_id}",
            f"Check artifact/worktree, then harvest or restart {agent_id}.",
        )
    signals = set(normalize_list(pane.get("signals")))
    if "trust-prompt" in signals:
        return make_issue(
            "P1",
            "codex-trust-prompt",
            subject,
            f"{role} pane is waiting at the Codex trust prompt.",
            f"Inspect with `{watch_cmd}` and resolve the trust prompt before continuing.",
        )
    if "dangerous-agent-command" in signals:
        return make_issue(
            "P0",
            "dangerous-agent-command",
            subject,
            f"{role} pane output contains a dangerous Codex launch marker.",
            "Stop this pane and recreate the agent through hloop with workspace-write sandbox.",
        )
    if "press-enter" in signals:
        return make_issue(
            "P2",
            "codex-press-enter",
            subject,
            f"{role} pane appears to be waiting for Enter.",
            f"Inspect with `{watch_cmd}` before sending follow-up instructions.",
        )
    status = str(pane.get("agent_status") or "")
    if status in {"blocked", "error", "failed"}:
        return make_issue(
            "P1",
            "agent-blocked",
            subject,
            f"{role} pane agent_status is `{status}`.",
            f"Inspect with `{watch_cmd}` and send a Manager message or restart if needed.",
        )
    if status in {"idle", "done", "complete"}:
        return make_issue(
            "P2",
            "agent-idle",
            subject,
            f"{role} pane is `{status}` but no artifact has been harvested yet.",
            f"Inspect with `{watch_cmd}` and harvest if the artifact exists.",
        )
    return None


def worktree_state(path_raw: Any) -> dict[str, Any]:
    if not path_raw:
        return {"path": "", "exists": False}
    path = Path(str(path_raw)).resolve()
    return {
        "path": str(path),
        "exists": path.exists(),
        "dirty_files": safe_porcelain_paths(path) if path.exists() else [],
    }


def contains_dangerous_agent_marker(value: Any) -> bool:
    if isinstance(value, dict):
        return any(contains_dangerous_agent_marker(item) for item in value.values())
    if isinstance(value, (list, tuple, set)):
        return any(contains_dangerous_agent_marker(item) for item in value)
    text = str(value or "").lower()
    return any(marker in text for marker in DANGEROUS_AGENT_MARKERS)


def expected_prompt_fragment(role: str, agent_id: str) -> str:
    suffix = {"worker": "worker", "reviewer": "reviewer", "gap": "gap"}.get(role, role)
    return f".ai/loop/prompts/{agent_id}.{suffix}.md"


def prompt_matches_hloop_contract(role: str, agent_id: str, prompt_raw: Any) -> bool:
    prompt = str(prompt_raw or "").replace("\\", "/")
    return bool(prompt) and expected_prompt_fragment(role, agent_id) in prompt


def path_under_repo_loop_results(repo: Path, path_raw: Any) -> bool:
    if not path_raw:
        return False
    path = Path(str(path_raw))
    if not path.is_absolute():
        path = repo / path
    try:
        resolved = path.resolve()
        results_root = (repo / LOOP_DIR / "results").resolve()
    except OSError:
        return False
    return resolved == results_root or results_root in resolved.parents


def agent_contract_issues(
    repo: Path,
    *,
    role: str,
    agent_id: str,
    agent: dict[str, Any],
) -> list[dict[str, str]]:
    subject = f"{role}:{agent_id}"
    issues: list[dict[str, str]] = []
    status = str(agent.get("status") or "")
    gate_status = agent_gate_status(agent)
    active_status = status in {"running", "result_reported", "reported", "reported_unharvested"} or gate_status in {
        "running",
        "reported",
        "reported_unharvested",
        "paused_untriaged",
    }

    sandbox = str(agent.get("sandbox") or "")
    if sandbox and sandbox != "workspace-write":
        severity = "P0" if contains_dangerous_agent_marker(sandbox) else "P1"
        issues.append(
            make_issue(
                severity,
                "unsafe-agent-sandbox",
                subject,
                f"{role} state records non-standard sandbox `{sandbox}`.",
                "Stop the agent if it is still running; restart through hloop so it uses workspace-write.",
            )
        )

    command_like = {
        key: agent.get(key)
        for key in ("argv", "command", "runner_command", "launch_command", "codex_command")
        if key in agent
    }
    if command_like and contains_dangerous_agent_marker(command_like):
        issues.append(
            make_issue(
                "P0",
                "dangerous-agent-command",
                subject,
                f"{role} state contains a dangerous Codex launch marker.",
                "Stop the pane and recreate the agent with hloop; do not continue from this run.",
            )
        )

    if active_status:
        prompt = str(agent.get("prompt") or "")
        if not prompt:
            issues.append(
                make_issue(
                    "P1",
                    "missing-hloop-prompt",
                    subject,
                    f"{role} is active but STATE.json has no hloop prompt path.",
                    f"Use hloop {role if role != 'reviewer' else 'reviewer'} watch {agent_id}; restart through hloop if the pane was started manually.",
                )
            )
        elif not prompt_matches_hloop_contract(role, agent_id, prompt):
            issues.append(
                make_issue(
                    "P1",
                    "non-hloop-prompt",
                    subject,
                    f"{role} prompt path does not match the hloop prompt contract: {prompt}",
                    "Treat this as a suspected manual launch; harvest only if the artifact passes hloop validation, otherwise restart.",
                )
            )

    state_fragments = [
        str(agent.get("status") or ""),
        str(agent.get("gate_status") or ""),
        str(agent.get("artifact_status") or ""),
    ]
    if any("unharvested" in fragment for fragment in state_fragments):
        issues.append(
            make_issue(
                "P1",
                "unharvested-artifact-state",
                subject,
                f"{role} state records an unharvested artifact.",
                f"Run the matching hloop harvest command or keep the loop paused until Manager intentionally resumes.",
            )
        )

    if role == "worker":
        head_sha = str(agent.get("head_sha") or "").lower()
        if head_sha in SUSPICIOUS_WORKER_HEADS:
            issues.append(
                make_issue(
                    "P1",
                    "untrusted-worker-head",
                    subject,
                    f"Worker result uses non-commit head marker `{agent.get('head_sha')}`.",
                    "Do not merge this task; rerun the Worker or record an environment blocker.",
                )
            )
        integration_method = str(agent.get("integration_method") or "")
        if "manual" in integration_method or integration_method.startswith("manager_"):
            issues.append(
                make_issue(
                    "P1",
                    "manual-worker-integration",
                    subject,
                    f"Worker state records manual integration method `{integration_method}`.",
                    "Review this task before trusting final loop status; prefer hloop merge for future tasks.",
                )
            )
        if normalize_bool(agent.get("merge_ready")) and not agent.get("committed_result_path"):
            issues.append(
                make_issue(
                    "P1",
                    "merge-ready-without-committed-result",
                    subject,
                    "Worker is merge-ready but STATE.json has no committed_result_path.",
                    "Run hloop worker harvest again; do not merge until the result is committed at branch HEAD.",
                )
            )
        if path_under_repo_loop_results(repo, agent.get("result_path")) and str(agent.get("worktree") or ""):
            issues.append(
                make_issue(
                    "P1",
                    "manager-owned-worker-result",
                    subject,
                    f"Worker result_path points at the Manager repo: {agent.get('result_path')}",
                    "Treat this as a suspected Manager-edited result; rerun or re-harvest from the Worker worktree.",
                )
            )
    return issues


def collect_worker_inventory(
    repo: Path,
    state: dict[str, Any],
    task_id: str,
    task: dict[str, Any],
    *,
    probe_panes: bool,
    lines: int,
    include_output: bool,
) -> dict[str, Any]:
    status = str(task.get("status") or "")
    branch = str(task.get("branch") or "")
    worktree_raw = task.get("worktree") or (
        str(default_worktree(repo, task_id)) if status in {"running", "result_reported"} else ""
    )
    worktree = worktree_state(worktree_raw)
    artifact_path = result_file(Path(worktree["path"]), task_id) if worktree["path"] else result_file(default_worktree(repo, task_id), task_id)
    artifact_meta, artifact_state = safe_frontmatter(artifact_path)
    artifact: dict[str, Any] = {
        "path": str(artifact_path),
        "state": artifact_state,
        "exists": artifact_state == "present",
        "status": str(artifact_meta.get("status") or task.get("result_status") or ""),
        "merge_ready": normalize_bool(artifact_meta.get("merge_ready", task.get("merge_ready"))),
        "validation_recorded": normalize_bool(
            artifact_meta.get("validation_recorded", task.get("validation_recorded"))
        ),
        "committed_path": str(task.get("committed_result_path") or ""),
    }
    if worktree["exists"] and artifact["exists"]:
        artifact["commit_state"] = safe_result_commit_state(
            Path(worktree["path"]),
            task_id,
            str(artifact_meta.get("head_sha") or task.get("head_sha") or "HEAD"),
        )
    pane_id = str(task.get("pane_id") or "")
    pane = (
        pane_snapshot(
            pane_id,
            role="worker",
            agent_id=task_id,
            lines=lines,
            include_output=include_output,
        )
        if probe_panes
        else {"pane_id": pane_id, "available": False, "present": False, "reason": "not-probed"}
    )
    issues: list[dict[str, str]] = []
    issues.extend(agent_contract_issues(repo, role="worker", agent_id=task_id, agent=task))
    if status == "running":
        if artifact["exists"]:
            issues.append(
                make_issue(
                    "P2",
                    "worker-result-ready",
                    f"worker:{task_id}",
                    f"Worker result artifact exists for running task {task_id}.",
                    f"hloop worker harvest {task_id}",
                )
            )
        else:
            pane_issue = pane_issue_for_running("worker", task_id, pane)
            if pane_issue:
                issues.append(pane_issue)
    if status == "result_reported":
        if artifact.get("commit_state") in {"not-committed", "mismatch"}:
            issues.append(
                make_issue(
                    "P1",
                    "worker-result-not-committed",
                    f"worker:{task_id}",
                    f"Worker result commit state is `{artifact.get('commit_state')}`.",
                    f"Ask Worker {task_id} to commit the result artifact before merge.",
                )
            )
        elif artifact["merge_ready"]:
            issues.append(
                make_issue(
                    "P2",
                    "worker-merge-ready",
                    f"worker:{task_id}",
                    f"Worker {task_id} is merge-ready.",
                    f"hloop merge {task_id}",
                )
            )
        else:
            issues.append(
                make_issue(
                    "P1",
                    "worker-result-not-merge-ready",
                    f"worker:{task_id}",
                    f"Worker {task_id} reported a result that is not merge-ready.",
                    "Create a fix task, rerun the Worker, or record the blocker.",
                )
            )
    if status in {"partial", "blocked", "failed", "abandoned"}:
        issues.append(
            make_issue(
                "P1",
                "worker-terminal-not-merged",
                f"worker:{task_id}",
                f"Worker {task_id} ended with status `{status}`.",
                "Create a fix task, rerun the Worker, or record the blocker.",
            )
        )
    return {
        "id": task_id,
        "role": "worker",
        "status": status,
        "branch": branch,
        "branch_exists": branch_exists(repo, branch) if branch else False,
        "worktree": worktree,
        "pane": pane,
        "artifact": artifact,
        "merge_ready": normalize_bool(task.get("merge_ready")),
        "validation_recorded": normalize_bool(task.get("validation_recorded")),
        "cleanup_done": normalize_bool(task.get("cleanup_done")),
        "issues": issues,
    }


def collect_gate_inventory(
    repo: Path,
    agent_id: str,
    agent: dict[str, Any],
    *,
    role: str,
    probe_panes: bool,
    lines: int,
    include_output: bool,
) -> dict[str, Any]:
    status = str(agent.get("status") or "")
    gate_status = agent_gate_status(agent)
    artifact_path = (
        review_artifact_path(repo, agent_id, agent)
        if role == "reviewer"
        else gap_artifact_path(repo, agent_id, agent)
    )
    artifact_meta, artifact_state = safe_frontmatter(artifact_path)
    pane_id = str(agent.get("pane_id") or "")
    pane = (
        pane_snapshot(
            pane_id,
            role=role,
            agent_id=agent_id,
            lines=lines,
            include_output=include_output,
        )
        if probe_panes
        else {"pane_id": pane_id, "available": False, "present": False, "reason": "not-probed"}
    )
    issues: list[dict[str, str]] = []
    issues.extend(agent_contract_issues(repo, role=role, agent_id=agent_id, agent=agent))
    gate_name = "review" if role == "reviewer" else "gap"
    if gate_status == "running":
        if artifact_state == "present":
            issues.append(
                make_issue(
                    "P2",
                    f"{gate_name}-artifact-ready",
                    f"{role}:{agent_id}",
                    f"{role} artifact exists and can be harvested.",
                    f"hloop {gate_name if role == 'gap' else 'reviewer'} harvest {agent_id}",
                )
            )
        else:
            pane_issue = pane_issue_for_running(role, agent_id, pane)
            if pane_issue:
                issues.append(pane_issue)
    if gate_status == "reported":
        issues.append(
            make_issue(
                "P1",
                f"{gate_name}-triage-required",
                f"{role}:{agent_id}",
                f"{role} {agent_id} has been harvested and needs Manager triage.",
                f"hloop triage {gate_name} {agent_id}",
            )
        )
    if gate_status == "blocked_write_scope":
        issues.append(
            make_issue(
                "P1",
                f"{gate_name}-write-scope-violation",
                f"{role}:{agent_id}",
                f"{role} {agent_id} changed files outside its artifact.",
                "Inspect USER_ACTION_REQUIRED.md and the detached worktree before closing the gate.",
            )
        )
    worktree = worktree_state(agent.get("worktree"))
    return {
        "id": agent_id,
        "role": role,
        "status": status,
        "gate_status": gate_status,
        "artifact_status": str(agent.get("artifact_status") or artifact_meta.get("status") or ""),
        "base": str(agent.get("base") or ""),
        "head": str(agent.get("head") or ""),
        "worktree": worktree,
        "pane": pane,
        "artifact": {
            "path": str(artifact_path),
            "state": artifact_state,
            "exists": artifact_state == "present",
            "frontmatter": artifact_meta,
        },
        "issues": issues,
    }


def collect_loop_inventory(
    repo: Path,
    *,
    probe_panes: bool = True,
    lines: int = 80,
    include_output: bool = False,
) -> dict[str, Any]:
    state = load_state(repo)
    current = safe_current_branch(repo)
    integration = str(state.get("integration_branch") or "")
    base = str(state.get("base_branch") or "")
    unsafe_dirty = unsafe_dirty_paths(repo, allow_loop_dirty=True)
    issues: list[dict[str, str]] = []
    if unsafe_dirty:
        issues.append(
            make_issue(
                "P1",
                "non-loop-dirty-files",
                "repo",
                "Working tree has non-loop dirty files: " + ", ".join(unsafe_dirty),
                "Commit/stash/revert unrelated files before mutating the loop.",
            )
        )
    if integration and current and current != integration:
        issues.append(
            make_issue(
                "P1",
                "integration-branch-mismatch",
                "repo",
                f"Current branch is `{current}`, expected integration branch `{integration}`.",
                f"git switch {integration}",
            )
        )
    if state.get("blocking_decisions"):
        issues.append(
            make_issue(
                "P1",
                "blocking-decisions",
                "state",
                "STATE.json contains blocking decisions.",
                "Update DECISIONS.md and USER_ACTION_REQUIRED.md before dispatching new work.",
            )
        )
    phase = str(state.get("phase") or "")
    if phase in {"blocked_user_decision", "blocked_environment", "blocked_conflict", "failed_validation", "failed_manager_qa", "no_progress"}:
        issues.append(
            make_issue(
                "P1",
                "blocked-phase",
                "state",
                f"Loop phase is `{phase}`.",
                "Inspect JOURNAL.md, USER_ACTION_REQUIRED.md, and hloop dashboard output.",
            )
        )
    workers = [
        collect_worker_inventory(
            repo,
            state,
            task_id,
            task,
            probe_panes=probe_panes,
            lines=lines,
            include_output=include_output,
        )
        for task_id, task in state.get("tasks", {}).items()
    ]
    reviewers = [
        collect_gate_inventory(
            repo,
            review_id,
            review,
            role="reviewer",
            probe_panes=probe_panes,
            lines=lines,
            include_output=include_output,
        )
        for review_id, review in state.get("reviews", {}).items()
    ]
    gaps = [
        collect_gate_inventory(
            repo,
            gap_id,
            gap,
            role="gap",
            probe_panes=probe_panes,
            lines=lines,
            include_output=include_output,
        )
        for gap_id, gap in state.get("gaps", {}).items()
    ]
    for collection in (workers, reviewers, gaps):
        for item in collection:
            issues.extend(item.get("issues", []))
    issues = sorted(issues, key=issue_sort_key)
    next_actions = []

    def add_next_action(action: str) -> None:
        if action and action not in next_actions:
            next_actions.append(action)

    for item in issues:
        add_next_action(item.get("action", ""))
    if state.get("needs_gap_check") and not pending_gap_exists(state):
        add_next_action("hloop gap start")
    if state.get("needs_review") and not pending_review_exists(state):
        add_next_action("hloop reviewer start")
    if last_validation_passed(state) and should_open_gap_gate(state):
        add_next_action("hloop tick --once # open gap gate")
    if last_validation_passed(state) and should_open_review_gate(state):
        add_next_action("hloop tick --once # open review gate")
    running_workers = [item["id"] for item in workers if item.get("status") == "running"]
    running_reviewers = [item["id"] for item in reviewers if item.get("gate_status") == "running"]
    running_gaps = [item["id"] for item in gaps if item.get("gate_status") == "running"]
    inventory = {
        "repo": str(repo),
        "generated_at": now_iso(),
        "loop": {
            "goal_id": state.get("goal_id"),
            "phase": phase,
            "cycle": state.get("cycle", 0),
            "base_branch": base,
            "base_sha": safe_short_sha(repo, base),
            "integration_branch": integration,
            "integration_sha": safe_short_sha(repo, integration),
            "current_branch": current,
            "branch_strategy": state_value(state, "branch_strategy", DEFAULT_BRANCH_STRATEGY),
            "worker_protocol": state_value(state, "worker_protocol", DEFAULT_WORKER_PROTOCOL),
            "review_protocol": state_value(state, "review_protocol", DEFAULT_REVIEW_PROTOCOL),
            "worker_qa_profile": state_worker_qa_profile(state),
            "manager_qa_profile": state_manager_qa_profile(state),
            "manager_qa_status": state.get("manager_qa_status", ""),
            "current_batch_id": current_batch_id(state),
            "needs_validation": normalize_bool(state.get("needs_validation")),
            "needs_review": normalize_bool(state.get("needs_review")),
            "needs_gap_check": normalize_bool(state.get("needs_gap_check")),
            "review_queue": {
                "count": normalize_int(state.get("unreviewed_merge_count"), 0),
                "threshold": review_after_merges(state),
            },
            "gap_queue": {
                "count": normalize_int(state.get("ungapped_merge_count"), 0),
                "threshold": gap_after_merges(state),
            },
        },
        "counts": {
            "workers": len(workers),
            "workers_running": len(running_workers),
            "workers_queued": sum(1 for item in workers if item.get("status") == "queued"),
            "workers_merge_ready": sum(
                1 for item in workers if item.get("status") == "result_reported" and item.get("artifact", {}).get("merge_ready")
            ),
            "batches": len(state_batches(state)),
            "reviewers": len(reviewers),
            "reviewers_running": len(running_reviewers),
            "reviewers_reported": sum(1 for item in reviewers if item.get("gate_status") == "reported"),
            "gaps": len(gaps),
            "gaps_running": len(running_gaps),
            "gaps_reported": sum(1 for item in gaps if item.get("gate_status") == "reported"),
            "issues": len(issues),
            "p0_p1_issues": sum(1 for item in issues if item.get("severity") in {"P0", "P1"}),
        },
        "workers": workers,
        "reviewers": reviewers,
        "gaps": gaps,
        "issues": issues,
        "next_actions": next_actions,
        "herdr": {
            "available": os.environ.get("HERDR_ENV") == "1" and command_exists("herdr"),
            "HERDR_ENV": os.environ.get("HERDR_ENV"),
            "HERDR_PANE_ID": os.environ.get("HERDR_PANE_ID"),
            "HERDR_WORKSPACE_ID": os.environ.get("HERDR_WORKSPACE_ID"),
        },
        "state": state,
    }
    return inventory


def validate_reviewer_worktree_scope(
    review_id: str,
    review_state: dict[str, Any],
    worktree: Path,
) -> list[str]:
    allowed = {
        str((LOOP_DIR / "reviews" / f"{review_id}.md").as_posix()),
        str((LOOP_DIR / "prompts" / f"{review_id}.reviewer.md").as_posix()),
    }
    baseline = set(normalize_list(review_state.get("baseline_dirty_files")))
    violations = []
    for path in porcelain_paths(worktree):
        if path in baseline:
            continue
        if path not in allowed:
            violations.append(path)
    return violations


def validate_gap_worktree_scope(
    gap_id: str,
    gap_state: dict[str, Any],
    worktree: Path,
) -> list[str]:
    allowed = {
        str((LOOP_DIR / "gaps" / f"{gap_id}.md").as_posix()),
        str((LOOP_DIR / "prompts" / f"{gap_id}.gap.md").as_posix()),
    }
    baseline = set(normalize_list(gap_state.get("baseline_dirty_files")))
    violations = []
    for path in porcelain_paths(worktree):
        if path in baseline:
            continue
        if path not in allowed:
            violations.append(path)
    return violations


def all_tasks_merged(state: dict[str, Any]) -> bool:
    tasks = state.get("tasks", {})
    return bool(tasks) and all(task.get("status") == "merged" for task in tasks.values())


def last_validation_passed(state: dict[str, Any]) -> bool:
    results = state.get("last_validation", {}).get("results", [])
    return bool(results) and all(item.get("result") == "passed" for item in results)


def running_review_exists(state: dict[str, Any]) -> bool:
    return any(agent_gate_status(review) == "running" for review in state.get("reviews", {}).values())


def running_gap_exists(state: dict[str, Any]) -> bool:
    return any(agent_gate_status(gap) == "running" for gap in state.get("gaps", {}).values())


def agent_gate_status(agent_state: dict[str, Any]) -> str:
    return str(agent_state.get("gate_status") or agent_state.get("status") or "")


def reported_review_exists(state: dict[str, Any]) -> bool:
    return any(agent_gate_status(review) == "reported" for review in state.get("reviews", {}).values())


def reported_gap_exists(state: dict[str, Any]) -> bool:
    return any(agent_gate_status(gap) == "reported" for gap in state.get("gaps", {}).values())


def pending_review_exists(state: dict[str, Any]) -> bool:
    return any(
        agent_gate_status(review) in {"running", "reported"}
        for review in state.get("reviews", {}).values()
    )


def pending_gap_exists(state: dict[str, Any]) -> bool:
    return any(
        agent_gate_status(gap) in {"running", "reported"}
        for gap in state.get("gaps", {}).values()
    )


def review_gate_passed(state: dict[str, Any]) -> bool:
    if int(state.get("max_reviewers", DEFAULT_MAX_REVIEWERS)) <= 0:
        return True
    if state.get("needs_review"):
        return False
    reviews = state.get("reviews", {})
    return any(agent_gate_status(review) == "triaged" for review in reviews.values())


def gap_gate_passed(state: dict[str, Any]) -> bool:
    if int(state.get("max_gap_auditors", DEFAULT_MAX_GAP_AUDITORS)) <= 0:
        return True
    if state.get("needs_gap_check"):
        return False
    gaps = state.get("gaps", {})
    return any(agent_gate_status(gap) == "triaged" for gap in gaps.values())


def review_after_merges(state: dict[str, Any]) -> int:
    return max(1, normalize_int(state.get("review_after_merges"), DEFAULT_REVIEW_AFTER_MERGES))


def gap_after_merges(state: dict[str, Any]) -> int:
    return max(1, normalize_int(state.get("gap_after_merges"), DEFAULT_GAP_AFTER_MERGES))


def should_open_review_gate(state: dict[str, Any]) -> bool:
    if int(state.get("max_reviewers", DEFAULT_MAX_REVIEWERS)) <= 0:
        return False
    if state.get("needs_review") or pending_review_exists(state):
        return False
    count = normalize_int(state.get("unreviewed_merge_count"), 0)
    if count >= review_after_merges(state):
        return True
    return all_tasks_merged(state) and (count > 0 or not review_gate_passed(state))


def should_open_gap_gate(state: dict[str, Any]) -> bool:
    if int(state.get("max_gap_auditors", DEFAULT_MAX_GAP_AUDITORS)) <= 0:
        return False
    if state.get("needs_gap_check") or pending_gap_exists(state):
        return False
    count = normalize_int(state.get("ungapped_merge_count"), 0)
    if count >= gap_after_merges(state):
        return True
    return all_tasks_merged(state) and (count > 0 or not gap_gate_passed(state))


def review_wait_ms(args: argparse.Namespace, state: dict[str, Any]) -> int:
    raw = getattr(args, "review_wait_ms", None)
    if raw is None:
        raw = state.get("review_wait_ms", DEFAULT_REVIEW_WAIT_MS)
    try:
        return max(0, int(raw))
    except (TypeError, ValueError) as exc:
        raise HLoopError(f"invalid review_wait_ms: {raw}") from exc


def gap_wait_ms(args: argparse.Namespace, state: dict[str, Any]) -> int:
    raw = getattr(args, "gap_wait_ms", None)
    if raw is None:
        raw = state.get("gap_wait_ms", DEFAULT_GAP_WAIT_MS)
    try:
        return max(0, int(raw))
    except (TypeError, ValueError) as exc:
        raise HLoopError(f"invalid gap_wait_ms: {raw}") from exc


def wait_for_running_review(repo: Path, review_id: str, review: dict[str, Any], wait_ms: int) -> bool:
    path = review_artifact_path(repo, review_id, review)
    if path.exists() and read_text(path).strip():
        return True
    pane_id = str(review.get("pane_id") or "")
    if wait_ms <= 0 or not pane_id or os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        return False
    proc = run_cmd(
        [
            "herdr",
            "wait",
            "output",
            pane_id,
            "--match",
            f"HERDR_LOOP_REVIEW_DONE:{review_id}:",
            "--source",
            "recent-unwrapped",
            "--timeout",
            str(wait_ms),
        ],
        check=False,
    )
    if proc.returncode == 0:
        review["last_wait_result"] = "done-marker"
    else:
        review["last_wait_result"] = "timeout"
    review["last_waited_at"] = now_iso()
    return path.exists() and read_text(path).strip() != ""


def wait_for_running_gap(repo: Path, gap_id: str, gap: dict[str, Any], wait_ms: int) -> bool:
    path = gap_artifact_path(repo, gap_id, gap)
    if path.exists() and read_text(path).strip():
        return True
    pane_id = str(gap.get("pane_id") or "")
    if wait_ms <= 0 or not pane_id or os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        return False
    proc = run_cmd(
        [
            "herdr",
            "wait",
            "output",
            pane_id,
            "--match",
            f"HERDR_LOOP_GAP_DONE:{gap_id}:",
            "--source",
            "recent-unwrapped",
            "--timeout",
            str(wait_ms),
        ],
        check=False,
    )
    if proc.returncode == 0:
        gap["last_wait_result"] = "done-marker"
    else:
        gap["last_wait_result"] = "timeout"
    gap["last_waited_at"] = now_iso()
    return path.exists() and read_text(path).strip() != ""


def state_value(state: dict[str, Any], key: str, default: str) -> str:
    value = str(state.get(key) or default)
    return value


def state_worker_qa_profile(state: dict[str, Any]) -> str:
    return str(
        state.get("worker_qa_profile")
        or state.get("qa_profile")
        or DEFAULT_WORKER_QA_PROFILE
    )


def state_manager_qa_profile(state: dict[str, Any]) -> str:
    return str(state.get("manager_qa_profile") or DEFAULT_MANAGER_QA_PROFILE)


def args_worker_qa_profile(args: argparse.Namespace) -> str:
    return str(
        getattr(args, "worker_qa_profile", None)
        or getattr(args, "qa_profile", None)
        or DEFAULT_WORKER_QA_PROFILE
    )


def manager_qa_required(state: dict[str, Any]) -> bool:
    return state_manager_qa_profile(state) != "none"


def manager_qa_passed(state: dict[str, Any]) -> bool:
    if not manager_qa_required(state):
        return True
    return str(state.get("manager_qa_status") or "") in MANAGER_QA_PASSING_STATUSES


def state_list(state: dict[str, Any], key: str, default: list[str]) -> list[str]:
    return normalize_list(state.get(key)) or list(default)


def worker_protocol_text(protocol: str, worker_qa_profile: str, base_ref: str) -> str:
    if protocol == "codex-impl":
        return f"""Compatibility mode:
- You may use $codex-impl for this bounded task.
- Manager has fixed kickoff choices for this task:
  - implementation gap-check count: 1
  - review/fix loop limit: skip review unless this task explicitly requires it
  - Worker QA profile: {worker_qa_profile}
  - QA target diff: this task branch against {base_ref}
- Do not ask the user for codex-impl preflight choices; Manager already owns them.
"""
    return f"""HLoop Worker Protocol:
1. Re-read MISSION, PLAN, DECISIONS, PROFILE, and your task contract.
2. Inspect the current code enough to verify the task is still valid.
3. Compare the task acceptance criteria against the implementation before editing.
4. Implement the smallest coherent change inside your write scope.
5. Self-review the diff for correctness, product behavior, security/privacy, data integrity, UX, and validation risk.
6. Run repository-appropriate validation for the changed surface and the task validation minimum.
7. Apply Worker QA profile `{worker_qa_profile}`:
   - `repo-default`: choose the repo's documented local checks, scripts, or CI-equivalent commands.
   - `local`: run local app/API/browser checks when the touched workflow is runnable.
   - `staging` or `preview`: collect evidence only when the target URL/credentials are already available in the task or PROFILE; otherwise report blocked QA explicitly.
   - `custom`: follow PROFILE.md and task instructions exactly.
   - `none`: record why QA is intentionally skipped.
8. Write the result artifact and commit your branch.

Manager final QA is a separate gate. Do not treat staging/preview final QA as your task's done condition unless the task contract explicitly says so.

Do not invoke another broad implementation orchestration skill unless the task explicitly opts into one.
"""


def review_protocol_text(
    protocol: str,
    lanes: list[str],
    worker_qa_profile: str,
    manager_qa_profile: str,
    branch_strategy: str,
) -> str:
    lane_lines = "\n".join(f"- {lane}" for lane in lanes)
    if protocol == "codex-review-multi-v2":
        return f"""Compatibility mode:
- You may use $codex-review-multi-v2, but still produce the HLoop artifact and Fix Task Candidates section.
- Review lanes requested by Manager:
{lane_lines}
- Branch strategy: {branch_strategy}
- Worker QA profile to assess: {worker_qa_profile}
- Manager final QA profile to assess: {manager_qa_profile}
"""
    return f"""HLoop Native Review Protocol:
Review the integration result as a Manager gate, not as a generic code review. Use these lanes:
{lane_lines}

Mandatory review sequence:
1. Build the review inventory:
   - `git diff --name-status <base-branch>...<integration-branch>`
   - `git diff --stat <base-branch>...<integration-branch>`
   - task/result artifacts, validation logs, and PROFILE/PLAN/DECISIONS.
2. Read changed files plus the nearest callers, callees, tests, schemas, migrations, generated-code sources, and CI/workflow files needed to verify behavior.
3. Cross-check each Worker result against actual changed files, write scopes, validation commands, Worker QA profile `{worker_qa_profile}`, and acceptance criteria.
4. For every candidate finding, prove the trigger path in the current code. Discard it if the scenario is speculative, pre-existing and unrelated, or unsupported by code evidence.
5. For validation or QA gaps, name the exact missing evidence and the product risk it leaves open. Separate Worker-local QA gaps from Manager final QA gaps.
6. Prefer fewer high-confidence findings over broad checklists.

Lane meanings:
- `integration-contract`: task/result artifacts, write-scope boundaries, merge safety, generated-code boundaries, and state consistency.
- `correctness`: user-visible behavior, edge cases, API/schema contracts, backward compatibility, and repository conventions.
- `risk`: security, auth/authorization, privacy, tenant scope, data integrity, concurrency, idempotency, migrations, performance, rollback, and observability.
- `validation-qa`: whether validation commands, logs, Worker QA profile `{worker_qa_profile}`, Manager final QA profile `{manager_qa_profile}`, and evidence are sufficient for the changed product surface.
- `ux`: visual/interaction/accessibility/copy risks only when UI is touched.
- Custom lane names from PROFILE.md should be interpreted literally and kept actionable.

Branch strategy under review: `{branch_strategy}`. Judge findings against that strategy and the repository's product workflow, not against a fixed branch model.

Do not invoke a generic multi-review skill unless PROFILE.md or the task explicitly opts into one.
"""


def render_worker_prompt(
    task_id: str,
    task_meta: dict[str, Any],
    worktree: Path,
    branch: str,
    state: dict[str, Any],
) -> str:
    worker_protocol = str(task_meta.get("worker_protocol") or state_value(state, "worker_protocol", DEFAULT_WORKER_PROTOCOL))
    if worker_protocol not in WORKER_PROTOCOLS:
        worker_protocol = DEFAULT_WORKER_PROTOCOL
    worker_qa_profile = str(
        task_meta.get("worker_qa_profile")
        or task_meta.get("qa_profile")
        or state_worker_qa_profile(state)
    )
    branch_strategy = state_value(state, "branch_strategy", DEFAULT_BRANCH_STRATEGY)
    base_ref = str(task_meta.get("base_ref") or "the integration branch")
    protocol = worker_protocol_text(worker_protocol, worker_qa_profile, base_ref)
    return f"""You are Worker {task_id}.

You are running in your own git worktree:
{worktree}

Your branch:
{branch}

Read first:
- .ai/loop/MISSION.md
- .ai/loop/PLAN.md
- .ai/loop/PROFILE.md
- .ai/loop/DECISIONS.md
- .ai/loop/tasks/{task_id}.md

Loop profile:
- Branch strategy: {branch_strategy}
- Worker protocol: {worker_protocol}
- Worker QA profile: {worker_qa_profile}

{protocol}

Rules:
- Edit only the files allowed by write_allow in .ai/loop/tasks/{task_id}.md.
- Do not edit .ai/loop/STATE.json.
- Do not edit Manager-owned files: .ai/loop/MISSION.md, PLAN.md, PROFILE.md, DECISIONS.md, JOURNAL.md, or USER_ACTION_REQUIRED.md.
- Do not edit other task files or other result directories.
- Do not merge, rebase, or switch to the integration branch.
- If the task needs a specification decision not present in MISSION/PLAN/task, write status: blocked.

Required output:
- Write .ai/loop/results/{task_id}/result.md using the required frontmatter.
- Commit your work on your branch.

Before finishing:
- Run relevant tests/build from the task.
- Record exact commands and results in flat frontmatter fields:
  validation_recorded: true
  validation_commands:
    - <command>
  validation_results:
    - <passed|failed|blocked>
  validation_summary: "..."
- Review your own diff.
- Ensure no unrelated changes.

Final terminal line:
HERDR_LOOP_TASK_DONE:{task_id}:<done|blocked|failed|partial>
"""


def render_reviewer_prompt(
    review_id: str,
    base_branch: str,
    integration_branch: str,
    state: dict[str, Any],
) -> str:
    review_protocol = state_value(state, "review_protocol", DEFAULT_REVIEW_PROTOCOL)
    if review_protocol not in REVIEW_PROTOCOLS:
        review_protocol = DEFAULT_REVIEW_PROTOCOL
    worker_qa_profile = state_worker_qa_profile(state)
    manager_qa_profile = state_manager_qa_profile(state)
    branch_strategy = state_value(state, "branch_strategy", DEFAULT_BRANCH_STRATEGY)
    lanes = state_list(state, "review_lanes", DEFAULT_REVIEW_LANES)
    protocol = review_protocol_text(
        review_protocol,
        lanes,
        worker_qa_profile,
        manager_qa_profile,
        branch_strategy,
    )
    return f"""You are Reviewer {review_id}.

Compare:
- base branch: {base_branch}
- integration branch: {integration_branch}

You are running in a detached review worktree. Treat the review target as read-only during investigation.

Read:
- .ai/loop/MISSION.md
- .ai/loop/PLAN.md
- .ai/loop/PROFILE.md
- .ai/loop/DECISIONS.md
- .ai/loop/STATE.json
- .ai/loop/tasks/*.md
- .ai/loop/results/*/result.md
- .ai/loop/validation/*.log when present

Review profile:
- Branch strategy: {branch_strategy}
- Worker QA profile: {worker_qa_profile}
- Manager final QA profile: {manager_qa_profile}
- Review protocol: {review_protocol}
- Review lanes: {", ".join(lanes)}

{protocol}

Rules:
- Do not edit code.
- Do not run formatters, generators, migrations, or automatic fix commands.
- Do not commit, merge, rebase, or switch branches.
- Review the integration branch against base.
- For every finding, re-investigate whether it can actually occur in this codebase.
- Do not report vague best-practice issues unless they create concrete risk.
- Prefer concrete code paths, failing scenarios, or missing tests.
- Classify severity as P0/P1/P2/P3.
- Recommend Manager action: fix_task, decision_needed, accepted_risk_candidate, or false_positive_candidate.

Output:
- During review, do not write files.
- After review is complete, write only .ai/loop/reviews/{review_id}.md.
- Include frontmatter: review_id, base, head, status: reported|blocked|failed.
- If blocked or failed, still write the artifact with the concrete reason.
- Include a `## Fix Task Candidates` section. For every finding that should become a Worker fix task, add:
  `### FTNNN: <title>`, `action: fix_task`, `severity: P0|P1|P2|P3`, `write_allow:`, `acceptance:`, and `rationale:`.
  If no fix task is needed, write `No fix task candidates.`

Final terminal line:
HERDR_LOOP_REVIEW_DONE:{review_id}:<reported|blocked|failed>
"""


def render_gap_prompt(
    gap_id: str,
    base_branch: str,
    integration_branch: str,
    spec_sources: list[str],
) -> str:
    if spec_sources:
        source_lines = "\n".join(f"- {item}" for item in spec_sources)
    else:
        source_lines = "- No extra spec source was configured; use MISSION.md, PLAN.md, DECISIONS.md, tasks, and results as the implementation contract."
    return f"""You are Gap Auditor {gap_id}.

Purpose:
- Compare the intended plan/spec against the current implementation.
- Find specification coverage gaps, not generic code-review issues.

Compare:
- base branch: {base_branch}
- integration branch: {integration_branch}

You are running in a detached gap-audit worktree. Treat the target as read-only during investigation.

Read:
- .ai/loop/MISSION.md
- .ai/loop/PLAN.md
- .ai/loop/DECISIONS.md
- .ai/loop/tasks/*.md
- .ai/loop/results/*/result.md

Spec sources:
{source_lines}

Rules:
- Do not edit code.
- Do not run formatters, generators, migrations, or automatic fix commands.
- Do not commit, merge, rebase, or switch branches.
- Check whether each planned requirement is implemented, partially implemented, intentionally deferred, obsolete, or blocked by a decision gap.
- Verify every gap against the actual code path or missing artifact.
- Do not report broad best-practice review findings unless they directly prove plan/spec drift.
- Classify each item as implemented, partial, missing, deferred, obsolete-spec, or needs-decision.
- Recommend Manager action: fix_task, decision_needed, accepted_risk_candidate, stale_spec_update, or no_action.

Output:
- During investigation, do not write files.
- After the audit is complete, write only .ai/loop/gaps/{gap_id}.md.
- Include frontmatter: gap_id, base, head, status: aligned|gaps-found|blocked|failed, spec_sources, gap_count.
- If blocked or failed, still write the artifact with the concrete reason.
- Include a `## Fix Task Candidates` section. For every missing or partial requirement that should become a Worker fix task, add:
  `### FTNNN: <title>`, `action: fix_task`, `priority: P0|P1|P2|P3`, `write_allow:`, `acceptance:`, and `rationale:`.
  If no fix task is needed, write `No fix task candidates.`

Final terminal line:
HERDR_LOOP_GAP_DONE:{gap_id}:<aligned|gaps-found|blocked|failed>
"""


def cmd_doctor(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    herdr_skill_candidates = []
    if os.environ.get("HERDR_SKILL_PATH"):
        herdr_skill_candidates.append(Path(os.environ["HERDR_SKILL_PATH"]))
    herdr_skill_candidates.extend(
        [
            Path.home() / ".agents/skills/herdr/SKILL.md",
            codex_home / "skills/herdr/SKILL.md",
            Path.home() / ".codex/skills/herdr/SKILL.md",
        ]
    )
    herdr_skill = next((path for path in herdr_skill_candidates if path.exists()), None)
    checks: dict[str, Any] = {
        "repo": str(repo),
        "HERDR_ENV": os.environ.get("HERDR_ENV"),
        "HERDR_PANE_ID": os.environ.get("HERDR_PANE_ID"),
        "HERDR_WORKSPACE_ID": os.environ.get("HERDR_WORKSPACE_ID"),
        "HERDR_TAB_ID": os.environ.get("HERDR_TAB_ID"),
        "commands": {
            "git": command_exists("git"),
            "herdr": command_exists("herdr"),
            "codex": command_exists("codex"),
        },
        "skills": {
            "herdr": str(herdr_skill or herdr_skill_candidates[0]),
        },
        "optional_skills": {
            "codex-impl": str(codex_home / "skills/codex-impl/SKILL.md"),
            "codex-review-multi-v2": str(
                codex_home / "skills/codex-review-multi-v2/SKILL.md"
            ),
        },
        "warnings": [],
    }
    checks["skills"] = {
        key: {"path": value, "exists": Path(value).exists()}
        for key, value in checks["skills"].items()
    }
    checks["optional_skills"] = {
        key: {"path": value, "exists": Path(value).exists()}
        for key, value in checks["optional_skills"].items()
    }
    checks["skills"]["herdr"]["candidates"] = [str(path) for path in herdr_skill_candidates]
    if not checks["skills"]["herdr"]["exists"]:
        checks["warnings"].append("herdr skill file not found; continuing because the herdr CLI is authoritative")
    for key, item in checks["optional_skills"].items():
        if not item["exists"]:
            checks["warnings"].append(
                f"optional compatibility skill `{key}` not found; native hloop protocols do not require it"
            )
    if command_exists("codex"):
        proc = run_cmd(["codex", "--version"], check=False)
        checks["codex_version"] = (proc.stdout or proc.stderr).strip()
    if command_exists("herdr") and os.environ.get("HERDR_ENV") == "1":
        status_proc = run_cmd(["herdr", "status"], check=False)
        checks["herdr_status"] = (status_proc.stdout or status_proc.stderr).strip()
        try:
            current = json_from_cmd(["herdr", "pane", "current", "--current"])
            checks["current_pane_id"] = extract_pane_id(current)
        except HLoopError as exc:
            checks["herdr_error"] = str(exc)
    if getattr(args, "sessions", False):
        try:
            checks["loop_inventory"] = collect_loop_inventory(
                repo,
                probe_panes=True,
                lines=getattr(args, "session_lines", 80),
                include_output=False,
            )
        except HLoopError as exc:
            checks["warnings"].append(f"session inventory unavailable: {exc}")
    herdr_skill_ok = checks["skills"]["herdr"]["exists"] or not args.strict_skills
    ok = checks["HERDR_ENV"] == "1" and all(checks["commands"].values()) and herdr_skill_ok
    checks["ok"] = ok
    if args.json:
        print(json.dumps(checks, ensure_ascii=False, indent=2))
    else:
        for key, value in checks.items():
            print(f"{key}: {value}")
    return 0 if ok else 1


def contract_required_state_fields(text: str) -> list[str]:
    fields: list[str] = []
    in_required = False
    for line in text.splitlines():
        if line.strip() == "Required top-level fields:":
            in_required = True
            continue
        if in_required and line.strip().startswith("Treat `pane_id`"):
            break
        if not in_required:
            continue
        match = re.match(r"^-\s+`([^`]+)`\s*$", line.strip())
        if match:
            fields.append(match.group(1))
    return fields


def openai_yaml_interface_fields(text: str) -> set[str]:
    fields: set[str] = set()
    in_interface = False
    for line in text.splitlines():
        if line.strip() == "interface:":
            in_interface = True
            continue
        if not in_interface:
            continue
        match = re.match(r"^\s{2}([a-zA-Z0-9_]+):\s+.+$", line)
        if match:
            fields.add(match.group(1))
            continue
        if line.strip() and not line.startswith(" "):
            break
    return fields


def schema_has_merge_ready_guard(schema: dict[str, Any]) -> bool:
    all_of = schema.get("allOf")
    if not isinstance(all_of, list):
        return False
    for item in all_of:
        if not isinstance(item, dict):
            continue
        condition = item.get("if", {})
        then = item.get("then", {})
        if not isinstance(condition, dict) or not isinstance(then, dict):
            continue
        if (
            condition.get("properties", {})
            .get("merge_ready", {})
            .get("const")
            is not True
        ):
            continue
        required = set(normalize_list(then.get("required")))
        props = then.get("properties", {})
        if not isinstance(props, dict):
            continue
        if {
            "status",
            "validation_recorded",
            "validation_commands",
            "validation_results",
        }.issubset(required) and props.get("status", {}).get("const") == "done":
            return True
    return False


def schema_has_write_allow_guard(schema: dict[str, Any]) -> bool:
    all_of = schema.get("allOf")
    if not isinstance(all_of, list):
        return False
    for item in all_of:
        if not isinstance(item, dict):
            continue
        condition = item.get("if", {})
        then = item.get("then", {})
        if not isinstance(condition, dict) or not isinstance(then, dict):
            continue
        kind = condition.get("properties", {}).get("kind", {})
        write_allow = then.get("properties", {}).get("write_allow", {})
        if kind.get("enum") == ["implementation", "fix"] and write_allow.get("minItems") == 1:
            return True
    return False


def cmd_selftest(args: argparse.Namespace) -> int:
    skill_root = (
        Path(args.skill_dir).resolve()
        if args.skill_dir
        else Path(__file__).resolve().parents[1]
    )
    errors: list[str] = []

    def check(condition: bool, message: str) -> None:
        if not condition:
            errors.append(message)

    skill_md = skill_root / "SKILL.md"
    skill_meta = parse_frontmatter_text(read_text(skill_md))
    check(skill_meta.get("name") == "herdr-dev-loop", "SKILL.md frontmatter name is invalid")
    check(bool(skill_meta.get("description")), "SKILL.md frontmatter description is missing")

    openai_yaml = skill_root / "agents" / "openai.yaml"
    fields = openai_yaml_interface_fields(read_text(openai_yaml))
    check(
        {"display_name", "short_description", "default_prompt"}.issubset(fields),
        "agents/openai.yaml interface fields are incomplete",
    )

    schema_dir = skill_root / "references" / "schemas"
    schemas: dict[str, dict[str, Any]] = {}
    for path in sorted(schema_dir.glob("*.json")):
        try:
            data = json.loads(read_text(path))
        except json.JSONDecodeError as exc:
            errors.append(f"{path.name} is invalid JSON: {exc}")
            continue
        if not isinstance(data, dict):
            errors.append(f"{path.name} is not a JSON object")
            continue
        schemas[path.name] = data

    state_schema = schemas.get("state.schema.json", {})
    contract_fields = contract_required_state_fields(
        read_text(skill_root / "references" / "artifact-contract.md")
    )
    schema_required = normalize_list(state_schema.get("required"))
    check(bool(contract_fields), "artifact-contract required state fields were not found")
    check(
        set(contract_fields) == set(schema_required),
        "STATE.json required fields differ between artifact-contract.md and state.schema.json",
    )

    result_schema = schemas.get("result.schema.json", {})
    task_schema = schemas.get("task.schema.json", {})
    check(schema_has_merge_ready_guard(result_schema), "result.schema.json lacks merge_ready guard")
    check(schema_has_write_allow_guard(task_schema), "task.schema.json lacks write_allow guard")

    result_meta = parse_frontmatter_text(
        """---
task_id: T001
status: done
merge_ready: true
branch: ai/demo/T001
head_sha: HEAD
base_sha: abc123
changed_files:
  - src/demo.ts
validation_recorded: true
validation_commands:
  - npm test -- tests/demo.test.ts
validation_results:
  - passed
validation_summary: "targeted tests passed"
blocking_questions: []
---
"""
    )
    check(result_meta.get("merge_ready") is True, "sample result merge_ready did not parse")
    check(
        normalize_list(result_meta.get("validation_commands")),
        "sample result validation_commands did not parse as a list",
    )
    check(
        matches_any("app/[liveId]/page.tsx", ["app/[liveId]/**"]),
        "write_allow matcher does not treat bracket path segments literally",
    )
    parsed_task = build_parser().parse_args(
        [
            "task",
            "new",
            "demo task",
            "--write-allow",
            "app/[liveId]/**",
            "--validation-minimum",
            "L1",
            "--validation-minimum",
            "local browser QA",
        ]
    )
    check(
        parsed_task.validation_minimum == ["L1", "local browser QA"],
        "task new did not preserve repeated --validation-minimum values",
    )
    parsed_harvest = build_parser().parse_args(["harvest", "T001"])
    check(parsed_harvest.command == "harvest", "top-level harvest command did not parse")
    parsed_wait = build_parser().parse_args(["wait", "next"])
    check(parsed_wait.timeout_ms == DEFAULT_WAIT_TIMEOUT_MS, "wait timeout default drifted")
    parsed_checkpoint = build_parser().parse_args(["checkpoint", "--message", "ai-loop: checkpoint"])
    check(parsed_checkpoint.command == "checkpoint", "checkpoint command did not parse")
    parsed_rollup = build_parser().parse_args(
        ["checkpoint", "--message", "ai-loop(B001): checkpoint", "--batch", "B001", "--rollup"]
    )
    check(parsed_rollup.batch == "B001" and parsed_rollup.rollup, "checkpoint rollup args did not parse")
    parsed_batch = build_parser().parse_args(["batch", "start", "demo batch", "--id", "B001"])
    check(parsed_batch.batch_command == "start", "batch start command did not parse")
    parsed_pump = build_parser().parse_args(["pump"])
    check(parsed_pump.sleep_ms == DEFAULT_PUMP_SLEEP_MS, "pump sleep default drifted")
    check(
        normalize_validation_log_output("line with spaces  \nnext\t \r\n") == "line with spaces\nnext\n",
        "validation log normalization did not trim trailing whitespace",
    )
    message_state: dict[str, Any] = {}
    record_manager_message(
        message_state,
        "argv",
        "hello",
        delivery_status="pending",
        delivery_error="Codex is still working",
        pending_path=".ai/loop/inbox/pending/example.md",
    )
    check(
        message_state.get("manager_messages", [{}])[-1].get("delivery_status") == "pending",
        "manager message delivery status was not recorded",
    )
    check(
        item_artifact_state(
            {
                "role": "worker",
                "status": "merged",
                "cleanup_done": True,
                "artifact": {
                    "state": "missing",
                    "status": "done",
                    "committed_path": ".ai/loop/results/T001/result.md",
                },
            }
        )
        == "cleaned/done/committed",
        "merged cleaned Worker artifact display is misleading",
    )

    review_meta = parse_frontmatter_text(
        """---
review_id: R001
base: main
head: ai/demo/integration
status: reported
---
"""
    )
    check(
        str(review_meta.get("status")) in REVIEW_ARTIFACT_STATUSES,
        "sample review artifact status is invalid",
    )

    gap_meta = parse_frontmatter_text(
        """---
gap_id: G001
base: main
head: ai/demo/integration
status: aligned
gap_count: 0
---
"""
    )
    check(str(gap_meta.get("status")) in GAP_ARTIFACT_STATUSES, "sample gap artifact status is invalid")

    batch_meta = parse_frontmatter_text(
        """---
id: B001
title: Demo batch
status: active
task_ids:
  - T001
checkpoint_mode: rollup
---
"""
    )
    check(batch_meta.get("id") == "B001", "sample batch artifact id did not parse")
    check(normalize_list(batch_meta.get("task_ids")) == ["T001"], "sample batch task_ids did not parse")

    reliability_codes = {
        item["code"]
        for item in agent_contract_issues(
            skill_root,
            role="worker",
            agent_id="T999",
            agent={
                "status": "result_reported",
                "sandbox": "danger-full-access",
                "prompt": "/tmp/manual-prompt.md",
                "worktree": "/tmp/manual-worker",
                "head_sha": "manager-working-tree",
                "merge_ready": True,
                "integration_method": "manager_manual_apply_after_worker_quota_failure",
                "result_path": str(skill_root / LOOP_DIR / "results" / "T999" / "result.md"),
            },
        )
    }
    check("unsafe-agent-sandbox" in reliability_codes, "reliability audit missed unsafe sandbox")
    check("non-hloop-prompt" in reliability_codes, "reliability audit missed non-hloop prompt")
    check("untrusted-worker-head" in reliability_codes, "reliability audit missed untrusted Worker head")
    check(
        "merge-ready-without-committed-result" in reliability_codes,
        "reliability audit missed missing committed result path",
    )

    result = {"ok": not errors, "skill_root": str(skill_root), "errors": errors}
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    elif errors:
        for error in errors:
            print(f"selftest: {error}", file=sys.stderr)
    else:
        print("selftest ok")
    return 0 if not errors else 1


def cmd_init(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    base = args.base or current_branch(repo) or "main"
    goal_id = args.goal_id or slugify(args.goal, 32)
    integration = args.integration or f"ai/{goal_id}/integration"
    worker_qa_profile = args_worker_qa_profile(args)
    manager_qa_profile = str(
        getattr(args, "manager_qa_profile", None) or DEFAULT_MANAGER_QA_PROFILE
    )
    if args.create_branch:
        if branch_exists(repo, integration):
            git(repo, ["switch", integration])
        else:
            git(repo, ["switch", "-c", integration, base])

    mission = loop_path(repo) / "MISSION.md"
    plan = loop_path(repo) / "PLAN.md"
    profile = loop_path(repo) / "PROFILE.md"
    decisions = loop_path(repo) / "DECISIONS.md"
    user_action = loop_path(repo) / "USER_ACTION_REQUIRED.md"
    journal_path = loop_path(repo) / "JOURNAL.md"
    if not mission.exists() or args.force:
        write_text(
            mission,
            f"""# Mission

## Goal
{args.goal}

## Context
TBD by Manager.

## Constraints
- Use Herdr-managed panes only when `HERDR_ENV=1`.
- Persist loop state in `.ai/loop`.
- Stop on blocking specification decisions.

## Non-goals
- Do not run unbounded autonomous loops.

## Done when
- All planned tasks are merged into `{integration}`.
- Required validation passes.
- No blocking plan/spec implementation gap remains.
- No blocking review finding remains.

## Base branch
{base}

## Integration branch
{integration}

## Validation levels
- L0: format / lint / typecheck
- L1: relevant unit tests
- L2: full build / full test
- L3: e2e or manual verification
""",
        )
    if not profile.exists() or args.force:
        lanes = args.review_lane or DEFAULT_REVIEW_LANES
        write_text(
            profile,
            f"""# Loop Profile

Manager-owned project profile for branch strategy, implementation protocol, review strategy, Worker QA, and final Manager QA.

## Branch Strategy
{args.branch_strategy}

- `integration`: hloop manages one integration branch plus one branch/worktree per Worker task.
- `pr-per-task`: Manager may keep Worker branches PR-oriented; use hloop artifacts as coordination gates and adapt merge/publish steps in PLAN.
- `custom`: product-specific branch rules in PLAN override default branch assumptions. Keep safety gates explicit.

## Worker Protocol
{args.worker_protocol}

- `native`: Workers follow the HLoop Worker Protocol embedded in their prompt.
- `codex-impl`: compatibility mode only; use when Manager intentionally wants the external skill's preflight/review/QA behavior.

## Review Protocol
{args.review_protocol}

- `native`: Reviewers use HLoop review lanes tuned for Manager gating, task artifacts, validation evidence, and product risk.
- `codex-review-multi-v2`: compatibility mode only; still require HLoop artifact shape and Fix Task Candidates.

## Review Lanes
{chr(10).join(f"- {item}" for item in lanes)}

## Worker QA Profile
{worker_qa_profile}

- `repo-default`: choose repository-native checks from scripts, CI, docs, or existing QA artifacts.
- `local`: run local app/API/browser checks when the touched workflow is runnable.
- `staging`: use staging only when credentials and URLs are already available.
- `preview`: use PR/preview only when a URL is already available or discoverable from repo tooling.
- `custom`: follow the QA section in PLAN exactly.
- `none`: record the reason QA is intentionally skipped.

## Manager Final QA Profile
{manager_qa_profile}

- `none`: no separate Manager final QA gate.
- `repo-default`: Manager records final repository-appropriate evidence after integration/review/gap gates pass.
- `local`: Manager records final local app/API/browser evidence after the combined implementation is assembled.
- `staging`: Manager records staging URL, data setup, cleanup, screenshots/logs, and blockers before final completion.
- `preview`: Manager records PR/preview URL evidence before final completion.
- `custom`: Manager follows the final QA section in PLAN exactly.
""",
        )
    if not plan.exists() or args.force:
        write_text(
            plan,
            """# Plan

## Strategy
TBD by Manager.

## Branch strategy
Follow `.ai/loop/PROFILE.md`. If the product needs PR-per-task, release-branch, or custom flow, record the exact merge/publish handoff here before dispatching Workers.

## Task graph
- Add tasks with `hloop task new`.

## Parallelization rules
- Run Workers in parallel only when their `write_allow` patterns do not overlap.

## Validation plan
- Run task-specific validation before merge.
- Run integration validation after each merge.

## Worker QA plan
- Workers follow `.ai/loop/PROFILE.md` Worker QA profile unless a task overrides it.
- Worker QA evidence belongs in each task result artifact.

## Manager final QA plan
- Manager follows `.ai/loop/PROFILE.md` Manager Final QA profile after the combined implementation is ready.
- Manager final QA evidence belongs in `.ai/loop/qa/FINAL.md` and the final report.
- If Manager final QA is staging or preview, record URL, environment, data setup, cleanup, screenshots/logs, and blockers.

## Review plan
- Keep up to 3 Workers running when write scopes do not overlap.
- Run Reviewer frequently after validated integration advances.
- Run Gap Auditor less frequently against original plan/spec sources, and always before final completion when configured.
""",
        )
    if not decisions.exists():
        write_text(
            decisions,
            """# Decisions

Manager-owned record for specification choices that cannot be answered from the original plan/spec alone.

## Pending Decisions

None.

## Accepted Decisions

None.

## Rejected Decisions

None.
""",
        )
    if not user_action.exists():
        write_text(user_action, "# User Action Required\n\nNo blocking user action.\n")
    if not journal_path.exists():
        write_text(journal_path, "# Journal\n")
    state = {
        "goal_id": goal_id,
        "phase": "initialized",
        "base_branch": base,
        "integration_branch": integration,
        "merge_mode": args.merge_mode,
        "branch_strategy": args.branch_strategy,
        "worker_qa_profile": worker_qa_profile,
        "manager_qa_profile": manager_qa_profile,
        "manager_qa_status": "not-required" if manager_qa_profile == "none" else "pending",
        "worker_protocol": args.worker_protocol,
        "review_protocol": args.review_protocol,
        "review_lanes": args.review_lane or DEFAULT_REVIEW_LANES,
        "worker_runner": args.worker_runner,
        "reviewer_runner": args.reviewer_runner,
        "gap_runner": args.gap_runner,
        "session_cleanup": args.session_cleanup,
        "review_wait_ms": args.review_wait_ms,
        "gap_wait_ms": args.gap_wait_ms,
        "review_after_merges": args.review_after_merges,
        "gap_after_merges": args.gap_after_merges,
        "unreviewed_merge_count": 0,
        "ungapped_merge_count": 0,
        "cycle": 0,
        "max_workers": args.max_workers,
        "max_reviewers": args.max_reviewers,
        "max_gap_auditors": args.max_gap_auditors,
        "spec_sources": args.spec_source or [],
        "validation_commands": args.validation or [],
        "tasks": {},
        "batches": {},
        "reviews": {},
        "gaps": {},
        "blocking_decisions": [],
        "created_at": now_iso(),
    }
    if state_path(repo).exists() and not args.force:
        old = load_state(repo)
        old.setdefault("validation_commands", args.validation or [])
        old.setdefault("branch_strategy", args.branch_strategy)
        old.setdefault("worker_qa_profile", old.get("qa_profile", worker_qa_profile))
        old.setdefault("manager_qa_profile", manager_qa_profile)
        old.setdefault(
            "manager_qa_status",
            "not-required" if state_manager_qa_profile(old) == "none" else "pending",
        )
        old.setdefault("worker_protocol", args.worker_protocol)
        old.setdefault("review_protocol", args.review_protocol)
        old.setdefault("review_lanes", args.review_lane or DEFAULT_REVIEW_LANES)
        old.setdefault("review_after_merges", args.review_after_merges)
        old.setdefault("gap_after_merges", args.gap_after_merges)
        old.setdefault("unreviewed_merge_count", 0)
        old.setdefault("ungapped_merge_count", 0)
        old.setdefault("max_workers", args.max_workers)
        old.setdefault("max_reviewers", args.max_reviewers)
        old.setdefault("max_gap_auditors", args.max_gap_auditors)
        old.setdefault("gaps", {})
        old.setdefault("batches", {})
        save_state(repo, old)
        print(f"STATE.json already exists: {state_path(repo)}")
        return 0
    save_state(repo, state)
    journal(repo, f"Initialized loop `{goal_id}` on integration branch `{integration}`.")
    print(f"initialized .ai/loop for {goal_id}")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    if getattr(args, "raw_state", False):
        state = load_state(repo)
        print(json.dumps(state, ensure_ascii=False, indent=2))
        return 0
    inventory = collect_loop_inventory(
        repo,
        probe_panes=not getattr(args, "no_pane_probe", False),
        lines=getattr(args, "lines", 80),
        include_output=False,
    )
    if args.json:
        print(json.dumps(inventory, ensure_ascii=False, indent=2))
        return 0
    loop = inventory["loop"]
    counts = inventory["counts"]
    print(f"goal_id: {loop.get('goal_id')}")
    print(f"phase: {loop.get('phase')}")
    print(f"base: {loop.get('base_branch')} {loop.get('base_sha')}")
    print(f"integration: {loop.get('integration_branch')} {loop.get('integration_sha')}")
    print(f"current_branch: {loop.get('current_branch')}")
    print(f"branch_strategy: {loop.get('branch_strategy')}")
    print(f"worker_protocol: {loop.get('worker_protocol')}")
    print(f"review_protocol: {loop.get('review_protocol')}")
    print(f"worker_qa_profile: {loop.get('worker_qa_profile')}")
    print(f"manager_qa_profile: {loop.get('manager_qa_profile')}")
    print(f"manager_qa_status: {loop.get('manager_qa_status')}")
    print(f"current_batch_id: {loop.get('current_batch_id') or '-'}")
    print(
        "review_queue: "
        f"{loop.get('review_queue', {}).get('count')}/"
        f"{loop.get('review_queue', {}).get('threshold')}"
    )
    print(
        "gap_queue: "
        f"{loop.get('gap_queue', {}).get('count')}/"
        f"{loop.get('gap_queue', {}).get('threshold')}"
    )
    print(
        "agents: "
        f"workers {counts.get('workers_running')}/{counts.get('workers')} running, "
        f"reviewers {counts.get('reviewers_running')}/{counts.get('reviewers')} running, "
        f"gaps {counts.get('gaps_running')}/{counts.get('gaps')} running"
    )
    print(f"issues: {counts.get('issues')} ({counts.get('p0_p1_issues')} P0/P1)")
    for item in inventory["issues"][:10]:
        print(
            f"  {item.get('severity')} {item.get('subject')} "
            f"{item.get('code')}: {item.get('message')}"
        )
    return 0


def item_agent_status(item: dict[str, Any]) -> str:
    pane = item.get("pane", {})
    if not isinstance(pane, dict):
        return ""
    if pane.get("present"):
        return str(pane.get("agent_status") or "")
    reason = pane.get("reason")
    return f"pane:{reason}" if reason else ""


def item_artifact_state(item: dict[str, Any]) -> str:
    artifact = item.get("artifact", {})
    if not isinstance(artifact, dict):
        return ""
    state = str(artifact.get("state") or "")
    status = str(artifact.get("status") or artifact.get("artifact_status") or "")
    if item.get("role") in {"reviewer", "gap"}:
        status = str(item.get("artifact_status") or "")
    commit_state = str(artifact.get("commit_state") or "")
    if (
        item.get("role") == "worker"
        and item.get("status") == "merged"
        and state == "missing"
        and status
    ):
        state = "cleaned" if item.get("cleanup_done") else "state"
        if artifact.get("committed_path") and not commit_state:
            commit_state = "committed"
    parts = [part for part in [state, status, commit_state] if part]
    return "/".join(parts)


def print_agent_rows(title: str, items: list[dict[str, Any]]) -> None:
    print(title + ":")
    if not items:
        print("  none")
        return
    for item in items:
        agent_id = item.get("id")
        role = item.get("role")
        status = item.get("gate_status") or item.get("status")
        pane_id = item.get("pane", {}).get("pane_id", "")
        pane_status = item_agent_status(item)
        artifact = item_artifact_state(item)
        issue_count = len(item.get("issues", []))
        suffix = f" issues={issue_count}" if issue_count else ""
        print(
            f"  {agent_id}: {role} status={status} pane={pane_id or '-'} "
            f"agent={pane_status or '-'} artifact={artifact or '-'}{suffix}"
        )


def print_inventory_dashboard(inventory: dict[str, Any]) -> None:
    loop = inventory["loop"]
    counts = inventory["counts"]
    print(f"HLoop dashboard: {loop.get('goal_id')} phase={loop.get('phase')} cycle={loop.get('cycle')}")
    print(
        f"repo={inventory.get('repo')} current={loop.get('current_branch')} "
        f"integration={loop.get('integration_branch')}@{loop.get('integration_sha')}"
    )
    print(
        "queues: "
        f"review {loop.get('review_queue', {}).get('count')}/{loop.get('review_queue', {}).get('threshold')}, "
        f"gap {loop.get('gap_queue', {}).get('count')}/{loop.get('gap_queue', {}).get('threshold')}, "
        f"validation={'yes' if loop.get('needs_validation') else 'no'}"
    )
    print(f"batch: current={loop.get('current_batch_id') or '-'} total={counts.get('batches')}")
    print(
        "counts: "
        f"workers={counts.get('workers')} running={counts.get('workers_running')} "
        f"queued={counts.get('workers_queued')} merge_ready={counts.get('workers_merge_ready')}; "
        f"reviewers={counts.get('reviewers')} running={counts.get('reviewers_running')} reported={counts.get('reviewers_reported')}; "
        f"gaps={counts.get('gaps')} running={counts.get('gaps_running')} reported={counts.get('gaps_reported')}"
    )
    print_agent_rows("Workers", inventory["workers"])
    print_agent_rows("Reviewers", inventory["reviewers"])
    print_agent_rows("Gaps", inventory["gaps"])
    print("Issues:")
    if not inventory["issues"]:
        print("  none")
    for item in inventory["issues"]:
        print(
            f"  {item.get('severity')} {item.get('subject')} "
            f"{item.get('code')}: {item.get('message')}"
        )
        if item.get("action"):
            print(f"    action: {item.get('action')}")
    if inventory.get("next_actions"):
        print("Next actions:")
        for action in inventory["next_actions"]:
            print(f"  - {action}")


def cmd_dashboard(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    inventory = collect_loop_inventory(
        repo,
        probe_panes=not args.no_pane_probe,
        lines=args.lines,
        include_output=args.include_output,
    )
    if args.json:
        print(json.dumps(inventory, ensure_ascii=False, indent=2))
        return 0
    print_inventory_dashboard(inventory)
    return 0


def cmd_conductor(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    inventory = collect_loop_inventory(
        repo,
        probe_panes=not args.no_pane_probe,
        lines=args.lines,
        include_output=args.include_output,
    )
    blocking = [
        item for item in inventory["issues"] if item.get("severity") in {"P0", "P1"}
    ]
    result = {
        "ok": not blocking,
        "blocking_issue_count": len(blocking),
        "issues": inventory["issues"],
        "next_actions": inventory["next_actions"],
        "inventory": inventory,
    }
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print(
            f"conductor: {'ok' if result['ok'] else 'attention'} "
            f"({len(inventory['issues'])} issue(s), {len(blocking)} P0/P1)"
        )
        if inventory["issues"]:
            print("issues:")
            for item in inventory["issues"]:
                print(
                    f"  {item.get('severity')} {item.get('subject')} "
                    f"{item.get('code')}: {item.get('message')}"
                )
                if item.get("action"):
                    print(f"    action: {item.get('action')}")
        if inventory["next_actions"]:
            print("next actions:")
            for action in inventory["next_actions"]:
                print(f"  - {action}")
    return 0 if args.no_fail or not blocking else 2


def validate_batch_id(batch_id: str) -> str:
    value = str(batch_id or "").strip()
    if not BATCH_ID_RE.fullmatch(value):
        raise HLoopError(f"invalid batch id: {batch_id}; expected BNNN")
    return value


def state_batches(state: dict[str, Any]) -> dict[str, Any]:
    batches = state.setdefault("batches", {})
    if not isinstance(batches, dict):
        raise HLoopError("STATE.json batches must be an object")
    return batches


def current_batch_id(state: dict[str, Any]) -> str:
    value = str(state.get("current_batch_id") or "")
    return validate_batch_id(value) if value else ""


def require_batch(state: dict[str, Any], batch_id: str) -> dict[str, Any]:
    batch_id = validate_batch_id(batch_id)
    batches = state_batches(state)
    batch = batches.get(batch_id)
    if not isinstance(batch, dict):
        raise HLoopError(f"unknown batch: {batch_id}")
    return batch


def batch_task_ids(state: dict[str, Any], batch_id: str) -> list[str]:
    batch = require_batch(state, batch_id)
    ids = list(normalize_list(batch.get("task_ids")))
    for task_id, task_state in state.get("tasks", {}).items():
        if isinstance(task_state, dict) and str(task_state.get("batch_id") or "") == batch_id:
            ids.append(task_id)
    return sorted(dict.fromkeys(ids))


def write_batch_artifact(repo: Path, state: dict[str, Any], batch_id: str) -> None:
    batch = require_batch(state, batch_id)
    task_ids = batch_task_ids(state, batch_id)
    batch["task_ids"] = task_ids
    fields = {
        "id": batch_id,
        "title": str(batch.get("title") or batch_id),
        "status": str(batch.get("status") or "active"),
        "task_ids": task_ids,
        "started_at": str(batch.get("started_at") or batch.get("created_at") or ""),
        "closed_at": str(batch.get("closed_at") or ""),
        "checkpoint_mode": str(batch.get("checkpoint_mode") or "rollup"),
        "summary": str(batch.get("summary") or ""),
    }
    task_lines = [f"- {task_id}" for task_id in task_ids] or ["- No tasks assigned."]
    body = f"""# Batch {batch_id}: {fields["title"]}

## Purpose
{fields["title"]}

## Tasks
{chr(10).join(task_lines)}

## Commit Policy
Use `hloop checkpoint --batch {batch_id} --rollup --message "ai-loop({batch_id}): ..."` for loop-state-only commits while this batch is active. Rollup may amend only an unpushed `.ai/loop` checkpoint commit for the same batch.

## Summary
{fields["summary"] or "TBD by Manager."}
"""
    write_text(batch_file(repo, batch_id), frontmatter(fields) + "\n" + body)


def assign_tasks_to_batch(repo: Path, state: dict[str, Any], batch_id: str, task_ids: list[str]) -> None:
    batch = require_batch(state, batch_id)
    tasks = state.setdefault("tasks", {})
    existing = set(normalize_list(batch.get("task_ids")))
    for task_id in task_ids:
        if task_id not in tasks:
            raise HLoopError(f"unknown task: {task_id}")
        task_state = tasks[task_id]
        if not isinstance(task_state, dict):
            raise HLoopError(f"task state must be an object: {task_id}")
        task_state["batch_id"] = batch_id
        task_path = task_file(repo, task_id)
        if task_path.exists():
            replace_frontmatter(task_path, {"batch_id": batch_id})
        existing.add(task_id)
    batch["task_ids"] = sorted(existing)


def cmd_batch_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    batches = state_batches(state)
    batch_id = validate_batch_id(args.id) if args.id else next_id("B", batches)
    if batch_id in batches:
        raise HLoopError(f"batch already exists: {batch_id}")
    now = now_iso()
    batches[batch_id] = {
        "title": args.title,
        "status": "active",
        "task_ids": [],
        "created_at": now,
        "started_at": now,
        "checkpoint_mode": "rollup",
    }
    if args.task:
        assign_tasks_to_batch(repo, state, batch_id, args.task)
    if not args.no_current:
        state["current_batch_id"] = batch_id
    write_batch_artifact(repo, state, batch_id)
    save_state(repo, state)
    journal(repo, f"Started batch `{batch_id}`: {args.title}")
    print(f"started {batch_id}: {batch_file(repo, batch_id)}")
    return 0


def cmd_batch_assign(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    batch_id = validate_batch_id(args.batch_id)
    require_batch(state, batch_id)
    assign_tasks_to_batch(repo, state, batch_id, args.task_id)
    write_batch_artifact(repo, state, batch_id)
    save_state(repo, state)
    journal(repo, f"Assigned tasks to batch `{batch_id}`: {', '.join(args.task_id)}")
    print(f"assigned {len(args.task_id)} task(s) to {batch_id}")
    return 0


def cmd_batch_close(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    batch_id = validate_batch_id(args.batch_id or current_batch_id(state))
    batch = require_batch(state, batch_id)
    batch["status"] = args.status
    batch["closed_at"] = now_iso()
    batch["summary"] = args.summary
    if current_batch_id(state) == batch_id:
        state.pop("current_batch_id", None)
    write_batch_artifact(repo, state, batch_id)
    save_state(repo, state)
    journal(repo, f"Closed batch `{batch_id}` as `{args.status}`: {args.summary}")
    print(f"closed {batch_id}")
    return 0


def cmd_batch_list(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    current = current_batch_id(state)
    rows = []
    for batch_id, batch in sorted(state_batches(state).items()):
        if not isinstance(batch, dict):
            continue
        rows.append(
            {
                "id": batch_id,
                "status": batch.get("status", ""),
                "title": batch.get("title", ""),
                "task_ids": batch_task_ids(state, batch_id),
                "current": batch_id == current,
            }
        )
    if args.json:
        print(json.dumps({"current_batch_id": current, "batches": rows}, ensure_ascii=False, indent=2))
        return 0
    if not rows:
        print("no batches")
        return 0
    for row in rows:
        marker = "*" if row["current"] else " "
        tasks = ",".join(row["task_ids"]) or "-"
        print(f"{marker} {row['id']} {row['status']} tasks={tasks} {row['title']}")
    return 0


def cmd_batch_show(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    batch_id = validate_batch_id(args.batch_id or current_batch_id(state))
    batch = require_batch(state, batch_id)
    payload = {
        "id": batch_id,
        "current": current_batch_id(state) == batch_id,
        "artifact": str(batch_file(repo, batch_id)),
        "state": batch,
        "task_ids": batch_task_ids(state, batch_id),
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0
    print(f"{batch_id}: {batch.get('status', '')} {batch.get('title', '')}")
    print(f"artifact: {payload['artifact']}")
    print(f"current: {'yes' if payload['current'] else 'no'}")
    print("tasks: " + (", ".join(payload["task_ids"]) or "-"))
    if batch.get("summary"):
        print(f"summary: {batch.get('summary')}")
    return 0


def create_loop_task(
    repo: Path,
    state: dict[str, Any],
    *,
    title: str,
    kind: str,
    priority: str,
    write_allow: list[str],
    write_deny: list[str],
    acceptance: list[str],
    depends_on: list[str],
    created_from: str,
    validation_minimum: str = "L1",
    branch: str | None = None,
    batch_id: str | None = None,
    allow_no_write: bool = False,
) -> str:
    if kind == "implementation" and not write_allow and not allow_no_write:
        raise HLoopError("implementation tasks require at least one write_allow")
    if kind == "fix" and not write_allow and not allow_no_write:
        raise HLoopError("fix tasks require at least one write_allow")
    task_id = next_id("T", state.setdefault("tasks", {}))
    title_slug = slugify(title)
    task_branch = branch or f"ai/{state['goal_id']}/{task_id}-{title_slug}"
    base_ref = state["integration_branch"]
    if not branch_exists(repo, base_ref):
        raise HLoopError(f"base_ref does not exist: {base_ref}")
    base_sha = git(repo, ["rev-parse", base_ref])
    resolved_batch_id = validate_batch_id(batch_id) if batch_id else current_batch_id(state)
    if resolved_batch_id:
        require_batch(state, resolved_batch_id)
    fields = {
        "id": task_id,
        "kind": kind,
        "status": "queued",
        "created_from": created_from,
        "branch": task_branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "priority": priority,
        "depends_on": depends_on,
        "write_allow": write_allow,
        "write_deny": write_deny,
        "acceptance": acceptance or ["Task acceptance criteria are satisfied."],
        "validation_minimum": validation_minimum,
        "worker_protocol": state_value(state, "worker_protocol", DEFAULT_WORKER_PROTOCOL),
        "worker_qa_profile": state_worker_qa_profile(state),
    }
    if resolved_batch_id:
        fields["batch_id"] = resolved_batch_id
    body = f"""# Task {task_id}: {title}

## Goal
{title}

## Context
Created from `{created_from}`.

Read:
- .ai/loop/MISSION.md
- .ai/loop/PLAN.md
- .ai/loop/DECISIONS.md
- .ai/loop/{created_from}.md if it exists

## Instructions
Follow this sequence:
1. Verify the referenced finding against the current code.
2. Implement the smallest safe fix.
3. Review your own diff.
4. Run targeted tests/build.
5. Write result artifact.
6. Commit your work.

Use the HLoop Worker Protocol from `.ai/loop/PROFILE.md` and your rendered worker prompt. Do not invoke an external implementation skill unless this task explicitly sets `worker_protocol: codex-impl`.

## Done when
{chr(10).join(f"- {item}" for item in fields["acceptance"])}
"""
    write_text(task_file(repo, task_id), frontmatter(fields) + "\n" + body)
    state["tasks"][task_id] = {
        "status": "queued",
        "branch": task_branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "write_allow": fields["write_allow"],
        "write_deny": fields["write_deny"],
        "depends_on": fields["depends_on"],
        "created_from": created_from,
        "worker_protocol": fields["worker_protocol"],
        "worker_qa_profile": fields["worker_qa_profile"],
        "created_at": now_iso(),
    }
    if resolved_batch_id:
        state["tasks"][task_id]["batch_id"] = resolved_batch_id
        batch = require_batch(state, resolved_batch_id)
        batch["task_ids"] = sorted(
            dict.fromkeys([*normalize_list(batch.get("task_ids")), task_id])
        )
        write_batch_artifact(repo, state, resolved_batch_id)
    return task_id


def cmd_task_new(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(
        repo,
        require_integration_branch=True,
        mark_blocked=False,
    )
    if args.kind in {"implementation", "fix"} and not args.write_allow and not args.allow_no_write:
        raise HLoopError(f"{args.kind} tasks require at least one --write-allow")
    task_id = args.id or next_id("T", state.setdefault("tasks", {}))
    if task_id in state["tasks"]:
        raise HLoopError(f"task already exists: {task_id}")
    title_slug = slugify(args.title)
    branch = args.branch or f"ai/{state['goal_id']}/{task_id}-{title_slug}"
    base_ref = args.base_ref or state["integration_branch"]
    if not branch_exists(repo, base_ref):
        raise HLoopError(
            f"base_ref does not exist: {base_ref}. Run init with --create-branch "
            "or create/switch to the integration branch before adding tasks."
        )
    base_sha = args.base_sha or git(repo, ["rev-parse", base_ref])
    resolved_batch_id = validate_batch_id(args.batch_id) if args.batch_id else current_batch_id(state)
    if resolved_batch_id:
        require_batch(state, resolved_batch_id)
    requested_worker_qa_profile = getattr(args, "worker_qa_profile", None) or getattr(
        args, "qa_profile", None
    )
    validation_minimums = args.validation_minimum or ["L1"]
    validation_minimum: str | list[str]
    if len(validation_minimums) == 1:
        validation_minimum = validation_minimums[0]
    else:
        validation_minimum = validation_minimums
    fields = {
        "id": task_id,
        "kind": args.kind,
        "status": "queued",
        "created_from": "PLAN.md",
        "branch": branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "priority": args.priority,
        "depends_on": args.depends_on or [],
        "write_allow": args.write_allow or [],
        "write_deny": args.write_deny or [],
        "acceptance": args.acceptance or ["Task acceptance criteria are satisfied."],
        "validation_minimum": validation_minimum,
        "worker_protocol": args.worker_protocol or state_value(state, "worker_protocol", DEFAULT_WORKER_PROTOCOL),
        "worker_qa_profile": args_worker_qa_profile(args)
        if requested_worker_qa_profile
        else state_worker_qa_profile(state),
    }
    if resolved_batch_id:
        fields["batch_id"] = resolved_batch_id
    body = f"""# Task {task_id}: {args.title}

## Goal
{args.title}

## Context
Read:
- .ai/loop/MISSION.md
- .ai/loop/PLAN.md

## Instructions
Follow this sequence:
1. Gap-check the task against the current code.
2. Implement the smallest safe change.
3. Review your own diff.
4. Run targeted tests/build.
5. Write result artifact.
6. Commit your work.

Use the HLoop Worker Protocol from `.ai/loop/PROFILE.md` and your rendered worker prompt. Do not invoke an external implementation skill unless this task explicitly sets `worker_protocol: codex-impl`.

## Done when
{chr(10).join(f"- {item}" for item in fields["acceptance"])}
"""
    write_text(task_file(repo, task_id), frontmatter(fields) + "\n" + body)
    state["tasks"][task_id] = {
        "status": "queued",
        "branch": branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "write_allow": fields["write_allow"],
        "write_deny": fields["write_deny"],
        "depends_on": fields["depends_on"],
        "worker_protocol": fields["worker_protocol"],
        "worker_qa_profile": fields["worker_qa_profile"],
        "created_at": now_iso(),
    }
    if resolved_batch_id:
        state["tasks"][task_id]["batch_id"] = resolved_batch_id
        batch = require_batch(state, resolved_batch_id)
        batch["task_ids"] = sorted(
            dict.fromkeys([*normalize_list(batch.get("task_ids")), task_id])
        )
        write_batch_artifact(repo, state, resolved_batch_id)
    state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Created task `{task_id}`: {args.title}")
    print(f"created {task_id}: {task_file(repo, task_id)}")
    return 0


def default_worktree(repo: Path, task_id: str) -> Path:
    return repo.parent / f"{repo.name}.{task_id.lower()}"


def default_review_worktree(repo: Path, review_id: str) -> Path:
    return repo.parent / f"{repo.name}.{review_id.lower()}-review"


def default_gap_worktree(repo: Path, gap_id: str) -> Path:
    return repo.parent / f"{repo.name}.{gap_id.lower()}-gap"


def cleanup_hloop_prompt_file(worktree: Path, agent_id: str, suffix: str) -> None:
    prompt = worktree / LOOP_DIR / "prompts" / f"{agent_id}.{suffix}.md"
    try:
        if prompt.exists() or prompt.is_symlink():
            prompt.unlink()
        prompts_dir = prompt.parent
        if prompts_dir.exists():
            try:
                prompts_dir.rmdir()
            except OSError:
                pass
    except OSError as exc:
        raise HLoopError(f"failed to remove generated prompt {prompt}: {exc}") from exc


def record_worktree_cleanup_failure(
    repo: Path,
    agent_state: dict[str, Any],
    label: str,
    exc: BaseException,
) -> None:
    detail = command_error_detail(exc)
    agent_state["worktree_cleanup_status"] = "failed"
    agent_state["worktree_cleanup_error"] = detail
    agent_state["worktree_cleanup_failed_at"] = now_iso()
    journal(repo, f"Failed to remove {label} worktree: {detail}")
    print(f"warning: failed to remove {label} worktree: {detail}", file=sys.stderr)


def ensure_task_visible_in_worktree(worktree: Path, task_id: str) -> None:
    missing = [
        loop_path(worktree) / "MISSION.md",
        loop_path(worktree) / "PLAN.md",
        loop_path(worktree) / "PROFILE.md",
        loop_path(worktree) / "DECISIONS.md",
        task_file(worktree, task_id),
    ]
    absent = [str(path) for path in missing if not path.exists()]
    if absent:
        raise HLoopError(
            "worker worktree does not contain required .ai/loop files. "
            "Commit Manager-owned .ai/loop changes on the integration branch first. "
            f"Missing: {', '.join(absent)}"
        )


def ensure_review_visible_in_worktree(worktree: Path) -> None:
    missing = [
        loop_path(worktree) / "MISSION.md",
        loop_path(worktree) / "PLAN.md",
        loop_path(worktree) / "PROFILE.md",
        loop_path(worktree) / "DECISIONS.md",
    ]
    absent = [str(path) for path in missing if not path.exists()]
    if absent:
        raise HLoopError(
            "review worktree does not contain required .ai/loop files. "
            "Commit Manager-owned .ai/loop changes on the integration branch first. "
            f"Missing: {', '.join(absent)}"
        )


def ensure_gap_visible_in_worktree(worktree: Path) -> None:
    missing = [
        loop_path(worktree) / "MISSION.md",
        loop_path(worktree) / "PLAN.md",
        loop_path(worktree) / "PROFILE.md",
        loop_path(worktree) / "DECISIONS.md",
    ]
    absent = [str(path) for path in missing if not path.exists()]
    if absent:
        raise HLoopError(
            "gap audit worktree does not contain required .ai/loop files. "
            "Commit Manager-owned .ai/loop changes on the integration branch first. "
            f"Missing: {', '.join(absent)}"
        )


def cleanup_review_worktree(
    repo: Path,
    review_id: str,
    review_state: dict[str, Any],
    *,
    dry_run: bool = False,
    best_effort: bool = False,
) -> None:
    worktree_raw = review_state.get("worktree")
    if not worktree_raw:
        return
    worktree = Path(worktree_raw).resolve()
    if not worktree.exists() or worktree == repo or review_state.get("worktree_cleaned_at"):
        return
    if dry_run:
        print(f"DRY RUN git worktree remove --force {worktree}")
        return
    try:
        cleanup_hloop_prompt_file(worktree, review_id, "reviewer")
        git(repo, ["worktree", "remove", "--force", str(worktree)])
    except (HLoopError, subprocess.CalledProcessError) as exc:
        if best_effort:
            record_worktree_cleanup_failure(repo, review_state, f"Reviewer {review_id}", exc)
            return
        raise
    review_state["worktree_cleanup_status"] = "removed"
    review_state["worktree_cleaned_at"] = now_iso()


def cleanup_gap_worktree(
    repo: Path,
    gap_id: str,
    gap_state: dict[str, Any],
    *,
    dry_run: bool = False,
    best_effort: bool = False,
) -> None:
    worktree_raw = gap_state.get("worktree")
    if not worktree_raw:
        return
    worktree = Path(worktree_raw).resolve()
    if not worktree.exists() or worktree == repo or gap_state.get("worktree_cleaned_at"):
        return
    if dry_run:
        print(f"DRY RUN git worktree remove --force {worktree}")
        return
    try:
        cleanup_hloop_prompt_file(worktree, gap_id, "gap")
        git(repo, ["worktree", "remove", "--force", str(worktree)])
    except (HLoopError, subprocess.CalledProcessError) as exc:
        if best_effort:
            record_worktree_cleanup_failure(repo, gap_state, f"Gap Auditor {gap_id}", exc)
            return
        raise
    gap_state["worktree_cleanup_status"] = "removed"
    gap_state["worktree_cleaned_at"] = now_iso()


def start_pane_launcher(
    *,
    manager_pane: str,
    direction: str,
    cwd: Path,
    command: str,
) -> str:
    split_cmd = [
        "herdr",
        "pane",
        "split",
        manager_pane,
        "--direction",
        direction,
        "--cwd",
        str(cwd),
        "--no-focus",
    ]
    pane_id = extract_pane_id(json_from_cmd(split_cmd))
    run_cmd(["herdr", "pane", "run", pane_id, command], check=True, capture=True)
    return pane_id


def start_agent_launcher(
    *,
    name: str,
    direction: str,
    cwd: Path,
    command: str,
) -> str:
    cmd = ["herdr", "agent", "start", name, "--cwd", str(cwd)]
    workspace_id = current_workspace_id()
    if workspace_id:
        cmd.extend(["--workspace", workspace_id])
    cmd.extend(["--split", direction, "--no-focus", "--", "bash", "-lc", command])
    return extract_pane_id(json_from_cmd(cmd))


def codex_command_for_prompt(
    *,
    runner: str,
    sandbox: str,
    prompt_rel: Path,
    output_rel: Path | None = None,
) -> str:
    prompt_ref = shlex.quote(str(prompt_rel))
    if runner == "exec":
        parts = ["codex", "exec", "--sandbox", sandbox]
        if output_rel is not None:
            parts.extend(["--output-last-message", str(output_rel)])
        parts.append("-")
        return f"{shlex.join(parts)} < {prompt_ref}"
    if runner == "tui":
        parts = [
            "codex",
            "--sandbox",
            sandbox,
            "--ask-for-approval",
            "never",
            "--no-alt-screen",
        ]
        return f"{shlex.join(parts)} \"$(cat {prompt_ref})\""
    raise HLoopError(f"unsupported runner: {runner}")


def cmd_worker_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    if task_state.get("status") not in {"queued", "failed_validation"}:
        raise HLoopError(f"task is not startable: {task_id} status={task_state.get('status')}")
    task_meta = read_frontmatter(task_file(repo, task_id))
    branch = task_state.get("branch") or task_meta["branch"]
    integration = state["integration_branch"]
    current_base_sha = git(repo, ["rev-parse", integration])
    task_state["base_ref"] = integration
    task_state["base_sha"] = current_base_sha
    task_meta["base_ref"] = integration
    task_meta["base_sha"] = current_base_sha
    worktree = Path(args.worktree).resolve() if args.worktree else default_worktree(repo, task_id)
    prompt = render_worker_prompt(task_id, task_meta, worktree, branch, state)
    prompt_rel = LOOP_DIR / "prompts" / f"{task_id}.worker.md"
    runner = args.runner or state.get("worker_runner", "tui")
    command = (
        f"cd {shlex.quote(str(worktree))} && "
        f"{codex_command_for_prompt(runner=runner, sandbox='workspace-write', prompt_rel=prompt_rel)}"
    )
    if args.dry_run:
        print(f"DRY RUN worktree: git worktree add {worktree} -b {branch} {integration}")
        print(f"DRY RUN prompt: {worktree / prompt_rel}")
        print(f"DRY RUN {args.launcher}/{runner} command: {command}")
        return 0
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_codex=True,
        require_integration_branch=True,
    )
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    if task_state.get("status") not in {"queued", "failed_validation"}:
        raise HLoopError(f"task is not startable: {task_id} status={task_state.get('status')}")
    task_meta = read_frontmatter(task_file(repo, task_id))
    branch = task_state.get("branch") or task_meta["branch"]
    integration = state["integration_branch"]
    current_base_sha = git(repo, ["rev-parse", integration])
    task_state["base_ref"] = integration
    task_state["base_sha"] = current_base_sha
    task_meta["base_ref"] = integration
    task_meta["base_sha"] = current_base_sha
    worktree = Path(args.worktree).resolve() if args.worktree else default_worktree(repo, task_id)
    prompt = render_worker_prompt(task_id, task_meta, worktree, branch, state)
    runner = args.runner or state.get("worker_runner", "tui")
    command = (
        f"cd {shlex.quote(str(worktree))} && "
        f"{codex_command_for_prompt(runner=runner, sandbox='workspace-write', prompt_rel=prompt_rel)}"
    )
    if not branch_exists(repo, integration):
        raise HLoopError(
            f"integration branch does not exist: {integration}. "
            "Run `hloop init --create-branch` or create it before starting Workers."
        )
    if not worktree.exists():
        if branch_exists(repo, branch):
            git(repo, ["worktree", "add", str(worktree), branch])
        else:
            git(repo, ["worktree", "add", str(worktree), "-b", branch, integration])
    ensure_task_visible_in_worktree(worktree, task_id)
    write_text(worktree / prompt_rel, prompt)
    if args.launcher == "agent":
        pane_id = start_agent_launcher(
            name=f"hloop-{state['goal_id']}-{task_id}-worker",
            direction=args.direction,
            cwd=worktree,
            command=command,
        )
    else:
        manager_pane = args.manager_pane or current_pane_id()
        pane_id = start_pane_launcher(
            manager_pane=manager_pane,
            direction=args.direction,
            cwd=worktree,
            command=command,
        )
    task_state.update(
        {
            "status": "running",
            "pane_id": pane_id,
            "worktree": str(worktree),
            "prompt": str(worktree / prompt_rel),
            "runner": runner,
            "sandbox": "workspace-write",
            "started_at": now_iso(),
        }
    )
    state["phase"] = "running"
    save_state(repo, state)
    journal(repo, f"Started Worker `{task_id}` in pane `{pane_id}` and worktree `{worktree}`.")
    print(f"started {task_id} in pane {pane_id}")
    return 0


def cmd_worker_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    worktree = Path(task_state.get("worktree") or default_worktree(repo, task_id)).resolve()
    result = result_file(worktree, task_id)
    if not result.exists():
        raise HLoopError(f"result not found: {result}")
    meta = read_frontmatter(result)
    status = str(meta.get("status", ""))
    if status not in TASK_STATUSES_FINAL:
        raise HLoopError(f"invalid result status in {result}: {status}")
    reported_task_id = str(meta.get("task_id") or "")
    if reported_task_id and reported_task_id != task_id:
        raise HLoopError(f"result task_id mismatch: expected {task_id}, got {reported_task_id}")
    raw_head_sha = str(meta.get("head_sha") or "")
    head_sha = git(worktree, ["rev-parse", "HEAD"]) if raw_head_sha in {"", "HEAD"} else raw_head_sha
    manager_base_sha = str(task_state.get("base_sha") or "")
    reported_base_sha = str(meta.get("base_sha") or "")
    base_sha = manager_base_sha
    if not base_sha:
        raise HLoopError(f"manager base_sha is missing for {task_id}")
    committed_result = require_committed_result(worktree, task_id, head_sha)
    files = normalize_list(meta.get("changed_files")) or changed_files(worktree, base_sha, head_sha)
    validation_recorded = result_validation_recorded(meta)
    if normalize_bool(meta.get("merge_ready")) and not validation_recorded:
        raise HLoopError(f"merge_ready result does not record validation: {result}")
    task_state.update(
        {
            "status": "result_reported" if status == "done" else status,
            "result_status": status,
            "merge_ready": normalize_bool(meta.get("merge_ready")),
            "head_sha": head_sha,
            "base_sha": base_sha,
            "reported_base_sha": reported_base_sha,
            "changed_files": files,
            "blocking_questions": normalize_list(meta.get("blocking_questions")),
            "validation_recorded": validation_recorded,
            "validation_commands": normalize_list(meta.get("validation_commands")),
            "validation_results": normalize_list(meta.get("validation_results")),
            "validation_summary": str(meta.get("validation_summary") or ""),
            "result_path": str(result),
            "committed_result_path": committed_result,
            "harvested_at": now_iso(),
        }
    )
    cleanup_completed_agent_pane(
        repo,
        task_state,
        label=f"Worker {task_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    state["phase"] = "harvesting"
    save_state(repo, state)
    journal(repo, f"Harvested Worker `{task_id}` with status `{status}`.")
    print(f"harvested {task_id}: {status}")
    return 0


def cmd_worker_message(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    if task_state.get("status") != "running":
        raise HLoopError(f"worker is not running: {task_id} status={task_state.get('status')}")
    pane_id = str(task_state.get("pane_id") or "")
    if not pane_id:
        raise HLoopError(f"worker has no pane_id: {task_id}")
    message, source = manager_message_from_args(args)
    if not message.strip():
        raise HLoopError("manager message is empty")
    try:
        send_codex_tui_message(
            pane_id,
            message,
            args.timeout_ms,
            args.input_settle_ms,
            args.submit_verify_ms,
            args.submit_attempts,
        )
    except HLoopError as exc:
        return record_pending_manager_message(
            repo,
            state,
            task_state,
            role="Worker",
            agent_id=task_id,
            pane_id=pane_id,
            source=source,
            message=message,
            error=exc,
        )
    record_manager_message(task_state, source, message)
    save_state(repo, state)
    journal(repo, f"Sent Manager message to Worker `{task_id}` in pane `{pane_id}` from {source}.")
    print(f"sent manager message to {task_id} in pane {pane_id}")
    return 0


def cmd_worker_watch(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    pane_id = str(task_state.get("pane_id") or "")
    if not pane_id:
        raise HLoopError(f"worker has no pane_id: {task_id}")
    proc = run_cmd(
        [
            "herdr",
            "pane",
            "read",
            pane_id,
            "--source",
            args.source,
            "--lines",
            str(args.lines),
        ],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    print(proc.stdout.rstrip())
    return 0


def cmd_merge(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True)
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    if task_state.get("result_status") != "done" or task_state.get("merge_ready") is not True:
        raise HLoopError(f"task is not merge ready: {task_id}")
    if normalize_list(task_state.get("blocking_questions")):
        raise HLoopError(f"task has blocking questions: {task_id}")
    if not task_state.get("validation_recorded"):
        raise HLoopError(f"task result does not record validation: {task_id}")
    branch = task_state["branch"]
    mode = args.mode or state.get("merge_mode", "squash")
    if mode not in {"squash", "cherry-pick"}:
        raise HLoopError(f"unsupported merge mode: {mode}")
    actual_head = git(repo, ["rev-parse", branch])
    reported_head = str(task_state.get("head_sha") or "")
    if reported_head and reported_head != actual_head:
        if not args.dry_run:
            task_state["status"] = "blocked_head_mismatch"
            state["phase"] = "blocked_conflict"
            save_state(repo, state)
        raise HLoopError(
            f"worker head mismatch for {task_id}: result={reported_head} actual={actual_head}"
        )
    rel_result = (LOOP_DIR / "results" / task_id / "result.md").as_posix()
    git_show(repo, f"{actual_head}:{rel_result}")
    base_sha = str(task_state.get("base_sha") or "")
    if not base_sha:
        raise HLoopError(f"manager base_sha is missing for {task_id}")
    reported_base_sha = str(task_state.get("reported_base_sha") or "")
    if reported_base_sha and reported_base_sha != base_sha:
        if is_ancestor(repo, reported_base_sha, base_sha):
            task_state["reported_base_sha_was_ancestor"] = True
            task_state["reported_base_sha_note"] = (
                "Worker reported an older base that is an ancestor of the Manager base."
            )
        else:
            if not args.dry_run:
                task_state["status"] = "blocked_base_mismatch"
                state["phase"] = "blocked_conflict"
                save_state(repo, state)
            raise HLoopError(
                f"worker base mismatch for {task_id}: result={reported_base_sha} manager={base_sha}"
            )
    files = changed_files(repo, base_sha, actual_head)
    task_state["head_sha"] = actual_head
    task_state["changed_files"] = files
    files = normalize_list(task_state.get("changed_files"))
    violations = validate_change_scope(task_id, task_state, files)
    if violations:
        if not args.dry_run:
            task_state["status"] = "blocked_write_scope"
            state["phase"] = "blocked_conflict"
            save_state(repo, state)
        raise HLoopError("write-scope violations: " + "; ".join(violations))
    if args.dry_run:
        if mode == "squash":
            print(f"DRY RUN git merge --squash {branch}")
            print(f"DRY RUN git commit -m 'ai-loop({task_id}): squash {branch}'")
        else:
            commits = git(repo, ["rev-list", "--reverse", f"{base_sha}..{actual_head}"])
            print(f"DRY RUN git cherry-pick {' '.join(commits.splitlines())}")
        return 0
    try:
        staged = run_cmd(["git", "-C", str(repo), "diff", "--cached", "--quiet"], check=False)
        if staged.returncode != 0:
            raise HLoopError("index has staged changes; commit or unstage them before integration")
        if mode == "squash":
            git(repo, ["merge", "--squash", branch])
            git(repo, ["commit", "-m", f"ai-loop({task_id}): squash {branch}"])
        else:
            commits = git(repo, ["rev-list", "--reverse", f"{base_sha}..{actual_head}"]).splitlines()
            if not commits:
                raise HLoopError(f"no commits to cherry-pick for {task_id}")
            git(repo, ["cherry-pick", *commits])
    except subprocess.CalledProcessError as exc:
        detail = command_error_detail(exc)
        if is_environment_git_error(detail):
            task_state["status"] = "blocked_environment"
            task_state["merge_error"] = detail
            state["phase"] = "blocked_environment"
            state["last_merge_error"] = {"task_id": task_id, "at": now_iso(), "reason": detail}
            save_state(repo, state)
            journal(repo, f"Merge for `{task_id}` was blocked by git/environment state: {detail}")
            append_text(
                loop_path(repo) / "USER_ACTION_REQUIRED.md",
                f"\n## Merge environment blocker for {task_id}\n\n"
                f"Git could not update the integration worktree for `{branch}`:\n\n"
                f"```text\n{detail}\n```\n",
            )
            raise HLoopError(f"merge blocked by git/environment state for {task_id}: {detail}") from exc
        task_state["status"] = "blocked_merge_conflict"
        state["phase"] = "blocked_conflict"
        save_state(repo, state)
        journal(repo, f"Merge failed for `{task_id}` from `{branch}`. Resolve or abort manually.")
        append_text(
            loop_path(repo) / "USER_ACTION_REQUIRED.md",
            f"\n## Merge conflict for {task_id}\n\nResolve or abort the merge for `{branch}`.\n",
        )
        raise exc
    task_state["status"] = "merged"
    task_state["merged_at"] = now_iso()
    task_state["merge_mode"] = mode
    task_state["cleanup_pending"] = True
    state["needs_validation"] = True
    state["last_merged_task"] = task_id
    state["unreviewed_merge_count"] = normalize_int(state.get("unreviewed_merge_count"), 0) + 1
    state["ungapped_merge_count"] = normalize_int(state.get("ungapped_merge_count"), 0) + 1
    if manager_qa_required(state):
        state["manager_qa_status"] = "pending"
    state["phase"] = "validating"
    save_state(repo, state)
    journal(repo, f"Merged Worker `{task_id}` from `{branch}`.")
    print(f"merged {task_id}")
    return 0


def cleanup_task(
    repo: Path,
    task_id: str,
    task_state: dict[str, Any],
    dry_run: bool = False,
    best_effort: bool = False,
) -> None:
    branch = task_state.get("branch")
    worktree_raw = task_state.get("worktree")
    worktree = Path(worktree_raw).resolve() if worktree_raw else default_worktree(repo, task_id)
    try:
        if worktree.exists() and worktree != repo:
            if dry_run:
                print(f"DRY RUN git worktree remove {worktree}")
            else:
                cleanup_hloop_prompt_file(worktree, task_id, "worker")
                git(repo, ["worktree", "remove", str(worktree)])
        if branch and branch_exists(repo, branch):
            if dry_run:
                print(f"DRY RUN git branch -D {branch}")
            else:
                git(repo, ["branch", "-D", branch])
    except (HLoopError, subprocess.CalledProcessError) as exc:
        if best_effort:
            record_worktree_cleanup_failure(repo, task_state, f"Worker {task_id}", exc)
            return
        raise
    if not dry_run:
        task_state["cleanup_pending"] = False
        task_state["cleanup_done"] = True
        task_state["cleaned_at"] = now_iso()


def cleanup_merged_tasks(repo: Path, state: dict[str, Any], dry_run: bool = False) -> None:
    for task_id, task in state.get("tasks", {}).items():
        if task.get("status") == "merged" and task.get("cleanup_pending"):
            cleanup_completed_agent_pane(
                repo,
                task,
                label=f"Worker {task_id}",
                session_cleanup=str(state.get("session_cleanup", "archive")),
                dry_run=dry_run,
            )
            cleanup_task(repo, task_id, task, dry_run=dry_run, best_effort=True)


def validation_log_rel(state: dict[str, Any], index: int) -> Path:
    cycle = int(state.get("cycle", 0))
    return LOOP_DIR / "validation" / f"cycle-{cycle:04d}-{index:02d}.log"


def normalize_validation_log_output(output: str) -> str:
    if not output:
        return ""
    pieces: list[str] = []
    for line in output.splitlines(keepends=True):
        newline = ""
        body = line
        if line.endswith("\r\n"):
            body = line[:-2]
            newline = "\n"
        elif line.endswith("\n") or line.endswith("\r"):
            body = line[:-1]
            newline = "\n"
        pieces.append(body.rstrip() + newline)
    return "".join(pieces)


def cmd_validate(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_integration_branch=True,
        mark_blocked=not args.dry_run,
    )
    commands = getattr(args, "validation_command", None) or state.get("validation_commands") or [
        "git diff --check"
    ]
    results = []
    failed = False
    for index, command in enumerate(commands, start=1):
        if args.dry_run:
            print(f"DRY RUN {command}")
            results.append({"command": command, "result": "dry-run"})
            continue
        proc = subprocess.run(
            command,
            cwd=str(repo),
            text=True,
            shell=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        output = proc.stdout or ""
        if output:
            sys.stdout.write(output)
            if not output.endswith("\n"):
                sys.stdout.write("\n")
        log_rel = validation_log_rel(state, index)
        write_text(repo / log_rel, normalize_validation_log_output(output))
        result = "passed" if proc.returncode == 0 else f"failed:{proc.returncode}"
        results.append(
            {
                "command": command,
                "result": result,
                "returncode": proc.returncode,
                "log": log_rel.as_posix(),
            }
        )
        if proc.returncode != 0:
            failed = True
            break
    if not args.dry_run:
        state["last_validation"] = {"at": now_iso(), "results": results}
        state["needs_validation"] = failed
        if failed:
            state["phase"] = "failed_validation"
        else:
            if not getattr(args, "no_cleanup", False):
                cleanup_merged_tasks(repo, state)
            if should_open_gap_gate(state):
                state["needs_gap_check"] = True
            if should_open_review_gate(state):
                state["needs_review"] = True
            if state.get("needs_gap_check"):
                state["phase"] = "gap_checking"
            elif state.get("needs_review"):
                state["phase"] = "reviewing"
            else:
                state["phase"] = "dispatching"
        save_state(repo, state)
        journal(repo, f"Validation results: {results}")
    return 1 if failed else 0


def cmd_reviewer_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    review_id = args.review_id or next_id("R", state.setdefault("reviews", {}))
    if review_id in state["reviews"]:
        raise HLoopError(f"review already exists: {review_id}")
    base = args.base or state["base_branch"]
    head = args.head or state["integration_branch"]
    base_sha = git(repo, ["rev-parse", base])
    head_sha = git(repo, ["rev-parse", head])
    worktree_arg = getattr(args, "worktree", None)
    worktree = Path(worktree_arg).resolve() if worktree_arg else default_review_worktree(repo, review_id)
    prompt = render_reviewer_prompt(review_id, base, head, state)
    prompt_rel = LOOP_DIR / "prompts" / f"{review_id}.reviewer.md"
    review_rel = LOOP_DIR / "reviews" / f"{review_id}.md"
    prompt_path = worktree / prompt_rel
    worktree_review_path = worktree / review_rel
    review_path = review_file(repo, review_id)
    runner = args.runner or state.get("reviewer_runner", "tui")
    command = (
        f"cd {shlex.quote(str(worktree))} && "
        f"{codex_command_for_prompt(runner=runner, sandbox='workspace-write', prompt_rel=prompt_rel, output_rel=review_rel if runner == 'exec' else None)}"
    )
    if args.dry_run:
        print(f"DRY RUN worktree: git worktree add --detach {worktree} {head_sha}")
        print(f"DRY RUN prompt: {prompt_path}")
        print(f"DRY RUN {args.launcher}/{runner} command: {command}")
        return 0
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_codex=True,
        require_integration_branch=True,
    )
    if review_id in state["reviews"]:
        raise HLoopError(f"review already exists: {review_id}")
    base = args.base or state["base_branch"]
    head = args.head or state["integration_branch"]
    base_sha = git(repo, ["rev-parse", base])
    head_sha = git(repo, ["rev-parse", head])
    worktree_arg = getattr(args, "worktree", None)
    worktree = Path(worktree_arg).resolve() if worktree_arg else default_review_worktree(repo, review_id)
    prompt = render_reviewer_prompt(review_id, base, head, state)
    prompt_path = worktree / prompt_rel
    worktree_review_path = worktree / review_rel
    review_path = review_file(repo, review_id)
    runner = args.runner or state.get("reviewer_runner", "tui")
    command = (
        f"cd {shlex.quote(str(worktree))} && "
        f"{codex_command_for_prompt(runner=runner, sandbox='workspace-write', prompt_rel=prompt_rel, output_rel=review_rel if runner == 'exec' else None)}"
    )
    if not worktree.exists():
        git(repo, ["worktree", "add", "--detach", str(worktree), head_sha])
    ensure_review_visible_in_worktree(worktree)
    write_text(prompt_path, prompt)
    baseline_dirty = porcelain_paths(worktree)
    if args.launcher == "agent":
        pane_id = start_agent_launcher(
            name=f"hloop-{state['goal_id']}-{review_id}-reviewer",
            direction=args.direction,
            cwd=worktree,
            command=command,
        )
    else:
        manager_pane = args.manager_pane or current_pane_id()
        pane_id = start_pane_launcher(
            manager_pane=manager_pane,
            direction=args.direction,
            cwd=worktree,
            command=command,
        )
    state["reviews"][review_id] = {
        "status": "running",
        "gate_status": "running",
        "base": base,
        "head": head,
        "base_sha": base_sha,
        "head_sha": head_sha,
        "pane_id": pane_id,
        "runner": runner,
        "sandbox": "workspace-write",
        "worktree": str(worktree),
        "prompt": str(prompt_path),
        "review_path": str(review_path),
        "worktree_review_path": str(worktree_review_path),
        "baseline_dirty_files": baseline_dirty,
        "started_at": now_iso(),
    }
    state["phase"] = "reviewing"
    save_state(repo, state)
    journal(repo, f"Started Reviewer `{review_id}` in pane `{pane_id}` and worktree `{worktree}`.")
    print(f"started {review_id} in pane {pane_id}; watch with `hloop reviewer watch {review_id}`")
    return 0


def cmd_reviewer_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    review_id = args.review_id
    review_state = state.get("reviews", {}).get(review_id)
    if not review_state:
        raise HLoopError(f"unknown review: {review_id}")
    path = review_artifact_path(repo, review_id, review_state)
    if not path.exists() or not read_text(path).strip():
        raise HLoopError(f"review artifact not found or empty: {path}")
    meta = read_frontmatter(path)
    artifact_status = str(meta.get("status", ""))
    if artifact_status not in REVIEW_ARTIFACT_STATUSES:
        raise HLoopError(f"invalid review artifact status in {path}: {artifact_status}")
    reported_review_id = str(meta.get("review_id") or "")
    if reported_review_id and reported_review_id != review_id:
        raise HLoopError(f"review_id mismatch: expected {review_id}, got {reported_review_id}")
    final_path = review_file(repo, review_id)
    if path.resolve() != final_path.resolve():
        write_text(final_path, read_text(path))
        review_state["worktree_review_path_harvested"] = str(path)
        review_state.pop("worktree_review_path", None)
    worktree_raw = review_state.get("worktree")
    violations: list[str] = []
    if worktree_raw:
        worktree = Path(worktree_raw).resolve()
        if worktree.exists():
            violations = validate_reviewer_worktree_scope(review_id, review_state, worktree)
    review_state["write_scope_violations"] = violations
    review_state["review_path"] = str(final_path)
    review_state["status"] = "reported"
    review_state["gate_status"] = "reported"
    review_state["artifact_status"] = artifact_status
    review_state["harvested_at"] = now_iso()
    cleanup_completed_agent_pane(
        repo,
        review_state,
        label=f"Reviewer {review_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    state["last_review_id"] = review_id
    state["needs_review"] = True
    if violations:
        review_state["status"] = "blocked_write_scope"
        review_state["gate_status"] = "blocked_write_scope"
        state["phase"] = "blocked_conflict"
        save_state(repo, state)
        journal(
            repo,
            f"Harvested Reviewer `{review_id}` but blocked because it changed files outside the review artifact: {violations}",
        )
        append_text(
            loop_path(repo) / "USER_ACTION_REQUIRED.md",
            f"\n## Reviewer write-scope violation for {review_id}\n\n"
            f"Review artifact was copied to `{final_path}` but the review worktree has unexpected changes:\n"
            + "\n".join(f"- {item}" for item in violations)
            + "\n",
        )
        print(f"blocked {review_id}: reviewer changed files outside the review artifact")
        return 2
    cleanup_review_worktree(repo, review_id, review_state, best_effort=True)
    state["phase"] = "reviewing"
    save_state(repo, state)
    journal(repo, f"Harvested Reviewer `{review_id}`; Manager triage is required.")
    print(f"harvested {review_id}; run `hloop reviewer close {review_id} --verdict <verdict>` after triage")
    return 0


def cmd_reviewer_close(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    review_id = args.review_id
    review_state = state.get("reviews", {}).get(review_id)
    if not review_state:
        raise HLoopError(f"unknown review: {review_id}")
    if agent_gate_status(review_state) not in {"reported", "triaged"}:
        raise HLoopError(f"review is not ready for close: {review_id}")
    cleanup_completed_agent_pane(
        repo,
        review_state,
        label=f"Reviewer {review_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    cleanup_review_worktree(repo, review_id, review_state, best_effort=True)
    review_state["status"] = "triaged"
    review_state["gate_status"] = "triaged"
    review_state["verdict"] = args.verdict
    review_state["triage_reason"] = args.reason
    review_state["triaged_at"] = now_iso()
    if args.verdict == "blocked":
        state["needs_review"] = True
        state["phase"] = "blocked_user_decision"
    else:
        state["needs_review"] = False
        state["unreviewed_merge_count"] = 0
        if args.verdict == "fix-tasks-created":
            state["phase"] = "dispatching"
        elif state.get("needs_gap_check"):
            state["phase"] = "gap_checking"
        else:
            state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Closed Reviewer `{review_id}` with verdict `{args.verdict}`: {args.reason}")
    print(f"closed {review_id}: {args.verdict}")
    return 0


def cmd_reviewer_watch(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    review_id = args.review_id
    review_state = state.get("reviews", {}).get(review_id)
    if not review_state:
        raise HLoopError(f"unknown review: {review_id}")
    pane_id = str(review_state.get("pane_id") or "")
    print(f"review: {review_id}")
    print(f"status: {review_state.get('status')}")
    print(f"gate_status: {agent_gate_status(review_state)}")
    print(f"artifact_status: {review_state.get('artifact_status', '')}")
    print(f"runner: {review_state.get('runner')}")
    print(f"worktree: {review_state.get('worktree', '')}")
    print(f"artifact: {review_artifact_path(repo, review_id, review_state)}")
    if not pane_id:
        print("pane: none")
        return 0
    print(f"pane: {pane_id}")
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        print("pane output unavailable: not inside Herdr")
        return 0
    info = pane_info(pane_id)
    if info is None:
        print("pane output unavailable: pane is closed or missing")
        return 0
    print(f"agent_status: {info.get('agent_status', 'unknown')}")
    proc = run_cmd(
        [
            "herdr",
            "pane",
            "read",
            pane_id,
            "--source",
            args.source,
            "--lines",
            str(args.lines),
        ],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    print(proc.stdout.rstrip())
    return 0


def cmd_reviewer_message(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    review_id = args.review_id
    review_state = state.get("reviews", {}).get(review_id)
    if not review_state:
        raise HLoopError(f"unknown review: {review_id}")
    if agent_gate_status(review_state) != "running":
        raise HLoopError(f"reviewer is not running: {review_id} status={review_state.get('status')}")
    pane_id = str(review_state.get("pane_id") or "")
    if not pane_id:
        raise HLoopError(f"reviewer has no pane_id: {review_id}")
    message, source = manager_message_from_args(args)
    if not message.strip():
        raise HLoopError("manager message is empty")
    try:
        send_codex_tui_message(
            pane_id,
            message,
            args.timeout_ms,
            args.input_settle_ms,
            args.submit_verify_ms,
            args.submit_attempts,
        )
    except HLoopError as exc:
        return record_pending_manager_message(
            repo,
            state,
            review_state,
            role="Reviewer",
            agent_id=review_id,
            pane_id=pane_id,
            source=source,
            message=message,
            error=exc,
        )
    record_manager_message(review_state, source, message)
    save_state(repo, state)
    journal(repo, f"Sent Manager message to Reviewer `{review_id}` in pane `{pane_id}` from {source}.")
    print(f"sent manager message to {review_id} in pane {pane_id}")
    return 0


def cmd_gap_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    gap_id = args.gap_id or next_id("G", state.setdefault("gaps", {}))
    if gap_id in state["gaps"]:
        raise HLoopError(f"gap audit already exists: {gap_id}")
    base = args.base or state["base_branch"]
    head = args.head or state["integration_branch"]
    base_sha = git(repo, ["rev-parse", base])
    head_sha = git(repo, ["rev-parse", head])
    worktree_arg = getattr(args, "worktree", None)
    worktree = Path(worktree_arg).resolve() if worktree_arg else default_gap_worktree(repo, gap_id)
    spec_sources = normalize_list(getattr(args, "spec_source", None)) or normalize_list(
        state.get("spec_sources")
    )
    prompt = render_gap_prompt(gap_id, base, head, spec_sources)
    prompt_rel = LOOP_DIR / "prompts" / f"{gap_id}.gap.md"
    gap_rel = LOOP_DIR / "gaps" / f"{gap_id}.md"
    prompt_path = worktree / prompt_rel
    worktree_gap_path = worktree / gap_rel
    final_gap_path = gap_file(repo, gap_id)
    runner = args.runner or state.get("gap_runner", "tui")
    command = (
        f"cd {shlex.quote(str(worktree))} && "
        f"{codex_command_for_prompt(runner=runner, sandbox='workspace-write', prompt_rel=prompt_rel, output_rel=gap_rel if runner == 'exec' else None)}"
    )
    if args.dry_run:
        print(f"DRY RUN worktree: git worktree add --detach {worktree} {head_sha}")
        print(f"DRY RUN prompt: {prompt_path}")
        print(f"DRY RUN {args.launcher}/{runner} command: {command}")
        return 0
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_codex=True,
        require_integration_branch=True,
    )
    if gap_id in state.setdefault("gaps", {}):
        raise HLoopError(f"gap audit already exists: {gap_id}")
    base = args.base or state["base_branch"]
    head = args.head or state["integration_branch"]
    base_sha = git(repo, ["rev-parse", base])
    head_sha = git(repo, ["rev-parse", head])
    worktree_arg = getattr(args, "worktree", None)
    worktree = Path(worktree_arg).resolve() if worktree_arg else default_gap_worktree(repo, gap_id)
    spec_sources = normalize_list(getattr(args, "spec_source", None)) or normalize_list(
        state.get("spec_sources")
    )
    prompt = render_gap_prompt(gap_id, base, head, spec_sources)
    prompt_path = worktree / prompt_rel
    worktree_gap_path = worktree / gap_rel
    final_gap_path = gap_file(repo, gap_id)
    runner = args.runner or state.get("gap_runner", "tui")
    command = (
        f"cd {shlex.quote(str(worktree))} && "
        f"{codex_command_for_prompt(runner=runner, sandbox='workspace-write', prompt_rel=prompt_rel, output_rel=gap_rel if runner == 'exec' else None)}"
    )
    if not worktree.exists():
        git(repo, ["worktree", "add", "--detach", str(worktree), head_sha])
    ensure_gap_visible_in_worktree(worktree)
    write_text(prompt_path, prompt)
    baseline_dirty = porcelain_paths(worktree)
    if args.launcher == "agent":
        pane_id = start_agent_launcher(
            name=f"hloop-{state['goal_id']}-{gap_id}-gap",
            direction=args.direction,
            cwd=worktree,
            command=command,
        )
    else:
        manager_pane = args.manager_pane or current_pane_id()
        pane_id = start_pane_launcher(
            manager_pane=manager_pane,
            direction=args.direction,
            cwd=worktree,
            command=command,
        )
    state["gaps"][gap_id] = {
        "status": "running",
        "gate_status": "running",
        "base": base,
        "head": head,
        "base_sha": base_sha,
        "head_sha": head_sha,
        "spec_sources": spec_sources,
        "pane_id": pane_id,
        "runner": runner,
        "sandbox": "workspace-write",
        "worktree": str(worktree),
        "prompt": str(prompt_path),
        "gap_path": str(final_gap_path),
        "worktree_gap_path": str(worktree_gap_path),
        "baseline_dirty_files": baseline_dirty,
        "started_at": now_iso(),
    }
    state["phase"] = "gap_checking"
    save_state(repo, state)
    journal(repo, f"Started Gap Auditor `{gap_id}` in pane `{pane_id}` and worktree `{worktree}`.")
    print(f"started {gap_id} in pane {pane_id}; watch with `hloop gap watch {gap_id}`")
    return 0


def cmd_gap_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    gap_id = args.gap_id
    gap_state = state.get("gaps", {}).get(gap_id)
    if not gap_state:
        raise HLoopError(f"unknown gap audit: {gap_id}")
    path = gap_artifact_path(repo, gap_id, gap_state)
    if not path.exists() or not read_text(path).strip():
        raise HLoopError(f"gap artifact not found or empty: {path}")
    meta = read_frontmatter(path)
    artifact_status = str(meta.get("status", ""))
    if artifact_status not in GAP_ARTIFACT_STATUSES:
        raise HLoopError(f"invalid gap artifact status in {path}: {artifact_status}")
    reported_gap_id = str(meta.get("gap_id") or "")
    if reported_gap_id and reported_gap_id != gap_id:
        raise HLoopError(f"gap_id mismatch: expected {gap_id}, got {reported_gap_id}")
    final_path = gap_file(repo, gap_id)
    if path.resolve() != final_path.resolve():
        write_text(final_path, read_text(path))
        gap_state["worktree_gap_path_harvested"] = str(path)
        gap_state.pop("worktree_gap_path", None)
    worktree_raw = gap_state.get("worktree")
    violations: list[str] = []
    if worktree_raw:
        worktree = Path(worktree_raw).resolve()
        if worktree.exists():
            violations = validate_gap_worktree_scope(gap_id, gap_state, worktree)
    gap_state["write_scope_violations"] = violations
    gap_state["gap_path"] = str(final_path)
    gap_state["status"] = "reported"
    gap_state["gate_status"] = "reported"
    gap_state["artifact_status"] = artifact_status
    gap_state["gap_count"] = meta.get("gap_count", "")
    gap_state["harvested_at"] = now_iso()
    cleanup_completed_agent_pane(
        repo,
        gap_state,
        label=f"Gap Auditor {gap_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    state["last_gap_id"] = gap_id
    state["needs_gap_check"] = True
    if violations:
        gap_state["status"] = "blocked_write_scope"
        gap_state["gate_status"] = "blocked_write_scope"
        state["phase"] = "blocked_conflict"
        save_state(repo, state)
        journal(
            repo,
            f"Harvested Gap Auditor `{gap_id}` but blocked because it changed files outside the gap artifact: {violations}",
        )
        append_text(
            loop_path(repo) / "USER_ACTION_REQUIRED.md",
            f"\n## Gap Auditor write-scope violation for {gap_id}\n\n"
            f"Gap artifact was copied to `{final_path}` but the gap worktree has unexpected changes:\n"
            + "\n".join(f"- {item}" for item in violations)
            + "\n",
        )
        print(f"blocked {gap_id}: gap auditor changed files outside the gap artifact")
        return 2
    cleanup_gap_worktree(repo, gap_id, gap_state, best_effort=True)
    state["phase"] = "gap_checking"
    save_state(repo, state)
    journal(repo, f"Harvested Gap Auditor `{gap_id}`; Manager triage is required.")
    print(f"harvested {gap_id}; run `hloop gap close {gap_id} --verdict <verdict>` after triage")
    return 0


def cmd_gap_close(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    gap_id = args.gap_id
    gap_state = state.get("gaps", {}).get(gap_id)
    if not gap_state:
        raise HLoopError(f"unknown gap audit: {gap_id}")
    if agent_gate_status(gap_state) not in {"reported", "triaged"}:
        raise HLoopError(f"gap audit is not ready for close: {gap_id}")
    cleanup_completed_agent_pane(
        repo,
        gap_state,
        label=f"Gap Auditor {gap_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    cleanup_gap_worktree(repo, gap_id, gap_state, best_effort=True)
    gap_state["status"] = "triaged"
    gap_state["gate_status"] = "triaged"
    gap_state["verdict"] = args.verdict
    gap_state["triage_reason"] = args.reason
    gap_state["triaged_at"] = now_iso()
    if args.verdict in {"blocked", "decision-needed"}:
        state["needs_gap_check"] = True
        state["phase"] = "blocked_user_decision"
    else:
        state["needs_gap_check"] = False
        state["ungapped_merge_count"] = 0
        if args.verdict == "fix-tasks-created":
            state["needs_review"] = False
            state["phase"] = "dispatching"
        elif last_validation_passed(state) and should_open_review_gate(state):
            state["needs_review"] = True
            state["phase"] = "reviewing"
        else:
            state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Closed Gap Auditor `{gap_id}` with verdict `{args.verdict}`: {args.reason}")
    print(f"closed {gap_id}: {args.verdict}")
    return 0


def cmd_gap_watch(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    gap_id = args.gap_id
    gap_state = state.get("gaps", {}).get(gap_id)
    if not gap_state:
        raise HLoopError(f"unknown gap audit: {gap_id}")
    pane_id = str(gap_state.get("pane_id") or "")
    print(f"gap: {gap_id}")
    print(f"status: {gap_state.get('status')}")
    print(f"gate_status: {agent_gate_status(gap_state)}")
    print(f"artifact_status: {gap_state.get('artifact_status', '')}")
    print(f"runner: {gap_state.get('runner')}")
    print(f"worktree: {gap_state.get('worktree', '')}")
    print(f"artifact: {gap_artifact_path(repo, gap_id, gap_state)}")
    if not pane_id:
        print("pane: none")
        return 0
    print(f"pane: {pane_id}")
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        print("pane output unavailable: not inside Herdr")
        return 0
    info = pane_info(pane_id)
    if info is None:
        print("pane output unavailable: pane is closed or missing")
        return 0
    print(f"agent_status: {info.get('agent_status', 'unknown')}")
    proc = run_cmd(
        [
            "herdr",
            "pane",
            "read",
            pane_id,
            "--source",
            args.source,
            "--lines",
            str(args.lines),
        ],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    print(proc.stdout.rstrip())
    return 0


