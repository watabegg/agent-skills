    init.add_argument("--review-wait-ms", type=int, default=DEFAULT_REVIEW_WAIT_MS)
    init.add_argument("--gap-wait-ms", type=int, default=DEFAULT_GAP_WAIT_MS)
    init.add_argument("--review-after-merges", type=int, default=DEFAULT_REVIEW_AFTER_MERGES)
    init.add_argument("--gap-after-merges", type=int, default=DEFAULT_GAP_AFTER_MERGES)
    init.add_argument("--validation", action="append")
    init.add_argument("--spec-source", action="append")
    init.add_argument(
        "--create-branch",
        action="store_true",
        help="create or switch to the integration branch before writing .ai/loop files",
    )
    init.add_argument("--force", action="store_true")
    init.set_defaults(func=cmd_init)

    status = sub.add_parser("status", help="show loop status")
