CHECKPOINT_TRAILER_KIND = "HLoop-Checkpoint"
CHECKPOINT_TRAILER_BATCH = "HLoop-Batch"
CHECKPOINT_KIND_LOOP_STATE = "loop-state"


class HLoopError(RuntimeError):
    pass


def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


def filename_timestamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + f"-{time.time_ns()}"


def run_cmd(
    cmd: list[str],
    cwd: Path | None = None,
    check: bool = True,
    capture: bool = True,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        cwd=str(cwd) if cwd else None,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=check,
    )


def git(repo: Path, args: list[str], check: bool = True) -> str:
    proc = run_cmd(["git", "-C", str(repo), *args], check=check)
    if proc.returncode != 0 and check:
        raise HLoopError(proc.stderr.strip())
    return (proc.stdout or "").strip()


def command_error_detail(exc: BaseException) -> str:
    if isinstance(exc, subprocess.CalledProcessError):
        stderr = (exc.stderr or "").strip()
        stdout = (exc.stdout or "").strip()
        return stderr or stdout or str(exc)
    return str(exc)


def is_environment_git_error(detail: str) -> bool:
    lower = detail.lower()
    needles = [
        "read-only file system",
        "permission denied",
        "unable to create",
        "cannot lock",
        ".lock",
        "index.lock",
        "orig_head.lock",
        "would be overwritten by merge",
        "no space left on device",
        "input/output error",
    ]
    return any(needle in lower for needle in needles)


def repo_root(path: Path) -> Path:
    proc = run_cmd(["git", "-C", str(path), "rev-parse", "--show-toplevel"], check=False)
    if proc.returncode != 0:
        raise HLoopError(f"not inside a git repository: {path}")
    return Path(proc.stdout.strip()).resolve()


def loop_path(repo: Path) -> Path:
    return repo / LOOP_DIR


def repo_lock_path(repo: Path) -> Path:
    proc = run_cmd(["git", "-C", str(repo), "rev-parse", "--git-path", "hloop.lock"], check=False)
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "failed to resolve git lock path").strip())
    raw = (proc.stdout or "").strip()
    path = Path(raw)
    return path if path.is_absolute() else (repo / path)


def state_path(repo: Path) -> Path:
    return loop_path(repo) / "STATE.json"


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except FileNotFoundError as exc:
        raise HLoopError(f"missing file: {path}") from exc


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{time.time_ns()}.tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def append_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(text)


@contextmanager
def loop_lock(repo: Path):
    lock_path = repo_lock_path(repo)
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+", encoding="utf-8") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        try:
            retire_legacy_loop_lock(repo)
            yield
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)


def retire_legacy_loop_lock(repo: Path) -> None:
    """Best-effort cleanup for the old worktree-visible .ai/loop/LOCK file."""
    legacy = loop_path(repo) / "LOCK"
    if not legacy.exists() or not legacy.is_file():
        return
    tracked = run_cmd(
        ["git", "-C", str(repo), "ls-files", "--error-unmatch", str(LOOP_DIR / "LOCK")],
        check=False,
    )
    if tracked.returncode == 0:
        return
    try:
        with legacy.open("r+", encoding="utf-8") as fh:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            try:
                if legacy.stat().st_size == 0:
                    legacy.unlink()
            finally:
                fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
    except (BlockingIOError, OSError):
        return


def command_requires_loop_lock(args: argparse.Namespace) -> bool:
    command = getattr(args, "command", "")
    if command in {"init", "merge", "validate", "qa", "tick", "pump", "report", "checkpoint"}:
        return True
    if command == "batch":
        return getattr(args, "batch_command", "") in {"start", "assign", "close"}
    if command == "harvest":
        return True
    if command == "task":
        return getattr(args, "task_command", "") == "new"
    if command == "worker":
        return getattr(args, "worker_command", "") in {"start", "harvest", "message"}
    if command == "reviewer":
        return getattr(args, "reviewer_command", "") in {"start", "harvest", "close", "message"}
    if command == "gap":
        return getattr(args, "gap_command", "") in {"start", "harvest", "close", "message"}
    if command == "triage":
        return not bool(getattr(args, "dry_run", False))
    return False


def load_state(repo: Path) -> dict[str, Any]:
    path = state_path(repo)
    if not path.exists():
        raise HLoopError(f"STATE.json not found: {path}")
    try:
        return json.loads(read_text(path))
    except json.JSONDecodeError as exc:
        raise HLoopError(f"invalid STATE.json: {exc}") from exc


def save_state(repo: Path, state: dict[str, Any]) -> None:
    state["updated_at"] = now_iso()
    write_text(state_path(repo), json.dumps(state, ensure_ascii=False, indent=2) + "\n")


def journal(repo: Path, message: str) -> None:
    append_text(loop_path(repo) / "JOURNAL.md", f"\n## {now_iso()}\n\n{message}\n")


def parse_scalar(raw: str) -> Any:
    value = raw.strip()
    if value == "":
        return ""
    lower = value.lower()
    if lower == "true":
        return True
    if lower == "false":
        return False
    if value == "[]":
        return []
    if value.startswith("[") and value.endswith("]"):
        inner = value[1:-1].strip()
        if not inner:
            return []
        return [parse_scalar(part.strip()) for part in inner.split(",")]
    if (value.startswith('"') and value.endswith('"')) or (
        value.startswith("'") and value.endswith("'")
    ):
        return value[1:-1]
    return value


def parse_frontmatter_text(text: str) -> dict[str, Any]:
    if not text.startswith("---\n"):
        return {}
    end = text.find("\n---", 4)
    if end == -1:
        return {}
    data: dict[str, Any] = {}
    current_key: str | None = None
    for line in text[4:end].splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        item = re.match(r"^\s*-\s+(.*)$", line)
        if item and current_key:
            data.setdefault(current_key, [])
            if not isinstance(data[current_key], list):
                data[current_key] = [data[current_key]]
            data[current_key].append(parse_scalar(item.group(1)))
            continue
        if ":" not in line:
            continue
        key, raw_value = line.split(":", 1)
        key = key.strip()
        raw_value = raw_value.strip()
        if raw_value == "":
            data[key] = []
            current_key = key
        else:
            data[key] = parse_scalar(raw_value)
            current_key = None
    return data


def read_frontmatter(path: Path) -> dict[str, Any]:
    return parse_frontmatter_text(read_text(path))


def replace_frontmatter(path: Path, updates: dict[str, Any]) -> None:
    text = read_text(path)
    if not text.startswith("---\n"):
        raise HLoopError(f"missing frontmatter: {path}")
    end = text.find("\n---", 4)
    if end == -1:
        raise HLoopError(f"unterminated frontmatter: {path}")
    meta = parse_frontmatter_text(text)
    meta.update(updates)
    rest = text[end + 4 :]
    if rest.startswith("\n"):
        rest = rest[1:]
    write_text(path, frontmatter(meta) + "\n" + rest)


def yaml_scalar(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    text = str(value)
    if text == "" or re.search(r"[:#\[\]{}]|^\s|\s$", text):
        return json.dumps(text, ensure_ascii=False)
    return text


def frontmatter(fields: dict[str, Any]) -> str:
    lines = ["---"]
    for key, value in fields.items():
        if isinstance(value, list):
            if value:
                lines.append(f"{key}:")
                for item in value:
                    lines.append(f"  - {yaml_scalar(item)}")
            else:
                lines.append(f"{key}: []")
        else:
            lines.append(f"{key}: {yaml_scalar(value)}")
    lines.append("---")
    return "\n".join(lines) + "\n"


def parse_simple_field_block(lines: list[str]) -> dict[str, Any]:
    data: dict[str, Any] = {}
    current_key: str | None = None
    for line in lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        item = re.match(r"^\s*-\s+(.*)$", line)
        if item and current_key:
            data.setdefault(current_key, [])
            if not isinstance(data[current_key], list):
                data[current_key] = [data[current_key]]
            data[current_key].append(parse_scalar(item.group(1)))
            continue
        if ":" not in line:
            continue
        key, raw_value = line.split(":", 1)
        key = key.strip()
        raw_value = raw_value.strip()
        if raw_value == "":
            data[key] = []
            current_key = key
        else:
            data[key] = parse_scalar(raw_value)
            current_key = None
    return data


def extract_fix_task_candidates(text: str, source_id: str) -> list[dict[str, Any]]:
    lines = text.splitlines()
    in_section = False
    blocks: list[tuple[str, list[str]]] = []
    current_title: str | None = None
    current_lines: list[str] = []
    for line in lines:
        if re.match(r"^##\s+Fix Task Candidates\s*$", line, re.IGNORECASE):
            in_section = True
            continue
        if in_section and re.match(r"^##\s+", line):
            break
        if not in_section:
            continue
        heading = re.match(r"^###\s+(.*)$", line)
        if heading:
            if current_title is not None:
                blocks.append((current_title, current_lines))
            current_title = heading.group(1).strip()
            current_lines = []
            continue
        if current_title is not None:
            current_lines.append(line)
    if current_title is not None:
        blocks.append((current_title, current_lines))

    candidates: list[dict[str, Any]] = []
    for title, block_lines in blocks:
        data = parse_simple_field_block(block_lines)
        action = str(data.get("action") or "fix_task")
        if action not in {"fix_task", "fix-task"}:
            continue
        clean_title = re.sub(r"^FT\d+\s*:\s*", "", title).strip()
        candidate = {
            "title": str(data.get("title") or clean_title),
            "kind": str(data.get("kind") or "fix"),
            "priority": str(data.get("priority") or data.get("severity") or "P1"),
            "source": str(data.get("source") or source_id),
            "source_finding": str(data.get("source_finding") or data.get("finding") or clean_title),
            "write_allow": normalize_list(data.get("write_allow")),
            "write_deny": normalize_list(data.get("write_deny")),
            "acceptance": normalize_list(data.get("acceptance"))
            or ["The referenced review/gap finding is fixed."],
            "depends_on": normalize_list(data.get("depends_on")),
            "rationale": str(data.get("rationale") or data.get("reason") or ""),
        }
        candidates.append(candidate)
    return candidates


def ensure_loop_dirs(repo: Path) -> None:
    for rel in [
        "tasks",
        "batches",
        "results",
        "reviews",
        "gaps",
        "prompts",
        "reports",
        "triage",
        "validation",
        "qa",
        "inbox/manager",
        "inbox/pending",
        "inbox/user",
    ]:
        (loop_path(repo) / rel).mkdir(parents=True, exist_ok=True)


def slugify(text: str, max_len: int = 48) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    slug = re.sub(r"-+", "-", slug)
    return (slug or "task")[:max_len].strip("-") or "task"


def next_id(prefix: str, existing: dict[str, Any]) -> str:
    nums = []
    for key in existing:
        if re.fullmatch(rf"{prefix}\d{{3}}", key):
            nums.append(int(key[1:]))
    return f"{prefix}{(max(nums) if nums else 0) + 1:03d}"


def current_branch(repo: Path) -> str:
    return git(repo, ["branch", "--show-current"])


def branch_exists(repo: Path, branch: str) -> bool:
    proc = run_cmd(["git", "-C", str(repo), "rev-parse", "--verify", "--quiet", branch], check=False)
    return proc.returncode == 0


def is_ancestor(repo: Path, ancestor: str, descendant: str) -> bool:
    if not ancestor or not descendant:
        return False
    proc = run_cmd(
        ["git", "-C", str(repo), "merge-base", "--is-ancestor", ancestor, descendant],
        check=False,
    )
    return proc.returncode == 0


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def json_from_cmd(cmd: list[str], cwd: Path | None = None) -> dict[str, Any]:
    proc = run_cmd(cmd, cwd=cwd, check=False)
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise HLoopError(f"expected JSON from {' '.join(cmd)}: {exc}") from exc


def find_key(value: Any, key: str) -> Any | None:
    if isinstance(value, dict):
        if key in value:
            return value[key]
        for child in value.values():
            found = find_key(child, key)
            if found is not None:
                return found
    elif isinstance(value, list):
        for child in value:
            found = find_key(child, key)
            if found is not None:
                return found
    return None


def extract_pane_id(payload: dict[str, Any]) -> str:
    found = find_key(payload, "pane_id")
    if found:
        return str(found)
    result = payload.get("result", {})
    candidates = [
        result.get("pane", {}),
        result.get("root_pane", {}),
        payload.get("pane", {}),
    ]
    for candidate in candidates:
        pane_id = candidate.get("pane_id") if isinstance(candidate, dict) else None
        if pane_id:
            return str(pane_id)
    raise HLoopError(f"could not find pane_id in Herdr response: {payload}")


def pane_info(pane_id: str) -> dict[str, Any] | None:
    proc = run_cmd(["herdr", "pane", "get", pane_id], check=False)
    if proc.returncode != 0:
        return None
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    pane = payload.get("result", {}).get("pane")
    return pane if isinstance(pane, dict) else None


def pane_text(pane_id: str, lines: int = 160) -> str:
    proc = run_cmd(
        [
            "herdr",
            "pane",
            "read",
            pane_id,
            "--source",
            "recent-unwrapped",
            "--lines",
            str(lines),
        ],
        check=False,
    )
    if proc.returncode != 0:
        return ""
    return proc.stdout or ""


def codex_tui_blocker(pane: dict[str, Any] | None, text: str) -> str | None:
    if pane is None:
        return "pane is missing or closed"
    if pane.get("agent") != "codex":
        return "pane is not a Codex TUI"
    if "Do you trust the contents of this directory?" in text or "Press enter to continue" in text:
        return "Codex trust prompt is pending"
    status = str(pane.get("agent_status") or "unknown")
    if status == "working" or "esc to interrupt" in text or "• Working" in text:
        return "Codex is still working"
    if status in {"blocked", "unknown"}:
        return f"Codex is not ready: agent_status={status}"
    return None


def message_anchors(message: str) -> list[str]:
    anchors: list[str] = []
    for line in message.splitlines():
        stripped = line.strip()
        if stripped:
            anchors.append(stripped[:160])
    if not anchors and message.strip():
        anchors.append(message.strip()[:160])
    if len(anchors) > 1:
        return [anchors[0], anchors[-1]]
    return anchors


def message_visible_in_text(message: str, text: str) -> bool:
    anchors = message_anchors(message)
    return bool(anchors) and all(anchor in text for anchor in anchors)


def codex_output_after_message(message: str, text: str) -> bool:
    anchors = message_anchors(message)
    if not anchors:
        return False
    index = text.rfind(anchors[-1])
    if index < 0:
        return False
    after = text[index + len(anchors[-1]) :]
    return "\n• " in after


def wait_codex_tui_ready(pane_id: str, timeout_ms: int) -> tuple[dict[str, Any], str]:
    deadline = time.monotonic() + max(0, timeout_ms) / 1000
    last_blocker = "Codex TUI did not become ready"
    while True:
        pane = pane_info(pane_id)
        text = pane_text(pane_id)
        blocker = codex_tui_blocker(pane, text)
        if blocker is None and pane is not None:
            return pane, text
        last_blocker = blocker or last_blocker
        if time.monotonic() >= deadline:
            raise HLoopError(f"Codex TUI is not ready for manager message: {last_blocker}")
        time.sleep(0.5)


def wait_manager_message_visible(pane_id: str, message: str, timeout_ms: int) -> str:
    deadline = time.monotonic() + max(0, timeout_ms) / 1000
    while True:
        text = pane_text(pane_id)
        if message_visible_in_text(message, text):
            return text
        if time.monotonic() >= deadline:
            raise HLoopError("manager message was not visible in the Codex input after send-text")
        time.sleep(0.2)


def manager_message_submitted(
    pane_id: str,
    message: str,
    typed_snapshot: str,
    initial_session_id: str | None,
    timeout_ms: int,
) -> bool:
    deadline = time.monotonic() + max(0, timeout_ms) / 1000
    while True:
        pane = pane_info(pane_id)
        text = pane_text(pane_id)
        status = str((pane or {}).get("agent_status") or "unknown")
        session_id = extract_agent_session_id(pane)
        if status in {"working", "blocked"} or "esc to interrupt" in text or "• Working" in text:
            return True
        if codex_output_after_message(message, text):
            return True
        if session_id and session_id != initial_session_id and text != typed_snapshot:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)


def send_codex_tui_message(
    pane_id: str,
    message: str,
    timeout_ms: int,
    input_settle_ms: int,
    submit_verify_ms: int,
    submit_attempts: int,
) -> None:
    if not message.strip():
        raise HLoopError("manager message is empty")
    check_herdr_env()
    initial_pane, _ = wait_codex_tui_ready(pane_id, timeout_ms)
    initial_session_id = extract_agent_session_id(initial_pane)
    run_cmd(["herdr", "pane", "send-text", pane_id, message], check=True, capture=True)
    typed_snapshot = wait_manager_message_visible(
        pane_id,
        message,
        max(input_settle_ms, 1_000),
    )
    if input_settle_ms > 0:
        time.sleep(input_settle_ms / 1000)
    attempts = max(1, submit_attempts)
    for attempt in range(attempts):
        run_cmd(["herdr", "pane", "send-keys", pane_id, "Enter"], check=True, capture=True)
        if manager_message_submitted(
            pane_id,
            message,
            typed_snapshot,
            initial_session_id,
            submit_verify_ms,
        ):
            return
        if attempt + 1 < attempts and input_settle_ms > 0:
            time.sleep(input_settle_ms / 1000)
    raise HLoopError(
        f"manager message was typed but not submitted after {attempts} Enter attempt(s)"
    )


def manager_message_from_args(args: argparse.Namespace) -> tuple[str, str]:
    if getattr(args, "file", None):
        path = Path(args.file).resolve()
        return read_text(path), str(path)
    if getattr(args, "message", None):
        return str(args.message), "argv"
    if not sys.stdin.isatty():
        return sys.stdin.read(), "stdin"
    raise HLoopError("provide a message argument, --file, or stdin")


def record_manager_message(
    target_state: dict[str, Any],
    source: str,
    message: str,
    *,
    delivery_status: str = "sent",
    delivery_error: str | None = None,
    pending_path: str | None = None,
) -> None:
    entry = {
        "at": now_iso(),
        "source": source,
        "bytes": len(message.encode("utf-8")),
        "lines": len(message.splitlines()) or 1,
        "delivery_status": delivery_status,
    }
    if delivery_error:
        entry["delivery_error"] = delivery_error
    if pending_path:
        entry["pending_path"] = pending_path
    target_state.setdefault("manager_messages", []).append(entry)


def write_pending_manager_message(
    repo: Path,
    *,
    role: str,
    agent_id: str,
    pane_id: str,
    source: str,
    message: str,
    error: str,
) -> Path:
    rel = (
        LOOP_DIR
        / "inbox"
        / "pending"
        / f"{filename_timestamp()}-{slugify(agent_id, 24)}.md"
    )
    body = (
        "# Pending Manager Message\n\n"
        f"- role: {role}\n"
        f"- id: `{agent_id}`\n"
        f"- pane_id: `{pane_id}`\n"
        f"- source: `{source}`\n"
        f"- recorded_at: `{now_iso()}`\n"
        f"- delivery_error: `{error}`\n\n"
        "## Message\n\n"
        f"{message.rstrip()}\n"
    )
    write_text(repo / rel, body)
    return rel


def record_pending_manager_message(
    repo: Path,
    state: dict[str, Any],
    agent_state: dict[str, Any],
    *,
    role: str,
    agent_id: str,
    pane_id: str,
    source: str,
    message: str,
    error: Exception,
) -> int:
    detail = str(error)
    pending_rel = write_pending_manager_message(
        repo,
        role=role,
        agent_id=agent_id,
        pane_id=pane_id,
        source=source,
        message=message,
        error=detail,
    )
    pending_path = pending_rel.as_posix()
    record_manager_message(
        agent_state,
        source,
        message,
        delivery_status="pending",
        delivery_error=detail,
        pending_path=pending_path,
    )
    agent_state["last_manager_message_error"] = detail
    agent_state["last_pending_manager_message"] = pending_path
    agent_state.setdefault("pending_manager_messages", []).append(
        {"at": now_iso(), "source": source, "pending_path": pending_path, "error": detail}
    )
    save_state(repo, state)
    journal(
        repo,
        f"Recorded pending Manager message for {role} `{agent_id}` at `{pending_path}`; "
        f"delivery failed: {detail}",
    )
    print(
        f"manager message not delivered to {agent_id}: {detail}; pending file: {pending_path}",
        file=sys.stderr,
    )
    return 2


def extract_agent_session_id(pane: dict[str, Any] | None) -> str | None:
    if not pane:
        return None
    session = pane.get("agent_session")
    if isinstance(session, dict):
        value = session.get("value")
        if value:
            return str(value)
    for key in ("agent_session_id", "session_id"):
        value = pane.get(key)
        if value:
            return str(value)
    return None


def session_cleanup_mode(args: argparse.Namespace, state: dict[str, Any]) -> str:
    mode = getattr(args, "session_cleanup", None) or state.get("session_cleanup", "archive")
    mode = str(mode)
    if mode not in SESSION_CLEANUP_MODES:
        raise HLoopError(f"unsupported session cleanup mode: {mode}")
    return mode


def cleanup_codex_session(session_id: str, mode: str) -> tuple[bool, str]:
    if mode == "none":
        return True, "skipped"
    if not command_exists("codex"):
        return False, "codex command not found"
    cmd = ["codex", "archive", session_id]
    if mode == "delete":
        cmd = ["codex", "delete", "--force", session_id]
    proc = run_cmd(cmd, check=False)
    if proc.returncode == 0:
        return True, mode
    message = (proc.stderr or proc.stdout or "").strip()
    return False, message or f"codex {mode} failed"


def cleanup_completed_agent_pane(
    repo: Path,
    agent_state: dict[str, Any],
    *,
    label: str,
    keep_pane: bool = False,
    session_cleanup: str = "archive",
    dry_run: bool = False,
) -> None:
    pane_id = str(agent_state.get("pane_id") or "")
    if not pane_id or agent_state.get("pane_closed_at"):
        return
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        agent_state["pane_cleanup_status"] = "skipped:not-in-herdr"
        return
    try:
        current = current_pane_id()
    except HLoopError:
        current = ""
    if pane_id == current:
        agent_state["pane_cleanup_status"] = "skipped:manager-pane"
        journal(repo, f"Skipped closing `{label}` pane `{pane_id}` because it is the current Manager pane.")
        return
    pane = pane_info(pane_id)
    if pane is None:
        agent_state["pane_closed_at"] = now_iso()
        agent_state["pane_cleanup_status"] = "already-closed"
        return
    session_id = extract_agent_session_id(pane)
    if session_id:
        agent_state["codex_session_id"] = session_id
    if keep_pane:
        agent_state["pane_cleanup_status"] = "kept"
        return
    if dry_run:
        print(f"DRY RUN herdr pane close {pane_id}")
        if session_id and session_cleanup != "none":
            print(f"DRY RUN codex {session_cleanup} {session_id}")
        return
    proc = run_cmd(["herdr", "pane", "close", pane_id], check=False)
    if proc.returncode == 0:
        agent_state["pane_closed_at"] = now_iso()
        agent_state["pane_cleanup_status"] = "closed"
        journal(repo, f"Closed `{label}` pane `{pane_id}` after harvesting its artifact.")
    else:
        message = (proc.stderr or proc.stdout or "").strip()
        agent_state["pane_cleanup_status"] = "failed"
        agent_state["pane_cleanup_error"] = message
        journal(repo, f"Failed to close `{label}` pane `{pane_id}`: {message}")
        return
    if session_id:
        ok, detail = cleanup_codex_session(session_id, session_cleanup)
        agent_state["codex_session_cleanup"] = detail
        if ok:
            agent_state["codex_session_cleaned_at"] = now_iso()
            journal(repo, f"Codex session `{session_id}` for `{label}` cleanup: {detail}.")
        else:
            agent_state["codex_session_cleanup_error"] = detail
            journal(repo, f"Failed Codex session cleanup for `{label}` session `{session_id}`: {detail}")


def current_pane_id() -> str:
    if os.environ.get("HERDR_PANE_ID"):
        return str(os.environ["HERDR_PANE_ID"])
    payload = json_from_cmd(["herdr", "pane", "current", "--current"])
    return extract_pane_id(payload)


def current_workspace_id() -> str | None:
    return os.environ.get("HERDR_WORKSPACE_ID")


def check_herdr_env() -> None:
    if os.environ.get("HERDR_ENV") != "1":
        raise HLoopError("HERDR_ENV=1 is required; run this skill inside Herdr")


