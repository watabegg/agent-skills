#!/usr/bin/env python3
"""Herdr Dev Loop helper.

This script keeps the Herdr/Codex multi-agent loop file-backed and bounded.
It intentionally avoids non-stdlib dependencies so it can run inside arbitrary
repositories.
"""

from __future__ import annotations

import argparse
import fnmatch
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


LOOP_DIR = Path(".ai") / "loop"
TASK_STATUSES_FINAL = {"done", "partial", "blocked", "failed", "abandoned"}
SESSION_CLEANUP_MODES = {"none", "archive", "delete"}
DEFAULT_REVIEW_WAIT_MS = 600_000
DEFAULT_MANAGER_MESSAGE_INPUT_SETTLE_MS = 1_000
DEFAULT_MANAGER_MESSAGE_SUBMIT_VERIFY_MS = 5_000
DEFAULT_MANAGER_MESSAGE_SUBMIT_ATTEMPTS = 2


class HLoopError(RuntimeError):
    pass


def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


def run_cmd(
    cmd: list[str],
    cwd: Path | None = None,
    check: bool = True,
    capture: bool = True,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        cwd=str(cwd) if cwd else None,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=check,
    )


def git(repo: Path, args: list[str], check: bool = True) -> str:
    proc = run_cmd(["git", "-C", str(repo), *args], check=check)
    if proc.returncode != 0 and check:
        raise HLoopError(proc.stderr.strip())
    return (proc.stdout or "").strip()


def repo_root(path: Path) -> Path:
    proc = run_cmd(["git", "-C", str(path), "rev-parse", "--show-toplevel"], check=False)
    if proc.returncode != 0:
        raise HLoopError(f"not inside a git repository: {path}")
    return Path(proc.stdout.strip()).resolve()


def loop_path(repo: Path) -> Path:
    return repo / LOOP_DIR


def state_path(repo: Path) -> Path:
    return loop_path(repo) / "STATE.json"


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except FileNotFoundError as exc:
        raise HLoopError(f"missing file: {path}") from exc


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def append_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(text)


def load_state(repo: Path) -> dict[str, Any]:
    path = state_path(repo)
    if not path.exists():
        raise HLoopError(f"STATE.json not found: {path}")
    try:
        return json.loads(read_text(path))
    except json.JSONDecodeError as exc:
        raise HLoopError(f"invalid STATE.json: {exc}") from exc


def save_state(repo: Path, state: dict[str, Any]) -> None:
    state["updated_at"] = now_iso()
    write_text(state_path(repo), json.dumps(state, ensure_ascii=False, indent=2) + "\n")


def journal(repo: Path, message: str) -> None:
    append_text(loop_path(repo) / "JOURNAL.md", f"\n## {now_iso()}\n\n{message}\n")


def parse_scalar(raw: str) -> Any:
    value = raw.strip()
    if value == "":
        return ""
    lower = value.lower()
    if lower == "true":
        return True
    if lower == "false":
        return False
    if value == "[]":
        return []
    if value.startswith("[") and value.endswith("]"):
        inner = value[1:-1].strip()
        if not inner:
            return []
        return [parse_scalar(part.strip()) for part in inner.split(",")]
    if (value.startswith('"') and value.endswith('"')) or (
        value.startswith("'") and value.endswith("'")
    ):
        return value[1:-1]
    return value


def read_frontmatter(path: Path) -> dict[str, Any]:
    text = read_text(path)
    if not text.startswith("---\n"):
        return {}
    end = text.find("\n---", 4)
    if end == -1:
        return {}
    data: dict[str, Any] = {}
    current_key: str | None = None
    for line in text[4:end].splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        item = re.match(r"^\s*-\s+(.*)$", line)
        if item and current_key:
            data.setdefault(current_key, [])
            if not isinstance(data[current_key], list):
                data[current_key] = [data[current_key]]
            data[current_key].append(parse_scalar(item.group(1)))
            continue
        if ":" not in line:
            continue
        key, raw_value = line.split(":", 1)
        key = key.strip()
        raw_value = raw_value.strip()
        if raw_value == "":
            data[key] = []
            current_key = key
        else:
            data[key] = parse_scalar(raw_value)
            current_key = None
    return data


def yaml_scalar(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    text = str(value)
    if text == "" or re.search(r"[:#\[\]{}]|^\s|\s$", text):
        return json.dumps(text, ensure_ascii=False)
    return text


def frontmatter(fields: dict[str, Any]) -> str:
    lines = ["---"]
    for key, value in fields.items():
        if isinstance(value, list):
            if value:
                lines.append(f"{key}:")
                for item in value:
                    lines.append(f"  - {yaml_scalar(item)}")
            else:
                lines.append(f"{key}: []")
        else:
            lines.append(f"{key}: {yaml_scalar(value)}")
    lines.append("---")
    return "\n".join(lines) + "\n"


def ensure_loop_dirs(repo: Path) -> None:
    for rel in [
        "tasks",
        "results",
        "reviews",
        "prompts",
        "reports",
        "validation",
        "inbox/manager",
        "inbox/user",
    ]:
        (loop_path(repo) / rel).mkdir(parents=True, exist_ok=True)


def slugify(text: str, max_len: int = 48) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    slug = re.sub(r"-+", "-", slug)
    return (slug or "task")[:max_len].strip("-") or "task"


def next_id(prefix: str, existing: dict[str, Any]) -> str:
    nums = []
    for key in existing:
        if re.fullmatch(rf"{prefix}\d{{3}}", key):
            nums.append(int(key[1:]))
    return f"{prefix}{(max(nums) if nums else 0) + 1:03d}"


def current_branch(repo: Path) -> str:
    return git(repo, ["branch", "--show-current"])


def branch_exists(repo: Path, branch: str) -> bool:
    proc = run_cmd(["git", "-C", str(repo), "rev-parse", "--verify", "--quiet", branch], check=False)
    return proc.returncode == 0


def is_ancestor(repo: Path, ancestor: str, descendant: str) -> bool:
    if not ancestor or not descendant:
        return False
    proc = run_cmd(
        ["git", "-C", str(repo), "merge-base", "--is-ancestor", ancestor, descendant],
        check=False,
    )
    return proc.returncode == 0


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def json_from_cmd(cmd: list[str], cwd: Path | None = None) -> dict[str, Any]:
    proc = run_cmd(cmd, cwd=cwd, check=False)
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise HLoopError(f"expected JSON from {' '.join(cmd)}: {exc}") from exc


def find_key(value: Any, key: str) -> Any | None:
    if isinstance(value, dict):
        if key in value:
            return value[key]
        for child in value.values():
            found = find_key(child, key)
            if found is not None:
                return found
    elif isinstance(value, list):
        for child in value:
            found = find_key(child, key)
            if found is not None:
                return found
    return None


def extract_pane_id(payload: dict[str, Any]) -> str:
    found = find_key(payload, "pane_id")
    if found:
        return str(found)
    result = payload.get("result", {})
    candidates = [
        result.get("pane", {}),
        result.get("root_pane", {}),
        payload.get("pane", {}),
    ]
    for candidate in candidates:
        pane_id = candidate.get("pane_id") if isinstance(candidate, dict) else None
        if pane_id:
            return str(pane_id)
    raise HLoopError(f"could not find pane_id in Herdr response: {payload}")


def pane_info(pane_id: str) -> dict[str, Any] | None:
    proc = run_cmd(["herdr", "pane", "get", pane_id], check=False)
    if proc.returncode != 0:
        return None
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    pane = payload.get("result", {}).get("pane")
    return pane if isinstance(pane, dict) else None


def pane_text(pane_id: str, lines: int = 160) -> str:
    proc = run_cmd(
        [
            "herdr",
            "pane",
            "read",
            pane_id,
            "--source",
            "recent-unwrapped",
            "--lines",
            str(lines),
        ],
        check=False,
    )
    if proc.returncode != 0:
        return ""
    return proc.stdout or ""


def codex_tui_blocker(pane: dict[str, Any] | None, text: str) -> str | None:
    if pane is None:
        return "pane is missing or closed"
    if pane.get("agent") != "codex":
        return "pane is not a Codex TUI"
    if "Do you trust the contents of this directory?" in text or "Press enter to continue" in text:
        return "Codex trust prompt is pending"
    status = str(pane.get("agent_status") or "unknown")
    if status == "working" or "esc to interrupt" in text or "• Working" in text:
        return "Codex is still working"
    if status in {"blocked", "unknown"}:
        return f"Codex is not ready: agent_status={status}"
    return None


def message_anchors(message: str) -> list[str]:
    anchors: list[str] = []
    for line in message.splitlines():
        stripped = line.strip()
        if stripped:
            anchors.append(stripped[:160])
    if not anchors and message.strip():
        anchors.append(message.strip()[:160])
    if len(anchors) > 1:
        return [anchors[0], anchors[-1]]
    return anchors


def message_visible_in_text(message: str, text: str) -> bool:
    anchors = message_anchors(message)
    return bool(anchors) and all(anchor in text for anchor in anchors)


def codex_output_after_message(message: str, text: str) -> bool:
    anchors = message_anchors(message)
    if not anchors:
        return False
    index = text.rfind(anchors[-1])
    if index < 0:
        return False
    after = text[index + len(anchors[-1]) :]
    return "\n• " in after


def wait_codex_tui_ready(pane_id: str, timeout_ms: int) -> tuple[dict[str, Any], str]:
    deadline = time.monotonic() + max(0, timeout_ms) / 1000
    last_blocker = "Codex TUI did not become ready"
    while True:
        pane = pane_info(pane_id)
        text = pane_text(pane_id)
        blocker = codex_tui_blocker(pane, text)
        if blocker is None and pane is not None:
            return pane, text
        last_blocker = blocker or last_blocker
        if time.monotonic() >= deadline:
            raise HLoopError(f"Codex TUI is not ready for manager message: {last_blocker}")
        time.sleep(0.5)


def wait_manager_message_visible(pane_id: str, message: str, timeout_ms: int) -> str:
    deadline = time.monotonic() + max(0, timeout_ms) / 1000
    while True:
        text = pane_text(pane_id)
        if message_visible_in_text(message, text):
            return text
        if time.monotonic() >= deadline:
            raise HLoopError("manager message was not visible in the Codex input after send-text")
        time.sleep(0.2)


def manager_message_submitted(
    pane_id: str,
    message: str,
    typed_snapshot: str,
    initial_session_id: str | None,
    timeout_ms: int,
) -> bool:
    deadline = time.monotonic() + max(0, timeout_ms) / 1000
    while True:
        pane = pane_info(pane_id)
        text = pane_text(pane_id)
        status = str((pane or {}).get("agent_status") or "unknown")
        session_id = extract_agent_session_id(pane)
        if status in {"working", "blocked"} or "esc to interrupt" in text or "• Working" in text:
            return True
        if codex_output_after_message(message, text):
            return True
        if session_id and session_id != initial_session_id and text != typed_snapshot:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)


def send_codex_tui_message(
    pane_id: str,
    message: str,
    timeout_ms: int,
    input_settle_ms: int,
    submit_verify_ms: int,
    submit_attempts: int,
) -> None:
    if not message.strip():
        raise HLoopError("manager message is empty")
    check_herdr_env()
    initial_pane, _ = wait_codex_tui_ready(pane_id, timeout_ms)
    initial_session_id = extract_agent_session_id(initial_pane)
    run_cmd(["herdr", "pane", "send-text", pane_id, message], check=True, capture=True)
    typed_snapshot = wait_manager_message_visible(
        pane_id,
        message,
        max(input_settle_ms, 1_000),
    )
    if input_settle_ms > 0:
        time.sleep(input_settle_ms / 1000)
    attempts = max(1, submit_attempts)
    for attempt in range(attempts):
        run_cmd(["herdr", "pane", "send-keys", pane_id, "Enter"], check=True, capture=True)
        if manager_message_submitted(
            pane_id,
            message,
            typed_snapshot,
            initial_session_id,
            submit_verify_ms,
        ):
            return
        if attempt + 1 < attempts and input_settle_ms > 0:
            time.sleep(input_settle_ms / 1000)
    raise HLoopError(
        f"manager message was typed but not submitted after {attempts} Enter attempt(s)"
    )


def manager_message_from_args(args: argparse.Namespace) -> tuple[str, str]:
    if getattr(args, "file", None):
        path = Path(args.file).resolve()
        return read_text(path), str(path)
    if getattr(args, "message", None):
        return str(args.message), "argv"
    if not sys.stdin.isatty():
        return sys.stdin.read(), "stdin"
    raise HLoopError("provide a message argument, --file, or stdin")


def record_manager_message(target_state: dict[str, Any], source: str, message: str) -> None:
    target_state.setdefault("manager_messages", []).append(
        {
            "at": now_iso(),
            "source": source,
            "bytes": len(message.encode("utf-8")),
            "lines": len(message.splitlines()) or 1,
        }
    )


def extract_agent_session_id(pane: dict[str, Any] | None) -> str | None:
    if not pane:
        return None
    session = pane.get("agent_session")
    if isinstance(session, dict):
        value = session.get("value")
        if value:
            return str(value)
    for key in ("agent_session_id", "session_id"):
        value = pane.get(key)
        if value:
            return str(value)
    return None


def session_cleanup_mode(args: argparse.Namespace, state: dict[str, Any]) -> str:
    mode = getattr(args, "session_cleanup", None) or state.get("session_cleanup", "archive")
    mode = str(mode)
    if mode not in SESSION_CLEANUP_MODES:
        raise HLoopError(f"unsupported session cleanup mode: {mode}")
    return mode


def cleanup_codex_session(session_id: str, mode: str) -> tuple[bool, str]:
    if mode == "none":
        return True, "skipped"
    if not command_exists("codex"):
        return False, "codex command not found"
    cmd = ["codex", "archive", session_id]
    if mode == "delete":
        cmd = ["codex", "delete", "--force", session_id]
    proc = run_cmd(cmd, check=False)
    if proc.returncode == 0:
        return True, mode
    message = (proc.stderr or proc.stdout or "").strip()
    return False, message or f"codex {mode} failed"


def cleanup_completed_agent_pane(
    repo: Path,
    agent_state: dict[str, Any],
    *,
    label: str,
    keep_pane: bool = False,
    session_cleanup: str = "archive",
    dry_run: bool = False,
) -> None:
    pane_id = str(agent_state.get("pane_id") or "")
    if not pane_id or agent_state.get("pane_closed_at"):
        return
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        agent_state["pane_cleanup_status"] = "skipped:not-in-herdr"
        return
    try:
        current = current_pane_id()
    except HLoopError:
        current = ""
    if pane_id == current:
        agent_state["pane_cleanup_status"] = "skipped:manager-pane"
        journal(repo, f"Skipped closing `{label}` pane `{pane_id}` because it is the current Manager pane.")
        return
    pane = pane_info(pane_id)
    if pane is None:
        agent_state["pane_closed_at"] = now_iso()
        agent_state["pane_cleanup_status"] = "already-closed"
        return
    session_id = extract_agent_session_id(pane)
    if session_id:
        agent_state["codex_session_id"] = session_id
    if keep_pane:
        agent_state["pane_cleanup_status"] = "kept"
        return
    if dry_run:
        print(f"DRY RUN herdr pane close {pane_id}")
        if session_id and session_cleanup != "none":
            print(f"DRY RUN codex {session_cleanup} {session_id}")
        return
    proc = run_cmd(["herdr", "pane", "close", pane_id], check=False)
    if proc.returncode == 0:
        agent_state["pane_closed_at"] = now_iso()
        agent_state["pane_cleanup_status"] = "closed"
        journal(repo, f"Closed `{label}` pane `{pane_id}` after harvesting its artifact.")
    else:
        message = (proc.stderr or proc.stdout or "").strip()
        agent_state["pane_cleanup_status"] = "failed"
        agent_state["pane_cleanup_error"] = message
        journal(repo, f"Failed to close `{label}` pane `{pane_id}`: {message}")
        return
    if session_id:
        ok, detail = cleanup_codex_session(session_id, session_cleanup)
        agent_state["codex_session_cleanup"] = detail
        if ok:
            agent_state["codex_session_cleaned_at"] = now_iso()
            journal(repo, f"Codex session `{session_id}` for `{label}` cleanup: {detail}.")
        else:
            agent_state["codex_session_cleanup_error"] = detail
            journal(repo, f"Failed Codex session cleanup for `{label}` session `{session_id}`: {detail}")


def current_pane_id() -> str:
    if os.environ.get("HERDR_PANE_ID"):
        return str(os.environ["HERDR_PANE_ID"])
    payload = json_from_cmd(["herdr", "pane", "current", "--current"])
    return extract_pane_id(payload)


def current_workspace_id() -> str | None:
    return os.environ.get("HERDR_WORKSPACE_ID")


def check_herdr_env() -> None:
    if os.environ.get("HERDR_ENV") != "1":
        raise HLoopError("HERDR_ENV=1 is required; run this skill inside Herdr")


def task_file(repo: Path, task_id: str) -> Path:
    return loop_path(repo) / "tasks" / f"{task_id}.md"


def result_file(worktree: Path, task_id: str) -> Path:
    return loop_path(worktree) / "results" / task_id / "result.md"


def review_file(repo: Path, review_id: str) -> Path:
    return loop_path(repo) / "reviews" / f"{review_id}.md"


def prompt_file(repo: Path, name: str) -> Path:
    return loop_path(repo) / "prompts" / name


def review_artifact_path(repo: Path, review_id: str, review: dict[str, Any]) -> Path:
    path = review.get("worktree_review_path") or review.get("review_path")
    return Path(path) if path else review_file(repo, review_id)


def normalize_list(value: Any) -> list[str]:
    if value is None:
        return []
    if isinstance(value, list):
        return [str(v) for v in value]
    return [str(value)]


def normalize_bool(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() in {"1", "true", "yes", "on"}
    return bool(value)


def changed_files(repo: Path, base_sha: str, head_sha: str) -> list[str]:
    if not base_sha or not head_sha:
        return []
    out = git(repo, ["diff", "--name-only", f"{base_sha}..{head_sha}"], check=False)
    return [line for line in out.splitlines() if line.strip()]


def git_show(repo: Path, ref_path: str) -> str:
    proc = run_cmd(["git", "-C", str(repo), "show", ref_path], check=False)
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    return proc.stdout or ""


def require_committed_result(worktree: Path, task_id: str, head_sha: str) -> str:
    rel = (LOOP_DIR / "results" / task_id / "result.md").as_posix()
    ref = f"{head_sha}:{rel}"
    committed = git_show(worktree, ref)
    disk = read_text(worktree / rel)
    if committed != disk:
        raise HLoopError(f"result artifact differs between worktree and committed HEAD: {rel}")
    return rel


def result_validation_recorded(meta: dict[str, Any]) -> bool:
    return normalize_bool(meta.get("validation_recorded"))


def matches_any(path: str, patterns: list[str]) -> bool:
    return any(fnmatch.fnmatch(path, pattern) for pattern in patterns)


def validate_change_scope(task_id: str, task_meta: dict[str, Any], files: list[str]) -> list[str]:
    allow = normalize_list(task_meta.get("write_allow"))
    deny = normalize_list(task_meta.get("write_deny"))
    result_pattern = f".ai/loop/results/{task_id}/**"
    violations = []
    for path in files:
        allowed = matches_any(path, allow) or fnmatch.fnmatch(path, result_pattern)
        denied = matches_any(path, deny)
        if not allowed or denied:
            suffix = "denied" if denied else "not allowed"
            violations.append(f"{path} ({suffix})")
    return violations


def porcelain_paths(repo: Path) -> list[str]:
    proc = run_cmd(
        ["git", "-C", str(repo), "status", "--porcelain", "--untracked-files=all"],
        check=False,
    )
    out = proc.stdout or ""
    paths = []
    for line in out.splitlines():
        if not line:
            continue
        path = line[3:] if len(line) > 3 else ""
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        if path:
            paths.append(path)
    return paths


def unsafe_dirty_paths(repo: Path, *, allow_loop_dirty: bool = True) -> list[str]:
    paths = porcelain_paths(repo)
    if not allow_loop_dirty:
        return paths
    loop_prefix = f"{LOOP_DIR.as_posix()}/"
    return [path for path in paths if path != LOOP_DIR.as_posix() and not path.startswith(loop_prefix)]


def mark_blocked_environment(repo: Path, state: dict[str, Any], reason: str) -> None:
    state["phase"] = "blocked_environment"
    state["last_preflight_error"] = {"at": now_iso(), "reason": reason}
    save_state(repo, state)
    journal(repo, f"Blocked by preflight: {reason}")


def preflight_loop(
    repo: Path,
    *,
    require_herdr: bool = False,
    require_codex: bool = False,
    require_integration_branch: bool = False,
    allow_loop_dirty: bool = True,
    mark_blocked: bool = True,
) -> dict[str, Any]:
    state = load_state(repo)

    def fail(reason: str) -> None:
        if mark_blocked:
            mark_blocked_environment(repo, state, reason)
        raise HLoopError(reason)

    if not command_exists("git"):
        fail("git command not found")
    if require_herdr:
        if os.environ.get("HERDR_ENV") != "1":
            fail("HERDR_ENV=1 is required")
        if not command_exists("herdr"):
            fail("herdr command not found")
    if require_codex and not command_exists("codex"):
        fail("codex command not found")
    if require_integration_branch:
        expected = str(state.get("integration_branch") or "")
        actual = current_branch(repo)
        if not expected:
            fail("integration_branch is missing from STATE.json")
        if actual != expected:
            fail(f"current branch must be integration branch {expected}; currently {actual}")
    dirty = unsafe_dirty_paths(repo, allow_loop_dirty=allow_loop_dirty)
    if dirty:
        fail("working tree has non-loop dirty files: " + ", ".join(dirty))
    return state


def validate_reviewer_worktree_scope(
    review_id: str,
    review_state: dict[str, Any],
    worktree: Path,
) -> list[str]:
    allowed = {
        str((LOOP_DIR / "reviews" / f"{review_id}.md").as_posix()),
        str((LOOP_DIR / "prompts" / f"{review_id}.reviewer.md").as_posix()),
    }
    baseline = set(normalize_list(review_state.get("baseline_dirty_files")))
    violations = []
    for path in porcelain_paths(worktree):
        if path in baseline:
            continue
        if path not in allowed:
            violations.append(path)
    return violations


def all_tasks_merged(state: dict[str, Any]) -> bool:
    tasks = state.get("tasks", {})
    return bool(tasks) and all(task.get("status") == "merged" for task in tasks.values())


def last_validation_passed(state: dict[str, Any]) -> bool:
    results = state.get("last_validation", {}).get("results", [])
    return bool(results) and all(item.get("result") == "passed" for item in results)


def running_review_exists(state: dict[str, Any]) -> bool:
    return any(review.get("status") == "running" for review in state.get("reviews", {}).values())


def reported_review_exists(state: dict[str, Any]) -> bool:
    return any(review.get("status") == "reported" for review in state.get("reviews", {}).values())


def pending_review_exists(state: dict[str, Any]) -> bool:
    return any(
        review.get("status") in {"running", "reported"}
        for review in state.get("reviews", {}).values()
    )


def review_gate_passed(state: dict[str, Any]) -> bool:
    if int(state.get("max_reviewers", 1)) <= 0:
        return True
    if state.get("needs_review"):
        return False
    reviews = state.get("reviews", {})
    return any(review.get("status") == "triaged" for review in reviews.values())


def review_wait_ms(args: argparse.Namespace, state: dict[str, Any]) -> int:
    raw = getattr(args, "review_wait_ms", None)
    if raw is None:
        raw = state.get("review_wait_ms", DEFAULT_REVIEW_WAIT_MS)
    try:
        return max(0, int(raw))
    except (TypeError, ValueError) as exc:
        raise HLoopError(f"invalid review_wait_ms: {raw}") from exc


def wait_for_running_review(repo: Path, review_id: str, review: dict[str, Any], wait_ms: int) -> bool:
    path = review_artifact_path(repo, review_id, review)
    if path.exists() and read_text(path).strip():
        return True
    pane_id = str(review.get("pane_id") or "")
    if wait_ms <= 0 or not pane_id or os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        return False
    proc = run_cmd(
        [
            "herdr",
            "wait",
            "output",
            pane_id,
            "--match",
            f"HERDR_LOOP_REVIEW_DONE:{review_id}:",
            "--source",
            "recent-unwrapped",
            "--timeout",
            str(wait_ms),
        ],
        check=False,
    )
    if proc.returncode == 0:
        review["last_wait_result"] = "done-marker"
    else:
        review["last_wait_result"] = "timeout"
    review["last_waited_at"] = now_iso()
    return path.exists() and read_text(path).strip() != ""


def render_worker_prompt(
    task_id: str,
    task_meta: dict[str, Any],
    worktree: Path,
    branch: str,
) -> str:
    return f"""You are Worker {task_id}.

You are running in your own git worktree:
{worktree}

Your branch:
{branch}

Read first:
- .ai/loop/MISSION.md
- .ai/loop/PLAN.md
- .ai/loop/tasks/{task_id}.md

Use $codex-impl.

Manager has fixed kickoff choices for this bounded task:
- Implementation gap-check count: 1
- Review/fix loop limit: skip review unless this task explicitly requires it
- Forced QA environment: local
- QA target diff: this task branch against {task_meta.get("base_ref", "the integration branch")}

Rules:
- Edit only the files allowed by write_allow in .ai/loop/tasks/{task_id}.md.
- Do not edit .ai/loop/STATE.json.
- Do not edit .ai/loop/MISSION.md or .ai/loop/PLAN.md.
- Do not edit other task files or other result directories.
- Do not merge, rebase, or switch to the integration branch.
- If the task needs a specification decision not present in MISSION/PLAN/task, write status: blocked.

Required output:
- Write .ai/loop/results/{task_id}/result.md using the required frontmatter.
- Commit your work on your branch.

Before finishing:
- Run relevant tests/build from the task.
- Record exact commands and results in flat frontmatter fields:
  validation_recorded: true
  validation_commands: [...]
  validation_results: [...]
  validation_summary: "..."
- Review your own diff.
- Ensure no unrelated changes.

Final terminal line:
HERDR_LOOP_TASK_DONE:{task_id}:<done|blocked|failed|partial>
"""


def render_reviewer_prompt(
    review_id: str,
    base_branch: str,
    integration_branch: str,
) -> str:
    return f"""You are Reviewer {review_id}.

Compare:
- base branch: {base_branch}
- integration branch: {integration_branch}

You are running in a detached review worktree. Treat the review target as read-only during investigation.

Read:
- .ai/loop/MISSION.md
- .ai/loop/PLAN.md
- .ai/loop/DECISIONS.md

Use $codex-review-multi-v2.

Rules:
- Do not edit code.
- Do not run formatters, generators, migrations, or automatic fix commands.
- Do not commit, merge, rebase, or switch branches.
- Review the integration branch against base.
- For every finding, re-investigate whether it can actually occur in this codebase.
- Do not report vague best-practice issues unless they create concrete risk.
- Prefer concrete code paths, failing scenarios, or missing tests.
- Classify severity as P0/P1/P2/P3.
- Recommend Manager action: fix_task, decision_needed, accepted_risk_candidate, or false_positive_candidate.

Output:
- During review, do not write files.
- After review is complete, write only .ai/loop/reviews/{review_id}.md.
- Include frontmatter: review_id, base, head, status: reported|blocked|failed.
- If blocked or failed, still write the artifact with the concrete reason.

Final terminal line:
HERDR_LOOP_REVIEW_DONE:{review_id}:<reported|blocked|failed>
"""


def cmd_doctor(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    herdr_skill_candidates = []
    if os.environ.get("HERDR_SKILL_PATH"):
        herdr_skill_candidates.append(Path(os.environ["HERDR_SKILL_PATH"]))
    herdr_skill_candidates.extend(
        [
            Path.home() / ".agents/skills/herdr/SKILL.md",
            codex_home / "skills/herdr/SKILL.md",
            Path.home() / ".codex/skills/herdr/SKILL.md",
        ]
    )
    herdr_skill = next((path for path in herdr_skill_candidates if path.exists()), None)
    checks: dict[str, Any] = {
        "repo": str(repo),
        "HERDR_ENV": os.environ.get("HERDR_ENV"),
        "HERDR_PANE_ID": os.environ.get("HERDR_PANE_ID"),
        "HERDR_WORKSPACE_ID": os.environ.get("HERDR_WORKSPACE_ID"),
        "HERDR_TAB_ID": os.environ.get("HERDR_TAB_ID"),
        "commands": {
            "git": command_exists("git"),
            "herdr": command_exists("herdr"),
            "codex": command_exists("codex"),
        },
        "skills": {
            "codex-impl": str(codex_home / "skills/codex-impl/SKILL.md"),
            "codex-review-multi-v2": str(
                codex_home / "skills/codex-review-multi-v2/SKILL.md"
            ),
            "herdr": str(herdr_skill or herdr_skill_candidates[0]),
        },
        "warnings": [],
    }
    checks["skills"] = {
        key: {"path": value, "exists": Path(value).exists()}
        for key, value in checks["skills"].items()
    }
    checks["skills"]["herdr"]["candidates"] = [str(path) for path in herdr_skill_candidates]
    if not checks["skills"]["herdr"]["exists"]:
        checks["warnings"].append("herdr skill file not found; continuing because the herdr CLI is authoritative")
    if command_exists("codex"):
        proc = run_cmd(["codex", "--version"], check=False)
        checks["codex_version"] = (proc.stdout or proc.stderr).strip()
    if command_exists("herdr") and os.environ.get("HERDR_ENV") == "1":
        status_proc = run_cmd(["herdr", "status"], check=False)
        checks["herdr_status"] = (status_proc.stdout or status_proc.stderr).strip()
        try:
            current = json_from_cmd(["herdr", "pane", "current", "--current"])
            checks["current_pane_id"] = extract_pane_id(current)
        except HLoopError as exc:
            checks["herdr_error"] = str(exc)
    required_skills_ok = all(
        checks["skills"][key]["exists"]
        for key in ("codex-impl", "codex-review-multi-v2")
    )
    herdr_skill_ok = checks["skills"]["herdr"]["exists"] or not args.strict_skills
    ok = checks["HERDR_ENV"] == "1" and all(checks["commands"].values()) and required_skills_ok and herdr_skill_ok
    checks["ok"] = ok
    if args.json:
        print(json.dumps(checks, ensure_ascii=False, indent=2))
    else:
        for key, value in checks.items():
            print(f"{key}: {value}")
    return 0 if ok else 1


def cmd_init(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    base = args.base or current_branch(repo) or "main"
    goal_id = args.goal_id or slugify(args.goal, 32)
    integration = args.integration or f"ai/{goal_id}/integration"
    if args.create_branch:
        if branch_exists(repo, integration):
            git(repo, ["switch", integration])
        else:
            git(repo, ["switch", "-c", integration, base])

    mission = loop_path(repo) / "MISSION.md"
    plan = loop_path(repo) / "PLAN.md"
    decisions = loop_path(repo) / "DECISIONS.md"
    user_action = loop_path(repo) / "USER_ACTION_REQUIRED.md"
    journal_path = loop_path(repo) / "JOURNAL.md"
    if not mission.exists() or args.force:
        write_text(
            mission,
            f"""# Mission

## Goal
{args.goal}

## Context
TBD by Manager.

## Constraints
- Use Herdr-managed panes only when `HERDR_ENV=1`.
- Persist loop state in `.ai/loop`.
- Stop on blocking specification decisions.

## Non-goals
- Do not run unbounded autonomous loops.

## Done when
- All planned tasks are merged into `{integration}`.
- Required validation passes.
- No blocking review finding remains.

## Base branch
{base}

## Integration branch
{integration}

## Validation levels
- L0: format / lint / typecheck
- L1: relevant unit tests
- L2: full build / full test
- L3: e2e or manual verification
""",
        )
    if not plan.exists() or args.force:
        write_text(
            plan,
            """# Plan

## Strategy
TBD by Manager.

## Task graph
- Add tasks with `hloop task new`.

## Parallelization rules
- Run Workers in parallel only when their `write_allow` patterns do not overlap.

## Validation plan
- Run task-specific validation before merge.
- Run integration validation after each merge.

## Review plan
- Run Reviewer after integration advances and before final completion.
""",
        )
    if not decisions.exists():
        write_text(decisions, "# Decisions\n\n")
    if not user_action.exists():
        write_text(user_action, "# User Action Required\n\nNo blocking user action.\n")
    if not journal_path.exists():
        write_text(journal_path, "# Journal\n")
    state = {
        "goal_id": goal_id,
        "phase": "initialized",
        "base_branch": base,
        "integration_branch": integration,
        "merge_mode": args.merge_mode,
        "worker_runner": args.worker_runner,
        "reviewer_runner": args.reviewer_runner,
        "session_cleanup": args.session_cleanup,
        "review_wait_ms": args.review_wait_ms,
        "cycle": 0,
        "max_workers": args.max_workers,
        "max_reviewers": args.max_reviewers,
        "validation_commands": args.validation or [],
        "tasks": {},
        "reviews": {},
        "blocking_decisions": [],
        "created_at": now_iso(),
    }
    if state_path(repo).exists() and not args.force:
        old = load_state(repo)
        old.setdefault("validation_commands", args.validation or [])
        print(f"STATE.json already exists: {state_path(repo)}")
        return 0
    save_state(repo, state)
    journal(repo, f"Initialized loop `{goal_id}` on integration branch `{integration}`.")
    print(f"initialized .ai/loop for {goal_id}")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    if args.json:
        print(json.dumps(state, ensure_ascii=False, indent=2))
        return 0
    print(f"goal_id: {state.get('goal_id')}")
    print(f"phase: {state.get('phase')}")
    print(f"base: {state.get('base_branch')}")
    print(f"integration: {state.get('integration_branch')}")
    print(f"current_branch: {current_branch(repo)}")
    print("tasks:")
    for task_id, task in state.get("tasks", {}).items():
        print(f"  {task_id}: {task.get('status')} {task.get('branch', '')}")
    print("reviews:")
    for review_id, review in state.get("reviews", {}).items():
        pane = review.get("pane_id", "")
        runner = review.get("runner", "")
        worktree = review.get("worktree", "")
        watch = f" watch: hloop reviewer watch {review_id}" if pane else ""
        print(f"  {review_id}: {review.get('status')} pane={pane} runner={runner} worktree={worktree}{watch}")
    return 0


def cmd_task_new(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(
        repo,
        require_integration_branch=True,
        mark_blocked=False,
    )
    if args.kind == "implementation" and not args.write_allow and not args.allow_no_write:
        raise HLoopError("implementation tasks require at least one --write-allow")
    task_id = args.id or next_id("T", state.setdefault("tasks", {}))
    if task_id in state["tasks"]:
        raise HLoopError(f"task already exists: {task_id}")
    title_slug = slugify(args.title)
    branch = args.branch or f"ai/{state['goal_id']}/{task_id}-{title_slug}"
    base_ref = args.base_ref or state["integration_branch"]
    if not branch_exists(repo, base_ref):
        raise HLoopError(
            f"base_ref does not exist: {base_ref}. Run init with --create-branch "
            "or create/switch to the integration branch before adding tasks."
        )
    base_sha = args.base_sha or git(repo, ["rev-parse", base_ref])
    fields = {
        "id": task_id,
        "kind": args.kind,
        "status": "queued",
        "created_from": "PLAN.md",
        "branch": branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "priority": args.priority,
        "depends_on": args.depends_on or [],
        "write_allow": args.write_allow or [],
        "write_deny": args.write_deny or [],
        "acceptance": args.acceptance or ["Task acceptance criteria are satisfied."],
        "validation_minimum": args.validation_minimum,
    }
    body = f"""# Task {task_id}: {args.title}

## Goal
{args.title}

## Context
Read:
- .ai/loop/MISSION.md
- .ai/loop/PLAN.md

## Instructions
Use $codex-impl.

Follow this sequence:
1. Gap-check the task against the current code.
2. Implement the smallest safe change.
3. Review your own diff.
4. Run targeted tests/build.
5. Write result artifact.
6. Commit your work.

## Done when
{chr(10).join(f"- {item}" for item in fields["acceptance"])}
"""
    write_text(task_file(repo, task_id), frontmatter(fields) + "\n" + body)
    state["tasks"][task_id] = {
        "status": "queued",
        "branch": branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "write_allow": fields["write_allow"],
        "write_deny": fields["write_deny"],
        "depends_on": fields["depends_on"],
        "created_at": now_iso(),
    }
    state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Created task `{task_id}`: {args.title}")
    print(f"created {task_id}: {task_file(repo, task_id)}")
    return 0


def default_worktree(repo: Path, task_id: str) -> Path:
    return repo.parent / f"{repo.name}.{task_id.lower()}"


def default_review_worktree(repo: Path, review_id: str) -> Path:
    return repo.parent / f"{repo.name}.{review_id.lower()}-review"


def ensure_task_visible_in_worktree(worktree: Path, task_id: str) -> None:
    missing = [
        loop_path(worktree) / "MISSION.md",
        loop_path(worktree) / "PLAN.md",
        task_file(worktree, task_id),
    ]
    absent = [str(path) for path in missing if not path.exists()]
    if absent:
        raise HLoopError(
            "worker worktree does not contain required .ai/loop files. "
            "Commit Manager-owned .ai/loop changes on the integration branch first. "
            f"Missing: {', '.join(absent)}"
        )


def ensure_review_visible_in_worktree(worktree: Path) -> None:
    missing = [
        loop_path(worktree) / "MISSION.md",
        loop_path(worktree) / "PLAN.md",
        loop_path(worktree) / "DECISIONS.md",
    ]
    absent = [str(path) for path in missing if not path.exists()]
    if absent:
        raise HLoopError(
            "review worktree does not contain required .ai/loop files. "
            "Commit Manager-owned .ai/loop changes on the integration branch first. "
            f"Missing: {', '.join(absent)}"
        )


def cleanup_review_worktree(
    repo: Path,
    review_id: str,
    review_state: dict[str, Any],
    *,
    dry_run: bool = False,
) -> None:
    worktree_raw = review_state.get("worktree")
    if not worktree_raw:
        return
    worktree = Path(worktree_raw).resolve()
    if not worktree.exists() or worktree == repo or review_state.get("worktree_cleaned_at"):
        return
    if dry_run:
        print(f"DRY RUN git worktree remove --force {worktree}")
        return
    git(repo, ["worktree", "remove", "--force", str(worktree)])
    review_state["worktree_cleanup_status"] = "removed"
    review_state["worktree_cleaned_at"] = now_iso()


def start_pane_launcher(
    *,
    manager_pane: str,
    direction: str,
    cwd: Path,
    command: str,
) -> str:
    split_cmd = [
        "herdr",
        "pane",
        "split",
        manager_pane,
        "--direction",
        direction,
        "--cwd",
        str(cwd),
        "--no-focus",
    ]
    pane_id = extract_pane_id(json_from_cmd(split_cmd))
    run_cmd(["herdr", "pane", "run", pane_id, command], check=True, capture=True)
    return pane_id


def start_agent_launcher(
    *,
    name: str,
    direction: str,
    cwd: Path,
    command: str,
) -> str:
    cmd = ["herdr", "agent", "start", name, "--cwd", str(cwd)]
    workspace_id = current_workspace_id()
    if workspace_id:
        cmd.extend(["--workspace", workspace_id])
    cmd.extend(["--split", direction, "--no-focus", "--", "bash", "-lc", command])
    return extract_pane_id(json_from_cmd(cmd))


def codex_command_for_prompt(
    *,
    runner: str,
    sandbox: str,
    prompt_rel: Path,
    output_rel: Path | None = None,
) -> str:
    prompt_ref = shlex.quote(str(prompt_rel))
    if runner == "exec":
        parts = ["codex", "exec", "--sandbox", sandbox]
        if output_rel is not None:
            parts.extend(["--output-last-message", str(output_rel)])
        parts.append("-")
        return f"{shlex.join(parts)} < {prompt_ref}"
    if runner == "tui":
        parts = [
            "codex",
            "--sandbox",
            sandbox,
            "--ask-for-approval",
            "never",
            "--no-alt-screen",
        ]
        return f"{shlex.join(parts)} \"$(cat {prompt_ref})\""
    raise HLoopError(f"unsupported runner: {runner}")


def cmd_worker_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    if task_state.get("status") not in {"queued", "failed_validation"}:
        raise HLoopError(f"task is not startable: {task_id} status={task_state.get('status')}")
    task_meta = read_frontmatter(task_file(repo, task_id))
    branch = task_state.get("branch") or task_meta["branch"]
    integration = state["integration_branch"]
    current_base_sha = git(repo, ["rev-parse", integration])
    task_state["base_ref"] = integration
    task_state["base_sha"] = current_base_sha
    task_meta["base_ref"] = integration
    task_meta["base_sha"] = current_base_sha
    worktree = Path(args.worktree).resolve() if args.worktree else default_worktree(repo, task_id)
    prompt = render_worker_prompt(task_id, task_meta, worktree, branch)
    prompt_rel = LOOP_DIR / "prompts" / f"{task_id}.worker.md"
    runner = args.runner or state.get("worker_runner", "tui")
    command = (
        f"cd {shlex.quote(str(worktree))} && "
        f"{codex_command_for_prompt(runner=runner, sandbox='workspace-write', prompt_rel=prompt_rel)}"
    )
    if args.dry_run:
        print(f"DRY RUN worktree: git worktree add {worktree} -b {branch} {integration}")
        print(f"DRY RUN prompt: {worktree / prompt_rel}")
        print(f"DRY RUN {args.launcher}/{runner} command: {command}")
        return 0
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_codex=True,
        require_integration_branch=True,
    )
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    if task_state.get("status") not in {"queued", "failed_validation"}:
        raise HLoopError(f"task is not startable: {task_id} status={task_state.get('status')}")
    task_meta = read_frontmatter(task_file(repo, task_id))
    branch = task_state.get("branch") or task_meta["branch"]
    integration = state["integration_branch"]
    current_base_sha = git(repo, ["rev-parse", integration])
    task_state["base_ref"] = integration
    task_state["base_sha"] = current_base_sha
    task_meta["base_ref"] = integration
    task_meta["base_sha"] = current_base_sha
    worktree = Path(args.worktree).resolve() if args.worktree else default_worktree(repo, task_id)
    prompt = render_worker_prompt(task_id, task_meta, worktree, branch)
    runner = args.runner or state.get("worker_runner", "tui")
    command = (
        f"cd {shlex.quote(str(worktree))} && "
        f"{codex_command_for_prompt(runner=runner, sandbox='workspace-write', prompt_rel=prompt_rel)}"
    )
    if not branch_exists(repo, integration):
        raise HLoopError(
            f"integration branch does not exist: {integration}. "
            "Run `hloop init --create-branch` or create it before starting Workers."
        )
    if not worktree.exists():
        if branch_exists(repo, branch):
            git(repo, ["worktree", "add", str(worktree), branch])
        else:
            git(repo, ["worktree", "add", str(worktree), "-b", branch, integration])
    ensure_task_visible_in_worktree(worktree, task_id)
    write_text(worktree / prompt_rel, prompt)
    if args.launcher == "agent":
        pane_id = start_agent_launcher(
            name=f"hloop-{state['goal_id']}-{task_id}-worker",
            direction=args.direction,
            cwd=worktree,
            command=command,
        )
    else:
        manager_pane = args.manager_pane or current_pane_id()
        pane_id = start_pane_launcher(
            manager_pane=manager_pane,
            direction=args.direction,
            cwd=worktree,
            command=command,
        )
    task_state.update(
        {
            "status": "running",
            "pane_id": pane_id,
            "worktree": str(worktree),
            "prompt": str(worktree / prompt_rel),
            "runner": runner,
            "started_at": now_iso(),
        }
    )
    state["phase"] = "running"
    save_state(repo, state)
    journal(repo, f"Started Worker `{task_id}` in pane `{pane_id}` and worktree `{worktree}`.")
    print(f"started {task_id} in pane {pane_id}")
    return 0


def cmd_worker_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    worktree = Path(task_state.get("worktree") or default_worktree(repo, task_id)).resolve()
    result = result_file(worktree, task_id)
    if not result.exists():
        raise HLoopError(f"result not found: {result}")
    meta = read_frontmatter(result)
    status = str(meta.get("status", ""))
    if status not in TASK_STATUSES_FINAL:
        raise HLoopError(f"invalid result status in {result}: {status}")
    reported_task_id = str(meta.get("task_id") or "")
    if reported_task_id and reported_task_id != task_id:
        raise HLoopError(f"result task_id mismatch: expected {task_id}, got {reported_task_id}")
    raw_head_sha = str(meta.get("head_sha") or "")
    head_sha = git(worktree, ["rev-parse", "HEAD"]) if raw_head_sha in {"", "HEAD"} else raw_head_sha
    manager_base_sha = str(task_state.get("base_sha") or "")
    reported_base_sha = str(meta.get("base_sha") or "")
    base_sha = manager_base_sha
    if not base_sha:
        raise HLoopError(f"manager base_sha is missing for {task_id}")
    committed_result = require_committed_result(worktree, task_id, head_sha)
    files = normalize_list(meta.get("changed_files")) or changed_files(worktree, base_sha, head_sha)
    validation_recorded = result_validation_recorded(meta)
    if normalize_bool(meta.get("merge_ready")) and not validation_recorded:
        raise HLoopError(f"merge_ready result does not record validation: {result}")
    task_state.update(
        {
            "status": "result_reported" if status == "done" else status,
            "result_status": status,
            "merge_ready": normalize_bool(meta.get("merge_ready")),
            "head_sha": head_sha,
            "base_sha": base_sha,
            "reported_base_sha": reported_base_sha,
            "changed_files": files,
            "blocking_questions": normalize_list(meta.get("blocking_questions")),
            "validation_recorded": validation_recorded,
            "validation_commands": normalize_list(meta.get("validation_commands")),
            "validation_results": normalize_list(meta.get("validation_results")),
            "validation_summary": str(meta.get("validation_summary") or ""),
            "result_path": str(result),
            "committed_result_path": committed_result,
            "harvested_at": now_iso(),
        }
    )
    cleanup_completed_agent_pane(
        repo,
        task_state,
        label=f"Worker {task_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    state["phase"] = "harvesting"
    save_state(repo, state)
    journal(repo, f"Harvested Worker `{task_id}` with status `{status}`.")
    print(f"harvested {task_id}: {status}")
    return 0


def cmd_worker_message(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    if task_state.get("status") != "running":
        raise HLoopError(f"worker is not running: {task_id} status={task_state.get('status')}")
    pane_id = str(task_state.get("pane_id") or "")
    if not pane_id:
        raise HLoopError(f"worker has no pane_id: {task_id}")
    message, source = manager_message_from_args(args)
    send_codex_tui_message(
        pane_id,
        message,
        args.timeout_ms,
        args.input_settle_ms,
        args.submit_verify_ms,
        args.submit_attempts,
    )
    record_manager_message(task_state, source, message)
    save_state(repo, state)
    journal(repo, f"Sent Manager message to Worker `{task_id}` in pane `{pane_id}` from {source}.")
    print(f"sent manager message to {task_id} in pane {pane_id}")
    return 0


def cmd_merge(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True)
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not task_state:
        raise HLoopError(f"unknown task: {task_id}")
    if task_state.get("result_status") != "done" or task_state.get("merge_ready") is not True:
        raise HLoopError(f"task is not merge ready: {task_id}")
    if normalize_list(task_state.get("blocking_questions")):
        raise HLoopError(f"task has blocking questions: {task_id}")
    if not task_state.get("validation_recorded"):
        raise HLoopError(f"task result does not record validation: {task_id}")
    branch = task_state["branch"]
    mode = args.mode or state.get("merge_mode", "squash")
    if mode not in {"squash", "cherry-pick"}:
        raise HLoopError(f"unsupported merge mode: {mode}")
    actual_head = git(repo, ["rev-parse", branch])
    reported_head = str(task_state.get("head_sha") or "")
    if reported_head and reported_head != actual_head:
        if not args.dry_run:
            task_state["status"] = "blocked_head_mismatch"
            state["phase"] = "blocked_conflict"
            save_state(repo, state)
        raise HLoopError(
            f"worker head mismatch for {task_id}: result={reported_head} actual={actual_head}"
        )
    rel_result = (LOOP_DIR / "results" / task_id / "result.md").as_posix()
    git_show(repo, f"{actual_head}:{rel_result}")
    base_sha = str(task_state.get("base_sha") or "")
    if not base_sha:
        raise HLoopError(f"manager base_sha is missing for {task_id}")
    reported_base_sha = str(task_state.get("reported_base_sha") or "")
    if reported_base_sha and reported_base_sha != base_sha:
        if is_ancestor(repo, reported_base_sha, base_sha):
            task_state["reported_base_sha_was_ancestor"] = True
            task_state["reported_base_sha_note"] = (
                "Worker reported an older base that is an ancestor of the Manager base."
            )
        else:
            if not args.dry_run:
                task_state["status"] = "blocked_base_mismatch"
                state["phase"] = "blocked_conflict"
                save_state(repo, state)
            raise HLoopError(
                f"worker base mismatch for {task_id}: result={reported_base_sha} manager={base_sha}"
            )
    files = changed_files(repo, base_sha, actual_head)
    task_state["head_sha"] = actual_head
    task_state["changed_files"] = files
    files = normalize_list(task_state.get("changed_files"))
    violations = validate_change_scope(task_id, task_state, files)
    if violations:
        if not args.dry_run:
            task_state["status"] = "blocked_write_scope"
            state["phase"] = "blocked_conflict"
            save_state(repo, state)
        raise HLoopError("write-scope violations: " + "; ".join(violations))
    if args.dry_run:
        if mode == "squash":
            print(f"DRY RUN git merge --squash {branch}")
            print(f"DRY RUN git commit -m 'ai-loop({task_id}): squash {branch}'")
        else:
            commits = git(repo, ["rev-list", "--reverse", f"{base_sha}..{actual_head}"])
            print(f"DRY RUN git cherry-pick {' '.join(commits.splitlines())}")
        return 0
    try:
        staged = run_cmd(["git", "-C", str(repo), "diff", "--cached", "--quiet"], check=False)
        if staged.returncode != 0:
            raise HLoopError("index has staged changes; commit or unstage them before integration")
        if mode == "squash":
            git(repo, ["merge", "--squash", branch])
            git(repo, ["commit", "-m", f"ai-loop({task_id}): squash {branch}"])
        else:
            commits = git(repo, ["rev-list", "--reverse", f"{base_sha}..{actual_head}"]).splitlines()
            if not commits:
                raise HLoopError(f"no commits to cherry-pick for {task_id}")
            git(repo, ["cherry-pick", *commits])
    except subprocess.CalledProcessError as exc:
        task_state["status"] = "blocked_merge_conflict"
        state["phase"] = "blocked_conflict"
        save_state(repo, state)
        journal(repo, f"Merge failed for `{task_id}` from `{branch}`. Resolve or abort manually.")
        append_text(
            loop_path(repo) / "USER_ACTION_REQUIRED.md",
            f"\n## Merge conflict for {task_id}\n\nResolve or abort the merge for `{branch}`.\n",
        )
        raise exc
    task_state["status"] = "merged"
    task_state["merged_at"] = now_iso()
    task_state["merge_mode"] = mode
    task_state["cleanup_pending"] = True
    state["needs_validation"] = True
    state["last_merged_task"] = task_id
    state["phase"] = "validating"
    save_state(repo, state)
    journal(repo, f"Merged Worker `{task_id}` from `{branch}`.")
    print(f"merged {task_id}")
    return 0


def cleanup_task(repo: Path, task_id: str, task_state: dict[str, Any], dry_run: bool = False) -> None:
    branch = task_state.get("branch")
    worktree_raw = task_state.get("worktree")
    worktree = Path(worktree_raw).resolve() if worktree_raw else default_worktree(repo, task_id)
    if worktree.exists() and worktree != repo:
        if dry_run:
            print(f"DRY RUN git worktree remove {worktree}")
        else:
            git(repo, ["worktree", "remove", str(worktree)])
    if branch and branch_exists(repo, branch):
        if dry_run:
            print(f"DRY RUN git branch -D {branch}")
        else:
            git(repo, ["branch", "-D", branch])
    if not dry_run:
        task_state["cleanup_pending"] = False
        task_state["cleanup_done"] = True
        task_state["cleaned_at"] = now_iso()


def cleanup_merged_tasks(repo: Path, state: dict[str, Any], dry_run: bool = False) -> None:
    for task_id, task in state.get("tasks", {}).items():
        if task.get("status") == "merged" and task.get("cleanup_pending"):
            cleanup_completed_agent_pane(
                repo,
                task,
                label=f"Worker {task_id}",
                session_cleanup=str(state.get("session_cleanup", "archive")),
                dry_run=dry_run,
            )
            cleanup_task(repo, task_id, task, dry_run=dry_run)


def validation_log_rel(state: dict[str, Any], index: int) -> Path:
    cycle = int(state.get("cycle", 0))
    return LOOP_DIR / "validation" / f"cycle-{cycle:04d}-{index:02d}.log"


def cmd_validate(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_integration_branch=True,
        mark_blocked=not args.dry_run,
    )
    commands = getattr(args, "validation_command", None) or state.get("validation_commands") or [
        "git diff --check"
    ]
    results = []
    failed = False
    for index, command in enumerate(commands, start=1):
        if args.dry_run:
            print(f"DRY RUN {command}")
            results.append({"command": command, "result": "dry-run"})
            continue
        proc = subprocess.run(
            command,
            cwd=str(repo),
            text=True,
            shell=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        output = proc.stdout or ""
        if output:
            sys.stdout.write(output)
            if not output.endswith("\n"):
                sys.stdout.write("\n")
        log_rel = validation_log_rel(state, index)
        write_text(repo / log_rel, output)
        result = "passed" if proc.returncode == 0 else f"failed:{proc.returncode}"
        results.append(
            {
                "command": command,
                "result": result,
                "returncode": proc.returncode,
                "log": log_rel.as_posix(),
            }
        )
        if proc.returncode != 0:
            failed = True
            break
    if not args.dry_run:
        state["last_validation"] = {"at": now_iso(), "results": results}
        state["needs_validation"] = failed
        if failed:
            state["phase"] = "failed_validation"
        elif all_tasks_merged(state) and int(state.get("max_reviewers", 1)) > 0:
            if not getattr(args, "no_cleanup", False):
                cleanup_merged_tasks(repo, state)
            state["needs_review"] = True
            state["phase"] = "reviewing"
        else:
            if not getattr(args, "no_cleanup", False):
                cleanup_merged_tasks(repo, state)
            state["phase"] = "dispatching"
        save_state(repo, state)
        journal(repo, f"Validation results: {results}")
    return 1 if failed else 0


def cmd_reviewer_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    review_id = args.review_id or next_id("R", state.setdefault("reviews", {}))
    if review_id in state["reviews"]:
        raise HLoopError(f"review already exists: {review_id}")
    base = args.base or state["base_branch"]
    head = args.head or state["integration_branch"]
    base_sha = git(repo, ["rev-parse", base])
    head_sha = git(repo, ["rev-parse", head])
    worktree = Path(args.worktree).resolve() if args.worktree else default_review_worktree(repo, review_id)
    prompt = render_reviewer_prompt(review_id, base, head)
    prompt_rel = LOOP_DIR / "prompts" / f"{review_id}.reviewer.md"
    review_rel = LOOP_DIR / "reviews" / f"{review_id}.md"
    prompt_path = worktree / prompt_rel
    worktree_review_path = worktree / review_rel
    review_path = review_file(repo, review_id)
    runner = args.runner or state.get("reviewer_runner", "tui")
    command = (
        f"cd {shlex.quote(str(worktree))} && "
        f"{codex_command_for_prompt(runner=runner, sandbox='workspace-write', prompt_rel=prompt_rel, output_rel=review_rel if runner == 'exec' else None)}"
    )
    if args.dry_run:
        print(f"DRY RUN worktree: git worktree add --detach {worktree} {head_sha}")
        print(f"DRY RUN prompt: {prompt_path}")
        print(f"DRY RUN {args.launcher}/{runner} command: {command}")
        return 0
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_codex=True,
        require_integration_branch=True,
    )
    if review_id in state["reviews"]:
        raise HLoopError(f"review already exists: {review_id}")
    base = args.base or state["base_branch"]
    head = args.head or state["integration_branch"]
    base_sha = git(repo, ["rev-parse", base])
    head_sha = git(repo, ["rev-parse", head])
    worktree = Path(args.worktree).resolve() if args.worktree else default_review_worktree(repo, review_id)
    prompt = render_reviewer_prompt(review_id, base, head)
    prompt_path = worktree / prompt_rel
    worktree_review_path = worktree / review_rel
    review_path = review_file(repo, review_id)
    runner = args.runner or state.get("reviewer_runner", "tui")
    command = (
        f"cd {shlex.quote(str(worktree))} && "
        f"{codex_command_for_prompt(runner=runner, sandbox='workspace-write', prompt_rel=prompt_rel, output_rel=review_rel if runner == 'exec' else None)}"
    )
    if not worktree.exists():
        git(repo, ["worktree", "add", "--detach", str(worktree), head_sha])
    ensure_review_visible_in_worktree(worktree)
    write_text(prompt_path, prompt)
    baseline_dirty = porcelain_paths(worktree)
    if args.launcher == "agent":
        pane_id = start_agent_launcher(
            name=f"hloop-{state['goal_id']}-{review_id}-reviewer",
            direction=args.direction,
            cwd=worktree,
            command=command,
        )
    else:
        manager_pane = args.manager_pane or current_pane_id()
        pane_id = start_pane_launcher(
            manager_pane=manager_pane,
            direction=args.direction,
            cwd=worktree,
            command=command,
        )
    state["reviews"][review_id] = {
        "status": "running",
        "base": base,
        "head": head,
        "base_sha": base_sha,
        "head_sha": head_sha,
        "pane_id": pane_id,
        "runner": runner,
        "sandbox": "workspace-write",
        "worktree": str(worktree),
        "prompt": str(prompt_path),
        "review_path": str(review_path),
        "worktree_review_path": str(worktree_review_path),
        "baseline_dirty_files": baseline_dirty,
        "started_at": now_iso(),
    }
    state["phase"] = "reviewing"
    save_state(repo, state)
    journal(repo, f"Started Reviewer `{review_id}` in pane `{pane_id}` and worktree `{worktree}`.")
    print(f"started {review_id} in pane {pane_id}; watch with `hloop reviewer watch {review_id}`")
    return 0


def cmd_reviewer_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    review_id = args.review_id
    review_state = state.get("reviews", {}).get(review_id)
    if not review_state:
        raise HLoopError(f"unknown review: {review_id}")
    path = review_artifact_path(repo, review_id, review_state)
    if not path.exists() or not read_text(path).strip():
        raise HLoopError(f"review artifact not found or empty: {path}")
    final_path = review_file(repo, review_id)
    if path.resolve() != final_path.resolve():
        write_text(final_path, read_text(path))
        review_state["worktree_review_path_harvested"] = str(path)
        review_state.pop("worktree_review_path", None)
    worktree_raw = review_state.get("worktree")
    violations: list[str] = []
    if worktree_raw:
        worktree = Path(worktree_raw).resolve()
        if worktree.exists():
            violations = validate_reviewer_worktree_scope(review_id, review_state, worktree)
    review_state["write_scope_violations"] = violations
    review_state["review_path"] = str(final_path)
    review_state["status"] = "reported"
    review_state["harvested_at"] = now_iso()
    cleanup_completed_agent_pane(
        repo,
        review_state,
        label=f"Reviewer {review_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    state["last_review_id"] = review_id
    state["needs_review"] = True
    if violations:
        review_state["status"] = "blocked_write_scope"
        state["phase"] = "blocked_conflict"
        save_state(repo, state)
        journal(
            repo,
            f"Harvested Reviewer `{review_id}` but blocked because it changed files outside the review artifact: {violations}",
        )
        append_text(
            loop_path(repo) / "USER_ACTION_REQUIRED.md",
            f"\n## Reviewer write-scope violation for {review_id}\n\n"
            f"Review artifact was copied to `{final_path}` but the review worktree has unexpected changes:\n"
            + "\n".join(f"- {item}" for item in violations)
            + "\n",
        )
        print(f"blocked {review_id}: reviewer changed files outside the review artifact")
        return 2
    cleanup_review_worktree(repo, review_id, review_state)
    state["phase"] = "reviewing"
    save_state(repo, state)
    journal(repo, f"Harvested Reviewer `{review_id}`; Manager triage is required.")
    print(f"harvested {review_id}; run `hloop reviewer close {review_id} --verdict <verdict>` after triage")
    return 0


def cmd_reviewer_close(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    review_id = args.review_id
    review_state = state.get("reviews", {}).get(review_id)
    if not review_state:
        raise HLoopError(f"unknown review: {review_id}")
    if review_state.get("status") not in {"reported", "triaged"}:
        raise HLoopError(f"review is not ready for close: {review_id}")
    cleanup_completed_agent_pane(
        repo,
        review_state,
        label=f"Reviewer {review_id}",
        keep_pane=getattr(args, "keep_pane", False),
        session_cleanup=session_cleanup_mode(args, state),
    )
    cleanup_review_worktree(repo, review_id, review_state)
    review_state["status"] = "triaged"
    review_state["verdict"] = args.verdict
    review_state["triage_reason"] = args.reason
    review_state["triaged_at"] = now_iso()
    if args.verdict == "blocked":
        state["needs_review"] = True
        state["phase"] = "blocked_user_decision"
    else:
        state["needs_review"] = False
        state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Closed Reviewer `{review_id}` with verdict `{args.verdict}`: {args.reason}")
    print(f"closed {review_id}: {args.verdict}")
    return 0


def cmd_reviewer_watch(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    review_id = args.review_id
    review_state = state.get("reviews", {}).get(review_id)
    if not review_state:
        raise HLoopError(f"unknown review: {review_id}")
    pane_id = str(review_state.get("pane_id") or "")
    print(f"review: {review_id}")
    print(f"status: {review_state.get('status')}")
    print(f"runner: {review_state.get('runner')}")
    print(f"worktree: {review_state.get('worktree', '')}")
    print(f"artifact: {review_artifact_path(repo, review_id, review_state)}")
    if not pane_id:
        print("pane: none")
        return 0
    print(f"pane: {pane_id}")
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        print("pane output unavailable: not inside Herdr")
        return 0
    info = pane_info(pane_id)
    if info is None:
        print("pane output unavailable: pane is closed or missing")
        return 0
    print(f"agent_status: {info.get('agent_status', 'unknown')}")
    proc = run_cmd(
        [
            "herdr",
            "pane",
            "read",
            pane_id,
            "--source",
            args.source,
            "--lines",
            str(args.lines),
        ],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    print(proc.stdout.rstrip())
    return 0


def cmd_reviewer_message(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_integration_branch=True,
    )
    review_id = args.review_id
    review_state = state.get("reviews", {}).get(review_id)
    if not review_state:
        raise HLoopError(f"unknown review: {review_id}")
    if review_state.get("status") != "running":
        raise HLoopError(f"reviewer is not running: {review_id} status={review_state.get('status')}")
    pane_id = str(review_state.get("pane_id") or "")
    if not pane_id:
        raise HLoopError(f"reviewer has no pane_id: {review_id}")
    message, source = manager_message_from_args(args)
    send_codex_tui_message(
        pane_id,
        message,
        args.timeout_ms,
        args.input_settle_ms,
        args.submit_verify_ms,
        args.submit_attempts,
    )
    record_manager_message(review_state, source, message)
    save_state(repo, state)
    journal(repo, f"Sent Manager message to Reviewer `{review_id}` in pane `{pane_id}` from {source}.")
    print(f"sent manager message to {review_id} in pane {pane_id}")
    return 0


def write_sets_overlap(a: list[str], b: list[str]) -> bool:
    for left in a:
        for right in b:
            if left == right or fnmatch.fnmatch(left, right) or fnmatch.fnmatch(right, left):
                return True
    return False


def queued_dispatchable_tasks(state: dict[str, Any]) -> list[str]:
    running_sets = [
        normalize_list(task.get("write_allow"))
        for task in state.get("tasks", {}).values()
        if task.get("status") == "running"
    ]
    dispatchable = []
    for task_id, task in state.get("tasks", {}).items():
        if task.get("status") != "queued":
            continue
        depends = normalize_list(task.get("depends_on"))
        if any(state["tasks"].get(dep, {}).get("status") != "merged" for dep in depends):
            continue
        write_allow = normalize_list(task.get("write_allow"))
        if any(write_sets_overlap(write_allow, active) for active in running_sets):
            continue
        dispatchable.append(task_id)
        running_sets.append(write_allow)
    return dispatchable


def cmd_tick(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(
        repo,
        require_herdr=True,
        require_codex=True,
        require_integration_branch=True,
        mark_blocked=not args.dry_run,
    )
    if not args.dry_run:
        state["cycle"] = int(state.get("cycle", 0)) + 1
        save_state(repo, state)
    if state.get("blocking_decisions"):
        if args.dry_run:
            print("DRY RUN blocked: pending user decision")
            return 2
        state["phase"] = "blocked_user_decision"
        save_state(repo, state)
        print("blocked: pending user decision")
        return 2

    if state.get("needs_validation") or state.get("phase") == "validating":
        return cmd_validate(args)

    # Harvest any running worker with a visible result artifact.
    for task_id, task in state.get("tasks", {}).items():
        if task.get("status") == "running":
            worktree = Path(task.get("worktree") or default_worktree(repo, task_id))
            if result_file(worktree, task_id).exists():
                if args.dry_run:
                    print(f"DRY RUN harvest worker {task_id}")
                    return 0
                args.task_id = task_id
                return cmd_worker_harvest(args)

    # Merge one ready task unless a Reviewer is actively reading the integration head.
    if not running_review_exists(state):
        for task_id, task in state.get("tasks", {}).items():
            if task.get("status") == "result_reported" and task.get("merge_ready"):
                args.task_id = task_id
                return cmd_merge(args)

    # Harvest any reported review artifact.
    for review_id, review in state.get("reviews", {}).items():
        if review.get("status") == "running":
            path = review_artifact_path(repo, review_id, review)
            if path.exists() and read_text(path).strip():
                if args.dry_run:
                    print(f"DRY RUN harvest reviewer {review_id}")
                    return 0
                args.review_id = review_id
                return cmd_reviewer_harvest(args)

    if (
        state.get("needs_review")
        and int(state.get("max_reviewers", 1)) > 0
        and not pending_review_exists(state)
    ):
        args.review_id = None
        args.base = None
        args.head = None
        args.runner = args.reviewer_runner
        return cmd_reviewer_start(args)

    if state.get("needs_review") and reported_review_exists(state):
        print("review triage required")
        return 0

    running_count = sum(1 for t in state.get("tasks", {}).values() if t.get("status") == "running")
    max_workers = args.max_workers or state.get("max_workers", 2)
    slots = max(0, max_workers - running_count)
    dispatchable = queued_dispatchable_tasks(state)[:slots]
    if dispatchable and args.dry_run:
        for task_id in dispatchable:
            print(f"DRY RUN start worker {task_id}")
        return 0
    started = []
    while slots > 0:
        state = load_state(repo)
        dispatchable = queued_dispatchable_tasks(state)
        if not dispatchable:
            break
        task_id = dispatchable[0]
        args.task_id = task_id
        args.worktree = None
        args.runner = args.worker_runner
        rc = cmd_worker_start(args)
        if rc != 0:
            return rc
        started.append(task_id)
        slots -= 1
    if started:
        print(f"started workers: {', '.join(started)}")
        return 0

    if state.get("needs_review") and running_review_exists(state):
        wait_ms = review_wait_ms(args, state)
        for review_id, review in state.get("reviews", {}).items():
            if review.get("status") != "running":
                continue
            if args.dry_run:
                print(f"DRY RUN wait reviewer {review_id} for {wait_ms}ms")
                return 0
            if wait_for_running_review(repo, review_id, review, wait_ms):
                save_state(repo, state)
                args.review_id = review_id
                return cmd_reviewer_harvest(args)
            save_state(repo, state)
            journal(
                repo,
                f"Reviewer `{review_id}` still running after waiting {wait_ms}ms; Manager may continue other work.",
            )
            state["phase"] = "waiting_review"
            save_state(repo, state)
            print(
                f"reviewer {review_id} still running after {wait_ms}ms; "
                f"inspect with `hloop reviewer watch {review_id}` or tick again"
            )
            return 0

    if (
        all_tasks_merged(state)
        and not state.get("needs_validation")
        and not state.get("needs_review")
        and not running_review_exists(state)
        and last_validation_passed(state)
        and review_gate_passed(state)
    ):
        if args.dry_run:
            print("DRY RUN done: all tasks merged, validation passed, review gate closed")
            return 0
        state["phase"] = "done"
        save_state(repo, state)
        print("done: all tasks merged")
        return 0

    running_workers = [
        task_id
        for task_id, task in state.get("tasks", {}).items()
        if task.get("status") == "running"
    ]
    if running_workers:
        if not args.dry_run:
            state["phase"] = "waiting_worker"
            save_state(repo, state)
        print("waiting for worker result: " + ", ".join(running_workers))
        return 0

    if not args.dry_run:
        state["phase"] = "no_progress"
        state["last_no_progress_at"] = now_iso()
        save_state(repo, state)
        journal(repo, "No progressable transition found; Manager inspection is required.")
    print("no progressable transition found")
    return 2


def cmd_report(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True)
    lines = [
        "# Final Report",
        "",
        f"- Goal ID: {state.get('goal_id')}",
        f"- Phase: {state.get('phase')}",
        f"- Base branch: {state.get('base_branch')}",
        f"- Integration branch: {state.get('integration_branch')}",
        "",
        "## Tasks",
    ]
    for task_id, task in state.get("tasks", {}).items():
        cleanup = "cleaned" if task.get("cleanup_done") else "cleanup pending"
        lines.append(
            f"- {task_id}: {task.get('status')} ({task.get('branch', '')}, {cleanup})"
        )
    lines.extend(["", "## Reviews"])
    for review_id, review in state.get("reviews", {}).items():
        lines.append(f"- {review_id}: {review.get('status')}")
    lines.extend(["", "## Validation"])
    for item in state.get("last_validation", {}).get("results", []):
        lines.append(f"- `{item.get('command')}`: {item.get('result')}")
    lines.append("")
    path = loop_path(repo) / "reports" / "FINAL.md"
    write_text(path, "\n".join(lines))
    print(path)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="hloop",
        description="File-backed Herdr/Codex Manager loop helper.",
        epilog=(
            "Safe first run: python3 /path/to/herdr-dev-loop/scripts/hloop "
            "--repo /path/to/repo init --goal-id demo --goal '...' "
            "--base main --create-branch"
        ),
    )
    parser.add_argument("--repo", default=".", help="repository path")
    sub = parser.add_subparsers(dest="command", required=True)

    doctor = sub.add_parser("doctor", help="check local Herdr/Codex/skill dependencies")
    doctor.add_argument("--json", action="store_true")
    doctor.add_argument("--strict-skills", action="store_true")
    doctor.set_defaults(func=cmd_doctor)

    init = sub.add_parser("init", help="initialize .ai/loop")
    init.add_argument("--goal-id")
    init.add_argument("--goal", required=True)
    init.add_argument("--base")
    init.add_argument("--integration")
    init.add_argument("--max-workers", type=int, default=3)
    init.add_argument("--max-reviewers", type=int, default=1)
    init.add_argument("--merge-mode", choices=["squash", "cherry-pick"], default="squash")
    init.add_argument("--worker-runner", choices=["tui", "exec"], default="tui")
    init.add_argument("--reviewer-runner", choices=["exec", "tui"], default="tui")
    init.add_argument("--session-cleanup", choices=sorted(SESSION_CLEANUP_MODES), default="archive")
    init.add_argument("--review-wait-ms", type=int, default=DEFAULT_REVIEW_WAIT_MS)
    init.add_argument("--validation", action="append")
    init.add_argument(
        "--create-branch",
        action="store_true",
        help="create or switch to the integration branch before writing .ai/loop files",
    )
    init.add_argument("--force", action="store_true")
    init.set_defaults(func=cmd_init)

    status = sub.add_parser("status", help="show loop status")
    status.add_argument("--json", action="store_true")
    status.set_defaults(func=cmd_status)

    task = sub.add_parser("task", help="task operations")
    task_sub = task.add_subparsers(dest="task_command", required=True)
    task_new = task_sub.add_parser("new", help="create a queued task")
    task_new.add_argument("title")
    task_new.add_argument("--id")
    task_new.add_argument("--kind", default="implementation")
    task_new.add_argument("--branch")
    task_new.add_argument("--base-ref")
    task_new.add_argument("--base-sha")
    task_new.add_argument("--priority", default="P1")
    task_new.add_argument("--depends-on", action="append")
    task_new.add_argument("--write-allow", action="append")
    task_new.add_argument(
        "--allow-no-write",
        action="store_true",
        help="allow an implementation task with no write_allow; prefer --kind research for no-edit work",
    )
    task_new.add_argument("--write-deny", action="append")
    task_new.add_argument("--acceptance", action="append")
    task_new.add_argument("--validation-minimum", default="L1")
    task_new.set_defaults(func=cmd_task_new)

    worker = sub.add_parser("worker", help="worker operations")
    worker_sub = worker.add_subparsers(dest="worker_command", required=True)
    worker_start = worker_sub.add_parser("start")
    worker_start.add_argument("task_id")
    worker_start.add_argument("--worktree")
    worker_start.add_argument("--manager-pane")
    worker_start.add_argument("--direction", choices=["right", "down"], default="right")
    worker_start.add_argument("--launcher", choices=["pane", "agent"], default="pane")
    worker_start.add_argument("--runner", choices=["tui", "exec"])
    worker_start.add_argument("--dry-run", action="store_true")
    worker_start.set_defaults(func=cmd_worker_start)
    worker_harvest = worker_sub.add_parser("harvest")
    worker_harvest.add_argument("task_id")
    worker_harvest.add_argument("--keep-pane", action="store_true")
    worker_harvest.add_argument("--session-cleanup", choices=sorted(SESSION_CLEANUP_MODES))
    worker_harvest.set_defaults(func=cmd_worker_harvest)
    worker_message = worker_sub.add_parser("message")
    worker_message.add_argument("task_id")
    worker_message.add_argument("message", nargs="?")
    worker_message.add_argument("--file")
    worker_message.add_argument("--timeout-ms", type=int, default=30_000)
    worker_message.add_argument(
        "--input-settle-ms",
        type=int,
        default=DEFAULT_MANAGER_MESSAGE_INPUT_SETTLE_MS,
        help="delay between send-text visibility and Enter",
    )
    worker_message.add_argument(
        "--submit-verify-ms",
        type=int,
        default=DEFAULT_MANAGER_MESSAGE_SUBMIT_VERIFY_MS,
        help="time to wait for Codex to start working or answer after Enter",
    )
    worker_message.add_argument(
        "--submit-attempts",
        type=int,
        default=DEFAULT_MANAGER_MESSAGE_SUBMIT_ATTEMPTS,
        help="Enter retry count when the message remains typed but unsubmitted",
    )
    worker_message.set_defaults(func=cmd_worker_message)

    merge = sub.add_parser("merge", help="merge a Worker task")
    merge.add_argument("task_id")
    merge.add_argument("--mode", choices=["squash", "cherry-pick"])
    merge.add_argument("--dry-run", action="store_true")
    merge.set_defaults(func=cmd_merge)

    validate = sub.add_parser("validate", help="run integration validation")
    validate.add_argument("--command", dest="validation_command", action="append")
    validate.add_argument("--no-cleanup", action="store_true")
    validate.add_argument("--dry-run", action="store_true")
    validate.set_defaults(func=cmd_validate)

    reviewer = sub.add_parser("reviewer", help="reviewer operations")
    reviewer_sub = reviewer.add_subparsers(dest="reviewer_command", required=True)
    reviewer_start = reviewer_sub.add_parser("start")
    reviewer_start.add_argument("--review-id")
    reviewer_start.add_argument("--base")
    reviewer_start.add_argument("--head")
    reviewer_start.add_argument("--worktree")
    reviewer_start.add_argument("--manager-pane")
    reviewer_start.add_argument("--direction", choices=["right", "down"], default="down")
    reviewer_start.add_argument("--launcher", choices=["pane", "agent"], default="pane")
    reviewer_start.add_argument("--runner", choices=["exec", "tui"])
    reviewer_start.add_argument("--dry-run", action="store_true")
    reviewer_start.set_defaults(func=cmd_reviewer_start)
    reviewer_harvest = reviewer_sub.add_parser("harvest")
    reviewer_harvest.add_argument("review_id")
    reviewer_harvest.add_argument("--keep-pane", action="store_true")
    reviewer_harvest.add_argument("--session-cleanup", choices=sorted(SESSION_CLEANUP_MODES))
    reviewer_harvest.set_defaults(func=cmd_reviewer_harvest)
    reviewer_close = reviewer_sub.add_parser("close")
    reviewer_close.add_argument("review_id")
    reviewer_close.add_argument(
        "--verdict",
        choices=["passed", "accepted-risk", "fix-tasks-created", "blocked"],
        required=True,
    )
    reviewer_close.add_argument("--reason", required=True)
    reviewer_close.add_argument("--keep-pane", action="store_true")
    reviewer_close.add_argument("--session-cleanup", choices=sorted(SESSION_CLEANUP_MODES))
    reviewer_close.set_defaults(func=cmd_reviewer_close)
    reviewer_watch = reviewer_sub.add_parser("watch")
    reviewer_watch.add_argument("review_id")
    reviewer_watch.add_argument("--lines", type=int, default=120)
    reviewer_watch.add_argument(
        "--source",
        choices=["visible", "recent", "recent-unwrapped"],
        default="recent-unwrapped",
    )
    reviewer_watch.set_defaults(func=cmd_reviewer_watch)
    reviewer_message = reviewer_sub.add_parser("message")
    reviewer_message.add_argument("review_id")
    reviewer_message.add_argument("message", nargs="?")
    reviewer_message.add_argument("--file")
    reviewer_message.add_argument("--timeout-ms", type=int, default=30_000)
    reviewer_message.add_argument(
        "--input-settle-ms",
        type=int,
        default=DEFAULT_MANAGER_MESSAGE_INPUT_SETTLE_MS,
        help="delay between send-text visibility and Enter",
    )
    reviewer_message.add_argument(
        "--submit-verify-ms",
        type=int,
        default=DEFAULT_MANAGER_MESSAGE_SUBMIT_VERIFY_MS,
        help="time to wait for Codex to start working or answer after Enter",
    )
    reviewer_message.add_argument(
        "--submit-attempts",
        type=int,
        default=DEFAULT_MANAGER_MESSAGE_SUBMIT_ATTEMPTS,
        help="Enter retry count when the message remains typed but unsubmitted",
    )
    reviewer_message.set_defaults(func=cmd_reviewer_message)

    tick = sub.add_parser("tick", help="run one bounded loop tick")
    tick.add_argument("--once", action="store_true", help="document intent; tick is always bounded")
    tick.add_argument("--max-workers", type=int)
    tick.add_argument("--manager-pane")
    tick.add_argument("--direction", choices=["right", "down"], default="right")
    tick.add_argument("--launcher", choices=["pane", "agent"], default="pane")
    tick.add_argument("--worker-runner", choices=["tui", "exec"])
    tick.add_argument("--reviewer-runner", choices=["exec", "tui"])
    tick.add_argument("--keep-pane", action="store_true")
    tick.add_argument("--session-cleanup", choices=sorted(SESSION_CLEANUP_MODES))
    tick.add_argument("--review-wait-ms", type=int)
    tick.add_argument("--dry-run", action="store_true")
    tick.add_argument(
        "--stop-on-user-decision",
        action="store_true",
        help="deprecated; ticks always stop on blocking decisions",
    )
    tick.set_defaults(func=cmd_tick)

    report = sub.add_parser("report", help="write reports/FINAL.md")
    report.set_defaults(func=cmd_report)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args))
    except HLoopError as exc:
        print(f"hloop: {exc}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as exc:
        stderr = (exc.stderr or "").strip()
        stdout = (exc.stdout or "").strip()
        detail = stderr or stdout or str(exc)
        print(f"hloop: command failed: {detail}", file=sys.stderr)
        return exc.returncode or 1


if __name__ == "__main__":
    raise SystemExit(main())
