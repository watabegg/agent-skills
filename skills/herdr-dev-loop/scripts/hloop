    )
    advisor_request.add_argument("--source", action="append", help="review/gap/task/code reference for the consultation")
    advisor_request.set_defaults(func=cmd_advisor_request)
    advisor_start = advisor_sub.add_parser("start", help="start one Advisor participant")
    advisor_start.add_argument("advice_id")
    advisor_start.add_argument("--participant-id", default="P1")
    advisor_start.add_argument("--base")
    advisor_start.add_argument("--head")
    advisor_start.add_argument("--worktree")
    advisor_start.add_argument("--manager-pane")
    advisor_start.add_argument("--direction", choices=["right", "down"], default="down")
    advisor_start.add_argument("--launcher", choices=["pane", "agent"], default="pane")
    advisor_start.add_argument("--runner", choices=["exec", "tui"])
    advisor_start.add_argument("--agent-provider", choices=sorted(AGENT_PROVIDERS))
    advisor_start.add_argument("--agent-model")
    advisor_start.add_argument("--dry-run", action="store_true")
    advisor_start.set_defaults(func=cmd_advisor_start)
    advisor_harvest = advisor_sub.add_parser("harvest", help="harvest one Advisor participant artifact")
    advisor_harvest.add_argument("advice_id")
    advisor_harvest.add_argument("--participant-id", default="P1")
    advisor_harvest.add_argument("--keep-pane", action="store_true")
    advisor_harvest.add_argument("--session-cleanup", choices=sorted(SESSION_CLEANUP_MODES))
    advisor_harvest.set_defaults(func=cmd_advisor_harvest)
    advisor_close = advisor_sub.add_parser("close", help="close an Advisor consultation after Manager review")
    advisor_close.add_argument("advice_id")
    advisor_close.add_argument("--verdict", choices=sorted(ADVISOR_VERDICTS), required=True)
    advisor_close.add_argument("--reason", required=True)
    advisor_close.set_defaults(func=cmd_advisor_close)
    advisor_watch = advisor_sub.add_parser("watch")
    advisor_watch.add_argument("advice_id")
    advisor_watch.add_argument("--participant-id", default="P1")
    advisor_watch.add_argument("--lines", type=int, default=120)
    advisor_watch.add_argument(
        "--source",
        choices=["visible", "recent", "recent-unwrapped"],
        default="recent-unwrapped",
    )
    advisor_watch.set_defaults(func=cmd_advisor_watch)
    advisor_message = advisor_sub.add_parser("message")
    advisor_message.add_argument("advice_id")
    advisor_message.add_argument("message", nargs="?")
    advisor_message.add_argument("--participant-id", default="P1")
    advisor_message.add_argument("--file")
    advisor_message.add_argument("--timeout-ms", type=int, default=30_000)
    advisor_message.add_argument(
        "--input-settle-ms",
        type=int,
        default=DEFAULT_MANAGER_MESSAGE_INPUT_SETTLE_MS,
        help="delay between send-text visibility and Enter",
    )
    advisor_message.add_argument(
        "--submit-verify-ms",
        type=int,
        default=DEFAULT_MANAGER_MESSAGE_SUBMIT_VERIFY_MS,
        help="time to wait for agent to start working or answer after Enter",
    )
    advisor_message.add_argument(
        "--submit-attempts",
        type=int,
        default=DEFAULT_MANAGER_MESSAGE_SUBMIT_ATTEMPTS,
        help="Enter retry count when the message remains typed but unsubmitted",
    )
    advisor_message.add_argument(
        "--contract-changing",
        action="store_true",
        help="arm a semantic ACK barrier that blocks material work until resolved",
    )
    advisor_message.set_defaults(func=cmd_advisor_message)

    triage = sub.add_parser("triage", help="generate or create fix tasks from review/gap artifacts")
    triage_sub = triage.add_subparsers(dest="triage_command", required=True)
    triage_review = triage_sub.add_parser("review")
    triage_review.add_argument("source_id")
    triage_review.add_argument("--create-tasks", action="store_true")
    triage_review.add_argument("--allow-no-write", action="store_true")
    triage_review.add_argument("--dry-run", action="store_true")
    triage_review.set_defaults(func=cmd_triage_review)
    triage_gap = triage_sub.add_parser("gap")
    triage_gap.add_argument("source_id")
    triage_gap.add_argument("--create-tasks", action="store_true")
    triage_gap.add_argument("--allow-no-write", action="store_true")
    triage_gap.add_argument("--dry-run", action="store_true")
    triage_gap.set_defaults(func=cmd_triage_gap)

    tick = sub.add_parser("tick", help="run one bounded loop tick")
    tick.add_argument("--once", action="store_true", help="document intent; tick is always bounded")
    tick.add_argument("--max-workers", type=int)
    tick.add_argument("--manager-pane")
    tick.add_argument("--direction", choices=["right", "down"], default="right")
    tick.add_argument("--launcher", choices=["pane", "agent"], default="pane")
    tick.add_argument("--worker-runner", choices=["tui", "exec"])
    tick.add_argument("--reviewer-runner", choices=["exec", "tui"])
    tick.add_argument("--gap-runner", choices=["exec", "tui"])
    tick.add_argument("--worker-agent-provider", choices=sorted(AGENT_PROVIDERS))
    tick.add_argument("--worker-agent-model")
    tick.add_argument("--reviewer-agent-provider", choices=sorted(AGENT_PROVIDERS))
    tick.add_argument("--reviewer-agent-model")
    tick.add_argument("--gap-agent-provider", choices=sorted(AGENT_PROVIDERS))
    tick.add_argument("--gap-agent-model")
    tick.add_argument("--keep-pane", action="store_true")
    tick.add_argument("--session-cleanup", choices=sorted(SESSION_CLEANUP_MODES))
    tick.add_argument("--review-wait-ms", type=int)
    tick.add_argument("--gap-wait-ms", type=int)
    tick.add_argument("--dry-run", action="store_true")
    tick.add_argument(
        "--stop-on-user-decision",
        action="store_true",
        help="deprecated; ticks always stop on blocking decisions",
    )
    tick.set_defaults(func=cmd_tick)

    pump = sub.add_parser("pump", help="run multiple safe tick transitions until triage, blocked, done, or max transitions")
    pump.add_argument("--max-transitions", type=int, default=20)
    pump.add_argument("--max-workers", type=int)
    pump.add_argument("--manager-pane")
    pump.add_argument("--direction", choices=["right", "down"], default="right")
    pump.add_argument("--launcher", choices=["pane", "agent"], default="pane")
    pump.add_argument("--worker-runner", choices=["tui", "exec"])
    pump.add_argument("--reviewer-runner", choices=["exec", "tui"])
    pump.add_argument("--gap-runner", choices=["exec", "tui"])
    pump.add_argument("--worker-agent-provider", choices=sorted(AGENT_PROVIDERS))
    pump.add_argument("--worker-agent-model")
    pump.add_argument("--reviewer-agent-provider", choices=sorted(AGENT_PROVIDERS))
    pump.add_argument("--reviewer-agent-model")
    pump.add_argument("--gap-agent-provider", choices=sorted(AGENT_PROVIDERS))
    pump.add_argument("--gap-agent-model")
    pump.add_argument("--keep-pane", action="store_true")
    pump.add_argument("--session-cleanup", choices=sorted(SESSION_CLEANUP_MODES))
    pump.add_argument("--review-wait-ms", type=int)
    pump.add_argument("--gap-wait-ms", type=int)
    pump.add_argument("--wait", action="store_true", help="use configured review/gap wait times instead of forcing 0ms waits")
    pump.add_argument("--sleep-ms", type=int, default=DEFAULT_PUMP_SLEEP_MS)
    pump.add_argument("--dry-run", action="store_true")
    pump.add_argument("--stop-on-triage", dest="stop_on_triage", action="store_true", default=True)
    pump.add_argument("--no-stop-on-triage", dest="stop_on_triage", action="store_false")
    pump.add_argument("--stop-on-waiting", dest="stop_on_waiting", action="store_true", default=False)
    pump.add_argument("--no-stop-on-waiting", dest="stop_on_waiting", action="store_false")
    pump.set_defaults(func=cmd_pump)

    report = sub.add_parser("report", help="write reports/FINAL.md")
    report.set_defaults(func=cmd_report)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        configure_loop_namespace(getattr(args, "namespace", None))
        # Resolve/verify the trusted git executable before any code path below
        # can execute a PATH `git` -- `find_repo_root` and STATE.json reads are
        # plain filesystem operations, so no git subprocess runs before this
        # decision is made. `repo_root()` (which does exec git) always runs
        # after this point.
        global TRUSTED_GIT_PATH
        no_exec_repo = hloop_config.find_repo_root(Path(args.repo).resolve())
        TRUSTED_GIT_PATH = resolve_trusted_git_path(no_exec_repo)
        repo: Path | None = None
        if command_requires_state_schema_guard(args):
            repo = repo_root(Path(args.repo).resolve())
            # Check before taking the lock so an already-future loop remains
            # byte/resource invariant, then check again under the lock to close
            # the race with another runtime updating STATE.json.
            assert_mutating_state_schema_compatible(repo)
        if command_requires_loop_lock(args):
            repo = repo or repo_root(Path(args.repo).resolve())
            with loop_lock(repo):
                if command_requires_state_schema_guard(args):
                    assert_mutating_state_schema_compatible(repo)
                return int(args.func(args))
        return int(args.func(args))
    except HLoopError as exc:
        print(f"hloop: {exc}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as exc:
        stderr = (exc.stderr or "").strip()
        stdout = (exc.stdout or "").strip()
        detail = stderr or stdout or str(exc)
        print(f"hloop: command failed: {detail}", file=sys.stderr)
        return exc.returncode or 1


if __name__ == "__main__":
    raise SystemExit(main())
