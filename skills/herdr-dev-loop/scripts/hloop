    init.add_argument("--manager-qa-profile", choices=sorted(QA_PROFILES), default=DEFAULT_MANAGER_QA_PROFILE)
    init.add_argument(
        "--qa-profile",
        choices=sorted(QA_PROFILES),
        help="deprecated alias for --worker-qa-profile",
    )
