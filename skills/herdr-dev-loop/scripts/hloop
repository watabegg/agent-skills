GAP_ARTIFACT_STATUSES = {"aligned", "gaps-found", "blocked", "failed"}
ISSUE_SEVERITY_RANK = {"P0": 0, "P1": 1, "P2": 2, "P3": 3}
DANGEROUS_AGENT_MARKERS = (
    "danger-full-access",
    "dangerously-bypass-approvals-and-sandbox",
    "--dangerously-bypass",
    "bypass-approvals-and-sandbox",
)
SUSPICIOUS_WORKER_HEADS = {"manager-working-tree", "pending_code_commit"}
