def configure_loop_namespace(value: str | None) -> str:
    global LOOP_NAMESPACE, LOOP_DIR
    namespace = str(value or os.environ.get("HLOOP_NAMESPACE") or DEFAULT_LOOP_NAMESPACE).strip()
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,63}", namespace):
        raise HLoopError(
            "invalid loop namespace; use 1-64 lowercase letters, numbers, dot, underscore, or hyphen"
        )
    LOOP_NAMESPACE = namespace
    LOOP_DIR = LOOP_HOME / "loops" / namespace
    return namespace


def loop_namespace_flag() -> str:
    return f"--namespace {shlex.quote(LOOP_NAMESPACE)}"


def loop_display_path() -> str:
    return LOOP_DIR.as_posix()


def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


def filename_timestamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + f"-{time.time_ns()}"


def new_run_id(goal_id: str) -> str:
    return f"{filename_timestamp()}-{slugify(goal_id, 24)}"


def run_cmd(
    cmd: list[str],
    cwd: Path | None = None,
    check: bool = True,
    capture: bool = True,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        cwd=str(cwd) if cwd else None,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=check,
    )


# The absolute path of the git executable this process has verified (or
# bootstrapped) against STATE.json's recorded identity.  `main()` resolves this
# once, before any other code path can execute a PATH `git`, and every git
# invocation below reads this instead of the bare `"git"` string so a PATH
# mutation after that check cannot retarget a later call (TOCTOU).  Direct
# library/test callers that never go through `main()` keep the prior
# PATH-lookup behavior via this default.
TRUSTED_GIT_PATH = "git"


def git(repo: Path, args: list[str], check: bool = True) -> str:
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), *args], check=check)
    if proc.returncode != 0 and check:
        raise HLoopError(proc.stderr.strip())
    return (proc.stdout or "").strip()


def resolve_git_binary_fingerprint() -> dict[str, Any]:
    """Fingerprint the PATH git binary's path/device/inode/hash without executing it.

    Every field here is gathered with filesystem calls only (``shutil.which``,
    ``os.stat``, reading bytes for a hash), so this can run and be compared
    against a recorded identity *before* this process ever executes a
    PATH-resolved ``git``, closing the window a malicious PATH substitution
    would otherwise get to run in.
    """

    resolved = shutil.which("git")
    if not resolved:
        raise HLoopError("git command not found")
    real = os.path.realpath(resolved)
    stat = os.stat(real)
    digest = hashlib.sha256(Path(real).read_bytes()).hexdigest()
    return {
        "path": real,
        "st_dev": stat.st_dev,
        "st_ino": stat.st_ino,
        "sha256": digest,
    }


def git_executable_identity() -> dict[str, Any]:
    """Resolve the git binary HLoop is about to trust and fingerprint it.

    Recorded at ``init``/migration/``trust-git`` time and re-checked on every
    ``preflight_loop`` so a PATH-substituted or replaced ``git`` cannot silently
    change HLoop's trust boundary mid-run. The one intentional execution here
    (``--version``, for the human-readable record) targets the already-resolved
    absolute path, not a fresh PATH lookup.
    """

    fingerprint = resolve_git_binary_fingerprint()
    version_proc = run_cmd([fingerprint["path"], "--version"], check=False, capture=True)
    return {
        **fingerprint,
        "version": (version_proc.stdout or "").strip(),
        "recorded_at": now_iso(),
    }


def resolve_trusted_git_path(repo: Path | None) -> str:
    """Verify the PATH git binary against any recorded identity, with no exec.

    Called once at the very top of ``main()``, before ``repo_root()`` or any
    other code path executes a git subprocess. ``repo`` is located by a plain
    filesystem walk (see ``hloop_config.find_repo_root``), and STATE.json is
    read directly, so no git invocation happens before this decision is made.
    Raises before anything is trusted if a recorded identity does not match.
    """

    fingerprint = resolve_git_binary_fingerprint()
    if repo is not None:
        state_path = repo / LOOP_DIR / "STATE.json"
        if state_path.exists():
            try:
                state = json.loads(state_path.read_text(encoding="utf-8"))
            except (OSError, UnicodeDecodeError, json.JSONDecodeError):
                state = None
            recorded = state.get("git_identity") if isinstance(state, dict) else None
            if isinstance(recorded, dict) and recorded:
                drift = git_identity_drift(recorded, fingerprint)
                if drift:
                    raise HLoopError(
                        "git executable identity drift detected: "
                        f"{drift}; run `hloop runtime trust-git --reason <text>` to accept it"
                    )
    return fingerprint["path"]


def git_identity_drift(recorded: dict[str, Any], current: dict[str, Any]) -> str:
    """Return a human-readable drift description, or an empty string if trusted."""

    mismatches = [
        f"{field}: recorded={recorded.get(field)!r} current={current.get(field)!r}"
        for field in ("path", "st_dev", "st_ino", "sha256")
        if recorded.get(field) != current.get(field)
    ]
    return "; ".join(mismatches)


def command_error_detail(exc: BaseException) -> str:
    if isinstance(exc, subprocess.CalledProcessError):
        stderr = (exc.stderr or "").strip()
        stdout = (exc.stdout or "").strip()
        return stderr or stdout or str(exc)
    return str(exc)


def is_environment_git_error(detail: str) -> bool:
    lower = detail.lower()
    needles = [
        "read-only file system",
        "permission denied",
        "unable to create",
        "cannot lock",
        ".lock",
        "index.lock",
        "orig_head.lock",
        "would be overwritten by merge",
        "no space left on device",
        "input/output error",
    ]
    return any(needle in lower for needle in needles)


def repo_root(path: Path) -> Path:
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(path), "rev-parse", "--show-toplevel"], check=False)
    if proc.returncode != 0:
        raise HLoopError(f"not inside a git repository: {path}")
    return Path(proc.stdout.strip()).resolve()


def loop_path(repo: Path) -> Path:
    return repo / LOOP_DIR


def experience_path(repo: Path) -> Path:
    return repo / EXPERIENCE_DIR / "worktree-setup.json"


def load_worktree_experience(repo: Path) -> dict[str, Any]:
    path = experience_path(repo)
    if not path.exists():
        return {"schema_version": 1, "recommended_commands": [], "runs": []}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise HLoopError(f"invalid worktree setup experience: {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise HLoopError(f"worktree setup experience must be a JSON object: {path}")
    data.setdefault("schema_version", 1)
    data.setdefault("recommended_commands", [])
    data.setdefault("runs", [])
    return data


def save_worktree_experience(repo: Path, data: dict[str, Any]) -> None:
    runs = data.get("runs", [])
    if isinstance(runs, list) and len(runs) > 200:
        data["runs"] = runs[-200:]
    write_text(experience_path(repo), json.dumps(data, ensure_ascii=False, indent=2) + "\n")


def state_persistence(state: dict[str, Any]) -> str:
    value = str(state.get("persistence") or "branch-history")
    return value if value in {"local-only", "branch-history"} else "branch-history"


def setup_commands_for_role(state: dict[str, Any], role: str) -> list[str]:
    role_key = f"{role_state_prefix(role)}_setup_commands"
    if role_key in state:
        return normalize_list(state.get(role_key))
    # 0.3 compatibility: the old shared setup contract becomes Worker-only.
    return normalize_list(state.get("worktree_setup_commands")) if role == "worker" else []


def unsafe_setup_command(command: str) -> str:
    lowered = command.lower()
    markers = (
        ".claude",
        ".codex",
        "claude.md",
        "agents.md",
        "bypasspermissions",
        "dangerously-skip-permissions",
        "dangerously-bypass",
        "permission-mode",
    )
    return next((marker for marker in markers if marker in lowered), "")


def storage_paths(repo: Path, state: dict[str, Any]) -> list[Path]:
    candidates = [repo, Path(os.environ.get("TMPDIR") or "/tmp")]
    raw_root = str(state.get("worktree_root") or "")
    if raw_root:
        candidates.append(Path(raw_root))
    result: list[Path] = []
    for candidate in candidates:
        path = candidate.resolve()
        while not path.exists() and path != path.parent:
            path = path.parent
        if path.exists() and path not in result:
            result.append(path)
    return result


def storage_preflight(repo: Path, state: dict[str, Any]) -> list[dict[str, Any]]:
    required_bytes = normalize_int(state.get("min_free_bytes"), DEFAULT_MIN_FREE_BYTES)
    required_inodes = normalize_int(state.get("min_free_inodes"), DEFAULT_MIN_FREE_INODES)
    snapshots: list[dict[str, Any]] = []
    seen_devices: set[int] = set()
    for path in storage_paths(repo, state):
        stats = os.statvfs(path)
        device = path.stat().st_dev
        if device in seen_devices:
            continue
        seen_devices.add(device)
        free_bytes = stats.f_bavail * stats.f_frsize
        free_inodes = stats.f_favail
        item = {
            "path": str(path),
            "device": device,
            "free_bytes": free_bytes,
            "free_inodes": free_inodes,
            "required_bytes": required_bytes,
            "required_inodes": required_inodes,
        }
        snapshots.append(item)
        if required_bytes and free_bytes < required_bytes:
            raise HLoopError(
                f"disk preflight failed for {path}: free bytes {free_bytes} < {required_bytes}"
            )
        if required_inodes and free_inodes < required_inodes:
            raise HLoopError(
                f"disk preflight failed for {path}: free inodes {free_inodes} < {required_inodes}"
            )
        probe = path / f".hloop-write-probe-{os.getpid()}-{time.time_ns()}"
        try:
            with probe.open("wb") as fh:
                fh.write(b"hloop\n")
                fh.flush()
                os.fsync(fh.fileno())
        except OSError as exc:
            raise HLoopError(f"disk write probe failed for {path}: {exc}") from exc
        finally:
            try:
                probe.unlink()
            except FileNotFoundError:
                pass
    return snapshots


def ensure_local_only_git_excludes(repo: Path) -> None:
    git_common = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "rev-parse", "--git-common-dir"], check=False
    )
    if git_common.returncode != 0:
        raise HLoopError((git_common.stderr or git_common.stdout or "cannot resolve git common dir").strip())
    common = Path((git_common.stdout or "").strip())
    if not common.is_absolute():
        common = (repo / common).resolve()
    exclude = common / "info" / "exclude"
    exclude.parent.mkdir(parents=True, exist_ok=True)
    existing = exclude.read_text(encoding="utf-8") if exclude.exists() else ""
    additions = [
        pattern
        for pattern in (
            f"/{LOOP_DIR.as_posix()}/",
            f"/{(LOOP_ARCHIVE_ROOT / LOOP_NAMESPACE).as_posix()}/",
            f"/{EXPERIENCE_DIR.as_posix()}/",
            f"/{LEGACY_LOOP_DIR.as_posix()}/",
        )
        if pattern not in {line.strip() for line in existing.splitlines()}
    ]
    if additions:
        prefix = "" if not existing or existing.endswith("\n") else "\n"
        with exclude.open("a", encoding="utf-8") as fh:
            fh.write(prefix + "\n".join(additions) + "\n")


def copy_local_loop_snapshot(repo: Path, worktree: Path, state: dict[str, Any]) -> None:
    if state_persistence(state) != "local-only":
        return
    source = loop_path(repo)
    target = loop_path(worktree)
    if not source.exists():
        raise HLoopError(f"local-only loop snapshot is missing: {source}")
    shutil.copytree(source, target, dirs_exist_ok=True, ignore=shutil.ignore_patterns("prompts"))


def run_worktree_setup_commands(
    repo: Path,
    worktree: Path,
    state: dict[str, Any],
    *,
    role: str,
    agent_id: str,
) -> None:
    commands = setup_commands_for_role(state, role)
    if not commands:
        return
    experience = load_worktree_experience(repo)
    for command in commands:
        marker = unsafe_setup_command(command)
        if marker:
            raise HLoopError(
                f"unsafe worktree setup command for {role} {agent_id}: contains `{marker}`"
            )
        started = time.monotonic()
        proc = run_cmd(["bash", "-lc", command], cwd=worktree, check=False)
        record = {
            "at": now_iso(),
            "namespace": LOOP_NAMESPACE,
            "role": role,
            "agent_id": agent_id,
            "command": command,
            "outcome": "passed" if proc.returncode == 0 else "failed",
            "returncode": proc.returncode,
            "duration_ms": int((time.monotonic() - started) * 1000),
        }
        experience.setdefault("runs", []).append(record)
        save_worktree_experience(repo, experience)
        if proc.returncode != 0:
            raise HLoopError(
                f"worktree setup failed for {role} {agent_id}: {command}: "
                + ((proc.stderr or proc.stdout or f"exit {proc.returncode}").strip())
            )


def cmd_experience_show(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    data = load_worktree_experience(repo)
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        print(f"experience: {experience_path(repo)}")
        for command in normalize_list(data.get("recommended_commands")):
            print(f"recommended: {command}")
        for item in data.get("runs", [])[-10:]:
            print(
                f"{item.get('at')} {item.get('outcome')} {item.get('role')}/{item.get('agent_id')}: "
                f"{item.get('command')}"
            )
    return 0


def cmd_experience_recommend(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    data = load_worktree_experience(repo)
    commands = normalize_list(data.get("recommended_commands"))
    if args.remove:
        commands = [item for item in commands if item != args.command]
    elif args.command not in commands:
        commands.append(args.command)
    data["recommended_commands"] = commands
    data["updated_at"] = now_iso()
    save_worktree_experience(repo, data)
    print(f"recommended worktree setup commands: {len(commands)}")
    return 0


def cmd_namespace_list(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    root = repo / LOOP_HOME / "loops"
    items = []
    if root.exists():
        for path in sorted(root.iterdir()):
            if not path.is_dir():
                continue
            state_file = path / "STATE.json"
            state: dict[str, Any] = {}
            if state_file.exists():
                try:
                    parsed = json.loads(state_file.read_text(encoding="utf-8"))
                    if isinstance(parsed, dict):
                        state = parsed
                except (OSError, json.JSONDecodeError):
                    pass
            items.append(
                {
                    "namespace": path.name,
                    "path": str(path),
                    "goal_id": state.get("goal_id", ""),
                    "run_id": state.get("run_id", ""),
                    "phase": state.get("phase", "unknown"),
                    "skill_version": state.get("skill_version", "unversioned"),
                }
            )
    legacy_ignored = (repo / LEGACY_LOOP_DIR).exists()
    if args.json:
        print(
            json.dumps(
                {"selected_namespace": LOOP_NAMESPACE, "namespaces": items, "legacy_loop_ignored": legacy_ignored},
                ensure_ascii=False,
                indent=2,
            )
        )
    elif not items:
        print("no namespaced loops")
    else:
        for item in items:
            marker = "*" if item["namespace"] == LOOP_NAMESPACE else " "
            print(
                f"{marker} {item['namespace']}: phase={item['phase']} goal={item['goal_id'] or '-'} "
                f"version={item['skill_version']}"
            )
    if legacy_ignored and not args.json:
        print(f"legacy ignored: {LEGACY_LOOP_DIR.as_posix()}")
    return 0


def assert_migration_safe(repo: Path, state: dict[str, Any]) -> None:
    running = running_agent_ids(state)
    if running:
        raise HLoopError(
            "cannot migrate while role agents are running; abort them first: " + ", ".join(running)
        )
    if state.get("active_merge"):
        raise HLoopError("cannot migrate while a merge transaction is active")
    for role_kind, role_id, role_state in iter_all_roles(state):
        worktree_raw = str(role_state.get("worktree") or "")
        if worktree_raw and Path(worktree_raw).exists() and product_dirty_paths_for_agent(Path(worktree_raw)):
            raise HLoopError(f"cannot migrate dirty role worktree: {role_kind} {role_id}")


def migrate_format_one_to_two(state: dict[str, Any]) -> dict[str, Any]:
    result = json.loads(json.dumps(state))
    result["migrated_from_skill_version"] = str(state.get("skill_version") or "unversioned")
    result.setdefault("worker_setup_commands", normalize_list(state.get("worktree_setup_commands")))
    result.setdefault("reviewer_setup_commands", [])
    result.setdefault("gap_setup_commands", [])
    result.setdefault("advisor_setup_commands", [])
    result.setdefault("min_free_bytes", DEFAULT_MIN_FREE_BYTES)
    result.setdefault("min_free_inodes", DEFAULT_MIN_FREE_INODES)
    for prefix in ("worker", "reviewer", "gap", "advisor"):
        result.setdefault(f"{prefix}_agent_effort", DEFAULT_AGENT_EFFORT)
        result.setdefault(f"{prefix}_claude_permission_mode", DEFAULT_CLAUDE_PERMISSION_MODE)
    for task in result.get("tasks", {}).values():
        task.setdefault("attempt_no", 0)
        task.setdefault("attempts", [])
        if task.get("base_sha"):
            task.setdefault("worker_base_sha", task.get("base_sha"))
        if task.get("status") == "queued":
            task["skill_version"] = SKILL_VERSION
    result["needs_validation"] = bool(result.get("tasks"))
    result["needs_review"] = bool(result.get("reviews"))
    result["needs_gap_check"] = bool(result.get("gaps"))
    result["manager_qa_status"] = (
        "not-required" if state_manager_qa_profile(result) == "none" else "pending"
    )
    result["phase"] = "dispatching"
    return result


def migrate_format_two_to_three(state: dict[str, Any]) -> dict[str, Any]:
    result = json.loads(json.dumps(state))
    resolved_snapshot = json.loads(json.dumps(BUILT_IN_CONFIG_DEFAULTS))
    for key in ("max_workers", "session_cleanup", "specification_scout"):
        if key in state:
            resolved_snapshot[key] = state[key]
    for role in ("worker", "reviewer"):
        for key in ("provider", "model", "effort"):
            state_key = f"{role}_agent_{key}"
            if state_key in state:
                resolved_snapshot[role][key] = state[state_key]
    result.setdefault(
        "config_source",
        {"kind": "state-migration", "path": ""},
    )
    result.setdefault("resolved_config", resolved_snapshot)
    result.setdefault("manager_qa_evidence_path", (LOOP_DIR / "qa" / "FINAL.md").as_posix())
    result.setdefault(
        "artifact_policy",
        {
            "role_active": "role-worktree",
            "role_harvested": "manager-loop",
            "inputs": "local-only",
            "inbox": "local-only",
            "broker": "local-only",
        },
    )
    result.setdefault("final_gate", None)
    result.setdefault("resume_requirements", [])
    result.setdefault("pending_fix_task_drafts", [])
    result.setdefault("terminal_outcome", {})
    result.setdefault("specification_scout", DEFAULT_SPECIFICATION_SCOUT)
    if "specification_scout_run" not in result:
        already_dispatched = any(
            str(task.get("status") or "") != "queued"
            for task in (result.get("tasks") or {}).values()
            if isinstance(task, dict)
        )
        result["specification_scout_run"] = (
            {
                "status": "skipped",
                "gate_status": "skipped",
                "policy": result["specification_scout"],
                "reason": "migrated loop had already dispatched implementation work",
            }
            if already_dispatched
            else {}
        )
    result.setdefault("decision_liaisons", {})
    canonicalize_migrated_artifact_records(result)
    return result


def canonicalize_migrated_artifact_records(state: dict[str, Any]) -> None:
    """Rewrite harvested 0.4 artifact records to Manager-loop paths.

    Older states could retain a detached role-worktree path after harvest.
    Migration has no repository argument, so it records stable repo-relative
    paths; ``recorded_path`` resolves those against the active Manager repo.
    The original role path remains available as ``worktree_*_path_harvested``
    for diagnostics.
    """

    for task_id, task in (state.get("tasks") or {}).items():
        if not isinstance(task, dict):
            continue
        old_path = str(task.get("result_path") or "")
        if not old_path and str(task.get("status") or "") not in {
            "result_reported",
            "merged",
            "partial",
            "blocked",
            "failed",
            "abandoned",
        }:
            continue
        canonical = (LOOP_DIR / "results" / str(task_id) / "result.md").as_posix()
        if old_path and old_path != canonical:
            task.setdefault("worktree_result_path_harvested", old_path)
        task["result_path"] = canonical

    for review_id, review in (state.get("reviews") or {}).items():
        if not isinstance(review, dict) or not artifact_was_harvested(review):
            continue
        old_path = str(review.get("review_path") or "")
        canonical = (
            LOOP_DIR / "reviews" / str(review_id) / "FINAL.md"
            if str(review.get("mode") or "single") != "single"
            else LOOP_DIR / "reviews" / f"{review_id}.md"
        ).as_posix()
        if old_path and old_path != canonical:
            review.setdefault("worktree_review_path_harvested", old_path)
        review["review_path"] = canonical

    for gap_id, gap in (state.get("gaps") or {}).items():
        if not isinstance(gap, dict) or not artifact_was_harvested(gap):
            continue
        old_path = str(gap.get("gap_path") or "")
        canonical = (LOOP_DIR / "gaps" / f"{gap_id}.md").as_posix()
        if old_path and old_path != canonical:
            gap.setdefault("worktree_gap_path_harvested", old_path)
        gap["gap_path"] = canonical

    for advice_id, advice in (state.get("advice") or {}).items():
        if not isinstance(advice, dict):
            continue
        for participant in advice.get("participants") or []:
            if not isinstance(participant, dict) or not artifact_was_harvested(participant):
                continue
            participant_id = str(participant.get("participant_id") or "P1")
            old_path = str(participant.get("advice_path") or "")
            canonical = (
                LOOP_DIR / "advice" / f"{advice_id}-{participant_id}.md"
            ).as_posix()
            if old_path and old_path != canonical:
                participant.setdefault("worktree_advice_path_harvested", old_path)
            participant["advice_path"] = canonical


def migrate_format_three_revision_one(state: dict[str, Any]) -> dict[str, Any]:
    result = json.loads(json.dumps(state))
    result.setdefault("attempt_history", [])
    result.setdefault("cleanup_history", [])
    result.setdefault("lifecycle_diagnostics", [])
    return result


RUNTIME_MIGRATION_STEPS = (
    MigrationStep(
        SchemaVersion(1, 0),
        SchemaVersion(2, 0),
        "format-1-to-2",
        migrate_format_one_to_two,
    ),
    MigrationStep(
        SchemaVersion(2, 0),
        SchemaVersion(3, 0),
        "format-2-to-3",
        migrate_format_two_to_three,
    ),
    MigrationStep(
        SchemaVersion(3, 0),
        SchemaVersion(3, 1),
        "format-3-revision-1",
        migrate_format_three_revision_one,
    ),
)


def migrated_runtime_state(repo: Path, state: dict[str, Any]) -> tuple[dict[str, Any], tuple[str, ...]]:
    assert_migration_safe(repo, state)
    try:
        migration = migrate_schema(
            state,
            target=RUNTIME_SCHEMA_VERSION,
            steps=RUNTIME_MIGRATION_STEPS,
        )
    except MigrationError as exc:
        raise HLoopError(str(exc)) from exc
    result = dict(migration.state)
    result["skill_version"] = SKILL_VERSION
    return result, migration.applied_steps


def migrated_state(repo: Path, state: dict[str, Any]) -> dict[str, Any]:
    """Compatibility adapter for 0.4 callers that passed unversioned state.

    The CLI migration always advances through the full runtime chain.  The
    imported helper historically upgraded an unversioned mapping to format 2,
    so that one-step behavior remains available to 0.4 characterization tests.
    """

    if "state_format_version" not in state:
        assert_migration_safe(repo, state)
        result = migrate_format_one_to_two(state)
        result["state_format_version"] = LEGACY_STATE_FORMAT_VERSION
        result["skill_version"] = SKILL_VERSION
        return result
    return migrated_runtime_state(repo, state)[0]


def cmd_migrate(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    updated, applied_steps = migrated_runtime_state(repo, state)
    source_version = schema_version_of(state)
    target_version = schema_version_of(updated)
    if not args.apply:
        print(
            json.dumps(
                {
                    "from_format": source_version.format_version,
                    "from_revision": source_version.revision,
                    "to_format": target_version.format_version,
                    "to_revision": target_version.revision,
                    "applied_steps": list(applied_steps),
                    "from_skill_version": state.get("skill_version", "unversioned"),
                    "to_skill_version": updated.get("skill_version"),
                    "run_id_preserved": state.get("run_id") == updated.get("run_id"),
                },
                ensure_ascii=False,
                indent=2,
            )
        )
        return 0
    backup = (
        loop_path(repo)
        / "migration"
        / f"STATE.v{source_version.format_version}.r{source_version.revision}.{filename_timestamp()}.json"
    )
    write_text(backup, json.dumps(state, ensure_ascii=False, indent=2) + "\n")
    save_state(repo, updated)
    journal(
        repo,
        f"Migrated state to format `{STATE_FORMAT_VERSION}` revision `{STATE_SCHEMA_REVISION}` "
        f"with backup `{backup.relative_to(repo)}`.",
    )
    print(
        f"migrated state to format {STATE_FORMAT_VERSION} revision {STATE_SCHEMA_REVISION}; "
        f"backup: {backup}"
    )
    return 0


def config_candidates_payload() -> tuple[list[hloop_config.ConfigCandidate], hloop_config.ConfigCandidate | None]:
    try:
        hloop_config.check_python_capability()
        candidates = hloop_config.discover_config_candidates()
        selected = hloop_config.find_config_file()
    except hloop_config.ConfigError as exc:
        raise HLoopError(str(exc)) from exc
    return candidates, selected


def cmd_config_path(args: argparse.Namespace) -> int:
    candidates, selected = config_candidates_payload()
    payload = {
        "selected": str(selected.path) if selected else None,
        "selected_source": selected.source if selected else None,
        "default_target": str(candidates[0].path),
        "candidates": [
            {"source": item.source, "path": str(item.path), "exists": item.path.is_file()}
            for item in candidates
        ],
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif selected:
        print(selected.path)
    else:
        print(f"no config file; default target: {candidates[0].path}")
    return 0


def selected_config_path(explicit: str | None = None) -> Path | None:
    if explicit:
        return hloop_config.canonicalize_path(explicit)
    _, selected = config_candidates_payload()
    return selected.path if selected else None


def validate_config_semantics(data: dict[str, Any]) -> None:
    errors: list[str] = []
    if data.get("version") != 1:
        errors.append("config.version must be 1")
    forbidden_key_fragments = ("token", "secret", "password", "credential", "api_key", "command")

    def validate_table(label: str, table: Any) -> None:
        if not isinstance(table, dict):
            return
        for key in table:
            normalized = str(key).lower()
            if any(fragment in normalized for fragment in forbidden_key_fragments):
                errors.append(f"{label}.{key} is not allowed in config.toml")
        max_workers = table.get("max_workers")
        if max_workers is not None and (
            isinstance(max_workers, bool) or not isinstance(max_workers, int) or max_workers < 1
        ):
            errors.append(f"{label}.max_workers must be a positive integer")
        cleanup = table.get("session_cleanup")
        if cleanup is not None and cleanup not in SESSION_CLEANUP_MODES:
            errors.append(
                f"{label}.session_cleanup must be one of {sorted(SESSION_CLEANUP_MODES)}"
            )
        scout_policy = table.get("specification_scout")
        if scout_policy is not None and scout_policy not in SPECIFICATION_SCOUT_MODES:
            errors.append(
                f"{label}.specification_scout must be one of "
                f"{sorted(SPECIFICATION_SCOUT_MODES)}"
            )
        for role in ("worker", "reviewer"):
            role_table = table.get(role)
            if not isinstance(role_table, dict):
                continue
            provider = role_table.get("provider")
            if provider is not None and provider not in AGENT_PROVIDERS:
                errors.append(f"{label}.{role}.provider must be one of {sorted(AGENT_PROVIDERS)}")
            providers = role_table.get("providers")
            if providers is not None and any(item not in AGENT_PROVIDERS for item in providers):
                errors.append(f"{label}.{role}.providers contains an unsupported provider")
            for key in ("model", "effort", "mode"):
                value = role_table.get(key)
                if isinstance(value, str) and ("\n" in value or "\x00" in value):
                    errors.append(f"{label}.{role}.{key} must be a single safe line")
            for key in role_table:
                normalized = str(key).lower()
                if any(fragment in normalized for fragment in forbidden_key_fragments):
                    errors.append(f"{label}.{role}.{key} is not allowed in config.toml")

    validate_table("defaults", data.get("defaults"))
    for index, scope in enumerate(data.get("scope") or []):
        validate_table(f"scope[{index}]", scope)
    if errors:
        raise HLoopError("invalid config: " + "; ".join(errors))


def cmd_config_validate(args: argparse.Namespace) -> int:
    path = selected_config_path(getattr(args, "path", None))
    if path is None:
        payload = {"ok": True, "path": None, "source": "built-in-default"}
    else:
        try:
            data = hloop_config.load_config_file(path)
            hloop_config.validate_config(data, base=path.parent)
            validate_config_semantics(data)
        except hloop_config.ConfigError as exc:
            raise HLoopError(str(exc)) from exc
        payload = {"ok": True, "path": str(path), "source": "config.toml"}
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif path is None:
        print("config valid: built-in defaults (no config file)")
    else:
        print(f"config valid: {path}")
    return 0


def cmd_config_explain(args: argparse.Namespace) -> int:
    target = hloop_config.canonicalize_path(
        getattr(args, "config_repo", None) or args.repo
    )
    try:
        selected = hloop_config.find_config_file()
        if selected is not None:
            validate_config_semantics(hloop_config.load_config_file(selected.path))
        resolution, selected = hloop_config.load_and_resolve(
            BUILT_IN_CONFIG_DEFAULTS,
            target_dir=target,
        )
    except hloop_config.ConfigError as exc:
        raise HLoopError(str(exc)) from exc
    payload = {
        "target": str(target),
        "repo_root": str(hloop_config.find_repo_root(target) or ""),
        "config_path": str(selected.path) if selected else None,
        "config_source": selected.source if selected else "built-in-default",
        "resolved": resolution.as_dict(),
        "values": resolution.explain(),
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(f"target: {payload['target']}")
        print(f"repo_root: {payload['repo_root'] or '-'}")
        print(f"config: {payload['config_path'] or 'built-in defaults'}")
        for row in payload["values"]:
            print(f"{row['key']} = {json.dumps(row['value'], ensure_ascii=False)} ({row['source']})")
    return 0


def cmd_config_init(args: argparse.Namespace) -> int:
    candidates, _ = config_candidates_payload()
    path = selected_config_path(getattr(args, "path", None)) or candidates[0].path
    if path.exists() and not args.force:
        raise HLoopError(f"config file already exists: {path}; use --force to replace it")
    write_text(path, CONFIG_TEMPLATE)
    if args.json:
        print(json.dumps({"created": str(path)}, ensure_ascii=False, indent=2))
    else:
        print(f"created config: {path}")
    return 0


def flattened_mapping(value: dict[str, Any], prefix: tuple[str, ...] = ()) -> dict[str, Any]:
    """Return dotted config leaves for stable apply previews."""

    leaves: dict[str, Any] = {}
    for key, item in value.items():
        path = (*prefix, str(key))
        if isinstance(item, dict):
            leaves.update(flattened_mapping(item, path))
        else:
            leaves[".".join(path)] = item
    return leaves


def config_apply_changes(
    previous: dict[str, Any], resolved: dict[str, Any]
) -> list[dict[str, Any]]:
    """Describe config snapshot changes without mutating either mapping."""

    before = flattened_mapping(previous)
    after = flattened_mapping(resolved)
    return [
        {"key": key, "before": before.get(key), "after": after.get(key)}
        for key in sorted(set(before) | set(after))
        if before.get(key) != after.get(key)
    ]


def apply_resolved_config_to_state(
    state: dict[str, Any],
    resolved: dict[str, Any],
    candidate: hloop_config.ConfigCandidate | None,
) -> None:
    """Replace the explicit loop snapshot and its runtime-facing leaves."""

    state["config_source"] = {
        "kind": candidate.source if candidate else "built-in-default",
        "path": str(candidate.path) if candidate else "",
    }
    state["resolved_config"] = resolved
    state["max_workers"] = resolved["max_workers"]
    state["session_cleanup"] = resolved["session_cleanup"]
    state["specification_scout"] = str(
        resolved.get("specification_scout") or DEFAULT_SPECIFICATION_SCOUT
    )
    for role in ("worker", "reviewer"):
        role_config = resolved.get(role) or {}
        state[f"{role}_agent_provider"] = normalize_agent_provider(
            role_config.get("provider")
        )
        state[f"{role}_agent_model"] = normalize_agent_model(role_config.get("model"))
        state[f"{role}_agent_effort"] = normalize_agent_effort(
            role_config.get("effort")
        )


def cmd_config_apply(args: argparse.Namespace) -> int:
    """Preview or explicitly apply a newly resolved config to an idle loop."""

    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    try:
        candidate = hloop_config.find_config_file()
        if candidate is not None:
            data = hloop_config.load_config_file(candidate.path)
            hloop_config.validate_config(data, base=candidate.path.parent)
            validate_config_semantics(data)
        resolution, candidate = hloop_config.load_and_resolve(
            BUILT_IN_CONFIG_DEFAULTS,
            target_dir=repo,
        )
    except hloop_config.ConfigError as exc:
        raise HLoopError(str(exc)) from exc

    resolved = resolution.as_dict()
    changes = config_apply_changes(state.get("resolved_config") or {}, resolved)
    next_source = {
        "kind": candidate.source if candidate else "built-in-default",
        "path": str(candidate.path) if candidate else "",
    }
    source_changed = state.get("config_source") != next_source
    payload = {
        "mode": "apply" if args.apply else "dry-run",
        "config_path": str(candidate.path) if candidate else None,
        "config_source": candidate.source if candidate else "built-in-default",
        "changes": changes,
        "source_changed": source_changed,
        "changed": bool(changes) or source_changed,
    }
    if not args.apply:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0

    active_roles = running_agent_ids(state)
    if active_roles:
        raise HLoopError(
            "cannot apply config while roles are running: " + ", ".join(active_roles)
        )
    if state.get("active_merge"):
        raise HLoopError("cannot apply config while a merge transaction is active")
    if str(state.get("phase") or "") in RUN_TERMINAL_PHASES:
        raise HLoopError(f"cannot apply config to a terminal run: {state.get('phase')}")
    if changes or source_changed:
        apply_resolved_config_to_state(state, resolved, candidate)
        state["config_applied_at"] = now_iso()
        save_state(repo, state)
        journal(
            repo,
            "Applied resolved config snapshot: "
            + (", ".join(item["key"] for item in changes) or "config_source"),
        )
    payload["applied"] = bool(changes) or source_changed
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


def init_config_override(args: argparse.Namespace) -> dict[str, Any]:
    override: dict[str, Any] = {}
    if getattr(args, "max_workers", None) is not None:
        override["max_workers"] = args.max_workers
    if getattr(args, "session_cleanup", None) is not None:
        override["session_cleanup"] = args.session_cleanup
    if getattr(args, "specification_scout", None) is not None:
        override["specification_scout"] = args.specification_scout
    for role in ("worker", "reviewer"):
        role_values: dict[str, Any] = {}
        for key in ("provider", "model", "effort"):
            value = getattr(args, f"{role}_agent_{key}", None)
            if value is not None:
                role_values[key] = value
        if role_values:
            override[role] = role_values
    return override


def resolve_init_config(
    args: argparse.Namespace, repo: Path
) -> tuple[hloop_config.ConfigResolution, hloop_config.ConfigCandidate | None]:
    try:
        selected = hloop_config.find_config_file()
        if selected is not None:
            validate_config_semantics(hloop_config.load_config_file(selected.path))
        resolution, selected = hloop_config.load_and_resolve(
            BUILT_IN_CONFIG_DEFAULTS,
            target_dir=repo,
            start_override=init_config_override(args),
        )
    except hloop_config.ConfigError as exc:
        raise HLoopError(str(exc)) from exc
    max_workers = resolution.get("max_workers")
    if isinstance(max_workers, bool) or not isinstance(max_workers, int) or max_workers < 1:
        raise HLoopError("resolved config max_workers must be a positive integer")
    session_cleanup = str(resolution.get("session_cleanup") or "")
    if session_cleanup not in SESSION_CLEANUP_MODES:
        raise HLoopError(
            "resolved config session_cleanup must be one of: "
            + ", ".join(sorted(SESSION_CLEANUP_MODES))
        )
    specification_scout = str(
        resolution.get("specification_scout") or DEFAULT_SPECIFICATION_SCOUT
    )
    if specification_scout not in SPECIFICATION_SCOUT_MODES:
        raise HLoopError(
            "resolved config specification_scout must be one of: "
            + ", ".join(sorted(SPECIFICATION_SCOUT_MODES))
        )
    args.max_workers = max_workers
    args.session_cleanup = session_cleanup
    args.specification_scout = specification_scout
    for role in ("worker", "reviewer"):
        setattr(
            args,
            f"{role}_agent_provider",
            normalize_agent_provider(resolution.get(role, "provider")),
        )
        setattr(
            args,
            f"{role}_agent_model",
            normalize_agent_model(resolution.get(role, "model")),
        )
        setattr(
            args,
            f"{role}_agent_effort",
            str(resolution.get(role, "effort") or DEFAULT_AGENT_EFFORT),
        )
    return resolution, selected


def _private_runtime_directory(path: Path) -> Path:
    """Create or repair one current-user-only HLoop runtime directory."""

    try:
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
        metadata = path.lstat()
    except OSError as exc:
        raise HLoopError(f"cannot prepare HLoop runtime directory {path}: {exc}") from exc
    if path.is_symlink() or not stat.S_ISDIR(metadata.st_mode):
        raise HLoopError(f"HLoop runtime directory must be a real directory: {path}")
    if metadata.st_uid != os.geteuid():
        raise HLoopError(f"HLoop runtime directory must be owned by the current user: {path}")
    try:
        path.chmod(0o700)
        metadata = path.lstat()
    except OSError as exc:
        raise HLoopError(f"cannot secure HLoop runtime directory {path}: {exc}") from exc
    if stat.S_IMODE(metadata.st_mode) != 0o700:
        raise HLoopError(f"HLoop runtime directory must have mode 0700: {path}")
    return path


def repo_lock_path(repo: Path) -> Path:
    """Return one private cross-worktree lock path for this repo/namespace."""

    uid = os.geteuid()
    runtime_root = _private_runtime_directory(
        REPOSITORY_LOCK_RUNTIME_BASE / f"herdr-dev-loop-{uid}"
    )
    lock_directory = _private_runtime_directory(runtime_root / "locks")
    identity = f"{git_common_dir(repo)}\0{LOOP_NAMESPACE}".encode("utf-8")
    digest = hashlib.sha256(identity).hexdigest()
    return lock_directory / f"{digest}.lock"


def state_path(repo: Path) -> Path:
    return loop_path(repo) / "STATE.json"


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except FileNotFoundError as exc:
        raise HLoopError(f"missing file: {path}") from exc


def fsync_directory(path: Path) -> None:
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
    descriptor = os.open(path, flags)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def write_text(path: Path, text: str, *, durable: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        with tmp.open("w", encoding="utf-8") as stream:
            stream.write(text)
            if durable:
                stream.flush()
                os.fsync(stream.fileno())
        os.replace(tmp, path)
        if durable:
            fsync_directory(path.parent)
    except BaseException:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass
        raise


def ensure_worktree_parent_dirs(worktree: Path, *relative_paths: Path) -> None:
    for relative_path in relative_paths:
        (worktree / relative_path).parent.mkdir(parents=True, exist_ok=True)


def append_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(text)


@contextmanager
def loop_lock(repo: Path):
    lock_path = repo_lock_path(repo)
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(lock_path, flags, 0o600)
    except OSError as exc:
        raise HLoopError(f"cannot open HLoop repository lock {lock_path}: {exc}") from exc
    locked = False
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid():
            raise HLoopError("HLoop repository lock must be a regular file owned by the current user")
        os.fchmod(descriptor, 0o600)
        if stat.S_IMODE(os.fstat(descriptor).st_mode) != 0o600:
            raise HLoopError("HLoop repository lock must have mode 0600")
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        locked = True
        try:
            retire_legacy_loop_lock(repo)
            yield
        finally:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
            locked = False
    finally:
        if locked:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def retire_legacy_loop_lock(repo: Path) -> None:
    """Best-effort cleanup for the old worktree-visible namespaced LOCK file."""
    legacy = loop_path(repo) / "LOCK"
    if not legacy.exists() or not legacy.is_file():
        return
    tracked = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "ls-files", "--error-unmatch", str(LOOP_DIR / "LOCK")],
        check=False,
    )
    if tracked.returncode == 0:
        return
    try:
        with legacy.open("r+", encoding="utf-8") as fh:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            try:
                if legacy.stat().st_size == 0:
                    legacy.unlink()
            finally:
                fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
    except (BlockingIOError, OSError):
        return


def command_requires_loop_lock(args: argparse.Namespace) -> bool:
    command = getattr(args, "command", "")
    if command == "config":
        return getattr(args, "config_command", "") == "apply" and bool(
            getattr(args, "apply", False)
        )
    if command == "outcome":
        return getattr(args, "outcome_command", "") == "blocked"
    if command == "completion":
        return True
    if command in {"init", "migrate", "merge", "validate", "validation", "qa", "tick", "pump", "report", "checkpoint", "pause", "resume", "finish", "final-gates", "cleanup"}:
        return True
    if command == "batch":
        return getattr(args, "batch_command", "") in {"start", "assign", "close"}
    if command == "harvest":
        return True
    if command == "task":
        return getattr(args, "task_command", "") in {"new", "update"}
    if command == "worker":
        return getattr(args, "worker_command", "") in {"start", "harvest", "message", "finalize"}
    if command == "reviewer":
        return getattr(args, "reviewer_command", "") in {"start", "harvest", "close", "message"}
    if command == "gap":
        return getattr(args, "gap_command", "") in {"start", "harvest", "close", "message"}
    if command == "advisor":
        return getattr(args, "advisor_command", "") in {"request", "start", "harvest", "close", "message"}
    if command == "agent":
        return getattr(args, "agent_command", "") != "report"
    if command == "message":
        return True
    if command == "inbox":
        return getattr(args, "inbox_command", "") == "ack"
    if command == "manager":
        # The blocking sleep must release the repo lock so role reports can be
        # accepted while the Manager is suspended in the foreground.
        return getattr(args, "manager_command", "") != "sleep"
    if command == "broker":
        return getattr(args, "broker_command", "") == "recover"
    if command == "input":
        return True
    if command == "requirement":
        return True
    if command == "context":
        return True
    if command == "progress":
        return True
    if command == "experience":
        return getattr(args, "experience_command", "") == "recommend"
    if command == "triage":
        return not bool(getattr(args, "dry_run", False))
    return False


def command_requires_state_schema_guard(args: argparse.Namespace) -> bool:
    """Return whether a command may mutate resources governed by STATE.json.

    Migration is the only mutating command that intentionally accepts an older
    schema.  It performs its own future-version check before writing a backup
    or state.  ``wait --harvest`` acquires its lock only after an artifact is
    ready, so it needs the same guard without holding the lock while waiting.
    """

    command = getattr(args, "command", "")
    if command == "migrate":
        return False
    if command == "wait":
        return bool(getattr(args, "harvest", False))
    return command_requires_loop_lock(args)


def _has_local_state(repo: Path) -> bool:
    return state_path(repo).exists()


def load_state(repo: Path) -> dict[str, Any]:
    path = state_path(repo)
    if not path.exists():
        raise HLoopError(f"STATE.json not found: {path}")
    try:
        state = json.loads(read_text(path))
    except json.JSONDecodeError as exc:
        raise HLoopError(f"invalid STATE.json: {exc}") from exc
    if not isinstance(state, dict):
        raise HLoopError(f"STATE.json must be a JSON object: {path}")
    recorded_namespace = str(state.get("namespace") or LOOP_NAMESPACE)
    if recorded_namespace != LOOP_NAMESPACE:
        raise HLoopError(
            f"loop namespace mismatch: selected={LOOP_NAMESPACE} state={recorded_namespace}"
        )
    return state


def assert_mutating_state_schema_compatible(repo: Path) -> None:
    """Reject incompatible state before a mutating command can cause effects."""

    if not state_path(repo).exists():
        return
    state = load_state(repo)
    try:
        state_schema = schema_version_of(state)
    except MigrationError as exc:
        raise HLoopError(f"invalid state schema marker: {exc}") from exc
    if state_schema < RUNTIME_SCHEMA_VERSION:
        raise HLoopError(
            f"state migration required: {state_schema.label()} "
            f"runtime={RUNTIME_SCHEMA_VERSION.label()}; run `hloop migrate --dry-run` "
            "then `hloop migrate --apply`"
        )
    if state_schema > RUNTIME_SCHEMA_VERSION:
        raise HLoopError(
            f"state {state_schema.label()} is newer than runtime "
            f"{RUNTIME_SCHEMA_VERSION.label()}; mutating commands are disabled"
        )


def save_state(repo: Path, state: dict[str, Any]) -> None:
    state["updated_at"] = now_iso()
    write_text(
        state_path(repo),
        json.dumps(state, ensure_ascii=False, indent=2) + "\n",
        durable=True,
    )


def journal(repo: Path, message: str) -> None:
    append_text(loop_path(repo) / "JOURNAL.md", f"\n## {now_iso()}\n\n{message}\n")


def parse_scalar(raw: str, key: str | None = None) -> Any:
    value = raw.strip()
    if value == "":
        return ""
    lower = value.lower()
    if lower == "true":
        return True
    if lower == "false":
        return False
    if value == "[]":
        return []
    if value.startswith("[") and value.endswith("]"):
        inner = value[1:-1].strip()
        if not inner:
            return []
        if key in STRICT_MULTILINE_LIST_FIELDS:
            raise HLoopError(f"{key}: inline list unsupported; use multiline list")
        return [parse_scalar(part.strip()) for part in inner.split(",")]
    if (value.startswith('"') and value.endswith('"')) or (
        value.startswith("'") and value.endswith("'")
    ):
        return value[1:-1]
    return value


def parse_frontmatter_text(text: str) -> dict[str, Any]:
    if not text.startswith("---\n"):
        return {}
    end = text.find("\n---", 4)
    if end == -1:
        return {}
    data: dict[str, Any] = {}
    current_key: str | None = None
    for line in text[4:end].splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        item = re.match(r"^\s*-\s+(.*)$", line)
        if item and current_key:
            data.setdefault(current_key, [])
            if not isinstance(data[current_key], list):
                data[current_key] = [data[current_key]]
            data[current_key].append(parse_scalar(item.group(1)))
            continue
        if ":" not in line:
            continue
        key, raw_value = line.split(":", 1)
        key = key.strip()
        raw_value = raw_value.strip()
        if raw_value == "":
            data[key] = []
            current_key = key
        else:
            data[key] = parse_scalar(raw_value, key=key)
            current_key = None
    return data


def read_frontmatter(path: Path) -> dict[str, Any]:
    return parse_frontmatter_text(read_text(path))


def replace_frontmatter(path: Path, updates: dict[str, Any]) -> None:
    text = read_text(path)
    if not text.startswith("---\n"):
        raise HLoopError(f"missing frontmatter: {path}")
    end = text.find("\n---", 4)
    if end == -1:
        raise HLoopError(f"unterminated frontmatter: {path}")
    meta = parse_frontmatter_text(text)
    meta.update(updates)
    rest = text[end + 4 :]
    if rest.startswith("\n"):
        rest = rest[1:]
    write_text(path, frontmatter(meta) + "\n" + rest)


def yaml_scalar(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    text = str(value)
    if text == "" or re.search(r"[:#\[\]{}]|^\s|\s$", text):
        return json.dumps(text, ensure_ascii=False)
    return text


def frontmatter(fields: dict[str, Any]) -> str:
    lines = ["---"]
    for key, value in fields.items():
        if isinstance(value, list):
            if value:
                lines.append(f"{key}:")
                for item in value:
                    lines.append(f"  - {yaml_scalar(item)}")
            else:
                lines.append(f"{key}: []")
        else:
            lines.append(f"{key}: {yaml_scalar(value)}")
    lines.append("---")
    return "\n".join(lines) + "\n"


def parse_simple_field_block(lines: list[str]) -> dict[str, Any]:
    data: dict[str, Any] = {}
    current_key: str | None = None
    for line in lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        item = re.match(r"^\s*-\s+(.*)$", line)
        if item and current_key:
            data.setdefault(current_key, [])
            if not isinstance(data[current_key], list):
                data[current_key] = [data[current_key]]
            data[current_key].append(parse_scalar(item.group(1)))
            continue
        if ":" not in line:
            continue
        key, raw_value = line.split(":", 1)
        key = key.strip()
        raw_value = raw_value.strip()
        if raw_value == "":
            data[key] = []
            current_key = key
        else:
            data[key] = parse_scalar(raw_value, key=key)
            current_key = None
    return data


def reject_fix_task_candidate(title: str, reasons: list[str], raw: str = "") -> dict[str, Any]:
    return {
        "title": title or "untitled candidate",
        "reasons": reasons,
        "raw": raw,
    }


def validate_fix_task_candidate(candidate: dict[str, Any], data: dict[str, Any]) -> list[str]:
    reasons = []
    if not str(candidate.get("title") or "").strip():
        reasons.append("title is missing")
    if str(data.get("action") or "") not in {"fix_task", "fix-task"}:
        reasons.append("action must be fix_task")
    if str(candidate.get("kind") or "") not in {"fix", "implementation"}:
        reasons.append("kind must be fix or implementation")
    priority = str(candidate.get("priority") or "")
    if priority not in FIX_TASK_PRIORITIES:
        reasons.append("priority/severity must be one of P0, P1, P2, P3")
    if not normalize_list(candidate.get("write_allow")):
        reasons.append("write_allow is required")
    if not normalize_list(candidate.get("acceptance")):
        reasons.append("acceptance is required")
    if not str(candidate.get("rationale") or "").strip():
        reasons.append("rationale is required")
    return reasons


def extract_fix_task_candidates(text: str, source_id: str) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    lines = text.splitlines()
    in_section = False
    blocks: list[tuple[str, list[str]]] = []
    current_title: str | None = None
    current_lines: list[str] = []
    for line in lines:
        if re.match(r"^##\s+Fix Task Candidates\s*$", line, re.IGNORECASE):
            in_section = True
            continue
        if in_section and re.match(r"^##\s+", line):
            break
        if not in_section:
            continue
        heading = re.match(r"^###\s+(.*)$", line)
        if heading:
            if current_title is not None:
                blocks.append((current_title, current_lines))
            current_title = heading.group(1).strip()
            current_lines = []
            continue
        if current_title is not None:
            current_lines.append(line)
    if current_title is not None:
        blocks.append((current_title, current_lines))

    candidates: list[dict[str, Any]] = []
    rejected: list[dict[str, Any]] = []
    for title, block_lines in blocks:
        try:
            data = parse_simple_field_block(block_lines)
        except HLoopError as exc:
            rejected.append(reject_fix_task_candidate(title, [str(exc)], "\n".join(block_lines)))
            continue
        action = str(data.get("action") or "")
        clean_title = re.sub(r"^FT\d+\s*:\s*", "", title).strip()
        def clean_path_item(value: str) -> str:
            stripped = value.strip()
            code_span = re.match(r"^`([^`]+)`(?:\s+.*)?$", stripped)
            return code_span.group(1).strip() if code_span else stripped

        candidate = {
            "title": str(data.get("title") or clean_title),
            "kind": str(data.get("kind") or "fix"),
            "priority": str(data.get("priority") or data.get("severity") or ""),
            "source": str(data.get("source") or source_id),
            "source_finding": str(data.get("source_finding") or data.get("finding") or clean_title),
            "write_allow": [clean_path_item(item) for item in normalize_list(data.get("write_allow"))],
            "write_deny": [clean_path_item(item) for item in normalize_list(data.get("write_deny"))],
            "acceptance": normalize_list(data.get("acceptance")),
            "depends_on": normalize_list(data.get("depends_on")),
            "rationale": str(data.get("rationale") or data.get("reason") or ""),
        }
        reasons = validate_fix_task_candidate(candidate, {**data, "action": action})
        if reasons:
            rejected.append(reject_fix_task_candidate(candidate["title"], reasons, "\n".join(block_lines)))
            continue
        candidates.append(candidate)
    return candidates, rejected


def confirmed_review_fix_task_candidates(
    manifest: hloop_review.ReviewManifest,
    candidates: list[dict[str, Any]],
    rejected_candidates: list[dict[str, Any]],
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    confirmed = set(manifest.confirmed_fingerprints)
    accepted = []
    rejected = list(rejected_candidates)
    for candidate in candidates:
        source_finding = str(candidate.get("source_finding") or "")
        if source_finding not in confirmed:
            rejected.append(
                reject_fix_task_candidate(
                    candidate["title"],
                    [
                        "source_finding must identify a manifest finding whose required verification records are all confirmed"
                    ],
                )
            )
            continue
        accepted.append(candidate)
    return accepted, rejected


def ensure_loop_dirs(repo: Path) -> None:
    for rel in [
        "tasks",
        "batches",
        "results",
        "reviews",
        "gaps",
        "advice",
        "prompts",
        "reports",
        "triage",
        "validation",
        "qa",
        "inbox/manager",
        "inbox/pending",
        "inbox/user",
    ]:
        (loop_path(repo) / rel).mkdir(parents=True, exist_ok=True)


def archive_existing_loop(repo: Path) -> Path | None:
    source = loop_path(repo)
    if not source.exists():
        return None
    archive_root = repo / LOOP_ARCHIVE_ROOT / LOOP_NAMESPACE
    archive_root.mkdir(parents=True, exist_ok=True)
    old_goal = "loop"
    old_state = source / "STATE.json"
    if old_state.exists():
        try:
            old_goal = slugify(str(json.loads(read_text(old_state)).get("goal_id") or old_goal), 24)
        except (HLoopError, json.JSONDecodeError):
            pass
    destination = archive_root / f"{filename_timestamp()}-{old_goal}"
    shutil.move(str(source), str(destination))
    return destination


def resolve_worktree_root(repo: Path, raw: str | None) -> Path | None:
    value = str(raw or "").strip()
    if not value:
        return None
    path = Path(value).expanduser()
    return path.resolve() if path.is_absolute() else (repo / path).resolve()


def configured_worktree_path(
    repo: Path,
    state: dict[str, Any] | None,
    name: str,
    legacy_name: str,
) -> Path:
    root = resolve_worktree_root(repo, str((state or {}).get("worktree_root") or ""))
    if root is None:
        return repo.parent / legacy_name
    return root / name


def slugify(text: str, max_len: int = 48) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    slug = re.sub(r"-+", "-", slug)
    return (slug or "task")[:max_len].strip("-") or "task"


def next_id(prefix: str, existing: dict[str, Any]) -> str:
    nums = []
    for key in existing:
        if re.fullmatch(rf"{prefix}\d{{3}}", key):
            nums.append(int(key[1:]))
    return f"{prefix}{(max(nums) if nums else 0) + 1:03d}"


def current_branch(repo: Path) -> str:
    return git(repo, ["branch", "--show-current"])


def branch_exists(repo: Path, branch: str) -> bool:
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "rev-parse", "--verify", "--quiet", branch], check=False)
    return proc.returncode == 0


def is_ancestor(repo: Path, ancestor: str, descendant: str) -> bool:
    if not ancestor or not descendant:
        return False
    proc = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "merge-base", "--is-ancestor", ancestor, descendant],
        check=False,
    )
    return proc.returncode == 0


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def json_from_cmd(cmd: list[str], cwd: Path | None = None) -> dict[str, Any]:
    proc = run_cmd(cmd, cwd=cwd, check=False)
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise HLoopError(f"expected JSON from {' '.join(cmd)}: {exc}") from exc


def find_key(value: Any, key: str) -> Any | None:
    if isinstance(value, dict):
        if key in value:
            return value[key]
        for child in value.values():
            found = find_key(child, key)
            if found is not None:
                return found
    elif isinstance(value, list):
        for child in value:
            found = find_key(child, key)
            if found is not None:
                return found
    return None


def extract_pane_id(payload: dict[str, Any]) -> str:
    found = find_key(payload, "pane_id")
    if found:
        return str(found)
    result = payload.get("result", {})
    candidates = [
        result.get("pane", {}),
        result.get("root_pane", {}),
        payload.get("pane", {}),
    ]
    for candidate in candidates:
        pane_id = candidate.get("pane_id") if isinstance(candidate, dict) else None
        if pane_id:
            return str(pane_id)
    raise HLoopError(f"could not find pane_id in Herdr response: {payload}")


def pane_info(pane_id: str) -> dict[str, Any] | None:
    proc = run_cmd(["herdr", "pane", "get", pane_id], check=False)
    if proc.returncode != 0:
        return None
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    pane = payload.get("result", {}).get("pane")
    return pane if isinstance(pane, dict) else None


def pane_text(pane_id: str, lines: int = 160) -> str:
    proc = run_cmd(
        [
            "herdr",
            "pane",
            "read",
            pane_id,
            "--source",
            "recent-unwrapped",
            "--lines",
            str(lines),
        ],
        check=False,
    )
    if proc.returncode != 0:
        return ""
    return proc.stdout or ""


def codex_tui_blocker(pane: dict[str, Any] | None, text: str) -> str | None:
    if pane is None:
        return "pane is missing or closed"
    if pane.get("agent") != "codex":
        return "pane is not a Codex TUI"
    if "Do you trust the contents of this directory?" in text or "Press enter to continue" in text:
        return "Codex trust prompt is pending"
    status = str(pane.get("agent_status") or "unknown")
    if status == "working" or "esc to interrupt" in text or "• Working" in text:
        return "Codex is still working"
    if status in {"blocked", "unknown"}:
        return f"Codex is not ready: agent_status={status}"
    return None


def agent_tui_blocker(provider: str, pane: dict[str, Any] | None, text: str) -> str | None:
    provider = normalize_agent_provider(provider)
    if provider == "codex":
        return codex_tui_blocker(pane, text)
    if pane is None:
        return "pane is missing or closed"
    pane_agent = str(pane.get("agent") or "")
    if pane_agent and pane_agent not in {provider, "shell"}:
        return f"pane is not a {provider} TUI"
    trust_markers = (
        "Do you trust the contents of this directory?",
        "Do you trust the files in this folder?",
        "Press enter to continue",
    )
    if any(marker in text for marker in trust_markers):
        return f"{provider} trust prompt is pending"
    status = str(pane.get("agent_status") or "unknown")
    working_markers = ("esc to interrupt", "• Working", "Working…", "Working...")
    if status == "working" or any(marker in text for marker in working_markers):
        return f"{provider} is still working"
    if status in {"blocked", "unknown"}:
        return f"{provider} is not ready: agent_status={status}"
    return None


def message_anchors(message: str) -> list[str]:
    anchors: list[str] = []
    for line in message.splitlines():
        stripped = line.strip()
        if stripped:
            anchors.append(stripped[:160])
    if not anchors and message.strip():
        anchors.append(message.strip()[:160])
    if len(anchors) > 1:
        return [anchors[0], anchors[-1]]
    return anchors


def message_visible_in_text(message: str, text: str) -> bool:
    anchors = message_anchors(message)
    return bool(anchors) and all(anchor in text for anchor in anchors)


def codex_output_after_message(message: str, text: str) -> bool:
    anchors = message_anchors(message)
    if not anchors:
        return False
    index = text.rfind(anchors[-1])
    if index < 0:
        return False
    after = text[index + len(anchors[-1]) :]
    return "\n• " in after


def agent_output_after_message(provider: str, message: str, text: str) -> bool:
    provider = normalize_agent_provider(provider)
    if provider == "codex":
        return codex_output_after_message(message, text)
    anchors = message_anchors(message)
    if not anchors:
        return False
    index = text.rfind(anchors[-1])
    if index < 0:
        return False
    after = text[index + len(anchors[-1]) :]
    return bool(after.strip())


def wait_codex_tui_ready(pane_id: str, timeout_ms: int) -> tuple[dict[str, Any], str]:
    return wait_agent_tui_ready("codex", pane_id, timeout_ms)


def wait_agent_tui_ready(provider: str, pane_id: str, timeout_ms: int) -> tuple[dict[str, Any], str]:
    provider = normalize_agent_provider(provider)
    deadline = time.monotonic() + max(0, timeout_ms) / 1000
    last_blocker = f"{provider} TUI did not become ready"
    while True:
        pane = pane_info(pane_id)
        text = pane_text(pane_id)
        blocker = agent_tui_blocker(provider, pane, text)
        if blocker is None and pane is not None:
            return pane, text
        last_blocker = blocker or last_blocker
        if time.monotonic() >= deadline:
            raise HLoopError(f"{provider} TUI is not ready for manager message: {last_blocker}")
        time.sleep(0.5)


def wait_manager_message_visible(pane_id: str, message: str, timeout_ms: int) -> str:
    deadline = time.monotonic() + max(0, timeout_ms) / 1000
    while True:
        text = pane_text(pane_id)
        if message_visible_in_text(message, text):
            return text
        if time.monotonic() >= deadline:
            raise HLoopError("manager message was not visible in the Codex input after send-text")
        time.sleep(0.2)


def manager_message_submitted(
    provider: str,
    pane_id: str,
    message: str,
    typed_snapshot: str,
    initial_session_id: str | None,
    timeout_ms: int,
) -> bool:
    deadline = time.monotonic() + max(0, timeout_ms) / 1000
    while True:
        pane = pane_info(pane_id)
        text = pane_text(pane_id)
        status = str((pane or {}).get("agent_status") or "unknown")
        session_id = extract_agent_session_id(pane)
        if status in {"working", "blocked"} or "esc to interrupt" in text or "• Working" in text:
            return True
        if agent_output_after_message(provider, message, text):
            return True
        if (
            normalize_agent_provider(provider) == "codex"
            and text != typed_snapshot
            and message_visible_in_text(message, text)
        ):
            # Codex can move the submitted input into the transcript before it
            # exposes a Working marker or assistant bullet.  The changed pane
            # snapshot plus the still-visible exact input is transport evidence;
            # classifying it as undelivered would make a retry duplicate work.
            return True
        if session_id and session_id != initial_session_id and text != typed_snapshot:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)


def send_codex_tui_message(
    pane_id: str,
    message: str,
    timeout_ms: int,
    input_settle_ms: int,
    submit_verify_ms: int,
    submit_attempts: int,
) -> None:
    send_agent_tui_message(
        "codex",
        pane_id,
        message,
        timeout_ms,
        input_settle_ms,
        submit_verify_ms,
        submit_attempts,
    )


def send_agent_tui_message(
    provider: str,
    pane_id: str,
    message: str,
    timeout_ms: int,
    input_settle_ms: int,
    submit_verify_ms: int,
    submit_attempts: int,
) -> None:
    provider = normalize_agent_provider(provider)
    if not message.strip():
        raise HLoopError("manager message is empty")
    check_herdr_env()
    initial_pane, _ = wait_agent_tui_ready(provider, pane_id, timeout_ms)
    initial_session_id = extract_agent_session_id(initial_pane)
    try:
        run_cmd(["herdr", "pane", "send-text", pane_id, message], check=True, capture=True)
    except (OSError, subprocess.CalledProcessError) as exc:
        raise HLoopError("manager message could not be typed into the agent pane") from exc
    try:
        typed_snapshot = wait_manager_message_visible(
            pane_id,
            message,
            max(input_settle_ms, 1_000),
        )
    except HLoopError as exc:
        raise ManagerMessageDeliveryUnknown(
            "send-text succeeded but input visibility could not be confirmed; "
            "delivery is unknown and must not be auto-retried"
        ) from exc
    if input_settle_ms > 0:
        time.sleep(input_settle_ms / 1000)
    attempts = max(1, submit_attempts)
    try:
        for attempt in range(attempts):
            run_cmd(["herdr", "pane", "send-keys", pane_id, "Enter"], check=True, capture=True)
            if manager_message_submitted(
                provider,
                pane_id,
                message,
                typed_snapshot,
                initial_session_id,
                submit_verify_ms,
            ):
                return
            if attempt + 1 < attempts and input_settle_ms > 0:
                time.sleep(input_settle_ms / 1000)
    except (HLoopError, OSError, subprocess.CalledProcessError) as exc:
        raise ManagerMessageDeliveryUnknown(
            "manager message was visibly typed before submission verification failed; "
            "delivery is unknown and must not be auto-retried"
        ) from exc
    raise ManagerMessageDeliveryUnknown(
        f"manager message was typed and Enter was sent {attempts} time(s), but submission "
        "could not be visually confirmed"
    )


def resend_pending_manager_messages(
    repo: Path,
    agent_state: dict[str, Any],
    *,
    timeout_ms: int,
    input_settle_ms: int,
    submit_verify_ms: int,
    submit_attempts: int,
) -> tuple[int, int]:
    """Resend one role's `undelivered` Manager messages; return (drained, remaining).

    Entries tagged anything other than `undelivered` (defensively defaulted to
    `undelivered` for pre-0.5.0 state) are left untouched: `unknown` messages
    must never be auto-resent, and a resend that itself comes back `unknown`
    is recorded as such rather than retried indefinitely.
    """

    pane_id = str(agent_state.get("pane_id") or "")
    pending = agent_state.get("pending_manager_messages") or []
    if not pane_id or not pending:
        return 0, 0
    remaining: list[dict[str, Any]] = []
    drained = 0
    marker = "## Message\n\n"
    for entry in pending:
        if str(entry.get("status") or "undelivered") != "undelivered":
            remaining.append(entry)
            continue
        pending_path = entry.get("pending_path")
        full_path = repo / pending_path if pending_path else None
        if full_path is None or not full_path.exists():
            entry["error"] = "pending Manager message file is missing"
            remaining.append(entry)
            continue
        content = read_text(full_path)
        offset = content.find(marker)
        message = content[offset + len(marker) :] if offset != -1 else content
        message_id = str(entry.get("message_id") or "")
        original = manager_message_by_id(agent_state, message_id) if message_id else None
        try:
            send_agent_tui_message(
                str(agent_state.get("agent_provider") or DEFAULT_AGENT_PROVIDER),
                pane_id,
                message,
                timeout_ms,
                input_settle_ms,
                submit_verify_ms,
                submit_attempts,
            )
        except ManagerMessageDeliveryUnknown as exc:
            if original is not None:
                transition_manager_message(
                    agent_state,
                    original,
                    delivery_status="unknown",
                    error=str(exc),
                )
            else:
                original = record_manager_message(
                    agent_state,
                    "drain",
                    message,
                    delivery_status="unknown",
                    delivery_error=str(exc),
                )
            agent_state.setdefault("unknown_manager_messages", []).append(
                {
                    "at": now_iso(),
                    "source": "drain",
                    "message_id": original.get("message_id"),
                    "error": str(exc),
                }
            )
            try:
                full_path.unlink()
            except OSError:
                pass
            continue
        except HLoopError:
            remaining.append(entry)
            continue
        if original is not None:
            transition_manager_message(
                agent_state, original, delivery_status="delivered"
            )
        else:
            record_manager_message(agent_state, "drain", message)
        try:
            full_path.unlink()
        except OSError:
            pass
        drained += 1
    agent_state["pending_manager_messages"] = remaining
    return drained, len(remaining)


def manager_message_from_args(args: argparse.Namespace) -> tuple[str, str]:
    if getattr(args, "file", None):
        path = Path(args.file).resolve()
        return read_text(path), str(path)
    if getattr(args, "message", None):
        return str(args.message), "argv"
    if not sys.stdin.isatty():
        return sys.stdin.read(), "stdin"
    raise HLoopError("provide a message argument, --file, or stdin")


def manager_message_envelope(
    state: dict[str, Any],
    agent_id: str,
    agent: dict[str, Any],
    message: str,
    *,
    contract_changing: bool = False,
) -> tuple[str, str]:
    message_id = str(uuid.uuid4())
    run_id = str(state.get("run_id") or "")
    attempt_id = str(agent.get("attempt_id") or agent.get("active_attempt_id") or "")
    ack = f"HERDR_LOOP_MESSAGE_ACK:{run_id}:{agent_id}:{attempt_id}:{message_id}"
    contract_notice = (
        "This message changes the task contract. Material work (a `done` finalize "
        "or merge) is blocked until the Manager resolves the semantic ACK barrier "
        "with `hloop agent ack resolve`.\n\n"
        if contract_changing
        else ""
    )
    body = (
        f"Manager message id: {message_id}\n"
        f"Before acting, print exactly: {ack}\n\n{contract_notice}{message.rstrip()}\n"
    )
    return message_id, body


def message_digest(message: str) -> str:
    return hashlib.sha256(message.encode("utf-8")).hexdigest()


def record_manager_message(
    target_state: dict[str, Any],
    source: str,
    message: str,
    *,
    delivery_status: str = "delivered",
    delivery_error: str | None = None,
    pending_path: str | None = None,
) -> dict[str, Any]:
    if delivery_status not in MESSAGE_DELIVERY_STATUSES:
        raise HLoopError(f"unsupported message delivery status: {delivery_status}")
    sent_at = now_iso()
    entry = {
        "at": sent_at,
        "sent_at": sent_at,
        "source": source,
        "bytes": len(message.encode("utf-8")),
        "lines": len(message.splitlines()) or 1,
        "digest": message_digest(message),
        "delivery_status": delivery_status,
        "result": None,
    }
    match = re.search(r"Manager message id: ([0-9a-f-]{36})", message)
    if match:
        entry["message_id"] = match.group(1)
    if delivery_error:
        entry["delivery_error"] = delivery_error
    if pending_path:
        entry["pending_path"] = pending_path
    target_state.setdefault("manager_messages", []).append(entry)
    return entry


def manager_message_by_id(
    target_state: dict[str, Any], message_id: str
) -> dict[str, Any] | None:
    for entry in reversed(target_state.get("manager_messages") or []):
        if entry.get("message_id") == message_id:
            return entry
    return None


def transition_manager_message(
    target_state: dict[str, Any],
    entry: dict[str, Any],
    *,
    delivery_status: str,
    result: str | None = None,
    error: str | None = None,
) -> dict[str, Any]:
    """Persist a legal transport/application status transition and its history."""

    if delivery_status not in MESSAGE_DELIVERY_STATUSES:
        raise HLoopError(f"unsupported message delivery status: {delivery_status}")
    previous = str(entry.get("delivery_status") or "delivered")
    allowed = {
        "delivered": {"acknowledged", "applied", "unknown", "superseded"},
        "acknowledged": {"applied", "unknown", "superseded"},
        "applied": set(),
        "undelivered": {"delivered", "unknown", "superseded"},
        "unknown": {"acknowledged", "applied", "undelivered", "superseded"},
        "superseded": set(),
    }
    if delivery_status == previous:
        return entry
    if delivery_status not in allowed.get(previous, set()):
        raise HLoopError(
            f"invalid message status transition: {previous} -> {delivery_status}"
        )
    if delivery_status == "applied" and not str(result or "").strip():
        raise HLoopError("applied message resolution requires a non-empty result")
    changed_at = now_iso()
    entry["delivery_status"] = delivery_status
    if delivery_status == "acknowledged":
        entry["acknowledged_at"] = changed_at
    elif delivery_status == "applied":
        entry.setdefault("acknowledged_at", changed_at)
        entry["applied_at"] = changed_at
        entry["result"] = str(result).strip()
    elif delivery_status == "superseded":
        entry["superseded_at"] = changed_at
    if error:
        entry["delivery_error"] = error
    target_state.setdefault("manager_message_events", []).append(
        {
            "message_id": entry.get("message_id"),
            "from": previous,
            "to": delivery_status,
            "at": changed_at,
            "result": entry.get("result"),
            "error": error,
        }
    )
    return entry


SEMANTIC_ACK_DECISIONS = frozenset({"approve", "reject", "timeout"})


def arm_semantic_ack_barrier(
    agent_state: dict[str, Any],
    *,
    message_id: str,
    digest: str,
    kind: str = "message",
    required_reack_after_sequence: int = 0,
) -> None:
    """(Re-)arm the semantic ACK barrier for a contract-changing Manager message.

    Any existing barrier -- pending, approved, or rejected -- is replaced, so a
    later contract-changing message always requires a fresh Manager decision
    even if an earlier barrier had already been resolved.
    """

    agent_state["semantic_ack_barrier"] = {
        "message_id": message_id,
        "digest": digest,
        "kind": kind,
        "status": "awaiting_ack",
        "armed_at": now_iso(),
        "required_reack_after_sequence": required_reack_after_sequence,
    }


def arm_initial_semantic_ack_barrier(
    agent_state: dict[str, Any],
    *,
    attempt_id: str,
    contract_digest: str,
    required_reack_after_sequence: int = 0,
) -> None:
    arm_semantic_ack_barrier(
        agent_state,
        message_id=f"initial:{attempt_id}",
        digest=contract_digest,
        kind="initial",
        required_reack_after_sequence=required_reack_after_sequence,
    )


def latest_semantic_ack_sequence(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    agent_state: dict[str, Any],
) -> int:
    attempt_id = str(
        agent_state.get("attempt_id") or agent_state.get("active_attempt_id") or ""
    )
    if not attempt_id:
        return 0
    store = _open_broker_store(repo)
    with store.transaction() as transaction:
        latest = store.latest_role_event(
            transaction,
            run_id=str(state.get("run_id") or "local"),
            role_id=role_id,
            attempt_id=attempt_id,
            report_type="ack",
        )
    return int((latest or {}).get("sequence") or 0)


def semantic_ack_barrier_blocking(agent_state: dict[str, Any]) -> str:
    """Return a non-empty block reason while material work must wait, else ""."""

    barrier = agent_state.get("semantic_ack_barrier")
    if not isinstance(barrier, dict) or barrier.get("status") == "approved":
        return ""
    return (
        f"semantic ACK barrier `{barrier.get('message_id')}` is "
        f"{barrier.get('status') or 'awaiting_ack'}; a fresh authenticated ACK "
        "must be approved with `hloop agent ack resolve`"
    )


def resolve_semantic_ack_barrier(
    agent_state: dict[str, Any],
    *,
    decision: str,
    reason: str,
    latest_ack: dict[str, Any] | None,
) -> dict[str, Any]:
    if decision not in SEMANTIC_ACK_DECISIONS:
        raise HLoopError(f"unsupported semantic ACK decision: {decision}")
    barrier = agent_state.get("semantic_ack_barrier")
    if not isinstance(barrier, dict):
        raise HLoopError("no pending semantic ACK barrier to resolve")
    if barrier.get("status") == "approved":
        raise HLoopError("semantic ACK barrier is already approved")
    latest_sequence = int((latest_ack or {}).get("sequence") or 0)
    required_after = int(barrier.get("required_reack_after_sequence") or 0)
    if decision in {"approve", "reject"} and latest_ack is None:
        raise HLoopError("no authenticated semantic ACK report is available")
    if decision == "approve" and latest_sequence <= required_after:
        raise HLoopError(
            "a corrected semantic ACK report is required after the previous reject/timeout"
        )
    if (
        decision == "approve"
        and str(barrier.get("kind") or "") == "task-contract"
        and str((latest_ack or {}).get("task_contract_digest") or "")
        != str(barrier.get("digest") or "")
    ):
        raise HLoopError(
            "the corrected semantic ACK does not match the active task contract digest"
        )
    if decision == "approve":
        barrier["status"] = "approved"
        barrier["ack_event_id"] = latest_ack["event_id"]
        barrier["ack_sequence"] = latest_sequence
    else:
        barrier["status"] = "rejected" if decision == "reject" else "timed_out"
        barrier["required_reack_after_sequence"] = max(required_after, latest_sequence)
        if latest_ack is not None:
            barrier["rejected_ack_event_id"] = latest_ack["event_id"]
            barrier["rejected_ack_sequence"] = latest_sequence
    barrier["resolved_at"] = now_iso()
    barrier["resolution_reason"] = reason
    return barrier


def write_pending_manager_message(
    repo: Path,
    *,
    role: str,
    agent_id: str,
    pane_id: str,
    source: str,
    message: str,
    error: str,
) -> Path:
    rel = (
        LOOP_DIR
        / "inbox"
        / "pending"
        / f"{filename_timestamp()}-{slugify(agent_id, 24)}.md"
    )
    body = (
        "# Pending Manager Message\n\n"
        f"- role: {role}\n"
        f"- id: `{agent_id}`\n"
        f"- pane_id: `{pane_id}`\n"
        f"- source: `{source}`\n"
        f"- recorded_at: `{now_iso()}`\n"
        f"- delivery_error: `{error}`\n\n"
        "## Message\n\n"
        f"{message.rstrip()}\n"
    )
    write_text(repo / rel, body)
    return rel


def record_pending_manager_message(
    repo: Path,
    state: dict[str, Any],
    agent_state: dict[str, Any],
    *,
    role: str,
    agent_id: str,
    pane_id: str,
    source: str,
    message: str,
    error: Exception,
) -> int:
    detail = str(error)
    pending_rel = write_pending_manager_message(
        repo,
        role=role,
        agent_id=agent_id,
        pane_id=pane_id,
        source=source,
        message=message,
        error=detail,
    )
    pending_path = pending_rel.as_posix()
    recorded = record_manager_message(
        agent_state,
        source,
        message,
        delivery_status="undelivered",
        delivery_error=detail,
        pending_path=pending_path,
    )
    agent_state["last_manager_message_error"] = detail
    agent_state["last_pending_manager_message"] = pending_path
    agent_state.setdefault("pending_manager_messages", []).append(
        {
            "at": now_iso(),
            "source": source,
            "pending_path": pending_path,
            "error": detail,
            "status": "undelivered",
            "message_id": recorded.get("message_id"),
        }
    )
    save_state(repo, state)
    journal(
        repo,
        f"Recorded undelivered Manager message for {role} `{agent_id}` at `{pending_path}`; "
        f"delivery failed: {detail}",
    )
    print(
        f"manager message not delivered to {agent_id}: {detail}; pending file: {pending_path}",
        file=sys.stderr,
    )
    return 2


def record_unknown_manager_message(
    repo: Path,
    state: dict[str, Any],
    agent_state: dict[str, Any],
    *,
    role: str,
    agent_id: str,
    source: str,
    message: str,
    error: Exception,
) -> int:
    """Record a message whose delivery could not be confirmed.

    ``unknown`` messages are intentionally kept out of ``pending_manager_messages``
    so `hloop message drain` never auto-resends them; only an explicit retry,
    pane check, or ``resolve`` clears them.
    """

    detail = str(error)
    recorded = record_manager_message(
        agent_state,
        source,
        message,
        delivery_status="unknown",
        delivery_error=detail,
    )
    agent_state["last_manager_message_error"] = detail
    agent_state.setdefault("unknown_manager_messages", []).append(
        {
            "at": now_iso(),
            "source": source,
            "message_id": recorded.get("message_id"),
            "error": detail,
        }
    )
    save_state(repo, state)
    journal(
        repo,
        f"Manager message delivery to {role} `{agent_id}` is unknown (not auto-resent): {detail}",
    )
    print(
        f"manager message delivery to {agent_id} is unknown: {detail}; "
        "confirm pane state or resend explicitly; it will not be auto-drained",
        file=sys.stderr,
    )
    return 3


def supersede_pending_manager_messages(repo: Path, agent_state: dict[str, Any]) -> list[dict[str, Any]]:
    """Mark an ending attempt's outstanding messages superseded and drop pending files.

    Called on abort/requeue so a dead attempt's undelivered or unknown messages
    are archived rather than silently forwarded into, or resent against, a new
    attempt.
    """

    messages = agent_state.get("manager_messages") or []
    for entry in messages:
        if entry.get("delivery_status") in {
            "delivered",
            "acknowledged",
            "undelivered",
            "unknown",
        }:
            transition_manager_message(
                agent_state, entry, delivery_status="superseded"
            )
    for entry in agent_state.get("pending_manager_messages") or []:
        pending_path = entry.get("pending_path")
        if not pending_path:
            continue
        try:
            (repo / pending_path).unlink()
        except OSError:
            pass
    agent_state["pending_manager_messages"] = []
    return messages


def extract_agent_session_id(pane: dict[str, Any] | None) -> str | None:
    if not pane:
        return None
    session = pane.get("agent_session")
    if isinstance(session, dict):
        value = session.get("value")
        if value:
            return str(value)
    for key in ("agent_session_id", "session_id"):
        value = pane.get(key)
        if value:
            return str(value)
    return None


def session_cleanup_mode(args: argparse.Namespace, state: dict[str, Any]) -> str:
    mode = getattr(args, "session_cleanup", None) or state.get("session_cleanup", "archive")
    mode = str(mode)
    if mode not in SESSION_CLEANUP_MODES:
        raise HLoopError(f"unsupported session cleanup mode: {mode}")
    return mode


def cleanup_codex_session(session_id: str, mode: str) -> tuple[bool, str]:
    if mode == "none":
        return True, "skipped"
    if not command_exists("codex"):
        return False, "codex command not found"
    cmd = ["codex", "archive", session_id]
    if mode == "delete":
        cmd = ["codex", "delete", "--force", session_id]
    proc = run_cmd(cmd, check=False)
    if proc.returncode == 0:
        return True, mode
    message = (proc.stderr or proc.stdout or "").strip()
    return False, message or f"codex {mode} failed"


def cleanup_agent_session(provider: str, session_id: str, mode: str) -> tuple[bool, str]:
    provider = normalize_agent_provider(provider)
    if provider == "codex":
        return cleanup_codex_session(session_id, mode)
    if mode == "none":
        return True, "skipped"
    return True, f"skipped:{provider}-session-cleanup-unsupported"


def retry_agent_session_cleanup(
    repo: Path,
    agent_state: dict[str, Any],
    *,
    label: str,
    provider: str,
    session_id: str,
    session_cleanup: str,
) -> None:
    ok, detail = cleanup_agent_session(provider, session_id, session_cleanup)
    agent_state["agent_session_cleanup"] = detail
    if normalize_agent_provider(provider) == "codex":
        agent_state["codex_session_cleanup"] = detail
    if ok:
        agent_state["agent_session_cleaned_at"] = now_iso()
        if normalize_agent_provider(provider) == "codex":
            agent_state["codex_session_cleaned_at"] = agent_state["agent_session_cleaned_at"]
        agent_state.pop("agent_session_cleanup_error", None)
        agent_state.pop("agent_session_cleanup_error_fingerprint", None)
        agent_state.pop("codex_session_cleanup_error", None)
        journal(repo, f"{provider} session `{session_id}` for `{label}` cleanup: {detail}.")
    else:
        agent_state["agent_session_cleanup_error"] = detail
        agent_state["agent_session_cleanup_error_fingerprint"] = cleanup_error_fingerprint("session", detail)
        if normalize_agent_provider(provider) == "codex":
            agent_state["codex_session_cleanup_error"] = detail
        journal(repo, f"Failed {provider} session cleanup for `{label}` session `{session_id}`: {detail}")


def cleanup_completed_agent_pane(
    repo: Path,
    agent_state: dict[str, Any],
    *,
    label: str,
    keep_pane: bool = False,
    session_cleanup: str = "archive",
    dry_run: bool = False,
) -> None:
    pane_id = str(agent_state.get("pane_id") or "")
    if not pane_id or agent_state.get("pane_closed_at"):
        return
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        agent_state["pane_cleanup_status"] = "skipped:not-in-herdr"
        return
    try:
        current = current_pane_id()
    except HLoopError:
        current = ""
    if pane_id == current:
        agent_state["pane_cleanup_status"] = "skipped:manager-pane"
        journal(repo, f"Skipped closing `{label}` pane `{pane_id}` because it is the current Manager pane.")
        return
    pane = pane_info(pane_id)
    if pane is None:
        agent_state["pane_closed_at"] = now_iso()
        agent_state["pane_cleanup_status"] = "already-closed"
        agent_state["closed_pane_id"] = pane_id
        agent_state.pop("pane_id", None)
        return
    session_id = extract_agent_session_id(pane)
    provider = str(agent_state.get("agent_provider") or agent_state.get("provider") or DEFAULT_AGENT_PROVIDER)
    if session_id:
        agent_state["agent_session_id"] = session_id
        agent_state["agent_session_provider"] = provider
        if normalize_agent_provider(provider) == "codex":
            agent_state["codex_session_id"] = session_id
    if keep_pane:
        agent_state["pane_cleanup_status"] = "kept"
        return
    if dry_run:
        print(f"DRY RUN herdr pane close {pane_id}")
        if session_id and session_cleanup != "none":
            print(f"DRY RUN {provider} session cleanup {session_cleanup} {session_id}")
        return
    proc = run_cmd(["herdr", "pane", "close", pane_id], check=False)
    if proc.returncode == 0:
        agent_state["pane_closed_at"] = now_iso()
        agent_state["pane_cleanup_status"] = "closed"
        agent_state["closed_pane_id"] = pane_id
        agent_state.pop("pane_id", None)
        agent_state.pop("pane_cleanup_error", None)
        agent_state.pop("pane_cleanup_error_fingerprint", None)
        journal(repo, f"Closed `{label}` pane `{pane_id}` after harvesting its artifact.")
    else:
        message = (proc.stderr or proc.stdout or "").strip()
        agent_state["pane_cleanup_status"] = "failed"
        agent_state["pane_cleanup_error"] = message
        agent_state["pane_cleanup_error_fingerprint"] = cleanup_error_fingerprint("pane", message)
        journal(repo, f"Failed to close `{label}` pane `{pane_id}`: {message}")
        return
    if session_id:
        retry_agent_session_cleanup(
            repo, agent_state, label=label, provider=provider, session_id=session_id, session_cleanup=session_cleanup
        )


def current_pane_id() -> str:
    if os.environ.get("HERDR_PANE_ID"):
        return str(os.environ["HERDR_PANE_ID"])
    payload = json_from_cmd(["herdr", "pane", "current", "--current"])
    return extract_pane_id(payload)


def current_workspace_id() -> str | None:
    return os.environ.get("HERDR_WORKSPACE_ID")


def check_herdr_env() -> None:
    if os.environ.get("HERDR_ENV") != "1":
        raise HLoopError("HERDR_ENV=1 is required; run this skill inside Herdr")


def task_file(repo: Path, task_id: str) -> Path:
    return loop_path(repo) / "tasks" / f"{task_id}.md"


def batch_file(repo: Path, batch_id: str) -> Path:
    return loop_path(repo) / "batches" / f"{batch_id}.md"


def result_file(worktree: Path, task_id: str) -> Path:
    return loop_path(worktree) / "results" / task_id / "result.md"


def review_file(repo: Path, review_id: str) -> Path:
    return loop_path(repo) / "reviews" / f"{review_id}.md"


def review_group_dir(repo: Path, review_id: str) -> Path:
    return loop_path(repo) / "reviews" / review_id


def review_manifest_file(repo: Path, review_id: str) -> Path:
    return review_group_dir(repo, review_id) / "MANIFEST.json"


def review_provider_file(repo: Path, review_id: str, provider: str) -> Path:
    return review_group_dir(repo, review_id) / "providers" / f"{provider}.md"


def review_final_file(repo: Path, review_id: str) -> Path:
    return review_group_dir(repo, review_id) / "FINAL.md"


def is_directory_review(review: dict[str, Any]) -> bool:
    return str(review.get("mode") or "single") != "single"


def gap_file(repo: Path, gap_id: str) -> Path:
    return loop_path(repo) / "gaps" / f"{gap_id}.md"


def advice_file(repo: Path, advice_id: str, participant_id: str | None = None) -> Path:
    if participant_id:
        return loop_path(repo) / "advice" / f"{advice_id}-{participant_id}.md"
    return loop_path(repo) / "advice" / f"{advice_id}.md"


def prompt_file(repo: Path, name: str) -> Path:
    return loop_path(repo) / "prompts" / name


def recorded_path(repo: Path, value: Any, fallback: Path) -> Path:
    if not value:
        return fallback
    path = Path(str(value))
    return path if path.is_absolute() else repo / path


def artifact_was_harvested(agent: dict[str, Any]) -> bool:
    return bool(agent.get("harvested_at")) or agent_gate_status(agent) in {
        "reported",
        "triaged",
        "blocked_write_scope",
        "consumed",
    } or str(agent.get("status") or "") in {
        "result_reported",
        "merged",
        "partial",
        "blocked",
        "failed",
        "abandoned",
    }


def worker_artifact_path(
    repo: Path, state: dict[str, Any], task_id: str, task: dict[str, Any]
) -> Path:
    if artifact_was_harvested(task):
        return result_file(repo, task_id)
    worktree = Path(task.get("worktree") or default_worktree(repo, task_id, state)).resolve()
    return result_file(worktree, task_id)


def review_artifact_path(repo: Path, review_id: str, review: dict[str, Any]) -> Path:
    fallback = (
        review_final_file(repo, review_id)
        if is_directory_review(review)
        else review_file(repo, review_id)
    )
    if artifact_was_harvested(review):
        return fallback
    return recorded_path(
        repo,
        review.get("worktree_review_path") or review.get("review_path"),
        fallback,
    )


def load_review_manifest(path: Path) -> hloop_review.ReviewManifest:
    try:
        raw = json.loads(read_text(path))
        return hloop_review.ReviewManifest.from_record(raw)
    except (json.JSONDecodeError, hloop_review.ReviewModelError) as exc:
        raise HLoopError(f"invalid review manifest {path}: {exc}") from exc


def gap_artifact_path(repo: Path, gap_id: str, gap: dict[str, Any]) -> Path:
    if artifact_was_harvested(gap):
        return gap_file(repo, gap_id)
    return recorded_path(
        repo,
        gap.get("worktree_gap_path") or gap.get("gap_path"),
        gap_file(repo, gap_id),
    )


def advice_artifact_path(repo: Path, advice_id: str, participant: dict[str, Any]) -> Path:
    fallback = advice_file(repo, advice_id, str(participant.get("participant_id") or "P1"))
    if artifact_was_harvested(participant):
        return fallback
    return recorded_path(
        repo,
        participant.get("worktree_advice_path") or participant.get("advice_path"),
        fallback,
    )


def triage_draft_file(repo: Path, source_id: str) -> Path:
    return loop_path(repo) / "triage" / f"{source_id}.fix-task-draft.md"


def manager_qa_file(repo: Path) -> Path:
    return loop_path(repo) / "qa" / "FINAL.md"


def normalize_list(value: Any) -> list[str]:
    if value is None:
        return []
    if isinstance(value, list):
        return [str(v) for v in value]
    return [str(value)]


def normalize_agent_provider(value: Any, default: str = DEFAULT_AGENT_PROVIDER) -> str:
    provider = str(value or default or DEFAULT_AGENT_PROVIDER).strip().lower()
    if provider not in AGENT_PROVIDERS:
        raise HLoopError(
            f"unsupported agent provider `{provider}`; expected one of: {', '.join(sorted(AGENT_PROVIDERS))}"
        )
    return provider


def normalize_agent_model(value: Any) -> str:
    model = str(value or DEFAULT_AGENT_MODEL).strip()
    return model or DEFAULT_AGENT_MODEL


def normalize_agent_effort(value: Any) -> str:
    effort = str(value or DEFAULT_AGENT_EFFORT).strip().lower()
    return effort or DEFAULT_AGENT_EFFORT


def role_state_prefix(role: str) -> str:
    if role == "reviewer":
        return "reviewer"
    if role == "gap":
        return "gap"
    if role == "advisor":
        return "advisor"
    return "worker"


def role_agent_config(
    state: dict[str, Any],
    role: str,
    *,
    overrides: dict[str, Any] | None = None,
) -> dict[str, str]:
    overrides = overrides or {}
    prefix = role_state_prefix(role)
    provider = normalize_agent_provider(
        overrides.get("agent_provider")
        or overrides.get("provider")
        or overrides.get(f"{prefix}_agent_provider")
        or overrides.get(f"{prefix}_provider")
        or state.get(f"{prefix}_agent_provider")
        or state.get(f"{prefix}_provider")
        or DEFAULT_AGENT_PROVIDER
    )
    model = normalize_agent_model(
        overrides.get("agent_model")
        or overrides.get("model")
        or overrides.get(f"{prefix}_agent_model")
        or overrides.get(f"{prefix}_model")
        or state.get(f"{prefix}_agent_model")
        or state.get(f"{prefix}_model")
        or DEFAULT_AGENT_MODEL
    )
    fallback = str(
        overrides.get("fallback_provider")
        or state.get(f"{prefix}_fallback_provider")
        or DEFAULT_AGENT_PROVIDER
    ).strip().lower()
    if fallback and fallback not in AGENT_PROVIDERS:
        raise HLoopError(
            f"unsupported fallback provider `{fallback}`; expected one of: {', '.join(sorted(AGENT_PROVIDERS))}"
        )
    effort = normalize_agent_effort(
        overrides.get("agent_effort")
        or overrides.get(f"{prefix}_agent_effort")
        or state.get(f"{prefix}_agent_effort")
    )
    permission_mode = str(
        overrides.get("claude_permission_mode")
        or overrides.get(f"{prefix}_claude_permission_mode")
        or state.get(f"{prefix}_claude_permission_mode")
        or DEFAULT_CLAUDE_PERMISSION_MODE
    ).strip()
    return {"provider": provider, "model": model, "effort": effort, "claude_permission_mode": permission_mode, "fallback_provider": fallback}


def require_agent_provider_available(provider: str) -> None:
    provider = normalize_agent_provider(provider)
    if not command_exists(provider):
        raise HLoopError(f"{provider} command not found")


def agent_display(config: dict[str, str]) -> str:
    model = config.get("model") or DEFAULT_AGENT_MODEL
    provider = config.get("provider") or DEFAULT_AGENT_PROVIDER
    if model == DEFAULT_AGENT_MODEL:
        return provider
    return f"{provider}:{model}"


def normalize_bool(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() in {"1", "true", "yes", "on"}
    return bool(value)


def normalize_int(value: Any, default: int) -> int:
    if value is None:
        return default
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def parse_changed_files_name_status(text: str) -> list[str]:
    paths: list[str] = []
    for line in text.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t")
        status = parts[0]
        if (status.startswith("R") or status.startswith("C")) and len(parts) >= 3:
            paths.extend([parts[1], parts[2]])
        elif len(parts) >= 2:
            paths.append(parts[1])
    return list(dict.fromkeys(normalize_match_path(path) for path in paths if path.strip()))


def changed_files(repo: Path, base_sha: str, head_sha: str) -> list[str]:
    if not base_sha or not head_sha:
        return []
    out = git(
        repo,
        ["diff", "--name-status", "--find-renames", f"{base_sha}..{head_sha}"],
        check=False,
    )
    return parse_changed_files_name_status(out)


def git_worktree_paths(repo: Path) -> list[Path]:
    """Return every checkout sharing this repository's common Git directory."""

    output = git(repo, ["worktree", "list", "--porcelain"])
    return [
        Path(line.removeprefix("worktree ")).resolve()
        for line in output.splitlines()
        if line.startswith("worktree ")
    ]


def canonical_worker_contract_source(
    worker_repo: Path,
    task_id: str,
    local_state: dict[str, Any],
) -> tuple[Path, dict[str, Any]]:
    """Locate the active Manager checkout that owns a Worker's live contract.

    A local-only role worktree intentionally receives a point-in-time loop
    snapshot. Contract changes and semantic ACK approval are Manager-owned
    state, so ``worker finalize`` must not trust that stale snapshot when the
    active integration checkout is available through the shared Git worktree
    inventory.
    """

    worker_repo = worker_repo.resolve()
    expected_run_id = str(local_state.get("run_id") or "")
    for candidate in git_worktree_paths(worker_repo):
        if candidate == worker_repo or not state_path(candidate).is_file():
            continue
        try:
            candidate_state = load_state(candidate)
        except (HLoopError, OSError, json.JSONDecodeError):
            continue
        if expected_run_id and str(candidate_state.get("run_id") or "") != expected_run_id:
            continue
        task_state = (candidate_state.get("tasks") or {}).get(task_id)
        if not isinstance(task_state, dict) or str(task_state.get("status") or "") != "running":
            continue
        worktree_raw = str(task_state.get("worktree") or "")
        if not worktree_raw or Path(worktree_raw).resolve() != worker_repo:
            continue
        integration_branch = str(candidate_state.get("integration_branch") or "")
        if integration_branch and current_branch(candidate) != integration_branch:
            continue
        return candidate, candidate_state
    local_task = (local_state.get("tasks") or {}).get(task_id)
    local_integration = str(local_state.get("integration_branch") or "")
    local_worktree = str((local_task or {}).get("worktree") or "")
    if (
        isinstance(local_task, dict)
        and local_integration
        and current_branch(worker_repo) != local_integration
        and local_worktree
        and Path(local_worktree).resolve() == worker_repo
    ):
        raise HLoopError(
            f"canonical Manager task contract is unavailable for active Worker {task_id}"
        )
    return worker_repo, local_state


def git_show(repo: Path, ref_path: str) -> str:
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "show", ref_path], check=False)
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    return proc.stdout or ""


def require_files_committed_at_ref(repo: Path, ref: str, relative_paths: list[Path]) -> None:
    stale: list[str] = []
    missing: list[str] = []
    for relative in relative_paths:
        path = repo / relative
        if not path.exists():
            missing.append(relative.as_posix())
            continue
        try:
            committed = git_show(repo, f"{ref}:{relative.as_posix()}")
        except HLoopError:
            stale.append(f"{relative.as_posix()} (not committed at {ref})")
            continue
        if committed != read_text(path):
            stale.append(f"{relative.as_posix()} (working copy differs from {ref})")
    if missing or stale:
        details = [*(f"missing: {item}" for item in missing), *stale]
        raise HLoopError(
            "role worktree snapshot is not checkpointed; no worktree was created. "
            "Run `hloop checkpoint --message \"ai-loop: checkpoint role inputs\"` first. "
            + "; ".join(details)
        )


def worker_snapshot_paths(task_id: str) -> list[Path]:
    return [
        LOOP_DIR / "MISSION.md",
        LOOP_DIR / "PLAN.md",
        LOOP_DIR / "PROFILE.md",
        LOOP_DIR / "DECISIONS.md",
        LOOP_DIR / "tasks" / f"{task_id}.md",
    ]


def audit_snapshot_paths(repo: Path) -> list[Path]:
    paths = [
        LOOP_DIR / "MISSION.md",
        LOOP_DIR / "PLAN.md",
        LOOP_DIR / "PROFILE.md",
        LOOP_DIR / "DECISIONS.md",
        LOOP_DIR / "STATE.json",
    ]
    for subdir in ("tasks", "results", "validation"):
        root = loop_path(repo) / subdir
        if root.exists():
            paths.extend(path.relative_to(repo) for path in root.rglob("*") if path.is_file())
    return list(dict.fromkeys(paths))


def require_committed_result(worktree: Path, task_id: str, head_sha: str) -> str:
    rel = (LOOP_DIR / "results" / task_id / "result.md").as_posix()
    ref = f"{head_sha}:{rel}"
    try:
        committed = git_show(worktree, ref)
    except HLoopError as exc:
        disk_path = worktree / rel
        if disk_path.exists():
            raise HLoopError(
                "result artifact exists on disk but is not committed at worker HEAD: "
                f"{rel}. Ask Worker {task_id} to commit the result artifact in `{worktree}` "
                f"and rerun `hloop worker harvest {task_id}`."
            ) from exc
        raise
    disk = read_text(worktree / rel)
    if committed != disk:
        raise HLoopError(f"result artifact differs between worktree and committed HEAD: {rel}")
    return rel


def result_validation_recorded(meta: dict[str, Any]) -> bool:
    return normalize_bool(meta.get("validation_recorded"))


def worker_validation_error(
    meta: dict[str, Any],
    *,
    require_recorded: bool = False,
    require_passing: bool = False,
) -> str:
    """Return a fail-closed error for one Worker validation record."""

    recorded = result_validation_recorded(meta)
    commands = normalize_list(meta.get("validation_commands"))
    results = normalize_list(meta.get("validation_results"))
    if not recorded:
        if commands or results:
            return "validation evidence is present while validation_recorded is false"
        return "validation is not recorded" if require_recorded else ""
    if not commands or not results:
        return "validation_recorded requires non-empty commands and results"
    if len(commands) != len(results):
        return "validation command and result counts do not match"
    invalid = [result for result in results if result not in WORKER_VALIDATION_RESULTS]
    if invalid:
        return "unsupported validation result(s): " + ", ".join(invalid)
    if require_passing:
        non_passing = [result for result in results if result != "passed"]
        if non_passing:
            return "validation did not pass: " + ", ".join(non_passing)
    return ""


def escape_literal_brackets(pattern: str) -> str:
    pieces = []
    for char in pattern:
        if char == "[":
            pieces.append("[[]")
        elif char == "]":
            pieces.append("[]]")
        else:
            pieces.append(char)
    return "".join(pieces)


def normalize_match_path(value: str) -> str:
    value = str(value).replace("\\", "/")
    if value.startswith("./"):
        return value[2:]
    return value


def path_matches_pattern(path: str, pattern: str) -> bool:
    normalized_path = normalize_match_path(path)
    normalized_pattern = normalize_match_path(pattern)
    if fnmatch.fnmatchcase(normalized_path, normalized_pattern):
        return True
    escaped_pattern = escape_literal_brackets(normalized_pattern)
    return escaped_pattern != normalized_pattern and fnmatch.fnmatchcase(
        normalized_path,
        escaped_pattern,
    )


def matches_any(path: str, patterns: list[str]) -> bool:
    return any(path_matches_pattern(path, pattern) for pattern in patterns)


def validate_change_scope(task_id: str, task_meta: dict[str, Any], files: list[str]) -> list[str]:
    allow = normalize_list(task_meta.get("write_allow"))
    deny = normalize_list(task_meta.get("write_deny"))
    result_pattern = f"{LOOP_DIR.as_posix()}/results/{task_id}/**"
    violations = []
    for path in files:
        allowed = matches_any(path, allow) or path_matches_pattern(path, result_pattern)
        denied = matches_any(path, deny)
        if not allowed or denied:
            suffix = "denied" if denied else "not allowed"
            violations.append(f"{path} ({suffix})")
    return violations


def porcelain_paths(repo: Path) -> list[str]:
    proc = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "status", "--porcelain", "--untracked-files=all"],
        check=False,
    )
    return parse_porcelain_paths(proc.stdout or "")


def parse_porcelain_paths(text: str) -> list[str]:
    paths = []
    for line in text.splitlines():
        if not line:
            continue
        path = line[3:] if len(line) > 3 else ""
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        if path:
            paths.append(path)
    return paths


def porcelain_paths_for(repo: Path, pathspec: str) -> list[str]:
    proc = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "status", "--porcelain", "--untracked-files=all", "--", pathspec],
        check=False,
    )
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    return parse_porcelain_paths(proc.stdout or "")


def unsafe_dirty_paths(repo: Path, *, allow_loop_dirty: bool = True) -> list[str]:
    paths = porcelain_paths(repo)
    if not allow_loop_dirty:
        return paths
    loop_home = LOOP_HOME.as_posix()
    loop_prefix = f"{loop_home}/"
    legacy_root = LEGACY_LOOP_DIR.as_posix()
    legacy_prefix = legacy_root + "/"
    return [
        path
        for path in paths
        if path != loop_home
        and not path.startswith(loop_prefix)
        and path != legacy_root
        and not path.startswith(legacy_prefix)
    ]


def active_preflight_environment_block(state: dict[str, Any]) -> bool:
    error = state.get("last_preflight_error")
    return (
        str(state.get("phase") or "") == "blocked_environment"
        and isinstance(error, dict)
        and error.get("source") == "preflight"
        and not error.get("resolved_at")
    )


def mark_blocked_environment(repo: Path, state: dict[str, Any], reason: str) -> None:
    previous_error = state.get("last_preflight_error")
    previous_phase = str(state.get("phase") or "dispatching")
    if active_preflight_environment_block(state) and isinstance(previous_error, dict):
        previous_phase = str(previous_error.get("previous_phase") or "dispatching")
    state["phase"] = "blocked_environment"
    state["last_preflight_error"] = {
        "at": now_iso(),
        "reason": reason,
        "source": "preflight",
        "previous_phase": previous_phase,
    }
    save_state(repo, state)
    journal(repo, f"Blocked by preflight: {reason}")


def recover_preflight_environment_block(repo: Path, state: dict[str, Any]) -> bool:
    if not active_preflight_environment_block(state):
        return False
    error = state["last_preflight_error"]
    recovered_phase = str(error.get("previous_phase") or "dispatching")
    state["phase"] = recovered_phase
    error["resolved_at"] = now_iso()
    error["resolved_phase"] = recovered_phase
    save_state(repo, state)
    journal(repo, f"Recovered preflight environment blocker; restored phase `{recovered_phase}`.")
    return True


def preflight_loop(
    repo: Path,
    *,
    require_herdr: bool = False,
    require_codex: bool = False,
    require_agent_provider: str | None = None,
    require_agent_invocation: hloop_providers.ProviderInvocation | None = None,
    require_integration_branch: bool = False,
    allow_loop_dirty: bool = True,
    skip_dirty_check: bool = False,
    mark_blocked: bool = True,
) -> dict[str, Any]:
    state = load_state(repo)

    def fail(reason: str, *, persist: bool = True) -> None:
        if mark_blocked and persist:
            mark_blocked_environment(repo, state, reason)
        raise HLoopError(reason)

    try:
        state_schema = schema_version_of(state)
    except MigrationError as exc:
        fail(f"invalid state schema marker: {exc}", persist=False)
        raise AssertionError("unreachable")
    if state_schema < RUNTIME_SCHEMA_VERSION:
        fail(
            f"state migration required: {state_schema.label()} "
            f"runtime={RUNTIME_SCHEMA_VERSION.label()}; run `hloop migrate --dry-run` "
            "then `hloop migrate --apply`"
        )
    if state_schema > RUNTIME_SCHEMA_VERSION:
        fail(
            f"state {state_schema.label()} is newer than runtime "
            f"{RUNTIME_SCHEMA_VERSION.label()}; mutating commands are disabled",
            persist=False,
        )

    if not command_exists("git"):
        fail("git command not found")
    recorded_identity = state.get("git_identity")
    if isinstance(recorded_identity, dict) and recorded_identity:
        try:
            current_identity = resolve_git_binary_fingerprint()
        except HLoopError as exc:
            fail(f"git identity probe failed: {exc}")
            raise AssertionError("unreachable")
        drift = git_identity_drift(recorded_identity, current_identity)
        if drift:
            fail(
                "git executable identity drift detected: "
                f"{drift}; run `hloop runtime trust-git --reason <text>` to accept it"
            )
    elif mark_blocked:
        # Legacy STATE created before identity tracking existed: record the
        # currently-trusted executable instead of retroactively blocking.
        state["git_identity"] = git_executable_identity()
    if require_herdr:
        if os.environ.get("HERDR_ENV") != "1":
            fail("HERDR_ENV=1 is required")
        if not command_exists("herdr"):
            fail("herdr command not found")
        try:
            state["last_storage_preflight"] = {
                "at": now_iso(),
                "filesystems": storage_preflight(repo, state),
            }
        except HLoopError as exc:
            fail(str(exc))
    if require_codex and not command_exists("codex"):
        fail("codex command not found")
    if require_agent_invocation is not None:
        # Probe the exact role invocation the caller is about to launch (same
        # runner/model/effort/permission/sandbox/argv), so preflight evidence
        # and `last_provider_preflight.argv` describe the real launch, not a
        # generic stand-in that can pass while the real configuration cannot.
        capability = hloop_providers.probe_provider_capability(require_agent_invocation)
        state["last_provider_preflight"] = {
            "at": now_iso(),
            **capability.as_record(),
        }
        if not capability.launch_allowed:
            fail(capability.reason)
    elif require_agent_provider:
        provider = normalize_agent_provider(require_agent_provider)
        invocation = hloop_providers.build_provider_invocation(
            provider=provider,
            runner="tui",
            sandbox="workspace-write",
            prompt_path=repo / LOOP_DIR / "prompts" / "_preflight-probe.md",
        )
        capability = hloop_providers.probe_provider_capability(invocation)
        state["last_provider_preflight"] = {
            "at": now_iso(),
            **capability.as_record(),
        }
        if not capability.launch_allowed:
            fail(capability.reason)
    if require_integration_branch:
        expected = str(state.get("integration_branch") or "")
        actual = current_branch(repo)
        if not expected:
            fail("integration_branch is missing from STATE.json")
        if actual != expected:
            fail(f"current branch must be integration branch {expected}; currently {actual}")
    if not skip_dirty_check:
        # A content-conflict or environment-failure merge transaction leaves the
        # working tree intentionally dirty (conflict markers, a partial squash
        # index).  Callers recovering an active transaction skip this blanket
        # check and rely on the transaction-aware preflight instead.
        dirty = unsafe_dirty_paths(repo, allow_loop_dirty=allow_loop_dirty)
        if dirty:
            fail("working tree has non-loop dirty files: " + ", ".join(dirty))
    if mark_blocked:
        recover_preflight_environment_block(repo, state)
    return state


def make_issue(
    severity: str,
    code: str,
    subject: str,
    message: str,
    action: str = "",
) -> dict[str, str]:
    return {
        "severity": severity,
        "code": code,
        "subject": subject,
        "message": message,
        "action": action,
    }


def issue_sort_key(item: dict[str, Any]) -> tuple[int, str, str]:
    return (
        ISSUE_SEVERITY_RANK.get(str(item.get("severity") or "P3"), 3),
        str(item.get("subject") or ""),
        str(item.get("code") or ""),
    )


def safe_current_branch(repo: Path) -> str:
    try:
        return current_branch(repo)
    except HLoopError:
        return ""


def safe_short_sha(repo: Path, ref: str) -> str:
    if not ref:
        return ""
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "rev-parse", "--short", ref], check=False)
    if proc.returncode != 0:
        return ""
    return (proc.stdout or "").strip()


def safe_porcelain_paths(repo: Path) -> list[str]:
    try:
        return porcelain_paths(repo)
    except HLoopError:
        return []


def safe_frontmatter(path: Path) -> tuple[dict[str, Any], str]:
    if not path.exists():
        return {}, "missing"
    try:
        text = read_text(path)
    except HLoopError as exc:
        return {}, f"read-error:{exc}"
    if not text.strip():
        return {}, "empty"
    try:
        return parse_frontmatter_text(text), "present"
    except HLoopError as exc:
        return {}, f"frontmatter-error:{exc}"


def safe_result_commit_state(worktree: Path, task_id: str, head_sha: str) -> str:
    rel = (LOOP_DIR / "results" / task_id / "result.md").as_posix()
    disk_path = worktree / rel
    if not disk_path.exists():
        return "missing"
    resolved_head = head_sha
    if not resolved_head or resolved_head == "HEAD":
        proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(worktree), "rev-parse", "HEAD"], check=False)
        if proc.returncode != 0:
            return "head-unreadable"
        resolved_head = (proc.stdout or "").strip()
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(worktree), "show", f"{resolved_head}:{rel}"], check=False)
    if proc.returncode != 0:
        return "not-committed"
    try:
        disk = read_text(disk_path)
    except HLoopError:
        return "disk-unreadable"
    return "committed" if (proc.stdout or "") == disk else "mismatch"


def pane_marker(role: str, agent_id: str) -> str:
    if role == "worker":
        return f"HERDR_LOOP_TASK_DONE:{agent_id}:"
    if role == "reviewer":
        return f"HERDR_LOOP_REVIEW_DONE:{agent_id}:"
    if role == "gap":
        return f"HERDR_LOOP_GAP_DONE:{agent_id}:"
    if role == "advisor":
        advice_id, participant_id = split_advice_target(agent_id)
        return f"HERDR_LOOP_ADVICE_DONE:{advice_id}:{participant_id}:"
    return ""


def terminal_status_from_text(
    text: str,
    *,
    run_id: str,
    agent_id: str,
    attempt_id: str,
) -> str:
    pattern = re.compile(
        rf"HERDR_LOOP_ROLE_DONE:{re.escape(run_id)}:{re.escape(agent_id)}:"
        rf"{re.escape(attempt_id)}:(done|reported|aligned|gaps-found|blocked|failed|partial)"
    )
    matches = pattern.findall(text)
    return matches[-1] if matches else ""


def pane_snapshot(
    pane_id: str,
    *,
    role: str,
    agent_id: str,
    lines: int = 80,
    include_output: bool = False,
) -> dict[str, Any]:
    snapshot: dict[str, Any] = {
        "pane_id": pane_id,
        "available": False,
        "present": False,
        "signals": [],
    }
    if not pane_id:
        snapshot["reason"] = "none"
        return snapshot
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        snapshot["reason"] = "not-in-herdr"
        return snapshot
    snapshot["available"] = True
    info = pane_info(pane_id)
    if info is None:
        snapshot["reason"] = "missing-or-closed"
        return snapshot
    snapshot["present"] = True
    snapshot["agent"] = info.get("agent", "")
    snapshot["agent_status"] = info.get("agent_status", "unknown")
    session_id = extract_agent_session_id(info)
    if session_id:
        snapshot["agent_session_id"] = session_id
        snapshot["codex_session_id"] = session_id
    text = pane_text(pane_id, max(1, lines))
    marker = pane_marker(role, agent_id)
    signals: list[str] = []
    if marker and marker in text:
        signals.append("done-marker")
    if "Do you trust the contents of this directory?" in text:
        signals.append("trust-prompt")
    if "Do you trust the files in this folder?" in text:
        signals.append("trust-prompt")
    if "Press enter to continue" in text:
        signals.append("press-enter")
    if "esc to interrupt" in text or "• Working" in text:
        signals.append("working-text")
    if "command not found" in text and "hloop" in text:
        signals.append("hloop-command-not-found")
    if contains_dangerous_agent_marker(text):
        signals.append("dangerous-agent-command")
    if include_output:
        snapshot["output_tail"] = text
    snapshot["signals"] = signals
    return snapshot


def pane_issue_for_running(
    role: str,
    agent_id: str,
    pane: dict[str, Any],
) -> dict[str, str] | None:
    subject = f"{role}:{agent_id}"
    pane_id = str(pane.get("pane_id") or "")
    watch_cmd = f"hloop {role} watch {agent_id}" if role != "worker" else f"hloop worker watch {agent_id}"
    if pane_id and pane.get("reason") == "not-in-herdr":
        return None
    if pane_id and not pane.get("present"):
        return make_issue(
            "P1",
            "pane-missing",
            subject,
            f"Running {role} has no readable Herdr pane: {pane_id}",
            f"Check artifact/worktree, then harvest or restart {agent_id}.",
        )
    signals = set(normalize_list(pane.get("signals")))
    if "trust-prompt" in signals:
        return make_issue(
            "P1",
            "codex-trust-prompt",
            subject,
            f"{role} pane is waiting at the Codex trust prompt.",
            f"Inspect with `{watch_cmd}` and resolve the trust prompt before continuing.",
        )
    if "dangerous-agent-command" in signals:
        return make_issue(
            "P0",
            "dangerous-agent-command",
            subject,
            f"{role} pane output contains a dangerous Codex launch marker.",
            "Stop this pane and recreate the agent through hloop with workspace-write sandbox.",
        )
    if "press-enter" in signals:
        return make_issue(
            "P2",
            "codex-press-enter",
            subject,
            f"{role} pane appears to be waiting for Enter.",
            f"Inspect with `{watch_cmd}` before sending follow-up instructions.",
        )
    status = str(pane.get("agent_status") or "")
    if status in {"blocked", "error", "failed"}:
        return make_issue(
            "P1",
            "agent-blocked",
            subject,
            f"{role} pane agent_status is `{status}`.",
            f"Inspect with `{watch_cmd}` and send a Manager message or restart if needed.",
        )
    if status in {"idle", "done", "complete"}:
        return make_issue(
            "P2",
            "agent-idle",
            subject,
            f"{role} pane is `{status}` but no artifact has been harvested yet.",
            f"Inspect with `{watch_cmd}` and harvest if the artifact exists.",
        )
    return None


def worktree_state(path_raw: Any) -> dict[str, Any]:
    if not path_raw:
        return {"path": "", "exists": False}
    path = Path(str(path_raw)).resolve()
    return {
        "path": str(path),
        "exists": path.exists(),
        "dirty_files": safe_porcelain_paths(path) if path.exists() else [],
    }


def contains_dangerous_agent_marker(value: Any) -> bool:
    if isinstance(value, dict):
        return any(contains_dangerous_agent_marker(item) for item in value.values())
    if isinstance(value, (list, tuple, set)):
        return any(contains_dangerous_agent_marker(item) for item in value)
    text = str(value or "").lower()
    return any(marker in text for marker in DANGEROUS_AGENT_MARKERS)


def expected_prompt_fragment(role: str, agent_id: str) -> str:
    if role == "advisor":
        advice_id, participant_id = split_advice_target(agent_id)
        return f"{LOOP_DIR.as_posix()}/prompts/{advice_id}-{participant_id}.advisor.md"
    suffix = {"worker": "worker", "reviewer": "reviewer", "gap": "gap"}.get(role, role)
    return f"{LOOP_DIR.as_posix()}/prompts/{agent_id}.{suffix}.md"


def prompt_matches_hloop_contract(role: str, agent_id: str, prompt_raw: Any) -> bool:
    prompt = str(prompt_raw or "").replace("\\", "/")
    return bool(prompt) and expected_prompt_fragment(role, agent_id) in prompt


def path_under_repo_loop_results(repo: Path, path_raw: Any) -> bool:
    if not path_raw:
        return False
    path = Path(str(path_raw))
    if not path.is_absolute():
        path = repo / path
    try:
        resolved = path.resolve()
        results_root = (repo / LOOP_DIR / "results").resolve()
    except OSError:
        return False
    return resolved == results_root or results_root in resolved.parents


def agent_contract_issues(
    repo: Path,
    *,
    role: str,
    agent_id: str,
    agent: dict[str, Any],
) -> list[dict[str, str]]:
    subject = f"{role}:{agent_id}"
    issues: list[dict[str, str]] = []
    status = str(agent.get("status") or "")
    gate_status = agent_gate_status(agent)
    active_status = status in {"running", "result_reported", "reported", "reported_unharvested"} or gate_status in {
        "running",
        "reported",
        "reported_unharvested",
        "paused_untriaged",
    }

    sandbox = str(agent.get("sandbox") or "")
    if sandbox and sandbox != "workspace-write":
        severity = "P0" if contains_dangerous_agent_marker(sandbox) else "P1"
        issues.append(
            make_issue(
                severity,
                "unsafe-agent-sandbox",
                subject,
                f"{role} state records non-standard sandbox `{sandbox}`.",
                "Stop the agent if it is still running; restart through hloop so it uses workspace-write.",
            )
        )

    command_like = {
        key: agent.get(key)
        for key in ("argv", "command", "runner_command", "launch_command", "codex_command")
        if key in agent
    }
    if command_like and contains_dangerous_agent_marker(command_like):
        issues.append(
            make_issue(
                "P0",
                "dangerous-agent-command",
                subject,
                f"{role} state contains a dangerous Codex launch marker.",
                "Stop the pane and recreate the agent with hloop; do not continue from this run.",
            )
        )

    if active_status:
        prompt = str(agent.get("prompt") or "")
        if not prompt:
            issues.append(
                make_issue(
                    "P1",
                    "missing-hloop-prompt",
                    subject,
                    f"{role} is active but STATE.json has no hloop prompt path.",
                    f"Use hloop {role if role != 'reviewer' else 'reviewer'} watch {agent_id}; restart through hloop if the pane was started manually.",
                )
            )
        elif not prompt_matches_hloop_contract(role, agent_id, prompt):
            issues.append(
                make_issue(
                    "P1",
                    "non-hloop-prompt",
                    subject,
                    f"{role} prompt path does not match the hloop prompt contract: {prompt}",
                    "Treat this as a suspected manual launch; harvest only if the artifact passes hloop validation, otherwise restart.",
                )
            )

    state_fragments = [
        str(agent.get("status") or ""),
        str(agent.get("gate_status") or ""),
        str(agent.get("artifact_status") or ""),
    ]
    if any("unharvested" in fragment for fragment in state_fragments):
        issues.append(
            make_issue(
                "P1",
                "unharvested-artifact-state",
                subject,
                f"{role} state records an unharvested artifact.",
                f"Run the matching hloop harvest command or keep the loop paused until Manager intentionally resumes.",
            )
        )

    if role == "worker":
        head_sha = str(agent.get("head_sha") or "").lower()
        if head_sha in SUSPICIOUS_WORKER_HEADS:
            issues.append(
                make_issue(
                    "P1",
                    "untrusted-worker-head",
                    subject,
                    f"Worker result uses non-commit head marker `{agent.get('head_sha')}`.",
                    "Do not merge this task; rerun the Worker or record an environment blocker.",
                )
            )
        integration_method = str(agent.get("integration_method") or "")
        if "manual" in integration_method or integration_method.startswith("manager_"):
            issues.append(
                make_issue(
                    "P1",
                    "manual-worker-integration",
                    subject,
                    f"Worker state records manual integration method `{integration_method}`.",
                    "Review this task before trusting final loop status; prefer hloop merge for future tasks.",
                )
            )
        if normalize_bool(agent.get("merge_ready")) and not agent.get("committed_result_path"):
            issues.append(
                make_issue(
                    "P1",
                    "merge-ready-without-committed-result",
                    subject,
                    "Worker is merge-ready but STATE.json has no committed_result_path.",
                    "Run hloop worker harvest again; do not merge until the result is committed at branch HEAD.",
                )
            )
        if (
            not artifact_was_harvested(agent)
            and path_under_repo_loop_results(repo, agent.get("result_path"))
            and str(agent.get("worktree") or "")
        ):
            issues.append(
                make_issue(
                    "P1",
                    "manager-owned-worker-result",
                    subject,
                    f"Worker result_path points at the Manager repo: {agent.get('result_path')}",
                    "Treat this as a suspected Manager-edited result; rerun or re-harvest from the Worker worktree.",
                )
            )
    return issues


def artifact_location_status(
    agent: dict[str, Any], artifact_path: Path, worktree: dict[str, Any]
) -> str:
    if not artifact_was_harvested(agent):
        return "active-worktree"
    if not artifact_path.is_file():
        return "unexpectedly-missing"
    if not worktree.get("exists") or normalize_bool(agent.get("cleanup_done")) or str(
        agent.get("worktree_cleanup_status") or ""
    ) == "removed":
        return "cleaned-after-harvest"
    return "harvested-manager"


def collect_worker_inventory(
    repo: Path,
    state: dict[str, Any],
    task_id: str,
    task: dict[str, Any],
    *,
    probe_panes: bool,
    lines: int,
    include_output: bool,
) -> dict[str, Any]:
    status = str(task.get("status") or "")
    branch = str(task.get("branch") or "")
    worktree_raw = task.get("worktree") or (
        str(default_worktree(repo, task_id, state)) if status in {"running", "result_reported"} else ""
    )
    worktree = worktree_state(worktree_raw)
    artifact_path = worker_artifact_path(repo, state, task_id, task)
    artifact_meta, artifact_state = safe_frontmatter(artifact_path)
    location_status = artifact_location_status(task, artifact_path, worktree)
    artifact: dict[str, Any] = {
        "path": str(artifact_path),
        "state": artifact_state,
        "location_status": location_status,
        "exists": artifact_state == "present",
        "status": str(artifact_meta.get("status") or task.get("result_status") or ""),
        "merge_ready": normalize_bool(artifact_meta.get("merge_ready", task.get("merge_ready"))),
        "validation_recorded": normalize_bool(
            artifact_meta.get("validation_recorded", task.get("validation_recorded"))
        ),
        "committed_path": str(task.get("committed_result_path") or ""),
    }
    if not artifact_was_harvested(task) and worktree["exists"] and artifact["exists"]:
        artifact["commit_state"] = safe_result_commit_state(
            Path(worktree["path"]),
            task_id,
            str(artifact_meta.get("head_sha") or task.get("head_sha") or "HEAD"),
        )
    elif artifact_was_harvested(task) and task.get("committed_result_path"):
        artifact["commit_state"] = "verified-at-harvest"
    artifact_ready_now, readiness_reason = artifact_readiness(
        repo, state, task_id, "worker", task, artifact_path
    )
    artifact["ready"] = artifact_ready_now
    artifact["readiness_reason"] = readiness_reason
    pane_id = str(task.get("pane_id") or "")
    pane = (
        pane_snapshot(
            pane_id,
            role="worker",
            agent_id=task_id,
            lines=lines,
            include_output=include_output,
        )
        if probe_panes and status == "running" and pane_id
        else {"pane_id": pane_id, "available": False, "present": False, "reason": "not-probed"}
    )
    issues: list[dict[str, str]] = []
    issues.extend(agent_contract_issues(repo, role="worker", agent_id=task_id, agent=task))
    if location_status == "unexpectedly-missing":
        issues.append(
            make_issue(
                "P1",
                "worker-artifact-unexpectedly-missing",
                f"worker:{task_id}",
                "Harvested Worker artifact is missing from the Manager loop path.",
                f"Re-harvest {task_id} from its immutable Worker head before relying on completion evidence.",
            )
        )
    if status == "running":
        if artifact["ready"]:
            issues.append(
                make_issue(
                    "P2",
                    "worker-result-ready",
                    f"worker:{task_id}",
                    f"Worker result artifact exists for running task {task_id}.",
                    f"hloop worker harvest {task_id}",
                )
            )
        else:
            pane_issue = pane_issue_for_running("worker", task_id, pane)
            if pane_issue:
                issues.append(pane_issue)
    if status == "result_reported":
        if artifact.get("commit_state") in {"not-committed", "mismatch"}:
            issues.append(
                make_issue(
                    "P1",
                    "worker-result-not-committed",
                    f"worker:{task_id}",
                    f"Worker result commit state is `{artifact.get('commit_state')}`.",
                    f"Ask Worker {task_id} to commit the result artifact before merge.",
                )
            )
        elif artifact["merge_ready"]:
            issues.append(
                make_issue(
                    "P2",
                    "worker-merge-ready",
                    f"worker:{task_id}",
                    f"Worker {task_id} is merge-ready.",
                    f"hloop merge {task_id}",
                )
            )
        else:
            issues.append(
                make_issue(
                    "P1",
                    "worker-result-not-merge-ready",
                    f"worker:{task_id}",
                    f"Worker {task_id} reported a result that is not merge-ready.",
                    "Create a fix task, rerun the Worker, or record the blocker.",
                )
            )
    if status in {"partial", "blocked", "failed", "abandoned"}:
        issues.append(
            make_issue(
                "P1",
                "worker-terminal-not-merged",
                f"worker:{task_id}",
                f"Worker {task_id} ended with status `{status}`.",
                "Create a fix task, rerun the Worker, or record the blocker.",
            )
        )
    return {
        "id": task_id,
        "role": "worker",
        "status": status,
        "branch": branch,
        "branch_exists": branch_exists(repo, branch) if branch else False,
        "worktree": worktree,
        "pane": pane,
        "artifact": artifact,
        "merge_ready": normalize_bool(task.get("merge_ready")),
        "validation_recorded": normalize_bool(task.get("validation_recorded")),
        "cleanup_done": normalize_bool(task.get("cleanup_done")),
        "issues": issues,
    }


def collect_gate_inventory(
    repo: Path,
    state: dict[str, Any],
    agent_id: str,
    agent: dict[str, Any],
    *,
    role: str,
    probe_panes: bool,
    lines: int,
    include_output: bool,
) -> dict[str, Any]:
    status = str(agent.get("status") or "")
    gate_status = agent_gate_status(agent)
    artifact_path = (
        review_artifact_path(repo, agent_id, agent)
        if role == "reviewer"
        else gap_artifact_path(repo, agent_id, agent)
    )
    worktree = worktree_state(agent.get("worktree"))
    location_status = artifact_location_status(agent, artifact_path, worktree)
    artifact_meta, artifact_state = safe_frontmatter(artifact_path)
    artifact_ready_now, readiness_reason = artifact_readiness(
        repo, state, agent_id, role, agent, artifact_path
    )
    pane_id = str(agent.get("pane_id") or "")
    pane = (
        pane_snapshot(
            pane_id,
            role=role,
            agent_id=agent_id,
            lines=lines,
            include_output=include_output,
        )
        if probe_panes and gate_status == "running" and pane_id
        else {"pane_id": pane_id, "available": False, "present": False, "reason": "not-probed"}
    )
    issues: list[dict[str, str]] = []
    issues.extend(agent_contract_issues(repo, role=role, agent_id=agent_id, agent=agent))
    if location_status == "unexpectedly-missing":
        issues.append(
            make_issue(
                "P1",
                f"{role}-artifact-unexpectedly-missing",
                f"{role}:{agent_id}",
                f"Harvested {role} artifact is missing from the Manager loop path.",
                "Restore or re-harvest the canonical Manager artifact before closing the gate.",
            )
        )
    gate_name = "review" if role == "reviewer" else "gap"
    if gate_status == "running":
        if artifact_ready_now:
            issues.append(
                make_issue(
                    "P2",
                    f"{gate_name}-artifact-ready",
                    f"{role}:{agent_id}",
                    f"{role} artifact exists and can be harvested.",
                    f"hloop {gate_name if role == 'gap' else 'reviewer'} harvest {agent_id}",
                )
            )
        else:
            pane_issue = pane_issue_for_running(role, agent_id, pane)
            if pane_issue:
                issues.append(pane_issue)
    if gate_status == "reported":
        issues.append(
            make_issue(
                "P1",
                f"{gate_name}-triage-required",
                f"{role}:{agent_id}",
                f"{role} {agent_id} has been harvested and needs Manager triage.",
                f"hloop triage {gate_name} {agent_id}",
            )
        )
    if gate_status == "blocked_write_scope":
        issues.append(
            make_issue(
                "P1",
                f"{gate_name}-write-scope-violation",
                f"{role}:{agent_id}",
                f"{role} {agent_id} changed files outside its artifact.",
                "Inspect USER_ACTION_REQUIRED.md and the detached worktree before closing the gate.",
            )
        )
    return {
        "id": agent_id,
        "role": role,
        "status": status,
        "gate_status": gate_status,
        "artifact_status": str(agent.get("artifact_status") or artifact_meta.get("status") or ""),
        "base": str(agent.get("base") or ""),
        "head": str(agent.get("head") or ""),
        "worktree": worktree,
        "pane": pane,
        "artifact": {
            "path": str(artifact_path),
            "state": artifact_state,
            "location_status": location_status,
            "exists": artifact_state == "present",
            "ready": artifact_ready_now,
            "readiness_reason": readiness_reason,
            "frontmatter": artifact_meta,
        },
        "issues": issues,
    }


def collect_advice_inventory(
    repo: Path,
    state: dict[str, Any],
    advice_id: str,
    advice: dict[str, Any],
    *,
    probe_panes: bool,
    lines: int,
    include_output: bool,
) -> list[dict[str, Any]]:
    items = []
    for participant in advice.get("participants", []):
        participant_id = str(participant.get("participant_id") or "P1")
        combined_id = f"{advice_id}/{participant_id}"
        status = str(participant.get("status") or "")
        gate_status = agent_gate_status(participant)
        artifact_path = advice_artifact_path(repo, advice_id, participant)
        participant_worktree = worktree_state(participant.get("worktree"))
        location_status = artifact_location_status(
            participant, artifact_path, participant_worktree
        )
        artifact_meta, artifact_state = safe_frontmatter(artifact_path)
        artifact_ready_now, readiness_reason = artifact_readiness(
            repo, state, combined_id, "advisor", participant, artifact_path
        )
        pane_id = str(participant.get("pane_id") or "")
        pane = (
            pane_snapshot(
                pane_id,
                role="advisor",
                agent_id=combined_id,
                lines=lines,
                include_output=include_output,
            )
            if probe_panes and gate_status == "running" and pane_id
            else {"pane_id": pane_id, "available": False, "present": False, "reason": "not-probed"}
        )
        issues: list[dict[str, str]] = []
        issues.extend(agent_contract_issues(repo, role="advisor", agent_id=combined_id, agent=participant))
        if location_status == "unexpectedly-missing":
            issues.append(
                make_issue(
                    "P1",
                    "advisor-artifact-unexpectedly-missing",
                    f"advisor:{combined_id}",
                    "Harvested Advisor artifact is missing from the Manager loop path.",
                    "Restore or re-harvest the canonical Manager artifact before closing the request.",
                )
            )
        if gate_status == "running":
            if artifact_ready_now:
                issues.append(
                    make_issue(
                        "P2",
                        "advisor-artifact-ready",
                        f"advisor:{combined_id}",
                        f"Advisor artifact exists and can be harvested.",
                        f"hloop harvest {combined_id}",
                    )
                )
            else:
                pane_issue = pane_issue_for_running("advisor", combined_id, pane)
                if pane_issue:
                    issues.append(pane_issue)
        if gate_status == "reported":
            issues.append(
                make_issue(
                    "P2",
                    "advisor-manager-review-required",
                    f"advisor:{combined_id}",
                    f"Advisor {combined_id} has been harvested and needs Manager review.",
                    f"hloop advisor close {advice_id} --verdict <verdict> --reason ...",
                )
            )
        items.append(
            {
                "id": combined_id,
                "role": "advisor",
                "status": status,
                "gate_status": gate_status,
                "artifact_status": str(participant.get("artifact_status") or artifact_meta.get("status") or ""),
                "provider": str(participant.get("agent_provider") or participant.get("provider") or ""),
                "model": str(participant.get("agent_model") or participant.get("model") or ""),
                "topic": str(advice.get("topic") or ""),
                "worktree": participant_worktree,
                "pane": pane,
                "artifact": {
                    "path": str(artifact_path),
                    "state": artifact_state,
                    "location_status": location_status,
                    "exists": artifact_state == "present",
                    "ready": artifact_ready_now,
                    "readiness_reason": readiness_reason,
                    "frontmatter": artifact_meta,
                },
                "issues": issues,
            }
        )
    return items


def decision_records_from_state(state: dict[str, Any]) -> dict[str, DecisionRecord]:
    """Parse ``state["decisions"]`` into validated records, skipping bad entries.

    Malformed records must never crash dashboard/status reporting; they are
    dropped from the returned mapping (the raw dict is still visible via
    ``hloop decision list`` / ``STATE.json`` for debugging).
    """

    records: dict[str, DecisionRecord] = {}
    for decision_id, raw in (state.get("decisions") or {}).items():
        try:
            record = DecisionRecord.from_record(raw)
        except DecisionValidationError:
            continue
        records[decision_id] = record
    return records


def pending_blocking_user_decisions(state: dict[str, Any]) -> dict[str, DecisionRecord]:
    """Unresolved ``blocking-user`` decisions, keyed by decision id."""

    return {
        decision_id: record
        for decision_id, record in decision_records_from_state(state).items()
        if record.blocks_affected_tasks
    }


def build_decision_scheduler(state: dict[str, Any]) -> "hloop_decisions.SchedulerDecision":
    """Evaluate decision-aware, partial-blocking dispatch for the current state.

    ``loop_blocked`` is only true when every queued task is blocked by a
    pending/answered ``blocking-user`` decision and no other safe work
    (running/reported tasks, in-flight review or gap agents, a merge-ready
    task, or pending validation) is available to the Manager.
    """

    tasks_map = state.get("tasks") or {}
    decisions_map = state.get("decisions") or {}
    safe_work_remaining = bool(
        running_review_exists(state)
        or running_gap_exists(state)
        or pending_review_exists(state)
        or pending_gap_exists(state)
        or state.get("needs_validation")
        or any(
            task.get("status") == "result_reported" and task.get("merge_ready")
            for task in tasks_map.values()
        )
    )
    try:
        return decision_aware_dispatch(
            tasks_map, decisions_map, safe_work_remaining=safe_work_remaining
        )
    except (DecisionValidationError, DecisionTransitionError) as exc:
        raise HLoopError(f"invalid decision state: {exc}") from exc


def collect_loop_inventory(
    repo: Path,
    *,
    probe_panes: bool = True,
    lines: int = 80,
    include_output: bool = False,
) -> dict[str, Any]:
    state = load_state(repo)
    current = safe_current_branch(repo)
    integration = str(state.get("integration_branch") or "")
    base = str(state.get("base_branch") or "")
    unsafe_dirty = unsafe_dirty_paths(repo, allow_loop_dirty=True)
    issues: list[dict[str, str]] = []
    if unsafe_dirty:
        issues.append(
            make_issue(
                "P1",
                "non-loop-dirty-files",
                "repo",
                "Working tree has non-loop dirty files: " + ", ".join(unsafe_dirty),
                "Commit/stash/revert unrelated files before mutating the loop.",
            )
        )
    if integration and current and current != integration:
        issues.append(
            make_issue(
                "P1",
                "integration-branch-mismatch",
                "repo",
                f"Current branch is `{current}`, expected integration branch `{integration}`.",
                f"git switch {integration}",
            )
        )
    pending_blocking_decisions = pending_blocking_user_decisions(state)
    if pending_blocking_decisions:
        affected = sorted(
            {
                task_id
                for record in pending_blocking_decisions.values()
                for task_id in record.affected_task_ids
            }
        )
        issues.append(
            make_issue(
                "P1",
                "blocking-decisions",
                "state",
                (
                    f"STATE.json has {len(pending_blocking_decisions)} pending "
                    "blocking-user decision(s) "
                    f"({', '.join(sorted(pending_blocking_decisions))}) affecting "
                    f"task(s) {', '.join(affected) if affected else '(none)'}."
                ),
                "Respond with `hloop decision respond` and resolve with "
                "`hloop decision resolve` before dispatching affected tasks.",
            )
        )
    phase = str(state.get("phase") or "")
    if phase in {"blocked_user_decision", "blocked_environment", "blocked_conflict", "failed_validation", "failed_manager_qa", "no_progress"}:
        issues.append(
            make_issue(
                "P1",
                "blocked-phase",
                "state",
                f"Loop phase is `{phase}`.",
                "Inspect JOURNAL.md, USER_ACTION_REQUIRED.md, and hloop dashboard output.",
            )
        )
    integration_target = current_integration_target(repo, state)
    final_target = str(state.get("final_target_sha") or "")
    drift = diagnose_done_target_drift(
        phase=phase,
        final_target_sha=final_target,
        current_target_sha=integration_target,
        commit_count=advancing_commit_count(repo, final_target, integration_target),
    )
    if drift is not None:
        issues.append(
            make_issue(
                str(drift.severity),
                str(drift.code),
                "completion-target",
                str(drift.message),
                "Start a new run or explicitly supersede the completed run; do not reuse stale evidence.",
            )
        )
    final_gate = final_gate_from_state(state)
    if isinstance(state.get("final_gate"), dict) and final_gate is None:
        issues.append(
            make_issue(
                "P1",
                "final-gates-record-invalid",
                "final-gates",
                "STATE.json contains an invalid final gate record.",
                "Inspect the migration and final-gates history before finishing.",
            )
        )
    elif final_gate is not None:
        for item in validate_final_gate_arm(
            final_gate, current_target_sha=integration_target
        ).issues:
            issues.append(
                make_issue(
                    "P1",
                    item.code,
                    item.subject or "final-gates",
                    item.message,
                    "Create or finish the new task, then arm final gates again for the current target.",
                )
            )
    resume_requirements = lifecycle_resume_requirements(repo, state) if phase == "paused" else []
    for item in resume_requirements:
        issues.append(
            make_issue(
                "P1",
                f"resume-{item['code']}",
                item["subject"] or "resume",
                item["reason"],
                "Refresh the named gate or resolve the blocker before `hloop resume`.",
            )
        )
    workers = [
        collect_worker_inventory(
            repo,
            state,
            task_id,
            task,
            probe_panes=probe_panes,
            lines=lines,
            include_output=include_output,
        )
        for task_id, task in state.get("tasks", {}).items()
    ]
    reviewers = [
        collect_gate_inventory(
            repo,
            state,
            review_id,
            review,
            role="reviewer",
            probe_panes=probe_panes,
            lines=lines,
            include_output=include_output,
        )
        for review_id, review in state.get("reviews", {}).items()
    ]
    gaps = [
        collect_gate_inventory(
            repo,
            state,
            gap_id,
            gap,
            role="gap",
            probe_panes=probe_panes,
            lines=lines,
            include_output=include_output,
        )
        for gap_id, gap in state.get("gaps", {}).items()
    ]
    advisors = []
    for advice_id, advice in state.get("advice", {}).items():
        if isinstance(advice, dict):
            advisors.extend(
                collect_advice_inventory(
                    repo,
                    state,
                    advice_id,
                    advice,
                    probe_panes=probe_panes,
                    lines=lines,
                    include_output=include_output,
                )
            )
    for collection in (workers, reviewers, gaps, advisors):
        for item in collection:
            issues.extend(item.get("issues", []))
    issues = sorted(issues, key=issue_sort_key)
    next_actions = []

    def add_next_action(action: str) -> None:
        if action and action not in next_actions:
            next_actions.append(action)

    if phase not in RUN_TERMINAL_PHASES:
        for item in issues:
            add_next_action(item.get("action", ""))
        if state.get("needs_gap_check") and not pending_gap_exists(state):
            add_next_action("hloop gap start")
        if state.get("needs_review") and not pending_review_exists(state):
            add_next_action("hloop reviewer start")
        if last_validation_passed(state) and should_open_gap_gate(state):
            add_next_action("hloop tick --once # open gap gate")
        if last_validation_passed(state) and should_open_review_gate(state):
            add_next_action("hloop tick --once # open review gate")
    running_workers = [item["id"] for item in workers if item.get("status") == "running"]
    running_reviewers = [item["id"] for item in reviewers if item.get("gate_status") == "running"]
    running_gaps = [item["id"] for item in gaps if item.get("gate_status") == "running"]
    running_advisors = [item["id"] for item in advisors if item.get("gate_status") == "running"]
    inventory = {
        "repo": str(repo),
        "generated_at": now_iso(),
        "loop": {
            "goal_id": state.get("goal_id"),
            "phase": phase,
            "cycle": state.get("cycle", 0),
            "base_branch": base,
            "base_sha": safe_short_sha(repo, base),
            "integration_branch": integration,
            "integration_sha": safe_short_sha(repo, integration),
            "integration_target_sha": integration_target,
            "final_target_sha": final_target,
            "final_gate": final_gate.to_record() if final_gate else state.get("final_gate"),
            "resume_requirements": resume_requirements,
            "current_branch": current,
            "branch_strategy": state_value(state, "branch_strategy", DEFAULT_BRANCH_STRATEGY),
            "worker_protocol": state_value(state, "worker_protocol", DEFAULT_WORKER_PROTOCOL),
            "review_protocol": state_value(state, "review_protocol", DEFAULT_REVIEW_PROTOCOL),
            "worker_qa_profile": state_worker_qa_profile(state),
            "manager_qa_profile": state_manager_qa_profile(state),
            "manager_qa_status": state.get("manager_qa_status", ""),
            "current_batch_id": current_batch_id(state),
            "needs_validation": normalize_bool(state.get("needs_validation")),
            "needs_review": normalize_bool(state.get("needs_review")),
            "needs_gap_check": normalize_bool(state.get("needs_gap_check")),
            "review_queue": {
                "count": normalize_int(state.get("unreviewed_merge_count"), 0),
                "threshold": review_after_merges(state),
            },
            "gap_queue": {
                "count": normalize_int(state.get("ungapped_merge_count"), 0),
                "threshold": gap_after_merges(state),
            },
        },
        "counts": {
            "workers": len(workers),
            "workers_running": len(running_workers),
            "workers_queued": sum(1 for item in workers if item.get("status") == "queued"),
            "workers_merge_ready": sum(
                1 for item in workers if item.get("status") == "result_reported" and item.get("artifact", {}).get("merge_ready")
            ),
            "batches": len(state_batches(state)),
            "reviewers": len(reviewers),
            "reviewers_running": len(running_reviewers),
            "reviewers_reported": sum(1 for item in reviewers if item.get("gate_status") == "reported"),
            "gaps": len(gaps),
            "gaps_running": len(running_gaps),
            "gaps_reported": sum(1 for item in gaps if item.get("gate_status") == "reported"),
            "advisors": len(advisors),
            "advisors_running": len(running_advisors),
            "advisors_reported": sum(1 for item in advisors if item.get("gate_status") == "reported"),
            "issues": len(issues),
            "p0_p1_issues": sum(1 for item in issues if item.get("severity") in {"P0", "P1"}),
        },
        "workers": workers,
        "reviewers": reviewers,
        "gaps": gaps,
        "advisors": advisors,
        "issues": issues,
        "next_actions": next_actions,
        "herdr": {
            "available": os.environ.get("HERDR_ENV") == "1" and command_exists("herdr"),
            "HERDR_ENV": os.environ.get("HERDR_ENV"),
            "HERDR_PANE_ID": os.environ.get("HERDR_PANE_ID"),
            "HERDR_WORKSPACE_ID": os.environ.get("HERDR_WORKSPACE_ID"),
        },
        "state": state,
    }
    return inventory


def validate_reviewer_worktree_scope(
    review_id: str,
    review_state: dict[str, Any],
    worktree: Path,
) -> list[str]:
    allowed = {str((LOOP_DIR / "prompts" / f"{review_id}.reviewer.md").as_posix())}
    if is_directory_review(review_state):
        allowed.update(
            {
                str((LOOP_DIR / "reviews" / review_id / "MANIFEST.json").as_posix()),
                str((LOOP_DIR / "reviews" / review_id / "FINAL.md").as_posix()),
                *{
                    str(
                        (
                            LOOP_DIR
                            / "reviews"
                            / review_id
                            / "providers"
                            / f"{provider}.md"
                        ).as_posix()
                    )
                    for provider in normalize_list(review_state.get("review_providers"))
                },
            }
        )
    else:
        allowed.add(str((LOOP_DIR / "reviews" / f"{review_id}.md").as_posix()))
    baseline = set(normalize_list(review_state.get("baseline_dirty_files")))
    violations = []
    for path in porcelain_paths(worktree):
        if path in baseline:
            continue
        if path not in allowed:
            violations.append(path)
    return violations


def validate_gap_worktree_scope(
    gap_id: str,
    gap_state: dict[str, Any],
    worktree: Path,
) -> list[str]:
    allowed = {
        str((LOOP_DIR / "gaps" / f"{gap_id}.md").as_posix()),
        str((LOOP_DIR / "prompts" / f"{gap_id}.gap.md").as_posix()),
    }
    baseline = set(normalize_list(gap_state.get("baseline_dirty_files")))
    violations = []
    for path in porcelain_paths(worktree):
        if path in baseline:
            continue
        if path not in allowed:
            violations.append(path)
    return violations


def validate_advisor_worktree_scope(
    advice_id: str,
    participant: dict[str, Any],
    worktree: Path,
) -> list[str]:
    participant_id = str(participant.get("participant_id") or "P1")
    allowed = {
        str((LOOP_DIR / "advice" / f"{advice_id}-{participant_id}.md").as_posix()),
        str((LOOP_DIR / "prompts" / f"{advice_id}-{participant_id}.advisor.md").as_posix()),
    }
    baseline = set(normalize_list(participant.get("baseline_dirty_files")))
    violations = []
    for path in porcelain_paths(worktree):
        if path in baseline:
            continue
        if path not in allowed:
            violations.append(path)
    return violations


def all_tasks_merged(state: dict[str, Any]) -> bool:
    tasks = state.get("tasks", {})
    return bool(tasks) and all(task.get("status") == "merged" for task in tasks.values())


def last_validation_passed(state: dict[str, Any]) -> bool:
    results = state.get("last_validation", {}).get("results", [])
    target = str(state.get("completion_target_sha") or state.get("integration_head_sha") or "")
    recorded = str(state.get("last_validation", {}).get("head_sha") or "")
    return bool(results) and (not target or recorded == target) and all(
        item.get("result") == "passed" for item in results
    )


def validation_result_failed(value: Any) -> bool:
    """Treat ``failed:<returncode>`` as failed without discarding the code."""

    result = str(value or "")
    return result == "failed" or result.startswith("failed:")


def running_review_exists(state: dict[str, Any]) -> bool:
    return any(agent_gate_status(review) == "running" for review in state.get("reviews", {}).values())


def running_gap_exists(state: dict[str, Any]) -> bool:
    return any(agent_gate_status(gap) == "running" for gap in state.get("gaps", {}).values())


def agent_gate_status(agent_state: dict[str, Any]) -> str:
    return str(agent_state.get("gate_status") or agent_state.get("status") or "")


def reported_review_exists(state: dict[str, Any]) -> bool:
    return any(agent_gate_status(review) == "reported" for review in state.get("reviews", {}).values())


def reported_gap_exists(state: dict[str, Any]) -> bool:
    return any(agent_gate_status(gap) == "reported" for gap in state.get("gaps", {}).values())


def pending_review_exists(state: dict[str, Any]) -> bool:
    return any(
        agent_gate_status(review) in {"running", "reported"}
        for review in state.get("reviews", {}).values()
    )


def pending_gap_exists(state: dict[str, Any]) -> bool:
    return any(
        agent_gate_status(gap) in {"running", "reported"}
        for gap in state.get("gaps", {}).values()
    )


def review_gate_passed(state: dict[str, Any]) -> bool:
    if int(state.get("max_reviewers", DEFAULT_MAX_REVIEWERS)) <= 0:
        return True
    if state.get("needs_review"):
        return False
    reviews = state.get("reviews", {})
    target = str(state.get("completion_target_sha") or state.get("integration_head_sha") or "")
    return any(
        agent_gate_status(review) == "triaged"
        and (not target or str(review.get("closed_head_sha") or review.get("head_sha") or "") == target)
        for review in reviews.values()
    )


def gap_gate_passed(state: dict[str, Any]) -> bool:
    if int(state.get("max_gap_auditors", DEFAULT_MAX_GAP_AUDITORS)) <= 0:
        return True
    if state.get("needs_gap_check"):
        return False
    gaps = state.get("gaps", {})
    target = str(state.get("completion_target_sha") or state.get("integration_head_sha") or "")
    return any(
        agent_gate_status(gap) == "triaged"
        and (not target or str(gap.get("closed_head_sha") or gap.get("head_sha") or "") == target)
        for gap in gaps.values()
    )


def current_integration_target(repo: Path, state: dict[str, Any]) -> str:
    branch = str(state.get("integration_branch") or "")
    if not branch:
        return ""
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "rev-parse", branch], check=False)
    return (proc.stdout or "").strip() if proc.returncode == 0 else ""


def advancing_commit_count(repo: Path, old_sha: str, new_sha: str) -> int | None:
    if not old_sha or not new_sha or not is_ancestor(repo, old_sha, new_sha):
        return None
    proc = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "rev-list", "--count", f"{old_sha}..{new_sha}"],
        check=False,
    )
    if proc.returncode != 0:
        return None
    try:
        return int((proc.stdout or "").strip())
    except ValueError:
        return None


def final_gate_from_state(state: dict[str, Any]) -> FinalGateArm | None:
    record = state.get("final_gate")
    if not isinstance(record, dict):
        return None
    try:
        return FinalGateArm(
            generation=normalize_int(record.get("generation"), 0),
            status=str(record.get("status") or ""),
            target_sha=str(record.get("target_sha") or ""),
            armed_at=str(record.get("armed_at") or ""),
            armed_by=str(record.get("armed_by") or ""),
            disarmed_at=str(record.get("disarmed_at") or ""),
            disarmed_by=str(record.get("disarmed_by") or ""),
            disarm_reason=str(record.get("disarm_reason") or ""),
        )
    except ValueError:
        return None


def final_gate_conditions(state: dict[str, Any]) -> FinalGateConditions:
    batches = state.get("batches", {})
    current_id = str(state.get("current_batch_id") or "")
    closed_batches = [
        batch
        for batch in batches.values()
        if isinstance(batch, dict) and str(batch.get("status") or "") in {"closed", "abandoned"}
    ]
    batch_closed = not current_id and bool(closed_batches)
    review_triage_complete = not any(
        agent_gate_status(review) in {"running", "reported", "reported_unharvested"}
        for review in state.get("reviews", {}).values()
    )
    return FinalGateConditions(
        current_batch_closed=batch_closed,
        review_triage_complete=review_triage_complete,
        pending_fix_task_drafts=tuple(normalize_list(state.get("pending_fix_task_drafts"))),
    )


def disarm_final_gate_for_new_task(state: dict[str, Any], task_id: str) -> None:
    current = final_gate_from_state(state)
    if current is None or current.status != "armed":
        return
    state["final_gate"] = disarm_final_gates(
        current,
        disarmed_by=os.environ.get("HERDR_PANE_ID") or "manager",
        disarmed_at=now_iso(),
        reason=f"new task created: {task_id}",
    ).to_record()


def cmd_final_gates_arm(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    if not all_tasks_merged(state):
        raise HLoopError("cannot arm final gates before all tasks are merged")
    running = running_agent_ids(state)
    if running:
        raise HLoopError("cannot arm final gates while roles are running: " + ", ".join(running))
    target = current_integration_target(repo, state)
    try:
        armed = arm_final_gates(
            final_gate_from_state(state),
            target_sha=target,
            armed_by=args.armed_by or os.environ.get("HERDR_PANE_ID") or "manager",
            armed_at=now_iso(),
            conditions=final_gate_conditions(state),
        )
    except LifecycleInvariantError as exc:
        raise HLoopError("cannot arm final gates: " + "; ".join(item.message for item in exc.issues)) from exc
    state["final_gate"] = armed.to_record()
    save_state(repo, state)
    journal(repo, f"Armed final gates generation `{armed.generation}` for `{target}`.")
    print(f"final gates armed for {target} (generation {armed.generation})")
    return 0


def gate_evidence_for_resume(state: dict[str, Any]) -> tuple[GateEvidence, ...]:
    validation = state.get("last_validation", {})
    validation_results = validation.get("results", [])
    validation_passed = bool(validation_results) and all(
        item.get("result") == "passed" for item in validation_results
    )

    def latest_closed_record(records: dict[str, Any]) -> dict[str, Any]:
        for record in reversed(list(records.values())):
            if isinstance(record, dict) and agent_gate_status(record) == "triaged":
                return record
        return {}

    review_record = latest_closed_record(state.get("reviews", {}))
    gap_record = latest_closed_record(state.get("gaps", {}))
    manager_qa_status = str(state.get("manager_qa_status") or "")
    manager_qa_passed = manager_qa_status in MANAGER_QA_PASSING_STATUSES
    return (
        GateEvidence(
            "validation",
            "passed" if validation_passed else "",
            str(validation.get("head_sha") or ""),
            required=validation_passed,
        ),
        GateEvidence(
            "review",
            "passed" if review_record else "",
            str(review_record.get("closed_head_sha") or review_record.get("head_sha") or ""),
            required=(
                normalize_int(state.get("max_reviewers"), DEFAULT_MAX_REVIEWERS) > 0
                and bool(review_record)
            ),
        ),
        GateEvidence(
            "gap",
            "passed" if gap_record else "",
            str(gap_record.get("closed_head_sha") or gap_record.get("head_sha") or ""),
            required=(
                normalize_int(state.get("max_gap_auditors"), DEFAULT_MAX_GAP_AUDITORS) > 0
                and bool(gap_record)
            ),
        ),
        GateEvidence(
            "manager-qa",
            manager_qa_status if manager_qa_passed else "",
            str(state.get("manager_qa_head_sha") or state.get("completion_target_sha") or ""),
            passing_statuses=("passed", "accepted-risk", "not-required"),
            required=state_manager_qa_profile(state) != "none" and manager_qa_passed,
        ),
    )


def lifecycle_resume_requirements(repo: Path, state: dict[str, Any]) -> list[dict[str, str]]:
    target = current_integration_target(repo, state)
    if not target:
        return []
    blockers = [
        f"decision {decision_id}" for decision_id in pending_blocking_user_decisions(state)
    ]
    if state.get("active_merge"):
        blockers.append("active merge transaction")
    requirements = compute_resume_requirements(
        current_target_sha=target,
        gates=gate_evidence_for_resume(state),
        active_blockers=blockers,
        dirty_paths=unsafe_dirty_paths(repo),
        running_roles=running_agent_ids(state),
    )
    return [
        {
            "code": item.code,
            "subject": item.subject,
            "reason": item.reason,
            "target_sha": item.target_sha,
            "observed_sha": item.observed_sha,
        }
        for item in requirements
    ]


def review_after_merges(state: dict[str, Any]) -> int:
    return max(1, normalize_int(state.get("review_after_merges"), DEFAULT_REVIEW_AFTER_MERGES))


def gap_after_merges(state: dict[str, Any]) -> int:
    return max(1, normalize_int(state.get("gap_after_merges"), DEFAULT_GAP_AFTER_MERGES))


def final_strict_gate_armed(state: dict[str, Any]) -> bool:
    """Whether the Manager has explicitly armed the final strict gates.

    Cadence review/gap gates during ongoing dispatch are unaffected by this;
    only the "all tasks are merged" final-completion trigger requires it, so
    a single explicit `hloop final-gates arm` -- not just merging the last
    task -- decides when strict final review/gap replace the periodic cadence.
    """

    final_gate = final_gate_from_state(state)
    return final_gate is not None and final_gate.status == "armed"


def should_open_review_gate(state: dict[str, Any]) -> bool:
    if int(state.get("max_reviewers", DEFAULT_MAX_REVIEWERS)) <= 0:
        return False
    if state.get("needs_review") or pending_review_exists(state):
        return False
    count = normalize_int(state.get("unreviewed_merge_count"), 0)
    if count >= review_after_merges(state):
        return True
    if not all_tasks_merged(state) or not final_strict_gate_armed(state):
        return False
    return count > 0 or not review_gate_passed(state)


def should_open_gap_gate(state: dict[str, Any]) -> bool:
    if int(state.get("max_gap_auditors", DEFAULT_MAX_GAP_AUDITORS)) <= 0:
        return False
    if state.get("needs_gap_check") or pending_gap_exists(state):
        return False
    count = normalize_int(state.get("ungapped_merge_count"), 0)
    if count >= gap_after_merges(state):
        return True
    if not all_tasks_merged(state) or not final_strict_gate_armed(state):
        return False
    return count > 0 or not gap_gate_passed(state)


def review_wait_ms(args: argparse.Namespace, state: dict[str, Any]) -> int:
    raw = getattr(args, "review_wait_ms", None)
    if raw is None:
        raw = state.get("review_wait_ms", DEFAULT_REVIEW_WAIT_MS)
    try:
        return max(0, int(raw))
    except (TypeError, ValueError) as exc:
        raise HLoopError(f"invalid review_wait_ms: {raw}") from exc


def gap_wait_ms(args: argparse.Namespace, state: dict[str, Any]) -> int:
    raw = getattr(args, "gap_wait_ms", None)
    if raw is None:
        raw = state.get("gap_wait_ms", DEFAULT_GAP_WAIT_MS)
    try:
        return max(0, int(raw))
    except (TypeError, ValueError) as exc:
        raise HLoopError(f"invalid gap_wait_ms: {raw}") from exc


def wait_for_running_review(
    repo: Path,
    state: dict[str, Any],
    review_id: str,
    review: dict[str, Any],
    wait_ms: int,
) -> bool:
    path = review_artifact_path(repo, review_id, review)
    if artifact_readiness(repo, state, review_id, "reviewer", review, path)[0]:
        return True
    pane_id = str(review.get("pane_id") or "")
    if wait_ms <= 0 or not pane_id or os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        return False
    proc = run_cmd(
        [
            "herdr",
            "wait",
            "output",
            pane_id,
            "--match",
            f"HERDR_LOOP_REVIEW_DONE:{review_id}:",
            "--source",
            "recent-unwrapped",
            "--timeout",
            str(wait_ms),
        ],
        check=False,
    )
    if proc.returncode == 0:
        review["last_wait_result"] = "done-marker"
    else:
        review["last_wait_result"] = "timeout"
    review["last_waited_at"] = now_iso()
    return artifact_readiness(repo, state, review_id, "reviewer", review, path)[0]


def wait_for_running_gap(
    repo: Path,
    state: dict[str, Any],
    gap_id: str,
    gap: dict[str, Any],
    wait_ms: int,
) -> bool:
    path = gap_artifact_path(repo, gap_id, gap)
    if artifact_readiness(repo, state, gap_id, "gap", gap, path)[0]:
        return True
    pane_id = str(gap.get("pane_id") or "")
    if wait_ms <= 0 or not pane_id or os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        return False
    proc = run_cmd(
        [
            "herdr",
            "wait",
            "output",
            pane_id,
            "--match",
            f"HERDR_LOOP_GAP_DONE:{gap_id}:",
            "--source",
            "recent-unwrapped",
            "--timeout",
            str(wait_ms),
        ],
        check=False,
    )
    if proc.returncode == 0:
        gap["last_wait_result"] = "done-marker"
    else:
        gap["last_wait_result"] = "timeout"
    gap["last_waited_at"] = now_iso()
    return artifact_readiness(repo, state, gap_id, "gap", gap, path)[0]


def state_value(state: dict[str, Any], key: str, default: str) -> str:
    value = str(state.get(key) or default)
    return value


def state_worker_qa_profile(state: dict[str, Any]) -> str:
    return str(
        state.get("worker_qa_profile")
        or state.get("qa_profile")
        or DEFAULT_WORKER_QA_PROFILE
    )


def state_manager_qa_profile(state: dict[str, Any]) -> str:
    return str(state.get("manager_qa_profile") or DEFAULT_MANAGER_QA_PROFILE)


def args_worker_qa_profile(args: argparse.Namespace) -> str:
    return str(
        getattr(args, "worker_qa_profile", None)
        or getattr(args, "qa_profile", None)
        or DEFAULT_WORKER_QA_PROFILE
    )


def manager_qa_required(state: dict[str, Any]) -> bool:
    return state_manager_qa_profile(state) != "none"


def manager_qa_passed(state: dict[str, Any]) -> bool:
    if not manager_qa_required(state):
        return True
    target = str(state.get("completion_target_sha") or state.get("integration_head_sha") or "")
    return str(state.get("manager_qa_status") or "") in MANAGER_QA_PASSING_STATUSES and (
        not target or str(state.get("manager_qa_head_sha") or "") == target
    )


def state_list(state: dict[str, Any], key: str, default: list[str]) -> list[str]:
    return normalize_list(state.get(key)) or list(default)


def worker_protocol_text(protocol: str, worker_qa_profile: str, base_ref: str) -> str:
    if protocol == "codex-impl":
        return f"""Compatibility mode:
- You may use $codex-impl for this bounded task.
- Manager has fixed kickoff choices for this task:
  - implementation gap-check count: 1
  - review/fix loop limit: skip review unless this task explicitly requires it
  - Worker QA profile: {worker_qa_profile}
  - QA target diff: this task branch against {base_ref}
- Do not ask the user for codex-impl preflight choices; Manager already owns them.
"""
    return f"""HLoop Worker Protocol:
1. Re-read MISSION, PLAN, DECISIONS, PROFILE, and your task contract.
2. Inspect the current code enough to verify the task is still valid.
3. Compare the task acceptance criteria against the implementation before editing.
4. Implement the smallest coherent change inside your write scope.
5. Self-review the diff for correctness, product behavior, security/privacy, data integrity, UX, and validation risk.
6. Run repository-appropriate validation for the changed surface and the task validation minimum.
7. Apply Worker QA profile `{worker_qa_profile}`:
   - `repo-default`: choose the repo's documented local checks, scripts, or CI-equivalent commands.
   - `local`: run local app/API/browser checks when the touched workflow is runnable.
   - `staging` or `preview`: collect evidence only when the target URL/credentials are already available in the task or PROFILE; otherwise report blocked QA explicitly.
   - `custom`: follow PROFILE.md and task instructions exactly.
   - `none`: record why QA is intentionally skipped.
8. Write the result artifact and commit your branch.

Manager final QA is a separate gate. Do not treat staging/preview final QA as your task's done condition unless the task contract explicitly says so.

Do not invoke another broad implementation orchestration skill unless the task explicitly opts into one.
"""


def review_protocol_text(
    protocol: str,
    lanes: list[str],
    worker_qa_profile: str,
    manager_qa_profile: str,
    branch_strategy: str,
) -> str:
    lane_lines = "\n".join(f"- {lane}" for lane in lanes)
    if protocol == "codex-review-multi-v2":
        return f"""Compatibility mode:
- You may use $codex-review-multi-v2, but still produce the HLoop artifact and Fix Task Candidates section.
- Review lanes requested by Manager:
{lane_lines}
- Branch strategy: {branch_strategy}
- Worker QA profile to assess: {worker_qa_profile}
- Manager final QA profile to assess: {manager_qa_profile}
"""
    return f"""HLoop Native Review Protocol:
Review the integration result as a Manager gate, not as a generic code review. Use these lanes:
{lane_lines}

Mandatory review sequence:
1. Build the review inventory:
   - `git diff --name-status <base-branch>...<integration-branch>`
   - `git diff --stat <base-branch>...<integration-branch>`
   - task/result artifacts, validation logs, and PROFILE/PLAN/DECISIONS.
2. Read changed files plus the nearest callers, callees, tests, schemas, migrations, generated-code sources, and CI/workflow files needed to verify behavior.
3. Cross-check each Worker result against actual changed files, write scopes, validation commands, Worker QA profile `{worker_qa_profile}`, and acceptance criteria.
4. For every candidate finding, prove the trigger path in the current code. Discard it if the scenario is speculative, pre-existing and unrelated, or unsupported by code evidence.
5. For validation or QA gaps, name the exact missing evidence and the product risk it leaves open. Separate Worker-local QA gaps from Manager final QA gaps.
6. Prefer fewer high-confidence findings over broad checklists.

Lane meanings:
- `integration-contract`: task/result artifacts, write-scope boundaries, merge safety, generated-code boundaries, and state consistency.
- `correctness`: user-visible behavior, edge cases, API/schema contracts, backward compatibility, and repository conventions.
- `risk`: security, auth/authorization, privacy, tenant scope, data integrity, concurrency, idempotency, migrations, performance, rollback, and observability.
- `validation-qa`: whether validation commands, logs, Worker QA profile `{worker_qa_profile}`, Manager final QA profile `{manager_qa_profile}`, and evidence are sufficient for the changed product surface.
- `ux`: visual/interaction/accessibility/copy risks only when UI is touched.
- Custom lane names from PROFILE.md should be interpreted literally and kept actionable.

Branch strategy under review: `{branch_strategy}`. Judge findings against that strategy and the repository's product workflow, not against a fixed branch model.

Do not invoke a generic multi-review skill unless PROFILE.md or the task explicitly opts into one.
"""


def parse_participant_spec(spec: str) -> dict[str, str]:
    raw = str(spec or "").strip()
    if not raw:
        raise HLoopError("advisor participant spec is empty")
    if ":" in raw:
        provider, model = raw.split(":", 1)
    else:
        provider, model = raw, DEFAULT_AGENT_MODEL
    return {
        "provider": normalize_agent_provider(provider),
        "model": normalize_agent_model(model),
    }


def advisor_participants_from_args(args: argparse.Namespace, state: dict[str, Any]) -> list[dict[str, Any]]:
    specs = normalize_list(getattr(args, "participant", None))
    if not specs:
        config = role_agent_config(state, "advisor")
        specs = [f"{config['provider']}:{config['model']}"]
    participants = []
    for index, spec in enumerate(specs, start=1):
        parsed = parse_participant_spec(spec)
        participants.append(
            {
                "participant_id": f"P{index}",
                "provider": parsed["provider"],
                "model": parsed["model"],
                "status": "queued",
            }
        )
    return participants


def render_advisor_prompt(
    advice_id: str,
    participant: dict[str, Any],
    advice_state: dict[str, Any],
    state: dict[str, Any],
    output_rel: Path,
    head_sha: str = "",
    report_credential_file: str = "",
    task_contract_digest: str = "",
    attempt_id: str = "",
) -> str:
    participant_id = str(participant.get("participant_id") or "P1")
    provider = str(participant.get("provider") or DEFAULT_AGENT_PROVIDER)
    model = str(participant.get("model") or DEFAULT_AGENT_MODEL)
    topic = str(advice_state.get("topic") or "")
    mode = str(advice_state.get("mode") or DEFAULT_ADVISOR_MODE)
    max_rounds = advisor_max_rounds(state, advice_state)
    dialogue_round = int(participant.get("dialogue_round") or (1 if mode == "dialogue" else 0))
    sources = normalize_list(advice_state.get("source_refs"))
    source_lines = "\n".join(f"- {item}" for item in sources) or "- No specific source artifact was provided."
    peer_paths = [
        str(item.get("advice_path"))
        for item in advice_state.get("participants", [])
        if item.get("participant_id") != participant_id and item.get("advice_path")
    ]
    peer_lines = "\n".join(f"- {item}" for item in peer_paths) or "- No peer advice artifact is available yet."
    return f"""You are Advisor {advice_id}/{participant_id}.

You are an opt-in consultation agent for the HLoop Manager.

HLoop skill version: {SKILL_VERSION}
In your first progress message, state `herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Advisor {advice_id}/{participant_id}` before investigation.

Agent backend:
- provider: {provider}
- model: {model}

Consultation mode: {mode}
Dialogue round: {dialogue_round}
Dialogue max rounds: {max_rounds}

Topic:
{topic}

Read first:
- {LOOP_DIR.as_posix()}/MISSION.md
- {LOOP_DIR.as_posix()}/PLAN.md
- {LOOP_DIR.as_posix()}/PROFILE.md
- {LOOP_DIR.as_posix()}/DECISIONS.md
- {LOOP_DIR.as_posix()}/STATE.json

Source artifacts or code references:
{source_lines}

Peer advice artifacts for bounded cross-model dialogue:
{peer_lines}
{report_contract_text(f"{advice_id}/{participant_id}", attempt_id or f"{advice_id}-{participant_id}-A001", state, report_credential_file=report_credential_file, task_contract_digest=task_contract_digest)}

Rules:
- Do not edit code.
- Do not modify Manager-owned loop files other than your required advice artifact.
- Do not create tasks, close review/gap gates, or make final decisions.
- You may recommend a fix strategy, a better specification shape, accepted-risk rationale, or a decision record.
- If the choice requires user preference, product policy, external approval, secrets, or production risk acceptance, say that Manager must ask the user.
- If the choice can be resolved from repository evidence, plan/spec sources, and existing decisions, give a concrete recommendation.
- In dialogue mode, address peer advice directly when present; otherwise produce an independent first-round memo.
- Do not continue open-ended debate; Manager enforces the dialogue max rounds.

Required output:
- Write only {output_rel.as_posix()}.
- Include frontmatter: advice_id, participant_id, run_id: {str(state.get("run_id") or "")}, skill_version: {SKILL_VERSION}, head_sha: {head_sha}, provider, model, status: advised|blocked|failed.
- Include sections:
  - ## Recommendation
  - ## Reasoning
  - ## Tradeoffs
  - ## Suggested Manager Action
  - ## User Escalation Needed

Final terminal line:
HERDR_LOOP_ADVICE_DONE:{advice_id}:{participant_id}:<advised|blocked|failed>
"""


def report_contract_text(
    role_id: str,
    attempt_id: str,
    state: dict[str, Any],
    *,
    report_credential_file: str,
    task_contract_digest: str,
) -> str:
    if not report_credential_file:
        return ""
    run_id = str(state.get("run_id") or "local")
    credential_ref = shlex.quote(str(report_credential_file))
    return f"""
Reporting: send ack, milestone, attention, and completion reports as your understanding, risk, or progress changes (see skills/herdr-dev-loop/references/report-protocol.md). Every report must include the exact identity below:
```
python3 {Path(__file__).resolve()} {loop_namespace_flag()} agent report \\
  --role-id {role_id} --attempt-id {attempt_id} --run-id {run_id} \\
  --task-contract-digest {task_contract_digest} --report-credential-file {credential_ref} \\
  --type ack --stage <stage> --summary '<summary>' --next '<next action>' ...
```
After the initial read-only investigation, send the semantic `ack` and stop before material work. Resume only after the Manager explicitly approves that ACK and sends the approval notice. A reject or timeout requires a corrected, new ACK event.
"""


def register_role_report_identity(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    attempt_id: str,
    task_contract_digest: str,
) -> str:
    """Register one fail-closed report identity and return its attempt-scoped token."""

    token, _ = _register_role_report_identity_and_ack_floor(
        repo,
        state,
        role_id=role_id,
        attempt_id=attempt_id,
        task_contract_digest=task_contract_digest,
    )
    return token


def register_role_report_identity_and_ack_floor(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    attempt_id: str,
    task_contract_digest: str,
) -> tuple[Path, int]:
    """Register an identity and persist its credential outside the worktree."""

    token, ack_floor = _register_role_report_identity_and_ack_floor(
        repo,
        state,
        role_id=role_id,
        attempt_id=attempt_id,
        task_contract_digest=task_contract_digest,
    )
    credential_file = write_role_report_credential(
        repo,
        state,
        role_id=role_id,
        attempt_id=attempt_id,
        token=token,
    )
    return credential_file, ack_floor


def _register_role_report_identity_and_ack_floor(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    attempt_id: str,
    task_contract_digest: str,
) -> tuple[str, int]:
    """Register an identity and return its in-memory token and ACK watermark."""

    token = secrets.token_hex(32)
    store = _open_broker_store(repo)
    with store.transaction() as transaction:
        latest_ack = store.latest_role_event(
            transaction,
            run_id=str(state.get("run_id") or "local"),
            role_id=role_id,
            attempt_id=attempt_id,
            report_type="ack",
        )
        store.register_active_role(
            transaction,
            run_id=str(state.get("run_id") or "local"),
            role_id=role_id,
            attempt_id=attempt_id,
            task_contract_digest=task_contract_digest,
            token=token,
        )
    return token, int((latest_ack or {}).get("sequence") or 0)


def rebind_role_report_contract_digest(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    attempt_id: str,
    task_contract_digest: str,
) -> int:
    """Append a new digest binding while preserving the attempt's secret token."""

    store = _open_broker_store(repo)
    run_id = str(state.get("run_id") or "local")
    with store.transaction() as transaction:
        current = store._latest_active_role(  # noqa: SLF001 - same-runtime storage contract
            transaction, run_id=run_id, role_id=role_id
        )
        if current is None or not normalize_bool(current.get("active")):
            raise HLoopError(f"active report identity is missing for {role_id}")
        if str(current.get("attempt_id") or "") != attempt_id:
            raise HLoopError(
                f"active report identity attempt mismatch for {role_id}: "
                f"expected {attempt_id}, got {current.get('attempt_id')}"
            )
        latest_ack = store.latest_role_event(
            transaction,
            run_id=run_id,
            role_id=role_id,
            attempt_id=attempt_id,
            report_type="ack",
        )
        transaction.connection.execute(
            """
            INSERT INTO active_roles(
                run_id, role_id, attempt_id, task_contract_digest,
                token_digest, active, registered_at
            ) VALUES (?, ?, ?, ?, ?, 1, ?)
            """,
            (
                run_id,
                role_id,
                attempt_id,
                task_contract_digest.lower(),
                current["token_digest"],
                now_iso(),
            ),
        )
    return int((latest_ack or {}).get("sequence") or 0)


def refresh_running_worker_contract_snapshot(
    repo: Path,
    state: dict[str, Any],
    task_id: str,
    task_state: dict[str, Any],
    *,
    task_contract_digest: str,
) -> None:
    """Refresh the role-visible contract identity without copying Manager state."""

    prompt_raw = str(task_state.get("prompt") or "")
    if prompt_raw:
        prompt = Path(prompt_raw)
        if not prompt.is_file():
            raise HLoopError(f"running Worker prompt is missing: {prompt}")
        prompt_text = read_text(prompt)
        updated_prompt, replacements = re.subn(
            r"(--task-contract-digest )[0-9a-f]{64}",
            rf"\g<1>{task_contract_digest}",
            prompt_text,
        )
        if replacements != 1:
            raise HLoopError(
                f"running Worker prompt has {replacements} task contract digest fields: {prompt}"
            )
        write_text(prompt, updated_prompt)

    if state_persistence(state) != "local-only":
        return
    worktree_raw = str(task_state.get("worktree") or "")
    if not worktree_raw:
        return
    worktree = Path(worktree_raw).resolve()
    if not worktree.is_dir():
        raise HLoopError(f"running Worker worktree is missing: {worktree}")
    visible_task = task_file(worktree, task_id)
    write_text(visible_task, read_text(task_file(repo, task_id)))


def prompt_contract_digest(prompt: str) -> str:
    return hashlib.sha256(prompt.encode("utf-8")).hexdigest()


def render_worker_prompt(
    task_id: str,
    task_meta: dict[str, Any],
    worktree: Path,
    branch: str,
    state: dict[str, Any],
    *,
    report_credential_file: str = "",
    task_contract_digest: str = "",
) -> str:
    worker_protocol = str(task_meta.get("worker_protocol") or state_value(state, "worker_protocol", DEFAULT_WORKER_PROTOCOL))
    if worker_protocol not in WORKER_PROTOCOLS:
        worker_protocol = DEFAULT_WORKER_PROTOCOL
    worker_qa_profile = str(
        task_meta.get("worker_qa_profile")
        or task_meta.get("qa_profile")
        or state_worker_qa_profile(state)
    )
    branch_strategy = state_value(state, "branch_strategy", DEFAULT_BRANCH_STRATEGY)
    base_ref = str(task_meta.get("base_ref") or "the integration branch")
    agent_config = role_agent_config(state, "worker", overrides=task_meta)
    protocol = worker_protocol_text(worker_protocol, worker_qa_profile, base_ref)
    return f"""You are Worker {task_id}.

HLoop skill version: {SKILL_VERSION}
In your first progress message, state `herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Worker {task_id}` before investigation or edits.

You are running in your own git worktree:
{worktree}

Your branch:
{branch}

Read first:
- {LOOP_DIR.as_posix()}/MISSION.md
- {LOOP_DIR.as_posix()}/PLAN.md
- {LOOP_DIR.as_posix()}/PROFILE.md
- {LOOP_DIR.as_posix()}/DECISIONS.md
- {LOOP_DIR.as_posix()}/tasks/{task_id}.md

Loop profile:
- Branch strategy: {branch_strategy}
- Worker protocol: {worker_protocol}
- Worker QA profile: {worker_qa_profile}
- Agent backend: {agent_display(agent_config)}
- Run ID: {str(state.get("run_id") or "")}
- Fixed Worker base SHA: {str(task_meta.get("base_sha") or "")}
{report_contract_text(task_id, str(task_meta.get("attempt_id") or task_id), state, report_credential_file=report_credential_file, task_contract_digest=task_contract_digest)}
{protocol}

Rules:
- Edit only the files allowed by write_allow in {LOOP_DIR.as_posix()}/tasks/{task_id}.md.
- Do not edit {LOOP_DIR.as_posix()}/STATE.json.
- Do not edit Manager-owned files below {LOOP_DIR.as_posix()}: MISSION.md, PLAN.md, PROFILE.md, DECISIONS.md, JOURNAL.md, or USER_ACTION_REQUIRED.md.
- Do not edit other task files or other result directories.
- Do not merge, rebase, or switch to the integration branch.
- If the task needs a specification decision not present in MISSION/PLAN/task, write status: blocked.

Required output:
- Commit product changes first, leaving no unrelated dirty files.
- Generate and commit the result with:
  `python3 {Path(__file__).resolve()} {loop_namespace_flag()} worker finalize {task_id} --status done --validation-command '<command>' --validation-result passed --validation-summary '<summary>'`
- Repeat `--validation-command` and `--validation-result` in matching order for multiple checks.
- For blocked or failed work, use the matching `--status` and `--blocking-question` instead of claiming done.

Before finishing:
- Run relevant tests/build from the task.
- Record exact commands and results in flat frontmatter fields:
  validation_recorded: true
  validation_commands:
    - <command>
  validation_results:
    - <passed|failed|blocked>
  validation_summary: "..."
- Review your own diff.
- Ensure no unrelated changes.

Final terminal line:
HERDR_LOOP_ROLE_DONE:{str(state.get("run_id") or "")}:{task_id}:{str(task_meta.get("attempt_id") or "")}:<done|blocked|failed|partial>
"""


def resolved_reviewer_topology(
    state: dict[str, Any],
    *,
    mode: str | None = None,
    providers: Sequence[str] | None = None,
    probe_count: int | None = None,
    probes_per_provider: int | None = None,
) -> dict[str, Any]:
    """Merge CLI-explicit reviewer topology with the resolved config.

    Explicit CLI values always win. Anything left unset falls back to
    ``resolved_config.reviewer`` (the full hierarchical config precedence
    chain already applied by ``config apply``), then to legacy STATE fields,
    then to built-in defaults -- so a configured swarm/dual/probe-count
    topology is never silently narrowed by an unrelated CLI default.
    """

    reviewer_config = state.get("resolved_config", {}).get("reviewer", {})
    if not isinstance(reviewer_config, dict):
        reviewer_config = {}
    resolved_mode = mode or reviewer_config.get("mode") or state.get("review_mode") or "single"
    if resolved_mode not in hloop_review.REVIEW_MODES:
        raise HLoopError(f"unsupported review mode: {resolved_mode}")
    resolved_providers = list(providers) if providers else reviewer_config.get("providers")
    resolved_probe_count = (
        probe_count if probe_count is not None else reviewer_config.get("probe_count")
    )
    resolved_probes_per_provider = (
        probes_per_provider
        if probes_per_provider is not None
        else reviewer_config.get("probes_per_provider")
    )
    if resolved_probe_count is not None and resolved_probes_per_provider is not None:
        raise HLoopError("set only one of --probe-count or --probes-per-provider")
    return {
        "mode": resolved_mode,
        "providers": resolved_providers or None,
        "probe_count": resolved_probe_count,
        "probes_per_provider": resolved_probes_per_provider,
    }


def review_capacity_evidence(
    review_plan: hloop_review.ReviewGroupPlan,
) -> dict[str, tuple[str, str]]:
    """Real per-provider swarm-concurrency probe evidence for ``review_plan``.

    Checked by ``check_review_capacity`` before any Coordinator pane exists,
    alongside the configured numeric ceiling, so an installed CLI that does
    not verifiably support the plan's concurrency requirements fails closed
    instead of only being compared against a fixed default.
    """

    return {
        provider: hloop_providers.probe_provider_review_capacity(provider)
        for provider in review_plan.providers
    }


def build_reviewer_group_plan(
    mode: str,
    head_sha: str,
    agent_config: dict[str, str],
    *,
    topology: dict[str, Any] | None = None,
) -> hloop_review.ReviewGroupPlan:
    topology = topology or {}
    return hloop_review.plan_review_group(
        mode,
        head_sha=head_sha,
        provider=agent_config["provider"],
        providers=topology.get("providers"),
        model=DEFAULT_AGENT_MODEL,
        models={agent_config["provider"]: agent_config["model"]},
        probe_count=topology.get("probe_count"),
        probes_per_provider=topology.get("probes_per_provider"),
    )


def render_reviewer_prompt(
    review_id: str,
    base_branch: str,
    integration_branch: str,
    state: dict[str, Any],
    agent_config: dict[str, str] | None = None,
    head_sha: str = "",
    review_plan: hloop_review.ReviewGroupPlan | None = None,
    report_credential_file: str = "",
    task_contract_digest: str = "",
    attempt_id: str = "",
) -> str:
    review_protocol = state_value(state, "review_protocol", DEFAULT_REVIEW_PROTOCOL)
    if review_protocol not in REVIEW_PROTOCOLS:
        review_protocol = DEFAULT_REVIEW_PROTOCOL
    worker_qa_profile = state_worker_qa_profile(state)
    manager_qa_profile = state_manager_qa_profile(state)
    branch_strategy = state_value(state, "branch_strategy", DEFAULT_BRANCH_STRATEGY)
    lanes = state_list(state, "review_lanes", DEFAULT_REVIEW_LANES)
    agent_config = agent_config or role_agent_config(state, "reviewer")
    protocol = review_protocol_text(
        review_protocol,
        lanes,
        worker_qa_profile,
        manager_qa_profile,
        branch_strategy,
    )
    mode = review_plan.mode if review_plan is not None else "single"
    if mode == "single":
        output_contract = f"""Output:
- During review, do not write files.
- After review is complete, write only {LOOP_DIR.as_posix()}/reviews/{review_id}.md.
- Include frontmatter: review_id, run_id: {str(state.get("run_id") or "")}, skill_version: {SKILL_VERSION}, base, head, head_sha: {head_sha}, status: reported|blocked|failed.
- If blocked or failed, still write the artifact with the concrete reason.
- Include a `## Fix Task Candidates` section. For every finding that should become a Worker fix task, add:
  `### FTNNN: <title>`, `action: fix_task`, `severity: P0|P1|P2|P3`, non-empty `write_allow:`, non-empty `acceptance:`, and non-empty `rationale:`.
  Incomplete candidates are rejected by `hloop triage` and will not become tasks.
  If no fix task is needed, write `No fix task candidates.`
"""
    else:
        plan_json = json.dumps(review_plan.to_record(), ensure_ascii=False, indent=2)
        provider_paths = "\n".join(
            f"- {LOOP_DIR.as_posix()}/reviews/{review_id}/providers/{provider}.md"
            for provider in review_plan.providers
        )
        output_contract = f"""Review group mode: {mode}
Target SHA for every lane and verifier: {review_plan.head_sha}

The following plan is immutable for this started review. Run every listed discovery lane with the exact provider, purpose, and agent_label. Swarm providers must launch the listed 4-8 provider-native sub-agents. Do not replace missing lanes with a smaller plan.

```json
{plan_json}
```

Directory artifact contract:
- During investigation, do not write HLoop artifacts.
- After all provider lanes and verifier passes reach a terminal result, write exactly:
  - {LOOP_DIR.as_posix()}/reviews/{review_id}/MANIFEST.json
{provider_paths}
  - {LOOP_DIR.as_posix()}/reviews/{review_id}/FINAL.md
- `MANIFEST.json` must follow `skills/herdr-dev-loop/schemas/review-manifest.schema.json`. Start from the immutable plan above, add each provider's actual `lanes`, normalized `findings`, planned verification assignments and shortfalls, actual verification `records`, and the recomputed `completeness` result. Never claim a missing or failed lane as completed.
- Every provider Markdown must have frontmatter: review_id, run_id: {str(state.get("run_id") or "")}, skill_version: {SKILL_VERSION}, head_sha: {head_sha}, provider, status: reported|blocked|failed. Record lane results, candidates, refutations, and shortfalls for only that provider.
- `FINAL.md` must have frontmatter: review_id, run_id: {str(state.get("run_id") or "")}, skill_version: {SKILL_VERSION}, base, head, head_sha: {head_sha}, status: reported|blocked|failed.
- `FINAL.md` must summarize confirmed, refuted, needs-spec, and insufficient-evidence findings without promoting incomplete evidence.
- Include `## Fix Task Candidates` in `FINAL.md`. A candidate is permitted only when all required manifest verification records for its fingerprint have `fact_status: confirmed`; include `source_finding: <sha256 fingerprint>` plus action, severity, write_allow, acceptance, and rationale. Non-confirmed or unknown fingerprints are rejected by `hloop triage`.
- If no confirmed finding needs a task, write `No fix task candidates.`
- If blocked or failed, still write all available artifacts truthfully; missing data must leave manifest completeness false.
"""
    return f"""You are Reviewer {review_id}.

HLoop skill version: {SKILL_VERSION}
In your first progress message, state `herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Reviewer {review_id}` before investigation.

Compare:
- base branch: {base_branch}
- integration branch: {integration_branch}

You are running in a detached review worktree. Treat the review target as read-only during investigation.

Read:
- {LOOP_DIR.as_posix()}/MISSION.md
- {LOOP_DIR.as_posix()}/PLAN.md
- {LOOP_DIR.as_posix()}/PROFILE.md
- {LOOP_DIR.as_posix()}/DECISIONS.md
- {LOOP_DIR.as_posix()}/STATE.json
- {LOOP_DIR.as_posix()}/tasks/*.md
- {LOOP_DIR.as_posix()}/results/*/result.md
- {LOOP_DIR.as_posix()}/validation/*.log when present

Review profile:
- Branch strategy: {branch_strategy}
- Worker QA profile: {worker_qa_profile}
- Manager final QA profile: {manager_qa_profile}
- Review protocol: {review_protocol}
- Review lanes: {", ".join(lanes)}
- Review mode: {mode}
- Agent backend: {agent_display(agent_config)}
{report_contract_text(review_id, attempt_id or f"{review_id}-A001", state, report_credential_file=report_credential_file, task_contract_digest=task_contract_digest)}

{protocol}

Rules:
- Do not edit code.
- Do not run formatters, generators, migrations, or automatic fix commands.
- Do not commit, merge, rebase, or switch branches.
- Review the integration branch against base.
- For every finding, re-investigate whether it can actually occur in this codebase.
- Do not report vague best-practice issues unless they create concrete risk.
- Prefer concrete code paths, failing scenarios, or missing tests.
- Classify severity as P0/P1/P2/P3.
- Recommend Manager action: fix_task, decision_needed, accepted_risk_candidate, or false_positive_candidate.

{output_contract}

Final terminal line:
HERDR_LOOP_ROLE_DONE:{str(state.get("run_id") or "")}:{review_id}:{review_id}-A001:<reported|blocked|failed>
"""


def render_gap_prompt(
    gap_id: str,
    base_branch: str,
    integration_branch: str,
    spec_sources: list[str],
    state: dict[str, Any] | None = None,
    agent_config: dict[str, str] | None = None,
    head_sha: str = "",
    report_credential_file: str = "",
    task_contract_digest: str = "",
    attempt_id: str = "",
) -> str:
    agent_config = agent_config or role_agent_config(state or {}, "gap")
    if spec_sources:
        source_lines = "\n".join(f"- {item}" for item in spec_sources)
    else:
        source_lines = "- No extra spec source was configured; use MISSION.md, PLAN.md, DECISIONS.md, tasks, and results as the implementation contract."
    return f"""You are Gap Auditor {gap_id}.

HLoop skill version: {SKILL_VERSION}
In your first progress message, state `herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Gap Auditor {gap_id}` before investigation.

Purpose:
- Compare the intended plan/spec against the current implementation.
- Find specification coverage gaps, not generic code-review issues.

Compare:
- base branch: {base_branch}
- integration branch: {integration_branch}
- Agent backend: {agent_display(agent_config)}

You are running in a detached gap-audit worktree. Treat the target as read-only during investigation.

Read:
- {LOOP_DIR.as_posix()}/MISSION.md
- {LOOP_DIR.as_posix()}/PLAN.md
- {LOOP_DIR.as_posix()}/DECISIONS.md
- {LOOP_DIR.as_posix()}/tasks/*.md
- {LOOP_DIR.as_posix()}/results/*/result.md

Spec sources:
{source_lines}
{report_contract_text(gap_id, attempt_id or f"{gap_id}-A001", state or {}, report_credential_file=report_credential_file, task_contract_digest=task_contract_digest)}

Rules:
- Do not edit code.
- Do not run formatters, generators, migrations, or automatic fix commands.
- Do not commit, merge, rebase, or switch branches.
- Check whether each planned requirement is implemented, partially implemented, intentionally deferred, obsolete, or blocked by a decision gap.
- Verify every gap against the actual code path or missing artifact.
- Do not report broad best-practice review findings unless they directly prove plan/spec drift.
- Classify each item as implemented, partial, missing, deferred, obsolete-spec, or needs-decision.
- Recommend Manager action: fix_task, decision_needed, accepted_risk_candidate, stale_spec_update, or no_action.

Output:
- During investigation, do not write files.
- After the audit is complete, write only {LOOP_DIR.as_posix()}/gaps/{gap_id}.md.
- Include frontmatter: gap_id, run_id: {str((state or {}).get("run_id") or "")}, skill_version: {SKILL_VERSION}, base, head, head_sha: {head_sha}, status: aligned|gaps-found|blocked|failed, spec_sources, gap_count.
- If blocked or failed, still write the artifact with the concrete reason.
- Include a `## Fix Task Candidates` section. For every missing or partial requirement that should become a Worker fix task, add:
  `### FTNNN: <title>`, `action: fix_task`, `priority: P0|P1|P2|P3`, non-empty `write_allow:`, non-empty `acceptance:`, and non-empty `rationale:`.
  Incomplete candidates are rejected by `hloop triage` and will not become tasks.
  If no fix task is needed, write `No fix task candidates.`

Final terminal line:
HERDR_LOOP_ROLE_DONE:{str((state or {}).get("run_id") or "")}:{gap_id}:{gap_id}-A001:<aligned|gaps-found|blocked|failed>
"""


def version_payload(repo: Path | None = None) -> dict[str, Any]:
    payload: dict[str, Any] = {
        "name": "herdr-dev-loop",
        "runtime_skill_version": SKILL_VERSION,
        "skill_root": str(SKILL_ROOT),
        "namespace": LOOP_NAMESPACE,
        "loop_path": LOOP_DIR.as_posix(),
    }
    if repo is not None:
        payload["legacy_loop_ignored"] = (repo / LEGACY_LOOP_DIR).exists()
    if repo is not None and state_path(repo).exists():
        state = load_state(repo)
        payload["loop_skill_version"] = str(state.get("skill_version") or "unversioned")
        payload["run_id"] = str(state.get("run_id") or "")
        payload["goal_id"] = str(state.get("goal_id") or "")
        payload["version_mismatch"] = payload["loop_skill_version"] not in {
            "unversioned",
            SKILL_VERSION,
        }
    return payload


def cmd_version(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    payload = version_payload(repo)
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(f"herdr-dev-loop {SKILL_VERSION}")
        if "loop_skill_version" in payload:
            print(
                f"loop_skill_version: {payload['loop_skill_version']} "
                f"run_id: {payload.get('run_id') or '-'}"
            )
            if payload.get("version_mismatch"):
                print("warning: runtime and loop skill versions differ")
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    role_state = load_state(repo) if state_path(repo).exists() else {}
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    herdr_skill_candidates = []
    if os.environ.get("HERDR_SKILL_PATH"):
        herdr_skill_candidates.append(Path(os.environ["HERDR_SKILL_PATH"]))
    herdr_skill_candidates.extend(
        [
            Path.home() / ".agents/skills/herdr/SKILL.md",
            codex_home / "skills/herdr/SKILL.md",
            Path.home() / ".codex/skills/herdr/SKILL.md",
        ]
    )
    herdr_skill = next((path for path in herdr_skill_candidates if path.exists()), None)
    checks: dict[str, Any] = {
        "repo": str(repo),
        "herdr_dev_loop": version_payload(repo),
        "HERDR_ENV": os.environ.get("HERDR_ENV"),
        "HERDR_PANE_ID": os.environ.get("HERDR_PANE_ID"),
        "HERDR_WORKSPACE_ID": os.environ.get("HERDR_WORKSPACE_ID"),
        "HERDR_TAB_ID": os.environ.get("HERDR_TAB_ID"),
        "commands": {
            "git": command_exists("git"),
            "herdr": command_exists("herdr"),
            "codex": command_exists("codex"),
            "claude": command_exists("claude"),
        },
        "skills": {
            "herdr": str(herdr_skill or herdr_skill_candidates[0]),
        },
        "optional_skills": {
            "codex-impl": str(codex_home / "skills/codex-impl/SKILL.md"),
            "codex-review-multi-v2": str(
                codex_home / "skills/codex-review-multi-v2/SKILL.md"
            ),
        },
        "warnings": [],
    }
    checks["skills"] = {
        key: {"path": value, "exists": Path(value).exists()}
        for key, value in checks["skills"].items()
    }
    checks["optional_skills"] = {
        key: {"path": value, "exists": Path(value).exists()}
        for key, value in checks["optional_skills"].items()
    }
    checks["skills"]["herdr"]["candidates"] = [str(path) for path in herdr_skill_candidates]
    config_ok = True
    try:
        hloop_config.check_python_capability()
        config_candidate = hloop_config.find_config_file()
        if config_candidate is not None:
            config_data = hloop_config.load_config_file(config_candidate.path)
            hloop_config.validate_config(config_data, base=config_candidate.path.parent)
            validate_config_semantics(config_data)
        checks["config"] = {
            "python": f"{sys.version_info.major}.{sys.version_info.minor}",
            "capability": "supported",
            "path": str(config_candidate.path) if config_candidate else None,
            "valid": True,
        }
    except (hloop_config.ConfigError, HLoopError) as exc:
        config_ok = False
        checks["config"] = {
            "python": f"{sys.version_info.major}.{sys.version_info.minor}",
            "capability": "unsupported-or-invalid",
            "valid": False,
            "error": str(exc),
        }
        checks["warnings"].append(f"config capability check failed: {exc}")
    role_capabilities_ok = True
    role_capabilities: dict[str, Any] = {}
    for role in ("worker", "reviewer", "gap", "advisor"):
        config = role_agent_config(role_state, role)
        runner = str(role_state.get(f"{role}_runner") or "tui")
        try:
            invocation = agent_provider_invocation(
                provider=config["provider"],
                model=config["model"],
                runner=runner,
                sandbox="workspace-write",
                prompt_rel=LOOP_DIR / "prompts" / f"_doctor-{role}.md",
                cwd=repo,
                effort=config.get("effort", DEFAULT_AGENT_EFFORT),
                claude_permission_mode=config.get(
                    "claude_permission_mode", DEFAULT_CLAUDE_PERMISSION_MODE
                ),
            )
            capability = hloop_providers.probe_provider_capability(invocation)
            role_capabilities[role] = capability.as_record()
            if not capability.launch_allowed:
                role_capabilities_ok = False
                checks["warnings"].append(
                    f"{role} provider capability failed: {capability.reason}"
                )
        except (HLoopError, hloop_providers.ProviderError) as exc:
            role_capabilities_ok = False
            role_capabilities[role] = {
                "provider": config.get("provider"),
                "runner": runner,
                "model": config.get("model"),
                "capability": "unsupported",
                "launch_allowed": False,
                "reason": str(exc),
            }
            checks["warnings"].append(f"{role} provider capability failed: {exc}")
    checks["role_capabilities"] = role_capabilities
    topology = resolved_reviewer_topology(role_state)
    review_capacity: dict[str, Any] = {}
    for provider in hloop_review.SUPPORTED_PROVIDERS:
        status, reason = hloop_providers.probe_provider_review_capacity(provider)
        review_capacity[provider] = {
            "capacity_probe": status,
            "reason": reason,
            "ceiling": hloop_providers.review_capacity_ceiling(
                provider, limits=role_state.get("review_capacity_limits")
            ),
        }
        if status in {"unsupported", "unavailable"}:
            checks["warnings"].append(
                f"{provider} review swarm capacity probe failed: {reason}"
            )
    checks["review_capacity"] = {"resolved_mode": topology["mode"], "providers": review_capacity}
    if not checks["skills"]["herdr"]["exists"]:
        checks["warnings"].append("herdr skill file not found; continuing because the herdr CLI is authoritative")
    if checks["herdr_dev_loop"].get("version_mismatch"):
        checks["warnings"].append(
            "runtime herdr-dev-loop version differs from the version pinned when this loop was initialized"
        )
    for key, item in checks["optional_skills"].items():
        if not item["exists"]:
            checks["warnings"].append(
                f"optional compatibility skill `{key}` not found; native hloop protocols do not require it"
            )
    if command_exists("codex"):
        proc = run_cmd(["codex", "--version"], check=False)
        checks["codex_version"] = (proc.stdout or proc.stderr).strip()
    if command_exists("claude"):
        proc = run_cmd(["claude", "--version"], check=False)
        checks["claude_version"] = (proc.stdout or proc.stderr).strip()
    if command_exists("herdr") and os.environ.get("HERDR_ENV") == "1":
        status_proc = run_cmd(["herdr", "status"], check=False)
        checks["herdr_status"] = (status_proc.stdout or status_proc.stderr).strip()
        try:
            current = json_from_cmd(["herdr", "pane", "current", "--current"])
            checks["current_pane_id"] = extract_pane_id(current)
        except HLoopError as exc:
            checks["herdr_error"] = str(exc)
    if getattr(args, "sessions", False):
        try:
            checks["loop_inventory"] = collect_loop_inventory(
                repo,
                probe_panes=True,
                lines=getattr(args, "session_lines", 80),
                include_output=False,
            )
        except HLoopError as exc:
            checks["warnings"].append(f"session inventory unavailable: {exc}")
    herdr_skill_ok = checks["skills"]["herdr"]["exists"] or not args.strict_skills
    required_commands_ok = checks["commands"]["git"] and checks["commands"]["herdr"] and checks["commands"]["codex"]
    ok = (
        checks["HERDR_ENV"] == "1"
        and required_commands_ok
        and herdr_skill_ok
        and config_ok
        and role_capabilities_ok
    )
    checks["ok"] = ok
    if args.json:
        print(json.dumps(checks, ensure_ascii=False, indent=2))
    else:
        for key, value in checks.items():
            print(f"{key}: {value}")
    return 0 if ok else 1


def contract_required_state_fields(text: str) -> list[str]:
    fields: list[str] = []
    in_required = False
    for line in text.splitlines():
        if line.strip() == "Required top-level fields:":
            in_required = True
            continue
        if in_required and line.strip().startswith("Treat `pane_id`"):
            break
        if not in_required:
            continue
        match = re.match(r"^-\s+`([^`]+)`\s*$", line.strip())
        if match:
            fields.append(match.group(1))
    return fields


def openai_yaml_interface_fields(text: str) -> set[str]:
    fields: set[str] = set()
    in_interface = False
    for line in text.splitlines():
        if line.strip() == "interface:":
            in_interface = True
            continue
        if not in_interface:
            continue
        match = re.match(r"^\s{2}([a-zA-Z0-9_]+):\s+.+$", line)
        if match:
            fields.add(match.group(1))
            continue
        if line.strip() and not line.startswith(" "):
            break
    return fields


def schema_has_merge_ready_guard(schema: dict[str, Any]) -> bool:
    all_of = schema.get("allOf")
    if not isinstance(all_of, list):
        return False
    for item in all_of:
        if not isinstance(item, dict):
            continue
        condition = item.get("if", {})
        then = item.get("then", {})
        if not isinstance(condition, dict) or not isinstance(then, dict):
            continue
        if (
            condition.get("properties", {})
            .get("merge_ready", {})
            .get("const")
            is not True
        ):
            continue
        required = set(normalize_list(then.get("required")))
        props = then.get("properties", {})
        if not isinstance(props, dict):
            continue
        validation_items = props.get("validation_results", {}).get("items", {})
        if {
            "status",
            "validation_recorded",
            "validation_commands",
            "validation_results",
        }.issubset(required) and props.get("status", {}).get("const") == "done" and (
            validation_items.get("const") == "passed"
        ):
            return True
    return False


def schema_has_write_allow_guard(schema: dict[str, Any]) -> bool:
    all_of = schema.get("allOf")
    if not isinstance(all_of, list):
        return False
    for item in all_of:
        if not isinstance(item, dict):
            continue
        condition = item.get("if", {})
        then = item.get("then", {})
        if not isinstance(condition, dict) or not isinstance(then, dict):
            continue
        kind = condition.get("properties", {}).get("kind", {})
        write_allow = then.get("properties", {}).get("write_allow", {})
        if kind.get("enum") == ["implementation", "fix"] and write_allow.get("minItems") == 1:
            return True
    return False


def cmd_selftest(args: argparse.Namespace) -> int:
    skill_root = (
        Path(args.skill_dir).resolve()
        if args.skill_dir
        else Path(__file__).resolve().parents[1]
    )
    errors: list[str] = []

    def check(condition: bool, message: str) -> None:
        if not condition:
            errors.append(message)

    skill_md = skill_root / "SKILL.md"
    skill_meta = parse_frontmatter_text(read_text(skill_md))
    check(skill_meta.get("name") == "herdr-dev-loop", "SKILL.md frontmatter name is invalid")
    check(bool(skill_meta.get("description")), "SKILL.md frontmatter description is missing")
    version_path = skill_root / "VERSION"
    version_text = read_text(version_path).strip()
    check(
        bool(re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?", version_text)),
        "VERSION is missing or is not semantic-version shaped",
    )
    if skill_root == SKILL_ROOT:
        check(version_text == SKILL_VERSION, "VERSION differs from the loaded runtime version")

    openai_yaml = skill_root / "agents" / "openai.yaml"
    fields = openai_yaml_interface_fields(read_text(openai_yaml))
    check(
        {"display_name", "short_description", "default_prompt"}.issubset(fields),
        "agents/openai.yaml interface fields are incomplete",
    )

    schema_dir = skill_root / "references" / "schemas"
    schemas: dict[str, dict[str, Any]] = {}
    for path in sorted(schema_dir.glob("*.json")):
        try:
            data = json.loads(read_text(path))
        except json.JSONDecodeError as exc:
            errors.append(f"{path.name} is invalid JSON: {exc}")
            continue
        if not isinstance(data, dict):
            errors.append(f"{path.name} is not a JSON object")
            continue
        schemas[path.name] = data

    state_schema = schemas.get("state.schema.json", {})
    contract_fields = contract_required_state_fields(
        read_text(skill_root / "references" / "artifact-contract.md")
    )
    schema_required = normalize_list(state_schema.get("required"))
    check(bool(contract_fields), "artifact-contract required state fields were not found")
    check(
        set(contract_fields) == set(schema_required),
        "STATE.json required fields differ between artifact-contract.md and state.schema.json",
    )
    check(
        "schema_revision" in set(schema_required),
        "state.schema.json lacks required schema_revision",
    )

    result_schema = schemas.get("result.schema.json", {})
    task_schema = schemas.get("task.schema.json", {})
    review_schema = schemas.get("review.schema.json", {})
    gap_schema = schemas.get("gap.schema.json", {})
    advice_schema = schemas.get("advice.schema.json", {})
    for schema_name, schema in (
        ("state.schema.json", state_schema),
        ("task.schema.json", task_schema),
        ("result.schema.json", result_schema),
        ("review.schema.json", review_schema),
        ("gap.schema.json", gap_schema),
        ("advice.schema.json", advice_schema),
    ):
        check(
            "skill_version" in set(normalize_list(schema.get("required"))),
            f"{schema_name} lacks required skill_version",
        )
    check(schema_has_merge_ready_guard(result_schema), "result.schema.json lacks merge_ready guard")
    validation_result_enum = set(
        normalize_list(
            result_schema.get("properties", {})
            .get("validation_results", {})
            .get("items", {})
            .get("enum")
        )
    )
    check(
        validation_result_enum == WORKER_VALIDATION_RESULTS,
        "result.schema.json validation result enum drifted",
    )
    check(schema_has_write_allow_guard(task_schema), "task.schema.json lacks write_allow guard")
    review_status_enum = set(normalize_list(review_schema.get("properties", {}).get("status", {}).get("enum")))
    gap_status_enum = set(normalize_list(gap_schema.get("properties", {}).get("status", {}).get("enum")))
    advice_status_enum = set(normalize_list(advice_schema.get("properties", {}).get("status", {}).get("enum")))
    check(review_status_enum == REVIEW_ARTIFACT_STATUSES, "review.schema.json status enum drifted")
    check(gap_status_enum == GAP_ARTIFACT_STATUSES, "gap.schema.json status enum drifted")
    check(advice_status_enum == ADVISOR_ARTIFACT_STATUSES, "advice.schema.json status enum drifted")
    check(
        {"run_id", "head_sha"}.issubset(set(normalize_list(review_schema.get("required")))),
        "review.schema.json lacks run/head freshness fields",
    )
    check(
        {"run_id", "head_sha"}.issubset(set(normalize_list(gap_schema.get("required")))),
        "gap.schema.json lacks run/head freshness fields",
    )

    result_meta = parse_frontmatter_text(
        """---
task_id: T001
run_id: run-demo
skill_version: 0.3.0
status: done
merge_ready: true
branch: ai/demo/T001
head_sha: HEAD
base_sha: abc123
changed_files:
  - src/demo.ts
validation_recorded: true
validation_commands:
  - npm test -- tests/demo.test.ts
validation_results:
  - passed
validation_summary: "targeted tests passed"
blocking_questions: []
---
"""
    )
    check(result_meta.get("merge_ready") is True, "sample result merge_ready did not parse")
    check(
        normalize_list(result_meta.get("validation_commands")),
        "sample result validation_commands did not parse as a list",
    )
    inline_list_rejected = False
    try:
        parse_frontmatter_text(
            """---
validation_commands: ["npm test -- --grep foo,bar"]
---
"""
        )
    except HLoopError as exc:
        inline_list_rejected = "inline list unsupported" in str(exc)
    check(inline_list_rejected, "known list fields should reject non-empty inline lists")
    check(
        matches_any("app/[liveId]/page.tsx", ["app/[liveId]/**"]),
        "write_allow matcher does not treat bracket path segments literally",
    )
    check(
        parse_changed_files_name_status("R100\told/path.ts\tnew/path.ts\nD\tgone.ts\n")
        == ["old/path.ts", "new/path.ts", "gone.ts"],
        "name-status changed file parser missed rename/delete paths",
    )
    parsed_task = build_parser().parse_args(
        [
            "task",
            "new",
            "demo task",
            "--write-allow",
            "app/[liveId]/**",
            "--validation-minimum",
            "L1",
            "--validation-minimum",
            "local browser QA",
        ]
    )
    check(
        parsed_task.validation_minimum == ["L1", "local browser QA"],
        "task new did not preserve repeated --validation-minimum values",
    )
    parsed_harvest = build_parser().parse_args(["harvest", "T001"])
    check(parsed_harvest.command == "harvest", "top-level harvest command did not parse")
    parsed_version = build_parser().parse_args(["version", "--json"])
    check(parsed_version.command == "version" and parsed_version.json, "version command did not parse")
    parsed_namespaced = build_parser().parse_args(
        ["--namespace", "feature-x", "version", "--json"]
    )
    check(parsed_namespaced.namespace == "feature-x", "global namespace did not parse")
    parsed_abort = build_parser().parse_args(
        ["agent", "abort", "R001", "--reason", "missing artifact"]
    )
    check(parsed_abort.agent_command == "abort", "agent abort command did not parse")
    parsed_requeue = build_parser().parse_args(
        ["agent", "requeue", "T001", "--reason", "retry"]
    )
    check(parsed_requeue.agent_command == "requeue", "agent requeue command did not parse")
    parsed_experience = build_parser().parse_args(
        ["experience", "recommend", "--command", "pnpm install --frozen-lockfile"]
    )
    check(
        parsed_experience.experience_command == "recommend",
        "experience recommend command did not parse",
    )
    parsed_wait = build_parser().parse_args(["wait", "next"])
    check(parsed_wait.timeout_ms == DEFAULT_WAIT_TIMEOUT_MS, "wait timeout default drifted")
    parsed_update = build_parser().parse_args(
        ["task", "update", "T001", "--add-write-allow", "src/shared/**"]
    )
    check(parsed_update.task_command == "update", "task update command did not parse")
    parsed_finalize = build_parser().parse_args(
        [
            "worker",
            "finalize",
            "T001",
            "--validation-command",
            "npm test",
            "--validation-result",
            "passed",
        ]
    )
    check(parsed_finalize.worker_command == "finalize", "worker finalize command did not parse")
    parsed_checkpoint = build_parser().parse_args(["checkpoint", "--message", "ai-loop: checkpoint"])
    check(parsed_checkpoint.command == "checkpoint", "checkpoint command did not parse")
    parsed_rollup = build_parser().parse_args(
        ["checkpoint", "--message", "ai-loop(B001): checkpoint", "--batch", "B001", "--rollup"]
    )
    check(parsed_rollup.batch == "B001" and parsed_rollup.rollup, "checkpoint rollup args did not parse")
    parsed_batch = build_parser().parse_args(["batch", "start", "demo batch", "--id", "B001"])
    check(parsed_batch.batch_command == "start", "batch start command did not parse")
    parsed_mixed_init = build_parser().parse_args(
        [
            "init",
            "--goal",
            "demo",
            "--reviewer-agent-provider",
            "claude",
            "--reviewer-agent-model",
            "opus",
            "--advisor-enabled",
            "--advisor-mode",
            "dialogue",
            "--worktree-root",
            "../wt/demo",
            "--persistence",
            "local-only",
            "--worktree-setup-command",
            "pnpm install --frozen-lockfile",
        ]
    )
    check(parsed_mixed_init.reviewer_agent_provider == "claude", "init reviewer agent provider did not parse")
    check(parsed_mixed_init.worktree_root == "../wt/demo", "init worktree root did not parse")
    check(parsed_mixed_init.persistence == "local-only", "init persistence did not parse")
    check(
        parsed_mixed_init.worktree_setup_command == ["pnpm install --frozen-lockfile"],
        "init worktree setup command did not parse",
    )
    parsed_advisor = build_parser().parse_args(
        [
            "advisor",
            "request",
            "--topic",
            "choose fix strategy",
            "--mode",
            "dialogue",
            "--participant",
            "codex:auto",
            "--participant",
            "claude:opus",
        ]
    )
    check(parsed_advisor.advisor_command == "request", "advisor request command did not parse")
    check(
        parse_participant_spec("claude:opus") == {"provider": "claude", "model": "opus"},
        "advisor participant parser drifted",
    )
    worker_prompt = render_worker_prompt(
        "T001",
        {
            "worker_protocol": "native",
            "worker_qa_profile": "none",
            "base_ref": "main",
            "worker_agent_provider": "claude",
            "worker_agent_model": "opus",
        },
        Path("/tmp/hloop-worker"),
        "ai/demo/T001",
        {
            "branch_strategy": "integration",
            "worker_protocol": "native",
            "worker_qa_profile": "none",
            "worker_agent_provider": "codex",
            "worker_agent_model": "auto",
        },
    )
    check(
        "- Agent backend: claude:opus" in worker_prompt,
        "worker prompt ignored task-level worker agent backend override",
    )
    check("worker finalize T001" in worker_prompt, "worker prompt omitted deterministic finalizer")
    check(
        f"herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Worker T001" in worker_prompt,
        "worker prompt omitted first-message version identity",
    )
    review_override_prompt = render_reviewer_prompt(
        "R999",
        "main",
        "ai/demo/integration",
        {
            "reviewer_agent_provider": "claude",
            "reviewer_agent_model": "opus",
            "worker_qa_profile": "none",
            "manager_qa_profile": "none",
            "branch_strategy": "integration",
            "review_protocol": "native",
            "review_lanes": DEFAULT_REVIEW_LANES,
        },
        agent_config={"provider": "codex", "model": "auto", "fallback_provider": "codex"},
    )
    check(
        "- Agent backend: codex" in review_override_prompt,
        "reviewer prompt ignored start-level agent backend override",
    )
    check(
        f"herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Reviewer R999" in review_override_prompt,
        "reviewer prompt omitted first-message version identity",
    )
    gap_override_prompt = render_gap_prompt(
        "G999",
        "main",
        "ai/demo/integration",
        ["spec/demo.md"],
        {"gap_agent_provider": "claude", "gap_agent_model": "opus"},
        agent_config={"provider": "codex", "model": "auto", "fallback_provider": "codex"},
    )
    check(
        "- Agent backend: codex" in gap_override_prompt,
        "gap prompt ignored start-level agent backend override",
    )
    check(
        f"herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Gap Auditor G999" in gap_override_prompt,
        "gap prompt omitted first-message version identity",
    )
    advisor_state = {"advisor_max_rounds": 2}
    peer_advice = {
        "mode": "dialogue",
        "max_rounds": 2,
        "topic": "compare fix strategy",
        "participants": [
            {
                "participant_id": "P1",
                "provider": "codex",
                "model": "auto",
                "advice_path": (LOOP_DIR / "advice" / "A001-P1.md").as_posix(),
            },
            {"participant_id": "P2", "provider": "claude", "model": "opus"},
        ],
    }
    peer_participant = peer_advice["participants"][1]
    prepare_advisor_dialogue_start(advisor_state, peer_advice, peer_participant)
    peer_prompt = render_advisor_prompt(
        "A001",
        peer_participant,
        peer_advice,
        advisor_state,
        LOOP_DIR / "advice" / "A001-P2.md",
    )
    check(
        (LOOP_DIR / "advice" / "A001-P1.md").as_posix() in peer_prompt
        and "Dialogue max rounds: 2" in peer_prompt,
        "advisor dialogue prompt did not include peer artifact and round bound",
    )
    check(
        f"herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Advisor A001/P2" in peer_prompt,
        "advisor prompt omitted first-message version identity",
    )
    check(
        artifact_identity_error(
            {"run_id": "run-new"},
            "R001",
            "reviewer",
            {"head_sha": "new-head"},
            {"review_id": "R001", "run_id": "run-old", "head_sha": "new-head"},
        )
        == "run_id mismatch",
        "artifact freshness check accepted an older run",
    )
    check(
        artifact_identity_error(
            {"run_id": "run-new", "skill_version": SKILL_VERSION},
            "R001",
            "reviewer",
            {"head_sha": "new-head", "skill_version": SKILL_VERSION},
            {
                "review_id": "R001",
                "run_id": "run-new",
                "skill_version": "0.0.0",
                "head_sha": "new-head",
            },
        )
        == "skill_version mismatch",
        "artifact freshness check accepted a different skill version",
    )
    check(
        configured_worktree_path(
            Path("/tmp/repo"), {"worktree_root": "/tmp/wt/demo"}, "T001", "repo.t001"
        )
        == Path("/tmp/wt/demo/T001"),
        "configured worktree root was not applied",
    )
    limit_participant = {
        "participant_id": "P1",
        "manager_messages": [{"delivery_status": "delivered"}],
    }
    advisor_limit_rejected = False
    try:
        enforce_advisor_message_round_limit(
            advisor_state,
            {"mode": "dialogue", "max_rounds": 2},
            limit_participant,
        )
    except HLoopError as exc:
        advisor_limit_rejected = "follow-up limit reached" in str(exc)
    check(advisor_limit_rejected, "advisor dialogue follow-up limit was not enforced")
    check(
        "claude --print" in agent_command_for_prompt(
            provider="claude",
            model="opus",
            runner="exec",
            sandbox="workspace-write",
            prompt_rel=LOOP_DIR / "prompts" / "A001-P1.advisor.md",
            cwd=skill_root,
            output_rel=LOOP_DIR / "advice" / "A001-P1.md",
        ),
        "claude exec command rendering drifted",
    )
    parsed_pump = build_parser().parse_args(["pump"])
    check(parsed_pump.sleep_ms == DEFAULT_PUMP_SLEEP_MS, "pump sleep default drifted")
    check(
        not hasattr(build_parser().parse_args(["tick", "--once"]), "mode")
        and not hasattr(parsed_pump, "mode"),
        "tick/pump unexpectedly define merge mode; cmd_merge must use a safe optional lookup",
    )
    check(
        normalize_validation_log_output("line with spaces  \nnext\t \r\n") == "line with spaces\nnext\n",
        "validation log normalization did not trim trailing whitespace",
    )
    message_state: dict[str, Any] = {}
    record_manager_message(
        message_state,
        "argv",
        "hello",
        delivery_status="undelivered",
        delivery_error="Codex is still working",
        pending_path=(LOOP_DIR / "inbox" / "pending" / "example.md").as_posix(),
    )
    check(
        message_state.get("manager_messages", [{}])[-1].get("delivery_status") == "undelivered"
        and message_state.get("manager_messages", [{}])[-1].get("digest"),
        "manager message delivery status/digest was not recorded",
    )
    check(
        item_artifact_state(
            {
                "role": "worker",
                "status": "merged",
                "cleanup_done": True,
                "artifact": {
                    "state": "missing",
                    "status": "done",
                    "committed_path": (LOOP_DIR / "results" / "T001" / "result.md").as_posix(),
                },
            }
        )
        == "cleaned/done/committed",
        "merged cleaned Worker artifact display is misleading",
    )

    review_meta = parse_frontmatter_text(
        """---
review_id: R001
run_id: run-demo
skill_version: 0.3.0
base: main
head_sha: abc123
head: ai/demo/integration
status: reported
---
"""
    )
    check(
        str(review_meta.get("status")) in REVIEW_ARTIFACT_STATUSES,
        "sample review artifact status is invalid",
    )

    gap_meta = parse_frontmatter_text(
        """---
gap_id: G001
run_id: run-demo
skill_version: 0.3.0
base: main
head_sha: abc123
head: ai/demo/integration
status: aligned
gap_count: 0
---
"""
    )
    check(str(gap_meta.get("status")) in GAP_ARTIFACT_STATUSES, "sample gap artifact status is invalid")

    batch_meta = parse_frontmatter_text(
        """---
id: B001
title: Demo batch
status: active
task_ids:
  - T001
checkpoint_mode: rollup
---
"""
    )
    check(batch_meta.get("id") == "B001", "sample batch artifact id did not parse")
    check(normalize_list(batch_meta.get("task_ids")) == ["T001"], "sample batch task_ids did not parse")

    valid_fix_candidates, rejected_fix_candidates = extract_fix_task_candidates(
        """## Fix Task Candidates

### FT001: Fix valid path
action: fix_task
priority: P1
write_allow:
  - `src/example/**` if this source remains scoped
acceptance:
  - Regression is fixed.
rationale: The reviewed path can fail.

### FT002: Missing required fields
action: fix_task
priority: P1
acceptance:
  - Something improves.
""",
        "R001",
    )
    check(len(valid_fix_candidates) == 1, "valid fix task candidate was not accepted")
    check(len(rejected_fix_candidates) == 1, "invalid fix task candidate was not rejected")
    check(
        valid_fix_candidates[0].get("write_allow") == ["src/example/**"],
        "triage did not normalize a Markdown code-span path",
    )
    draft_text = render_fix_task_draft(
        "review",
        "R001",
        LOOP_DIR / "reviews" / "R001.md",
        valid_fix_candidates,
        rejected_fix_candidates,
    )
    check("## Rejected Candidates" in draft_text, "triage draft did not include rejected candidates")

    reliability_codes = {
        item["code"]
        for item in agent_contract_issues(
            skill_root,
            role="worker",
            agent_id="T999",
            agent={
                "status": "result_reported",
                "sandbox": "danger-full-access",
                "prompt": "/tmp/manual-prompt.md",
                "worktree": "/tmp/manual-worker",
                "head_sha": "manager-working-tree",
                "merge_ready": True,
                "integration_method": "manager_manual_apply_after_worker_quota_failure",
                "result_path": str(skill_root / LOOP_DIR / "results" / "T999" / "result.md"),
            },
        )
    }
    check("unsafe-agent-sandbox" in reliability_codes, "reliability audit missed unsafe sandbox")
    check("non-hloop-prompt" in reliability_codes, "reliability audit missed non-hloop prompt")
    check("untrusted-worker-head" in reliability_codes, "reliability audit missed untrusted Worker head")
    check(
        "merge-ready-without-committed-result" in reliability_codes,
        "reliability audit missed missing committed result path",
    )

    result = {"ok": not errors, "skill_root": str(skill_root), "errors": errors}
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    elif errors:
        for error in errors:
            print(f"selftest: {error}", file=sys.stderr)
    else:
        print("selftest ok")
    return 0 if not errors else 1


def cmd_init(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    config_resolution, config_candidate = resolve_init_config(args, repo)
    archived_loop: Path | None = None
    base = args.base or current_branch(repo) or "main"
    goal_id = args.goal_id or slugify(args.goal, 32)
    run_id = new_run_id(goal_id)
    integration = args.integration or f"ai/{goal_id}/integration"
    worktree_root = resolve_worktree_root(repo, getattr(args, "worktree_root", None))
    experience = load_worktree_experience(repo)
    setup_commands = args.worktree_setup_command or normalize_list(
        experience.get("recommended_commands")
    )
    worker_setup_commands = args.worker_setup_command or setup_commands
    reviewer_setup_commands = args.reviewer_setup_command or []
    gap_setup_commands = args.gap_setup_command or []
    advisor_setup_commands = args.advisor_setup_command or []
    for role, commands in (
        ("worker", worker_setup_commands),
        ("reviewer", reviewer_setup_commands),
        ("gap", gap_setup_commands),
        ("advisor", advisor_setup_commands),
    ):
        for command in commands:
            marker = unsafe_setup_command(command)
            if marker:
                raise HLoopError(f"unsafe {role} setup command: contains `{marker}`")
    if args.persistence == "local-only":
        ensure_local_only_git_excludes(repo)
    worker_qa_profile = args_worker_qa_profile(args)
    manager_qa_profile = str(
        getattr(args, "manager_qa_profile", None) or DEFAULT_MANAGER_QA_PROFILE
    )
    worker_agent_provider = normalize_agent_provider(getattr(args, "worker_agent_provider", None))
    worker_agent_model = normalize_agent_model(getattr(args, "worker_agent_model", None))
    reviewer_agent_provider = normalize_agent_provider(getattr(args, "reviewer_agent_provider", None))
    reviewer_agent_model = normalize_agent_model(getattr(args, "reviewer_agent_model", None))
    gap_agent_provider = normalize_agent_provider(getattr(args, "gap_agent_provider", None))
    gap_agent_model = normalize_agent_model(getattr(args, "gap_agent_model", None))
    advisor_agent_provider = normalize_agent_provider(getattr(args, "advisor_agent_provider", None))
    advisor_agent_model = normalize_agent_model(getattr(args, "advisor_agent_model", None))
    advisor_enabled = normalize_bool(getattr(args, "advisor_enabled", DEFAULT_ADVISOR_ENABLED))
    advisor_mode = str(getattr(args, "advisor_mode", DEFAULT_ADVISOR_MODE) or DEFAULT_ADVISOR_MODE)
    if args.create_branch:
        if branch_exists(repo, integration):
            git(repo, ["switch", integration])
        else:
            git(repo, ["switch", "-c", integration, base])

    if args.force and loop_path(repo).exists():
        archived_loop = archive_existing_loop(repo)
    ensure_loop_dirs(repo)

    mission = loop_path(repo) / "MISSION.md"
    plan = loop_path(repo) / "PLAN.md"
    profile = loop_path(repo) / "PROFILE.md"
    decisions = loop_path(repo) / "DECISIONS.md"
    user_action = loop_path(repo) / "USER_ACTION_REQUIRED.md"
    journal_path = loop_path(repo) / "JOURNAL.md"
    if not mission.exists() or args.force:
        write_text(
            mission,
            f"""# Mission

## Goal
{args.goal}

## Context
TBD by Manager.

## Constraints
- Use Herdr-managed panes only when `HERDR_ENV=1`.
- Persist loop state in `{LOOP_DIR.as_posix()}`.
- Stop on blocking specification decisions.

## Non-goals
- Do not run unbounded autonomous loops.

## Done when
- All planned tasks are merged into `{integration}`.
- Required validation passes.
- No blocking plan/spec implementation gap remains.
- No blocking review finding remains.

## Base branch
{base}

## Integration branch
{integration}

## Validation levels
- L0: format / lint / typecheck
- L1: relevant unit tests
- L2: full build / full test
- L3: e2e or manual verification
""",
        )
    if not profile.exists() or args.force:
        lanes = args.review_lane or DEFAULT_REVIEW_LANES
        write_text(
            profile,
            f"""# Loop Profile

Manager-owned project profile for branch strategy, implementation protocol, review strategy, Worker QA, and final Manager QA.

## Loop Identity

- Namespace: `{LOOP_NAMESPACE}`
- Path: `{LOOP_DIR.as_posix()}`
- Persistence: `{args.persistence}`
- Config: `{str(config_candidate.path) if config_candidate else "built-in defaults"}`

Legacy `.ai/loop` state is ignored. `local-only` copies Manager artifacts into role worktrees and keeps them out of integration commits; `branch-history` requires committed Manager snapshots.

## Worktree Setup Commands
{chr(10).join(f"- `{item}`" for item in setup_commands) if setup_commands else "None configured."}

Execution outcomes accumulate in `{EXPERIENCE_DIR.as_posix()}/worktree-setup.json`.

## Branch Strategy
{args.branch_strategy}

- `integration`: hloop manages one integration branch plus one branch/worktree per Worker task.
- `pr-per-task`: Manager may keep Worker branches PR-oriented; use hloop artifacts as coordination gates and adapt merge/publish steps in PLAN.
- `custom`: product-specific branch rules in PLAN override default branch assumptions. Keep safety gates explicit.

## Worker Protocol
{args.worker_protocol}

- `native`: Workers follow the HLoop Worker Protocol embedded in their prompt.
- `codex-impl`: compatibility mode only; use when Manager intentionally wants the external skill's preflight/review/QA behavior.

## Review Protocol
{args.review_protocol}

- `native`: Reviewers use HLoop review lanes tuned for Manager gating, task artifacts, validation evidence, and product risk.
- `codex-review-multi-v2`: compatibility mode only; still require HLoop artifact shape and Fix Task Candidates.

## Review Lanes
{chr(10).join(f"- {item}" for item in lanes)}

## Agent Backends

- Worker default: provider `{worker_agent_provider}`, model `{worker_agent_model}`
- Reviewer default: provider `{reviewer_agent_provider}`, model `{reviewer_agent_model}`
- Gap Auditor default: provider `{gap_agent_provider}`, model `{gap_agent_model}`
- Advisor default: provider `{advisor_agent_provider}`, model `{advisor_agent_model}`

Codex is the default fallback provider for every role. Use role-specific provider/model settings when the Manager intentionally wants Claude, Codex, or a mixed model review strategy. Manager is always the agent currently using this skill; hloop only spawns subordinate role agents.

Advisor is opt-in only. It must not run from pump/tick unless Manager explicitly starts an advice request.

Advisor enabled: `{str(advisor_enabled).lower()}`
Advisor mode: `{advisor_mode}`

## Specification Scout
{args.specification_scout}

- `auto`: run once before implementation dispatch when requirements or tasks expose specification risk.
- `always`: run once before the first implementation dispatch.
- `off`: skip automatic Scout dispatch, while finish still checks unresolved decisions.

## Worktree Root
{str(worktree_root) if worktree_root else "default sibling paths"}

When configured, all Worker, Reviewer, Gap Auditor, and Advisor worktrees are created below this directory.

## Worker QA Profile
{worker_qa_profile}

- `repo-default`: choose repository-native checks from scripts, CI, docs, or existing QA artifacts.
- `local`: run local app/API/browser checks when the touched workflow is runnable.
- `staging`: use staging only when credentials and URLs are already available.
- `preview`: use PR/preview only when a URL is already available or discoverable from repo tooling.
- `custom`: follow the QA section in PLAN exactly.
- `none`: record the reason QA is intentionally skipped.

## Manager Final QA Profile
{manager_qa_profile}

- `none`: no separate Manager final QA gate.
- `repo-default`: Manager records final repository-appropriate evidence after integration/review/gap gates pass.
- `local`: Manager records final local app/API/browser evidence after the combined implementation is assembled.
- `staging`: Manager records staging URL, data setup, cleanup, screenshots/logs, and blockers before final completion.
- `preview`: Manager records PR/preview URL evidence before final completion.
- `custom`: Manager follows the final QA section in PLAN exactly.
""",
        )
    if not plan.exists() or args.force:
        write_text(
            plan,
            f"""# Plan

## Strategy
TBD by Manager.

## Branch strategy
Follow `{LOOP_DIR.as_posix()}/PROFILE.md`. If the product needs PR-per-task, release-branch, or custom flow, record the exact merge/publish handoff here before dispatching Workers.

## Task graph
- Add tasks with `hloop task new`.

## Parallelization rules
- Run Workers in parallel only when their `write_allow` patterns do not overlap.

## Validation plan
- Run task-specific validation before merge.
- Run integration validation after each merge.

## Worker QA plan
- Workers follow `{LOOP_DIR.as_posix()}/PROFILE.md` Worker QA profile unless a task overrides it.
- Worker QA evidence belongs in each task result artifact.

## Manager final QA plan
- Manager follows `{LOOP_DIR.as_posix()}/PROFILE.md` Manager Final QA profile after the combined implementation is ready.
- Manager final QA evidence belongs in `{LOOP_DIR.as_posix()}/qa/FINAL.md` and the final report.
- If Manager final QA is staging or preview, record URL, environment, data setup, cleanup, screenshots/logs, and blockers.

## Review plan
- Keep up to 3 Workers running when write scopes do not overlap.
- Run Reviewer frequently after validated integration advances.
- Run Gap Auditor less frequently against original plan/spec sources, and always before final completion when configured.
""",
        )
    if not decisions.exists():
        write_text(
            decisions,
            """# Decisions

Manager-owned record for specification choices that cannot be answered from the original plan/spec alone.

## Pending Decisions

None.

## Accepted Decisions

None.

## Rejected Decisions

None.
""",
        )
    if not user_action.exists():
        write_text(user_action, "# User Action Required\n\nNo blocking user action.\n")
    if not journal_path.exists():
        write_text(journal_path, "# Journal\n")
    state = {
        "state_format_version": STATE_FORMAT_VERSION,
        "schema_revision": STATE_SCHEMA_REVISION,
        "goal_id": goal_id,
        "run_id": run_id,
        "skill_version": SKILL_VERSION,
        "namespace": LOOP_NAMESPACE,
        "loop_path": LOOP_DIR.as_posix(),
        "persistence": args.persistence,
        "config_source": {
            "kind": config_candidate.source if config_candidate else "built-in-default",
            "path": str(config_candidate.path) if config_candidate else "",
        },
        "resolved_config": config_resolution.as_dict(),
        "worktree_setup_commands": worker_setup_commands,
        "worker_setup_commands": worker_setup_commands,
        "reviewer_setup_commands": reviewer_setup_commands,
        "gap_setup_commands": gap_setup_commands,
        "advisor_setup_commands": advisor_setup_commands,
        "min_free_bytes": args.min_free_bytes,
        "min_free_inodes": args.min_free_inodes,
        "phase": "initialized",
        "base_branch": base,
        "integration_branch": integration,
        "worktree_root": str(worktree_root) if worktree_root else "",
        "merge_mode": args.merge_mode,
        "branch_strategy": args.branch_strategy,
        "worker_qa_profile": worker_qa_profile,
        "manager_qa_profile": manager_qa_profile,
        "manager_qa_status": "not-required" if manager_qa_profile == "none" else "pending",
        "manager_qa_evidence_path": (LOOP_DIR / "qa" / "FINAL.md").as_posix(),
        "worker_protocol": args.worker_protocol,
        "review_protocol": args.review_protocol,
        "worker_agent_provider": worker_agent_provider,
        "worker_agent_model": worker_agent_model,
        "worker_agent_effort": args.worker_agent_effort,
        "worker_claude_permission_mode": args.worker_claude_permission_mode,
        "reviewer_agent_provider": reviewer_agent_provider,
        "reviewer_agent_model": reviewer_agent_model,
        "reviewer_agent_effort": args.reviewer_agent_effort,
        "reviewer_claude_permission_mode": args.reviewer_claude_permission_mode,
        "gap_agent_provider": gap_agent_provider,
        "gap_agent_model": gap_agent_model,
        "gap_agent_effort": args.gap_agent_effort,
        "gap_claude_permission_mode": args.gap_claude_permission_mode,
        "advisor_enabled": advisor_enabled,
        "advisor_mode": advisor_mode,
        "advisor_max_rounds": getattr(args, "advisor_max_rounds", DEFAULT_ADVISOR_MAX_ROUNDS),
        "advisor_agent_provider": advisor_agent_provider,
        "advisor_agent_model": advisor_agent_model,
        "advisor_agent_effort": args.advisor_agent_effort,
        "advisor_claude_permission_mode": args.advisor_claude_permission_mode,
        "review_lanes": args.review_lane or DEFAULT_REVIEW_LANES,
        "worker_runner": args.worker_runner,
        "reviewer_runner": args.reviewer_runner,
        "gap_runner": args.gap_runner,
        "session_cleanup": args.session_cleanup,
        "specification_scout": args.specification_scout,
        "specification_scout_run": {},
        "decision_liaisons": {},
        "review_wait_ms": args.review_wait_ms,
        "gap_wait_ms": args.gap_wait_ms,
        "review_after_merges": args.review_after_merges,
        "gap_after_merges": args.gap_after_merges,
        "unreviewed_merge_count": 0,
        "ungapped_merge_count": 0,
        "cycle": 0,
        "max_workers": args.max_workers,
        "max_reviewers": args.max_reviewers,
        "max_gap_auditors": args.max_gap_auditors,
        "spec_sources": args.spec_source or [],
        "validation_commands": args.validation or [],
        "tasks": {},
        "batches": {},
        "reviews": {},
        "gaps": {},
        "advice": {},
        "decisions": {},
        "requirements": {},
        "manager_context": [],
        "progress_sequence": 0,
        "attempt_history": [],
        "cleanup_history": [],
        "lifecycle_diagnostics": [],
        "resume_requirements": [],
        "pending_fix_task_drafts": [],
        "final_gate": None,
        "terminal_outcome": {},
        "artifact_policy": {
            "role_active": "role-worktree",
            "role_harvested": "manager-loop",
            "inputs": "local-only",
            "inbox": "local-only",
            "broker": "local-only",
        },
        "git_identity": git_executable_identity(),
        "created_at": now_iso(),
    }
    if state_path(repo).exists() and not args.force:
        old = load_state(repo)
        old.setdefault("validation_commands", args.validation or [])
        old.setdefault("run_id", new_run_id(str(old.get("goal_id") or goal_id)))
        old.setdefault("skill_version", "unversioned")
        old.setdefault("namespace", LOOP_NAMESPACE)
        old.setdefault("loop_path", LOOP_DIR.as_posix())
        old.setdefault("persistence", args.persistence)
        old.setdefault(
            "config_source",
            {
                "kind": config_candidate.source if config_candidate else "built-in-default",
                "path": str(config_candidate.path) if config_candidate else "",
            },
        )
        old.setdefault("resolved_config", config_resolution.as_dict())
        old.setdefault("worktree_setup_commands", setup_commands)
        old.setdefault("worktree_root", str(worktree_root) if worktree_root else "")
        old.setdefault("branch_strategy", args.branch_strategy)
        old.setdefault("worker_qa_profile", old.get("qa_profile", worker_qa_profile))
        old.setdefault("manager_qa_profile", manager_qa_profile)
        old.setdefault(
            "manager_qa_status",
            "not-required" if state_manager_qa_profile(old) == "none" else "pending",
        )
        old.setdefault("worker_protocol", args.worker_protocol)
        old.setdefault("review_protocol", args.review_protocol)
        old.setdefault("worker_agent_provider", worker_agent_provider)
        old.setdefault("worker_agent_model", worker_agent_model)
        old.setdefault("reviewer_agent_provider", reviewer_agent_provider)
        old.setdefault("reviewer_agent_model", reviewer_agent_model)
        old.setdefault("gap_agent_provider", gap_agent_provider)
        old.setdefault("gap_agent_model", gap_agent_model)
        old.setdefault("advisor_enabled", advisor_enabled)
        old.setdefault("advisor_mode", advisor_mode)
        old.setdefault("advisor_max_rounds", getattr(args, "advisor_max_rounds", DEFAULT_ADVISOR_MAX_ROUNDS))
        old.setdefault("advisor_agent_provider", advisor_agent_provider)
        old.setdefault("advisor_agent_model", advisor_agent_model)
        old.setdefault("advice", {})
        old.setdefault("review_lanes", args.review_lane or DEFAULT_REVIEW_LANES)
        old.setdefault("review_after_merges", args.review_after_merges)
        old.setdefault("gap_after_merges", args.gap_after_merges)
        old.setdefault("unreviewed_merge_count", 0)
        old.setdefault("ungapped_merge_count", 0)
        old.setdefault("max_workers", args.max_workers)
        old.setdefault("max_reviewers", args.max_reviewers)
        old.setdefault("max_gap_auditors", args.max_gap_auditors)
        old.setdefault("gaps", {})
        old.setdefault("batches", {})
        old.setdefault("decisions", {})
        old.setdefault("requirements", {})
        old.setdefault("manager_context", [])
        old.setdefault("progress_sequence", 0)
        old.setdefault("git_identity", git_executable_identity())
        write_requirement_artifacts(repo, old)
        write_manager_context_artifact(repo, old)
        write_decision_artifacts(repo, old)
        save_state(repo, old)
        print(f"STATE.json already exists: {state_path(repo)}")
        return 0
    write_requirement_artifacts(repo, state)
    write_manager_context_artifact(repo, state)
    write_decision_artifacts(repo, state)
    save_state(repo, state)
    archive_note = f" Archived previous loop at `{archived_loop}`." if archived_loop else ""
    journal(repo, f"Initialized loop `{goal_id}` run `{run_id}` on integration branch `{integration}`.{archive_note}")
    print(f"initialized {LOOP_DIR.as_posix()} for {goal_id}")
    if (repo / LEGACY_LOOP_DIR).exists():
        print(f"ignored legacy loop: {LEGACY_LOOP_DIR.as_posix()}")
    if archived_loop:
        print(f"archived previous loop: {archived_loop}")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    if getattr(args, "raw_state", False):
        state = load_state(repo)
        print(json.dumps(state, ensure_ascii=False, indent=2))
        return 0
    inventory = collect_loop_inventory(
        repo,
        probe_panes=not getattr(args, "no_pane_probe", False),
        lines=getattr(args, "lines", 80),
        include_output=False,
    )
    if args.json:
        print(json.dumps(inventory, ensure_ascii=False, indent=2))
        return 0
    loop = inventory["loop"]
    counts = inventory["counts"]
    print(f"goal_id: {loop.get('goal_id')}")
    print(f"phase: {loop.get('phase')}")
    print(f"base: {loop.get('base_branch')} {loop.get('base_sha')}")
    print(f"integration: {loop.get('integration_branch')} {loop.get('integration_sha')}")
    print(f"current_branch: {loop.get('current_branch')}")
    print(f"branch_strategy: {loop.get('branch_strategy')}")
    print(f"worker_protocol: {loop.get('worker_protocol')}")
    print(f"review_protocol: {loop.get('review_protocol')}")
    print(f"worker_qa_profile: {loop.get('worker_qa_profile')}")
    print(f"manager_qa_profile: {loop.get('manager_qa_profile')}")
    print(f"manager_qa_status: {loop.get('manager_qa_status')}")
    print(f"current_batch_id: {loop.get('current_batch_id') or '-'}")
    print(
        "review_queue: "
        f"{loop.get('review_queue', {}).get('count')}/"
        f"{loop.get('review_queue', {}).get('threshold')}"
    )
    print(
        "gap_queue: "
        f"{loop.get('gap_queue', {}).get('count')}/"
        f"{loop.get('gap_queue', {}).get('threshold')}"
    )
    print(
        "agents: "
        f"workers {counts.get('workers_running')}/{counts.get('workers')} running, "
        f"reviewers {counts.get('reviewers_running')}/{counts.get('reviewers')} running, "
        f"gaps {counts.get('gaps_running')}/{counts.get('gaps')} running"
    )
    print(f"issues: {counts.get('issues')} ({counts.get('p0_p1_issues')} P0/P1)")
    for item in inventory["issues"][:10]:
        print(
            f"  {item.get('severity')} {item.get('subject')} "
            f"{item.get('code')}: {item.get('message')}"
        )
    return 0


def item_agent_status(item: dict[str, Any]) -> str:
    pane = item.get("pane", {})
    if not isinstance(pane, dict):
        return ""
    if pane.get("present"):
        return str(pane.get("agent_status") or "")
    reason = pane.get("reason")
    return f"pane:{reason}" if reason else ""


def item_artifact_state(item: dict[str, Any]) -> str:
    artifact = item.get("artifact", {})
    if not isinstance(artifact, dict):
        return ""
    state = str(artifact.get("state") or "")
    status = str(artifact.get("status") or artifact.get("artifact_status") or "")
    if item.get("role") in {"reviewer", "gap"}:
        status = str(item.get("artifact_status") or "")
    commit_state = str(artifact.get("commit_state") or "")
    if (
        item.get("role") == "worker"
        and item.get("status") == "merged"
        and state == "missing"
        and status
    ):
        state = "cleaned" if item.get("cleanup_done") else "state"
        if artifact.get("committed_path") and not commit_state:
            commit_state = "committed"
    parts = [part for part in [state, status, commit_state] if part]
    return "/".join(parts)


def print_agent_rows(title: str, items: list[dict[str, Any]]) -> None:
    print(title + ":")
    if not items:
        print("  none")
        return
    for item in items:
        agent_id = item.get("id")
        role = item.get("role")
        status = item.get("gate_status") or item.get("status")
        pane_id = item.get("pane", {}).get("pane_id", "")
        pane_status = item_agent_status(item)
        artifact = item_artifact_state(item)
        issue_count = len(item.get("issues", []))
        suffix = f" issues={issue_count}" if issue_count else ""
        print(
            f"  {agent_id}: {role} status={status} pane={pane_id or '-'} "
            f"agent={pane_status or '-'} artifact={artifact or '-'}{suffix}"
        )


def print_inventory_dashboard(inventory: dict[str, Any]) -> None:
    loop = inventory["loop"]
    counts = inventory["counts"]
    print(f"HLoop dashboard: {loop.get('goal_id')} phase={loop.get('phase')} cycle={loop.get('cycle')}")
    print(
        f"repo={inventory.get('repo')} current={loop.get('current_branch')} "
        f"integration={loop.get('integration_branch')}@{loop.get('integration_sha')}"
    )
    print(
        "queues: "
        f"review {loop.get('review_queue', {}).get('count')}/{loop.get('review_queue', {}).get('threshold')}, "
        f"gap {loop.get('gap_queue', {}).get('count')}/{loop.get('gap_queue', {}).get('threshold')}, "
        f"validation={'yes' if loop.get('needs_validation') else 'no'}"
    )
    print(f"batch: current={loop.get('current_batch_id') or '-'} total={counts.get('batches')}")
    print(
        "counts: "
        f"workers={counts.get('workers')} running={counts.get('workers_running')} "
        f"queued={counts.get('workers_queued')} merge_ready={counts.get('workers_merge_ready')}; "
        f"reviewers={counts.get('reviewers')} running={counts.get('reviewers_running')} reported={counts.get('reviewers_reported')}; "
        f"gaps={counts.get('gaps')} running={counts.get('gaps_running')} reported={counts.get('gaps_reported')}; "
        f"advisors={counts.get('advisors')} running={counts.get('advisors_running')} reported={counts.get('advisors_reported')}"
    )
    print_agent_rows("Workers", inventory["workers"])
    print_agent_rows("Reviewers", inventory["reviewers"])
    print_agent_rows("Gaps", inventory["gaps"])
    print_agent_rows("Advisors", inventory.get("advisors", []))
    print("Issues:")
    if not inventory["issues"]:
        print("  none")
    for item in inventory["issues"]:
        print(
            f"  {item.get('severity')} {item.get('subject')} "
            f"{item.get('code')}: {item.get('message')}"
        )
        if item.get("action"):
            print(f"    action: {item.get('action')}")
    if inventory.get("next_actions"):
        print("Next actions:")
        for action in inventory["next_actions"]:
            print(f"  - {action}")


def cmd_dashboard(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    inventory = collect_loop_inventory(
        repo,
        probe_panes=not args.no_pane_probe,
        lines=args.lines,
        include_output=args.include_output,
    )
    if args.json:
        print(json.dumps(inventory, ensure_ascii=False, indent=2))
        return 0
    print_inventory_dashboard(inventory)
    return 0


def cmd_conductor(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    inventory = collect_loop_inventory(
        repo,
        probe_panes=not args.no_pane_probe,
        lines=args.lines,
        include_output=args.include_output,
    )
    blocking = [
        item for item in inventory["issues"] if item.get("severity") in {"P0", "P1"}
    ]
    result = {
        "ok": not blocking,
        "blocking_issue_count": len(blocking),
        "issues": inventory["issues"],
        "next_actions": inventory["next_actions"],
        "inventory": inventory,
    }
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print(
            f"conductor: {'ok' if result['ok'] else 'attention'} "
            f"({len(inventory['issues'])} issue(s), {len(blocking)} P0/P1)"
        )
        if inventory["issues"]:
            print("issues:")
            for item in inventory["issues"]:
                print(
                    f"  {item.get('severity')} {item.get('subject')} "
                    f"{item.get('code')}: {item.get('message')}"
                )
                if item.get("action"):
                    print(f"    action: {item.get('action')}")
        if inventory["next_actions"]:
            print("next actions:")
            for action in inventory["next_actions"]:
                print(f"  - {action}")
    return 0 if args.no_fail or not blocking else 2


def validate_batch_id(batch_id: str) -> str:
    value = str(batch_id or "").strip()
    if not BATCH_ID_RE.fullmatch(value):
        raise HLoopError(f"invalid batch id: {batch_id}; expected BNNN")
    return value


def state_batches(state: dict[str, Any]) -> dict[str, Any]:
    batches = state.setdefault("batches", {})
    if not isinstance(batches, dict):
        raise HLoopError("STATE.json batches must be an object")
    return batches


def current_batch_id(state: dict[str, Any]) -> str:
    value = str(state.get("current_batch_id") or "")
    return validate_batch_id(value) if value else ""


def require_batch(state: dict[str, Any], batch_id: str) -> dict[str, Any]:
    batch_id = validate_batch_id(batch_id)
    batches = state_batches(state)
    batch = batches.get(batch_id)
    if not isinstance(batch, dict):
        raise HLoopError(f"unknown batch: {batch_id}")
    return batch


def batch_task_ids(state: dict[str, Any], batch_id: str) -> list[str]:
    batch = require_batch(state, batch_id)
    ids = list(normalize_list(batch.get("task_ids")))
    for task_id, task_state in state.get("tasks", {}).items():
        if isinstance(task_state, dict) and str(task_state.get("batch_id") or "") == batch_id:
            ids.append(task_id)
    return sorted(dict.fromkeys(ids))


def write_batch_artifact(repo: Path, state: dict[str, Any], batch_id: str) -> None:
    batch = require_batch(state, batch_id)
    task_ids = batch_task_ids(state, batch_id)
    batch["task_ids"] = task_ids
    fields = {
        "id": batch_id,
        "title": str(batch.get("title") or batch_id),
        "status": str(batch.get("status") or "active"),
        "task_ids": task_ids,
        "started_at": str(batch.get("started_at") or batch.get("created_at") or ""),
        "closed_at": str(batch.get("closed_at") or ""),
        "checkpoint_mode": str(batch.get("checkpoint_mode") or "rollup"),
        "summary": str(batch.get("summary") or ""),
    }
    task_lines = [f"- {task_id}" for task_id in task_ids] or ["- No tasks assigned."]
    body = f"""# Batch {batch_id}: {fields["title"]}

## Purpose
{fields["title"]}

## Tasks
{chr(10).join(task_lines)}

## Commit Policy
Use `hloop checkpoint --batch {batch_id} --rollup --message "ai-loop({batch_id}): ..."` for loop-state-only commits while this batch is active. Rollup may amend only an unpushed namespaced loop checkpoint commit for the same batch.

## Summary
{fields["summary"] or "TBD by Manager."}
"""
    write_text(batch_file(repo, batch_id), frontmatter(fields) + "\n" + body)


def assign_tasks_to_batch(repo: Path, state: dict[str, Any], batch_id: str, task_ids: list[str]) -> None:
    batch = require_batch(state, batch_id)
    tasks = state.setdefault("tasks", {})
    existing = set(normalize_list(batch.get("task_ids")))
    for task_id in task_ids:
        if task_id not in tasks:
            raise HLoopError(f"unknown task: {task_id}")
        task_state = tasks[task_id]
        if not isinstance(task_state, dict):
            raise HLoopError(f"task state must be an object: {task_id}")
        task_state["batch_id"] = batch_id
        task_path = task_file(repo, task_id)
        if task_path.exists():
            replace_frontmatter(task_path, {"batch_id": batch_id})
        existing.add(task_id)
    batch["task_ids"] = sorted(existing)


def cmd_batch_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    batches = state_batches(state)
    batch_id = validate_batch_id(args.id) if args.id else next_id("B", batches)
    if batch_id in batches:
        raise HLoopError(f"batch already exists: {batch_id}")
    now = now_iso()
    batches[batch_id] = {
        "title": args.title,
        "status": "active",
        "task_ids": [],
        "created_at": now,
        "started_at": now,
        "checkpoint_mode": "rollup",
    }
    if args.task:
        assign_tasks_to_batch(repo, state, batch_id, args.task)
    if not args.no_current:
        state["current_batch_id"] = batch_id
    write_batch_artifact(repo, state, batch_id)
    save_state(repo, state)
    journal(repo, f"Started batch `{batch_id}`: {args.title}")
    print(f"started {batch_id}: {batch_file(repo, batch_id)}")
    return 0


def cmd_batch_assign(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    batch_id = validate_batch_id(args.batch_id)
    require_batch(state, batch_id)
    assign_tasks_to_batch(repo, state, batch_id, args.task_id)
    write_batch_artifact(repo, state, batch_id)
    save_state(repo, state)
    journal(repo, f"Assigned tasks to batch `{batch_id}`: {', '.join(args.task_id)}")
    print(f"assigned {len(args.task_id)} task(s) to {batch_id}")
    return 0


def cmd_batch_close(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    batch_id = validate_batch_id(args.batch_id or current_batch_id(state))
    batch = require_batch(state, batch_id)
    batch["status"] = args.status
    batch["closed_at"] = now_iso()
    batch["summary"] = args.summary
    if current_batch_id(state) == batch_id:
        state.pop("current_batch_id", None)
    write_batch_artifact(repo, state, batch_id)
    save_state(repo, state)
    journal(repo, f"Closed batch `{batch_id}` as `{args.status}`: {args.summary}")
    print(f"closed {batch_id}")
    return 0


def cmd_batch_list(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    current = current_batch_id(state)
    rows = []
    for batch_id, batch in sorted(state_batches(state).items()):
        if not isinstance(batch, dict):
            continue
        rows.append(
            {
                "id": batch_id,
                "status": batch.get("status", ""),
                "title": batch.get("title", ""),
                "task_ids": batch_task_ids(state, batch_id),
                "current": batch_id == current,
            }
        )
    if args.json:
        print(json.dumps({"current_batch_id": current, "batches": rows}, ensure_ascii=False, indent=2))
        return 0
    if not rows:
        print("no batches")
        return 0
    for row in rows:
        marker = "*" if row["current"] else " "
        tasks = ",".join(row["task_ids"]) or "-"
        print(f"{marker} {row['id']} {row['status']} tasks={tasks} {row['title']}")
    return 0


def cmd_batch_show(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    batch_id = validate_batch_id(args.batch_id or current_batch_id(state))
    batch = require_batch(state, batch_id)
    payload = {
        "id": batch_id,
        "current": current_batch_id(state) == batch_id,
        "artifact": str(batch_file(repo, batch_id)),
        "state": batch,
        "task_ids": batch_task_ids(state, batch_id),
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0
    print(f"{batch_id}: {batch.get('status', '')} {batch.get('title', '')}")
    print(f"artifact: {payload['artifact']}")
    print(f"current: {'yes' if payload['current'] else 'no'}")
    print("tasks: " + (", ".join(payload["task_ids"]) or "-"))
    if batch.get("summary"):
        print(f"summary: {batch.get('summary')}")
    return 0


def require_decision(state: dict[str, Any], decision_id: str) -> DecisionRecord:
    raw = state.setdefault("decisions", {}).get(decision_id)
    if raw is None:
        raise HLoopError(f"unknown decision: {decision_id}")
    try:
        return DecisionRecord.from_record(raw)
    except DecisionValidationError as exc:
        raise HLoopError(f"invalid decision record {decision_id}: {exc}") from exc


def decision_question_text(record: DecisionRecord, state: dict[str, Any]) -> str:
    option_lines: list[str] = []
    for index, option in enumerate(record.options, 1):
        option_lines.extend(
            [
                f"{index}. {option.label}",
                *[f"   - 利点・注意点: {tradeoff}" for tradeoff in option.tradeoffs],
            ]
        )
    recommended = next(
        item.label
        for item in record.options
        if item.option_id == record.recommendation.option_id
    )
    blocked = set(build_decision_scheduler(state).decision_blocked_task_ids)
    queued = {
        task_id
        for task_id, task in (state.get("tasks") or {}).items()
        if str(task.get("status") or "") == "queued"
    }
    independent = sorted(queued - blocked)
    if independent:
        later = (
            "この判断に依存しない作業は継続できます。"
            f" 現在は {len(independent)} 件の独立した作業を進められます。"
        )
    else:
        later = "安全に進められる独立作業がなくなるため、回答を待ちます。"
    reason = {
        DECISION_ADVISORY: "元の仕様を変えない範囲の選択ですが、理由を残す必要があります。",
        DECISION_DEFERRED_USER: "影響する作業だけを保留し、その他の作業を安全に続けるためです。",
        DECISION_BLOCKING_USER: "影響する作業を推測で進めず、安全な範囲を確定するためです。",
    }[record.decision_class]
    return "\n".join(
        [
            "# 判断のお願い",
            "",
            "## 何が決まっていないか",
            "",
            record.question,
            "",
            "## 今決める必要がある理由",
            "",
            reason,
            "",
            "## 選択肢",
            "",
            *option_lines,
            "",
            "## 推奨案",
            "",
            f"{recommended} — {record.recommendation.rationale}",
            "",
            "## 判断を後回しにした場合",
            "",
            later,
            "",
            "## 回答方法",
            "",
            "上の選択肢を選ぶか、希望する進め方を自由入力で伝えてください。",
            "",
        ]
    )


SPECIFICATION_RISK_MARKERS = (
    "user-visible",
    "public contract",
    "security",
    "authorization",
    "privacy",
    "credential",
    "data",
    "schema",
    "migration",
    "rollback",
    "breaking",
    "利用者",
    "公開",
    "認証",
    "認可",
    "秘密",
    "データ",
    "スキーマ",
    "移行",
    "破壊",
    "ロールバック",
)


def specification_scout_reasons(state: dict[str, Any]) -> list[str]:
    """Return stable reasons for ``auto`` Scout dispatch."""

    requirements = state.get("requirements") or {}
    implementation_tasks = [
        task
        for task in (state.get("tasks") or {}).values()
        if str(task.get("kind") or "implementation") in {"implementation", "fix"}
        and str(task.get("status") or "") == "queued"
    ]
    if not implementation_tasks:
        return []
    reasons: list[str] = []
    if len(requirements) > 1:
        reasons.append("multiple accepted requirements may interact")
    text_parts = [str(state.get("goal") or state.get("goal_id") or "")]
    for requirement in requirements.values():
        if isinstance(requirement, dict):
            text_parts.extend(normalize_list(requirement.get("acceptance")))
            if normalize_list(requirement.get("dependencies")):
                reasons.append("accepted requirements have dependencies")
    for task in implementation_tasks:
        text_parts.append(str(task.get("title") or ""))
        text_parts.extend(normalize_list(task.get("acceptance")))
        text_parts.append(str(task.get("validation_minimum") or ""))
    searchable = "\n".join(text_parts).lower()
    for marker in SPECIFICATION_RISK_MARKERS:
        if marker.lower() in searchable:
            reasons.append(f"specification-risk marker: {marker}")
    return list(dict.fromkeys(reasons))


def specification_scout_required(state: dict[str, Any]) -> tuple[bool, list[str]]:
    policy = str(state.get("specification_scout") or DEFAULT_SPECIFICATION_SCOUT)
    if policy not in SPECIFICATION_SCOUT_MODES:
        raise HLoopError(f"invalid specification_scout policy: {policy}")
    run = state.get("specification_scout_run") or {}
    if str(run.get("status") or "") in {"completed", "skipped"}:
        return False, []
    if policy == "off":
        return False, ["policy is off"]
    implementation_queued = any(
        str(task.get("status") or "") == "queued"
        and str(task.get("kind") or "implementation") in {"implementation", "fix"}
        for task in (state.get("tasks") or {}).values()
    )
    if not implementation_queued:
        return False, []
    if policy == "always":
        return True, ["policy is always"]
    reasons = specification_scout_reasons(state)
    return bool(reasons), reasons


def specification_scout_file(repo: Path) -> Path:
    return loop_path(repo) / "decisions" / "SCOUT.md"


def decision_liaison_file(repo: Path, decision_id: str) -> Path:
    return loop_path(repo) / "decisions" / decision_id / "RESPONSE.md"


def render_specification_scout_prompt(
    state: dict[str, Any], *, head_sha: str, reasons: list[str]
) -> str:
    reason_lines = "\n".join(f"- {reason}" for reason in reasons) or "- Manager requested it."
    artifact = (LOOP_DIR / "decisions" / "SCOUT.md").as_posix()
    return f"""You are the Specification Scout for herdr-dev-loop {SKILL_VERSION}.

Inspect MISSION.md, PLAN.md, PROFILE.md, DECISIONS.md, accepted requirements,
queued implementation tasks, and repository evidence at `{head_sha}`. Do not
edit product code and do not decide user-visible specifications yourself.

The automatic trigger reasons were:
{reason_lines}

Write only `{artifact}` with frontmatter containing `status: reported`,
`head_sha: {head_sha}`, and `run_id: {state.get('run_id', '')}`. In the body,
report unresolved questions, why each decision is needed, affected requirement
or task candidates, two or three options with tradeoffs and rollback cost,
the repository-supported recommendation, safe work that can continue, and the
cost of delaying the decision. If no decision is needed, state that clearly.

Finish with `HERDR_LOOP_SCOUT_DONE:{state.get('run_id', '')}:S001:reported`.
"""


def render_decision_liaison_prompt(
    record: DecisionRecord, state: dict[str, Any], *, head_sha: str
) -> str:
    question = decision_question_text(record, state)
    artifact = (LOOP_DIR / "decisions" / record.decision_id / "RESPONSE.md").as_posix()
    return f"""あなたは Decision Liaison です。仕様を決めるのではなく、利用者が
判断できるよう、次の質問を平易な日本語で説明し、回答を受け取ってください。

利用者向け本文に decision ID、task ID、state machine 用語、論理式を出さないでください。
二つか三つの選択肢、利点と欠点、推奨案と根拠、後回しにした場合に進められる範囲、
自由入力できることを示してください。

{question}

回答を得たら `{artifact}` だけを書き、frontmatter に
`decision_id: {record.decision_id}`、`responded_by: liaison`、
`responded_at`、選択肢が特定できる場合は `selected_option` を記録してください。
本文は `# 回答` の下に利用者の回答を日本語で記録してください。
対象 SHA は `{head_sha}` です。

完了時は `HERDR_LOOP_LIAISON_DONE:{state.get('run_id', '')}:{record.decision_id}:responded`
を表示してください。
"""


def write_decision_artifacts(repo: Path, state: dict[str, Any]) -> None:
    """Refresh canonical decision questions, responses, and Manager fallback."""

    records = decision_records_from_state(state)
    for decision_id, record in records.items():
        directory = loop_path(repo) / "decisions" / decision_id
        directory.mkdir(parents=True, exist_ok=True)
        question_fields = {
            "decision_id": decision_id,
            "class": record.decision_class,
            "status": record.status,
            "affected_task_ids": list(record.affected_task_ids),
            "source_findings": list(record.source_findings),
        }
        write_text(
            directory / "QUESTION.md",
            frontmatter(question_fields)
            + "\n"
            + decision_question_text(record, state),
        )
        if record.response is not None:
            response_fields = {
                "decision_id": decision_id,
                "responded_by": record.response.responded_by,
                "responded_at": record.response.responded_at,
                "selected_option": record.response.selected_option,
            }
            response_body = record.response.free_text or "選択肢を回答済みです。"
            write_text(
                directory / "RESPONSE.md",
                frontmatter(response_fields) + "\n# 回答\n\n" + response_body + "\n",
            )

    sections: dict[str, list[DecisionRecord]] = {
        "Pending Decisions": [],
        "Accepted Decisions": [],
        "Rejected Decisions": [],
        "Superseded Decisions": [],
    }
    for record in records.values():
        if record.status in {DECISION_PENDING, DECISION_ANSWERED}:
            sections["Pending Decisions"].append(record)
        elif record.status == DECISION_ACCEPTED:
            sections["Accepted Decisions"].append(record)
        elif record.status == DECISION_REJECTED:
            sections["Rejected Decisions"].append(record)
        else:
            sections["Superseded Decisions"].append(record)
    ledger = [
        "# Decisions",
        "",
        "Manager-owned record for specification choices and their scoped effects.",
        "",
    ]
    for heading, items in sections.items():
        ledger.extend([f"## {heading}", ""])
        if not items:
            ledger.extend(["None.", ""])
            continue
        for record in sorted(items, key=lambda item: item.decision_id):
            ledger.append(
                f"- `{record.decision_id}` [{record.decision_class}/{record.status}] "
                f"{record.question} (affects: {', '.join(record.affected_task_ids) or '-'})"
            )
        ledger.append("")
    write_text(loop_path(repo) / "DECISIONS.md", "\n".join(ledger))

    pending_user = [
        record
        for record in records.values()
        if record.unresolved and record.decision_class in hloop_decisions.USER_DECISION_CLASSES
    ]
    action_lines = ["# User Action Required", ""]
    if not pending_user:
        action_lines.append("利用者の判断待ちはありません。\n")
    else:
        action_lines.extend(
            [
                "次の判断を待っています。判断に依存しない作業は引き続き進めます。",
                "",
            ]
        )
        for record in sorted(pending_user, key=lambda item: item.decision_id):
            action_lines.extend(
                [
                    f"## {record.question}",
                    "",
                    f"詳しい選択肢: `decisions/{record.decision_id}/QUESTION.md`",
                    "",
                ]
            )
    write_text(loop_path(repo) / "USER_ACTION_REQUIRED.md", "\n".join(action_lines))

    state["decision_liaison"] = {
        "mode": "manager-fallback",
        "status": "waiting" if pending_user else "idle",
        "pending_decision_ids": [record.decision_id for record in pending_user],
        "updated_at": now_iso(),
    }


def default_decision_role_worktree(
    repo: Path, state: dict[str, Any], role_id: str, suffix: str
) -> Path:
    return configured_worktree_path(
        repo,
        state,
        role_id,
        f"{repo.name}.{slugify(role_id, 32)}-{suffix}",
    )


def cleanup_decision_role_worktree(
    repo: Path,
    role_id: str,
    role_state: dict[str, Any],
    *,
    prompt_suffix: str,
    best_effort: bool = False,
) -> None:
    worktree_raw = str(role_state.get("worktree") or "")
    if not worktree_raw:
        return
    worktree = Path(worktree_raw).resolve()
    if not worktree.exists() or role_state.get("worktree_cleaned_at"):
        return
    try:
        cleanup_hloop_prompt_file(worktree, role_id, prompt_suffix)
        git(repo, ["worktree", "remove", "--force", str(worktree)])
    except (HLoopError, subprocess.CalledProcessError) as exc:
        if best_effort:
            record_worktree_cleanup_failure(repo, role_state, role_id, exc)
            return
        raise
    role_state["worktree_cleanup_status"] = "removed"
    role_state["worktree_cleaned_at"] = now_iso()


def decision_role_fallback(
    repo: Path,
    state: dict[str, Any],
    role_state: dict[str, Any],
    *,
    role_label: str,
    reason: str,
    user_text: str,
) -> int:
    role_state.update(
        {
            "mode": "manager-fallback",
            "status": "waiting-manager",
            "gate_status": "waiting-manager",
            "fallback_reason": reason,
            "fallback_at": now_iso(),
        }
    )
    save_state(repo, state)
    journal(repo, f"{role_label} pane fallback activated: {reason}")
    print(f"{role_label} paneを開始できないため、Manager経由で続行します。")
    print(user_text.rstrip())
    return 0


def cmd_specification_scout_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    required, reasons = specification_scout_required(state)
    policy = str(state.get("specification_scout") or DEFAULT_SPECIFICATION_SCOUT)
    run = state.setdefault("specification_scout_run", {})
    if str(run.get("status") or "") in {"running", "reported", "completed"}:
        raise HLoopError(f"Specification Scout is already {run.get('status')}")
    if not required and not getattr(args, "force", False):
        run.update(
            {
                "status": "skipped",
                "gate_status": "skipped",
                "policy": policy,
                "reasons": reasons,
                "completed_at": now_iso(),
            }
        )
        save_state(repo, state)
        print("Specification Scout skipped: " + (", ".join(reasons) or "no auto trigger"))
        return 0
    if not reasons:
        reasons = ["Manager forced the Scout"]
    head_sha = git(repo, ["rev-parse", str(state["integration_branch"])])
    worktree_arg = getattr(args, "worktree", None)
    worktree = (
        Path(worktree_arg).resolve()
        if worktree_arg
        else default_decision_role_worktree(repo, state, "S001", "scout")
    )
    prompt_rel = LOOP_DIR / "prompts" / "S001.scout.md"
    artifact_rel = LOOP_DIR / "decisions" / "SCOUT.md"
    prompt = render_specification_scout_prompt(state, head_sha=head_sha, reasons=reasons)
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        return decision_role_fallback(
            repo,
            state,
            run,
            role_label="Specification Scout",
            reason="Herdr pane is unavailable",
            user_text=prompt,
        )
    runner = getattr(args, "runner", None) or "tui"
    agent_config = role_agent_config(
        state,
        "advisor",
        overrides={
            "agent_provider": getattr(args, "agent_provider", None),
            "agent_model": getattr(args, "agent_model", None),
        },
    )
    command_text, invocation = role_agent_command(
        repo,
        agent_config,
        runner=runner,
        prompt_rel=prompt_rel,
        cwd=worktree,
        output_rel=artifact_rel if runner == "exec" else None,
    )
    command = f"cd {shlex.quote(str(worktree))} && {command_text}"
    worktree_preexisting = worktree.exists()
    try:
        if not worktree_preexisting:
            git(repo, ["worktree", "add", "--detach", str(worktree), head_sha])
        prepare_role_worktree(repo, worktree, state, role="advisor", agent_id="S001")
        ensure_advisor_visible_in_worktree(worktree)
        ensure_worktree_parent_dirs(worktree, prompt_rel, artifact_rel)
        write_text(worktree / prompt_rel, prompt)
        baseline = porcelain_paths(worktree)
        if getattr(args, "launcher", "pane") == "agent":
            pane_id = start_agent_launcher(
                name=f"hloop-{state['goal_id']}-specification-scout",
                direction=getattr(args, "direction", "right"),
                cwd=worktree,
                command=command,
            )
        else:
            pane_id = start_pane_launcher(
                manager_pane=getattr(args, "manager_pane", None) or current_pane_id(),
                direction=getattr(args, "direction", "right"),
                cwd=worktree,
                command=command,
            )
    except (HLoopError, OSError, subprocess.CalledProcessError) as exc:
        rollback_failed_role_start(
            repo, worktree, created_worktree=not worktree_preexisting
        )
        return decision_role_fallback(
            repo,
            state,
            run,
            role_label="Specification Scout",
            reason=command_error_detail(exc),
            user_text=prompt,
        )
    run.update(
        {
            "role_id": "S001",
            "status": "running",
            "gate_status": "running",
            "mode": "agent-pane",
            "policy": policy,
            "reasons": reasons,
            "head_sha": head_sha,
            "pane_id": pane_id,
            "worktree": str(worktree),
            "prompt": str(worktree / prompt_rel),
            "artifact_path": str(specification_scout_file(repo)),
            "worktree_artifact_path": str(worktree / artifact_rel),
            "baseline_dirty_files": baseline,
            "agent_provider": agent_config["provider"],
            "agent_model": agent_config["model"],
            "runner": runner,
            "provider_invocation": invocation.as_record(),
            "started_at": now_iso(),
        }
    )
    state["phase"] = "specification_scout"
    save_state(repo, state)
    journal(repo, f"Started Specification Scout in pane `{pane_id}` at `{head_sha}`.")
    print(f"started Specification Scout in pane {pane_id}")
    return 0


def validate_decision_role_scope(
    worktree: Path,
    role_state: dict[str, Any],
    *,
    allowed: set[str],
) -> list[str]:
    baseline = set(normalize_list(role_state.get("baseline_dirty_files")))
    return [
        path
        for path in porcelain_paths(worktree)
        if path not in baseline and path not in allowed
    ]


def cmd_specification_scout_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    run = state.get("specification_scout_run") or {}
    if str(run.get("status") or "") != "running":
        raise HLoopError("Specification Scout is not running")
    worktree = Path(str(run.get("worktree") or "")).resolve()
    source = worktree / LOOP_DIR / "decisions" / "SCOUT.md"
    if not source.is_file() or not read_text(source).strip():
        raise HLoopError(f"Specification Scout artifact is missing: {source}")
    violations = validate_decision_role_scope(
        worktree,
        run,
        allowed={
            (LOOP_DIR / "decisions" / "SCOUT.md").as_posix(),
            (LOOP_DIR / "prompts" / "S001.scout.md").as_posix(),
        },
    )
    if violations:
        raise HLoopError(
            "Specification Scout changed files outside its artifact: "
            + ", ".join(violations)
        )
    destination = specification_scout_file(repo)
    write_text(destination, read_text(source))
    run.update(
        {
            "status": "reported",
            "gate_status": "reported",
            "artifact_path": str(destination),
            "worktree_artifact_path_harvested": str(source),
            "harvested_at": now_iso(),
        }
    )
    cleanup_completed_agent_pane(
        repo,
        run,
        label="Specification Scout",
        session_cleanup=session_cleanup_mode(args, state),
    )
    cleanup_decision_role_worktree(
        repo, "S001", run, prompt_suffix="scout", best_effort=True
    )
    save_state(repo, state)
    journal(repo, "Harvested Specification Scout; Manager decision triage is required.")
    print(f"harvested Specification Scout: {destination}")
    return 0


def cmd_specification_scout_close(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    run = state.get("specification_scout_run") or {}
    if str(run.get("status") or "") not in {"reported", "waiting-manager"}:
        raise HLoopError("Specification Scout is not ready to close")
    run.update(
        {
            "status": "completed",
            "gate_status": "completed",
            "verdict": args.verdict,
            "triage_reason": args.reason,
            "completed_at": now_iso(),
        }
    )
    state["phase"] = "blocked_user_decision" if args.verdict == "blocked" else "dispatching"
    save_state(repo, state)
    journal(repo, f"Closed Specification Scout as `{args.verdict}`: {args.reason}")
    print(f"closed Specification Scout: {args.verdict}")
    return 0


def start_decision_liaison(
    repo: Path,
    state: dict[str, Any],
    record: DecisionRecord,
    args: argparse.Namespace,
) -> int:
    liaisons = state.setdefault("decision_liaisons", {})
    liaison = liaisons.setdefault(record.decision_id, {})
    if str(liaison.get("status") or "") in {"running", "responded", "completed"}:
        print(f"Decision Liaison already {liaison.get('status')}: {record.decision_id}")
        return 0
    head_sha = git(repo, ["rev-parse", str(state["integration_branch"])])
    prompt = render_decision_liaison_prompt(record, state, head_sha=head_sha)
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        return decision_role_fallback(
            repo,
            state,
            liaison,
            role_label="Decision Liaison",
            reason="Herdr pane is unavailable",
            user_text=decision_question_text(record, state),
        )
    role_id = f"L-{record.decision_id}"
    worktree_arg = getattr(args, "worktree", None)
    worktree = (
        Path(worktree_arg).resolve()
        if worktree_arg
        else default_decision_role_worktree(repo, state, role_id, "liaison")
    )
    prompt_rel = LOOP_DIR / "prompts" / f"{role_id}.liaison.md"
    artifact_rel = LOOP_DIR / "decisions" / record.decision_id / "RESPONSE.md"
    agent_config = role_agent_config(
        state,
        "advisor",
        overrides={
            "agent_provider": getattr(args, "agent_provider", None),
            "agent_model": getattr(args, "agent_model", None),
        },
    )
    command_text, invocation = role_agent_command(
        repo,
        agent_config,
        runner="tui",
        prompt_rel=prompt_rel,
        cwd=worktree,
    )
    command = f"cd {shlex.quote(str(worktree))} && {command_text}"
    worktree_preexisting = worktree.exists()
    try:
        if not worktree_preexisting:
            git(repo, ["worktree", "add", "--detach", str(worktree), head_sha])
        prepare_role_worktree(repo, worktree, state, role="advisor", agent_id=role_id)
        ensure_advisor_visible_in_worktree(worktree)
        ensure_worktree_parent_dirs(worktree, prompt_rel, artifact_rel)
        write_text(worktree / prompt_rel, prompt)
        baseline = porcelain_paths(worktree)
        if getattr(args, "launcher", "pane") == "agent":
            pane_id = start_agent_launcher(
                name=f"hloop-{state['goal_id']}-{role_id}-liaison",
                direction=getattr(args, "direction", "right"),
                cwd=worktree,
                command=command,
            )
        else:
            pane_id = start_pane_launcher(
                manager_pane=getattr(args, "manager_pane", None) or current_pane_id(),
                direction=getattr(args, "direction", "right"),
                cwd=worktree,
                command=command,
            )
    except (HLoopError, OSError, subprocess.CalledProcessError) as exc:
        rollback_failed_role_start(
            repo, worktree, created_worktree=not worktree_preexisting
        )
        return decision_role_fallback(
            repo,
            state,
            liaison,
            role_label="Decision Liaison",
            reason=command_error_detail(exc),
            user_text=decision_question_text(record, state),
        )
    liaison.update(
        {
            "role_id": role_id,
            "decision_id": record.decision_id,
            "status": "running",
            "gate_status": "running",
            "mode": "agent-pane",
            "head_sha": head_sha,
            "pane_id": pane_id,
            "worktree": str(worktree),
            "prompt": str(worktree / prompt_rel),
            "response_path": str(decision_liaison_file(repo, record.decision_id)),
            "worktree_response_path": str(worktree / artifact_rel),
            "baseline_dirty_files": baseline,
            "agent_provider": agent_config["provider"],
            "agent_model": agent_config["model"],
            "provider_invocation": invocation.as_record(),
            "started_at": now_iso(),
        }
    )
    save_state(repo, state)
    journal(repo, f"Started Decision Liaison for `{record.decision_id}` in pane `{pane_id}`.")
    print(f"started Decision Liaison for {record.decision_id} in pane {pane_id}")
    return 0


def cmd_decision_liaison_start(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    record = require_decision(state, args.id)
    if record.decision_class not in hloop_decisions.USER_DECISION_CLASSES:
        raise HLoopError("Decision Liaison is only for user decision classes")
    return start_decision_liaison(repo, state, record, args)


def markdown_body_after_frontmatter(text: str) -> str:
    if not text.startswith("---\n"):
        return text.strip()
    marker = text.find("\n---\n", 4)
    return text[marker + 5 :].strip() if marker >= 0 else ""


def cmd_decision_liaison_harvest(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    record = require_decision(state, args.id)
    liaison = (state.get("decision_liaisons") or {}).get(args.id) or {}
    if str(liaison.get("status") or "") != "running":
        raise HLoopError(f"Decision Liaison is not running: {args.id}")
    worktree = Path(str(liaison.get("worktree") or "")).resolve()
    role_id = str(liaison.get("role_id") or f"L-{args.id}")
    source = worktree / LOOP_DIR / "decisions" / args.id / "RESPONSE.md"
    if not source.is_file() or not read_text(source).strip():
        raise HLoopError(f"Decision Liaison response is missing: {source}")
    violations = validate_decision_role_scope(
        worktree,
        liaison,
        allowed={
            (LOOP_DIR / "decisions" / args.id / "RESPONSE.md").as_posix(),
            (LOOP_DIR / "prompts" / f"{role_id}.liaison.md").as_posix(),
        },
    )
    if violations:
        raise HLoopError(
            "Decision Liaison changed files outside its response: "
            + ", ".join(violations)
        )
    text = read_text(source)
    meta = read_frontmatter(source)
    selected = str(meta.get("selected_option") or record.recommendation.option_id)
    body = markdown_body_after_frontmatter(text)
    body = re.sub(r"^# 回答\s*", "", body).strip()
    if not body:
        raise HLoopError("Decision Liaison response body is empty")
    try:
        updated = record_response(
            record,
            {
                "responded_by": str(meta.get("responded_by") or "liaison"),
                "responded_at": str(meta.get("responded_at") or now_iso()),
                "selected_option": selected,
                "free_text": body,
            },
        )
    except (DecisionValidationError, DecisionTransitionError) as exc:
        raise HLoopError(str(exc)) from exc
    state.setdefault("decisions", {})[args.id] = updated.to_record()
    destination = decision_liaison_file(repo, args.id)
    write_text(destination, text)
    liaison.update(
        {
            "status": "responded",
            "gate_status": "responded",
            "response_path": str(destination),
            "worktree_response_path_harvested": str(source),
            "harvested_at": now_iso(),
        }
    )
    cleanup_completed_agent_pane(
        repo,
        liaison,
        label=f"Decision Liaison {args.id}",
        session_cleanup=session_cleanup_mode(args, state),
    )
    cleanup_decision_role_worktree(
        repo, role_id, liaison, prompt_suffix="liaison", best_effort=True
    )
    write_decision_artifacts(repo, state)
    save_state(repo, state)
    journal(repo, f"Harvested Decision Liaison response for `{args.id}`.")
    print(f"harvested Decision Liaison response for {args.id}")
    return 0


def cmd_decision_new(args: argparse.Namespace) -> int:
    """Record one structured decision, ready for Liaison presentation."""

    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    decisions_state = state.setdefault("decisions", {})
    decision_id = args.id or next_id("D", decisions_state)
    if decision_id in decisions_state:
        raise HLoopError(f"decision already exists: {decision_id}")
    option_labels = args.option or ["推奨案を採用する", "別案を選ぶ"]
    if not 2 <= len(option_labels) <= 3:
        raise HLoopError("a decision requires 2 or 3 --option values")
    option_ids = [f"opt_{index}" for index in range(1, len(option_labels) + 1)]
    tradeoffs = getattr(args, "tradeoff", None) or option_labels
    if len(tradeoffs) != len(option_labels):
        raise HLoopError("provide exactly one --tradeoff for each --option")
    options = [
        {"id": option_id, "label": label, "tradeoffs": [tradeoff]}
        for option_id, label, tradeoff in zip(option_ids, option_labels, tradeoffs)
    ]
    recommend_option = args.recommend_option or option_ids[0]
    if recommend_option not in option_ids:
        raise HLoopError(f"--recommend-option must be one of {', '.join(option_ids)}")
    recommendation = {
        "option_id": recommend_option,
        "rationale": args.recommend_rationale
        or "repository evidence を踏まえ、最初の選択肢を暫定の推奨案とします。",
    }
    affected = normalize_list(args.affects)
    try:
        record = DecisionRecord(
            decision_id=decision_id,
            decision_class=args.decision_class,
            status=DECISION_PENDING,
            question=args.title,
            options=tuple(options),
            recommendation=recommendation,
            affected_task_ids=tuple(affected),
            source_findings=tuple(getattr(args, "source_finding", None) or ()),
            created_from=getattr(args, "created_from", None)
            or "specification-scout/manager fallback",
        )
    except DecisionValidationError as exc:
        raise HLoopError(str(exc)) from exc
    decisions_state[decision_id] = record.to_record()
    write_decision_artifacts(repo, state)
    save_state(repo, state)
    journal(
        repo,
        f"Opened decision `{decision_id}` ({record.decision_class}): {record.question}"
        + (f" (affects: {', '.join(affected)})" if affected else " (advisory scope; no task affected)"),
    )
    print(f"created {decision_id}")
    return 0


def cmd_decision_list(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    decisions_state = state.get("decisions") or {}
    rows = []
    for decision_id in sorted(decisions_state):
        try:
            record = DecisionRecord.from_record(decisions_state[decision_id])
        except DecisionValidationError:
            rows.append({"id": decision_id, "error": "invalid decision record"})
            continue
        rows.append(
            {
                "id": record.decision_id,
                "class": record.decision_class,
                "status": record.status,
                "question": record.question,
                "affected_task_ids": list(record.affected_task_ids),
                "blocks_affected_tasks": record.blocks_affected_tasks,
            }
        )
    if getattr(args, "json", False):
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0
    if not rows:
        print("no decisions")
        return 0
    for row in rows:
        if row.get("error"):
            print(f"{row['id']}: {row['error']}")
            continue
        affects = ",".join(row["affected_task_ids"]) or "-"
        blocking = " BLOCKING" if row["blocks_affected_tasks"] else ""
        print(
            f"{row['id']} [{row['class']}/{row['status']}]{blocking} "
            f"affects={affects} {row['question']}"
        )
    return 0


def cmd_decision_respond(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    decisions_state = state.setdefault("decisions", {})
    record = require_decision(state, args.id)
    selected_option = args.option or record.recommendation.option_id
    response = {
        "responded_by": args.responded_by or "manager",
        "responded_at": now_iso(),
        "selected_option": selected_option,
        "free_text": args.text,
    }
    try:
        updated = record_response(record, response)
        if args.recommendation:
            payload = updated.to_record()
            payload["recommendation"]["rationale"] = args.recommendation
            updated = DecisionRecord.from_record(payload)
    except (DecisionValidationError, DecisionTransitionError) as exc:
        raise HLoopError(str(exc)) from exc
    decisions_state[args.id] = updated.to_record()
    liaison = (state.get("decision_liaisons") or {}).get(args.id)
    if isinstance(liaison, dict):
        liaison["status"] = "responded"
        liaison["gate_status"] = "responded"
        liaison["responded_at"] = now_iso()
        if liaison.get("pane_id"):
            cleanup_completed_agent_pane(
                repo,
                liaison,
                label=f"Decision Liaison {args.id}",
                session_cleanup=session_cleanup_mode(args, state),
            )
        if liaison.get("worktree"):
            cleanup_decision_role_worktree(
                repo,
                str(liaison.get("role_id") or f"L-{args.id}"),
                liaison,
                prompt_suffix="liaison",
                best_effort=True,
            )
    write_decision_artifacts(repo, state)
    save_state(repo, state)
    journal(repo, f"Recorded response to decision `{args.id}`: {args.text}")
    print(f"responded {args.id}: status={updated.status}")
    return 0


def cmd_decision_resolve(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    decisions_state = state.setdefault("decisions", {})
    record = require_decision(state, args.id)
    rationale = args.note or f"Resolved via hloop decision resolve as {args.outcome}."
    try:
        updated = resolve_decision(
            record,
            outcome=args.outcome,
            rationale=rationale,
            resolved_by=args.resolved_by or "manager",
            resolved_at=now_iso(),
            selected_option=args.selected_option or "",
        )
    except (DecisionValidationError, DecisionTransitionError) as exc:
        raise HLoopError(str(exc)) from exc
    decisions_state[args.id] = updated.to_record()
    write_decision_artifacts(repo, state)
    save_state(repo, state)
    journal(repo, f"Resolved decision `{args.id}` as `{args.outcome}`: {rationale}")
    print(f"resolved {args.id}: status={updated.status}")
    return 0


def cmd_decision_reclassify(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    decisions_state = state.setdefault("decisions", {})
    record = require_decision(state, args.id)
    try:
        updated = reclassify_decision(record, args.decision_class)
    except (DecisionValidationError, DecisionTransitionError) as exc:
        raise HLoopError(str(exc)) from exc
    decisions_state[args.id] = updated.to_record()
    write_decision_artifacts(repo, state)
    save_state(repo, state)
    journal(repo, f"Reclassified decision `{args.id}` as `{args.decision_class}`.")
    print(f"reclassified {args.id}: class={updated.decision_class}")
    return 0


def create_loop_task(
    repo: Path,
    state: dict[str, Any],
    *,
    title: str,
    kind: str,
    priority: str,
    write_allow: list[str],
    write_deny: list[str],
    acceptance: list[str],
    depends_on: list[str],
    created_from: str,
    validation_minimum: str = "L1",
    branch: str | None = None,
    batch_id: str | None = None,
    worker_agent_provider: str | None = None,
    worker_agent_model: str | None = None,
    allow_no_write: bool = False,
) -> str:
    if kind == "implementation" and not write_allow and not allow_no_write:
        raise HLoopError("implementation tasks require at least one write_allow")
    if kind == "fix" and not write_allow and not allow_no_write:
        raise HLoopError("fix tasks require at least one write_allow")
    task_id = next_id("T", state.setdefault("tasks", {}))
    title_slug = slugify(title)
    task_branch = branch or f"ai/{state['goal_id']}/{task_id}-{title_slug}"
    base_ref = state["integration_branch"]
    if not branch_exists(repo, base_ref):
        raise HLoopError(f"base_ref does not exist: {base_ref}")
    base_sha = git(repo, ["rev-parse", base_ref])
    resolved_batch_id = validate_batch_id(batch_id) if batch_id else current_batch_id(state)
    if resolved_batch_id:
        require_batch(state, resolved_batch_id)
    fields = {
        "id": task_id,
        "run_id": str(state.get("run_id") or ""),
        "skill_version": SKILL_VERSION,
        "kind": kind,
        "status": "queued",
        "created_from": created_from,
        "branch": task_branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "priority": priority,
        "depends_on": depends_on,
        "write_allow": write_allow,
        "write_deny": write_deny,
        "acceptance": acceptance or ["Task acceptance criteria are satisfied."],
        "validation_minimum": validation_minimum,
        "worker_protocol": state_value(state, "worker_protocol", DEFAULT_WORKER_PROTOCOL),
        "worker_qa_profile": state_worker_qa_profile(state),
        "worker_agent_provider": normalize_agent_provider(
            worker_agent_provider or state.get("worker_agent_provider") or DEFAULT_AGENT_PROVIDER
        ),
        "worker_agent_model": normalize_agent_model(
            worker_agent_model or state.get("worker_agent_model") or DEFAULT_AGENT_MODEL
        ),
    }
    if resolved_batch_id:
        fields["batch_id"] = resolved_batch_id
    body = f"""# Task {task_id}: {title}

## Goal
{title}

## Context
Created from `{created_from}`.

Read:
- {LOOP_DIR.as_posix()}/MISSION.md
- {LOOP_DIR.as_posix()}/PLAN.md
- {LOOP_DIR.as_posix()}/DECISIONS.md
- {LOOP_DIR.as_posix()}/{created_from}.md if it exists

## Instructions
Follow this sequence:
1. Verify the referenced finding against the current code.
2. Implement the smallest safe fix.
3. Review your own diff.
4. Run targeted tests/build.
5. Write result artifact.
6. Commit your work.

Use the HLoop Worker Protocol from `{LOOP_DIR.as_posix()}/PROFILE.md` and your rendered worker prompt. Do not invoke an external implementation skill unless this task explicitly sets `worker_protocol: codex-impl`.

## Done when
{chr(10).join(f"- {item}" for item in fields["acceptance"])}
"""
    write_text(task_file(repo, task_id), frontmatter(fields) + "\n" + body)
    state["tasks"][task_id] = {
        "status": "queued",
        "branch": task_branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "write_allow": fields["write_allow"],
        "write_deny": fields["write_deny"],
        "depends_on": fields["depends_on"],
        "created_from": created_from,
        "worker_protocol": fields["worker_protocol"],
        "worker_qa_profile": fields["worker_qa_profile"],
        "agent_provider": fields["worker_agent_provider"],
        "agent_model": fields["worker_agent_model"],
        "created_at": now_iso(),
    }
    if resolved_batch_id:
        state["tasks"][task_id]["batch_id"] = resolved_batch_id
        batch = require_batch(state, resolved_batch_id)
        batch["task_ids"] = sorted(
            dict.fromkeys([*normalize_list(batch.get("task_ids")), task_id])
        )
        write_batch_artifact(repo, state, resolved_batch_id)
    disarm_final_gate_for_new_task(state, task_id)
    return task_id


def cmd_task_new(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(
        repo,
        require_integration_branch=True,
        mark_blocked=False,
    )
    if args.kind in {"implementation", "fix"} and not args.write_allow and not args.allow_no_write:
        raise HLoopError(f"{args.kind} tasks require at least one --write-allow")
    task_id = args.id or next_id("T", state.setdefault("tasks", {}))
    if task_id in state["tasks"]:
        raise HLoopError(f"task already exists: {task_id}")
    title_slug = slugify(args.title)
    branch = args.branch or f"ai/{state['goal_id']}/{task_id}-{title_slug}"
    base_ref = args.base_ref or state["integration_branch"]
    if not branch_exists(repo, base_ref):
        raise HLoopError(
            f"base_ref does not exist: {base_ref}. Run init with --create-branch "
            "or create/switch to the integration branch before adding tasks."
        )
    base_sha = args.base_sha or git(repo, ["rev-parse", base_ref])
    resolved_batch_id = validate_batch_id(args.batch_id) if args.batch_id else current_batch_id(state)
    if resolved_batch_id:
        require_batch(state, resolved_batch_id)
    requested_worker_qa_profile = getattr(args, "worker_qa_profile", None) or getattr(
        args, "qa_profile", None
    )
    validation_minimums = args.validation_minimum or ["L1"]
    validation_minimum: str | list[str]
    if len(validation_minimums) == 1:
        validation_minimum = validation_minimums[0]
    else:
        validation_minimum = validation_minimums
    fields = {
        "id": task_id,
        "run_id": str(state.get("run_id") or ""),
        "skill_version": SKILL_VERSION,
        "kind": args.kind,
        "status": "queued",
        "created_from": "PLAN.md",
        "branch": branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "priority": args.priority,
        "depends_on": args.depends_on or [],
        "write_allow": args.write_allow or [],
        "write_deny": args.write_deny or [],
        "acceptance": args.acceptance or ["Task acceptance criteria are satisfied."],
        "validation_minimum": validation_minimum,
        "worker_protocol": args.worker_protocol or state_value(state, "worker_protocol", DEFAULT_WORKER_PROTOCOL),
        "worker_qa_profile": args_worker_qa_profile(args)
        if requested_worker_qa_profile
        else state_worker_qa_profile(state),
        "worker_agent_provider": normalize_agent_provider(
            getattr(args, "worker_agent_provider", None)
            or state.get("worker_agent_provider")
            or DEFAULT_AGENT_PROVIDER
        ),
        "worker_agent_model": normalize_agent_model(
            getattr(args, "worker_agent_model", None)
            or state.get("worker_agent_model")
            or DEFAULT_AGENT_MODEL
        ),
    }
    if resolved_batch_id:
        fields["batch_id"] = resolved_batch_id
    body = f"""# Task {task_id}: {args.title}

## Goal
{args.title}

## Context
Read:
- {LOOP_DIR.as_posix()}/MISSION.md
- {LOOP_DIR.as_posix()}/PLAN.md

## Instructions
Follow this sequence:
1. Gap-check the task against the current code.
2. Implement the smallest safe change.
3. Review your own diff.
4. Run targeted tests/build.
5. Write result artifact.
6. Commit your work.

Use the HLoop Worker Protocol from `{LOOP_DIR.as_posix()}/PROFILE.md` and your rendered worker prompt. Do not invoke an external implementation skill unless this task explicitly sets `worker_protocol: codex-impl`.

## Done when
{chr(10).join(f"- {item}" for item in fields["acceptance"])}
"""
    write_text(task_file(repo, task_id), frontmatter(fields) + "\n" + body)
    state["tasks"][task_id] = {
        "status": "queued",
        "branch": branch,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "write_allow": fields["write_allow"],
        "write_deny": fields["write_deny"],
        "depends_on": fields["depends_on"],
        "worker_protocol": fields["worker_protocol"],
        "worker_qa_profile": fields["worker_qa_profile"],
        "agent_provider": fields["worker_agent_provider"],
        "agent_model": fields["worker_agent_model"],
        "created_at": now_iso(),
    }
    if resolved_batch_id:
        state["tasks"][task_id]["batch_id"] = resolved_batch_id
        batch = require_batch(state, resolved_batch_id)
        batch["task_ids"] = sorted(
            dict.fromkeys([*normalize_list(batch.get("task_ids")), task_id])
        )
        write_batch_artifact(repo, state, resolved_batch_id)
    disarm_final_gate_for_new_task(state, task_id)
    state["phase"] = "dispatching"
    save_state(repo, state)
    journal(repo, f"Created task `{task_id}`: {args.title}")
    print(f"created {task_id}: {task_file(repo, task_id)}")
    return 0


def updated_list(
    current: Any,
    additions: list[str] | None,
    removals: list[str] | None,
    replacement: list[str] | None = None,
) -> list[str]:
    values = list(replacement) if replacement is not None else normalize_list(current)
    values.extend(additions or [])
    removed = set(removals or [])
    return [item for item in dict.fromkeys(values) if item not in removed]


def cmd_task_update(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    task_id = args.task_id
    task_state = state.get("tasks", {}).get(task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"unknown task: {task_id}")
    path = task_file(repo, task_id)
    meta = read_frontmatter(path)
    updates: dict[str, Any] = {}
    list_specs = [
        ("write_allow", args.add_write_allow, args.remove_write_allow, None),
        ("write_deny", args.add_write_deny, args.remove_write_deny, None),
        (
            "acceptance",
            args.add_acceptance,
            None,
            args.set_acceptance if args.set_acceptance is not None else None,
        ),
    ]
    for key, additions, removals, replacement in list_specs:
        if additions or removals or replacement is not None:
            updates[key] = updated_list(meta.get(key), additions, removals, replacement)
    scalar_updates = {
        "priority": args.priority,
        "validation_minimum": args.validation_minimum,
        "worker_protocol": args.worker_protocol,
        "worker_qa_profile": args.worker_qa_profile,
        "worker_agent_provider": args.worker_agent_provider,
        "worker_agent_model": args.worker_agent_model,
    }
    updates.update({key: value for key, value in scalar_updates.items() if value is not None})
    if not updates:
        raise HLoopError("task update has no changes")
    kind = str(meta.get("kind") or "implementation")
    next_allow = normalize_list(updates.get("write_allow", meta.get("write_allow")))
    if kind in {"implementation", "fix"} and not next_allow:
        raise HLoopError(f"{kind} task must keep a non-empty write_allow")
    replace_frontmatter(path, updates)
    for key in (
        "write_allow",
        "write_deny",
        "acceptance",
        "priority",
        "validation_minimum",
        "worker_protocol",
        "worker_qa_profile",
    ):
        if key in updates:
            task_state[key] = updates[key]
    if "worker_agent_provider" in updates:
        task_state["agent_provider"] = normalize_agent_provider(updates["worker_agent_provider"])
    if "worker_agent_model" in updates:
        task_state["agent_model"] = normalize_agent_model(updates["worker_agent_model"])
    task_contract_digest = hashlib.sha256(path.read_bytes()).hexdigest()
    task_state["task_contract_digest"] = task_contract_digest
    task_state["contract_updated_at"] = now_iso()
    if task_state.get("status") == "running":
        attempt_id = str(task_state.get("active_attempt_id") or task_state.get("attempt_id") or "")
        if not attempt_id:
            raise HLoopError(f"running task has no active attempt identity: {task_id}")
        try:
            ack_floor = rebind_role_report_contract_digest(
                repo,
                state,
                role_id=task_id,
                attempt_id=attempt_id,
                task_contract_digest=task_contract_digest,
            )
        except (HLoopError, hloop_broker.BrokerStorageError, OSError) as exc:
            arm_semantic_ack_barrier(
                task_state,
                message_id=f"task-contract:{task_contract_digest}",
                digest=task_contract_digest,
                kind="task-contract",
            )
            task_state["semantic_ack_barrier"]["status"] = "identity_rebind_failed"
            task_state["semantic_ack_barrier"]["error"] = str(exc)
            save_state(repo, state)
            raise HLoopError(
                f"task contract changed but report identity rebinding failed for {task_id}; "
                "finalize, harvest, and merge remain blocked"
            ) from exc
        arm_semantic_ack_barrier(
            task_state,
            message_id=f"task-contract:{task_contract_digest}",
            digest=task_contract_digest,
            kind="task-contract",
            required_reack_after_sequence=ack_floor,
        )
    save_state(repo, state)
    if task_state.get("status") == "running":
        refresh_running_worker_contract_snapshot(
            repo,
            state,
            task_id,
            task_state,
            task_contract_digest=task_contract_digest,
        )
    journal(repo, f"Updated task contract `{task_id}`: {', '.join(sorted(updates))}.")
    print(f"updated {task_id}: {', '.join(sorted(updates))}")
    if task_state.get("status") == "running":
        print(
            "Worker contract digest changed to "
            f"{task_contract_digest}; a corrected semantic ACK and Manager approval are required "
            "before finalize, harvest, or merge. Send the changed requirements with `hloop worker message`."
        )
    else:
        print("checkpoint required before starting this task")
    return 0


def cmd_worker_finalize(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    local_state = load_state(repo)
    task_id = args.task_id
    contract_repo, state = canonical_worker_contract_source(repo, task_id, local_state)
    task_state = state.get("tasks", {}).get(task_id)
    if not isinstance(task_state, dict):
        raise HLoopError(f"unknown task: {task_id}")
    meta = read_frontmatter(task_file(contract_repo, task_id))
    if str(meta.get("id") or "") != task_id:
        raise HLoopError(f"task file mismatch for {task_id}")
    branch = current_branch(repo)
    expected_branch = str(task_state.get("branch") or meta.get("branch") or "")
    if expected_branch and branch != expected_branch:
        raise HLoopError(f"Worker branch mismatch: expected {expected_branch}, got {branch}")
    expected_worktree = str(task_state.get("worktree") or "")
    if expected_worktree and repo.resolve() != Path(expected_worktree).resolve():
        raise HLoopError(
            f"worker finalize must run in the active attempt worktree: expected {expected_worktree}, got {repo}"
        )
    status = str(args.status)
    if str(task_state.get("result_status") or "") in {"blocked", "failed", "partial"} and status == "done":
        raise HLoopError("a terminal blocked/failed/partial attempt must be requeued before status done")
    if status == "done":
        block_reason = semantic_ack_barrier_blocking(task_state)
        if block_reason:
            raise HLoopError(f"cannot finalize status done for {task_id}: {block_reason}")
    result_rel = LOOP_DIR / "results" / task_id / "result.md"
    dirty = [path for path in porcelain_paths(repo) if path != result_rel.as_posix()]
    if dirty:
        raise HLoopError(
            "worker finalize requires product changes to be committed first; dirty paths: "
            + ", ".join(dirty)
        )
    validation_commands = args.validation_command or []
    validation_results = args.validation_result or []
    blocking_questions = args.blocking_question or []
    validation_recorded = bool(validation_commands and validation_results)
    if len(validation_commands) != len(validation_results):
        raise HLoopError("--validation-command and --validation-result counts must match")
    validation_error = worker_validation_error(
        {
            "validation_recorded": validation_recorded,
            "validation_commands": validation_commands,
            "validation_results": validation_results,
        },
        require_recorded=status == "done",
        require_passing=status == "done",
    )
    if validation_error:
        raise HLoopError(f"invalid Worker validation for status {status}: {validation_error}")
    merge_ready = status == "done" and validation_recorded and not blocking_questions
    base_ref = str(task_state.get("base_ref") or meta.get("base_ref") or state.get("integration_branch") or "")
    if not base_ref:
        raise HLoopError(f"task base_ref is missing: {task_id}")
    base_proc = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "merge-base", "HEAD", base_ref], check=False
    )
    if base_proc.returncode != 0 or not (base_proc.stdout or "").strip():
        raise HLoopError(f"cannot resolve Worker branch point against {base_ref}")
    base_sha = str(task_state.get("worker_base_sha") or task_state.get("base_sha") or "")
    if not base_sha:
        base_sha = (base_proc.stdout or "").strip()
    if not is_ancestor(repo, base_sha, "HEAD"):
        raise HLoopError(f"active attempt base is not an ancestor of HEAD: {base_sha}")
    head_sha = git(repo, ["rev-parse", "HEAD"])
    files = changed_files(repo, base_sha, head_sha)
    files = list(dict.fromkeys([*files, result_rel.as_posix()]))
    violations = validate_change_scope(task_id, meta, files)
    if violations:
        raise HLoopError("write-scope violations: " + "; ".join(violations))
    fields = {
        "task_id": task_id,
        "run_id": str(state.get("run_id") or meta.get("run_id") or ""),
        "skill_version": SKILL_VERSION,
        "attempt_id": str(task_state.get("active_attempt_id") or task_state.get("attempt_id") or ""),
        "status": status,
        "merge_ready": merge_ready,
        "branch": branch,
        "head_sha": "HEAD",
        "base_sha": base_sha,
        "changed_files": files,
        "validation_recorded": validation_recorded,
        "validation_commands": validation_commands,
        "validation_results": validation_results,
        "validation_summary": args.validation_summary or "",
        "blocking_questions": blocking_questions,
    }
    body = f"# Worker Result {task_id}\n\nGenerated by `hloop worker finalize`.\n"
    write_text(repo / result_rel, frontmatter(fields) + "\n" + body)
    if not args.no_commit:
        # Loop artifacts are intentionally gitignored in some repositories. The
        # committed artifact is still the Worker/Manager hand-off contract, so
        # stage this one known path explicitly even in local-only loop setups.
        run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "add", "-f", "--", result_rel.as_posix()], check=True)
        staged = run_cmd(
            [TRUSTED_GIT_PATH, "-C", str(repo), "diff", "--cached", "--quiet", "--", result_rel.as_posix()],
            check=False,
        )
        if staged.returncode == 1:
            run_cmd(
                [TRUSTED_GIT_PATH, "-C", str(repo), "commit", "-m", f"ai-loop({task_id}): finalize worker result"],
                check=True,
                capture=False,
            )
        elif staged.returncode != 0:
            raise HLoopError("failed to inspect staged result artifact")
    print(f"finalized {task_id}: status={status} merge_ready={str(merge_ready).lower()}")
    print(
        f"HERDR_LOOP_ROLE_DONE:{fields['run_id']}:{task_id}:{fields['attempt_id']}:{status}"
    )
    return 0


def default_worktree(repo: Path, task_id: str, state: dict[str, Any] | None = None) -> Path:
    return configured_worktree_path(repo, state, task_id, f"{repo.name}.{task_id.lower()}")


def default_review_worktree(repo: Path, review_id: str, state: dict[str, Any] | None = None) -> Path:
    return configured_worktree_path(
        repo, state, review_id, f"{repo.name}.{review_id.lower()}-review"
    )


def default_gap_worktree(repo: Path, gap_id: str, state: dict[str, Any] | None = None) -> Path:
    return configured_worktree_path(repo, state, gap_id, f"{repo.name}.{gap_id.lower()}-gap")


def default_advisor_worktree(
    repo: Path,
    advice_id: str,
    participant_id: str,
    state: dict[str, Any] | None = None,
) -> Path:
    name = f"{advice_id}-{participant_id}"
    legacy = f"{repo.name}.{advice_id.lower()}-{participant_id.lower()}-advisor"
    return configured_worktree_path(repo, state, name, legacy)


def cleanup_hloop_prompt_file(worktree: Path, agent_id: str, suffix: str) -> None:
    prompt = worktree / LOOP_DIR / "prompts" / f"{agent_id}.{suffix}.md"
    try:
        if prompt.exists() or prompt.is_symlink():
            prompt.unlink()
        prompts_dir = prompt.parent
        if prompts_dir.exists():
            try:
                prompts_dir.rmdir()
            except OSError:
                pass
    except OSError as exc:
        raise HLoopError(f"failed to remove generated prompt {prompt}: {exc}") from exc


def cleanup_error_fingerprint(kind: str, detail: str) -> str:
    return hashlib.sha256(f"{kind}:{detail}".encode("utf-8")).hexdigest()[:16]


def record_worktree_cleanup_failure(
    repo: Path,
    agent_state: dict[str, Any],
    label: str,
    exc: BaseException,
) -> None:
    detail = command_error_detail(exc)
    agent_state["worktree_cleanup_status"] = "failed"
    agent_state["worktree_cleanup_error"] = detail
    agent_state["worktree_cleanup_error_fingerprint"] = cleanup_error_fingerprint("worktree", detail)
    agent_state["worktree_cleanup_failed_at"] = now_iso()
    journal(repo, f"Failed to remove {label} worktree: {detail}")
    print(f"warning: failed to remove {label} worktree: {detail}", file=sys.stderr)


def ensure_task_visible_in_worktree(worktree: Path, task_id: str) -> None:
    missing = [
        loop_path(worktree) / "MISSION.md",
        loop_path(worktree) / "PLAN.md",
        loop_path(worktree) / "PROFILE.md",
        loop_path(worktree) / "DECISIONS.md",
        task_file(worktree, task_id),
    ]
    absent = [str(path) for path in missing if not path.exists()]
    if absent:
        raise HLoopError(
            f"worker worktree does not contain required {LOOP_DIR.as_posix()} files. "
            "Use local-only snapshot copying or commit Manager-owned loop changes first. "
            f"Missing: {', '.join(absent)}"
        )


def ensure_review_visible_in_worktree(worktree: Path) -> None:
    missing = [
        loop_path(worktree) / "MISSION.md",
        loop_path(worktree) / "PLAN.md",
        loop_path(worktree) / "PROFILE.md",
