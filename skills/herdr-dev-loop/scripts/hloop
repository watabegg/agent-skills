def read_skill_version() -> str:
    version_path = SKILL_ROOT / "VERSION"
    try:
        version = version_path.read_text(encoding="utf-8").strip()
    except OSError as exc:
        raise HLoopError(f"cannot read skill version: {version_path}: {exc}") from exc
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?", version):
        raise HLoopError(f"invalid skill version in {version_path}: {version}")
    return version


class HLoopError(RuntimeError):
    pass


class ManagerMessageDeliveryUnknown(HLoopError):
    """The message was typed and an Enter attempt was made, but delivery could
    not be visually confirmed.  This is distinct from a confirmed failure: the
    caller must not treat it as ``undelivered`` and silently auto-retry it."""


SKILL_VERSION = read_skill_version()


