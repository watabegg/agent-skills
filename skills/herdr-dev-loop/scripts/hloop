def configure_loop_namespace(value: str | None) -> str:
    global LOOP_NAMESPACE, LOOP_DIR
    namespace = str(value or os.environ.get("HLOOP_NAMESPACE") or DEFAULT_LOOP_NAMESPACE).strip()
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,63}", namespace):
        raise HLoopError(
            "invalid loop namespace; use 1-64 lowercase letters, numbers, dot, underscore, or hyphen"
        )
    LOOP_NAMESPACE = namespace
    LOOP_DIR = LOOP_HOME / "loops" / namespace
    return namespace


def loop_namespace_flag() -> str:
    return f"--namespace {shlex.quote(LOOP_NAMESPACE)}"


def loop_display_path() -> str:
    return LOOP_DIR.as_posix()


def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


def filename_timestamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + f"-{time.time_ns()}"


def new_run_id(goal_id: str) -> str:
    return f"{filename_timestamp()}-{slugify(goal_id, 24)}"


def run_cmd(
    cmd: list[str],
    cwd: Path | None = None,
    check: bool = True,
    capture: bool = True,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        cwd=str(cwd) if cwd else None,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=check,
        env=env,
    )


def run_cmd_bytes(
    cmd: list[str],
    cwd: Path | None = None,
    check: bool = True,
    capture: bool = True,
    input_data: bytes | None = None,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[bytes]:
    """Run a command without decoding output that may contain Git path bytes."""

    return subprocess.run(
        cmd,
        cwd=str(cwd) if cwd else None,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=check,
        input=input_data,
        env=env,
    )


# The absolute path of the git executable this process has verified (or
# bootstrapped) against STATE.json's recorded identity.  `main()` resolves this
# once, before any other code path can execute a PATH `git`, and every git
# invocation below reads this instead of the bare `"git"` string so a PATH
# mutation after that check cannot retarget a later call (TOCTOU).  Direct
# library/test callers that never go through `main()` keep the prior
# PATH-lookup behavior via this default.
TRUSTED_GIT_PATH = "git"


def git(
    repo: Path,
    args: list[str],
    check: bool = True,
    *,
    env: dict[str, str] | None = None,
) -> str:
    proc = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), *args],
        check=check,
        env=env,
    )
    if proc.returncode != 0 and check:
        raise HLoopError(proc.stderr.strip())
    return (proc.stdout or "").strip()


def git_bytes(repo: Path, args: list[str], check: bool = True) -> bytes:
    """Return raw Git stdout for protocols whose records are byte-delimited."""

    proc = run_cmd_bytes([TRUSTED_GIT_PATH, "-C", str(repo), *args], check=False)
    if proc.returncode != 0 and check:
        raise HLoopError(os.fsdecode(proc.stderr or b"").strip())
    return proc.stdout or b""


def resolve_git_binary_fingerprint() -> dict[str, Any]:
    """Fingerprint the PATH git binary's path/device/inode/hash without executing it.

    Every field here is gathered with filesystem calls only (``shutil.which``,
    ``os.stat``, reading bytes for a hash), so this can run and be compared
    against a recorded identity *before* this process ever executes a
    PATH-resolved ``git``, closing the window a malicious PATH substitution
    would otherwise get to run in.
    """

    resolved = shutil.which("git")
    if not resolved:
        raise HLoopError("git command not found")
    real = os.path.realpath(resolved)
    stat = os.stat(real)
    digest = hashlib.sha256(Path(real).read_bytes()).hexdigest()
    return {
        "path": real,
        "st_dev": stat.st_dev,
        "st_ino": stat.st_ino,
        "sha256": digest,
    }


def git_executable_identity() -> dict[str, Any]:
    """Resolve the git binary HLoop is about to trust and fingerprint it.

    Recorded at ``init``/migration/``trust-git`` time and re-checked on every
    ``preflight_loop`` so a PATH-substituted or replaced ``git`` cannot silently
    change HLoop's trust boundary mid-run. The one intentional execution here
    (``--version``, for the human-readable record) targets the already-resolved
    absolute path, not a fresh PATH lookup.
    """

    fingerprint = resolve_git_binary_fingerprint()
    version_proc = run_cmd([fingerprint["path"], "--version"], check=False, capture=True)
    return {
        **fingerprint,
        "version": (version_proc.stdout or "").strip(),
        "recorded_at": now_iso(),
    }


def resolve_trusted_git_path(repo: Path | None) -> str:
    """Verify the PATH git binary against any recorded identity, with no exec.

    Called once at the very top of ``main()``, before ``repo_root()`` or any
    other code path executes a git subprocess. ``repo`` is located by a plain
    filesystem walk (see ``hloop_config.find_repo_root``), and STATE.json is
    read directly, so no git invocation happens before this decision is made.
    Raises before anything is trusted if a recorded identity does not match.
    """

    fingerprint = resolve_git_binary_fingerprint()
    if repo is not None:
        state_path = repo / LOOP_DIR / "STATE.json"
        if state_path.exists():
            try:
                state = json.loads(state_path.read_text(encoding="utf-8"))
            except (OSError, UnicodeDecodeError, json.JSONDecodeError):
                state = None
            recorded = state.get("git_identity") if isinstance(state, dict) else None
            if isinstance(recorded, dict) and recorded:
                drift = git_identity_drift(recorded, fingerprint)
                if drift:
                    raise HLoopError(
                        "git executable identity drift detected: "
                        f"{drift}; run `hloop runtime trust-git --reason <text>` to accept it"
                    )
    return fingerprint["path"]


def git_identity_drift(recorded: dict[str, Any], current: dict[str, Any]) -> str:
    """Return a human-readable drift description, or an empty string if trusted."""

    mismatches = [
        f"{field}: recorded={recorded.get(field)!r} current={current.get(field)!r}"
        for field in ("path", "st_dev", "st_ino", "sha256")
        if recorded.get(field) != current.get(field)
    ]
    return "; ".join(mismatches)


def command_error_detail(exc: BaseException) -> str:
    if isinstance(exc, subprocess.CalledProcessError):
        stderr = (exc.stderr or "").strip()
        stdout = (exc.stdout or "").strip()
        return stderr or stdout or str(exc)
    return str(exc)


def is_environment_git_error(detail: str) -> bool:
    lower = detail.lower()
    needles = [
        "read-only file system",
        "permission denied",
        "unable to create",
        "cannot lock",
        ".lock",
        "index.lock",
        "orig_head.lock",
        "would be overwritten by merge",
        "no space left on device",
        "input/output error",
    ]
    return any(needle in lower for needle in needles)


def repo_root(path: Path) -> Path:
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(path), "rev-parse", "--show-toplevel"], check=False)
    if proc.returncode != 0:
        raise HLoopError(f"not inside a git repository: {path}")
    return Path(proc.stdout.strip()).resolve()


def loop_path(repo: Path) -> Path:
    return repo / LOOP_DIR


def experience_path(repo: Path) -> Path:
    return repo / EXPERIENCE_DIR / "worktree-setup.json"


def load_worktree_experience(repo: Path) -> dict[str, Any]:
    path = experience_path(repo)
    if not path.exists():
        return {"schema_version": 1, "recommended_commands": [], "runs": []}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise HLoopError(f"invalid worktree setup experience: {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise HLoopError(f"worktree setup experience must be a JSON object: {path}")
    data.setdefault("schema_version", 1)
    data.setdefault("recommended_commands", [])
    data.setdefault("runs", [])
    return data


def save_worktree_experience(repo: Path, data: dict[str, Any]) -> None:
    runs = data.get("runs", [])
    if isinstance(runs, list) and len(runs) > 200:
        data["runs"] = runs[-200:]
    write_text(experience_path(repo), json.dumps(data, ensure_ascii=False, indent=2) + "\n")


def state_persistence(state: dict[str, Any]) -> str:
    value = str(state.get("persistence") or "branch-history")
    return value if value in {"local-only", "branch-history"} else "branch-history"


def setup_commands_for_role(state: dict[str, Any], role: str) -> list[str]:
    role_key = f"{role_state_prefix(role)}_setup_commands"
    if role_key in state:
        return normalize_list(state.get(role_key))
    # 0.3 compatibility: the old shared setup contract becomes Worker-only.
    return normalize_list(state.get("worktree_setup_commands")) if role == "worker" else []


def unsafe_setup_command(command: str) -> str:
    lowered = command.lower()
    markers = (
        ".claude",
        ".codex",
        "claude.md",
        "agents.md",
        "bypasspermissions",
        "dangerously-skip-permissions",
        "dangerously-bypass",
        "permission-mode",
    )
    return next((marker for marker in markers if marker in lowered), "")


def storage_paths(repo: Path, state: dict[str, Any]) -> list[Path]:
    candidates = [repo, Path(os.environ.get("TMPDIR") or "/tmp")]
    raw_root = str(state.get("worktree_root") or "")
    if raw_root:
        candidates.append(Path(raw_root))
    result: list[Path] = []
    for candidate in candidates:
        path = candidate.resolve()
        while not path.exists() and path != path.parent:
            path = path.parent
        if path.exists() and path not in result:
            result.append(path)
    return result


def storage_preflight(repo: Path, state: dict[str, Any]) -> list[dict[str, Any]]:
    required_bytes = normalize_int(state.get("min_free_bytes"), DEFAULT_MIN_FREE_BYTES)
    required_inodes = normalize_int(state.get("min_free_inodes"), DEFAULT_MIN_FREE_INODES)
    snapshots: list[dict[str, Any]] = []
    seen_devices: set[int] = set()
    for path in storage_paths(repo, state):
        stats = os.statvfs(path)
        device = path.stat().st_dev
        if device in seen_devices:
            continue
        seen_devices.add(device)
        free_bytes = stats.f_bavail * stats.f_frsize
        free_inodes = stats.f_favail
        item = {
            "path": str(path),
            "device": device,
            "free_bytes": free_bytes,
            "free_inodes": free_inodes,
            "required_bytes": required_bytes,
            "required_inodes": required_inodes,
        }
        snapshots.append(item)
        if required_bytes and free_bytes < required_bytes:
            raise HLoopError(
                f"disk preflight failed for {path}: free bytes {free_bytes} < {required_bytes}"
            )
        if required_inodes and free_inodes < required_inodes:
            raise HLoopError(
                f"disk preflight failed for {path}: free inodes {free_inodes} < {required_inodes}"
            )
        probe = path / f".hloop-write-probe-{os.getpid()}-{time.time_ns()}"
        try:
            with probe.open("wb") as fh:
                fh.write(b"hloop\n")
                fh.flush()
                os.fsync(fh.fileno())
        except OSError as exc:
            raise HLoopError(f"disk write probe failed for {path}: {exc}") from exc
        finally:
            try:
                probe.unlink()
            except FileNotFoundError:
                pass
    return snapshots


def ensure_local_only_git_excludes(repo: Path) -> None:
    git_common = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "rev-parse", "--git-common-dir"], check=False
    )
    if git_common.returncode != 0:
        raise HLoopError((git_common.stderr or git_common.stdout or "cannot resolve git common dir").strip())
    common = Path((git_common.stdout or "").strip())
    if not common.is_absolute():
        common = (repo / common).resolve()
    exclude = common / "info" / "exclude"
    exclude.parent.mkdir(parents=True, exist_ok=True)
    existing = exclude.read_text(encoding="utf-8") if exclude.exists() else ""
    additions = [
        pattern
        for pattern in (
            f"/{LOOP_DIR.as_posix()}/",
            f"/{(LOOP_ARCHIVE_ROOT / LOOP_NAMESPACE).as_posix()}/",
            f"/{EXPERIENCE_DIR.as_posix()}/",
            f"/{LEGACY_LOOP_DIR.as_posix()}/",
        )
        if pattern not in {line.strip() for line in existing.splitlines()}
    ]
    if additions:
        prefix = "" if not existing or existing.endswith("\n") else "\n"
        with exclude.open("a", encoding="utf-8") as fh:
            fh.write(prefix + "\n".join(additions) + "\n")


def copy_local_loop_snapshot(repo: Path, worktree: Path, state: dict[str, Any]) -> None:
    if state_persistence(state) != "local-only":
        return
    source = loop_path(repo)
    target = loop_path(worktree)
    if not source.exists():
        raise HLoopError(f"local-only loop snapshot is missing: {source}")
    shutil.copytree(source, target, dirs_exist_ok=True, ignore=shutil.ignore_patterns("prompts"))


def run_worktree_setup_commands(
    repo: Path,
    worktree: Path,
    state: dict[str, Any],
    *,
    role: str,
    agent_id: str,
) -> None:
    commands = setup_commands_for_role(state, role)
    if not commands:
        return
    experience = load_worktree_experience(repo)
    for command in commands:
        marker = unsafe_setup_command(command)
        if marker:
            raise HLoopError(
                f"unsafe worktree setup command for {role} {agent_id}: contains `{marker}`"
            )
        started = time.monotonic()
        proc = run_cmd(["bash", "-lc", command], cwd=worktree, check=False)
        record = {
            "at": now_iso(),
            "namespace": LOOP_NAMESPACE,
            "role": role,
            "agent_id": agent_id,
            "command": command,
            "outcome": "passed" if proc.returncode == 0 else "failed",
            "returncode": proc.returncode,
            "duration_ms": int((time.monotonic() - started) * 1000),
        }
        experience.setdefault("runs", []).append(record)
        save_worktree_experience(repo, experience)
        if proc.returncode != 0:
            raise HLoopError(
                f"worktree setup failed for {role} {agent_id}: {command}: "
                + ((proc.stderr or proc.stdout or f"exit {proc.returncode}").strip())
            )


def cmd_experience_show(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    data = load_worktree_experience(repo)
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        print(f"experience: {experience_path(repo)}")
        for command in normalize_list(data.get("recommended_commands")):
            print(f"recommended: {command}")
        for item in data.get("runs", [])[-10:]:
            print(
                f"{item.get('at')} {item.get('outcome')} {item.get('role')}/{item.get('agent_id')}: "
                f"{item.get('command')}"
            )
    return 0


def cmd_experience_recommend(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    data = load_worktree_experience(repo)
    commands = normalize_list(data.get("recommended_commands"))
    if args.remove:
        commands = [item for item in commands if item != args.command]
    elif args.command not in commands:
        commands.append(args.command)
    data["recommended_commands"] = commands
    data["updated_at"] = now_iso()
    save_worktree_experience(repo, data)
    print(f"recommended worktree setup commands: {len(commands)}")
    return 0


def cmd_namespace_list(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    root = repo / LOOP_HOME / "loops"
    items = []
    if root.exists():
        for path in sorted(root.iterdir()):
            if not path.is_dir():
                continue
            state_file = path / "STATE.json"
            state: dict[str, Any] = {}
            if state_file.exists():
                try:
                    parsed = json.loads(state_file.read_text(encoding="utf-8"))
                    if isinstance(parsed, dict):
                        state = parsed
                except (OSError, json.JSONDecodeError):
                    pass
            items.append(
                {
                    "namespace": path.name,
                    "path": str(path),
                    "goal_id": state.get("goal_id", ""),
                    "run_id": state.get("run_id", ""),
                    "phase": state.get("phase", "unknown"),
                    "skill_version": state.get("skill_version", "unversioned"),
                }
            )
    legacy_ignored = (repo / LEGACY_LOOP_DIR).exists()
    if args.json:
        print(
            json.dumps(
                {"selected_namespace": LOOP_NAMESPACE, "namespaces": items, "legacy_loop_ignored": legacy_ignored},
                ensure_ascii=False,
                indent=2,
            )
        )
    elif not items:
        print("no namespaced loops")
    else:
        for item in items:
            marker = "*" if item["namespace"] == LOOP_NAMESPACE else " "
            print(
                f"{marker} {item['namespace']}: phase={item['phase']} goal={item['goal_id'] or '-'} "
                f"version={item['skill_version']}"
            )
    if legacy_ignored and not args.json:
        print(f"legacy ignored: {LEGACY_LOOP_DIR.as_posix()}")
    return 0


def assert_migration_safe(repo: Path, state: dict[str, Any]) -> None:
    running = running_agent_ids(state)
    if running:
        raise HLoopError(
            "cannot migrate while role agents are running; abort them first: " + ", ".join(running)
        )
    if state.get("active_merge"):
        raise HLoopError("cannot migrate while a merge transaction is active")
    for role_kind, role_id, role_state in iter_all_roles(state):
        worktree_raw = str(role_state.get("worktree") or "")
        if worktree_raw and Path(worktree_raw).exists() and product_dirty_paths_for_agent(Path(worktree_raw)):
            raise HLoopError(f"cannot migrate dirty role worktree: {role_kind} {role_id}")


def migrate_format_one_to_two(state: dict[str, Any]) -> dict[str, Any]:
    result = json.loads(json.dumps(state))
    result["migrated_from_skill_version"] = str(state.get("skill_version") or "unversioned")
    result.setdefault("worker_setup_commands", normalize_list(state.get("worktree_setup_commands")))
    result.setdefault("reviewer_setup_commands", [])
    result.setdefault("gap_setup_commands", [])
    result.setdefault("advisor_setup_commands", [])
    result.setdefault("min_free_bytes", DEFAULT_MIN_FREE_BYTES)
    result.setdefault("min_free_inodes", DEFAULT_MIN_FREE_INODES)
    for prefix in ("worker", "reviewer", "gap", "advisor"):
        result.setdefault(f"{prefix}_agent_effort", DEFAULT_AGENT_EFFORT)
        result.setdefault(f"{prefix}_claude_permission_mode", DEFAULT_CLAUDE_PERMISSION_MODE)
    for task in result.get("tasks", {}).values():
        task.setdefault("attempt_no", 0)
        task.setdefault("attempts", [])
        if task.get("base_sha"):
            task.setdefault("worker_base_sha", task.get("base_sha"))
        if task.get("status") == "queued":
            task["skill_version"] = SKILL_VERSION
    result["needs_validation"] = bool(result.get("tasks"))
    result["needs_review"] = bool(result.get("reviews"))
    result["needs_gap_check"] = bool(result.get("gaps"))
    result["manager_qa_status"] = (
        "not-required" if state_manager_qa_profile(result) == "none" else "pending"
    )
    result["phase"] = "dispatching"
    return result


def migrate_format_two_to_three(state: dict[str, Any]) -> dict[str, Any]:
    result = json.loads(json.dumps(state))
    resolved_snapshot = json.loads(json.dumps(BUILT_IN_CONFIG_DEFAULTS))
    for key in ("max_workers", "session_cleanup", "specification_scout"):
        if key in state:
            resolved_snapshot[key] = state[key]
    for role in ("worker", "reviewer"):
        for key in ("provider", "model", "effort"):
            state_key = f"{role}_agent_{key}"
            if state_key in state:
                resolved_snapshot[role][key] = state[state_key]
    result.setdefault(
        "config_source",
        {"kind": "state-migration", "path": ""},
    )
    result.setdefault("resolved_config", resolved_snapshot)
    result.setdefault("manager_qa_evidence_path", (LOOP_DIR / "qa" / "FINAL.md").as_posix())
    result.setdefault(
        "artifact_policy",
        {
            "role_active": "role-worktree",
            "role_harvested": "manager-loop",
            "inputs": "local-only",
            "inbox": "local-only",
            "broker": "local-only",
        },
    )
    result.setdefault("final_gate", None)
    result.setdefault("resume_requirements", [])
    result.setdefault("pending_fix_task_drafts", [])
    result.setdefault("terminal_outcome", {})
    result.setdefault("specification_scout", DEFAULT_SPECIFICATION_SCOUT)
    if "specification_scout_run" not in result:
        already_dispatched = any(
            str(task.get("status") or "") != "queued"
            for task in (result.get("tasks") or {}).values()
            if isinstance(task, dict)
        )
        result["specification_scout_run"] = (
            {
                "status": "skipped",
                "gate_status": "skipped",
                "policy": result["specification_scout"],
                "reason": "migrated loop had already dispatched implementation work",
            }
            if already_dispatched
            else {}
        )
    result.setdefault("decision_liaisons", {})
    canonicalize_migrated_artifact_records(result)
    return result


def canonicalize_migrated_artifact_records(state: dict[str, Any]) -> None:
    """Rewrite harvested 0.4 artifact records to Manager-loop paths.

    Older states could retain a detached role-worktree path after harvest.
    Migration has no repository argument, so it records stable repo-relative
    paths; ``recorded_path`` resolves those against the active Manager repo.
    The original role path remains available as ``worktree_*_path_harvested``
    for diagnostics.
    """

    for task_id, task in (state.get("tasks") or {}).items():
        if not isinstance(task, dict):
            continue
        old_path = str(task.get("result_path") or "")
        if not old_path and str(task.get("status") or "") not in {
            "result_reported",
            "merged",
            "partial",
            "blocked",
            "failed",
            "abandoned",
        }:
            continue
        canonical = (LOOP_DIR / "results" / str(task_id) / "result.md").as_posix()
        if old_path and old_path != canonical:
            task.setdefault("worktree_result_path_harvested", old_path)
        task["result_path"] = canonical

    for review_id, review in (state.get("reviews") or {}).items():
        if not isinstance(review, dict) or not artifact_was_harvested(review):
            continue
        old_path = str(review.get("review_path") or "")
        canonical = (
            LOOP_DIR / "reviews" / str(review_id) / "FINAL.md"
            if str(review.get("mode") or "single") != "single"
            else LOOP_DIR / "reviews" / f"{review_id}.md"
        ).as_posix()
        if old_path and old_path != canonical:
            review.setdefault("worktree_review_path_harvested", old_path)
        review["review_path"] = canonical

    for gap_id, gap in (state.get("gaps") or {}).items():
        if not isinstance(gap, dict) or not artifact_was_harvested(gap):
            continue
        old_path = str(gap.get("gap_path") or "")
        canonical = (LOOP_DIR / "gaps" / f"{gap_id}.md").as_posix()
        if old_path and old_path != canonical:
            gap.setdefault("worktree_gap_path_harvested", old_path)
        gap["gap_path"] = canonical

    for advice_id, advice in (state.get("advice") or {}).items():
        if not isinstance(advice, dict):
            continue
        for participant in advice.get("participants") or []:
            if not isinstance(participant, dict) or not artifact_was_harvested(participant):
                continue
            participant_id = str(participant.get("participant_id") or "P1")
            old_path = str(participant.get("advice_path") or "")
            canonical = (
                LOOP_DIR / "advice" / f"{advice_id}-{participant_id}.md"
            ).as_posix()
            if old_path and old_path != canonical:
                participant.setdefault("worktree_advice_path_harvested", old_path)
            participant["advice_path"] = canonical


def migrate_format_three_revision_one(state: dict[str, Any]) -> dict[str, Any]:
    result = json.loads(json.dumps(state))
    result.setdefault("attempt_history", [])
    result.setdefault("cleanup_history", [])
    result.setdefault("lifecycle_diagnostics", [])
    return result


# Keep the command module's historical migration helper surface while the
# deterministic revision-2 transform lives in the reusable migration module.
migrate_format_three_revision_two = hloop_migration.migrate_format_three_revision_two


RUNTIME_MIGRATION_STEPS = (
    MigrationStep(
        SchemaVersion(1, 0),
        SchemaVersion(2, 0),
        "format-1-to-2",
        migrate_format_one_to_two,
    ),
    MigrationStep(
        SchemaVersion(2, 0),
        SchemaVersion(3, 0),
        "format-2-to-3",
        migrate_format_two_to_three,
    ),
    MigrationStep(
        SchemaVersion(3, 0),
        SchemaVersion(3, 1),
        "format-3-revision-1",
        migrate_format_three_revision_one,
    ),
    hloop_migration.FORMAT_3_REVISION_2_MIGRATION,
)


def migrated_runtime_state(repo: Path, state: dict[str, Any]) -> tuple[dict[str, Any], tuple[str, ...]]:
    assert_migration_safe(repo, state)
    try:
        migration = migrate_schema(
            state,
            target=RUNTIME_SCHEMA_VERSION,
            steps=RUNTIME_MIGRATION_STEPS,
        )
    except MigrationError as exc:
        raise HLoopError(str(exc)) from exc
    result = dict(migration.state)
    result.setdefault(
        "review_readiness",
        {"status": "pending", "target_sha": "", "errors": [], "checks": {}, "updated_at": ""},
    )
    convergence = result.get("review_convergence")
    if isinstance(convergence, dict):
        convergence.setdefault("base_ref", str(result.get("base_branch") or ""))
        convergence.setdefault("base_sha", "")
        convergence.setdefault("attempt_history", [])
    result["skill_version"] = SKILL_VERSION
    return result, migration.applied_steps


def migrated_state(repo: Path, state: dict[str, Any]) -> dict[str, Any]:
    """Compatibility adapter for 0.4 callers that passed unversioned state.

    The CLI migration always advances through the full runtime chain.  The
    imported helper historically upgraded an unversioned mapping to format 2,
    so that one-step behavior remains available to 0.4 characterization tests.
    """

    if "state_format_version" not in state:
        assert_migration_safe(repo, state)
        result = migrate_format_one_to_two(state)
        result["state_format_version"] = LEGACY_STATE_FORMAT_VERSION
        result["skill_version"] = SKILL_VERSION
        return result
    return migrated_runtime_state(repo, state)[0]


def cmd_migrate(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    updated, applied_steps = migrated_runtime_state(repo, state)
    source_version = schema_version_of(state)
    target_version = schema_version_of(updated)
    if not args.apply:
        print(
            json.dumps(
                {
                    "from_format": source_version.format_version,
                    "from_revision": source_version.revision,
                    "to_format": target_version.format_version,
                    "to_revision": target_version.revision,
                    "applied_steps": list(applied_steps),
                    "from_skill_version": state.get("skill_version", "unversioned"),
                    "to_skill_version": updated.get("skill_version"),
                    "run_id_preserved": state.get("run_id") == updated.get("run_id"),
                },
                ensure_ascii=False,
                indent=2,
            )
        )
        return 0
    backup = (
        loop_path(repo)
        / "migration"
        / f"STATE.v{source_version.format_version}.r{source_version.revision}.{filename_timestamp()}.json"
    )
    write_text(backup, json.dumps(state, ensure_ascii=False, indent=2) + "\n")
    save_state(repo, updated)
    journal(
        repo,
        f"Migrated state to format `{STATE_FORMAT_VERSION}` revision `{STATE_SCHEMA_REVISION}` "
        f"with backup `{backup.relative_to(repo)}`.",
    )
    print(
        f"migrated state to format {STATE_FORMAT_VERSION} revision {STATE_SCHEMA_REVISION}; "
        f"backup: {backup}"
    )
    return 0


def config_candidates_payload() -> tuple[list[hloop_config.ConfigCandidate], hloop_config.ConfigCandidate | None]:
    try:
        hloop_config.check_python_capability()
        candidates = hloop_config.discover_config_candidates()
        selected = hloop_config.find_config_file()
    except hloop_config.ConfigError as exc:
        raise HLoopError(str(exc)) from exc
    return candidates, selected


def cmd_config_path(args: argparse.Namespace) -> int:
    candidates, selected = config_candidates_payload()
    payload = {
        "selected": str(selected.path) if selected else None,
        "selected_source": selected.source if selected else None,
        "default_target": str(candidates[0].path),
        "candidates": [
            {"source": item.source, "path": str(item.path), "exists": item.path.is_file()}
            for item in candidates
        ],
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif selected:
        print(selected.path)
    else:
        print(f"no config file; default target: {candidates[0].path}")
    return 0


def selected_config_path(explicit: str | None = None) -> Path | None:
    if explicit:
        return hloop_config.canonicalize_path(explicit)
    _, selected = config_candidates_payload()
    return selected.path if selected else None


def validate_config_semantics(data: dict[str, Any]) -> None:
    errors: list[str] = []
    if data.get("version") != 1:
        errors.append("config.version must be 1")
    forbidden_key_fragments = ("token", "secret", "password", "credential", "api_key", "command")

    def validate_table(label: str, table: Any) -> None:
        if not isinstance(table, dict):
            return
        for key in table:
            normalized = str(key).lower()
            if any(fragment in normalized for fragment in forbidden_key_fragments):
                errors.append(f"{label}.{key} is not allowed in config.toml")
        max_workers = table.get("max_workers")
        if max_workers is not None and (
            isinstance(max_workers, bool) or not isinstance(max_workers, int) or max_workers < 1
        ):
            errors.append(f"{label}.max_workers must be a positive integer")
        cleanup = table.get("session_cleanup")
        if cleanup is not None and cleanup not in SESSION_CLEANUP_MODES:
            errors.append(
                f"{label}.session_cleanup must be one of {sorted(SESSION_CLEANUP_MODES)}"
            )
        scout_policy = table.get("specification_scout")
        if scout_policy is not None and scout_policy not in SPECIFICATION_SCOUT_MODES:
            errors.append(
                f"{label}.specification_scout must be one of "
                f"{sorted(SPECIFICATION_SCOUT_MODES)}"
            )
        for role in ("worker", "reviewer"):
            role_table = table.get(role)
            if not isinstance(role_table, dict):
                continue
            provider = role_table.get("provider")
            if provider is not None and provider not in AGENT_PROVIDERS:
                errors.append(f"{label}.{role}.provider must be one of {sorted(AGENT_PROVIDERS)}")
            providers = role_table.get("providers")
            if providers is not None and any(item not in AGENT_PROVIDERS for item in providers):
                errors.append(f"{label}.{role}.providers contains an unsupported provider")
            for key in ("model", "effort", "mode"):
                value = role_table.get(key)
                if isinstance(value, str) and ("\n" in value or "\x00" in value):
                    errors.append(f"{label}.{role}.{key} must be a single safe line")
            for key in role_table:
                normalized = str(key).lower()
                if any(fragment in normalized for fragment in forbidden_key_fragments):
                    errors.append(f"{label}.{role}.{key} is not allowed in config.toml")

    validate_table("defaults", data.get("defaults"))
    for index, scope in enumerate(data.get("scope") or []):
        validate_table(f"scope[{index}]", scope)
    if errors:
        raise HLoopError("invalid config: " + "; ".join(errors))


def cmd_config_validate(args: argparse.Namespace) -> int:
    path = selected_config_path(getattr(args, "path", None))
    if path is None:
        payload = {"ok": True, "path": None, "source": "built-in-default"}
    else:
        try:
            data = hloop_config.load_config_file(path)
            hloop_config.validate_config(data, base=path.parent)
            validate_config_semantics(data)
        except hloop_config.ConfigError as exc:
            raise HLoopError(str(exc)) from exc
        payload = {"ok": True, "path": str(path), "source": "config.toml"}
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif path is None:
        print("config valid: built-in defaults (no config file)")
    else:
        print(f"config valid: {path}")
    return 0


def cmd_config_explain(args: argparse.Namespace) -> int:
    target = hloop_config.canonicalize_path(
        getattr(args, "config_repo", None) or args.repo
    )
    try:
        selected = hloop_config.find_config_file()
        if selected is not None:
            validate_config_semantics(hloop_config.load_config_file(selected.path))
        resolution, selected = hloop_config.load_and_resolve(
            BUILT_IN_CONFIG_DEFAULTS,
            target_dir=target,
        )
    except hloop_config.ConfigError as exc:
        raise HLoopError(str(exc)) from exc
    payload = {
        "target": str(target),
        "repo_root": str(hloop_config.find_repo_root(target) or ""),
        "config_path": str(selected.path) if selected else None,
        "config_source": selected.source if selected else "built-in-default",
        "resolved": resolution.as_dict(),
        "values": resolution.explain(),
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(f"target: {payload['target']}")
        print(f"repo_root: {payload['repo_root'] or '-'}")
        print(f"config: {payload['config_path'] or 'built-in defaults'}")
        for row in payload["values"]:
            print(f"{row['key']} = {json.dumps(row['value'], ensure_ascii=False)} ({row['source']})")
    return 0


def cmd_config_init(args: argparse.Namespace) -> int:
    candidates, _ = config_candidates_payload()
    path = selected_config_path(getattr(args, "path", None)) or candidates[0].path
    if path.exists() and not args.force:
        raise HLoopError(f"config file already exists: {path}; use --force to replace it")
    write_text(path, CONFIG_TEMPLATE)
    if args.json:
        print(json.dumps({"created": str(path)}, ensure_ascii=False, indent=2))
    else:
        print(f"created config: {path}")
    return 0


def flattened_mapping(value: dict[str, Any], prefix: tuple[str, ...] = ()) -> dict[str, Any]:
    """Return dotted config leaves for stable apply previews."""

    leaves: dict[str, Any] = {}
    for key, item in value.items():
        path = (*prefix, str(key))
        if isinstance(item, dict):
            leaves.update(flattened_mapping(item, path))
        else:
            leaves[".".join(path)] = item
    return leaves


def config_apply_changes(
    previous: dict[str, Any], resolved: dict[str, Any]
) -> list[dict[str, Any]]:
    """Describe config snapshot changes without mutating either mapping."""

    before = flattened_mapping(previous)
    after = flattened_mapping(resolved)
    return [
        {"key": key, "before": before.get(key), "after": after.get(key)}
        for key in sorted(set(before) | set(after))
        if before.get(key) != after.get(key)
    ]


def apply_resolved_config_to_state(
    state: dict[str, Any],
    resolved: dict[str, Any],
    candidate: hloop_config.ConfigCandidate | None,
) -> None:
    """Replace the explicit loop snapshot and its runtime-facing leaves."""

    state["config_source"] = {
        "kind": candidate.source if candidate else "built-in-default",
        "path": str(candidate.path) if candidate else "",
    }
    state["resolved_config"] = resolved
    state["max_workers"] = resolved["max_workers"]
    state["session_cleanup"] = resolved["session_cleanup"]
    state["specification_scout"] = str(
        resolved.get("specification_scout") or DEFAULT_SPECIFICATION_SCOUT
    )
    review_policy = dict(hloop_config.REVIEW_POLICY_DEFAULTS)
    configured_review_policy = resolved.get("review")
    if isinstance(configured_review_policy, dict):
        review_policy.update(configured_review_policy)
    state["review_policy"] = review_policy
    for role in ("worker", "reviewer"):
        role_config = resolved.get(role) or {}
        state[f"{role}_agent_provider"] = normalize_agent_provider(
            role_config.get("provider")
        )
        state[f"{role}_agent_model"] = normalize_agent_model(role_config.get("model"))
        state[f"{role}_agent_effort"] = normalize_agent_effort(
            role_config.get("effort")
        )


def cmd_config_apply(args: argparse.Namespace) -> int:
    """Preview or explicitly apply a newly resolved config to an idle loop."""

    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    try:
        candidate = hloop_config.find_config_file()
        if candidate is not None:
            data = hloop_config.load_config_file(candidate.path)
            hloop_config.validate_config(data, base=candidate.path.parent)
            validate_config_semantics(data)
        resolution, candidate = hloop_config.load_and_resolve(
            BUILT_IN_CONFIG_DEFAULTS,
            target_dir=repo,
        )
    except hloop_config.ConfigError as exc:
        raise HLoopError(str(exc)) from exc

    resolved = resolution.as_dict()
    changes = config_apply_changes(state.get("resolved_config") or {}, resolved)
    previous_review_policy = review_policy_record(state)
    next_review_policy = dict(hloop_config.REVIEW_POLICY_DEFAULTS)
    configured_review_policy = resolved.get("review")
    if isinstance(configured_review_policy, dict):
        next_review_policy.update(configured_review_policy)
    review_policy_changed = _canonical_digest(previous_review_policy) != _canonical_digest(
        next_review_policy
    )
    next_source = {
        "kind": candidate.source if candidate else "built-in-default",
        "path": str(candidate.path) if candidate else "",
    }
    source_changed = state.get("config_source") != next_source
    payload = {
        "mode": "apply" if args.apply else "dry-run",
        "config_path": str(candidate.path) if candidate else None,
        "config_source": candidate.source if candidate else "built-in-default",
        "changes": changes,
        "source_changed": source_changed,
        "review_policy_changed": review_policy_changed,
        "changed": bool(changes) or source_changed or review_policy_changed,
    }
    if not args.apply:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0

    active_roles = running_agent_ids(state)
    if active_roles:
        raise HLoopError(
            "cannot apply config while roles are running: " + ", ".join(active_roles)
        )
    if state.get("active_merge"):
        raise HLoopError("cannot apply config while a merge transaction is active")
    if str(state.get("phase") or "") in RUN_TERMINAL_PHASES:
        raise HLoopError(f"cannot apply config to a terminal run: {state.get('phase')}")
    if changes or source_changed or review_policy_changed:
        apply_resolved_config_to_state(state, resolved, candidate)
        if review_policy_changed:
            # Review plans, convergence manifests, and manual-final
            # certification are all identified by the active policy.  A
            # policy change must invalidate those dependent artifacts before
            # the new snapshot becomes observable.
            invalidate_review_gates_for_change(
                state,
                reason="review-policy-config-change",
                target_sha=current_integration_target(repo, state),
            )
        state["config_applied_at"] = now_iso()
        save_state(repo, state)
        journal(
            repo,
            "Applied resolved config snapshot: "
            + (", ".join(item["key"] for item in changes) or "config_source"),
        )
    payload["applied"] = bool(changes) or source_changed or review_policy_changed
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


def init_config_override(args: argparse.Namespace) -> dict[str, Any]:
    override: dict[str, Any] = {}
    if getattr(args, "max_workers", None) is not None:
        override["max_workers"] = args.max_workers
    if getattr(args, "session_cleanup", None) is not None:
        override["session_cleanup"] = args.session_cleanup
    if getattr(args, "specification_scout", None) is not None:
        override["specification_scout"] = args.specification_scout
    for role in ("worker", "reviewer"):
        role_values: dict[str, Any] = {}
        for key in ("provider", "model", "effort"):
            value = getattr(args, f"{role}_agent_{key}", None)
            if value is not None:
                role_values[key] = value
        if role_values:
            override[role] = role_values
    return override


def resolve_init_config(
    args: argparse.Namespace, repo: Path
) -> tuple[hloop_config.ConfigResolution, hloop_config.ConfigCandidate | None]:
    try:
        selected = hloop_config.find_config_file()
        if selected is not None:
            validate_config_semantics(hloop_config.load_config_file(selected.path))
        resolution, selected = hloop_config.load_and_resolve(
            BUILT_IN_CONFIG_DEFAULTS,
            target_dir=repo,
            start_override=init_config_override(args),
        )
    except hloop_config.ConfigError as exc:
        raise HLoopError(str(exc)) from exc
    max_workers = resolution.get("max_workers")
    if isinstance(max_workers, bool) or not isinstance(max_workers, int) or max_workers < 1:
        raise HLoopError("resolved config max_workers must be a positive integer")
    session_cleanup = str(resolution.get("session_cleanup") or "")
    if session_cleanup not in SESSION_CLEANUP_MODES:
        raise HLoopError(
            "resolved config session_cleanup must be one of: "
            + ", ".join(sorted(SESSION_CLEANUP_MODES))
        )
    specification_scout = str(
        resolution.get("specification_scout") or DEFAULT_SPECIFICATION_SCOUT
    )
    if specification_scout not in SPECIFICATION_SCOUT_MODES:
        raise HLoopError(
            "resolved config specification_scout must be one of: "
            + ", ".join(sorted(SPECIFICATION_SCOUT_MODES))
        )
    args.max_workers = max_workers
    args.session_cleanup = session_cleanup
    args.specification_scout = specification_scout
    for role in ("worker", "reviewer"):
        setattr(
            args,
            f"{role}_agent_provider",
            normalize_agent_provider(resolution.get(role, "provider")),
        )
        setattr(
            args,
            f"{role}_agent_model",
            normalize_agent_model(resolution.get(role, "model")),
        )
        setattr(
            args,
            f"{role}_agent_effort",
            str(resolution.get(role, "effort") or DEFAULT_AGENT_EFFORT),
        )
    return resolution, selected


def _private_runtime_directory(path: Path) -> Path:
    """Create or repair one current-user-only HLoop runtime directory."""

    try:
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
        metadata = path.lstat()
    except OSError as exc:
        raise HLoopError(f"cannot prepare HLoop runtime directory {path}: {exc}") from exc
    if path.is_symlink() or not stat.S_ISDIR(metadata.st_mode):
        raise HLoopError(f"HLoop runtime directory must be a real directory: {path}")
    if metadata.st_uid != os.geteuid():
        raise HLoopError(f"HLoop runtime directory must be owned by the current user: {path}")
    try:
        path.chmod(0o700)
        metadata = path.lstat()
    except OSError as exc:
        raise HLoopError(f"cannot secure HLoop runtime directory {path}: {exc}") from exc
    if stat.S_IMODE(metadata.st_mode) != 0o700:
        raise HLoopError(f"HLoop runtime directory must have mode 0700: {path}")
    return path


def repo_lock_path(repo: Path) -> Path:
    """Return one private cross-worktree lock path for this repo/namespace."""

    uid = os.geteuid()
    runtime_root = _private_runtime_directory(
        REPOSITORY_LOCK_RUNTIME_BASE / f"herdr-dev-loop-{uid}"
    )
    lock_directory = _private_runtime_directory(runtime_root / "locks")
    identity = f"{git_common_dir(repo)}\0{LOOP_NAMESPACE}".encode("utf-8")
    digest = hashlib.sha256(identity).hexdigest()
    return lock_directory / f"{digest}.lock"


def state_path(repo: Path) -> Path:
    return loop_path(repo) / "STATE.json"


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except FileNotFoundError as exc:
        raise HLoopError(f"missing file: {path}") from exc


def fsync_directory(path: Path) -> None:
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
    descriptor = os.open(path, flags)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def write_text(path: Path, text: str, *, durable: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{time.time_ns()}.tmp")
    try:
        with tmp.open("w", encoding="utf-8") as stream:
            stream.write(text)
            if durable:
                stream.flush()
                os.fsync(stream.fileno())
        os.replace(tmp, path)
        if durable:
            fsync_directory(path.parent)
    except BaseException:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass
        raise


def ensure_worktree_parent_dirs(worktree: Path, *relative_paths: Path) -> None:
    for relative_path in relative_paths:
        (worktree / relative_path).parent.mkdir(parents=True, exist_ok=True)


def append_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(text)


@contextmanager
def loop_lock(repo: Path):
    lock_path = repo_lock_path(repo)
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(lock_path, flags, 0o600)
    except OSError as exc:
        raise HLoopError(f"cannot open HLoop repository lock {lock_path}: {exc}") from exc
    locked = False
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid():
            raise HLoopError("HLoop repository lock must be a regular file owned by the current user")
        os.fchmod(descriptor, 0o600)
        if stat.S_IMODE(os.fstat(descriptor).st_mode) != 0o600:
            raise HLoopError("HLoop repository lock must have mode 0600")
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        locked = True
        try:
            retire_legacy_loop_lock(repo)
            yield
        finally:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
            locked = False
    finally:
        if locked:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def retire_legacy_loop_lock(repo: Path) -> None:
    """Best-effort cleanup for the old worktree-visible namespaced LOCK file."""
    legacy = loop_path(repo) / "LOCK"
    if not legacy.exists() or not legacy.is_file():
        return
    tracked = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "ls-files", "--error-unmatch", str(LOOP_DIR / "LOCK")],
        check=False,
    )
    if tracked.returncode == 0:
        return
    try:
        with legacy.open("r+", encoding="utf-8") as fh:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            try:
                if legacy.stat().st_size == 0:
                    legacy.unlink()
            finally:
                fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
    except (BlockingIOError, OSError):
        return


def command_requires_loop_lock(args: argparse.Namespace) -> bool:
    command = getattr(args, "command", "")
    if command == "config":
        return getattr(args, "config_command", "") == "apply" and bool(
            getattr(args, "apply", False)
        )
    if command == "outcome":
        return getattr(args, "outcome_command", "") == "blocked"
    if command == "completion":
        return True
    if command == "verification":
        return getattr(args, "verification_command", "") == "record"
    if command in {"init", "migrate", "merge", "validate", "validation", "qa", "tick", "pump", "report", "checkpoint", "pause", "resume", "finish", "final-gates", "cleanup"}:
        return True
    if command == "release-scope":
        return getattr(args, "release_scope_command", "") in {"lock", "amend"}
    if command == "review":
        review_command = getattr(args, "review_command", "")
        if review_command == "epoch":
            return getattr(args, "review_epoch_command", "") != "status"
        if review_command in {"readiness", "reopen"}:
            return True
        return review_command == "convergence" and getattr(
            args, "review_convergence_command", ""
        ) in {"prepare", "record"}
    if command == "final-review":
        return getattr(args, "final_review_command", "") in {"prepare", "record"}
    if command == "dispatch":
        return getattr(args, "dispatch_command", "") in {"freeze", "unfreeze"}
    if command == "follow-up":
        return getattr(args, "follow_up_command", "") in {"add", "export"}
    if command == "batch":
        return getattr(args, "batch_command", "") in {"start", "assign", "close"}
    if command == "harvest":
        return True
    if command == "task":
        return getattr(args, "task_command", "") in {"new", "update"}
    if command == "worker":
        return getattr(args, "worker_command", "") in {
            "start",
            "submit",
            "candidate-seal",
            "finalize",
            "harvest",
            "seal",
            "accept-legacy-result",
            "message",
        }
    if command == "planning":
        return getattr(args, "planning_command", "") == "check"
    if command == "patch-review":
        return getattr(args, "patch_review_command", "") in {
            "start",
            "record",
            "harvest",
        }
    if command == "reviewer":
        return getattr(args, "reviewer_command", "") in {"start", "harvest", "close", "message"}
    if command == "gap":
        return getattr(args, "gap_command", "") in {"start", "harvest", "close", "message"}
    if command == "advisor":
        return getattr(args, "advisor_command", "") in {"request", "start", "harvest", "close", "message"}
    if command == "agent":
        return getattr(args, "agent_command", "") != "report"
    if command == "message":
        return True
    if command == "inbox":
        return getattr(args, "inbox_command", "") == "ack"
    if command == "manager":
        # The blocking sleep must release the repo lock so role reports can be
        # accepted while the Manager is suspended in the foreground.
        return getattr(args, "manager_command", "") != "sleep"
    if command == "broker":
        return getattr(args, "broker_command", "") == "recover"
    if command == "input":
        return True
    if command == "requirement":
        return True
    if command == "context":
        return True
    if command == "progress":
        return True
    if command == "experience":
        return getattr(args, "experience_command", "") == "recommend"
    if command == "triage":
        return not bool(getattr(args, "dry_run", False))
    return False


def command_requires_state_schema_guard(args: argparse.Namespace) -> bool:
    """Return whether a command may mutate resources governed by STATE.json.

    Migration is the only mutating command that intentionally accepts an older
    schema.  It performs its own future-version check before writing a backup
    or state.  ``wait --harvest`` acquires its lock only after an artifact is
    ready, so it needs the same guard without holding the lock while waiting.
    """

    command = getattr(args, "command", "")
    if command == "migrate":
        return False
    if command == "wait":
        return bool(getattr(args, "harvest", False))
    return command_requires_loop_lock(args)


def _has_local_state(repo: Path) -> bool:
    return state_path(repo).exists()


def load_state(repo: Path) -> dict[str, Any]:
    path = state_path(repo)
    if not path.exists():
        raise HLoopError(f"STATE.json not found: {path}")
    try:
        state = json.loads(read_text(path))
    except json.JSONDecodeError as exc:
        raise HLoopError(f"invalid STATE.json: {exc}") from exc
    if not isinstance(state, dict):
        raise HLoopError(f"STATE.json must be a JSON object: {path}")
    recorded_namespace = str(state.get("namespace") or LOOP_NAMESPACE)
    if recorded_namespace != LOOP_NAMESPACE:
        raise HLoopError(
            f"loop namespace mismatch: selected={LOOP_NAMESPACE} state={recorded_namespace}"
        )
    return state


def assert_mutating_state_schema_compatible(repo: Path) -> None:
    """Reject incompatible state before a mutating command can cause effects."""

    if not state_path(repo).exists():
        return
    state = load_state(repo)
    try:
        state_schema = schema_version_of(state)
    except MigrationError as exc:
        raise HLoopError(f"invalid state schema marker: {exc}") from exc
    if state_schema < RUNTIME_SCHEMA_VERSION:
        raise HLoopError(
            f"state migration required: {state_schema.label()} "
            f"runtime={RUNTIME_SCHEMA_VERSION.label()}; run `hloop migrate --dry-run` "
            "then `hloop migrate --apply`"
        )
    if state_schema > RUNTIME_SCHEMA_VERSION:
        raise HLoopError(
            f"state {state_schema.label()} is newer than runtime "
            f"{RUNTIME_SCHEMA_VERSION.label()}; mutating commands are disabled"
        )


def save_state(repo: Path, state: dict[str, Any]) -> None:
    state["updated_at"] = now_iso()
    _refresh_validation_staleness(repo, state)
    _refresh_execution_metrics(state)
    write_text(
        state_path(repo),
        json.dumps(state, ensure_ascii=False, indent=2) + "\n",
        durable=True,
    )


def _parse_metric_timestamp(value: Any) -> datetime | None:
    """Parse an observed state timestamp without manufacturing a value."""

    if not isinstance(value, str) or not value.strip():
        return None
    candidate = value.strip()
    if candidate.endswith("Z"):
        candidate = candidate[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(candidate)
    except ValueError:
        return None
    if parsed.tzinfo is None or parsed.utcoffset() is None:
        return None
    return parsed


def _observed_duration_seconds(start: Any, end: Any) -> float | None:
    started = _parse_metric_timestamp(start)
    finished = _parse_metric_timestamp(end)
    if started is None or finished is None:
        return None
    value = (finished - started).total_seconds()
    return round(value, 6) if value >= 0 else None


def _canonical_digest(value: Any) -> str:
    """Hash JSON-compatible evidence without depending on mapping order."""

    encoded = json.dumps(
        value,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def _repository_visible_paths(repo: Path) -> list[str]:
    """Return tracked and non-ignored paths used for identity snapshots."""
    try:
        output = git_bytes(
            repo,
            ["ls-files", "--cached", "--others", "--exclude-standard", "-z"],
            check=True,
        )
    except (HLoopError, OSError, subprocess.CalledProcessError):
        return []
    return sorted(
        set(
            parse_name_only_z(
                output,
                command="git ls-files --cached --others --exclude-standard -z",
            )
        )
    )


def _snapshot_file_group(repo: Path, paths: Sequence[str]) -> dict[str, Any]:
    entries: list[dict[str, Any]] = []
    for raw_path in sorted(dict.fromkeys(normalize_match_path(path) for path in paths)):
        path = repo / raw_path
        if path.is_file():
            digest = hashlib.sha256(path.read_bytes()).hexdigest()
            entries.append({"path": raw_path, "exists": True, "sha256": digest})
        else:
            # Retain deleted tracked files in the snapshot so deletion also
            # invalidates evidence recorded before the file disappeared.
            entries.append({"path": raw_path, "exists": False, "sha256": ""})
    return {
        "files": entries,
        "digest": _canonical_digest(entries),
    }


def _validation_dependency_identity(repo: Path, state: Mapping[str, Any]) -> dict[str, Any]:
    """Build the dependency/config/toolchain identity bound to validation."""

    visible_paths = _repository_visible_paths(repo)
    lockfiles = [
        path
        for path in visible_paths
        if Path(path).name.lower() in DEPENDENCY_LOCKFILE_NAMES
        or Path(path).name.lower().endswith((".lock", ".lockb", ".lockfile"))
    ]
    # Root-level dependency manifests are included because a repository can
    # intentionally omit a lockfile while still using a package manifest as
    # its dependency contract.
    dependency_manifests = [
        path
        for path in visible_paths
        if Path(path).name.lower()
        in {
            "cargo.toml",
            "composer.json",
            "gemfile",
            "package.json",
            "pipfile",
            "poetry.toml",
            "pyproject.toml",
            "requirements.txt",
            "setup.cfg",
            "setup.py",
        }
    ]
    lockfile_snapshot = _snapshot_file_group(repo, [*lockfiles, *dependency_manifests])
    toolchain_paths = [
        path
        for path in visible_paths
        if Path(path).name.lower() in TOOLCHAIN_FILE_NAMES
    ]
    toolchain_snapshot = _snapshot_file_group(repo, toolchain_paths)
    toolchain_snapshot["runtime"] = {
        "python_implementation": getattr(sys.implementation, "name", ""),
        "python_version": sys.version,
        "python_executable": sys.executable,
        "platform": sys.platform,
    }
    toolchain_snapshot["digest"] = _canonical_digest(toolchain_snapshot)
    resolved_config = state.get("resolved_config")
    resolved_config_snapshot = {
        "digest": _canonical_digest(resolved_config if resolved_config is not None else {}),
        "value": resolved_config if isinstance(resolved_config, Mapping) else {},
    }
    dependency_identity = _canonical_digest(
        {
            "lockfiles": lockfile_snapshot,
            "toolchain": toolchain_snapshot,
            "resolved_config": resolved_config_snapshot,
        }
    )
    return {
        "version": VALIDATION_SNAPSHOT_VERSION,
        "dependency_identity": dependency_identity,
        "lockfile_snapshot": lockfile_snapshot,
        "toolchain_snapshot": toolchain_snapshot,
        "resolved_config_snapshot": resolved_config_snapshot,
    }


def build_validation_identity(
    repo: Path,
    state: Mapping[str, Any],
    target_sha: str,
    commands: Sequence[str],
) -> dict[str, Any]:
    """Return the exact evidence identity required for validation reuse."""

    normalized_commands = [str(command) for command in commands]
    dependency = _validation_dependency_identity(repo, state)
    return {
        "version": VALIDATION_SNAPSHOT_VERSION,
        "target_sha": str(target_sha),
        "commands": normalized_commands,
        "command_set": sorted(normalized_commands),
        **dependency,
    }


# Keep a concise public spelling for tests and repository integrations.
validation_identity = build_validation_identity


def _validation_identity_matches(
    record: Mapping[str, Any] | None, identity: Mapping[str, Any]
) -> bool:
    if not isinstance(record, Mapping):
        return False
    stored = record.get("validation_identity")
    if not isinstance(stored, Mapping):
        stored = {
            "target_sha": record.get("head_sha"),
            "commands": record.get("commands"),
            "dependency_identity": record.get("dependency_identity"),
        }
    # Validation commands are an ordered execution contract.  Comparing a
    # sorted command set would allow a different sequence (and therefore a
    # different validation pipeline) to reuse old evidence.
    stored_commands = [str(item) for item in normalize_list(stored.get("commands"))]
    current_commands = [str(item) for item in normalize_list(identity.get("commands"))]
    return (
        str(stored.get("target_sha") or "") == str(identity.get("target_sha") or "")
        and stored_commands == current_commands
        and str(stored.get("dependency_identity") or "")
        == str(identity.get("dependency_identity") or "")
    )


def _validation_reusable(
    state: Mapping[str, Any], identity: Mapping[str, Any]
) -> bool:
    last = state.get("last_validation")
    if not isinstance(last, Mapping) or normalize_bool(state.get("validation_stale")):
        return False
    results = last.get("results")
    return bool(results) and all(
        isinstance(item, Mapping) and item.get("result") == "passed"
        for item in results
    ) and _validation_identity_matches(last, identity)


def _refresh_validation_staleness(repo: Path, state: dict[str, Any]) -> None:
    """Mark evidence stale when its fixed target or dependency identity drifts."""

    last = state.get("last_validation")
    if not isinstance(last, dict) or not isinstance(last.get("validation_identity"), Mapping):
        return
    integration = str(state.get("integration_branch") or "")
    if not integration:
        return
    try:
        target = git(repo, ["rev-parse", integration])
    except (HLoopError, OSError, subprocess.CalledProcessError):
        return
    commands = normalize_list(state.get("validation_commands")) or normalize_list(
        last.get("commands")
    )
    current = build_validation_identity(repo, state, target, commands)
    if _validation_identity_matches(last, current):
        state["validation_stale"] = False
        state.pop("validation_stale_reason", None)
        return
    state["validation_stale"] = True
    state["validation_stale_reason"] = (
        "validation identity changed: target SHA, command set, lockfile, "
        "toolchain, or resolved-config snapshot"
    )


def _validation_batch_id(state: Mapping[str, Any]) -> str:
    try:
        active = current_batch_id(dict(state))
    except HLoopError:
        active = ""
    return active or latest_closed_batch_id(state)


def _validation_duration(record: Mapping[str, Any]) -> float:
    raw = record.get("duration_seconds")
    if isinstance(raw, (int, float)) and not isinstance(raw, bool) and raw >= 0:
        return round(float(raw), 6)
    duration = _observed_duration_seconds(
        record.get("started_at") or record.get("validation_started_at"),
        record.get("completed_at") or record.get("at"),
    )
    return duration or 0.0


def _record_interval(record: Mapping[str, Any]) -> tuple[datetime, datetime] | None:
    started = _parse_metric_timestamp(record.get("started_at") or record.get("validation_started_at"))
    ended = _parse_metric_timestamp(record.get("completed_at") or record.get("closed_at") or record.get("at"))
    if started is None or ended is None or ended < started:
        return None
    return started, ended


def _batch_task_ids_for_metrics(state: Mapping[str, Any], batch_id: str) -> list[str]:
    batch = (state.get("batches") or {}).get(batch_id)
    if not isinstance(batch, Mapping):
        return []
    task_ids = set(normalize_list(batch.get("task_ids")))
    for task_id, task in (state.get("tasks") or {}).items():
        if isinstance(task, Mapping) and str(task.get("batch_id") or "") == batch_id:
            task_ids.add(str(task_id))
    return sorted(task_ids)


def _worker_interval(task: Mapping[str, Any]) -> tuple[datetime, datetime, float] | None:
    started = _parse_metric_timestamp(task.get("started_at"))
    if started is None:
        return None
    ended_value = next(
        (
            task.get(field_name)
            for field_name in (
                "completed_at",
                "finished_at",
                "harvested_at",
                "merged_at",
                "updated_at",
            )
            if task.get(field_name)
        ),
        None,
    )
    ended = _parse_metric_timestamp(ended_value)
    if ended is None or ended < started:
        return None
    duration = round((ended - started).total_seconds(), 6)
    return started, ended, duration


def _interval_inside(
    interval: tuple[datetime, datetime] | None,
    start: datetime | None,
    end: datetime | None,
) -> bool:
    if interval is None:
        return False
    observed_start, observed_end = interval
    if start is not None and observed_start < start:
        return False
    if end is not None and observed_end > end:
        return False
    return True


def _batch_validation_records(state: Mapping[str, Any]) -> list[Mapping[str, Any]]:
    records: list[Mapping[str, Any]] = []
    history = state.get("validation_history")
    if isinstance(history, Sequence) and not isinstance(history, (str, bytes)):
        records.extend(item for item in history if isinstance(item, Mapping))
    last = state.get("last_validation")
    if isinstance(last, Mapping):
        last_key = (
            str(last.get("validation_id") or ""),
            str(last.get("at") or last.get("completed_at") or ""),
            str(last.get("head_sha") or ""),
            tuple(normalize_list(last.get("commands"))),
            bool(last.get("reused")),
        )
        if not any(
            (
                str(item.get("validation_id") or ""),
                str(item.get("at") or item.get("completed_at") or ""),
                str(item.get("head_sha") or ""),
                tuple(normalize_list(item.get("commands"))),
                bool(item.get("reused")),
            )
            == last_key
            for item in records
        ):
            records.append(last)
    return records


def _batch_role_records(state: Mapping[str, Any]) -> list[Mapping[str, Any]]:
    records: list[Mapping[str, Any]] = []
    for group_name in ("reviews", "gaps"):
        group = state.get(group_name)
        if isinstance(group, Mapping):
            records.extend(item for item in group.values() if isinstance(item, Mapping))
    return records


def _batch_performance_record(
    state: Mapping[str, Any], batch_id: str, *, closed_at: str | None = None
) -> dict[str, Any]:
    batch = (state.get("batches") or {}).get(batch_id)
    if not isinstance(batch, Mapping):
        raise HLoopError(f"unknown batch: {batch_id}")
    task_ids = _batch_task_ids_for_metrics(state, batch_id)
    worker_intervals: list[tuple[datetime, datetime, float]] = []
    for task_id in task_ids:
        task = (state.get("tasks") or {}).get(task_id)
        if isinstance(task, Mapping):
            interval = _worker_interval(task)
            if interval is not None:
                worker_intervals.append(interval)

    batch_start = _parse_metric_timestamp(batch.get("started_at") or batch.get("created_at"))
    batch_end = _parse_metric_timestamp(closed_at or batch.get("closed_at"))
    if batch_start is None and worker_intervals:
        batch_start = min(item[0] for item in worker_intervals)
    if batch_end is None and worker_intervals:
        batch_end = max(item[1] for item in worker_intervals)
    wall_time = 0.0
    if batch_start is not None and batch_end is not None and batch_end >= batch_start:
        wall_time = round((batch_end - batch_start).total_seconds(), 6)
    worker_runtime = round(sum(item[2] for item in worker_intervals), 6)
    longest_worker = max((item[2] for item in worker_intervals), default=0.0)
    effective_parallelism = (
        round(worker_runtime / wall_time, 6) if wall_time > 0 else None
    )

    validation_time = 0.0
    review_wait = 0.0
    for record in _batch_validation_records(state):
        tagged = str(record.get("batch_id") or "") == batch_id
        if not tagged and not _interval_inside(_record_interval(record), batch_start, batch_end):
            continue
        validation_time += _validation_duration(record)
    for record in _batch_role_records(state):
        tagged = str(record.get("batch_id") or "") == batch_id
        interval = _record_interval(record)
        if not tagged and not _interval_inside(interval, batch_start, batch_end):
            continue
        if interval is not None:
            review_wait += round((interval[1] - interval[0]).total_seconds(), 6)
        else:
            review_wait += _observed_duration_seconds(
                record.get("started_at"),
                record.get("completed_at") or record.get("harvested_at") or record.get("closed_at"),
            ) or 0.0

    warnings: list[str] = []
    if (
        len(worker_intervals) >= 2
        and effective_parallelism is not None
        and effective_parallelism < 1.5
    ):
        warnings.append(
            "effective-parallelism-low: "
            f"{effective_parallelism:g} with {len(worker_intervals)} workers"
        )
    graph = batch.get("write_scope_conflict_graph")
    graph_digest = str(graph.get("digest") or "") if isinstance(graph, Mapping) else ""
    return {
        "batch_id": batch_id,
        "worker_count": len(worker_intervals),
        "wall_time_seconds": wall_time,
        "phase_wall_time_seconds": wall_time,
        "worker_runtime_seconds": worker_runtime,
        "worker_runtime_total_seconds": worker_runtime,
        "effective_parallelism": effective_parallelism,
        "longest_worker_seconds": round(longest_worker, 6),
        "validation_time_seconds": round(validation_time, 6),
        "review_wait_time_seconds": round(review_wait, 6),
        "warnings": list(dict.fromkeys(warnings)),
        "replan_required": bool(warnings),
        "conflict_graph_digest": graph_digest,
    }


def _refresh_batch_performance(
    state: dict[str, Any], batch_id: str, *, closed_at: str | None = None
) -> dict[str, Any]:
    batch = require_batch(state, batch_id)
    performance = _batch_performance_record(state, batch_id, closed_at=closed_at)
    batch["performance"] = performance
    # ``metrics`` is retained as a concise compatibility spelling for callers
    # that treat the batch record as a metrics envelope.
    batch["metrics"] = dict(performance)
    for key, value in performance.items():
        if key in {
            "batch_id",
            "worker_count",
            "wall_time_seconds",
            "worker_runtime_seconds",
            "effective_parallelism",
            "longest_worker_seconds",
            "validation_time_seconds",
            "review_wait_time_seconds",
            "warnings",
            "replan_required",
            "conflict_graph_digest",
        }:
            batch[key] = value
    return performance


def _batch_performance_records(state: Mapping[str, Any]) -> list[dict[str, Any]]:
    records: list[dict[str, Any]] = []
    batches = state.get("batches")
    if not isinstance(batches, Mapping):
        return records
    for batch_id, batch in batches.items():
        if not isinstance(batch, Mapping):
            continue
        performance = batch.get("performance") or batch.get("metrics")
        if isinstance(performance, Mapping):
            record = dict(performance)
            record.setdefault("batch_id", str(batch_id))
            records.append(record)
    return sorted(records, key=lambda item: str(item.get("batch_id") or ""))


def build_write_scope_conflict_graph(
    state: Mapping[str, Any],
    task_ids: Sequence[str] | None = None,
    *,
    batch_id: str = "",
) -> dict[str, Any]:
    """Build deterministic evidence for pairwise Worker write-scope conflicts."""

    if task_ids is None:
        selected = (
            _batch_task_ids_for_metrics(state, batch_id)
            if batch_id
            else sorted(str(task_id) for task_id in (state.get("tasks") or {}))
        )
    else:
        selected = sorted(dict.fromkeys(str(task_id) for task_id in task_ids))
    tasks = state.get("tasks")
    tasks = tasks if isinstance(tasks, Mapping) else {}
    nodes: dict[str, dict[str, Any]] = {}
    for task_id in selected:
        task = tasks.get(task_id)
        if not isinstance(task, Mapping):
            continue
        nodes[task_id] = {
            "status": str(task.get("status") or ""),
            "batch_id": str(task.get("batch_id") or ""),
            "write_allow": sorted(dict.fromkeys(normalize_list(task.get("write_allow")))),
        }
    edges: list[dict[str, Any]] = []
    conflicts = {task_id: [] for task_id in nodes}
    node_ids = sorted(nodes)
    for index, left_id in enumerate(node_ids):
        for right_id in node_ids[index + 1 :]:
            left_allow = nodes[left_id]["write_allow"]
            right_allow = nodes[right_id]["write_allow"]
            if not write_sets_overlap(left_allow, right_allow):
                continue
            edges.append(
                {
                    "tasks": [left_id, right_id],
                    "write_allow": sorted(dict.fromkeys([*left_allow, *right_allow])),
                }
            )
            conflicts[left_id].append(right_id)
            conflicts[right_id].append(left_id)
    graph = {
        "version": 1,
        "batch_id": batch_id,
        "task_ids": node_ids,
        "nodes": nodes,
        "edges": edges,
        "conflicts": {task_id: sorted(values) for task_id, values in conflicts.items()},
    }
    graph["digest"] = _canonical_digest(graph)
    graph["generated_at"] = now_iso()
    return graph


def persist_write_scope_conflict_graph(
    state: dict[str, Any],
    *,
    batch_id: str = "",
    task_ids: Sequence[str] | None = None,
) -> dict[str, Any]:
    graph = build_write_scope_conflict_graph(state, task_ids, batch_id=batch_id)
    state["write_scope_conflict_graph"] = graph
    resolved_batch_id = batch_id or str(state.get("current_batch_id") or "")
    if resolved_batch_id:
        batches = state.get("batches")
        batch = batches.get(resolved_batch_id) if isinstance(batches, Mapping) else None
        if isinstance(batch, dict):
            batch["write_scope_conflict_graph"] = json.loads(
                json.dumps(graph, ensure_ascii=False)
            )
    return graph


def active_write_scope_conflicts(state: Mapping[str, Any], task_id: str) -> list[str]:
    graph = build_write_scope_conflict_graph(state)
    conflicts = graph.get("conflicts")
    tasks = state.get("tasks")
    if not isinstance(conflicts, Mapping) or not isinstance(tasks, Mapping):
        return []
    return sorted(
        conflict_id
        for conflict_id in normalize_list(conflicts.get(task_id))
        if isinstance(tasks.get(conflict_id), Mapping)
        and str(tasks[conflict_id].get("status") or "")
        in {"running", "starting", "awaiting_result"}
    )


def _state_metric_counts(
    records: Mapping[str, Any] | None,
    *,
    key: str,
    statuses: set[str],
) -> int:
    if not isinstance(records, Mapping):
        return 0
    return sum(
        1
        for record in records.values()
        if isinstance(record, Mapping) and str(record.get(key) or "") in statuses
    )


def _refresh_execution_metrics(state: dict[str, Any]) -> None:
    """Refresh counters that are derivable from the durable state snapshot.

    This deliberately leaves values unknown when the state has no timestamp or
    evidence for them.  The helper is called at every state write so CLI
    transitions cannot silently leave the report projection stale.
    """

    metrics = state.get("execution_metrics")
    if not isinstance(metrics, dict):
        return

    tasks = state.get("tasks")
    tasks = tasks if isinstance(tasks, Mapping) else {}
    origin_counts: dict[str, int] = {}
    scope_revision_counts: dict[str, int] = {}
    planned_task_ids: list[str] = []
    worker_durations: list[float] = []
    worker_intervals: list[tuple[datetime, datetime, float]] = []
    worker_started_count = 0
    for task_id, task in tasks.items():
        if not isinstance(task, Mapping):
            continue
        origin = str(task.get("task_origin") or "legacy-unclassified")
        origin_counts[origin] = origin_counts.get(origin, 0) + 1
        scope_revision = str(task.get("release_scope_revision") or 0)
        scope_revision_counts[scope_revision] = scope_revision_counts.get(scope_revision, 0) + 1
        if origin == "planned":
            planned_task_ids.append(str(task_id))
        if task.get("started_at"):
            worker_started_count += 1
            ended_value = (
                task.get("completed_at")
                or task.get("harvested_at")
                or task.get("finished_at")
                or task.get("merged_at")
                or task.get("updated_at")
            )
            duration = _observed_duration_seconds(task.get("started_at"), ended_value)
            if duration is not None:
                worker_durations.append(duration)
                started = _parse_metric_timestamp(task.get("started_at"))
                ended = _parse_metric_timestamp(ended_value)
                if started is not None and ended is not None:
                    worker_intervals.append((started, ended, duration))

    metrics["planned_task_count"] = origin_counts.get("planned", 0)
    metrics["remediation_task_count"] = origin_counts.get("finding", 0)
    metrics["task_origin_counts"] = dict(sorted(origin_counts.items()))
    metrics["scope_revision_counts"] = dict(sorted(scope_revision_counts.items()))
    metrics["worker_count"] = worker_started_count
    metrics["worker_runtime_seconds"] = round(sum(worker_durations), 6)
    metrics["longest_worker_seconds"] = max(worker_durations, default=0.0)
    if worker_intervals:
        wall_start = min(item[0] for item in worker_intervals)
        wall_end = max(item[1] for item in worker_intervals)
        wall_seconds = (wall_end - wall_start).total_seconds()
        metrics["effective_parallelism"] = (
            round(sum(item[2] for item in worker_intervals) / wall_seconds, 6)
            if wall_seconds > 0
            else None
        )
    if planned_task_ids:
        metrics["planned_task_completed"] = all(
            str(tasks[task_id].get("status") or "") in {"done", "merged"}
            for task_id in planned_task_ids
            if isinstance(tasks.get(task_id), Mapping)
        )
    else:
        metrics["planned_task_completed"] = False

    reviews = state.get("reviews")
    reviews = reviews if isinstance(reviews, Mapping) else {}
    gaps = state.get("gaps")
    gaps = gaps if isinstance(gaps, Mapping) else {}
    metrics["review_completed_count"] = _state_metric_counts(
        reviews, key="gate_status", statuses={"reported", "triaged", "passed", "completed"}
    )
    metrics["stale_review_count"] = _state_metric_counts(
        reviews, key="status", statuses={"stale", "stale_target", "stale_review"}
    )
    metrics["aborted_review_count"] = _state_metric_counts(
        reviews, key="status", statuses={"aborted", "aborted_review"}
    )
    metrics["timeout_review_count"] = _state_metric_counts(
        reviews, key="status", statuses={"timeout", "timed_out"}
    )
    metrics["gap_completed_count"] = _state_metric_counts(
        gaps, key="gate_status", statuses={"reported", "triaged", "passed", "completed"}
    )
    metrics["stale_gap_count"] = _state_metric_counts(
        gaps, key="status", statuses={"stale", "stale_target", "stale_gap"}
    )
    metrics["aborted_gap_count"] = _state_metric_counts(
        gaps, key="status", statuses={"aborted", "aborted_gap"}
    )
    metrics["timeout_gap_count"] = _state_metric_counts(
        gaps, key="status", statuses={"timeout", "timed_out"}
    )

    review_durations: list[float] = []
    for record in (*reviews.values(), *gaps.values()):
        if not isinstance(record, Mapping):
            continue
        duration = _observed_duration_seconds(
            record.get("started_at"),
            record.get("completed_at")
            or record.get("harvested_at")
            or record.get("closed_at"),
        )
        if duration is not None:
            review_durations.append(duration)
    metrics["review_wait_time_seconds"] = round(sum(review_durations), 6)

    convergence = state.get("review_convergence")
    if isinstance(convergence, Mapping):
        recorded_round = convergence.get("recorded_round", convergence.get("fix_round", 0))
        if isinstance(recorded_round, int) and not isinstance(recorded_round, bool):
            metrics["review_fix_rounds"] = max(0, recorded_round)

    phase_started = state.get("phase_started_at") or state.get("created_at")
    phase_duration = _observed_duration_seconds(phase_started, state.get("updated_at"))
    if phase_duration is not None:
        metrics["phase_wall_time_seconds"] = phase_duration

    batch_records = _batch_performance_records(state)
    metrics["batch_metrics"] = batch_records
    metrics["batch_id"] = (
        str(batch_records[-1].get("batch_id") or "") if batch_records else ""
    )


def _empty_execution_metrics() -> dict[str, Any]:
    """Return the complete zero-valued state projection for a fresh loop."""

    return {
        "planned_task_count": 0,
        "remediation_task_count": 0,
        "task_origin_counts": {},
        "scope_revision_counts": {},
        "review_fix_rounds": 0,
        "candidate_count": 0,
        "confirmed_count": 0,
        "finding_origin_counts": {},
        "finding_contract_relation_counts": {},
        "finding_decision_requirement_counts": {},
        "finding_disposition_counts": {},
        "review_completed_count": 0,
        "stale_review_count": 0,
        "aborted_review_count": 0,
        "timeout_review_count": 0,
        "gap_completed_count": 0,
        "stale_gap_count": 0,
        "aborted_gap_count": 0,
        "timeout_gap_count": 0,
        "worker_count": 0,
        "planned_task_completed": False,
        "scope_expansion_started_at": "",
        "scope_expansion_user_input_id": "",
        "effective_parallelism": None,
        "phase_wall_time_seconds": 0.0,
        "validation_time_seconds": 0.0,
        "review_wait_time_seconds": 0.0,
        "longest_worker_seconds": 0.0,
        "worker_runtime_seconds": 0.0,
        "batch_id": "",
        "batch_metrics": [],
    }


def _manager_invocation_record() -> dict[str, str]:
    """Capture manager identity only when the invoking environment exposes it."""

    provider = str(os.environ.get("HLOOP_MANAGER_PROVIDER") or "").strip()
    model = str(os.environ.get("HLOOP_MANAGER_MODEL") or "").strip()
    effort = str(os.environ.get("HLOOP_MANAGER_REASONING_EFFORT") or "").strip()
    unavailable = "" if provider or model or effort else (
        "manager backend identity is not exposed by the hloop invocation"
    )
    return {
        "provider": provider,
        "model": model,
        "reasoning_effort": effort,
        "recorded_at": now_iso() if provider or model or effort else "",
        "unavailable_reason": unavailable,
    }


def _record_scope_expansion_metric(
    state: Mapping[str, Any], amendment: Mapping[str, Any] | None
) -> None:
    """Record explicit scope-change provenance when the command exposes it."""

    if not isinstance(amendment, Mapping) or str(amendment.get("kind") or "") != "scope-change":
        return
    metrics = state.get("execution_metrics")
    if not isinstance(metrics, dict):
        return
    metrics["scope_expansion_started_at"] = str(amendment.get("created_at") or "")
    metrics["scope_expansion_user_input_id"] = str(amendment.get("user_input_id") or "")


def journal(repo: Path, message: str) -> None:
    append_text(loop_path(repo) / "JOURNAL.md", f"\n## {now_iso()}\n\n{message}\n")


def parse_scalar(raw: str, key: str | None = None) -> Any:
    value = raw.strip()
    if value == "":
        return ""
    if key in STRUCTURED_JSON_FIELDS:
        try:
            decoded = json.loads(value)
        except json.JSONDecodeError as exc:
            raise HLoopError(f"{key} must be a JSON object or array: {exc}") from exc
        if not isinstance(decoded, (dict, list)):
            raise HLoopError(f"{key} must be a JSON object or array")
        return decoded
    if key in INTEGER_FRONTMATTER_FIELDS:
        if not re.fullmatch(r"[0-9]+", value):
            raise HLoopError(f"{key} must be a non-negative integer")
        return int(value)
    lower = value.lower()
    if lower == "true":
        return True
    if lower == "false":
        return False
    if value == "[]":
        return []
    if value.startswith("[") and value.endswith("]"):
        inner = value[1:-1].strip()
        if not inner:
            return []
        if key in STRICT_MULTILINE_LIST_FIELDS:
            raise HLoopError(f"{key}: inline list unsupported; use multiline list")
        return [parse_scalar(part.strip()) for part in inner.split(",")]
    if value.startswith('"') and value.endswith('"'):
        try:
            decoded = json.loads(value)
        except json.JSONDecodeError as exc:
            raise HLoopError(f"invalid JSON-quoted frontmatter scalar: {value}") from exc
        if not isinstance(decoded, str):
            raise HLoopError(f"quoted frontmatter scalar is not a string: {value}")
        return decoded
    if value.startswith("'") and value.endswith("'"):
        return value[1:-1]
    return value


def parse_frontmatter_text(text: str) -> dict[str, Any]:
    if not text.startswith("---\n"):
        return {}
    end = text.find("\n---", 4)
    if end == -1:
        return {}
    data: dict[str, Any] = {}
    current_key: str | None = None
    for line in text[4:end].splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        item = re.match(r"^\s*-\s+(.*)$", line)
        if item and current_key:
            data.setdefault(current_key, [])
            if not isinstance(data[current_key], list):
                data[current_key] = [data[current_key]]
            data[current_key].append(parse_scalar(item.group(1)))
            continue
        if ":" not in line:
            continue
        key, raw_value = line.split(":", 1)
        key = key.strip()
        raw_value = raw_value.strip()
        if raw_value == "":
            data[key] = []
            current_key = key
        else:
            data[key] = parse_scalar(raw_value, key=key)
            current_key = None
    return data


def read_frontmatter(path: Path) -> dict[str, Any]:
    return parse_frontmatter_text(read_text(path))


def replace_frontmatter(path: Path, updates: dict[str, Any]) -> None:
    text = read_text(path)
    if not text.startswith("---\n"):
        raise HLoopError(f"missing frontmatter: {path}")
    end = text.find("\n---", 4)
    if end == -1:
        raise HLoopError(f"unterminated frontmatter: {path}")
    meta = parse_frontmatter_text(text)
    meta.update(updates)
    rest = text[end + 4 :]
    if rest.startswith("\n"):
        rest = rest[1:]
    write_text(path, frontmatter(meta) + "\n" + rest)


def replace_frontmatter_record(path: Path, meta: Mapping[str, Any]) -> None:
    text = read_text(path)
    if not text.startswith("---\n"):
        raise HLoopError(f"missing frontmatter: {path}")
    end = text.find("\n---", 4)
    if end == -1:
        raise HLoopError(f"unterminated frontmatter: {path}")
    rest = text[end + 4 :]
    if rest.startswith("\n"):
        rest = rest[1:]
    write_text(path, frontmatter(dict(meta)) + "\n" + rest)


def yaml_scalar(value: Any, *, key: str | None = None) -> str:
    if key in STRUCTURED_JSON_FIELDS:
        if not isinstance(value, (dict, list)):
            raise HLoopError(f"{key} must be a JSON object or array")
        return json.dumps(value, ensure_ascii=False, separators=(",", ":"))
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    text = str(value)
    # A bare string equal to "true"/"false" (e.g. a validation command
    # literally named `false`) would otherwise round-trip as a Python `bool`
    # through `parse_scalar`'s case-insensitive boolean recognition -- quote
    # it like any other syntactically ambiguous scalar so readers get back
    # the exact string that was written.
    if (
        text == ""
        or text.lower() in {"true", "false"}
        or re.search(r"[:#\[\]{}]|^\s|\s$|[\x00-\x1f\x7f]", text)
    ):
        return json.dumps(text, ensure_ascii=False)
    return text


def frontmatter(fields: dict[str, Any]) -> str:
    lines = ["---"]
    for key, value in fields.items():
        if key in STRUCTURED_JSON_FIELDS:
            lines.append(f"{key}: {yaml_scalar(value, key=key)}")
        elif isinstance(value, list):
            if value:
                lines.append(f"{key}:")
                for item in value:
                    lines.append(f"  - {yaml_scalar(item)}")
            else:
                lines.append(f"{key}: []")
        else:
            lines.append(f"{key}: {yaml_scalar(value)}")
    lines.append("---")
    return "\n".join(lines) + "\n"


def parse_simple_field_block(lines: list[str]) -> dict[str, Any]:
    data: dict[str, Any] = {}
    current_key: str | None = None
    for line in lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        item = re.match(r"^\s*-\s+(.*)$", line)
        if item and current_key:
            data.setdefault(current_key, [])
            if not isinstance(data[current_key], list):
                data[current_key] = [data[current_key]]
            data[current_key].append(parse_scalar(item.group(1)))
            continue
        if ":" not in line:
            continue
        key, raw_value = line.split(":", 1)
        key = key.strip()
        raw_value = raw_value.strip()
        if raw_value == "":
            data[key] = []
            current_key = key
        else:
            data[key] = parse_scalar(raw_value, key=key)
            current_key = None
    return data


def reject_fix_task_candidate(title: str, reasons: list[str], raw: str = "") -> dict[str, Any]:
    return {
        "title": title or "untitled candidate",
        "reasons": reasons,
        "raw": raw,
    }


def validate_fix_task_candidate(candidate: dict[str, Any], data: dict[str, Any]) -> list[str]:
    reasons = []
    if not str(candidate.get("title") or "").strip():
        reasons.append("title is missing")
    if str(data.get("action") or "") not in {"fix_task", "fix-task"}:
        reasons.append("action must be fix_task")
    if str(candidate.get("kind") or "") not in {"fix", "implementation"}:
        reasons.append("kind must be fix or implementation")
    priority = str(candidate.get("priority") or "")
    if priority not in FIX_TASK_PRIORITIES:
        reasons.append("priority/severity must be one of P0, P1, P2, P3")
    if not normalize_list(candidate.get("write_allow")):
        reasons.append("write_allow is required")
    if not normalize_list(candidate.get("acceptance")):
        reasons.append("acceptance is required")
    if not str(candidate.get("rationale") or "").strip():
        reasons.append("rationale is required")
    return reasons


def extract_fix_task_candidates(text: str, source_id: str) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    lines = text.splitlines()
    in_section = False
    blocks: list[tuple[str, list[str]]] = []
    current_title: str | None = None
    current_lines: list[str] = []
    for line in lines:
        if re.match(r"^##\s+Fix Task Candidates\s*$", line, re.IGNORECASE):
            in_section = True
            continue
        if in_section and re.match(r"^##\s+", line):
            break
        if not in_section:
            continue
        heading = re.match(r"^###\s+(.*)$", line)
        if heading:
            if current_title is not None:
                blocks.append((current_title, current_lines))
            current_title = heading.group(1).strip()
            current_lines = []
            continue
        if current_title is not None:
            current_lines.append(line)
    if current_title is not None:
        blocks.append((current_title, current_lines))

    candidates: list[dict[str, Any]] = []
    rejected: list[dict[str, Any]] = []
    for title, block_lines in blocks:
        try:
            data = parse_simple_field_block(block_lines)
        except HLoopError as exc:
            rejected.append(reject_fix_task_candidate(title, [str(exc)], "\n".join(block_lines)))
            continue
        action = str(data.get("action") or "")
        clean_title = re.sub(r"^FT\d+\s*:\s*", "", title).strip()
        def clean_path_item(value: str) -> str:
            stripped = value.strip()
            code_span = re.match(r"^`([^`]+)`(?:\s+.*)?$", stripped)
            return code_span.group(1).strip() if code_span else stripped

        candidate = {
            "title": str(data.get("title") or clean_title),
            "kind": str(data.get("kind") or "fix"),
            "priority": str(data.get("priority") or data.get("severity") or ""),
            "source": str(data.get("source") or source_id),
            "source_finding": str(data.get("source_finding") or data.get("finding") or clean_title),
            "write_allow": [clean_path_item(item) for item in normalize_list(data.get("write_allow"))],
            "write_deny": [clean_path_item(item) for item in normalize_list(data.get("write_deny"))],
            "acceptance": normalize_list(data.get("acceptance")),
            "depends_on": normalize_list(data.get("depends_on")),
            "rationale": str(data.get("rationale") or data.get("reason") or ""),
            "task_origin": str(data.get("task_origin") or ""),
            "release_scope_revision": data.get("release_scope_revision"),
            "plan_item_refs": normalize_list(data.get("plan_item_refs") or data.get("plan_item_ref")),
            "requirement_refs": normalize_list(data.get("requirement_refs") or data.get("requirement_ref")),
            "scope_refs": normalize_list(data.get("scope_refs") or data.get("scope_ref")),
            "authorization_input_id": str(data.get("authorization_input_id") or data.get("user_input_id") or ""),
            "why_fix_now": str(data.get("why_fix_now") or ""),
            "origin": str(data.get("origin") or ""),
            "contract_relation": str(data.get("contract_relation") or ""),
            "decision_requirement": str(data.get("decision_requirement") or ""),
            "release_effect": str(data.get("release_effect") or ""),
            "remediation_round": data.get("remediation_round", 0),
            "fact_status": str(data.get("fact_status") or ""),
            "disposition": str(data.get("disposition") or ""),
        }
        reasons = validate_fix_task_candidate(candidate, {**data, "action": action})
        if reasons:
            rejected.append(reject_fix_task_candidate(candidate["title"], reasons, "\n".join(block_lines)))
            continue
        candidates.append(candidate)
    return candidates, rejected


def confirmed_review_fix_task_candidates(
    manifest: hloop_review.ReviewManifest,
    candidates: list[dict[str, Any]],
    rejected_candidates: list[dict[str, Any]],
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    confirmed = set(manifest.confirmed_fingerprints)
    accepted = []
    rejected = list(rejected_candidates)
    for candidate in candidates:
        source_finding = str(candidate.get("source_finding") or "")
        if source_finding not in confirmed:
            rejected.append(
                reject_fix_task_candidate(
                    candidate["title"],
                    [
                        "source_finding must identify a manifest finding whose required verification records are all confirmed"
                    ],
                )
            )
            continue
        accepted.append(candidate)
    return accepted, rejected


def fix_now_candidate_reasons(
    state: dict[str, Any], candidate: dict[str, Any]
) -> list[str]:
    """Require the review contract before a finding can create a fix task."""

    if not manual_final_review_required(state):
        return []
    reasons: list[str] = []
    if not re.fullmatch(r"sha256:[0-9a-f]{64}", str(candidate.get("source_finding") or "")):
        reasons.append("source_finding must be a manifest fingerprint")
    if str(candidate.get("fact_status") or "") != "confirmed":
        reasons.append("fact_status must be confirmed")
    if str(candidate.get("origin") or "") not in {"introduced", "diff-expanded-pre-existing"}:
        reasons.append("origin must be introduced or diff-expanded-pre-existing")
    if str(candidate.get("disposition") or "") != "fix_now":
        reasons.append("disposition must be fix_now")
    if str(candidate.get("contract_relation") or "") != "in_scope":
        reasons.append("contract_relation must be in_scope")
    if str(candidate.get("decision_requirement") or "") != "none":
        reasons.append("decision_requirement must be none")
    if not str(candidate.get("why_fix_now") or "").strip():
        reasons.append("why_fix_now is required")
    if not normalize_list(candidate.get("requirement_refs")) and not normalize_list(
        candidate.get("scope_refs")
    ):
        reasons.append("requirement_refs or scope_refs is required")
    effect = str(candidate.get("release_effect") or "")
    if effect not in {"blocking", "non_blocking"}:
        reasons.append("release_effect must be blocking or non_blocking")
    return reasons


def ensure_loop_dirs(repo: Path) -> None:
    for rel in [
        "tasks",
        "batches",
        "results",
        "reviews",
        "reviews/convergence",
        "reviews/final",
        "gaps",
        "advice",
        "prompts",
        "reports",
        "triage",
        "validation",
        "qa",
        "inbox/manager",
        "inbox/pending",
        "inbox/user",
        "release-scope/amendments",
        "follow-ups",
    ]:
        (loop_path(repo) / rel).mkdir(parents=True, exist_ok=True)


def dispatch_freeze_record(state: dict[str, Any]) -> dict[str, Any]:
    """Return the normalized dispatch-freeze record without creating policy state."""

    value = state.get("dispatch_freeze")
    if not isinstance(value, dict):
        return {
            "status": "inactive",
            "reason": "",
            "frozen_at": "",
            "source_input_id": "",
            "allowed_running_role_ids": [],
        }
    return value


def dispatch_is_frozen(state: dict[str, Any]) -> bool:
    return str(dispatch_freeze_record(state).get("status") or "inactive") == "active"


def review_failure_phase(state: Mapping[str, Any]) -> str:
    """Return a review stop phase that requires the atomic reopen command."""

    phase = str(state.get("phase") or "")
    if phase in hloop_certification.REOPENABLE_PHASES:
        return phase
    convergence = state.get("review_convergence")
    if isinstance(convergence, Mapping) and convergence.get("status") == "exhausted":
        return "review_convergence_exhausted"
    manual = state.get("manual_final_review")
    if isinstance(manual, Mapping):
        status = str(manual.get("status") or "")
        if status in {"failed", "incomplete"}:
            return f"manual_final_review_{status}"
    return ""


def release_scope_from_state(state: dict[str, Any]) -> hloop_release_scope.ReleaseScope:
    """Load scope policy, treating pre-0.5.2 state as explicitly legacy."""

    value = state.get("release_scope")
    if value is None:
        return hloop_release_scope.ReleaseScope(status="legacy-unlocked")
    if not isinstance(value, dict):
        raise HLoopError("STATE.json release_scope must be an object")
    try:
        return hloop_release_scope.ReleaseScope.from_record(value)
    except hloop_release_scope.ReleaseScopeError as exc:
        raise HLoopError(f"invalid release_scope state: {exc}") from exc


def release_scope_enabled(state: dict[str, Any]) -> bool:
    return "release_scope" in state


def safe_repo_path(repo: Path, raw: str, *, default_loop_path: bool = False) -> Path:
    value = str(raw or "").strip()
    if not value:
        raise HLoopError("source reference must be non-empty")
    candidate = Path(value)
    if not candidate.is_absolute():
        candidate = loop_path(repo) / candidate if default_loop_path else repo / candidate
    resolved = candidate.resolve()
    try:
        resolved.relative_to(repo.resolve())
    except ValueError as exc:
        raise HLoopError(f"path escapes repository: {raw}") from exc
    return resolved


def scope_source_path(repo: Path, reference: str) -> Path:
    """Resolve a scope reference against the loop first, then the repository."""

    value = str(reference or "").strip()
    if value.startswith(str(LOOP_DIR) + "/"):
        return safe_repo_path(repo, value)
    loop_candidate = safe_repo_path(repo, value, default_loop_path=True)
    if loop_candidate.exists():
        return loop_candidate
    return safe_repo_path(repo, value)


def read_scope_sources(repo: Path, references: Sequence[str]) -> dict[str, str]:
    sources: dict[str, str] = {}
    for reference in references:
        path = scope_source_path(repo, reference)
        if not path.is_file():
            raise HLoopError(f"release-scope source does not exist: {reference}")
        try:
            sources[str(reference)] = path.read_text(encoding="utf-8")
        except OSError as exc:
            raise HLoopError(f"cannot read release-scope source {reference}: {exc}") from exc
    return sources


def accepted_requirement_ids(state: Mapping[str, Any]) -> tuple[str, ...]:
    """Return only Manager-accepted requirement IDs from the immutable ledger."""

    raw_requirements = state.get("requirements")
    if not isinstance(raw_requirements, Mapping):
        return ()
    accepted: set[str] = set()
    for key, raw in raw_requirements.items():
        if not isinstance(raw, Mapping) or str(raw.get("status") or "") != "accepted":
            continue
        requirement_id = str(raw.get("id") or raw.get("requirement_id") or key).strip()
        if requirement_id:
            accepted.add(requirement_id)
    return tuple(sorted(accepted))


def finding_inventory_ids(
    state: Mapping[str, Any], *, confirmed_only: bool = False
) -> tuple[str, ...]:
    """Return canonical finding IDs persisted from review evidence.

    Task authorization uses only records confirmed by the review manifest.  The
    broader inventory remains available for audit and convergence accounting.
    """

    raw_inventory = state.get("finding_inventory")
    if not isinstance(raw_inventory, Mapping):
        return ()
    values: set[str] = set()
    if not confirmed_only:
        for key in ("fingerprints", "finding_ids", "ids"):
            values.update(
                str(item).strip()
                for item in normalize_list(raw_inventory.get(key))
                if str(item).strip()
            )
    records = raw_inventory.get("records")
    if isinstance(records, Mapping):
        for fingerprint, raw_record in records.items():
            if confirmed_only and (
                not isinstance(raw_record, Mapping)
                or raw_record.get("confirmed") is not True
            ):
                continue
            if str(fingerprint).strip():
                values.add(str(fingerprint).strip())
            if not isinstance(raw_record, Mapping):
                continue
            values.update(
                str(item).strip()
                for item in normalize_list(
                    raw_record.get("fingerprints") or raw_record.get("fingerprint")
                )
                if str(item).strip()
            )
            values.update(
                str(item).strip()
                for item in normalize_list(
                    raw_record.get("finding_ids") or raw_record.get("candidate_ids")
                )
                if str(item).strip()
            )
    return tuple(sorted(values))


def finding_inventory_records(
    state: Mapping[str, Any], *, confirmed_only: bool = False
) -> dict[str, dict[str, Any]]:
    """Return finding records keyed by fingerprint and persisted finding IDs."""

    raw_inventory = state.get("finding_inventory")
    if not isinstance(raw_inventory, Mapping):
        return {}
    raw_records = raw_inventory.get("records")
    if not isinstance(raw_records, Mapping):
        return {}
    records: dict[str, dict[str, Any]] = {}
    for fingerprint, raw_record in raw_records.items():
        if not isinstance(raw_record, Mapping):
            continue
        if confirmed_only and raw_record.get("confirmed") is not True:
            continue
        record = dict(raw_record)
        aliases = {
            str(fingerprint).strip(),
            str(record.get("fingerprint") or "").strip(),
            *(
                str(item).strip()
                for item in normalize_list(record.get("finding_ids"))
                if str(item).strip()
            ),
        }
        for alias in aliases:
            if alias:
                records[alias] = record
    return records


def persist_finding_inventory(
    state: dict[str, Any],
    manifest: hloop_review.ReviewManifest,
    *,
    source_ref: str = "",
) -> None:
    """Persist canonical IDs and fingerprints from one parsed review manifest."""

    inventory = state.setdefault(
        "finding_inventory",
        {"fingerprints": [], "finding_ids": [], "records": {}, "updated_at": ""},
    )
    if not isinstance(inventory, dict):
        raise HLoopError("STATE.json finding_inventory must be an object")
    records = inventory.setdefault("records", {})
    if not isinstance(records, dict):
        raise HLoopError("STATE.json finding_inventory.records must be an object")
    scope = release_scope_from_state(state)
    confirmed = set(manifest.confirmed_fingerprints)
    for finding in manifest.findings:
        fingerprint = str(finding.fingerprint).strip()
        if not fingerprint:
            continue
        candidate_ids = sorted(
            {
                str(candidate.finding_id).strip()
                for candidate in finding.candidates
                if str(candidate.finding_id).strip()
            }
            | {
                f"{candidate.provider}:{candidate.finding_id}"
                for candidate in finding.candidates
                if str(candidate.finding_id).strip()
            }
        )
        previous = records.get(fingerprint)
        if not isinstance(previous, Mapping):
            previous = {}
        source_refs = sorted(
            set(normalize_list(previous.get("source_refs")))
            | ({source_ref} if source_ref else set())
        )
        records[fingerprint] = {
            "fingerprint": fingerprint,
            "finding_ids": sorted(
                set(normalize_list(previous.get("finding_ids"))) | set(candidate_ids)
            ),
            "target_sha": str(finding.head_sha),
            "head_sha": str(finding.head_sha),
            "scope_revision": scope.scope_revision,
            "source_refs": source_refs,
            "confirmed": fingerprint in confirmed,
            "policy_axes_explicit": bool(finding.policy_axes_explicit),
            "policy_axes": {
                "fact_status": str(finding.fact_status or ""),
                "severity": str(finding.severity or ""),
                "origin": str(finding.origin or ""),
                "contract_relation": str(finding.contract_relation or ""),
                "decision_requirement": str(finding.decision_requirement or ""),
                "disposition": str(finding.disposition or ""),
                "release_effect": str(finding.release_effect or ""),
            },
            "fact_status": str(finding.fact_status or ""),
            "severity": str(finding.severity or ""),
            "origin": str(finding.origin or ""),
            "contract_relation": str(finding.contract_relation or ""),
            "decision_requirement": str(finding.decision_requirement or ""),
            "disposition": str(finding.disposition or ""),
            "release_effect": str(finding.release_effect or ""),
            "requirement_refs": list(finding.requirement_refs),
            "scope_refs": list(scope.release_scope_refs),
            "why_fix_now": str(finding.why_fix_now or ""),
        }
    inventory["records"] = records
    inventory["fingerprints"] = sorted(str(item) for item in records)
    inventory["finding_ids"] = sorted(
        {
            str(item)
            for record in records.values()
            if isinstance(record, Mapping)
            for item in normalize_list(record.get("finding_ids"))
            if str(item).strip()
        }
    )
    inventory["updated_at"] = now_iso()


def assert_release_scope_snapshot(
    repo: Path, state: dict[str, Any]
) -> hloop_release_scope.ReleaseScope:
    scope = release_scope_from_state(state)
    if scope.status == "locked":
        try:
            scope.assert_source_snapshot(read_scope_sources(repo, scope.source_refs))
        except hloop_release_scope.ReleaseScopeError as exc:
            raise HLoopError(str(exc)) from exc
    return scope


def _arg_list(args: argparse.Namespace, *names: str) -> list[str]:
    for name in names:
        value = getattr(args, name, None)
        if value:
            return [str(item) for item in normalize_list(value)]
    return []


def provenance_record_from_args(
    args: argparse.Namespace | None,
    state: dict[str, Any],
    *,
    candidate: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """Build one flat provenance record for every task-creation entry point."""

    candidate = candidate or {}
    get = lambda name, default=None: getattr(args, name, None) if args is not None else default

    source_finding = str(get("source_finding") or candidate.get("source_finding") or "")
    scope = release_scope_from_state(state)
    requested_origin = get("task_origin") or candidate.get("task_origin")
    if requested_origin:
        task_origin = str(requested_origin)
    elif source_finding:
        task_origin = "finding"
    elif scope.status == "locked":
        task_origin = "planned"
    else:
        task_origin = "legacy-unclassified"
    scope_refs = _arg_list(args, "scope_ref", "release_scope_ref") or normalize_list(
        candidate.get("scope_refs") or candidate.get("release_scope_refs")
    )
    revision_value = get("release_scope_revision")
    if revision_value is None:
        revision_value = candidate.get("release_scope_revision")
    if revision_value is None:
        revision_value = scope.scope_revision if release_scope_enabled(state) else 0
    if isinstance(revision_value, str) and re.fullmatch(r"[0-9]+", revision_value):
        revision_value = int(revision_value)
    remediation_value = get("remediation_round")
    if remediation_value is None:
        remediation_value = candidate.get("remediation_round", 0)
    if isinstance(remediation_value, str) and re.fullmatch(r"[0-9]+", remediation_value):
        remediation_value = int(remediation_value)
    record: dict[str, Any] = {
        "task_origin": task_origin,
        "release_scope_revision": revision_value,
        "plan_item_refs": _arg_list(args, "plan_item_ref") or normalize_list(
            candidate.get("plan_item_refs")
        ),
        "requirement_refs": _arg_list(args, "requirement_ref") or normalize_list(
            candidate.get("requirement_refs")
        ),
        "scope_refs": scope_refs,
        "source_finding": source_finding,
        "authorization_input_id": str(
            get("authorization_input_id")
            or get("user_input_id")
            or candidate.get("authorization_input_id")
            or ""
        ),
        "why_fix_now": str(get("why_fix_now") or candidate.get("why_fix_now") or ""),
        "operational_reason": str(
            get("operational_reason") or candidate.get("operational_reason") or ""
        ),
        "origin": str(get("origin") or candidate.get("origin") or ""),
        "contract_relation": str(
            get("contract_relation") or candidate.get("contract_relation") or ""
        ),
        "release_effect": str(
            get("release_effect") or candidate.get("release_effect") or ""
        ),
        "remediation_round": remediation_value,
        "fact_status": str(get("fact_status") or candidate.get("fact_status") or ""),
        "disposition": str(get("disposition") or candidate.get("disposition") or ""),
    }
    if task_origin == "user-amendment" and scope.amendment_refs:
        # Preserve the supported CLI path while making the authorization
        # provenance explicit in the task artifact.  The shared validator
        # still rejects editorial/clarification-only revisions because their
        # authorization input is empty after amendment application.
        scope_refs = list(dict.fromkeys([*scope_refs, scope.amendment_refs[-1]]))
        record["scope_refs"] = scope_refs
    scope_expanding = bool(get("scope_expanding") or candidate.get("scope_expanding", False))
    if scope_expanding:
        record["scope_expanding"] = True
    record["severity"] = str(
        get("severity")
        or get("priority")
        or candidate.get("severity")
        or candidate.get("priority")
        or ""
    )
    record["decision_requirement"] = str(
        get("decision_requirement")
        or candidate.get("decision_requirement")
        or ("none" if source_finding else "")
    )
    # Operational authorization is evaluated against the complete task
    # record, not only the immutable provenance projection.  Preserve the
    # path-bearing fields on this validation-only record so the shared
    # fail-closed validator can reject product/release writes before the task
    # artifact is persisted.
    for field_name in (
        "write_allow",
        "write_deny",
        "changed_files",
        "product_paths",
        "release_artifact_paths",
    ):
        supplied = getattr(args, field_name, None) if args is not None else None
        if supplied is not None:
            record[field_name] = normalize_list(supplied)
        elif field_name in candidate:
            record[field_name] = normalize_list(candidate.get(field_name))
    return record


def authorize_task_record(
    repo: Path,
    state: dict[str, Any],
    record: dict[str, Any],
    *,
    existing_task: dict[str, Any] | None = None,
) -> hloop_release_scope.TaskProvenance:
    scope = assert_release_scope_snapshot(repo, state)
    inventory_records = finding_inventory_records(state)
    try:
        return hloop_release_scope.authorize_task_creation(
            record,
            scope,
            existing_task=existing_task,
            locked_plan_item_refs=scope.plan_item_refs,
            locked_requirement_refs=scope.requirement_refs,
            locked_finding_ids=finding_inventory_ids(state, confirmed_only=True),
            finding_records=inventory_records or None,
            current_target_sha=current_integration_target(repo, state),
            captured_input_ids=state.get("inputs_index"),
            legacy_mode=scope.status == "legacy-unlocked",
            allow_legacy_unclassified=scope.status == "legacy-unlocked",
        )
    except hloop_release_scope.ReleaseScopeError as exc:
        raise HLoopError(f"task authorization failed: {exc}") from exc


def task_provenance_record(meta: dict[str, Any]) -> dict[str, Any] | None:
    if not meta.get("task_origin"):
        return None
    record = {
        key: meta.get(key, [] if key.endswith("_refs") else "")
        for key in (
            "task_origin",
            "release_scope_revision",
            "plan_item_refs",
            "requirement_refs",
            "scope_refs",
            "source_finding",
            "authorization_input_id",
            "why_fix_now",
            "operational_reason",
            "origin",
            "contract_relation",
            "release_effect",
            "remediation_round",
            "fact_status",
            "disposition",
            "severity",
            "decision_requirement",
        )
        if key in meta
    }
    for key in ("release_scope_revision", "remediation_round"):
        value = record.get(key)
        if isinstance(value, str) and re.fullmatch(r"[0-9]+", value):
            record[key] = int(value)
    if "severity" not in record and meta.get("priority"):
        record["severity"] = str(meta.get("priority"))
    # Dispatch and update preflights must authorize operational tasks with
    # their current write scope.  These fields remain validation-only; the
    # normalized TaskProvenance artifact is unchanged.
    for field_name in (
        "write_allow",
        "write_deny",
        "changed_files",
        "product_paths",
        "release_artifact_paths",
    ):
        if field_name in meta:
            record[field_name] = normalize_list(meta.get(field_name))
    return record | ({"scope_expanding": True} if meta.get("scope_expanding") else {})


def validate_task_update_provenance(
    repo: Path,
    state: dict[str, Any],
    current_meta: dict[str, Any],
    updates: dict[str, Any],
) -> None:
    old_record = task_provenance_record(current_meta)
    if old_record is None and not release_scope_enabled(state):
        return
    if old_record is None:
        raise HLoopError("new-policy task is missing immutable provenance")
    next_meta = dict(current_meta)
    next_meta.update(updates)
    if bool(current_meta.get("scope_expanding")) != bool(next_meta.get("scope_expanding")):
        raise HLoopError("task provenance update rejected: scope_expanding is immutable")
    scope = assert_release_scope_snapshot(repo, state)
    inventory_records = finding_inventory_records(state)
    try:
        hloop_release_scope.validate_provenance_update(
            old_record,
            task_provenance_record(next_meta) or {},
            scope,
            locked_plan_item_refs=scope.plan_item_refs,
            locked_requirement_refs=scope.requirement_refs,
            locked_finding_ids=finding_inventory_ids(state, confirmed_only=True),
            finding_records=inventory_records or None,
            current_target_sha=current_integration_target(repo, state),
            captured_input_ids=state.get("inputs_index"),
            legacy_mode=scope.status == "legacy-unlocked",
            allow_legacy_unclassified=scope.status == "legacy-unlocked",
        )
    except hloop_release_scope.ReleaseScopeError as exc:
        raise HLoopError(f"task provenance update rejected: {exc}") from exc
    # Provenance mutation checks intentionally normalize away task metadata.
    # Re-run the shared authorization against the complete updated record so
    # operational updates cannot introduce product or release writes through
    # write_allow (or its equivalent path-bearing fields).
    authorize_task_record(repo, state, task_provenance_record(next_meta) or {})


def _sha256_labelled(payload: bytes) -> str:
    return "sha256:" + hashlib.sha256(payload).hexdigest()


def _labelled_contract_digest(value: Any) -> str:
    text = str(value or "").strip()
    if re.fullmatch(r"[0-9a-f]{64}", text):
        return f"sha256:{text}"
    if re.fullmatch(r"sha256:[0-9a-f]{64}", text):
        return text
    raise HLoopError("task contract digest must be an exact SHA-256 digest")


def v053_state_contracts_enabled(state: dict[str, Any]) -> bool:
    revision = state.get("schema_revision")
    return isinstance(revision, int) and not isinstance(revision, bool) and revision >= 3


def task_contract_revision(meta: Mapping[str, Any]) -> int | None:
    value = meta.get("contract_schema_revision")
    if isinstance(value, int) and not isinstance(value, bool):
        return value
    return None


def validate_revision_three_task(meta: Mapping[str, Any], *, task_id: str) -> None:
    record = dict(meta)
    for field in ("release_scope_revision", "remediation_round"):
        value = record.get(field)
        if isinstance(value, str) and re.fullmatch(r"[0-9]+", value):
            record[field] = int(value)
    validation = hloop_task_contract.validate_task_contract(record)
    if not validation.ok:
        detail = "; ".join(issue.message for issue in validation.issues)
        raise HLoopError(f"invalid revision 3 task contract for {task_id}: {detail}")


def current_planning_identity(
    repo: Path, state: dict[str, Any]
) -> hloop_planning.PlanningIdentity:
    scope = assert_release_scope_snapshot(repo, state)
    if scope.status != "locked":
        raise HLoopError(
            "planning identity requires an authoritative locked release scope"
        )
    scope_record = scope.to_record()
    release_scope_digest = str(scope_record.get("scope_digest") or "")
    if not release_scope_digest:
        raise HLoopError("locked release scope is missing scope_digest")
    task_contracts: dict[str, str] = {}
    for task_id in sorted((state.get("tasks") or {}).keys()):
        path = task_file(repo, task_id)
        if not path.is_file():
            raise HLoopError(f"planning identity task artifact is missing: {path}")
        task_contracts[task_id] = _sha256_labelled(path.read_bytes())
    source_digest = hloop_planning.canonical_digest(
        {
            "source_digests": scope_record.get("source_digests") or {},
            "requirements": state.get("requirements") or {},
            "task_contracts": task_contracts,
        }
    )
    source_revision = int(scope_record.get("source_snapshot_revision") or 0)
    scope_revision = int(scope_record.get("scope_revision") or 0)
    if source_revision < 1 or scope_revision < 1:
        raise HLoopError("locked release scope has an invalid planning revision")
    requirements_revision = state.get("requirements_revision")
    if (
        isinstance(requirements_revision, bool)
        or not isinstance(requirements_revision, int)
        or requirements_revision < 1
    ):
        requirements_revision = max(1, len(state.get("requirements") or {}))
    return hloop_planning.PlanningIdentity(
        run_id=str(state.get("run_id") or ""),
        plan_revision=source_revision,
        requirements_revision=requirements_revision,
        release_scope_revision=scope_revision,
        release_scope_digest=release_scope_digest,
        source_revision=source_revision,
        source_digest=source_digest,
    )


def load_json_object(path: Path, *, label: str) -> dict[str, Any]:
    if not path.is_file():
        raise HLoopError(f"{label} is missing: {path}")
    try:
        value = json.loads(read_text(path))
    except json.JSONDecodeError as exc:
        raise HLoopError(f"{label} is not valid JSON: {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise HLoopError(f"{label} must be a JSON object: {path}")
    return value


def load_planning_bundle(repo: Path) -> tuple[dict[str, Any], ...]:
    records = []
    for record_type in (
        hloop_planning.IMPACT_RECORD_TYPE,
        hloop_planning.TASK_GRAPH_RECORD_TYPE,
        hloop_planning.COVERAGE_RECORD_TYPE,
        hloop_planning.PLAN_GAP_RECORD_TYPE,
    ):
        records.append(
            load_json_object(
                planning_artifact_file(repo, record_type),
                label=record_type,
            )
        )
    return tuple(records)


def planning_projection_issues(
    state: dict[str, Any], task_graph: Mapping[str, Any]
) -> list[hloop_planning.PlanningIssue]:
    graph_tasks = {
        str(item.get("task_id") or ""): item
        for item in task_graph.get("tasks", [])
        if isinstance(item, Mapping) and str(item.get("task_id") or "")
    }
    state_task_ids = set((state.get("tasks") or {}).keys())
    graph_task_ids = set(graph_tasks)
    issues: list[hloop_planning.PlanningIssue] = []
    missing = tuple(sorted(state_task_ids - graph_task_ids))
    unknown = tuple(sorted(graph_task_ids - state_task_ids))
    if missing:
        issues.append(
            hloop_planning.PlanningIssue(
                "task-projection-missing",
                "Task Risk Graph omits current tasks: " + ", ".join(missing),
                "tasks",
                missing,
            )
        )
    if unknown:
        issues.append(
            hloop_planning.PlanningIssue(
                "task-projection-unknown",
                "Task Risk Graph references unknown tasks: " + ", ".join(unknown),
                "tasks",
                unknown,
            )
        )
    for task_id in sorted(state_task_ids & graph_task_ids):
        projected = (state.get("tasks") or {}).get(task_id) or {}
        graph_task = graph_tasks[task_id]
        for field in ("depends_on", "write_allow", "scope_refs"):
            if set(normalize_list(projected.get(field))) != set(
                normalize_list(graph_task.get(field))
            ):
                issues.append(
                    hloop_planning.PlanningIssue(
                        "task-projection-mismatch",
                        f"Task Risk Graph {field} does not match {task_id}",
                        field,
                        (task_id,),
                    )
                )
    return issues


def planning_dispatch_validation(
    repo: Path, state: dict[str, Any], *, honor_recorded_status: bool = True
) -> hloop_planning.PlanningValidation:
    issues: list[hloop_planning.PlanningIssue] = []
    projection = state.get("planning")
    if honor_recorded_status and (
        not isinstance(projection, dict) or projection.get("status") != "ready"
    ):
        issues.append(
            hloop_planning.PlanningIssue(
                "planning-not-recorded",
                "planning evidence has not been checked for the current state",
                "planning.status",
            )
        )
    try:
        current = current_planning_identity(repo, state)
        impact, task_graph, coverage, plan_gap = load_planning_bundle(repo)
        scope = assert_release_scope_snapshot(repo, state)
        allowed_scope_refs = tuple(scope.release_scope_refs)
        if honor_recorded_status and isinstance(projection, dict):
            expected_digests = {
                "impact": impact.get("artifact_digest"),
                "task_graph": task_graph.get("artifact_digest"),
                "coverage": coverage.get("artifact_digest"),
                "plan_gap": plan_gap.get("artifact_digest"),
            }
            if projection.get("identity") != current.to_dict():
                issues.append(
                    hloop_planning.PlanningIssue(
                        "planning-record-stale",
                        "recorded planning identity does not match the current identity",
                        "planning.identity",
                    )
                )
            if projection.get("artifact_digests") != expected_digests:
                issues.append(
                    hloop_planning.PlanningIssue(
                        "planning-record-stale",
                        "recorded planning artifact digests do not match current bytes",
                        "planning.artifact_digests",
                    )
                )
            if set(normalize_list(projection.get("allowed_scope_refs"))) != set(
                allowed_scope_refs
            ):
                issues.append(
                    hloop_planning.PlanningIssue(
                        "planning-record-stale",
                        "recorded authoritative scope refs do not match the locked scope",
                        "planning.allowed_scope_refs",
                    )
                )
        if not allowed_scope_refs:
            issues.append(
                hloop_planning.PlanningIssue(
                    "authoritative-scope-required",
                    "locked release scope has no authoritative release_scope_refs",
                    "release_scope.release_scope_refs",
                )
            )
        validation = hloop_planning.validate_dispatch_readiness(
            impact,
            task_graph,
            coverage,
            plan_gap,
            current,
            required_requirement_refs=scope.requirement_refs,
            required_plan_item_refs=scope.plan_item_refs,
            allowed_scope_refs=allowed_scope_refs,
        )
        issues.extend(validation.issues)
        issues.extend(planning_projection_issues(state, task_graph))
    except (HLoopError, hloop_planning.PlanningContractError) as exc:
        issues.append(
            hloop_planning.PlanningIssue(
                "planning-evidence-unavailable",
                str(exc),
                "planning",
            )
        )
    return hloop_planning.PlanningValidation(tuple(issues))


def assert_planning_dispatch_ready(repo: Path, state: dict[str, Any]) -> None:
    validation = planning_dispatch_validation(repo, state)
    if validation.ok:
        return
    detail = "; ".join(
        f"{issue.code}: {issue.message}" for issue in validation.issues
    )
    raise HLoopError(f"planning dispatch gate blocked: {detail}")


def invalidate_planning_evidence(state: dict[str, Any], *, reason: str) -> None:
    planning = state.get("planning")
    if not isinstance(planning, dict):
        state["planning"] = {"status": "stale", "stale_reason": reason}
        return
    planning.update(
        {
            "status": "stale",
            "stale_reason": reason,
            "stale_at": now_iso(),
        }
    )


def runtime_worker_task_preflight(
    repo: Path,
    state: dict[str, Any],
    *,
    task_id: str,
    task_meta: Mapping[str, Any],
) -> None:
    revision = task_contract_revision(task_meta)
    if revision == hloop_task_contract.V053_CONTRACT_SCHEMA_REVISION:
        validate_revision_three_task(task_meta, task_id=task_id)
        assert_planning_dispatch_ready(repo, state)
        return
    if not v053_state_contracts_enabled(state):
        return
    legacy_record = dict(task_meta)
    task_state = (state.get("tasks") or {}).get(task_id) or {}
    legacy_record["status"] = str(task_state.get("status") or task_meta.get("status") or "")
    try:
        migration = hloop_task_contract.migrate_legacy_task_contract(legacy_record)
    except hloop_task_contract.ContractValidationError as exc:
        raise HLoopError(f"invalid legacy task contract for {task_id}: {exc}") from exc
    if migration.action == "reclassify-to-revision-3":
        raise HLoopError(
            f"legacy queued task {task_id} is blocked by "
            f"{migration.migration_blocker}; use `hloop task update` to record "
            "revision 3 risk, invariant, regression, gate, and effort fields"
        )
    if migration.requires_requeue_before_start:
        raise HLoopError(f"legacy task {task_id} must be requeued before a new attempt")
    if not migration.may_start_new_attempt:
        raise HLoopError(
            f"legacy task {task_id} cannot start a new attempt from status "
            f"{migration.status}; migration action={migration.action}"
        )


def dispatch_start_preflight(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    role_kind: str,
    task_meta: dict[str, Any] | None = None,
) -> None:
    if dispatch_is_frozen(state):
        freeze = dispatch_freeze_record(state)
        reason = str(freeze.get("reason") or "Manager dispatch freeze")
        raise HLoopError(
            f"dispatch is frozen; cannot start {role_kind} {role_id}: {reason}"
        )
    scope = assert_release_scope_snapshot(repo, state)
    if release_scope_enabled(state) and scope.status not in {"locked", "legacy-unlocked"}:
        raise HLoopError(
            f"{role_kind} dispatch requires a locked release scope; current status={scope.status}"
        )
    if role_kind == "worker":
        if task_meta is None:
            raise HLoopError(f"worker task metadata is unavailable: {role_id}")
        runtime_worker_task_preflight(
            repo,
            state,
            task_id=role_id,
            task_meta=task_meta,
        )
        record = task_provenance_record(task_meta)
        if record is None:
            if scope.status != "legacy-unlocked":
                raise HLoopError(f"task {role_id} is missing immutable provenance")
        else:
            authorize_task_record(repo, state, record)
        conflicts = active_write_scope_conflicts(state, role_id)
        if conflicts:
            raise HLoopError(
                f"write-scope conflict prevents concurrent start of {role_id}: "
                + ", ".join(conflicts)
            )
        persist_write_scope_conflict_graph(state)


def assert_task_creation_dispatchable(state: dict[str, Any]) -> None:
    if dispatch_is_frozen(state):
        freeze = dispatch_freeze_record(state)
        raise HLoopError(
            "dispatch is frozen; cannot create a task: "
            + str(freeze.get("reason") or "Manager dispatch freeze")
        )


def planning_status_payload(
    repo: Path, state: dict[str, Any], *, honor_recorded_status: bool
) -> dict[str, Any]:
    validation = planning_dispatch_validation(
        repo, state, honor_recorded_status=honor_recorded_status
    )
    identity: dict[str, Any] | None = None
    allowed_scope_refs: list[str] = []
    try:
        identity = current_planning_identity(repo, state).to_dict()
        allowed_scope_refs = list(
            assert_release_scope_snapshot(repo, state).release_scope_refs
        )
    except HLoopError:
        pass
    return {
        "ready": validation.ok,
        "recorded_status": (
            (state.get("planning") or {}).get("status")
            if isinstance(state.get("planning"), dict)
            else "missing"
        ),
        "identity": identity,
        "allowed_scope_refs": allowed_scope_refs,
        "issues": [
            {
                "code": issue.code,
                "message": issue.message,
                "field": issue.field,
                "refs": list(issue.refs),
            }
            for issue in validation.issues
        ],
    }


def cmd_planning_identity(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    payload = current_planning_identity(repo, state).to_dict()
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


def cmd_planning_check(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    payload = planning_status_payload(repo, state, honor_recorded_status=False)
    if not payload["ready"]:
        if getattr(args, "json", False):
            print(json.dumps(payload, ensure_ascii=False, indent=2))
        detail = "; ".join(
            f"{item['code']}: {item['message']}" for item in payload["issues"]
        )
        raise HLoopError(f"planning evidence is not dispatch-ready: {detail}")
    impact, task_graph, coverage, plan_gap = load_planning_bundle(repo)
    state["planning"] = {
        "status": "ready",
        "identity": payload["identity"],
        "artifact_digests": {
            "impact": impact["artifact_digest"],
            "task_graph": task_graph["artifact_digest"],
            "coverage": coverage["artifact_digest"],
            "plan_gap": plan_gap["artifact_digest"],
        },
        "allowed_scope_refs": payload["allowed_scope_refs"],
        "checked_at": now_iso(),
    }
    save_state(repo, state)
    journal(repo, "Recorded clean, current planning evidence for Worker dispatch.")
    payload["recorded_status"] = "ready"
    if getattr(args, "json", False):
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print("planning evidence is dispatch-ready")
    return 0


def cmd_planning_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    payload = planning_status_payload(repo, state, honor_recorded_status=True)
    if getattr(args, "json", False):
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(
            "planning ready="
            f"{str(payload['ready']).lower()} status={payload['recorded_status']}"
        )
        for issue in payload["issues"]:
            print(f"- {issue['code']}: {issue['message']}")
    return 0 if payload["ready"] else 1


def role_ids_running(state: dict[str, Any]) -> list[str]:
    running: list[str] = []
    for group_name in (
        "tasks",
        "reviews",
        "patch_reviews",
        "gaps",
        "advice",
        "decision_liaisons",
    ):
        group = state.get(group_name)
        if not isinstance(group, dict):
            continue
        for role_id, value in group.items():
            if not isinstance(value, dict):
                continue
            status = str(value.get("status") or value.get("gate_status") or "")
            if status in {"running", "starting", "awaiting_result"}:
                running.append(str(role_id))
            if group_name == "advice":
                for participant in value.get("participants", []):
                    if not isinstance(participant, dict):
                        continue
                    participant_status = str(
                        participant.get("status") or participant.get("gate_status") or ""
                    )
                    if participant_status in {"running", "starting", "awaiting_result"}:
                        running.append(
                            f"{role_id}/{participant.get('participant_id') or 'P1'}"
                        )
    scout = state.get("specification_scout_run")
    if isinstance(scout, dict) and str(scout.get("status") or "") in {"running", "starting"}:
        running.append("S001")
    return sorted(dict.fromkeys(running))


def archive_existing_loop(repo: Path) -> Path | None:
    source = loop_path(repo)
    if not source.exists():
        return None
    archive_root = repo / LOOP_ARCHIVE_ROOT / LOOP_NAMESPACE
    archive_root.mkdir(parents=True, exist_ok=True)
    old_goal = "loop"
    old_state = source / "STATE.json"
    if old_state.exists():
        try:
            old_goal = slugify(str(json.loads(read_text(old_state)).get("goal_id") or old_goal), 24)
        except (HLoopError, json.JSONDecodeError):
            pass
    destination = archive_root / f"{filename_timestamp()}-{old_goal}"
    shutil.move(str(source), str(destination))
    return destination


def resolve_worktree_root(repo: Path, raw: str | None) -> Path | None:
    value = str(raw or "").strip()
    if not value:
        return None
    path = Path(value).expanduser()
    return path.resolve() if path.is_absolute() else (repo / path).resolve()


def configured_worktree_path(
    repo: Path,
    state: dict[str, Any] | None,
    name: str,
    legacy_name: str,
) -> Path:
    root = resolve_worktree_root(repo, str((state or {}).get("worktree_root") or ""))
    if root is None:
        return repo.parent / legacy_name
    return root / name


def slugify(text: str, max_len: int = 48) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    slug = re.sub(r"-+", "-", slug)
    return (slug or "task")[:max_len].strip("-") or "task"


def next_id(prefix: str, existing: dict[str, Any]) -> str:
    nums = []
    for key in existing:
        if re.fullmatch(rf"{prefix}\d{{3}}", key):
            nums.append(int(key[1:]))
    return f"{prefix}{(max(nums) if nums else 0) + 1:03d}"


def current_branch(repo: Path) -> str:
    return git(repo, ["branch", "--show-current"])


def branch_exists(repo: Path, branch: str) -> bool:
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "rev-parse", "--verify", "--quiet", branch], check=False)
    return proc.returncode == 0


def is_ancestor(repo: Path, ancestor: str, descendant: str) -> bool:
    if not ancestor or not descendant:
        return False
    proc = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "merge-base", "--is-ancestor", ancestor, descendant],
        check=False,
    )
    return proc.returncode == 0


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def json_from_cmd(cmd: list[str], cwd: Path | None = None) -> dict[str, Any]:
    proc = run_cmd(cmd, cwd=cwd, check=False)
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise HLoopError(f"expected JSON from {' '.join(cmd)}: {exc}") from exc


def find_key(value: Any, key: str) -> Any | None:
    if isinstance(value, dict):
        if key in value:
            return value[key]
        for child in value.values():
            found = find_key(child, key)
            if found is not None:
                return found
    elif isinstance(value, list):
        for child in value:
            found = find_key(child, key)
            if found is not None:
                return found
    return None


def extract_pane_id(payload: dict[str, Any]) -> str:
    found = find_key(payload, "pane_id")
    if found:
        return str(found)
    result = payload.get("result", {})
    candidates = [
        result.get("pane", {}),
        result.get("root_pane", {}),
        payload.get("pane", {}),
    ]
    for candidate in candidates:
        pane_id = candidate.get("pane_id") if isinstance(candidate, dict) else None
        if pane_id:
            return str(pane_id)
    raise HLoopError(f"could not find pane_id in Herdr response: {payload}")


def pane_info(pane_id: str) -> dict[str, Any] | None:
    proc = run_cmd(["herdr", "pane", "get", pane_id], check=False)
    if proc.returncode != 0:
        return None
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    pane = payload.get("result", {}).get("pane")
    return pane if isinstance(pane, dict) else None


def pane_text(pane_id: str, lines: int = 160) -> str:
    proc = run_cmd(
        [
            "herdr",
            "pane",
            "read",
            pane_id,
            "--source",
            "recent-unwrapped",
            "--lines",
            str(lines),
        ],
        check=False,
    )
    if proc.returncode != 0:
        return ""
    return proc.stdout or ""


def codex_tui_blocker(pane: dict[str, Any] | None, text: str) -> str | None:
    if pane is None:
        return "pane is missing or closed"
    if pane.get("agent") != "codex":
        return "pane is not a Codex TUI"
    if "Do you trust the contents of this directory?" in text or "Press enter to continue" in text:
        return "Codex trust prompt is pending"
    status = str(pane.get("agent_status") or "unknown")
    if status == "working" or "esc to interrupt" in text or "• Working" in text:
        return "Codex is still working"
    if status in {"blocked", "unknown"}:
        return f"Codex is not ready: agent_status={status}"
    return None


def agent_tui_blocker(provider: str, pane: dict[str, Any] | None, text: str) -> str | None:
    provider = normalize_agent_provider(provider)
    if provider == "codex":
        return codex_tui_blocker(pane, text)
    if pane is None:
        return "pane is missing or closed"
    pane_agent = str(pane.get("agent") or "")
    if pane_agent and pane_agent not in {provider, "shell"}:
        return f"pane is not a {provider} TUI"
    trust_markers = (
        "Do you trust the contents of this directory?",
        "Do you trust the files in this folder?",
        "Press enter to continue",
    )
    if any(marker in text for marker in trust_markers):
        return f"{provider} trust prompt is pending"
    status = str(pane.get("agent_status") or "unknown")
    working_markers = ("esc to interrupt", "• Working", "Working…", "Working...")
    if status == "working" or any(marker in text for marker in working_markers):
        return f"{provider} is still working"
    if status in {"blocked", "unknown"}:
        return f"{provider} is not ready: agent_status={status}"
    return None


def message_anchors(message: str) -> list[str]:
    anchors: list[str] = []
    for line in message.splitlines():
        stripped = line.strip()
        if stripped:
            anchors.append(stripped[:160])
    if not anchors and message.strip():
        anchors.append(message.strip()[:160])
    if len(anchors) > 1:
        return [anchors[0], anchors[-1]]
    return anchors


def message_visible_in_text(message: str, text: str) -> bool:
    anchors = message_anchors(message)
    return bool(anchors) and all(anchor in text for anchor in anchors)


def codex_output_after_message(message: str, text: str) -> bool:
    anchors = message_anchors(message)
    if not anchors:
        return False
    index = text.rfind(anchors[-1])
    if index < 0:
        return False
    after = text[index + len(anchors[-1]) :]
    return "\n• " in after


def agent_output_after_message(provider: str, message: str, text: str) -> bool:
    provider = normalize_agent_provider(provider)
    if provider == "codex":
        return codex_output_after_message(message, text)
    anchors = message_anchors(message)
    if not anchors:
        return False
    index = text.rfind(anchors[-1])
    if index < 0:
        return False
    after = text[index + len(anchors[-1]) :]
    return bool(after.strip())


def wait_codex_tui_ready(pane_id: str, timeout_ms: int) -> tuple[dict[str, Any], str]:
    return wait_agent_tui_ready("codex", pane_id, timeout_ms)


def wait_agent_tui_ready(provider: str, pane_id: str, timeout_ms: int) -> tuple[dict[str, Any], str]:
    provider = normalize_agent_provider(provider)
    deadline = time.monotonic() + max(0, timeout_ms) / 1000
    last_blocker = f"{provider} TUI did not become ready"
    while True:
        pane = pane_info(pane_id)
        text = pane_text(pane_id)
        blocker = agent_tui_blocker(provider, pane, text)
        if blocker is None and pane is not None:
            return pane, text
        last_blocker = blocker or last_blocker
        if time.monotonic() >= deadline:
            raise HLoopError(f"{provider} TUI is not ready for manager message: {last_blocker}")
        time.sleep(0.5)


def wait_manager_message_visible(pane_id: str, message: str, timeout_ms: int) -> str:
    deadline = time.monotonic() + max(0, timeout_ms) / 1000
    while True:
        text = pane_text(pane_id)
        if message_visible_in_text(message, text):
            return text
        if time.monotonic() >= deadline:
            raise HLoopError("manager message was not visible in the Codex input after send-text")
        time.sleep(0.2)


def manager_message_submitted(
    provider: str,
    pane_id: str,
    message: str,
    typed_snapshot: str,
    initial_session_id: str | None,
    timeout_ms: int,
) -> bool:
    deadline = time.monotonic() + max(0, timeout_ms) / 1000
    while True:
        pane = pane_info(pane_id)
        text = pane_text(pane_id)
        status = str((pane or {}).get("agent_status") or "unknown")
        session_id = extract_agent_session_id(pane)
        if status in {"working", "blocked"} or "esc to interrupt" in text or "• Working" in text:
            return True
        if agent_output_after_message(provider, message, text):
            return True
        if (
            normalize_agent_provider(provider) == "codex"
            and text != typed_snapshot
            and message_visible_in_text(message, text)
        ):
            # Codex can move the submitted input into the transcript before it
            # exposes a Working marker or assistant bullet.  The changed pane
            # snapshot plus the still-visible exact input is transport evidence;
            # classifying it as undelivered would make a retry duplicate work.
            return True
        if session_id and session_id != initial_session_id and text != typed_snapshot:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)


def send_codex_tui_message(
    pane_id: str,
    message: str,
    timeout_ms: int,
    input_settle_ms: int,
    submit_verify_ms: int,
    submit_attempts: int,
) -> None:
    send_agent_tui_message(
        "codex",
        pane_id,
        message,
        timeout_ms,
        input_settle_ms,
        submit_verify_ms,
        submit_attempts,
    )


def send_agent_tui_message(
    provider: str,
    pane_id: str,
    message: str,
    timeout_ms: int,
    input_settle_ms: int,
    submit_verify_ms: int,
    submit_attempts: int,
) -> None:
    provider = normalize_agent_provider(provider)
    if not message.strip():
        raise HLoopError("manager message is empty")
    check_herdr_env()
    initial_pane, _ = wait_agent_tui_ready(provider, pane_id, timeout_ms)
    initial_session_id = extract_agent_session_id(initial_pane)
    try:
        run_cmd(["herdr", "pane", "send-text", pane_id, message], check=True, capture=True)
    except (OSError, subprocess.CalledProcessError) as exc:
        raise HLoopError("manager message could not be typed into the agent pane") from exc
    try:
        typed_snapshot = wait_manager_message_visible(
            pane_id,
            message,
            max(input_settle_ms, 1_000),
        )
    except HLoopError as exc:
        raise ManagerMessageDeliveryUnknown(
            "send-text succeeded but input visibility could not be confirmed; "
            "delivery is unknown and must not be auto-retried"
        ) from exc
    if input_settle_ms > 0:
        time.sleep(input_settle_ms / 1000)
    attempts = max(1, submit_attempts)
    try:
        for attempt in range(attempts):
            run_cmd(["herdr", "pane", "send-keys", pane_id, "Enter"], check=True, capture=True)
            if manager_message_submitted(
                provider,
                pane_id,
                message,
                typed_snapshot,
                initial_session_id,
                submit_verify_ms,
            ):
                return
            if attempt + 1 < attempts and input_settle_ms > 0:
                time.sleep(input_settle_ms / 1000)
    except (HLoopError, OSError, subprocess.CalledProcessError) as exc:
        raise ManagerMessageDeliveryUnknown(
            "manager message was visibly typed before submission verification failed; "
            "delivery is unknown and must not be auto-retried"
        ) from exc
    raise ManagerMessageDeliveryUnknown(
        f"manager message was typed and Enter was sent {attempts} time(s), but submission "
        "could not be visually confirmed"
    )


def resend_pending_manager_messages(
    repo: Path,
    agent_state: dict[str, Any],
    *,
    timeout_ms: int,
    input_settle_ms: int,
    submit_verify_ms: int,
    submit_attempts: int,
) -> tuple[int, int]:
    """Resend one role's `undelivered` Manager messages; return (drained, remaining).

    Entries tagged anything other than `undelivered` (defensively defaulted to
    `undelivered` for pre-0.5.0 state) are left untouched: `unknown` messages
    must never be auto-resent, and a resend that itself comes back `unknown`
    is recorded as such rather than retried indefinitely.
    """

    pane_id = str(agent_state.get("pane_id") or "")
    pending = agent_state.get("pending_manager_messages") or []
    if not pane_id or not pending:
        return 0, 0
    remaining: list[dict[str, Any]] = []
    drained = 0
    marker = "## Message\n\n"
    for entry in pending:
        if str(entry.get("status") or "undelivered") != "undelivered":
            remaining.append(entry)
            continue
        pending_path = entry.get("pending_path")
        full_path = repo / pending_path if pending_path else None
        if full_path is None or not full_path.exists():
            entry["error"] = "pending Manager message file is missing"
            remaining.append(entry)
            continue
        content = read_text(full_path)
        offset = content.find(marker)
        message = content[offset + len(marker) :] if offset != -1 else content
        message_id = str(entry.get("message_id") or "")
        original = manager_message_by_id(agent_state, message_id) if message_id else None
        try:
            send_agent_tui_message(
                str(agent_state.get("agent_provider") or DEFAULT_AGENT_PROVIDER),
                pane_id,
                message,
                timeout_ms,
                input_settle_ms,
                submit_verify_ms,
                submit_attempts,
            )
        except ManagerMessageDeliveryUnknown as exc:
            if original is not None:
                transition_manager_message(
                    agent_state,
                    original,
                    delivery_status="unknown",
                    error=str(exc),
                )
            else:
                original = record_manager_message(
                    agent_state,
                    "drain",
                    message,
                    delivery_status="unknown",
                    delivery_error=str(exc),
                )
            agent_state.setdefault("unknown_manager_messages", []).append(
                {
                    "at": now_iso(),
                    "source": "drain",
                    "message_id": original.get("message_id"),
                    "error": str(exc),
                }
            )
            try:
                full_path.unlink()
            except OSError:
                pass
            continue
        except HLoopError:
            remaining.append(entry)
            continue
        if original is not None:
            transition_manager_message(
                agent_state, original, delivery_status="delivered"
            )
        else:
            record_manager_message(agent_state, "drain", message)
        try:
            full_path.unlink()
        except OSError:
            pass
        drained += 1
    agent_state["pending_manager_messages"] = remaining
    return drained, len(remaining)


def manager_message_from_args(args: argparse.Namespace) -> tuple[str, str]:
    if getattr(args, "file", None):
        path = Path(args.file).resolve()
        return read_text(path), str(path)
    if getattr(args, "message", None):
        return str(args.message), "argv"
    if not sys.stdin.isatty():
        return sys.stdin.read(), "stdin"
    raise HLoopError("provide a message argument, --file, or stdin")


def manager_message_envelope(
    state: dict[str, Any],
    agent_id: str,
    agent: dict[str, Any],
    message: str,
    *,
    contract_changing: bool = False,
) -> tuple[str, str]:
    message_id = str(uuid.uuid4())
    run_id = str(state.get("run_id") or "")
    attempt_id = str(agent.get("attempt_id") or agent.get("active_attempt_id") or "")
    ack = f"HERDR_LOOP_MESSAGE_ACK:{run_id}:{agent_id}:{attempt_id}:{message_id}"
    contract_notice = (
        "This message changes the task contract. Material work (a `done` finalize "
        "or merge) is blocked until the Manager resolves the semantic ACK barrier "
        "with `hloop agent ack resolve`.\n\n"
        if contract_changing
        else ""
    )
    body = (
        f"Manager message id: {message_id}\n"
        f"Before acting, print exactly: {ack}\n\n{contract_notice}{message.rstrip()}\n"
    )
    return message_id, body


def message_digest(message: str) -> str:
    return hashlib.sha256(message.encode("utf-8")).hexdigest()


def record_manager_message(
    target_state: dict[str, Any],
    source: str,
    message: str,
    *,
    delivery_status: str = "delivered",
    delivery_error: str | None = None,
    pending_path: str | None = None,
) -> dict[str, Any]:
    if delivery_status not in MESSAGE_DELIVERY_STATUSES:
        raise HLoopError(f"unsupported message delivery status: {delivery_status}")
    sent_at = now_iso()
    entry = {
        "at": sent_at,
        "sent_at": sent_at,
        "source": source,
        "bytes": len(message.encode("utf-8")),
        "lines": len(message.splitlines()) or 1,
        "digest": message_digest(message),
        "delivery_status": delivery_status,
        "result": None,
    }
    match = re.search(r"Manager message id: ([0-9a-f-]{36})", message)
    if match:
        entry["message_id"] = match.group(1)
    if delivery_error:
        entry["delivery_error"] = delivery_error
    if pending_path:
        entry["pending_path"] = pending_path
    target_state.setdefault("manager_messages", []).append(entry)
    return entry


def manager_message_by_id(
    target_state: dict[str, Any], message_id: str
) -> dict[str, Any] | None:
    for entry in reversed(target_state.get("manager_messages") or []):
        if entry.get("message_id") == message_id:
            return entry
    return None


def transition_manager_message(
    target_state: dict[str, Any],
    entry: dict[str, Any],
    *,
    delivery_status: str,
    result: str | None = None,
    error: str | None = None,
) -> dict[str, Any]:
    """Persist a legal transport/application status transition and its history."""

    if delivery_status not in MESSAGE_DELIVERY_STATUSES:
        raise HLoopError(f"unsupported message delivery status: {delivery_status}")
    previous = str(entry.get("delivery_status") or "delivered")
    allowed = {
        "delivered": {"acknowledged", "applied", "unknown", "superseded"},
        "acknowledged": {"applied", "unknown", "superseded"},
        "applied": set(),
        "undelivered": {"delivered", "unknown", "superseded"},
        "unknown": {"acknowledged", "applied", "undelivered", "superseded"},
        "superseded": set(),
    }
    if delivery_status == previous:
        return entry
    if delivery_status not in allowed.get(previous, set()):
        raise HLoopError(
            f"invalid message status transition: {previous} -> {delivery_status}"
        )
    if delivery_status == "applied" and not str(result or "").strip():
        raise HLoopError("applied message resolution requires a non-empty result")
    changed_at = now_iso()
    entry["delivery_status"] = delivery_status
    if delivery_status == "acknowledged":
        entry["acknowledged_at"] = changed_at
    elif delivery_status == "applied":
        entry.setdefault("acknowledged_at", changed_at)
        entry["applied_at"] = changed_at
        entry["result"] = str(result).strip()
    elif delivery_status == "superseded":
        entry["superseded_at"] = changed_at
    if error:
        entry["delivery_error"] = error
    target_state.setdefault("manager_message_events", []).append(
        {
            "message_id": entry.get("message_id"),
            "from": previous,
            "to": delivery_status,
            "at": changed_at,
            "result": entry.get("result"),
            "error": error,
        }
    )
    return entry


SEMANTIC_ACK_DECISIONS = frozenset({"approve", "reject", "timeout"})


def arm_semantic_ack_barrier(
    agent_state: dict[str, Any],
    *,
    message_id: str,
    digest: str,
    kind: str = "message",
    required_reack_after_sequence: int = 0,
) -> None:
    """(Re-)arm the semantic ACK barrier for a contract-changing Manager message.

    Any existing barrier -- pending, approved, or rejected -- is replaced, so a
    later contract-changing message always requires a fresh Manager decision
    even if an earlier barrier had already been resolved.
    """

    agent_state["semantic_ack_barrier"] = {
        "message_id": message_id,
        "digest": digest,
        "kind": kind,
        "status": "awaiting_ack",
        "armed_at": now_iso(),
        "required_reack_after_sequence": required_reack_after_sequence,
    }


def arm_initial_semantic_ack_barrier(
    agent_state: dict[str, Any],
    *,
    attempt_id: str,
    contract_digest: str,
    required_reack_after_sequence: int = 0,
) -> None:
    arm_semantic_ack_barrier(
        agent_state,
        message_id=f"initial:{attempt_id}",
        digest=contract_digest,
        kind="initial",
        required_reack_after_sequence=required_reack_after_sequence,
    )


def latest_semantic_ack_sequence(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    agent_state: dict[str, Any],
) -> int:
    attempt_id = str(
        agent_state.get("attempt_id") or agent_state.get("active_attempt_id") or ""
    )
    if not attempt_id:
        return 0
    store = _open_broker_store(repo)
    with store.transaction() as transaction:
        latest = store.latest_role_event(
            transaction,
            run_id=str(state.get("run_id") or "local"),
            role_id=role_id,
            attempt_id=attempt_id,
            report_type="ack",
        )
    return int((latest or {}).get("sequence") or 0)


def semantic_ack_barrier_blocking(agent_state: dict[str, Any]) -> str:
    """Return a non-empty block reason while material work must wait, else ""."""

    barrier = agent_state.get("semantic_ack_barrier")
    if not isinstance(barrier, dict) or barrier.get("status") == "approved":
        return ""
    return (
        f"semantic ACK barrier `{barrier.get('message_id')}` is "
        f"{barrier.get('status') or 'awaiting_ack'}; a fresh authenticated ACK "
        "must be approved with `hloop agent ack resolve`"
    )


def resolve_semantic_ack_barrier(
    agent_state: dict[str, Any],
    *,
    decision: str,
    reason: str,
    latest_ack: dict[str, Any] | None,
) -> dict[str, Any]:
    if decision not in SEMANTIC_ACK_DECISIONS:
        raise HLoopError(f"unsupported semantic ACK decision: {decision}")
    barrier = agent_state.get("semantic_ack_barrier")
    if not isinstance(barrier, dict):
        raise HLoopError("no pending semantic ACK barrier to resolve")
    if barrier.get("status") == "approved":
        raise HLoopError("semantic ACK barrier is already approved")
    latest_sequence = int((latest_ack or {}).get("sequence") or 0)
    required_after = int(barrier.get("required_reack_after_sequence") or 0)
    if decision in {"approve", "reject"} and latest_ack is None:
        raise HLoopError("no authenticated semantic ACK report is available")
    if decision == "approve" and latest_sequence <= required_after:
        raise HLoopError(
            "a corrected semantic ACK report is required after the previous reject/timeout"
        )
    if (
        decision == "approve"
        and str(barrier.get("kind") or "") == "task-contract"
        and str((latest_ack or {}).get("task_contract_digest") or "")
        != str(barrier.get("digest") or "")
    ):
        raise HLoopError(
            "the corrected semantic ACK does not match the active task contract digest"
        )
    if decision == "approve":
        barrier["status"] = "approved"
        barrier["ack_event_id"] = latest_ack["event_id"]
        barrier["ack_sequence"] = latest_sequence
    else:
        barrier["status"] = "rejected" if decision == "reject" else "timed_out"
        barrier["required_reack_after_sequence"] = max(required_after, latest_sequence)
        if latest_ack is not None:
            barrier["rejected_ack_event_id"] = latest_ack["event_id"]
            barrier["rejected_ack_sequence"] = latest_sequence
    barrier["resolved_at"] = now_iso()
    barrier["resolution_reason"] = reason
    return barrier


def write_pending_manager_message(
    repo: Path,
    *,
    role: str,
    agent_id: str,
    pane_id: str,
    source: str,
    message: str,
    error: str,
) -> Path:
    rel = (
        LOOP_DIR
        / "inbox"
        / "pending"
        / f"{filename_timestamp()}-{slugify(agent_id, 24)}.md"
    )
    body = (
        "# Pending Manager Message\n\n"
        f"- role: {role}\n"
        f"- id: `{agent_id}`\n"
        f"- pane_id: `{pane_id}`\n"
        f"- source: `{source}`\n"
        f"- recorded_at: `{now_iso()}`\n"
        f"- delivery_error: `{error}`\n\n"
        "## Message\n\n"
        f"{message.rstrip()}\n"
    )
    write_text(repo / rel, body)
    return rel


def record_pending_manager_message(
    repo: Path,
    state: dict[str, Any],
    agent_state: dict[str, Any],
    *,
    role: str,
    agent_id: str,
    pane_id: str,
    source: str,
    message: str,
    error: Exception,
) -> int:
    detail = str(error)
    pending_rel = write_pending_manager_message(
        repo,
        role=role,
        agent_id=agent_id,
        pane_id=pane_id,
        source=source,
        message=message,
        error=detail,
    )
    pending_path = pending_rel.as_posix()
    recorded = record_manager_message(
        agent_state,
        source,
        message,
        delivery_status="undelivered",
        delivery_error=detail,
        pending_path=pending_path,
    )
    agent_state["last_manager_message_error"] = detail
    agent_state["last_pending_manager_message"] = pending_path
    agent_state.setdefault("pending_manager_messages", []).append(
        {
            "at": now_iso(),
            "source": source,
            "pending_path": pending_path,
            "error": detail,
            "status": "undelivered",
            "message_id": recorded.get("message_id"),
        }
    )
    save_state(repo, state)
    journal(
        repo,
        f"Recorded undelivered Manager message for {role} `{agent_id}` at `{pending_path}`; "
        f"delivery failed: {detail}",
    )
    print(
        f"manager message not delivered to {agent_id}: {detail}; pending file: {pending_path}",
        file=sys.stderr,
    )
    return 2


def record_unknown_manager_message(
    repo: Path,
    state: dict[str, Any],
    agent_state: dict[str, Any],
    *,
    role: str,
    agent_id: str,
    source: str,
    message: str,
    error: Exception,
) -> int:
    """Record a message whose delivery could not be confirmed.

    ``unknown`` messages are intentionally kept out of ``pending_manager_messages``
    so `hloop message drain` never auto-resends them; only an explicit retry,
    pane check, or ``resolve`` clears them.
    """

    detail = str(error)
    recorded = record_manager_message(
        agent_state,
        source,
        message,
        delivery_status="unknown",
        delivery_error=detail,
    )
    agent_state["last_manager_message_error"] = detail
    agent_state.setdefault("unknown_manager_messages", []).append(
        {
            "at": now_iso(),
            "source": source,
            "message_id": recorded.get("message_id"),
            "error": detail,
        }
    )
    save_state(repo, state)
    journal(
        repo,
        f"Manager message delivery to {role} `{agent_id}` is unknown (not auto-resent): {detail}",
    )
    print(
        f"manager message delivery to {agent_id} is unknown: {detail}; "
        "confirm pane state or resend explicitly; it will not be auto-drained",
        file=sys.stderr,
    )
    return 3


def supersede_pending_manager_messages(repo: Path, agent_state: dict[str, Any]) -> list[dict[str, Any]]:
    """Mark an ending attempt's outstanding messages superseded and drop pending files.

    Called on abort/requeue so a dead attempt's undelivered or unknown messages
    are archived rather than silently forwarded into, or resent against, a new
    attempt.
    """

    messages = agent_state.get("manager_messages") or []
    for entry in messages:
        if entry.get("delivery_status") in {
            "delivered",
            "acknowledged",
            "undelivered",
            "unknown",
        }:
            transition_manager_message(
                agent_state, entry, delivery_status="superseded"
            )
    for entry in agent_state.get("pending_manager_messages") or []:
        pending_path = entry.get("pending_path")
        if not pending_path:
            continue
        try:
            (repo / pending_path).unlink()
        except OSError:
            pass
    agent_state["pending_manager_messages"] = []
    return messages


def extract_agent_session_id(pane: dict[str, Any] | None) -> str | None:
    if not pane:
        return None
    session = pane.get("agent_session")
    if isinstance(session, dict):
        value = session.get("value")
        if value:
            return str(value)
    for key in ("agent_session_id", "session_id"):
        value = pane.get(key)
        if value:
            return str(value)
    return None


def session_cleanup_mode(args: argparse.Namespace, state: dict[str, Any]) -> str:
    mode = getattr(args, "session_cleanup", None) or state.get("session_cleanup", "archive")
    mode = str(mode)
    if mode not in SESSION_CLEANUP_MODES:
        raise HLoopError(f"unsupported session cleanup mode: {mode}")
    return mode


def cleanup_codex_session(session_id: str, mode: str) -> tuple[bool, str]:
    if mode == "none":
        return True, "skipped"
    if not command_exists("codex"):
        return False, "codex command not found"
    cmd = ["codex", "archive", session_id]
    if mode == "delete":
        cmd = ["codex", "delete", "--force", session_id]
    proc = run_cmd(cmd, check=False)
    if proc.returncode == 0:
        return True, mode
    message = (proc.stderr or proc.stdout or "").strip()
    return False, message or f"codex {mode} failed"


def cleanup_agent_session(provider: str, session_id: str, mode: str) -> tuple[bool, str]:
    provider = normalize_agent_provider(provider)
    if provider == "codex":
        return cleanup_codex_session(session_id, mode)
    if mode == "none":
        return True, "skipped"
    return True, f"skipped:{provider}-session-cleanup-unsupported"


def retry_agent_session_cleanup(
    repo: Path,
    agent_state: dict[str, Any],
    *,
    label: str,
    provider: str,
    session_id: str,
    session_cleanup: str,
) -> None:
    ok, detail = cleanup_agent_session(provider, session_id, session_cleanup)
    agent_state["agent_session_cleanup"] = detail
    if normalize_agent_provider(provider) == "codex":
        agent_state["codex_session_cleanup"] = detail
    if ok:
        agent_state["agent_session_cleaned_at"] = now_iso()
        if normalize_agent_provider(provider) == "codex":
            agent_state["codex_session_cleaned_at"] = agent_state["agent_session_cleaned_at"]
        agent_state.pop("agent_session_cleanup_error", None)
        agent_state.pop("agent_session_cleanup_error_fingerprint", None)
        agent_state.pop("codex_session_cleanup_error", None)
        journal(repo, f"{provider} session `{session_id}` for `{label}` cleanup: {detail}.")
    else:
        agent_state["agent_session_cleanup_error"] = detail
        agent_state["agent_session_cleanup_error_fingerprint"] = cleanup_error_fingerprint("session", detail)
        if normalize_agent_provider(provider) == "codex":
            agent_state["codex_session_cleanup_error"] = detail
        journal(repo, f"Failed {provider} session cleanup for `{label}` session `{session_id}`: {detail}")


def cleanup_completed_agent_pane(
    repo: Path,
    agent_state: dict[str, Any],
    *,
    label: str,
    keep_pane: bool = False,
    session_cleanup: str = "archive",
    dry_run: bool = False,
) -> None:
    pane_id = str(agent_state.get("pane_id") or "")
    if not pane_id or agent_state.get("pane_closed_at"):
        return
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        agent_state["pane_cleanup_status"] = "skipped:not-in-herdr"
        return
    try:
        current = current_pane_id()
    except HLoopError:
        current = ""
    if pane_id == current:
        agent_state["pane_cleanup_status"] = "skipped:manager-pane"
        journal(repo, f"Skipped closing `{label}` pane `{pane_id}` because it is the current Manager pane.")
        return
    pane = pane_info(pane_id)
    if pane is None:
        agent_state["pane_closed_at"] = now_iso()
        agent_state["pane_cleanup_status"] = "already-closed"
        agent_state["closed_pane_id"] = pane_id
        agent_state.pop("pane_id", None)
        return
    session_id = extract_agent_session_id(pane)
    provider = str(agent_state.get("agent_provider") or agent_state.get("provider") or DEFAULT_AGENT_PROVIDER)
    if session_id:
        agent_state["agent_session_id"] = session_id
        agent_state["agent_session_provider"] = provider
        if normalize_agent_provider(provider) == "codex":
            agent_state["codex_session_id"] = session_id
    if keep_pane:
        agent_state["pane_cleanup_status"] = "kept"
        return
    if dry_run:
        print(f"DRY RUN herdr pane close {pane_id}")
        if session_id and session_cleanup != "none":
            print(f"DRY RUN {provider} session cleanup {session_cleanup} {session_id}")
        return
    proc = run_cmd(["herdr", "pane", "close", pane_id], check=False)
    if proc.returncode == 0:
        agent_state["pane_closed_at"] = now_iso()
        agent_state["pane_cleanup_status"] = "closed"
        agent_state["closed_pane_id"] = pane_id
        agent_state.pop("pane_id", None)
        agent_state.pop("pane_cleanup_error", None)
        agent_state.pop("pane_cleanup_error_fingerprint", None)
        journal(repo, f"Closed `{label}` pane `{pane_id}` after harvesting its artifact.")
    else:
        message = (proc.stderr or proc.stdout or "").strip()
        agent_state["pane_cleanup_status"] = "failed"
        agent_state["pane_cleanup_error"] = message
        agent_state["pane_cleanup_error_fingerprint"] = cleanup_error_fingerprint("pane", message)
        journal(repo, f"Failed to close `{label}` pane `{pane_id}`: {message}")
        return
    if session_id:
        retry_agent_session_cleanup(
            repo, agent_state, label=label, provider=provider, session_id=session_id, session_cleanup=session_cleanup
        )


def require_worker_pane_quiesced_and_closed(
    repo: Path, task_id: str, task_state: dict[str, Any]
) -> None:
    """Confirm the Worker's pane is idle and close it before any Git/validation work.

    Sealing reads and mutates the Worker's live worktree. If the Worker's TUI
    pane is still open and could still be running, staging or committing its
    files races the agent process. Fail closed rather than best-effort: an
    already-closed pane (or one this Manager cannot confirm quiesced) is not
    good enough to proceed.
    """

    if task_state.get("pane_closed_at"):
        return
    pane_id = str(task_state.get("pane_id") or "")
    if not pane_id:
        raise HLoopError(
            f"cannot seal {task_id}: no pane_id on record and the pane was never closed; "
            "cannot confirm the Worker is quiesced"
        )
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        raise HLoopError(
            f"cannot seal {task_id}: Herdr is required to confirm and close Worker pane `{pane_id}` "
            "before sealing"
        )
    try:
        current = current_pane_id()
    except HLoopError as exc:
        raise HLoopError(
            f"cannot seal {task_id}: could not determine the current Manager pane: {exc}"
        ) from exc
    if pane_id == current:
        raise HLoopError(
            f"cannot seal {task_id}: Worker pane `{pane_id}` is the current Manager pane"
        )
    pane = pane_info(pane_id)
    if pane is not None:
        provider = str(task_state.get("agent_provider") or task_state.get("provider") or DEFAULT_AGENT_PROVIDER)
        text = pane_text(pane_id, lines=200)
        blocker = agent_tui_blocker(provider, pane, text)
        if blocker:
            raise HLoopError(f"cannot seal {task_id}: Worker pane is not quiesced: {blocker}")
        close_proc = run_cmd(["herdr", "pane", "close", pane_id], check=False)
        if close_proc.returncode != 0:
            message = (close_proc.stderr or close_proc.stdout or "").strip()
            raise HLoopError(f"cannot seal {task_id}: failed to close Worker pane `{pane_id}`: {message}")
    task_state["pane_closed_at"] = now_iso()
    task_state["pane_cleanup_status"] = "closed" if pane is not None else "already-closed"
    task_state["closed_pane_id"] = pane_id
    task_state.pop("pane_id", None)


def current_pane_id() -> str:
    if os.environ.get("HERDR_PANE_ID"):
        return str(os.environ["HERDR_PANE_ID"])
    payload = json_from_cmd(["herdr", "pane", "current", "--current"])
    return extract_pane_id(payload)


def current_workspace_id() -> str | None:
    return os.environ.get("HERDR_WORKSPACE_ID")


def check_herdr_env() -> None:
    if os.environ.get("HERDR_ENV") != "1":
        raise HLoopError("HERDR_ENV=1 is required; run this skill inside Herdr")


def task_file(repo: Path, task_id: str) -> Path:
    return loop_path(repo) / "tasks" / f"{task_id}.md"


def batch_file(repo: Path, batch_id: str) -> Path:
    return loop_path(repo) / "batches" / f"{batch_id}.md"


def result_file(worktree: Path, task_id: str) -> Path:
    return loop_path(worktree) / "results" / task_id / "result.md"


def planning_dir(repo: Path) -> Path:
    return loop_path(repo) / "planning"


def planning_artifact_file(repo: Path, record_type: str) -> Path:
    filename = PLANNING_ARTIFACT_FILENAMES.get(record_type)
    if filename is None:
        raise HLoopError(f"unsupported planning artifact type: {record_type}")
    return planning_dir(repo) / filename


def implementation_candidate_rel(
    task_id: str, attempt_id: str, candidate_revision: int
) -> Path:
    return (
        LOOP_DIR
        / "implementation-candidates"
        / task_id
        / attempt_id
        / f"{candidate_revision}.json"
    )


def implementation_candidate_file(
    repo: Path, task_id: str, attempt_id: str, candidate_revision: int
) -> Path:
    return repo / implementation_candidate_rel(task_id, attempt_id, candidate_revision)


def patch_review_rel(task_id: str, attempt_id: str, review_attempt_id: str) -> Path:
    return LOOP_DIR / "patch-reviews" / task_id / attempt_id / f"{review_attempt_id}.json"


def patch_review_file(
    repo: Path, task_id: str, attempt_id: str, review_attempt_id: str
) -> Path:
    return repo / patch_review_rel(task_id, attempt_id, review_attempt_id)


def candidate_artifact_ref(
    task_id: str, attempt_id: str, candidate_revision: int
) -> str:
    return (
        Path("implementation-candidates")
        / task_id
        / attempt_id
        / f"{candidate_revision}.json"
    ).as_posix()


def exact_json_bytes(record: Mapping[str, Any]) -> bytes:
    return (
        json.dumps(record, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    ).encode("utf-8")


def load_candidate_artifact(
    repo: Path,
    task_id: str,
    attempt_id: str,
    candidate_revision: int,
) -> tuple[hloop_worker_candidate.ImplementationCandidate, bytes]:
    path = implementation_candidate_file(
        repo, task_id, attempt_id, candidate_revision
    )
    if not path.is_file():
        raise HLoopError(f"implementation candidate is missing: {path}")
    payload = path.read_bytes()
    try:
        value = json.loads(payload)
        candidate = hloop_worker_candidate.ImplementationCandidate.from_record(value)
    except (
        json.JSONDecodeError,
        hloop_worker_candidate.WorkerCandidateError,
    ) as exc:
        raise HLoopError(f"invalid implementation candidate {path}: {exc}") from exc
    return candidate, payload


def active_attempt_id(task_id: str, task_state: Mapping[str, Any]) -> str:
    attempt_id = str(
        task_state.get("active_attempt_id") or task_state.get("attempt_id") or ""
    )
    if not attempt_id:
        raise HLoopError(f"active attempt is missing for {task_id}")
    return attempt_id


def approved_semantic_ack_event_id(
    task_id: str, task_state: Mapping[str, Any]
) -> str:
    block_reason = semantic_ack_barrier_blocking(dict(task_state))
    if block_reason:
        raise HLoopError(f"candidate gate blocked for {task_id}: {block_reason}")
    barrier = task_state.get("semantic_ack_barrier")
    event_id = (
        str(barrier.get("ack_event_id") or "")
        if isinstance(barrier, Mapping)
        else ""
    )
    if not event_id:
        raise HLoopError(
            f"candidate gate blocked for {task_id}: approved semantic ACK event is missing"
        )
    return event_id


def exact_task_contract_digest(
    repo: Path,
    task_id: str,
    task_state: Mapping[str, Any],
) -> tuple[str, str]:
    path = task_file(repo, task_id)
    if not path.is_file():
        raise HLoopError(f"task contract is missing: {path}")
    raw_digest = hashlib.sha256(path.read_bytes()).hexdigest()
    recorded = str(task_state.get("task_contract_digest") or "")
    if not re.fullmatch(r"[0-9a-f]{64}", recorded):
        raise HLoopError(
            f"task contract digest projection is missing or invalid for {task_id}"
        )
    if recorded != raw_digest:
        raise HLoopError(
            f"task contract digest drift for {task_id}: "
            f"state={recorded} artifact={raw_digest}"
        )
    return raw_digest, _labelled_contract_digest(raw_digest)


def candidate_revision_numbers(
    repo: Path, task_id: str, attempt_id: str
) -> list[int]:
    directory = implementation_candidate_file(repo, task_id, attempt_id, 1).parent
    if not directory.is_dir():
        return []
    revisions: list[int] = []
    for path in directory.iterdir():
        match = re.fullmatch(r"([1-9][0-9]*)\.json", path.name)
        if match:
            revisions.append(int(match.group(1)))
    return sorted(set(revisions))


def changed_files_between_git_objects(
    repo: Path, base_object: str, target_object: str
) -> list[str]:
    out = git_bytes(
        repo,
        [
            "diff",
            "--name-status",
            "-z",
            "--no-renames",
            f"{base_object}^{{tree}}",
            f"{target_object}^{{tree}}",
        ],
        check=True,
    )
    return parse_changed_files_name_status_z(out)


def proposed_worktree_tree(repo: Path, dirty_paths: Sequence[str]) -> str:
    if not dirty_paths:
        return git(repo, ["rev-parse", "HEAD^{tree}"])
    descriptor, index_name = tempfile.mkstemp(prefix="hloop-candidate-index-")
    os.close(descriptor)
    index_path = Path(index_name)
    try:
        index_path.unlink()
        env = dict(os.environ)
        env["GIT_INDEX_FILE"] = str(index_path)
        git(repo, ["read-tree", "HEAD"], env=env)
        git(repo, ["add", "-A", "--", *dirty_paths], env=env)
        return git(repo, ["write-tree"], env=env)
    finally:
        try:
            index_path.unlink()
        except FileNotFoundError:
            pass


def candidate_changed_files(
    repo: Path, base_sha: str, candidate_tree_sha: str
) -> list[str]:
    return changed_files_between_git_objects(repo, base_sha, candidate_tree_sha)


def unstaged_product_paths(repo: Path) -> list[str]:
    loop_root = LOOP_DIR.as_posix()
    loop_prefix = loop_root + "/"
    return [
        path
        for path in porcelain_paths_no_renames(repo)
        if path != loop_root and not path.startswith(loop_prefix)
    ]


def exact_product_dirty_paths(repo: Path) -> list[str]:
    loop_root = LOOP_DIR.as_posix()
    loop_prefix = loop_root + "/"
    return [
        path
        for path in porcelain_paths_all_no_renames(repo)
        if path != loop_root and not path.startswith(loop_prefix)
    ]


def task_required_gates(meta: Mapping[str, Any]) -> frozenset[str]:
    return frozenset(normalize_list(meta.get("required_gates")))


def current_candidate_evidence(
    repo: Path,
    state: dict[str, Any],
    task_id: str,
    task_state: dict[str, Any],
) -> tuple[
    hloop_worker_candidate.ImplementationCandidate,
    hloop_worker_candidate.CandidateSeal,
    bytes,
]:
    candidate_record = task_state.get("implementation_candidate")
    seal_record = task_state.get("candidate_seal")
    if not isinstance(candidate_record, Mapping) or not isinstance(
        seal_record, Mapping
    ):
        raise HLoopError(f"sealed implementation candidate is missing for {task_id}")
    try:
        candidate = hloop_worker_candidate.ImplementationCandidate.from_record(
            candidate_record
        )
        seal = hloop_worker_candidate.CandidateSeal.from_record(seal_record)
    except hloop_worker_candidate.WorkerCandidateError as exc:
        raise HLoopError(f"stored candidate evidence is invalid for {task_id}: {exc}") from exc
    attempt_id = active_attempt_id(task_id, task_state)
    if candidate.attempt_id != attempt_id:
        raise HLoopError(f"stored candidate attempt is stale for {task_id}")
    path = implementation_candidate_file(
        repo, task_id, attempt_id, candidate.candidate_revision
    )
    if not path.is_file():
        raise HLoopError(f"sealed candidate artifact is missing: {path}")
    payload = path.read_bytes()
    try:
        disk_candidate = hloop_worker_candidate.ImplementationCandidate.from_record(
            json.loads(payload)
        )
    except (
        json.JSONDecodeError,
        hloop_worker_candidate.WorkerCandidateError,
    ) as exc:
        raise HLoopError(f"sealed candidate artifact is invalid: {path}: {exc}") from exc
    if disk_candidate != candidate:
        raise HLoopError(f"stored candidate projection differs from artifact: {path}")
    artifact_digest = _sha256_labelled(payload)
    try:
        hloop_worker_candidate.validate_candidate_seal(
            candidate,
            seal,
            candidate_artifact_digest=artifact_digest,
        )
    except hloop_worker_candidate.WorkerCandidateError as exc:
        raise HLoopError(f"candidate seal is invalid for {task_id}: {exc}") from exc
    expected_projection = {
        "candidate_revision": candidate.candidate_revision,
        "candidate_artifact_digest": artifact_digest,
        "candidate_sha": seal.candidate_sha,
        "candidate_tree_sha": seal.candidate_tree_sha,
        "completion_mode": candidate.completion_mode,
    }
    for field, expected in expected_projection.items():
        if task_state.get(field) != expected:
            raise HLoopError(
                f"candidate state projection is stale for {task_id}: {field} changed"
            )
    raw_contract_digest, labelled_contract_digest = exact_task_contract_digest(
        repo, task_id, task_state
    )
    if candidate.task_contract_digest != labelled_contract_digest:
        raise HLoopError(f"candidate task contract is stale for {task_id}")
    if str(task_state.get("task_contract_digest") or raw_contract_digest) != raw_contract_digest:
        raise HLoopError(f"candidate task contract projection is stale for {task_id}")
    approved_ack = approved_semantic_ack_event_id(task_id, task_state)
    if candidate.semantic_ack_event_id != approved_ack:
        raise HLoopError(f"candidate semantic ACK is stale for {task_id}")
    observed_tree = git(repo, ["show", "-s", "--format=%T", seal.candidate_sha])
    if observed_tree != seal.candidate_tree_sha:
        raise HLoopError(f"candidate commit tree drift for {task_id}")
    return candidate, seal, payload


def patch_review_round_limit(state: Mapping[str, Any]) -> int:
    configured: Any = None
    resolved = state.get("resolved_config")
    if isinstance(resolved, Mapping):
        audit = resolved.get("audit")
        if isinstance(audit, Mapping):
            configured = audit.get("max_patch_review_rounds_per_task")
    if configured is None:
        configured = state.get("max_patch_review_rounds_per_task")
    if configured is None:
        configured = hloop_worker_candidate.DEFAULT_MAX_PATCH_REVIEW_ROUNDS_PER_TASK
    if isinstance(configured, bool) or not isinstance(configured, int):
        raise HLoopError("max_patch_review_rounds_per_task must be an integer")
    if not 0 <= configured <= hloop_worker_candidate.MAX_PATCH_REVIEW_ROUNDS_PER_TASK:
        raise HLoopError(
            "max_patch_review_rounds_per_task is outside the supported range"
        )
    return configured


def task_patch_review_history(
    task_state: Mapping[str, Any],
) -> list[hloop_worker_candidate.PatchReview]:
    history = task_state.get("patch_review_history") or []
    if not isinstance(history, list):
        raise HLoopError("patch_review_history must be an array")
    try:
        return [
            hloop_worker_candidate.PatchReview.from_record(item) for item in history
        ]
    except hloop_worker_candidate.WorkerCandidateError as exc:
        raise HLoopError(f"stored Patch Review history is invalid: {exc}") from exc


def fresh_passed_patch_review(
    repo: Path,
    task_id: str,
    task_state: Mapping[str, Any],
    seal: hloop_worker_candidate.CandidateSeal,
    *,
    current_task_contract_digest: str,
) -> hloop_worker_candidate.PatchReview | None:
    current = task_state.get("current_patch_review")
    if not isinstance(current, Mapping):
        return None
    try:
        review = hloop_worker_candidate.PatchReview.from_record(current)
        review = hloop_worker_candidate.require_fresh_patch_review(
            review,
            seal,
            current_task_contract_digest=current_task_contract_digest,
        )
        path = patch_review_file(
            repo, task_id, seal.attempt_id, review.review_attempt_id
        )
        if not path.is_file():
            raise HLoopError(f"passed Patch Review artifact is missing: {path}")
        expected_payload = exact_json_bytes(review.to_record())
        if path.read_bytes() != expected_payload:
            raise HLoopError(
                f"passed Patch Review artifact differs from its exact state record: {path}"
            )
        return review
    except hloop_worker_candidate.WorkerCandidateError as exc:
        raise HLoopError(f"Patch Review gate is not satisfied: {exc}") from exc


def review_file(repo: Path, review_id: str) -> Path:
    return loop_path(repo) / "reviews" / f"{review_id}.md"


def review_group_dir(repo: Path, review_id: str) -> Path:
    return loop_path(repo) / "reviews" / review_id


def review_manifest_file(repo: Path, review_id: str) -> Path:
    return review_group_dir(repo, review_id) / "MANIFEST.json"


def review_provider_file(repo: Path, review_id: str, provider: str) -> Path:
    return review_group_dir(repo, review_id) / "providers" / f"{provider}.md"


def review_final_file(repo: Path, review_id: str) -> Path:
    return review_group_dir(repo, review_id) / "FINAL.md"


def is_directory_review(review: dict[str, Any]) -> bool:
    return str(review.get("mode") or "single") != "single"


def gap_file(repo: Path, gap_id: str) -> Path:
    return loop_path(repo) / "gaps" / f"{gap_id}.md"


def advice_file(repo: Path, advice_id: str, participant_id: str | None = None) -> Path:
    if participant_id:
        return loop_path(repo) / "advice" / f"{advice_id}-{participant_id}.md"
    return loop_path(repo) / "advice" / f"{advice_id}.md"


def prompt_file(repo: Path, name: str) -> Path:
    return loop_path(repo) / "prompts" / name


def recorded_path(repo: Path, value: Any, fallback: Path) -> Path:
    if not value:
        return fallback
    path = Path(str(value))
    return path if path.is_absolute() else repo / path


def artifact_was_harvested(agent: dict[str, Any]) -> bool:
    return bool(agent.get("harvested_at")) or agent_gate_status(agent) in {
        "reported",
        "triaged",
        "blocked_write_scope",
        "consumed",
    } or str(agent.get("status") or "") in {
        "result_reported",
        "merged",
        "partial",
        "blocked",
        "failed",
        "abandoned",
    }


def worker_artifact_path(
    repo: Path, state: dict[str, Any], task_id: str, task: dict[str, Any]
) -> Path:
    if artifact_was_harvested(task):
        return result_file(repo, task_id)
    worktree = Path(task.get("worktree") or default_worktree(repo, task_id, state)).resolve()
    return result_file(worktree, task_id)


def review_artifact_path(repo: Path, review_id: str, review: dict[str, Any]) -> Path:
    fallback = (
        review_final_file(repo, review_id)
        if is_directory_review(review)
        else review_file(repo, review_id)
    )
    if artifact_was_harvested(review):
        return fallback
    return recorded_path(
        repo,
        review.get("worktree_review_path") or review.get("review_path"),
        fallback,
    )


def load_review_manifest(path: Path) -> hloop_review.ReviewManifest:
    try:
        raw = json.loads(read_text(path))
        return hloop_review.ReviewManifest.from_record(raw)
    except (json.JSONDecodeError, hloop_review.ReviewModelError) as exc:
        raise HLoopError(f"invalid review manifest {path}: {exc}") from exc


def gap_artifact_path(repo: Path, gap_id: str, gap: dict[str, Any]) -> Path:
    if artifact_was_harvested(gap):
        return gap_file(repo, gap_id)
    return recorded_path(
        repo,
        gap.get("worktree_gap_path") or gap.get("gap_path"),
        gap_file(repo, gap_id),
    )


def advice_artifact_path(repo: Path, advice_id: str, participant: dict[str, Any]) -> Path:
    fallback = advice_file(repo, advice_id, str(participant.get("participant_id") or "P1"))
    if artifact_was_harvested(participant):
        return fallback
    return recorded_path(
        repo,
        participant.get("worktree_advice_path") or participant.get("advice_path"),
        fallback,
    )


def triage_draft_file(repo: Path, source_id: str) -> Path:
    return loop_path(repo) / "triage" / f"{source_id}.fix-task-draft.md"


def manager_qa_file(repo: Path) -> Path:
    return loop_path(repo) / "qa" / "FINAL.md"


def normalize_list(value: Any) -> list[str]:
    if value is None:
        return []
    if isinstance(value, list):
        return [str(v) for v in value]
    return [str(value)]


def normalize_agent_provider(value: Any, default: str = DEFAULT_AGENT_PROVIDER) -> str:
    provider = str(value or default or DEFAULT_AGENT_PROVIDER).strip().lower()
    if provider not in AGENT_PROVIDERS:
        raise HLoopError(
            f"unsupported agent provider `{provider}`; expected one of: {', '.join(sorted(AGENT_PROVIDERS))}"
        )
    return provider


def normalize_agent_model(value: Any) -> str:
    model = str(value or DEFAULT_AGENT_MODEL).strip()
    return model or DEFAULT_AGENT_MODEL


def normalize_agent_effort(value: Any) -> str:
    effort = str(value or DEFAULT_AGENT_EFFORT).strip().lower()
    return effort or DEFAULT_AGENT_EFFORT


def role_state_prefix(role: str) -> str:
    if role == "reviewer":
        return "reviewer"
    if role == "gap":
        return "gap"
    if role == "advisor":
        return "advisor"
    return "worker"


def role_agent_config(
    state: dict[str, Any],
    role: str,
    *,
    overrides: dict[str, Any] | None = None,
) -> dict[str, str]:
    overrides = overrides or {}
    prefix = role_state_prefix(role)
    provider = normalize_agent_provider(
        overrides.get("agent_provider")
        or overrides.get("provider")
        or overrides.get(f"{prefix}_agent_provider")
        or overrides.get(f"{prefix}_provider")
        or state.get(f"{prefix}_agent_provider")
        or state.get(f"{prefix}_provider")
        or DEFAULT_AGENT_PROVIDER
    )
    model = normalize_agent_model(
        overrides.get("agent_model")
        or overrides.get("model")
        or overrides.get(f"{prefix}_agent_model")
        or overrides.get(f"{prefix}_model")
        or state.get(f"{prefix}_agent_model")
        or state.get(f"{prefix}_model")
        or DEFAULT_AGENT_MODEL
    )
    fallback = str(
        overrides.get("fallback_provider")
        or state.get(f"{prefix}_fallback_provider")
        or DEFAULT_AGENT_PROVIDER
    ).strip().lower()
    if fallback and fallback not in AGENT_PROVIDERS:
        raise HLoopError(
            f"unsupported fallback provider `{fallback}`; expected one of: {', '.join(sorted(AGENT_PROVIDERS))}"
        )
    effort = normalize_agent_effort(
        overrides.get("agent_effort")
        or overrides.get(f"{prefix}_agent_effort")
        or state.get(f"{prefix}_agent_effort")
    )
    permission_mode = str(
        overrides.get("claude_permission_mode")
        or overrides.get(f"{prefix}_claude_permission_mode")
        or state.get(f"{prefix}_claude_permission_mode")
        or DEFAULT_CLAUDE_PERMISSION_MODE
    ).strip()
    return {"provider": provider, "model": model, "effort": effort, "claude_permission_mode": permission_mode, "fallback_provider": fallback}


def require_agent_provider_available(provider: str) -> None:
    provider = normalize_agent_provider(provider)
    if not command_exists(provider):
        raise HLoopError(f"{provider} command not found")


def agent_display(config: dict[str, str]) -> str:
    model = config.get("model") or DEFAULT_AGENT_MODEL
    provider = config.get("provider") or DEFAULT_AGENT_PROVIDER
    if model == DEFAULT_AGENT_MODEL:
        return provider
    return f"{provider}:{model}"


def normalize_bool(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() in {"1", "true", "yes", "on"}
    return bool(value)


def normalize_int(value: Any, default: int) -> int:
    if value is None:
        return default
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def parse_changed_files_name_status(text: str) -> list[str]:
    paths: list[str] = []
    for line in text.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t")
        status = parts[0]
        if (status.startswith("R") or status.startswith("C")) and len(parts) >= 3:
            paths.extend([parts[1], parts[2]])
        elif len(parts) >= 2:
            paths.append(parts[1])
    return list(dict.fromkeys(normalize_match_path(path) for path in paths if path.strip()))


def split_nul_records(data: bytes, *, command: str) -> list[bytes]:
    """Split one complete Git ``-z`` stream without losing path characters."""

    if not data:
        return []
    if not data.endswith(b"\0"):
        raise HLoopError(f"{command} returned an incomplete NUL-delimited record")
    return data[:-1].split(b"\0")


def git_path_from_bytes(value: bytes) -> str:
    """Decode a Git path as UTF-8 and reject ambiguous byte-only filenames."""

    try:
        decoded = value.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise HLoopError(
            "Git path inventory returned non-UTF-8 path bytes; refusing to persist an ambiguous path"
        ) from exc
    return normalize_match_path(decoded)


def parse_name_status_z_records(
    data: bytes,
    *,
    command: str = "git diff --name-status -z",
) -> list[tuple[str, tuple[str, ...]]]:
    """Parse Git's NUL-delimited name-status protocol exactly."""

    fields = split_nul_records(data, command=command)
    records: list[tuple[str, tuple[str, ...]]] = []
    index = 0
    while index < len(fields):
        try:
            status = fields[index].decode("ascii")
        except UnicodeDecodeError as exc:
            raise HLoopError(f"{command} returned a non-ASCII status") from exc
        index += 1
        path_count = 2 if status.startswith(("R", "C")) else 1
        if not status or index + path_count > len(fields):
            raise HLoopError(f"{command} returned a malformed NUL-delimited record")
        paths = tuple(git_path_from_bytes(value) for value in fields[index : index + path_count])
        if any(not path for path in paths):
            raise HLoopError(f"{command} returned an empty path")
        records.append((status, paths))
        index += path_count
    return records


def parse_changed_files_name_status_z(data: bytes) -> list[str]:
    paths = [
        path
        for _, record_paths in parse_name_status_z_records(data)
        for path in record_paths
    ]
    return list(dict.fromkeys(paths))


def parse_name_only_z(data: bytes, *, command: str) -> list[str]:
    return [git_path_from_bytes(value) for value in split_nul_records(data, command=command)]


def git_name_only_z(repo: Path, args: list[str], *, command: str) -> list[str]:
    return parse_name_only_z(git_bytes(repo, [*args, "-z"]), command=command)


def changed_files(repo: Path, base_sha: str, head_sha: str) -> list[str]:
    if not base_sha or not head_sha:
        return []
    out = git_bytes(
        repo,
        ["diff", "--name-status", "-z", "--find-renames", f"{base_sha}..{head_sha}"],
        check=True,
    )
    return parse_changed_files_name_status_z(out)


def git_worktree_paths(repo: Path) -> list[Path]:
    """Return every checkout sharing this repository's common Git directory."""

    output = git(repo, ["worktree", "list", "--porcelain"])
    return [
        Path(line.removeprefix("worktree ")).resolve()
        for line in output.splitlines()
        if line.startswith("worktree ")
    ]


def canonical_worker_contract_source(
    worker_repo: Path,
    task_id: str,
    local_state: dict[str, Any],
) -> tuple[Path, dict[str, Any]]:
    """Locate the active Manager checkout that owns a Worker's live contract.

    A local-only role worktree intentionally receives a point-in-time loop
    snapshot. Contract changes and semantic ACK approval are Manager-owned
    state, so ``worker finalize`` must not trust that stale snapshot when the
    active integration checkout is available through the shared Git worktree
    inventory.
    """

    worker_repo = worker_repo.resolve()
    expected_run_id = str(local_state.get("run_id") or "")
    for candidate in git_worktree_paths(worker_repo):
        if candidate == worker_repo or not state_path(candidate).is_file():
            continue
        try:
            candidate_state = load_state(candidate)
        except (HLoopError, OSError, json.JSONDecodeError):
            continue
        if expected_run_id and str(candidate_state.get("run_id") or "") != expected_run_id:
            continue
        task_state = (candidate_state.get("tasks") or {}).get(task_id)
        if not isinstance(task_state, dict) or str(task_state.get("status") or "") != "running":
            continue
        worktree_raw = str(task_state.get("worktree") or "")
        if not worktree_raw or Path(worktree_raw).resolve() != worker_repo:
            continue
        integration_branch = str(candidate_state.get("integration_branch") or "")
        if integration_branch and current_branch(candidate) != integration_branch:
            continue
        return candidate, candidate_state
    local_task = (local_state.get("tasks") or {}).get(task_id)
    local_integration = str(local_state.get("integration_branch") or "")
    local_worktree = str((local_task or {}).get("worktree") or "")
    if (
        isinstance(local_task, dict)
        and local_integration
        and current_branch(worker_repo) != local_integration
        and local_worktree
        and Path(local_worktree).resolve() == worker_repo
    ):
        raise HLoopError(
            f"canonical Manager task contract is unavailable for active Worker {task_id}"
        )
    return worker_repo, local_state


def git_show(repo: Path, ref_path: str) -> str:
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "show", ref_path], check=False)
    if proc.returncode != 0:
        raise HLoopError((proc.stderr or proc.stdout or "").strip())
    return proc.stdout or ""


def require_files_committed_at_ref(repo: Path, ref: str, relative_paths: list[Path]) -> None:
    stale: list[str] = []
    missing: list[str] = []
    for relative in relative_paths:
        path = repo / relative
        if not path.exists():
            missing.append(relative.as_posix())
            continue
        try:
            committed = git_show(repo, f"{ref}:{relative.as_posix()}")
        except HLoopError:
            stale.append(f"{relative.as_posix()} (not committed at {ref})")
            continue
        if committed != read_text(path):
            stale.append(f"{relative.as_posix()} (working copy differs from {ref})")
    if missing or stale:
        details = [*(f"missing: {item}" for item in missing), *stale]
        raise HLoopError(
            "role worktree snapshot is not checkpointed; no worktree was created. "
            "Run `hloop checkpoint --message \"ai-loop: checkpoint role inputs\"` first. "
            + "; ".join(details)
        )


def worker_snapshot_paths(task_id: str) -> list[Path]:
    return [
        LOOP_DIR / "MISSION.md",
        LOOP_DIR / "PLAN.md",
        LOOP_DIR / "PROFILE.md",
        LOOP_DIR / "DECISIONS.md",
        LOOP_DIR / "tasks" / f"{task_id}.md",
    ]


def audit_snapshot_paths(repo: Path) -> list[Path]:
    paths = [
        LOOP_DIR / "MISSION.md",
        LOOP_DIR / "PLAN.md",
        LOOP_DIR / "PROFILE.md",
        LOOP_DIR / "DECISIONS.md",
        LOOP_DIR / "STATE.json",
    ]
    for subdir in ("tasks", "results", "validation"):
        root = loop_path(repo) / subdir
        if root.exists():
            paths.extend(path.relative_to(repo) for path in root.rglob("*") if path.is_file())
    return list(dict.fromkeys(paths))


def require_committed_result(worktree: Path, task_id: str, head_sha: str) -> str:
    rel = (LOOP_DIR / "results" / task_id / "result.md").as_posix()
    ref = f"{head_sha}:{rel}"
    try:
        committed = git_show(worktree, ref)
    except HLoopError as exc:
        disk_path = worktree / rel
        if disk_path.exists():
            raise HLoopError(
                "result artifact exists on disk but is not committed at worker HEAD: "
                f"{rel}. Ask Worker {task_id} to commit the result artifact in `{worktree}` "
                f"and rerun `hloop worker harvest {task_id}`."
            ) from exc
        raise
    disk = read_text(worktree / rel)
    if committed != disk:
        raise HLoopError(f"result artifact differs between worktree and committed HEAD: {rel}")
    return rel


def result_validation_recorded(meta: dict[str, Any]) -> bool:
    return normalize_bool(meta.get("validation_recorded"))


def worker_validation_error(
    meta: dict[str, Any],
    *,
    require_recorded: bool = False,
    require_passing: bool = False,
) -> str:
    """Return a fail-closed error for one Worker validation record."""

    recorded = result_validation_recorded(meta)
    commands = normalize_list(meta.get("validation_commands"))
    results = normalize_list(meta.get("validation_results"))
    if not recorded:
        if commands or results:
            return "validation evidence is present while validation_recorded is false"
        return "validation is not recorded" if require_recorded else ""
    if not commands or not results:
        return "validation_recorded requires non-empty commands and results"
    if len(commands) != len(results):
        return "validation command and result counts do not match"
    invalid = [result for result in results if result not in WORKER_VALIDATION_RESULTS]
    if invalid:
        return "unsupported validation result(s): " + ", ".join(invalid)
    if require_passing:
        non_passing = [result for result in results if result != "passed"]
        if non_passing:
            return "validation did not pass: " + ", ".join(non_passing)
    return ""


def escape_literal_brackets(pattern: str) -> str:
    pieces = []
    for char in pattern:
        if char == "[":
            pieces.append("[[]")
        elif char == "]":
            pieces.append("[]]")
        else:
            pieces.append(char)
    return "".join(pieces)


def normalize_match_path(value: str) -> str:
    value = str(value)
    if os.sep == "\\":
        value = value.replace("\\", "/")
    if value.startswith("./"):
        return value[2:]
    return value


def path_matches_pattern(path: str, pattern: str) -> bool:
    normalized_path = normalize_match_path(path)
    normalized_pattern = normalize_match_path(pattern)
    if fnmatch.fnmatchcase(normalized_path, normalized_pattern):
        return True
    escaped_pattern = escape_literal_brackets(normalized_pattern)
    return escaped_pattern != normalized_pattern and fnmatch.fnmatchcase(
        normalized_path,
        escaped_pattern,
    )


def matches_any(path: str, patterns: list[str]) -> bool:
    return any(path_matches_pattern(path, pattern) for pattern in patterns)


def validate_change_scope(task_id: str, task_meta: dict[str, Any], files: list[str]) -> list[str]:
    allow = normalize_list(task_meta.get("write_allow"))
    deny = normalize_list(task_meta.get("write_deny"))
    result_pattern = f"{LOOP_DIR.as_posix()}/results/{task_id}/**"
    violations = []
    for path in files:
        allowed = matches_any(path, allow) or path_matches_pattern(path, result_pattern)
        denied = matches_any(path, deny)
        if not allowed or denied:
            suffix = "denied" if denied else "not allowed"
            violations.append(f"{path} ({suffix})")
    return violations


def porcelain_paths(repo: Path) -> list[str]:
    out = git_bytes(
        repo,
        [
            "status",
            "--porcelain=v1",
            "-z",
            "--untracked-files=all",
            "--no-renames",
        ],
        check=True,
    )
    return [paths[0] for _, paths in parse_porcelain_v1_z_records(out)]


def parse_porcelain_paths(text: str) -> list[str]:
    paths = []
    for line in text.splitlines():
        if not line:
            continue
        path = line[3:] if len(line) > 3 else ""
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        if path:
            paths.append(path)
    return paths


def parse_porcelain_v1_z_records(data: bytes) -> list[tuple[str, tuple[str, ...]]]:
    """Parse ``git status --porcelain=v1 -z`` without C-style path quoting."""

    fields = split_nul_records(data, command="git status --porcelain=v1 -z")
    records: list[tuple[str, tuple[str, ...]]] = []
    index = 0
    while index < len(fields):
        primary = fields[index]
        index += 1
        if len(primary) < 4 or primary[2:3] != b" ":
            raise HLoopError("git status --porcelain=v1 -z returned a malformed record")
        try:
            status = primary[:2].decode("ascii")
        except UnicodeDecodeError as exc:
            raise HLoopError("git status --porcelain=v1 -z returned a non-ASCII status") from exc
        paths = [git_path_from_bytes(primary[3:])]
        if "R" in status or "C" in status:
            if index >= len(fields):
                raise HLoopError("git status --porcelain=v1 -z omitted a rename source")
            paths.append(git_path_from_bytes(fields[index]))
            index += 1
        if any(not path for path in paths):
            raise HLoopError("git status --porcelain=v1 -z returned an empty path")
        records.append((status, tuple(paths)))
    return records


def porcelain_paths_no_renames(repo: Path) -> list[str]:
    """Unstaged/untracked paths (tracked modified/deleted, untracked) with rename detection off.

    `porcelain_paths` collapses a rename to only its destination path, which
    would let an out-of-scope source path escape write-scope validation.
    Passing ``--no-renames`` makes Git report the source and destination as
    independent delete/add lines instead, so both sides are checked. Only the
    worktree-status column is consulted, so a path that is fully staged (and
    therefore clean in the worktree) does not keep showing up as "still
    dirty" after `git add` -- callers that need staged names use
    `cached_diff_paths_no_renames` instead.
    """

    out = git_bytes(
        repo,
        ["status", "--porcelain=v1", "-z", "--untracked-files=all", "--no-renames"],
        check=True,
    )
    return [paths[0] for status, paths in parse_porcelain_v1_z_records(out) if status[1] != " "]


def porcelain_paths_all_no_renames(repo: Path) -> list[str]:
    """All staged, unstaged, and untracked paths with both rename sides visible."""

    out = git_bytes(
        repo,
        ["status", "--porcelain=v1", "-z", "--untracked-files=all", "--no-renames"],
        check=True,
    )
    return [paths[0] for _, paths in parse_porcelain_v1_z_records(out)]


def role_scope_paths(repo: Path) -> list[str]:
    """Return one canonical path representation for role baselines and gates.

    Role worktrees permit only their prompt and artifact paths.  Rename
    detection must stay disabled at both baseline capture and harvest so an
    out-of-scope source cannot disappear behind an allowed destination.
    """

    return porcelain_paths(repo)


def cached_diff_paths_no_renames(repo: Path) -> list[str]:
    out = git_bytes(
        repo,
        ["diff", "--cached", "--no-renames", "--name-status", "-z"],
        check=True,
    )
    return parse_changed_files_name_status_z(out)


def porcelain_paths_for(repo: Path, pathspec: str) -> list[str]:
    out = git_bytes(
        repo,
        ["status", "--porcelain=v1", "-z", "--untracked-files=all", "--", pathspec],
        check=True,
    )
    return [paths[0] for _, paths in parse_porcelain_v1_z_records(out)]


def unsafe_dirty_paths(repo: Path, *, allow_loop_dirty: bool = True) -> list[str]:
    paths = porcelain_paths_all_no_renames(repo)
    if not allow_loop_dirty:
        return paths
    loop_home = LOOP_HOME.as_posix()
    loop_prefix = f"{loop_home}/"
    legacy_root = LEGACY_LOOP_DIR.as_posix()
    legacy_prefix = legacy_root + "/"
    return [
        path
        for path in paths
        if path != loop_home
        and not path.startswith(loop_prefix)
        and path != legacy_root
        and not path.startswith(legacy_prefix)
    ]


def active_preflight_environment_block(state: dict[str, Any]) -> bool:
    error = state.get("last_preflight_error")
    return (
        str(state.get("phase") or "") == "blocked_environment"
        and isinstance(error, dict)
        and error.get("source") == "preflight"
        and not error.get("resolved_at")
    )


def mark_blocked_environment(repo: Path, state: dict[str, Any], reason: str) -> None:
    previous_error = state.get("last_preflight_error")
    previous_phase = str(state.get("phase") or "dispatching")
    if active_preflight_environment_block(state) and isinstance(previous_error, dict):
        previous_phase = str(previous_error.get("previous_phase") or "dispatching")
    state["phase"] = "blocked_environment"
    state["last_preflight_error"] = {
        "at": now_iso(),
        "reason": reason,
        "source": "preflight",
        "previous_phase": previous_phase,
    }
    save_state(repo, state)
    journal(repo, f"Blocked by preflight: {reason}")


def recover_preflight_environment_block(repo: Path, state: dict[str, Any]) -> bool:
    if not active_preflight_environment_block(state):
        return False
    error = state["last_preflight_error"]
    recovered_phase = str(error.get("previous_phase") or "dispatching")
    state["phase"] = recovered_phase
    error["resolved_at"] = now_iso()
    error["resolved_phase"] = recovered_phase
    save_state(repo, state)
    journal(repo, f"Recovered preflight environment blocker; restored phase `{recovered_phase}`.")
    return True


def preflight_loop(
    repo: Path,
    *,
    require_herdr: bool = False,
    require_codex: bool = False,
    require_agent_provider: str | None = None,
    require_agent_invocation: hloop_providers.ProviderInvocation | None = None,
    require_integration_branch: bool = False,
    allow_loop_dirty: bool = True,
    skip_dirty_check: bool = False,
    mark_blocked: bool = True,
) -> dict[str, Any]:
    state = load_state(repo)

    def fail(reason: str, *, persist: bool = True) -> None:
        if mark_blocked and persist:
            mark_blocked_environment(repo, state, reason)
        raise HLoopError(reason)

    try:
        state_schema = schema_version_of(state)
    except MigrationError as exc:
        fail(f"invalid state schema marker: {exc}", persist=False)
        raise AssertionError("unreachable")
    if state_schema < RUNTIME_SCHEMA_VERSION:
        fail(
            f"state migration required: {state_schema.label()} "
            f"runtime={RUNTIME_SCHEMA_VERSION.label()}; run `hloop migrate --dry-run` "
            "then `hloop migrate --apply`"
        )
    if state_schema > RUNTIME_SCHEMA_VERSION:
        fail(
            f"state {state_schema.label()} is newer than runtime "
            f"{RUNTIME_SCHEMA_VERSION.label()}; mutating commands are disabled",
            persist=False,
        )

    if not command_exists("git"):
        fail("git command not found")
    recorded_identity = state.get("git_identity")
    if isinstance(recorded_identity, dict) and recorded_identity:
        try:
            current_identity = resolve_git_binary_fingerprint()
        except HLoopError as exc:
            fail(f"git identity probe failed: {exc}")
            raise AssertionError("unreachable")
        drift = git_identity_drift(recorded_identity, current_identity)
        if drift:
            fail(
                "git executable identity drift detected: "
                f"{drift}; run `hloop runtime trust-git --reason <text>` to accept it"
            )
    elif mark_blocked:
        # Legacy STATE created before identity tracking existed: record the
        # currently-trusted executable instead of retroactively blocking.
        state["git_identity"] = git_executable_identity()
    if require_herdr:
        if os.environ.get("HERDR_ENV") != "1":
            fail("HERDR_ENV=1 is required")
        if not command_exists("herdr"):
            fail("herdr command not found")
        try:
            state["last_storage_preflight"] = {
                "at": now_iso(),
                "filesystems": storage_preflight(repo, state),
            }
        except HLoopError as exc:
            fail(str(exc))
    if require_codex and not command_exists("codex"):
        fail("codex command not found")
    if require_agent_invocation is not None:
        # Probe the exact role invocation the caller is about to launch (same
        # runner/model/effort/permission/sandbox/argv), so preflight evidence
        # and `last_provider_preflight.argv` describe the real launch, not a
        # generic stand-in that can pass while the real configuration cannot.
        capability = hloop_providers.probe_provider_capability(require_agent_invocation)
        state["last_provider_preflight"] = {
            "at": now_iso(),
            **capability.as_record(),
        }
        if not capability.launch_allowed:
            fail(capability.reason)
    elif require_agent_provider:
        provider = normalize_agent_provider(require_agent_provider)
        invocation = hloop_providers.build_provider_invocation(
            provider=provider,
            runner="tui",
            sandbox="workspace-write",
            prompt_path=repo / LOOP_DIR / "prompts" / "_preflight-probe.md",
        )
        capability = hloop_providers.probe_provider_capability(invocation)
        state["last_provider_preflight"] = {
            "at": now_iso(),
            **capability.as_record(),
        }
        if not capability.launch_allowed:
            fail(capability.reason)
    if require_integration_branch:
        expected = str(state.get("integration_branch") or "")
        actual = current_branch(repo)
        if not expected:
            fail("integration_branch is missing from STATE.json")
        if actual != expected:
            fail(f"current branch must be integration branch {expected}; currently {actual}")
    if not skip_dirty_check:
        # A content-conflict or environment-failure merge transaction leaves the
        # working tree intentionally dirty (conflict markers, a partial squash
        # index).  Callers recovering an active transaction skip this blanket
        # check and rely on the transaction-aware preflight instead.
        dirty = unsafe_dirty_paths(repo, allow_loop_dirty=allow_loop_dirty)
        if dirty:
            fail("working tree has non-loop dirty files: " + ", ".join(dirty))
    if mark_blocked:
        recover_preflight_environment_block(repo, state)
    return state


def make_issue(
    severity: str,
    code: str,
    subject: str,
    message: str,
    action: str = "",
) -> dict[str, str]:
    return {
        "severity": severity,
        "code": code,
        "subject": subject,
        "message": message,
        "action": action,
    }


def issue_sort_key(item: dict[str, Any]) -> tuple[int, str, str]:
    return (
        ISSUE_SEVERITY_RANK.get(str(item.get("severity") or "P3"), 3),
        str(item.get("subject") or ""),
        str(item.get("code") or ""),
    )


def safe_current_branch(repo: Path) -> str:
    try:
        return current_branch(repo)
    except HLoopError:
        return ""


def safe_short_sha(repo: Path, ref: str) -> str:
    if not ref:
        return ""
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "rev-parse", "--short", ref], check=False)
    if proc.returncode != 0:
        return ""
    return (proc.stdout or "").strip()


def safe_porcelain_paths(repo: Path) -> list[str]:
    try:
        return porcelain_paths(repo)
    except HLoopError:
        return []


def safe_frontmatter(path: Path) -> tuple[dict[str, Any], str]:
    if not path.exists():
        return {}, "missing"
    try:
        text = read_text(path)
    except HLoopError as exc:
        return {}, f"read-error:{exc}"
    if not text.strip():
        return {}, "empty"
    try:
        return parse_frontmatter_text(text), "present"
    except HLoopError as exc:
        return {}, f"frontmatter-error:{exc}"


def safe_result_commit_state(worktree: Path, task_id: str, head_sha: str) -> str:
    rel = (LOOP_DIR / "results" / task_id / "result.md").as_posix()
    disk_path = worktree / rel
    if not disk_path.exists():
        return "missing"
    resolved_head = head_sha
    if not resolved_head or resolved_head == "HEAD":
        proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(worktree), "rev-parse", "HEAD"], check=False)
        if proc.returncode != 0:
            return "head-unreadable"
        resolved_head = (proc.stdout or "").strip()
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(worktree), "show", f"{resolved_head}:{rel}"], check=False)
    if proc.returncode != 0:
        return "not-committed"
    try:
        disk = read_text(disk_path)
    except HLoopError:
        return "disk-unreadable"
    return "committed" if (proc.stdout or "") == disk else "mismatch"


def pane_marker(role: str, agent_id: str) -> str:
    if role == "worker":
        return f"HERDR_LOOP_TASK_DONE:{agent_id}:"
    if role == "reviewer":
        return f"HERDR_LOOP_REVIEW_DONE:{agent_id}:"
    if role == "gap":
        return f"HERDR_LOOP_GAP_DONE:{agent_id}:"
    if role == "advisor":
        advice_id, participant_id = split_advice_target(agent_id)
        return f"HERDR_LOOP_ADVICE_DONE:{advice_id}:{participant_id}:"
    return ""


def terminal_status_from_text(
    text: str,
    *,
    run_id: str,
    agent_id: str,
    attempt_id: str,
) -> str:
    pattern = re.compile(
        rf"HERDR_LOOP_ROLE_DONE:{re.escape(run_id)}:{re.escape(agent_id)}:"
        rf"{re.escape(attempt_id)}:(done|reported|aligned|gaps-found|blocked|failed|partial)"
    )
    matches = pattern.findall(text)
    return matches[-1] if matches else ""


def pane_snapshot(
    pane_id: str,
    *,
    role: str,
    agent_id: str,
    lines: int = 80,
    include_output: bool = False,
) -> dict[str, Any]:
    snapshot: dict[str, Any] = {
        "pane_id": pane_id,
        "available": False,
        "present": False,
        "signals": [],
    }
    if not pane_id:
        snapshot["reason"] = "none"
        return snapshot
    if os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        snapshot["reason"] = "not-in-herdr"
        return snapshot
    snapshot["available"] = True
    info = pane_info(pane_id)
    if info is None:
        snapshot["reason"] = "missing-or-closed"
        return snapshot
    snapshot["present"] = True
    snapshot["agent"] = info.get("agent", "")
    snapshot["agent_status"] = info.get("agent_status", "unknown")
    session_id = extract_agent_session_id(info)
    if session_id:
        snapshot["agent_session_id"] = session_id
        snapshot["codex_session_id"] = session_id
    text = pane_text(pane_id, max(1, lines))
    marker = pane_marker(role, agent_id)
    signals: list[str] = []
    if marker and marker in text:
        signals.append("done-marker")
    if "Do you trust the contents of this directory?" in text:
        signals.append("trust-prompt")
    if "Do you trust the files in this folder?" in text:
        signals.append("trust-prompt")
    if "Press enter to continue" in text:
        signals.append("press-enter")
    if "esc to interrupt" in text or "• Working" in text:
        signals.append("working-text")
    if "command not found" in text and "hloop" in text:
        signals.append("hloop-command-not-found")
    if contains_dangerous_agent_marker(text):
        signals.append("dangerous-agent-command")
    if include_output:
        snapshot["output_tail"] = text
    snapshot["signals"] = signals
    return snapshot


def pane_issue_for_running(
    role: str,
    agent_id: str,
    pane: dict[str, Any],
) -> dict[str, str] | None:
    subject = f"{role}:{agent_id}"
    pane_id = str(pane.get("pane_id") or "")
    watch_cmd = f"hloop {role} watch {agent_id}" if role != "worker" else f"hloop worker watch {agent_id}"
    if pane_id and pane.get("reason") == "not-in-herdr":
        return None
    if pane_id and not pane.get("present"):
        return make_issue(
            "P1",
            "pane-missing",
            subject,
            f"Running {role} has no readable Herdr pane: {pane_id}",
            f"Check artifact/worktree, then harvest or restart {agent_id}.",
        )
    signals = set(normalize_list(pane.get("signals")))
    if "trust-prompt" in signals:
        return make_issue(
            "P1",
            "codex-trust-prompt",
            subject,
            f"{role} pane is waiting at the Codex trust prompt.",
            f"Inspect with `{watch_cmd}` and resolve the trust prompt before continuing.",
        )
    if "dangerous-agent-command" in signals:
        return make_issue(
            "P0",
            "dangerous-agent-command",
            subject,
            f"{role} pane output contains a dangerous Codex launch marker.",
            "Stop this pane and recreate the agent through hloop with workspace-write sandbox.",
        )
    if "press-enter" in signals:
        return make_issue(
            "P2",
            "codex-press-enter",
            subject,
            f"{role} pane appears to be waiting for Enter.",
            f"Inspect with `{watch_cmd}` before sending follow-up instructions.",
        )
    status = str(pane.get("agent_status") or "")
    if status in {"blocked", "error", "failed"}:
        return make_issue(
            "P1",
            "agent-blocked",
            subject,
            f"{role} pane agent_status is `{status}`.",
            f"Inspect with `{watch_cmd}` and send a Manager message or restart if needed.",
        )
    if status in {"idle", "done", "complete"}:
        return make_issue(
            "P2",
            "agent-idle",
            subject,
            f"{role} pane is `{status}` but no artifact has been harvested yet.",
            f"Inspect with `{watch_cmd}` and harvest if the artifact exists.",
        )
    return None


def worktree_state(path_raw: Any) -> dict[str, Any]:
    if not path_raw:
        return {"path": "", "exists": False}
    path = Path(str(path_raw)).resolve()
    return {
        "path": str(path),
        "exists": path.exists(),
        "dirty_files": safe_porcelain_paths(path) if path.exists() else [],
    }


def contains_dangerous_agent_marker(value: Any) -> bool:
    if isinstance(value, dict):
        return any(contains_dangerous_agent_marker(item) for item in value.values())
    if isinstance(value, (list, tuple, set)):
        return any(contains_dangerous_agent_marker(item) for item in value)
    text = str(value or "").lower()
    return any(marker in text for marker in DANGEROUS_AGENT_MARKERS)


def expected_prompt_fragment(role: str, agent_id: str) -> str:
    if role == "advisor":
        advice_id, participant_id = split_advice_target(agent_id)
        return f"{LOOP_DIR.as_posix()}/prompts/{advice_id}-{participant_id}.advisor.md"
    suffix = {"worker": "worker", "reviewer": "reviewer", "gap": "gap"}.get(role, role)
    return f"{LOOP_DIR.as_posix()}/prompts/{agent_id}.{suffix}.md"


def prompt_matches_hloop_contract(role: str, agent_id: str, prompt_raw: Any) -> bool:
    prompt = str(prompt_raw or "").replace("\\", "/")
    return bool(prompt) and expected_prompt_fragment(role, agent_id) in prompt


def path_under_repo_loop_results(repo: Path, path_raw: Any) -> bool:
    if not path_raw:
        return False
    path = Path(str(path_raw))
    if not path.is_absolute():
        path = repo / path
    try:
        resolved = path.resolve()
        results_root = (repo / LOOP_DIR / "results").resolve()
    except OSError:
        return False
    return resolved == results_root or results_root in resolved.parents


def agent_contract_issues(
    repo: Path,
    *,
    role: str,
    agent_id: str,
    agent: dict[str, Any],
) -> list[dict[str, str]]:
    subject = f"{role}:{agent_id}"
    issues: list[dict[str, str]] = []
    status = str(agent.get("status") or "")
    gate_status = agent_gate_status(agent)
    active_status = status in {"running", "result_reported", "reported", "reported_unharvested"} or gate_status in {
        "running",
        "reported",
        "reported_unharvested",
        "paused_untriaged",
    }

    sandbox = str(agent.get("sandbox") or "")
    if sandbox and sandbox != "workspace-write":
        severity = "P0" if contains_dangerous_agent_marker(sandbox) else "P1"
        issues.append(
            make_issue(
                severity,
                "unsafe-agent-sandbox",
                subject,
                f"{role} state records non-standard sandbox `{sandbox}`.",
                "Stop the agent if it is still running; restart through hloop so it uses workspace-write.",
            )
        )

    command_like = {
        key: agent.get(key)
        for key in ("argv", "command", "runner_command", "launch_command", "codex_command")
        if key in agent
    }
    if command_like and contains_dangerous_agent_marker(command_like):
        issues.append(
            make_issue(
                "P0",
                "dangerous-agent-command",
                subject,
                f"{role} state contains a dangerous Codex launch marker.",
                "Stop the pane and recreate the agent with hloop; do not continue from this run.",
            )
        )

    if active_status:
        prompt = str(agent.get("prompt") or "")
        if not prompt:
            issues.append(
                make_issue(
                    "P1",
                    "missing-hloop-prompt",
                    subject,
                    f"{role} is active but STATE.json has no hloop prompt path.",
                    f"Use hloop {role if role != 'reviewer' else 'reviewer'} watch {agent_id}; restart through hloop if the pane was started manually.",
                )
            )
        elif not prompt_matches_hloop_contract(role, agent_id, prompt):
            issues.append(
                make_issue(
                    "P1",
                    "non-hloop-prompt",
                    subject,
                    f"{role} prompt path does not match the hloop prompt contract: {prompt}",
                    "Treat this as a suspected manual launch; harvest only if the artifact passes hloop validation, otherwise restart.",
                )
            )

    state_fragments = [
        str(agent.get("status") or ""),
        str(agent.get("gate_status") or ""),
        str(agent.get("artifact_status") or ""),
    ]
    if any("unharvested" in fragment for fragment in state_fragments):
        issues.append(
            make_issue(
                "P1",
                "unharvested-artifact-state",
                subject,
                f"{role} state records an unharvested artifact.",
                f"Run the matching hloop harvest command or keep the loop paused until Manager intentionally resumes.",
            )
        )

    if role == "worker":
        head_sha = str(agent.get("head_sha") or "").lower()
        if head_sha in SUSPICIOUS_WORKER_HEADS:
            issues.append(
                make_issue(
                    "P1",
                    "untrusted-worker-head",
                    subject,
                    f"Worker result uses non-commit head marker `{agent.get('head_sha')}`.",
                    "Do not merge this task; rerun the Worker or record an environment blocker.",
                )
            )
        integration_method = str(agent.get("integration_method") or "")
        if "manual" in integration_method or integration_method.startswith("manager_"):
            issues.append(
                make_issue(
                    "P1",
                    "manual-worker-integration",
                    subject,
                    f"Worker state records manual integration method `{integration_method}`.",
                    "Review this task before trusting final loop status; prefer hloop merge for future tasks.",
                )
            )
        if normalize_bool(agent.get("merge_ready")) and not agent.get("committed_result_path"):
            issues.append(
                make_issue(
                    "P1",
                    "merge-ready-without-committed-result",
                    subject,
                    "Worker is merge-ready but STATE.json has no committed_result_path.",
                    "Run hloop worker harvest again; do not merge until the result is committed at branch HEAD.",
                )
            )
        if (
            not artifact_was_harvested(agent)
            and path_under_repo_loop_results(repo, agent.get("result_path"))
            and str(agent.get("worktree") or "")
        ):
            issues.append(
                make_issue(
                    "P1",
                    "manager-owned-worker-result",
                    subject,
                    f"Worker result_path points at the Manager repo: {agent.get('result_path')}",
                    "Treat this as a suspected Manager-edited result; rerun or re-harvest from the Worker worktree.",
                )
            )
    return issues


def artifact_location_status(
    agent: dict[str, Any], artifact_path: Path, worktree: dict[str, Any]
) -> str:
    if not artifact_was_harvested(agent):
        return "active-worktree"
    if not artifact_path.is_file():
        return "unexpectedly-missing"
    if not worktree.get("exists") or normalize_bool(agent.get("cleanup_done")) or str(
        agent.get("worktree_cleanup_status") or ""
    ) == "removed":
        return "cleaned-after-harvest"
    return "harvested-manager"


def collect_worker_inventory(
    repo: Path,
    state: dict[str, Any],
    task_id: str,
    task: dict[str, Any],
    *,
    probe_panes: bool,
    lines: int,
    include_output: bool,
) -> dict[str, Any]:
    status = str(task.get("status") or "")
    branch = str(task.get("branch") or "")
    worktree_raw = task.get("worktree") or (
        str(default_worktree(repo, task_id, state)) if status in {"running", "result_reported"} else ""
    )
    worktree = worktree_state(worktree_raw)
    artifact_path = worker_artifact_path(repo, state, task_id, task)
    artifact_meta, artifact_state = safe_frontmatter(artifact_path)
    location_status = artifact_location_status(task, artifact_path, worktree)
    artifact: dict[str, Any] = {
        "path": str(artifact_path),
        "state": artifact_state,
        "location_status": location_status,
        "exists": artifact_state == "present",
        "status": str(artifact_meta.get("status") or task.get("result_status") or ""),
        "merge_ready": normalize_bool(artifact_meta.get("merge_ready", task.get("merge_ready"))),
        "validation_recorded": normalize_bool(
            artifact_meta.get("validation_recorded", task.get("validation_recorded"))
        ),
        "committed_path": str(task.get("committed_result_path") or ""),
    }
    if not artifact_was_harvested(task) and worktree["exists"] and artifact["exists"]:
        artifact["commit_state"] = safe_result_commit_state(
            Path(worktree["path"]),
            task_id,
            str(artifact_meta.get("head_sha") or task.get("head_sha") or "HEAD"),
        )
    elif artifact_was_harvested(task) and task.get("committed_result_path"):
        artifact["commit_state"] = "verified-at-harvest"
    artifact_ready_now, readiness_reason = artifact_readiness(
        repo, state, task_id, "worker", task, artifact_path
    )
    artifact["ready"] = artifact_ready_now
    artifact["readiness_reason"] = readiness_reason
    pane_id = str(task.get("pane_id") or "")
    pane = (
        pane_snapshot(
            pane_id,
            role="worker",
            agent_id=task_id,
            lines=lines,
            include_output=include_output,
        )
        if probe_panes and status == "running" and pane_id
        else {"pane_id": pane_id, "available": False, "present": False, "reason": "not-probed"}
    )
    issues: list[dict[str, str]] = []
    issues.extend(agent_contract_issues(repo, role="worker", agent_id=task_id, agent=task))
    if location_status == "unexpectedly-missing":
        issues.append(
            make_issue(
                "P1",
                "worker-artifact-unexpectedly-missing",
                f"worker:{task_id}",
                "Harvested Worker artifact is missing from the Manager loop path.",
                f"Re-harvest {task_id} from its immutable Worker head before relying on completion evidence.",
            )
        )
    if status == "running":
        if artifact["ready"]:
            issues.append(
                make_issue(
                    "P2",
                    "worker-result-ready",
                    f"worker:{task_id}",
                    f"Worker result artifact exists for running task {task_id}.",
                    f"hloop worker harvest {task_id}",
                )
            )
        elif artifact["readiness_reason"] == "seal-required":
            issues.append(
                make_issue(
                    "P1",
                    "worker-seal-required",
                    f"worker:{task_id}",
                    f"Worker {task_id} left a valid uncommitted handoff awaiting Manager seal.",
                    seal_required_action_text(task_id),
                )
            )
        else:
            pane_issue = pane_issue_for_running("worker", task_id, pane)
            if pane_issue:
                issues.append(pane_issue)
    if status == "result_reported":
        if artifact.get("commit_state") in {"not-committed", "mismatch"}:
            issues.append(
                make_issue(
                    "P1",
                    "worker-result-not-committed",
                    f"worker:{task_id}",
                    f"Worker result commit state is `{artifact.get('commit_state')}`.",
                    f"Ask Worker {task_id} to commit the result artifact before merge.",
                )
            )
        elif artifact["merge_ready"]:
            issues.append(
                make_issue(
                    "P2",
                    "worker-merge-ready",
                    f"worker:{task_id}",
                    f"Worker {task_id} is merge-ready.",
                    f"hloop merge {task_id}",
                )
            )
        else:
            issues.append(
                make_issue(
                    "P1",
                    "worker-result-not-merge-ready",
                    f"worker:{task_id}",
                    f"Worker {task_id} reported a result that is not merge-ready.",
                    "Create a fix task, rerun the Worker, or record the blocker.",
                )
            )
    if status in {"partial", "blocked", "failed", "abandoned"}:
        issues.append(
            make_issue(
                "P1",
                "worker-terminal-not-merged",
                f"worker:{task_id}",
                f"Worker {task_id} ended with status `{status}`.",
                "Create a fix task, rerun the Worker, or record the blocker.",
            )
        )
    return {
        "id": task_id,
        "role": "worker",
        "status": status,
        "branch": branch,
        "branch_exists": branch_exists(repo, branch) if branch else False,
        "worktree": worktree,
        "pane": pane,
        "artifact": artifact,
        "merge_ready": normalize_bool(task.get("merge_ready")),
        "validation_recorded": normalize_bool(task.get("validation_recorded")),
        "cleanup_done": normalize_bool(task.get("cleanup_done")),
        "issues": issues,
    }


def collect_gate_inventory(
    repo: Path,
    state: dict[str, Any],
    agent_id: str,
    agent: dict[str, Any],
    *,
    role: str,
    probe_panes: bool,
    lines: int,
    include_output: bool,
) -> dict[str, Any]:
    status = str(agent.get("status") or "")
    gate_status = agent_gate_status(agent)
    artifact_path = (
        review_artifact_path(repo, agent_id, agent)
        if role == "reviewer"
        else gap_artifact_path(repo, agent_id, agent)
    )
    worktree = worktree_state(agent.get("worktree"))
    location_status = artifact_location_status(agent, artifact_path, worktree)
    artifact_meta, artifact_state = safe_frontmatter(artifact_path)
    artifact_ready_now, readiness_reason = artifact_readiness(
        repo, state, agent_id, role, agent, artifact_path
    )
    pane_id = str(agent.get("pane_id") or "")
    pane = (
        pane_snapshot(
            pane_id,
            role=role,
            agent_id=agent_id,
            lines=lines,
            include_output=include_output,
        )
        if probe_panes and gate_status == "running" and pane_id
        else {"pane_id": pane_id, "available": False, "present": False, "reason": "not-probed"}
    )
    issues: list[dict[str, str]] = []
    issues.extend(agent_contract_issues(repo, role=role, agent_id=agent_id, agent=agent))
    if location_status == "unexpectedly-missing":
        issues.append(
            make_issue(
                "P1",
                f"{role}-artifact-unexpectedly-missing",
                f"{role}:{agent_id}",
                f"Harvested {role} artifact is missing from the Manager loop path.",
                "Restore or re-harvest the canonical Manager artifact before closing the gate.",
            )
        )
    gate_name = "review" if role == "reviewer" else "gap"
    if gate_status == "running":
        if artifact_ready_now:
            issues.append(
                make_issue(
                    "P2",
                    f"{gate_name}-artifact-ready",
                    f"{role}:{agent_id}",
                    f"{role} artifact exists and can be harvested.",
                    f"hloop {gate_name if role == 'gap' else 'reviewer'} harvest {agent_id}",
                )
            )
        else:
            pane_issue = pane_issue_for_running(role, agent_id, pane)
            if pane_issue:
                issues.append(pane_issue)
    if gate_status == "reported":
        issues.append(
            make_issue(
                "P1",
                f"{gate_name}-triage-required",
                f"{role}:{agent_id}",
                f"{role} {agent_id} has been harvested and needs Manager triage.",
                f"hloop triage {gate_name} {agent_id}",
            )
        )
    if gate_status == "blocked_write_scope":
        issues.append(
            make_issue(
                "P1",
                f"{gate_name}-write-scope-violation",
                f"{role}:{agent_id}",
                f"{role} {agent_id} changed files outside its artifact.",
                "Inspect USER_ACTION_REQUIRED.md and the detached worktree before closing the gate.",
            )
        )
    return {
        "id": agent_id,
        "role": role,
        "status": status,
        "gate_status": gate_status,
        "artifact_status": str(agent.get("artifact_status") or artifact_meta.get("status") or ""),
        "base": str(agent.get("base") or ""),
        "head": str(agent.get("head") or ""),
        "worktree": worktree,
        "pane": pane,
        "artifact": {
            "path": str(artifact_path),
            "state": artifact_state,
            "location_status": location_status,
            "exists": artifact_state == "present",
            "ready": artifact_ready_now,
            "readiness_reason": readiness_reason,
            "frontmatter": artifact_meta,
        },
        "issues": issues,
    }


def collect_advice_inventory(
    repo: Path,
    state: dict[str, Any],
    advice_id: str,
    advice: dict[str, Any],
    *,
    probe_panes: bool,
    lines: int,
    include_output: bool,
) -> list[dict[str, Any]]:
    items = []
    for participant in advice.get("participants", []):
        participant_id = str(participant.get("participant_id") or "P1")
        combined_id = f"{advice_id}/{participant_id}"
        status = str(participant.get("status") or "")
        gate_status = agent_gate_status(participant)
        artifact_path = advice_artifact_path(repo, advice_id, participant)
        participant_worktree = worktree_state(participant.get("worktree"))
        location_status = artifact_location_status(
            participant, artifact_path, participant_worktree
        )
        artifact_meta, artifact_state = safe_frontmatter(artifact_path)
        artifact_ready_now, readiness_reason = artifact_readiness(
            repo, state, combined_id, "advisor", participant, artifact_path
        )
        pane_id = str(participant.get("pane_id") or "")
        pane = (
            pane_snapshot(
                pane_id,
                role="advisor",
                agent_id=combined_id,
                lines=lines,
                include_output=include_output,
            )
            if probe_panes and gate_status == "running" and pane_id
            else {"pane_id": pane_id, "available": False, "present": False, "reason": "not-probed"}
        )
        issues: list[dict[str, str]] = []
        issues.extend(agent_contract_issues(repo, role="advisor", agent_id=combined_id, agent=participant))
        if location_status == "unexpectedly-missing":
            issues.append(
                make_issue(
                    "P1",
                    "advisor-artifact-unexpectedly-missing",
                    f"advisor:{combined_id}",
                    "Harvested Advisor artifact is missing from the Manager loop path.",
                    "Restore or re-harvest the canonical Manager artifact before closing the request.",
                )
            )
        if gate_status == "running":
            if artifact_ready_now:
                issues.append(
                    make_issue(
                        "P2",
                        "advisor-artifact-ready",
                        f"advisor:{combined_id}",
                        f"Advisor artifact exists and can be harvested.",
                        f"hloop harvest {combined_id}",
                    )
                )
            else:
                pane_issue = pane_issue_for_running("advisor", combined_id, pane)
                if pane_issue:
                    issues.append(pane_issue)
        if gate_status == "reported":
            issues.append(
                make_issue(
                    "P2",
                    "advisor-manager-review-required",
                    f"advisor:{combined_id}",
                    f"Advisor {combined_id} has been harvested and needs Manager review.",
                    f"hloop advisor close {advice_id} --verdict <verdict> --reason ...",
                )
            )
        items.append(
            {
                "id": combined_id,
                "role": "advisor",
                "status": status,
                "gate_status": gate_status,
                "artifact_status": str(participant.get("artifact_status") or artifact_meta.get("status") or ""),
                "provider": str(participant.get("agent_provider") or participant.get("provider") or ""),
                "model": str(participant.get("agent_model") or participant.get("model") or ""),
                "topic": str(advice.get("topic") or ""),
                "worktree": participant_worktree,
                "pane": pane,
                "artifact": {
                    "path": str(artifact_path),
                    "state": artifact_state,
                    "location_status": location_status,
                    "exists": artifact_state == "present",
                    "ready": artifact_ready_now,
                    "readiness_reason": readiness_reason,
                    "frontmatter": artifact_meta,
                },
                "issues": issues,
            }
        )
    return items


def decision_records_from_state(state: dict[str, Any]) -> dict[str, DecisionRecord]:
    """Parse ``state["decisions"]`` into validated records, skipping bad entries.

    Malformed records must never crash dashboard/status reporting; they are
    dropped from the returned mapping (the raw dict is still visible via
    ``hloop decision list`` / ``STATE.json`` for debugging).
    """

    records: dict[str, DecisionRecord] = {}
    for decision_id, raw in (state.get("decisions") or {}).items():
        try:
            record = DecisionRecord.from_record(raw)
        except DecisionValidationError:
            continue
        records[decision_id] = record
    return records


def pending_blocking_user_decisions(state: dict[str, Any]) -> dict[str, DecisionRecord]:
    """Unresolved ``blocking-user`` decisions, keyed by decision id."""

    return {
        decision_id: record
        for decision_id, record in decision_records_from_state(state).items()
        if record.blocks_affected_tasks
    }


def build_decision_scheduler(state: dict[str, Any]) -> "hloop_decisions.SchedulerDecision":
    """Evaluate decision-aware, partial-blocking dispatch for the current state.

    ``loop_blocked`` is only true when every queued task is blocked by a
    pending/answered ``blocking-user`` decision and no other safe work
    (running/reported tasks, in-flight review or gap agents, a merge-ready
    task, or pending validation) is available to the Manager.
    """

    tasks_map = state.get("tasks") or {}
    decisions_map = state.get("decisions") or {}
    safe_work_remaining = bool(
        running_review_exists(state)
        or running_gap_exists(state)
        or pending_review_exists(state)
        or pending_gap_exists(state)
        or state.get("needs_validation")
        or any(
            task.get("status") == "result_reported" and task.get("merge_ready")
            for task in tasks_map.values()
        )
    )
    try:
        return decision_aware_dispatch(
            tasks_map, decisions_map, safe_work_remaining=safe_work_remaining
        )
    except (DecisionValidationError, DecisionTransitionError) as exc:
        raise HLoopError(f"invalid decision state: {exc}") from exc


def collect_loop_inventory(
    repo: Path,
    *,
    probe_panes: bool = True,
    lines: int = 80,
    include_output: bool = False,
) -> dict[str, Any]:
    state = load_state(repo)
    current = safe_current_branch(repo)
    integration = str(state.get("integration_branch") or "")
    base = str(state.get("base_branch") or "")
    unsafe_dirty = unsafe_dirty_paths(repo, allow_loop_dirty=True)
    issues: list[dict[str, str]] = []
    if unsafe_dirty:
        issues.append(
            make_issue(
                "P1",
                "non-loop-dirty-files",
                "repo",
                "Working tree has non-loop dirty files: " + ", ".join(unsafe_dirty),
                "Commit/stash/revert unrelated files before mutating the loop.",
            )
        )
    if integration and current and current != integration:
        issues.append(
            make_issue(
                "P1",
                "integration-branch-mismatch",
                "repo",
                f"Current branch is `{current}`, expected integration branch `{integration}`.",
                f"git switch {integration}",
            )
        )
    pending_blocking_decisions = pending_blocking_user_decisions(state)
    if pending_blocking_decisions:
        affected = sorted(
            {
                task_id
                for record in pending_blocking_decisions.values()
                for task_id in record.affected_task_ids
            }
        )
        issues.append(
            make_issue(
                "P1",
                "blocking-decisions",
                "state",
                (
                    f"STATE.json has {len(pending_blocking_decisions)} pending "
                    "blocking-user decision(s) "
                    f"({', '.join(sorted(pending_blocking_decisions))}) affecting "
                    f"task(s) {', '.join(affected) if affected else '(none)'}."
                ),
                "Respond with `hloop decision respond` and resolve with "
                "`hloop decision resolve` before dispatching affected tasks.",
            )
        )
    phase = str(state.get("phase") or "")
    if phase in {"blocked_user_decision", "blocked_environment", "blocked_conflict", "failed_validation", "failed_manager_qa", "no_progress"}:
        issues.append(
            make_issue(
                "P1",
                "blocked-phase",
                "state",
                f"Loop phase is `{phase}`.",
                "Inspect JOURNAL.md, USER_ACTION_REQUIRED.md, and hloop dashboard output.",
            )
        )
    integration_target = current_integration_target(repo, state)
    final_target = str(state.get("final_target_sha") or "")
    drift = diagnose_done_target_drift(
        phase=phase,
        final_target_sha=final_target,
        current_target_sha=integration_target,
        commit_count=advancing_commit_count(repo, final_target, integration_target),
    )
    if drift is not None:
        issues.append(
            make_issue(
                str(drift.severity),
                str(drift.code),
                "completion-target",
                str(drift.message),
                "Start a new run or explicitly supersede the completed run; do not reuse stale evidence.",
            )
        )
    final_gate = final_gate_from_state(state)
    if isinstance(state.get("final_gate"), dict) and final_gate is None:
        issues.append(
            make_issue(
                "P1",
                "final-gates-record-invalid",
                "final-gates",
                "STATE.json contains an invalid final gate record.",
                "Inspect the migration and final-gates history before finishing.",
            )
        )
    elif final_gate is not None:
        for item in validate_final_gate_arm(
            final_gate, current_target_sha=integration_target
        ).issues:
            issues.append(
                make_issue(
                    "P1",
                    item.code,
                    item.subject or "final-gates",
                    item.message,
                    "Create or finish the new task, then arm final gates again for the current target.",
                )
            )
    resume_requirements = lifecycle_resume_requirements(repo, state) if phase == "paused" else []
    for item in resume_requirements:
        issues.append(
            make_issue(
                "P1",
                f"resume-{item['code']}",
                item["subject"] or "resume",
                item["reason"],
                "Refresh the named gate or resolve the blocker before `hloop resume`.",
            )
        )
    workers = [
        collect_worker_inventory(
            repo,
            state,
            task_id,
            task,
            probe_panes=probe_panes,
            lines=lines,
            include_output=include_output,
        )
        for task_id, task in state.get("tasks", {}).items()
    ]
    reviewers = [
        collect_gate_inventory(
            repo,
            state,
            review_id,
            review,
            role="reviewer",
            probe_panes=probe_panes,
            lines=lines,
            include_output=include_output,
        )
        for review_id, review in state.get("reviews", {}).items()
    ]
    gaps = [
        collect_gate_inventory(
            repo,
            state,
            gap_id,
            gap,
            role="gap",
            probe_panes=probe_panes,
            lines=lines,
            include_output=include_output,
        )
        for gap_id, gap in state.get("gaps", {}).items()
    ]
    advisors = []
    for advice_id, advice in state.get("advice", {}).items():
        if isinstance(advice, dict):
            advisors.extend(
                collect_advice_inventory(
                    repo,
                    state,
                    advice_id,
                    advice,
                    probe_panes=probe_panes,
                    lines=lines,
                    include_output=include_output,
                )
            )
    for collection in (workers, reviewers, gaps, advisors):
        for item in collection:
            issues.extend(item.get("issues", []))
    issues = sorted(issues, key=issue_sort_key)
    next_actions = []
    dispatch_frozen = dispatch_is_frozen(state)
    release_scope = release_scope_from_state(state)

    def add_next_action(action: str) -> None:
        if dispatch_frozen and any(
            token in action
            for token in (
                "hloop worker start",
                "hloop reviewer start",
                "hloop gap start",
                "hloop advisor start",
                "hloop specification-scout start",
                "Decision Liaison",
            )
        ):
            return
        if action and action not in next_actions:
            next_actions.append(action)

    if phase not in RUN_TERMINAL_PHASES:
        for item in issues:
            add_next_action(item.get("action", ""))
        if not dispatch_frozen:
            if state.get("needs_gap_check") and not pending_gap_exists(state):
                add_next_action("hloop gap start")
            if state.get("needs_review") and not pending_review_exists(state):
                add_next_action("hloop reviewer start")
            if last_validation_passed(state) and should_open_gap_gate(state):
                add_next_action("hloop tick --once # open gap gate")
            if last_validation_passed(state) and should_open_review_gate(state):
                add_next_action("hloop tick --once # open review gate")
    running_workers = [item["id"] for item in workers if item.get("status") == "running"]
    running_reviewers = [item["id"] for item in reviewers if item.get("gate_status") == "running"]
    running_gaps = [item["id"] for item in gaps if item.get("gate_status") == "running"]
    running_advisors = [item["id"] for item in advisors if item.get("gate_status") == "running"]
    inventory = {
        "repo": str(repo),
        "generated_at": now_iso(),
        "loop": {
            "goal_id": state.get("goal_id"),
            "phase": phase,
            "cycle": state.get("cycle", 0),
            "base_branch": base,
            "base_sha": safe_short_sha(repo, base),
            "integration_branch": integration,
            "integration_sha": safe_short_sha(repo, integration),
            "integration_target_sha": integration_target,
            "final_target_sha": final_target,
            "final_gate": final_gate.to_record() if final_gate else state.get("final_gate"),
            "resume_requirements": resume_requirements,
            "current_branch": current,
            "branch_strategy": state_value(state, "branch_strategy", DEFAULT_BRANCH_STRATEGY),
            "worker_protocol": state_value(state, "worker_protocol", DEFAULT_WORKER_PROTOCOL),
            "review_protocol": state_value(state, "review_protocol", DEFAULT_REVIEW_PROTOCOL),
            "worker_qa_profile": state_worker_qa_profile(state),
            "manager_qa_profile": state_manager_qa_profile(state),
            "manager_qa_status": state.get("manager_qa_status", ""),
            "current_batch_id": current_batch_id(state),
            "needs_validation": normalize_bool(state.get("needs_validation")),
            "needs_review": normalize_bool(state.get("needs_review")),
            "needs_gap_check": normalize_bool(state.get("needs_gap_check")),
            "dispatch_frozen": dispatch_frozen,
            "dispatch_freeze": dispatch_freeze_record(state),
            "release_scope": release_scope.to_record(),
            "follow_ups": _follow_up_state(state),
            "review_queue": {
                "count": normalize_int(state.get("unreviewed_merge_count"), 0),
                "threshold": review_after_merges(state),
            },
            "gap_queue": {
                "count": normalize_int(state.get("ungapped_merge_count"), 0),
                "threshold": gap_after_merges(state),
            },
        },
        "counts": {
            "workers": len(workers),
            "workers_running": len(running_workers),
            "workers_queued": sum(1 for item in workers if item.get("status") == "queued"),
            "workers_merge_ready": sum(
                1 for item in workers if item.get("status") == "result_reported" and item.get("artifact", {}).get("merge_ready")
            ),
            "batches": len(state_batches(state)),
            "reviewers": len(reviewers),
            "reviewers_running": len(running_reviewers),
            "reviewers_reported": sum(1 for item in reviewers if item.get("gate_status") == "reported"),
            "gaps": len(gaps),
            "gaps_running": len(running_gaps),
            "gaps_reported": sum(1 for item in gaps if item.get("gate_status") == "reported"),
            "advisors": len(advisors),
            "advisors_running": len(running_advisors),
            "advisors_reported": sum(1 for item in advisors if item.get("gate_status") == "reported"),
            "issues": len(issues),
            "p0_p1_issues": sum(1 for item in issues if item.get("severity") in {"P0", "P1"}),
        },
        "workers": workers,
        "reviewers": reviewers,
        "gaps": gaps,
        "advisors": advisors,
        "issues": issues,
        "next_actions": next_actions,
        "herdr": {
            "available": os.environ.get("HERDR_ENV") == "1" and command_exists("herdr"),
            "HERDR_ENV": os.environ.get("HERDR_ENV"),
            "HERDR_PANE_ID": os.environ.get("HERDR_PANE_ID"),
            "HERDR_WORKSPACE_ID": os.environ.get("HERDR_WORKSPACE_ID"),
        },
        "state": state,
    }
    return inventory


def validate_reviewer_worktree_scope(
    review_id: str,
    review_state: dict[str, Any],
    worktree: Path,
) -> list[str]:
    allowed = {str((LOOP_DIR / "prompts" / f"{review_id}.reviewer.md").as_posix())}
    if is_directory_review(review_state):
        allowed.update(
            {
                str((LOOP_DIR / "reviews" / review_id / "MANIFEST.json").as_posix()),
                str((LOOP_DIR / "reviews" / review_id / "FINAL.md").as_posix()),
                *{
                    str(
                        (
                            LOOP_DIR
                            / "reviews"
                            / review_id
                            / "providers"
                            / f"{provider}.md"
                        ).as_posix()
                    )
                    for provider in normalize_list(review_state.get("review_providers"))
                },
            }
        )
    else:
        allowed.add(str((LOOP_DIR / "reviews" / f"{review_id}.md").as_posix()))
    baseline = set(normalize_list(review_state.get("baseline_dirty_files")))
    violations = []
    for path in role_scope_paths(worktree):
        if path in baseline:
            continue
        if path not in allowed:
            violations.append(path)
    return violations


def validate_gap_worktree_scope(
    gap_id: str,
    gap_state: dict[str, Any],
    worktree: Path,
) -> list[str]:
    allowed = {
        str((LOOP_DIR / "gaps" / f"{gap_id}.md").as_posix()),
        str((LOOP_DIR / "prompts" / f"{gap_id}.gap.md").as_posix()),
    }
    baseline = set(normalize_list(gap_state.get("baseline_dirty_files")))
    violations = []
    for path in role_scope_paths(worktree):
        if path in baseline:
            continue
        if path not in allowed:
            violations.append(path)
    return violations


def validate_advisor_worktree_scope(
    advice_id: str,
    participant: dict[str, Any],
    worktree: Path,
) -> list[str]:
    participant_id = str(participant.get("participant_id") or "P1")
    allowed = {
        str((LOOP_DIR / "advice" / f"{advice_id}-{participant_id}.md").as_posix()),
        str((LOOP_DIR / "prompts" / f"{advice_id}-{participant_id}.advisor.md").as_posix()),
    }
    baseline = set(normalize_list(participant.get("baseline_dirty_files")))
    violations = []
    for path in role_scope_paths(worktree):
        if path in baseline:
            continue
        if path not in allowed:
            violations.append(path)
    return violations


def all_tasks_merged(state: dict[str, Any]) -> bool:
    tasks = state.get("tasks", {})
    return bool(tasks) and all(task.get("status") == "merged" for task in tasks.values())


def latest_closed_batch_id(state: Mapping[str, Any]) -> str:
    """Return the most recently closed batch, using its durable timestamp."""

    batches = state.get("batches")
    if not isinstance(batches, Mapping):
        return ""
    candidates: list[tuple[str, str]] = []
    for raw_batch_id, batch in batches.items():
        if not isinstance(batch, Mapping) or str(batch.get("status") or "") != "closed":
            continue
        batch_id = str(raw_batch_id)
        timestamp = str(
            batch.get("closed_at")
            or batch.get("started_at")
            or batch.get("created_at")
            or ""
        )
        candidates.append((timestamp, batch_id))
    return max(candidates)[1] if candidates else ""


def closed_batch_tasks_merged(state: dict[str, Any]) -> bool:
    """Check only the latest closed batch for normal batch-cadence review."""

    batches = state.get("batches")
    if not isinstance(batches, Mapping) or not batches:
        # Preserve the shape of migrated/hand-built states that have no batch
        # inventory while retaining their existing all-task behavior.
        return all_tasks_merged(state)
    batch_id = latest_closed_batch_id(state)
    if not batch_id:
        return False
    try:
        task_ids = batch_task_ids(state, batch_id)
    except HLoopError:
        return False
    if not task_ids:
        # A batch created before task attachment may have an empty persisted
        # task_ids list. Fall back to the legacy all-task invariant in that
        # shape; queued tasks still keep it closed because all_tasks_merged
        # remains false.
        return all_tasks_merged(state)
    tasks = state.get("tasks")
    if not isinstance(tasks, Mapping):
        return False
    return all(
        isinstance(tasks.get(task_id), Mapping)
        and tasks[task_id].get("status") == "merged"
        for task_id in task_ids
    )


def last_validation_passed(state: dict[str, Any]) -> bool:
    if normalize_bool(state.get("validation_stale")):
        return False
    results = state.get("last_validation", {}).get("results", [])
    target = str(state.get("completion_target_sha") or state.get("integration_head_sha") or "")
    recorded = str(state.get("last_validation", {}).get("head_sha") or "")
    return bool(results) and (not target or recorded == target) and all(
        item.get("result") == "passed" for item in results
    )


def validation_result_failed(value: Any) -> bool:
    """Treat ``failed:<returncode>`` as failed without discarding the code."""

    result = str(value or "")
    return result == "failed" or result.startswith("failed:")


def running_review_exists(state: dict[str, Any]) -> bool:
    return any(agent_gate_status(review) == "running" for review in state.get("reviews", {}).values())


def running_gap_exists(state: dict[str, Any]) -> bool:
    return any(agent_gate_status(gap) == "running" for gap in state.get("gaps", {}).values())


def agent_gate_status(agent_state: dict[str, Any]) -> str:
    return str(agent_state.get("gate_status") or agent_state.get("status") or "")


def reported_review_exists(state: dict[str, Any]) -> bool:
    return any(agent_gate_status(review) == "reported" for review in state.get("reviews", {}).values())


def reported_gap_exists(state: dict[str, Any]) -> bool:
    return any(agent_gate_status(gap) == "reported" for gap in state.get("gaps", {}).values())


def pending_review_exists(state: dict[str, Any]) -> bool:
    return any(
        agent_gate_status(review) in {"running", "reported"}
        for review in state.get("reviews", {}).values()
    )


def pending_gap_exists(state: dict[str, Any]) -> bool:
    return any(
        agent_gate_status(gap) in {"running", "reported"}
        for gap in state.get("gaps", {}).values()
    )


def review_gate_passed(state: dict[str, Any]) -> bool:
    if manual_final_review_required(state):
        convergence = state.get("review_convergence")
        if isinstance(convergence, dict) and convergence.get("status") in {"prepared", "pending", "running"}:
            return False
        manual = state.get("manual_final_review")
        if isinstance(manual, dict):
            if manual.get("status") == "passed":
                observed_target = str(
                    state.get("completion_target_sha") or state.get("integration_head_sha") or ""
                )
                prepared_target = str(manual.get("target_sha") or "")
                return not observed_target or observed_target == prepared_target
            if manual.get("status") in {"failed", "incomplete", "prepared", "running"}:
                return False
        if isinstance(convergence, dict) and convergence.get("status") in {"converged", "exhausted"}:
            return False
    if int(state.get("max_reviewers", DEFAULT_MAX_REVIEWERS)) <= 0:
        return True
    if state.get("needs_review"):
        return False
    reviews = state.get("reviews", {})
    target = str(state.get("completion_target_sha") or state.get("integration_head_sha") or "")
    return any(
        agent_gate_status(review) == "triaged"
        and (not target or str(review.get("closed_head_sha") or review.get("head_sha") or "") == target)
        for review in reviews.values()
    )


def gap_gate_passed(state: dict[str, Any]) -> bool:
    if int(state.get("max_gap_auditors", DEFAULT_MAX_GAP_AUDITORS)) <= 0:
        return True
    if state.get("needs_gap_check"):
        return False
    gaps = state.get("gaps", {})
    target = str(state.get("completion_target_sha") or state.get("integration_head_sha") or "")
    return any(
        agent_gate_status(gap) == "triaged"
        and (not target or str(gap.get("closed_head_sha") or gap.get("head_sha") or "") == target)
        for gap in gaps.values()
    )


def current_integration_target(repo: Path, state: dict[str, Any]) -> str:
    branch = str(state.get("integration_branch") or "")
    if not branch:
        return ""
    proc = run_cmd([TRUSTED_GIT_PATH, "-C", str(repo), "rev-parse", branch], check=False)
    return (proc.stdout or "").strip() if proc.returncode == 0 else ""


def review_policy_record(state: dict[str, Any]) -> dict[str, Any]:
    """Return the normalized review policy without mutating persisted state."""

    value = state.get("review_policy")
    policy = dict(hloop_config.REVIEW_POLICY_DEFAULTS)
    if isinstance(value, dict):
        policy.update(value)
    cadence = str(policy.get("cadence") or "batch")
    if cadence not in {"batch", "merge-count"}:
        raise HLoopError(f"unsupported review cadence: {cadence}")
    try:
        max_fix_rounds = int(policy.get("max_fix_rounds", 2))
    except (TypeError, ValueError) as exc:
        raise HLoopError("review max_fix_rounds must be an integer") from exc
    if max_fix_rounds < 0 or max_fix_rounds > 2:
        raise HLoopError("review max_fix_rounds must be between 0 and 2")
    manual_final_protocol = str(
        policy.get("manual_final_protocol")
        or hloop_certification.MANUAL_FINAL_PROTOCOL
    )
    if manual_final_protocol != hloop_certification.MANUAL_FINAL_PROTOCOL:
        raise HLoopError(
            "unsupported manual-final protocol: " + manual_final_protocol
        )
    policy["manual_final_protocol"] = manual_final_protocol
    policy["cadence"] = cadence
    policy["max_fix_rounds"] = max_fix_rounds
    return policy


def review_max_fix_rounds(state: dict[str, Any], convergence: Mapping[str, Any] | None = None) -> int:
    policy = review_policy_record(state)
    record = convergence if isinstance(convergence, Mapping) else state.get("review_convergence")
    authorized = normalize_int(record.get("authorized_extra_rounds"), 0) if isinstance(record, Mapping) else 0
    current = normalize_int(record.get("fix_round"), 0) if isinstance(record, Mapping) else 0
    consumed = len(normalize_list(record.get("extra_round_authorization_refs"))) if isinstance(record, Mapping) else 0
    # A consumed user authorization advances the current round even though
    # the remaining-extra-round counter is decremented by the pure transition.
    base = int(policy.get("max_fix_rounds", 2))
    return max(base + authorized + consumed, current if consumed else base)


def review_epoch_store(state: dict[str, Any]) -> dict[str, Any]:
    """Return the canonical in-STATE container for immutable epoch revisions."""

    value = state.setdefault(
        "review_epochs",
        {
            "active_epoch_id": "",
            "records": {},
            "protocol_capabilities": {},
        },
    )
    if not isinstance(value, dict):
        raise HLoopError("review_epochs must be an object")
    records = value.setdefault("records", {})
    capabilities = value.setdefault("protocol_capabilities", {})
    if not isinstance(records, dict) or not isinstance(capabilities, dict):
        raise HLoopError("review_epochs records and protocol_capabilities must be objects")
    value.setdefault("active_epoch_id", "")
    return value


def require_review_epoch_collection(
    state: dict[str, Any], epoch_id: str, revision: int | None = None
) -> hloop_review_epoch.ReviewEpochCollection:
    store = review_epoch_store(state)
    epoch_record = store["records"].get(epoch_id)
    if not isinstance(epoch_record, Mapping):
        raise HLoopError(f"unknown review epoch: {epoch_id}")
    selected_revision = revision
    if selected_revision is None:
        selected_revision = epoch_record.get("active_revision")
    if isinstance(selected_revision, bool) or not isinstance(selected_revision, int):
        raise HLoopError(f"review epoch has no active revision: {epoch_id}")
    revisions = epoch_record.get("revisions")
    if not isinstance(revisions, Mapping):
        raise HLoopError(f"review epoch revisions are invalid: {epoch_id}")
    record = revisions.get(str(selected_revision))
    if record is None:
        raise HLoopError(
            f"unknown review epoch revision: {epoch_id} revision {selected_revision}"
        )
    try:
        return hloop_review_epoch.ReviewEpochCollection.from_record(record)
    except hloop_review_epoch.ReviewEpochError as exc:
        raise HLoopError(
            f"stored review epoch {epoch_id} revision {selected_revision} is invalid: {exc}"
        ) from exc


def store_review_epoch_collection(
    state: dict[str, Any],
    collection: hloop_review_epoch.ReviewEpochCollection,
    *,
    make_active: bool = True,
) -> None:
    store = review_epoch_store(state)
    plan = collection.plan
    epoch_record = store["records"].setdefault(
        plan.epoch_id,
        {"active_revision": plan.epoch_revision, "revisions": {}},
    )
    if not isinstance(epoch_record, dict):
        raise HLoopError(f"review epoch record is invalid: {plan.epoch_id}")
    revisions = epoch_record.setdefault("revisions", {})
    if not isinstance(revisions, dict):
        raise HLoopError(f"review epoch revisions are invalid: {plan.epoch_id}")
    revisions[str(plan.epoch_revision)] = collection.to_record()
    if make_active:
        epoch_record["active_revision"] = plan.epoch_revision
        store["active_epoch_id"] = plan.epoch_id


def require_active_review_epoch_collection(
    state: dict[str, Any],
    collection: hloop_review_epoch.ReviewEpochCollection,
) -> None:
    store = review_epoch_store(state)
    epoch_id = str(store.get("active_epoch_id") or "")
    epoch_record = store["records"].get(epoch_id)
    active_revision = (
        epoch_record.get("active_revision")
        if isinstance(epoch_record, Mapping)
        else None
    )
    if (
        epoch_id != collection.plan.epoch_id
        or active_revision != collection.plan.epoch_revision
    ):
        raise HLoopError(
            "review epoch command targets an inactive epoch revision: "
            f"{collection.plan.epoch_id} revision {collection.plan.epoch_revision}"
        )


def load_json_object(path_value: str, *, label: str) -> dict[str, Any]:
    path = Path(path_value).expanduser().resolve()
    try:
        value = json.loads(read_text(path))
    except (OSError, json.JSONDecodeError) as exc:
        raise HLoopError(f"cannot load {label} {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise HLoopError(f"{label} must be a JSON object: {path}")
    return value


def validate_epoch_protocol_capabilities(
    plan: hloop_review_epoch.ReviewEpochPlan,
    capability_paths: Sequence[str],
) -> dict[str, dict[str, Any]]:
    external = [
        execution
        for execution in plan.required_executions
        if execution.protocol == "codex-review-multi-v2"
    ]
    if not external:
        if capability_paths:
            raise HLoopError(
                "protocol capability evidence was supplied for a native-only epoch"
            )
        return {}
    adapters: dict[str, dict[str, Any]] = {}
    for path in capability_paths:
        try:
            adapter = hloop_review.ExternalReviewProtocolAdapter.from_record(
                load_json_object(path, label="external review capability")
            )
        except hloop_review.ReviewModelError as exc:
            raise HLoopError(f"invalid external review capability: {exc}") from exc
        adapters[adapter.protocol] = adapter.to_record()
    if "codex-review-multi-v2" not in adapters:
        raise HLoopError(
            "codex-review-multi-v2 epoch execution requires externally-planned-v1 capability evidence"
        )
    return adapters


def cmd_review_epoch_create(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    try:
        plan = hloop_review_epoch.ReviewEpochPlan.from_record(
            load_json_object(args.plan, label="review epoch plan")
        )
        if plan.epoch_revision != 1:
            raise hloop_review_epoch.ReviewEpochError(
                "initial epoch create requires revision 1"
            )
        collection = hloop_review_epoch.ReviewEpochCollection.create(plan)
    except hloop_review_epoch.ReviewEpochError as exc:
        raise HLoopError(f"invalid review epoch plan: {exc}") from exc
    store = review_epoch_store(state)
    if plan.epoch_id in store["records"]:
        existing = require_review_epoch_collection(state, plan.epoch_id, 1)
        if existing == collection:
            print(f"review epoch already exists: {plan.epoch_id} revision 1")
            return 0
        raise HLoopError(
            f"review epoch already exists with different identity: {plan.epoch_id}"
        )
    target = current_integration_target(repo, state)
    if plan.target_sha != target:
        raise HLoopError(
            f"review epoch target SHA mismatch: plan={plan.target_sha} integration={target}"
        )
    capabilities = validate_epoch_protocol_capabilities(
        plan, normalize_list(getattr(args, "protocol_capability", None))
    )
    store_review_epoch_collection(state, collection)
    if capabilities:
        store["protocol_capabilities"][plan.plan_digest] = capabilities
    state["phase"] = "reviewing"
    save_state(repo, state)
    journal(
        repo,
        f"Created review epoch `{plan.epoch_id}` revision `{plan.epoch_revision}` for `{plan.target_sha}`.",
    )
    print(f"created review epoch {plan.epoch_id} revision {plan.epoch_revision}")
    return 0


def cmd_review_epoch_successor(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    try:
        plan = hloop_review_epoch.ReviewEpochPlan.from_record(
            load_json_object(args.plan, label="successor review epoch plan")
        )
        parent = require_review_epoch_collection(
            state, plan.epoch_id, plan.epoch_revision - 1
        )
        superseded, successor = hloop_review_epoch.create_successor_collection(
            parent, plan
        )
    except hloop_review_epoch.ReviewEpochError as exc:
        raise HLoopError(f"invalid successor review epoch: {exc}") from exc
    store = review_epoch_store(state)
    epoch_record = store["records"].get(plan.epoch_id)
    revisions = epoch_record.get("revisions") if isinstance(epoch_record, Mapping) else None
    existing = revisions.get(str(plan.epoch_revision)) if isinstance(revisions, Mapping) else None
    if existing is not None:
        try:
            if hloop_review_epoch.ReviewEpochCollection.from_record(existing) == successor:
                print(
                    f"review epoch successor already exists: {plan.epoch_id} revision {plan.epoch_revision}"
                )
                return 0
        except hloop_review_epoch.ReviewEpochError:
            pass
        raise HLoopError("successor revision already exists with different identity")
    target = current_integration_target(repo, state)
    if plan.target_sha != target:
        raise HLoopError(
            "successor review epoch target SHA mismatch: "
            f"plan={plan.target_sha} integration={target}"
        )
    require_active_review_epoch_collection(state, parent)
    capabilities = validate_epoch_protocol_capabilities(
        plan, normalize_list(getattr(args, "protocol_capability", None))
    )
    store_review_epoch_collection(state, superseded, make_active=False)
    store_review_epoch_collection(state, successor)
    if capabilities:
        store["protocol_capabilities"][plan.plan_digest] = capabilities
    save_state(repo, state)
    journal(
        repo,
        f"Created successor review epoch `{plan.epoch_id}` revision `{plan.epoch_revision}`.",
    )
    print(f"created successor {plan.epoch_id} revision {plan.epoch_revision}")
    return 0


def cmd_review_epoch_reserve(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    collection = require_review_epoch_collection(state, args.epoch_id, args.revision)
    require_active_review_epoch_collection(state, collection)
    target = current_integration_target(repo, state)
    if collection.plan.target_sha != target:
        raise HLoopError(
            "cannot reserve capacity for a stale review epoch: "
            f"epoch={collection.plan.target_sha} integration={target}"
        )
    if collection.status != "collecting":
        raise HLoopError(f"review epoch cannot reserve while {collection.status}")
    try:
        capacity = collection.capacity.reserve(
            collection.plan,
            lease_id=args.lease_id,
            execution_id=args.execution_id,
            process_ids=args.process_id,
            expires_at=args.expires_at,
        )
        collection = collection.with_capacity(capacity)
    except hloop_review_epoch.ReviewEpochError as exc:
        raise HLoopError(f"cannot reserve review epoch capacity: {exc}") from exc
    store_review_epoch_collection(state, collection, make_active=False)
    save_state(repo, state)
    print(
        f"reserved {len(args.process_id)} slots in {args.epoch_id} revision {collection.plan.epoch_revision}"
    )
    return 0


def cmd_review_epoch_lease(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    collection = require_review_epoch_collection(state, args.epoch_id, args.revision)
    require_active_review_epoch_collection(state, collection)
    try:
        if args.action == "running":
            capacity = collection.capacity.mark_running(args.lease_id)
        elif args.action == "quarantine":
            if not args.now:
                raise HLoopError("lease quarantine requires --now")
            capacity = collection.capacity.mark_expired_quarantined(
                args.lease_id, now=args.now
            )
        else:
            if not args.reason:
                raise HLoopError("terminal lease transition requires --reason")
            capacity = collection.capacity.mark_terminal(
                args.lease_id,
                reason=args.reason,
                process_exit_confirmed=bool(args.process_exit_confirmed),
                forced_abort_acknowledged=bool(args.forced_abort_acknowledged),
            )
        collection = collection.with_capacity(capacity)
    except hloop_review_epoch.ReviewEpochError as exc:
        raise HLoopError(f"invalid review epoch lease transition: {exc}") from exc
    store_review_epoch_collection(state, collection, make_active=False)
    save_state(repo, state)
    print(f"review epoch lease {args.lease_id}: {args.action}")
    return 0


def validate_epoch_outcome_artifact(
    repo: Path,
    state: dict[str, Any],
    collection: hloop_review_epoch.ReviewEpochCollection,
    outcome: hloop_review_epoch.EpochExecutionOutcome,
) -> None:
    if not outcome.artifact_digest and not outcome.artifact_complete:
        return
    artifact_path = (loop_path(repo) / outcome.artifact_ref).resolve()
    loop_root = loop_path(repo).resolve()
    try:
        artifact_path.relative_to(loop_root)
    except ValueError as exc:
        raise HLoopError("review epoch artifact_ref escapes the loop directory") from exc
    if not artifact_path.is_file():
        raise HLoopError(f"review epoch artifact is missing: {artifact_path}")
    observed_digest = _sha256_labelled(artifact_path.read_bytes())
    if observed_digest != outcome.artifact_digest:
        raise HLoopError(
            "review epoch artifact digest does not match the terminal outcome"
        )
    if outcome.source_kind != "reviewer" or not outcome.artifact_ref.endswith(
        "/MANIFEST.json"
    ):
        return
    role_state = state.get("reviews", {}).get(outcome.execution_id)
    if not isinstance(role_state, Mapping):
        raise HLoopError(
            "manifest Reviewer outcome has no canonical Reviewer state"
        )
    expected_plan = role_state.get("review_plan")
    if expected_plan is None:
        raise HLoopError("manifest Reviewer outcome lacks its immutable review plan")
    manifest_record = load_json_object(
        str(artifact_path), label="review epoch Reviewer manifest"
    )
    if outcome.protocol != "codex-review-multi-v2":
        try:
            manifest = hloop_review.ReviewManifest.from_record(manifest_record)
            planned = hloop_review.ReviewGroupPlan.from_record(expected_plan)
        except hloop_review.ReviewModelError as exc:
            raise HLoopError(f"invalid Reviewer manifest artifact: {exc}") from exc
        if (
            manifest.review_id != outcome.execution_id
            or manifest.plan != planned
            or not manifest.completeness.complete
        ):
            raise HLoopError(
                "Reviewer manifest is incomplete or changed its immutable lane plan"
            )
        return
    adapters = (
        review_epoch_store(state)["protocol_capabilities"].get(
            collection.plan.plan_digest
        )
        or {}
    )
    adapter = adapters.get("codex-review-multi-v2") if isinstance(adapters, Mapping) else None
    if adapter is None:
        raise HLoopError(
            "externally planned Reviewer outcome lacks plan or capability evidence"
        )
    try:
        hloop_review.validate_externally_planned_review_manifest(
            manifest_record,
            expected_plan=expected_plan,
            adapter=adapter,
        )
    except hloop_review.ReviewModelError as exc:
        raise HLoopError(f"invalid externally planned Reviewer artifact: {exc}") from exc


def cmd_review_epoch_record(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    collection = require_review_epoch_collection(state, args.epoch_id, args.revision)
    require_active_review_epoch_collection(state, collection)
    target = current_integration_target(repo, state)
    if collection.plan.target_sha != target:
        raise HLoopError(
            "cannot record a stale review epoch outcome: "
            f"epoch={collection.plan.target_sha} integration={target}"
        )
    try:
        outcome = hloop_review_epoch.EpochExecutionOutcome.from_record(
            load_json_object(args.outcome, label="review epoch execution outcome")
        )
        validate_epoch_outcome_artifact(repo, state, collection, outcome)
        updated = collection.record_outcome(outcome)
    except hloop_review_epoch.ReviewEpochError as exc:
        raise HLoopError(f"invalid review epoch execution outcome: {exc}") from exc
    store_review_epoch_collection(state, updated, make_active=False)
    role_state = None
    if outcome.source_kind == "reviewer":
        role_state = state.get("reviews", {}).get(outcome.execution_id)
    elif outcome.source_kind == "gap":
        role_state = state.get("gaps", {}).get(outcome.execution_id)
    if isinstance(role_state, dict):
        role_state["review_epoch_identity"] = collection.plan.artifact_identity(
            outcome.execution_id
        ).to_record()
        role_state["review_epoch_outcome"] = outcome.to_record()
    save_state(repo, state)
    print(f"recorded {outcome.execution_id}: {outcome.status}; epoch={updated.status}")
    return 0


def cmd_review_epoch_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    collection = require_review_epoch_collection(state, args.epoch_id, args.revision)
    payload = collection.to_record()
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print(
            f"{collection.plan.epoch_id} revision {collection.plan.epoch_revision}: "
            f"{collection.status}; outcomes={len(collection.execution_outcomes)}/"
            f"{len(collection.plan.required_executions)}; "
            f"reserved={collection.capacity.reserved_slots}/"
            f"{collection.plan.audit_agent_budget}"
        )
    return 0


def epoch_execution_start_binding(
    state: dict[str, Any],
    *,
    role_id: str,
    attempt_id: str,
    source_kind: str,
    target_sha: str,
) -> dict[str, Any] | None:
    """Require a persisted starting lease before a 0.5.3 audit launch."""

    if "review_epochs" not in state:
        return None
    store = review_epoch_store(state)
    epoch_id = str(store.get("active_epoch_id") or "")
    if not epoch_id:
        raise HLoopError(
            f"create a review epoch before starting {source_kind} execution {role_id}"
        )
    collection = require_review_epoch_collection(state, epoch_id)
    try:
        execution = collection.plan.execution(role_id)
    except hloop_review_epoch.ReviewEpochError as exc:
        raise HLoopError(
            f"active review epoch does not plan execution {role_id}"
        ) from exc
    if (
        execution.source_kind != source_kind
        or execution.attempt_id != attempt_id
        or collection.plan.target_sha != target_sha
    ):
        raise HLoopError(
            f"{source_kind} execution identity does not match the active review epoch"
        )
    expected_protocol = (
        state_value(state, "review_protocol", DEFAULT_REVIEW_PROTOCOL)
        if source_kind == "reviewer"
        else "native"
    )
    if execution.protocol != expected_protocol:
        raise HLoopError(
            f"{source_kind} execution protocol {execution.protocol!r} does not "
            f"match configured protocol {expected_protocol!r}"
        )
    required_start_ids = {process.process_id for process in execution.processes}
    starting_leases = tuple(
        lease
        for lease in collection.capacity.leases
        if lease.execution_id == execution.execution_id
        and lease.attempt_id == execution.attempt_id
        and lease.status == "starting"
    )
    reserved = {
        process_id for lease in starting_leases for process_id in lease.process_ids
    }
    if not required_start_ids.issubset(reserved):
        missing = sorted(required_start_ids - reserved)
        raise HLoopError(
            "review epoch starting leases do not cover the complete planned process set: "
            + ", ".join(missing)
        )
    return {
        "collection": collection,
        "lease_ids": tuple(lease.lease_id for lease in starting_leases),
        "identity": collection.plan.artifact_identity(role_id).to_record(),
    }


def validate_reviewer_epoch_capacity_binding(
    binding: Mapping[str, Any] | None,
    review_plan: hloop_review.ReviewGroupPlan,
) -> None:
    """Bind the existing Reviewer topology to the aggregate epoch budget."""

    if binding is None:
        return
    collection = hloop_review_epoch.ReviewEpochCollection.from_record(
        binding["collection"]
        if isinstance(binding["collection"], Mapping)
        else binding["collection"].to_record()
    )
    execution_id = str(binding["identity"]["execution_id"])
    execution = collection.plan.execution(execution_id)
    planned_by_provider: dict[str, int] = {}
    for process in execution.processes:
        planned_by_provider[process.provider] = (
            planned_by_provider.get(process.provider, 0) + 1
        )
    required_by_provider = hloop_review.required_provider_capacity(review_plan)
    if planned_by_provider != required_by_provider:
        raise HLoopError(
            "review epoch process topology does not reserve the exact Reviewer "
            f"provider capacity: planned={planned_by_provider} "
            f"required={required_by_provider}"
        )
    expected_agents: dict[str, tuple[str, str]] = {}
    for provider_plan in review_plan.provider_plans:
        expected_agents[provider_plan.coordinator_label] = (
            provider_plan.provider,
            provider_plan.model,
        )
        if provider_plan.role == "coordinator":
            for lane in provider_plan.lanes:
                expected_agents[lane.agent_label] = (
                    provider_plan.provider,
                    provider_plan.model,
                )
        for verifier in provider_plan.verifier_agents:
            expected_agents[verifier] = (
                provider_plan.provider,
                provider_plan.model,
            )
    planned_agents = {
        process.agent_label: (process.provider, process.model)
        for process in execution.processes
    }
    if planned_agents != expected_agents:
        raise HLoopError(
            "review epoch process identities do not match the immutable Reviewer "
            "agent labels, providers, and models"
        )
    expected_artifact_ref = (
        f"reviews/{execution_id}.md"
        if review_plan.mode == "single"
        else f"reviews/{execution_id}/MANIFEST.json"
    )
    if execution.artifact_ref != expected_artifact_ref:
        raise HLoopError(
            "review epoch artifact_ref does not match the Reviewer output contract: "
            f"expected {expected_artifact_ref}"
        )
    if execution.protocol == "codex-review-multi-v2" and review_plan.mode == "single":
        raise HLoopError(
            "codex-review-multi-v2 epoch execution requires a manifest-producing "
            "Reviewer mode"
        )


def gap_epoch_execution(
    binding: Mapping[str, Any] | None,
    agent_config: Mapping[str, str] | None = None,
) -> hloop_review_epoch.EpochExecutionPlan | None:
    if binding is None:
        return None
    collection = hloop_review_epoch.ReviewEpochCollection.from_record(
        binding["collection"]
        if isinstance(binding["collection"], Mapping)
        else binding["collection"].to_record()
    )
    execution_id = str(binding["identity"]["execution_id"])
    execution = collection.plan.execution(execution_id)
    expected_artifact_ref = f"gaps/{execution_id}.md"
    if execution.artifact_ref != expected_artifact_ref:
        raise HLoopError(
            "review epoch artifact_ref does not match the Gap output contract: "
            f"expected {expected_artifact_ref}"
        )
    if agent_config is not None:
        coordinator = next(
            process
            for process in execution.processes
            if process.process_kind == "coordinator"
        )
        if (
            coordinator.provider != agent_config["provider"]
            or coordinator.model != agent_config["model"]
        ):
            raise HLoopError(
                "review epoch Gap Coordinator provider/model does not match the "
                "configured Gap Agent"
            )
    return execution


def mark_epoch_execution_running(
    state: dict[str, Any], binding: Mapping[str, Any] | None
) -> None:
    if binding is None:
        return
    collection = hloop_review_epoch.ReviewEpochCollection.from_record(
        binding["collection"]
        if isinstance(binding["collection"], Mapping)
        else binding["collection"].to_record()
    )
    capacity = collection.capacity
    for lease_id in binding["lease_ids"]:
        capacity = capacity.mark_running(lease_id)
    store_review_epoch_collection(
        state, collection.with_capacity(capacity), make_active=False
    )


def release_failed_epoch_start(
    state: dict[str, Any],
    binding: Mapping[str, Any] | None,
    *,
    process_exit_confirmed: bool = True,
) -> None:
    if binding is None:
        return
    collection = hloop_review_epoch.ReviewEpochCollection.from_record(
        binding["collection"]
        if isinstance(binding["collection"], Mapping)
        else binding["collection"].to_record()
    )
    capacity = collection.capacity
    if not process_exit_confirmed:
        # Keep the reservation held. A Manager must confirm process exit or
        # forced-abort acknowledgement before this identity can release
        # capacity; guessing here could overcommit an orphaned Agent.
        store_review_epoch_collection(state, collection, make_active=False)
        return
    for lease_id in binding["lease_ids"]:
        lease = capacity.lease(lease_id)
        if lease.status != "terminal":
            capacity = capacity.mark_terminal(
                lease_id,
                reason="provider launch failed before process became live",
                process_exit_confirmed=process_exit_confirmed,
            )
    store_review_epoch_collection(
        state, collection.with_capacity(capacity), make_active=False
    )


def require_epoch_execution_ready_for_triage(
    state: dict[str, Any], execution_id: str
) -> hloop_review_epoch.ReviewEpochCollection | None:
    """Enforce the epoch-wide collection barrier on legacy role close paths."""

    if "review_epochs" not in state:
        return None
    role_state = state.get("reviews", {}).get(execution_id)
    if not isinstance(role_state, Mapping):
        role_state = state.get("gaps", {}).get(execution_id)
    explicitly_bound = isinstance(role_state, Mapping) and isinstance(
        role_state.get("review_epoch_identity"), Mapping
    )
    store = review_epoch_store(state)
    epoch_id = str(store.get("active_epoch_id") or "")
    if not epoch_id:
        if not explicitly_bound:
            return None
        raise HLoopError(
            f"review execution {execution_id} has no active review epoch"
        )
    collection = require_review_epoch_collection(state, epoch_id)
    try:
        collection.plan.execution(execution_id)
    except hloop_review_epoch.ReviewEpochError as exc:
        if not explicitly_bound:
            return None
        raise HLoopError(
            f"active review epoch does not contain execution {execution_id}"
        ) from exc
    outcome = next(
        (
            item
            for item in collection.execution_outcomes
            if item.execution_id == execution_id
        ),
        None,
    )
    if outcome is None or outcome.status != "succeeded" or not outcome.artifact_complete:
        raise HLoopError(
            f"review execution {execution_id} has no complete successful epoch outcome"
        )
    if collection.status not in {"ready_to_triage", "closed"}:
        raise HLoopError(
            "review epoch collection barrier is not ready: "
            f"{collection.plan.epoch_id} revision {collection.plan.epoch_revision} "
            f"is {collection.status}"
        )
    return collection


def _canonical_review_fix_round(convergence: Mapping[str, Any]) -> int:
    """Read the one durable convergence round counter without coercion."""

    value = convergence.get("fix_round")
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        raise HLoopError("review convergence fix_round must be a non-negative integer")
    return value


def manual_final_review_required(state: dict[str, Any]) -> bool:
    manual = state.get("manual_final_review")
    if not isinstance(manual, dict) and not isinstance(state.get("review_policy"), dict):
        # Small in-memory legacy fixtures and pre-revision callers have no
        # certification block; retain their merge-count gate semantics.
        return False
    if isinstance(manual, dict) and manual.get("status") == "not-required-for-legacy-run":
        return False
    return not (
        not isinstance(manual, dict)
        and str((state.get("review_policy") or {}).get("cadence") or "") == "merge-count"
    )


def _review_freeze(state: dict[str, Any], *, reason: str, input_id: str = "") -> None:
    current = dispatch_freeze_record(state)
    state["dispatch_freeze"] = {
        **current,
        "status": "active",
        "reason": reason,
        "frozen_at": current.get("frozen_at") or now_iso(),
        "source_input_id": input_id or str(current.get("source_input_id") or ""),
        "allowed_running_role_ids": role_ids_running(state),
    }


def _review_unfreeze(state: dict[str, Any], *, reason: str, input_id: str = "") -> None:
    current = dispatch_freeze_record(state)
    state["dispatch_freeze"] = {
        **current,
        "status": "inactive",
        "reason": reason,
        "frozen_at": "",
        "source_input_id": input_id,
        "allowed_running_role_ids": [],
    }


def invalidate_review_gates_for_change(
    state: dict[str, Any], *, reason: str, target_sha: str = ""
) -> None:
    """Invalidate frozen review evidence after a new integration change.

    Legacy migrated loops intentionally keep their old merge-count behavior;
    new/revision-2 loops must require a fresh fixed-target review instead.
    """

    if not manual_final_review_required(state):
        return
    convergence = state.setdefault("review_convergence", {})
    if not isinstance(convergence, dict):
        convergence = {}
        state["review_convergence"] = convergence
    convergence.update(
        {
            "status": "pending",
            "target_sha": target_sha,
            "verified_actionable_findings": None,
            "release_blocking_findings": None,
            "artifact_refs": [],
            "invalidated_at": now_iso(),
            "invalidated_reason": reason,
        }
    )
    # A changed integration target invalidates the prior manifest identity;
    # retain the monotonic canonical round but require a new target manifest.
    for field_name in ("recorded_round", "recorded_manifest_digest", "recorded_status"):
        convergence.pop(field_name, None)
    manual = state.setdefault("manual_final_review", {})
    if not isinstance(manual, dict):
        manual = {}
        state["manual_final_review"] = manual
    if manual.get("status") not in {"pending", "not-required-for-legacy-run"}:
        attempts = list(manual.get("attempt_history") or [])
        attempts.append({"status": manual.get("status", ""), "reason": reason, "at": now_iso()})
        manual["attempt_history"] = attempts
    manual.update(
        {
            "status": "pending",
            "certification_id": "",
            "target_sha": target_sha,
            "prepared_plan": "",
            "prepared_plan_digest": "",
            "manifest": "",
            "report": "",
            "manifest_complete": None,
            "verified_actionable_findings": None,
            "release_blocking_findings": None,
            "invalidated_at": now_iso(),
            "invalidated_reason": reason,
        }
    )
    state["review_readiness"] = {
        "status": "pending",
        "target_sha": target_sha,
        "errors": [],
        "checks": {},
        "updated_at": now_iso(),
    }
    if str(state.get("phase") or "") in {
        "review_readiness",
        "review_convergence",
        "review_convergence_exhausted",
        "awaiting_manual_final_review",
        "manual_final_review_failed",
        "manual_final_review_incomplete",
        "manual_final_review_passed",
        "ready_to_finish",
        "manager_qa",
    }:
        state["phase"] = "dispatching"


def _review_validation_is_current(
    state: dict[str, Any], target: str, repo: Path | None = None
) -> bool:
    if repo is not None:
        _refresh_validation_staleness(repo, state)
    if normalize_bool(state.get("validation_stale")):
        return False
    validation = state.get("last_validation")
    if not isinstance(validation, dict):
        return False
    results = validation.get("results")
    return bool(results) and str(validation.get("head_sha") or "") == target and all(
        isinstance(item, dict) and item.get("result") == "passed" for item in results
    )


def _changed_file_inventory(repo: Path, base_sha: str, target_sha: str) -> list[str]:
    if not base_sha or not target_sha:
        return []
    return sorted(
        set(
            git_name_only_z(
                repo,
                ["diff", "--name-only", f"{base_sha}...{target_sha}"],
                command="git diff --name-only -z",
            )
        )
    )


def _validation_mapping_for_paths(
    state: Mapping[str, Any], target: str, paths: Sequence[str]
) -> tuple[dict[str, list[str]], list[str]]:
    """Return per-file validation references and missing mapping errors."""

    evidence = state.get("changed_file_validation")
    if not isinstance(evidence, Mapping):
        return {}, ["changed-file validation evidence mapping is missing"] if paths else []
    if str(evidence.get("target_sha") or "") != target:
        return {}, ["changed-file validation evidence is stale"]
    if str(evidence.get("status") or "") != "passed":
        return {}, ["changed-file validation evidence is not passed"]
    raw_mapping = evidence.get("mapping")
    if not isinstance(raw_mapping, Mapping):
        return {}, ["changed-file validation evidence mapping is missing"]
    mapping: dict[str, list[str]] = {}
    missing: list[str] = []
    for path in paths:
        refs = normalize_list(raw_mapping.get(path))
        if not refs:
            missing.append(path)
        else:
            mapping[path] = refs
    errors = [f"changed file lacks validation evidence: {path}" for path in missing]
    expected_paths = {str(path) for path in paths}
    extra_paths = sorted(
        str(path) for path in raw_mapping if str(path) not in expected_paths
    )
    if extra_paths:
        errors.append(
            "changed-file validation evidence has unexpected paths: "
            + ", ".join(extra_paths)
        )
    return mapping, errors


def _special_verification_domains(paths: Sequence[str]) -> dict[str, list[str]]:
    domains: dict[str, list[str]] = {}
    for raw_path in paths:
        path = str(raw_path).replace("\\", "/").lower()
        matched: set[str] = set()
        if (
            "/migration" in path
            or path.startswith("migration/")
            or "migrate" in Path(path).name
        ):
            matched.add("migration")
        if "/schema" in path or path.startswith("schema/") or path.endswith(".schema.json"):
            matched.add("schema")
        if (
            path.endswith(".md")
            or path.startswith("docs/")
            or path in {"readme.md", "skill.md"}
            or "/references/" in path
        ):
            matched.add("public-docs")
        if any(
            marker in path
            for marker in (
                "security",
                "authorization",
                "credential",
                "permission",
                "auth",
                "secret",
                "token",
                "broker",
                "supervisor",
            )
        ):
            matched.add("security-boundary")
        for domain in sorted(matched):
            domains.setdefault(domain, []).append(str(raw_path))
    return domains


def _special_verification_errors(
    state: Mapping[str, Any], domains: Mapping[str, Sequence[str]], target: str
) -> tuple[dict[str, list[str]], list[str]]:
    if not domains:
        return {}, []
    raw = state.get("special_verification_evidence")
    if not isinstance(raw, Mapping):
        raw = state.get("verification_evidence")
    if not isinstance(raw, Mapping):
        return {}, [
            "special verification evidence is missing: " + ", ".join(sorted(domains))
        ]
    resolved: dict[str, list[str]] = {}
    errors: list[str] = []
    for domain in sorted(domains):
        value = raw.get(domain)
        if not isinstance(value, Mapping):
            # Pre-0.5.2 list-shaped evidence has no trustworthy target
            # identity.  It must not satisfy a current-head readiness gate.
            errors.append(f"special verification evidence identity is missing: {domain}")
            continue
        recorded_target = value.get("target_sha")
        if not isinstance(recorded_target, str) or not recorded_target.strip():
            errors.append(f"special verification evidence identity is missing: {domain}")
            continue
        if recorded_target != target:
            errors.append(f"special verification evidence is stale: {domain}")
            continue
        if str(value.get("status") or "") not in {"passed", "verified"}:
            errors.append(f"special verification evidence is not passed: {domain}")
            continue
        refs = normalize_list(value.get("references") or value.get("evidence"))
        if not refs:
            errors.append(f"special verification evidence is missing: {domain}")
        else:
            resolved[domain] = refs
    return resolved, errors


def _deferred_follow_up_fingerprints(repo: Path, state: Mapping[str, Any]) -> set[str]:
    """Collect explicit defer_follow_up candidates without guessing findings."""

    fingerprints: set[str] = set()
    for key in ("defer_follow_up_fingerprints", "deferred_follow_up_fingerprints"):
        fingerprints.update(str(item) for item in normalize_list(state.get(key)))
    for review in (state.get("reviews") or {}).values():
        if not isinstance(review, Mapping):
            continue
        for key in ("defer_follow_up_fingerprints", "deferred_follow_up_fingerprints"):
            fingerprints.update(str(item) for item in normalize_list(review.get(key)))
    reviews_root = loop_path(repo) / "reviews"
    if reviews_root.exists():
        for manifest_path in reviews_root.rglob("MANIFEST.json"):
            try:
                record = json.loads(read_text(manifest_path))
            except (OSError, json.JSONDecodeError, TypeError):
                continue
            if isinstance(record, Mapping) and isinstance(record.get("review_manifest"), Mapping):
                record = record["review_manifest"]
            findings = record.get("findings") if isinstance(record, Mapping) else None
            if not isinstance(findings, list):
                continue
            for finding in findings:
                if not isinstance(finding, Mapping):
                    continue
                if finding.get("disposition") == "defer_follow_up" and finding.get("fingerprint"):
                    fingerprints.add(str(finding["fingerprint"]))
    return fingerprints


def _recorded_follow_up_fingerprints(repo: Path, state: Mapping[str, Any]) -> set[str]:
    recorded: set[str] = set()
    for record in _follow_up_records(repo, state):
        if not isinstance(record, Mapping):
            continue
        recorded.update(str(item) for item in normalize_list(record.get("source_review_fingerprints")))
    return recorded


def _require_deferred_follow_up_completeness(
    repo: Path, state: Mapping[str, Any]
) -> tuple[set[str], set[str]]:
    """Fail closed when review evidence lacks its first-class follow-up."""

    deferred = _deferred_follow_up_fingerprints(repo, state)
    recorded = _recorded_follow_up_fingerprints(repo, state)
    unresolved = sorted(deferred - recorded)
    if unresolved:
        raise HLoopError(
            "defer_follow_up candidates lack first-class follow-up artifacts: "
            + ", ".join(unresolved)
        )
    return deferred, recorded


def _review_readiness_snapshot(repo: Path, state: dict[str, Any]) -> dict[str, Any]:
    """Collect all fail-closed prerequisites for a fixed-target review."""

    errors: list[str] = []
    review_policy = review_policy_record(state)
    batch_cadence = review_policy.get("cadence") == "batch" and isinstance(
        state.get("review_policy"), dict
    )
    target = current_integration_target(repo, state)
    base_ref = str(state.get("base_branch") or "")
    base_sha = ""
    if not target:
        errors.append("integration branch cannot be resolved")
    if base_ref:
        try:
            base_sha = git(repo, ["rev-parse", base_ref])
        except (HLoopError, subprocess.CalledProcessError):
            errors.append(f"base branch cannot be resolved: {base_ref}")
    else:
        errors.append("base branch is not configured")
    if current_batch_id(state):
        errors.append("current batch is still open")
    elif any(
        isinstance(batch, dict) and str(batch.get("status") or "") not in {"closed", "abandoned"}
        for batch in (state.get("batches") or {}).values()
    ):
        errors.append("an unclosed batch remains")
    if batch_cadence:
        if not closed_batch_tasks_merged(state):
            errors.append("latest closed batch tasks must be merged before review readiness")
    elif not all_tasks_merged(state):
        errors.append("all tasks must be merged before review readiness")
    running = running_agent_ids(state)
    if running:
        errors.append("role agents are still running: " + ", ".join(running))
    if state.get("active_merge"):
        errors.append("a merge transaction is active")
    dirty = unsafe_dirty_paths(repo)
    if dirty:
        errors.append("Manager checkout has non-loop dirty files: " + ", ".join(dirty))
    if pending_blocking_user_decisions(state):
        errors.append("blocking user decisions remain")
    if target and not _review_validation_is_current(state, target, repo):
        errors.append("current integration target lacks passing validation")
    pending_drafts = normalize_list(state.get("pending_fix_task_drafts"))
    if pending_drafts:
        errors.append("pending fix-task drafts remain: " + ", ".join(pending_drafts))
    try:
        scope = assert_release_scope_snapshot(repo, state)
    except HLoopError as exc:
        errors.append(str(exc))
        scope = release_scope_from_state(state)
    if release_scope_enabled(state) and scope.status == "unlocked":
        errors.append("fresh 0.5.2 loops require release-scope lock before review readiness")
    inventory: list[str] = []
    if base_sha and target:
        inventory = _changed_file_inventory(repo, base_sha, target)
        if not inventory:
            try:
                probe = run_cmd(
                    [
                        TRUSTED_GIT_PATH,
                        "-C",
                        str(repo),
                        "diff",
                        "--name-only",
                        f"{base_sha}...{target}",
                    ],
                    check=False,
                )
            except OSError:
                probe = None
            if probe is None or probe.returncode != 0:
                errors.append("cannot compute changed-file inventory")

    mapping, mapping_errors = _validation_mapping_for_paths(state, target, inventory)
    errors.extend(mapping_errors)
    domains = _special_verification_domains(inventory)
    special_evidence, special_errors = _special_verification_errors(state, domains, target)
    errors.extend(special_errors)
    deferred = _deferred_follow_up_fingerprints(repo, state)
    recorded_follow_ups = _recorded_follow_up_fingerprints(repo, state)
    unresolved_follow_ups = sorted(deferred - recorded_follow_ups)
    if unresolved_follow_ups:
        errors.append(
            "defer_follow_up candidates lack first-class follow-up artifacts: "
            + ", ".join(unresolved_follow_ups)
        )
    checks = {
        "target_sha": target,
        "base_ref": base_ref,
        "base_sha": base_sha,
        "current_batch_closed": not current_batch_id(state),
        "all_tasks_merged": all_tasks_merged(state),
        "review_batch_tasks_merged": closed_batch_tasks_merged(state) if batch_cadence else None,
        "running_roles": running,
        "dirty_paths": dirty,
        "validation_current": bool(
            target and _review_validation_is_current(state, target, repo)
        ),
        "pending_fix_task_drafts": pending_drafts,
        "scope_status": scope.status,
        "scope_revision": scope.scope_revision,
        "source_snapshot_revision": scope.source_snapshot_revision,
        "diff_inventory": inventory,
        "changed_file_validation": {
            "status": "passed" if not mapping_errors else "failed",
            "target_sha": target,
            "paths": inventory,
            "mapping": mapping,
        },
        "special_verification": {
            "status": "passed" if not special_errors else "failed",
            "domains": domains,
            "evidence": special_evidence,
        },
        "follow_up_completeness": {
            "status": "passed" if not unresolved_follow_ups else "failed",
            "defer_follow_up_fingerprints": sorted(deferred),
            "recorded_fingerprints": sorted(recorded_follow_ups),
            "unresolved": unresolved_follow_ups,
        },
    }
    return {"ready": not errors, "target_sha": target, "base_sha": base_sha, "errors": errors, "checks": checks}


def _review_plan_for_target(
    state: dict[str, Any],
    target: str,
    *,
    mode: str | None = None,
    providers: Sequence[str] | None = None,
    probe_count: int | None = None,
    probes_per_provider: int | None = None,
) -> hloop_review.ReviewGroupPlan:
    topology = resolved_reviewer_topology(
        state,
        mode=mode,
        providers=providers,
        probe_count=probe_count,
        probes_per_provider=probes_per_provider,
    )
    try:
        return build_reviewer_group_plan(
            topology["mode"],
            target,
            role_agent_config(state, "reviewer"),
            topology=topology,
        )
    except (HLoopError, hloop_review.ReviewModelError) as exc:
        raise HLoopError(f"cannot build review plan: {exc}") from exc


def _write_json_artifact(path: Path, value: Mapping[str, Any]) -> None:
    write_text(path, json.dumps(value, ensure_ascii=False, indent=2) + "\n")


def _review_manifest_from_path(path: Path) -> hloop_review.ReviewManifest:
    try:
        record = json.loads(read_text(path))
        if isinstance(record, dict) and isinstance(record.get("review_manifest"), dict):
            record = record["review_manifest"]
        return hloop_review.ReviewManifest.from_record(record)
    except (OSError, json.JSONDecodeError, TypeError, ValueError, KeyError, hloop_review.ReviewModelError) as exc:
        raise HLoopError(f"invalid review manifest {path}: {exc}") from exc


def _review_manifest_policy_counts(
    manifest: hloop_review.ReviewManifest,
    *,
    allow_legacy: bool = False,
    accepted_risk_authorizations: Mapping[str, Any] | None = None,
) -> tuple[int, int]:
    """Count verified findings after shared disposition-policy validation."""

    try:
        return hloop_review.review_manifest_policy_counts(
            manifest,
            allow_legacy=allow_legacy,
            accepted_risk_authorizations=accepted_risk_authorizations,
        )
    except hloop_review.ReviewModelError as exc:
        raise HLoopError(str(exc)) from exc


def _review_manifest_actionable_count(manifest: hloop_review.ReviewManifest) -> int:
    return _review_manifest_policy_counts(manifest)[0]


def _resolve_review_accepted_risk_authorizations(
    state: Mapping[str, Any], manifest: hloop_review.ReviewManifest
) -> dict[str, hloop_decisions.ResolvedAcceptedRiskAuthorization]:
    """Resolve every accepted-risk finding before a review gate mutates state."""

    decisions = state.get("decisions") or {}
    resolved: dict[str, hloop_decisions.ResolvedAcceptedRiskAuthorization] = {}
    for finding in manifest.findings:
        if finding.disposition != "accepted_risk":
            continue
        try:
            authorization = hloop_decisions.resolve_accepted_risk_authorization(
                decisions,
                finding_fingerprint=finding.fingerprint,
                target_sha=finding.head_sha,
                decision_id=finding.accepted_risk_decision_id,
            )
        except hloop_decisions.DecisionAuthorizationError as exc:
            raise HLoopError(
                f"accepted-risk disposition policy authorization rejected for {finding.fingerprint}: {exc}"
            ) from exc
        resolved[finding.fingerprint] = authorization
    return resolved


def _update_review_execution_metrics(
    state: Mapping[str, Any], manifest: hloop_review.ReviewManifest, round_number: int
) -> None:
    """Project the recorded convergence manifest into durable execution metrics."""

    metrics = state.get("execution_metrics")
    if not isinstance(metrics, dict):
        return
    records = [finding.to_record() for finding in manifest.findings]
    metrics["candidate_count"] = len(records)
    metrics["confirmed_count"] = len(manifest.confirmed_fingerprints)
    explicit_records = [
        record for record in records if record.get("policy_axes_explicit") is True
    ]
    if explicit_records:
        projected = hloop_reports.ExecutionMetrics.from_finding_dispositions(explicit_records)
        metrics["finding_origin_counts"] = dict(projected.finding_origin_counts)
        metrics["finding_contract_relation_counts"] = dict(
            projected.finding_contract_relation_counts
        )
        metrics["finding_decision_requirement_counts"] = dict(
            projected.finding_decision_requirement_counts
        )
        metrics["finding_disposition_counts"] = dict(projected.finding_disposition_counts)
    else:
        # Legacy manifests predate the independent policy axes.  Preserve the
        # candidate/confirmed counters but do not manufacture classifications.
        for field_name in (
            "finding_origin_counts",
            "finding_contract_relation_counts",
            "finding_decision_requirement_counts",
            "finding_disposition_counts",
        ):
            metrics[field_name] = {}
    current_round = metrics.get("review_fix_rounds")
    if isinstance(current_round, int) and not isinstance(current_round, bool):
        metrics["review_fix_rounds"] = max(current_round, max(0, round_number))
    else:
        metrics["review_fix_rounds"] = max(0, round_number)


def _final_paths(repo: Path) -> dict[str, Path]:
    directory = loop_path(repo) / "reviews" / "final"
    return {
        "directory": directory,
        "plan": directory / "PLAN.json",
        "manifest": directory / "MANIFEST.json",
        "report": directory / "FINAL.md",
    }


def _scope_certification_identity(repo: Path, state: dict[str, Any]) -> tuple[int, int, str, tuple[str, ...]]:
    scope = assert_release_scope_snapshot(repo, state)
    if scope.status == "locked":
        digest = scope.scope_digest or hloop_certification.canonical_digest(scope.to_record())
        return (
            scope.scope_revision,
            scope.source_snapshot_revision,
            digest,
            tuple(scope.source_refs),
        )
    return (
        scope.scope_revision,
        scope.source_snapshot_revision,
        hloop_certification.canonical_digest({"status": scope.status, "scope": scope.to_record()}),
        tuple(scope.source_refs),
    )


def _final_certification_plan(
    repo: Path,
    state: dict[str, Any],
    target: str,
    *,
    certification_id: str,
    base_sha: str = "",
    mode: str | None = None,
    providers: Sequence[str] | None = None,
    probe_count: int | None = None,
    probes_per_provider: int | None = None,
) -> tuple[hloop_certification.CertificationPlan, hloop_review.ReviewGroupPlan]:
    review_policy = review_policy_record(state)
    manual_final_protocol = str(review_policy.get("manual_final_protocol") or "")
    if manual_final_protocol != hloop_certification.MANUAL_FINAL_PROTOCOL:
        # Do not silently substitute the one implemented protocol when a
        # persisted/configured policy names an unsupported manual-final
        # implementation.
        raise HLoopError(
            "unsupported manual-final protocol: " + (manual_final_protocol or "missing")
        )
    group = _review_plan_for_target(
        state,
        target,
        mode=mode,
        providers=providers,
        probe_count=probe_count,
        probes_per_provider=probes_per_provider,
    )
    scope_revision, snapshot_revision, source_digest, source_refs = _scope_certification_identity(repo, state)
    policy = hloop_certification.VerificationPolicy(
        max_parallel_verifiers=group.budget.max_parallel_verifiers,
        max_verifications=group.budget.max_verifications,
        time_limit_seconds=group.budget.time_limit_seconds,
        provider_limits=tuple(group.budget.provider_limits),
    )
    lanes = tuple(
        hloop_certification.FinalReviewLane(
            provider=lane.provider,
            lane_id=lane.lane_id,
            purpose=lane.purpose,
            agent_label=lane.agent_label,
        )
        for lane in group.expected_lanes
    )
    plan = hloop_certification.CertificationPlan(
        certification_id=certification_id,
        base_ref=str(state.get("base_branch") or ""),
        base_sha=base_sha or git(repo, ["rev-parse", str(state.get("base_branch") or "HEAD")]),
        target_ref=str(state.get("integration_branch") or ""),
        target_sha=target,
        scope_source=source_refs,
        scope_revision=scope_revision,
        source_snapshot_revision=snapshot_revision,
        source_digest=source_digest,
        protocol=manual_final_protocol,
        lane_plan=lanes,
        verification_policy=policy,
    )
    return plan, group


def _report_field(record: Mapping[str, Any], *names: str) -> tuple[str, Any]:
    for name in names:
        if name in record:
            return name, record[name]
    return names[0], None


def _report_nonnegative_int(
    record: Mapping[str, Any], *names: str
) -> tuple[str, int | None, str | None]:
    name, value = _report_field(record, *names)
    if isinstance(value, bool):
        return name, None, f"{name} must be a non-negative integer"
    if isinstance(value, int):
        return name, value, None if value >= 0 else f"{name} must be a non-negative integer"
    if isinstance(value, str) and re.fullmatch(r"[0-9]+", value.strip()):
        return name, int(value.strip()), None
    return name, None, f"{name} must be a non-negative integer"


_MANUAL_FINAL_REPORT_LIST_ALIASES: dict[str, tuple[str, ...]] = {
    "residual_risks": ("residual_risks", "risks", "risk"),
    "follow_up_refs": ("follow_up_refs", "follow_ups", "follow_up"),
}


def _manual_final_report_list_values(
    record: Mapping[str, Any],
) -> tuple[dict[str, list[str]], tuple[str, ...]]:
    """Return only non-empty, unique string lists from a manual final report."""

    values: dict[str, list[str]] = {}
    invalid: list[str] = []
    for field_name, names in _MANUAL_FINAL_REPORT_LIST_ALIASES.items():
        matched = next((name for name in names if name in record), None)
        if matched is None:
            continue
        raw = record[matched]
        if not isinstance(raw, list):
            invalid.append(field_name)
            continue
        normalized: list[str] = []
        for item in raw:
            if not isinstance(item, str) or not item.strip():
                invalid.append(field_name)
                break
            normalized.append(item.strip())
        else:
            if len(set(normalized)) != len(normalized):
                invalid.append(field_name)
            else:
                values[field_name] = normalized
    return values, tuple(dict.fromkeys(invalid))


def _manual_final_report_issues(
    repo: Path,
    plan: hloop_certification.CertificationPlan,
    evidence: hloop_certification.FinalReviewManifest,
    report_path: Path,
    *,
    allow_legacy: bool = False,
) -> list[str]:
    """Validate the human-facing FINAL.md certification record.

    The structured manifest remains the source for recomputed findings and
    lane completeness.  FINAL.md is required as an auditable human projection
    and must carry the same fixed identity and explicit evidence references.
    """

    try:
        record = read_frontmatter(report_path)
    except (OSError, HLoopError) as exc:
        return [f"report-unreadable:{exc}"]
    issues: list[str] = []
    required_fields = (
        "protocol",
        "certification_id",
        "prepared_plan_digest",
        "base_sha",
        "target_sha",
        "scope_revision",
        "source_snapshot_revision",
        "source_digest",
        "lane_count",
        "lane_names",
        "lane_outcomes",
        "coordinator_session_id",
        "diff_inventory",
        "verification_records",
        "verification_shortfall",
        "incomplete_findings",
        "manifest_complete",
        "verified_actionable_findings",
        "findings",
        "residual_risks",
        "follow_up_refs",
        "patch_verdict",
        "completed_at",
    )
    aliases = {
        "prepared_plan_digest": ("prepared_plan_digest", "plan_digest"),
        "lane_names": ("lane_names", "lanes"),
        "coordinator_session_id": ("coordinator_session_id", "coordinator_session"),
        "diff_inventory": ("diff_inventory", "reviewed_files"),
        "verification_records": ("verification_records", "verification"),
        "verification_shortfall": ("verification_shortfall", "shortfall"),
        **_MANUAL_FINAL_REPORT_LIST_ALIASES,
    }
    resolved: dict[str, Any] = {}
    for field_name in required_fields:
        names = aliases.get(field_name, (field_name,))
        matched = next((name for name in names if name in record), None)
        if matched is None:
            issues.append(f"report-missing:{field_name}")
        else:
            resolved[field_name] = record[matched]

    def require_text(field_name: str, expected: str | None = None) -> None:
        value = resolved.get(field_name)
        if not isinstance(value, str) or not value.strip():
            issues.append(f"report-invalid:{field_name}")
        elif expected is not None and value.strip() != expected:
            issues.append(f"report-identity-mismatch:{field_name}")

    require_text("protocol", plan.protocol)
    require_text("certification_id", plan.certification_id)
    require_text("prepared_plan_digest", plan.digest)
    require_text("base_sha", plan.base_sha)
    require_text("target_sha", plan.target_sha)
    require_text("source_digest", plan.source_digest)
    if str(evidence.protocol or "") != plan.protocol:
        issues.append("report-identity-mismatch:manifest-protocol")

    for field_name, expected in (
        ("scope_revision", plan.scope_revision),
        ("source_snapshot_revision", plan.source_snapshot_revision),
    ):
        raw = resolved.get(field_name)
        if isinstance(raw, bool) or not isinstance(raw, (int, str)):
            issues.append(f"report-invalid:{field_name}")
        else:
            try:
                value = int(raw)
            except (TypeError, ValueError):
                value = -1
            if value != expected:
                issues.append(f"report-identity-mismatch:{field_name}")

    lane_names = normalize_list(resolved.get("lane_names"))
    lane_outcomes = normalize_list(resolved.get("lane_outcomes"))
    expected_lanes = tuple(plan.lane_plan)
    lane_count = resolved.get("lane_count")
    try:
        lane_count_value = -1 if isinstance(lane_count, bool) else int(lane_count)
    except (TypeError, ValueError):
        lane_count_value = -1
    if lane_count_value != len(expected_lanes):
        issues.append("report-lane-count-mismatch")
    if len(lane_names) != len(expected_lanes) or len(lane_outcomes) != len(expected_lanes):
        issues.append("report-lane-inventory-incomplete")
    expected_lane_tokens = {
        token
        for lane in expected_lanes
        for token in (
            f"{lane.provider}:{lane.lane_id}",
            lane.lane_id,
            lane.agent_label,
        )
    }
    if not set(lane_names).issubset(expected_lane_tokens) or len(set(lane_names)) != len(lane_names):
        issues.append("report-lane-names-mismatch")
    actual_lane_results = {
        f"{result.provider}:{result.lane_id}": result.status
        for result in evidence.review_manifest.lane_results
    }
    for lane in expected_lanes:
        key = f"{lane.provider}:{lane.lane_id}"
        name_matches = [
            item
            for item in lane_names
            if item in {key, lane.lane_id, lane.agent_label}
        ]
        if len(name_matches) != 1:
            issues.append(f"report-lane-name-missing:{key}")
        matching = [
            item
            for item in lane_outcomes
            if any(
                item.startswith(f"{token}:")
                for token in (key, lane.lane_id, lane.agent_label)
            )
        ]
        if not matching:
            issues.append(f"report-lane-outcome-missing:{key}")
        else:
            actual_status = actual_lane_results.get(key)
            if actual_status and not any(
                item.rsplit(":", 1)[-1] == actual_status for item in matching
            ):
                issues.append(f"report-lane-outcome-mismatch:{key}")

    inventory = normalize_list(resolved.get("diff_inventory"))
    actual_inventory = _changed_file_inventory(repo, plan.base_sha, plan.target_sha)
    if actual_inventory:
        missing = sorted(set(actual_inventory) - set(inventory))
        extra = sorted(set(inventory) - set(actual_inventory))
        if missing:
            issues.append("report-diff-inventory-missing:" + ",".join(missing))
        if extra:
            issues.append("report-diff-inventory-extra:" + ",".join(extra))
    elif not inventory or inventory == [""]:
        issues.append("report-diff-inventory-missing")

    verification_records = normalize_list(resolved.get("verification_records"))
    if evidence.review_manifest.findings and not verification_records:
        issues.append("report-verification-records-missing")
    expected_verifications = {
        record.fingerprint for record in evidence.review_manifest.verifications
    }
    if expected_verifications and not all(
        any(fingerprint in reference for reference in verification_records)
        for fingerprint in expected_verifications
    ):
        issues.append("report-verification-records-mismatch")
    shortfall_name, shortfall, shortfall_issue = _report_nonnegative_int(
        resolved, "verification_shortfall"
    )
    if shortfall_issue:
        issues.append(f"report-invalid:{shortfall_name}")
    elif shortfall != len(evidence.review_manifest.verification_plan.shortfalls):
        issues.append("report-verification-shortfall-mismatch")
    incomplete = normalize_list(resolved.get("incomplete_findings"))
    expected_incomplete = list(evidence.completeness.incomplete_findings)
    if sorted(incomplete) != sorted(expected_incomplete):
        issues.append("report-incomplete-findings-mismatch")
    if resolved.get("manifest_complete") is not evidence.manifest_complete:
        issues.append("report-manifest-complete-mismatch")
    _, actionable, actionable_issue = _report_nonnegative_int(
        resolved, "verified_actionable_findings"
    )
    if actionable_issue:
        issues.append("report-invalid:verified_actionable_findings")
    elif actionable != evidence.recomputed_verified_actionable_count_for_scope(
        allow_legacy=allow_legacy
    ):
        issues.append("report-verified-actionable-findings-mismatch")
    report_findings = resolved.get("findings")
    if not isinstance(report_findings, list):
        issues.append("report-invalid:findings")
    else:
        finding_refs = []
        for item in report_findings:
            if isinstance(item, Mapping):
                fingerprint = str(item.get("fingerprint") or "").strip()
            else:
                fingerprint = str(item).strip()
            if fingerprint:
                finding_refs.append(fingerprint)
        expected_findings = [finding.fingerprint for finding in evidence.review_manifest.findings]
        if len(finding_refs) != len(set(finding_refs)) or sorted(finding_refs) != sorted(expected_findings):
            issues.append("report-findings-mismatch")
    _, invalid_lists = _manual_final_report_list_values(record)
    issues.extend(f"report-invalid:{field_name}" for field_name in invalid_lists)
    require_text("coordinator_session_id")
    require_text("patch_verdict", evidence.patch_verdict)
    completed_at = _parse_metric_timestamp(resolved.get("completed_at"))
    if completed_at is None:
        issues.append("report-invalid:completed_at")
    return sorted(set(issues))


def _next_certification_id(state: dict[str, Any]) -> str:
    used = {
        str(item.get("certification_id") or "")
        for item in (state.get("manual_final_review", {}).get("attempt_history") or [])
        if isinstance(item, dict)
    }
    current = str((state.get("manual_final_review") or {}).get("certification_id") or "")
    if current:
        used.add(current)
    index = 1
    while f"C{index:03d}" in used:
        index += 1
    return f"C{index:03d}"


def cmd_review_readiness(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    snapshot = _review_readiness_snapshot(repo, state)
    if not args.dry_run:
        state["review_readiness"] = {
            "status": "ready" if snapshot["ready"] else "blocked",
            "target_sha": snapshot["target_sha"],
            "base_sha": snapshot["base_sha"],
            "errors": snapshot["errors"],
            "checks": snapshot["checks"],
            "updated_at": now_iso(),
        }
        if snapshot["ready"]:
            state["phase"] = "review_readiness"
        save_state(repo, state)
    payload = {
        "ready": snapshot["ready"],
        "status": "ready" if snapshot["ready"] else "blocked",
        "target_sha": snapshot["target_sha"],
        "base_sha": snapshot["base_sha"],
        "errors": snapshot["errors"],
        "checks": snapshot["checks"],
        "dry_run": bool(args.dry_run),
    }
    print_policy_payload(payload, as_json=bool(args.json), label="review readiness")
    return 0 if snapshot["ready"] else 2


def cmd_review_convergence_prepare(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    policy = review_policy_record(state)
    if review_max_fix_rounds(state, state.get("review_convergence")) == 0:
        raise HLoopError("review convergence is disabled by max_fix_rounds=0")
    snapshot = _review_readiness_snapshot(repo, state)
    if not snapshot["ready"]:
        raise HLoopError("review readiness is blocked: " + "; ".join(snapshot["errors"]))
    convergence = state.setdefault("review_convergence", {})
    if not isinstance(convergence, dict):
        raise HLoopError("STATE.json review_convergence must be an object")
    if str(convergence.get("status") or "") == "exhausted":
        raise HLoopError("review convergence is exhausted; use `hloop review reopen` first")
    current_round = _canonical_review_fix_round(convergence)
    target = snapshot["target_sha"]
    group = _review_plan_for_target(
        state,
        target,
        mode=getattr(args, "mode", None),
        providers=getattr(args, "providers", None),
        probe_count=getattr(args, "probe_count", None),
        probes_per_provider=getattr(args, "probes_per_provider", None),
    )
    plan_path = loop_path(repo) / "reviews" / "convergence" / "PLAN.json"
    manifest_path = loop_path(repo) / "reviews" / "convergence" / "MANIFEST.json"
    plan_record = {
        "protocol": str(policy.get("pre_final_protocol") or hloop_certification.MANUAL_FINAL_PROTOCOL),
        "base_ref": str(state.get("base_branch") or ""),
        "base_sha": snapshot["base_sha"],
        "target_ref": str(state.get("integration_branch") or ""),
        "target_sha": target,
        "fix_round": current_round,
        "max_fix_rounds": review_max_fix_rounds(state, convergence),
        "review_plan": group.to_record(),
        "readiness": snapshot["checks"],
        "prepared_at": now_iso(),
    }
    if not args.dry_run:
        # Once a round has been recorded, preserve its manifest when prepare
        # is retried.  Replacing an actionable manifest with the empty
        # scaffold here would silently bypass remediation at the same round.
        recorded_digest = str(convergence.get("recorded_manifest_digest") or "")
        recorded_round = convergence.get("recorded_round")
        preserve_manifest = False
        if recorded_digest:
            if isinstance(recorded_round, bool) or not isinstance(recorded_round, int):
                raise HLoopError("recorded convergence round must be a non-negative integer")
            if recorded_round != current_round:
                raise HLoopError(
                    "recorded convergence round does not match canonical fix_round"
                )
            if not manifest_path.is_file():
                raise HLoopError(
                    "recorded convergence manifest is missing; cannot safely prepare the same round"
                )
            existing_manifest = _review_manifest_from_path(manifest_path)
            if existing_manifest.plan.to_record() != group.to_record():
                raise HLoopError("recorded convergence manifest does not match the current plan")
            preserve_manifest = True
        _write_json_artifact(plan_path, plan_record)
        if not preserve_manifest:
            # A missing-lane manifest is intentionally incomplete.  It gives
            # the Manager a safe structured starting point and cannot pass by
            # claim.
            empty_manifest = hloop_review.ReviewManifest(
                review_id="R001",
                plan=group,
                lane_results=(),
                findings=(),
                verification_plan=hloop_review.plan_verification(group, ()),
                verifications=(),
            )
            _write_json_artifact(manifest_path, empty_manifest.to_record())
        convergence.update(
            {
                "status": "prepared",
                "base_ref": str(state.get("base_branch") or ""),
                "base_sha": snapshot["base_sha"],
                "target_sha": target,
                "fix_round": current_round,
                "review_plan": group.to_record(),
                "artifact_refs": [str(plan_path.relative_to(repo)), str(manifest_path.relative_to(repo))],
                "prepared_at": now_iso(),
                "last_status": "prepared",
            }
        )
        state["review_readiness"] = {
            "status": "ready",
            "target_sha": target,
            "base_sha": snapshot["base_sha"],
            "errors": [],
            "checks": snapshot["checks"],
            "updated_at": now_iso(),
        }
        state["phase"] = "review_convergence"
        state["needs_review"] = False
        state["review_convergence_auto_start"] = False
        save_state(repo, state)
        journal(repo, f"Prepared fixed-target review convergence for `{target}` without starting a Reviewer.")
    payload = {
        "status": "prepared",
        "target_sha": target,
        "base_sha": snapshot["base_sha"],
        "plan": str(plan_path.relative_to(repo)),
        "manifest": str(manifest_path.relative_to(repo)),
        "review_plan": group.to_record(),
        "automatic_reviewer_started": False,
        "dry_run": bool(args.dry_run),
    }
    print_policy_payload(payload, as_json=bool(args.json), label="review convergence prepared")
    return 0


def cmd_review_convergence_record(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    convergence = state.get("review_convergence")
    if not isinstance(convergence, dict):
        raise HLoopError("STATE.json review_convergence must be an object")
    current_round = _canonical_review_fix_round(convergence)
    target = str(convergence.get("target_sha") or "")
    current = current_integration_target(repo, state)
    if not target or not current or target != current:
        raise HLoopError(
            f"review convergence target SHA is stale: prepared={target or 'missing'} current={current or 'missing'}"
        )
    manifest_raw = getattr(args, "manifest", None)
    manifest_path = (
        safe_repo_path(repo, manifest_raw, default_loop_path=True)
        if manifest_raw
        else loop_path(repo) / "reviews" / "convergence" / "MANIFEST.json"
    )
    manifest = _review_manifest_from_path(manifest_path)
    expected_plan = convergence.get("review_plan")
    if isinstance(expected_plan, dict) and manifest.plan.to_record() != expected_plan:
        raise HLoopError("review convergence manifest does not match the prepared plan")

    plan_path = loop_path(repo) / "reviews" / "convergence" / "PLAN.json"
    try:
        prepared_plan = json.loads(read_text(plan_path))
    except (OSError, json.JSONDecodeError, TypeError, ValueError) as exc:
        raise HLoopError(f"invalid prepared convergence plan {plan_path}: {exc}") from exc
    prepared_round = prepared_plan.get("fix_round") if isinstance(prepared_plan, dict) else None
    if isinstance(prepared_round, bool) or not isinstance(prepared_round, int) or prepared_round < 0:
        raise HLoopError("prepared convergence plan fix_round must be a non-negative integer")
    if prepared_round != current_round:
        raise HLoopError(
            "prepared convergence plan fix_round does not match canonical fix_round"
        )

    completeness = manifest.completeness
    scope = release_scope_from_state(state)
    accepted_risk_authorizations = _resolve_review_accepted_risk_authorizations(
        state, manifest
    )
    actionable, release_blocking = _review_manifest_policy_counts(
        manifest,
        allow_legacy=scope.status == "legacy-unlocked",
        accepted_risk_authorizations=accepted_risk_authorizations,
    )
    deferred_follow_ups, _recorded_follow_ups = _require_deferred_follow_up_completeness(
        repo, state
    )
    max_rounds = review_max_fix_rounds(state, convergence)
    if current_round > max_rounds:
        raise HLoopError(
            f"canonical fix_round {current_round} exceeds max_fix_rounds {max_rounds}"
        )
    requested_round = getattr(args, "fix_round", None)
    round_number = current_round if requested_round is None else int(requested_round)
    if round_number != current_round:
        raise HLoopError(
            f"fix round {round_number} does not match canonical fix_round {current_round}; "
            "rounds advance only through review reopen"
        )

    manifest_digest = hloop_certification.canonical_digest(manifest.to_record())
    recorded_digest = str(convergence.get("recorded_manifest_digest") or "")
    recorded_round = convergence.get("recorded_round")
    if recorded_digest:
        if isinstance(recorded_round, bool) or not isinstance(recorded_round, int) or recorded_round < 0:
            raise HLoopError("recorded convergence round must be a non-negative integer")
        if recorded_round != current_round:
            raise HLoopError(
                "recorded convergence round does not match canonical fix_round"
            )
        recorded_status = str(convergence.get("recorded_status") or "")
        if recorded_digest != manifest_digest and recorded_status != "incomplete":
            raise HLoopError(
                "same-round convergence record must use the previously recorded manifest; "
                "use review reopen for a new round"
            )

    status = str(convergence.get("status") or "")
    idempotent = False
    if status != "prepared":
        if status in {"pending", "converged", "exhausted"} and recorded_digest == manifest_digest:
            idempotent = True
        else:
            raise HLoopError("review convergence must be prepared before record")

    final_status = "incomplete"
    if completeness.complete:
        final_status = "exhausted" if actionable > 0 and round_number >= max_rounds else (
            "remediation-required" if actionable > 0 else "converged"
        )

    if not args.dry_run and not idempotent:
        persist_finding_inventory(
            state,
            manifest,
            source_ref=str(manifest_path.relative_to(repo)),
        )
        state["defer_follow_up_fingerprints"] = sorted(deferred_follow_ups)
        state["accepted_risk_authorizations"] = {
            fingerprint: authorization.to_record()
            for fingerprint, authorization in accepted_risk_authorizations.items()
        }
        _update_review_execution_metrics(state, manifest, round_number)
        convergence["artifact_refs"] = [str(manifest_path.relative_to(repo))]
        convergence["verified_actionable_findings"] = actionable
        convergence["release_blocking_findings"] = release_blocking
        convergence["accepted_risk_authorizations"] = {
            fingerprint: authorization.to_record()
            for fingerprint, authorization in accepted_risk_authorizations.items()
        }
        convergence["manifest_completeness"] = completeness.to_record()
        convergence["recorded_at"] = now_iso()
        # ``fix_round`` is the canonical counter.  ``recorded_round`` is only
        # an audit echo and may never advance it or override it.
        convergence["fix_round"] = current_round
        convergence["recorded_round"] = round_number
        convergence["recorded_manifest_digest"] = manifest_digest
        convergence["recorded_status"] = final_status
        convergence["last_status"] = "complete" if completeness.complete else "incomplete"
        if not completeness.complete:
            convergence["status"] = "pending"
            convergence["last_status"] = "incomplete"
            _review_freeze(state, reason="review-convergence-incomplete")
            state["phase"] = "review_convergence"
        elif actionable > 0:
            if round_number >= max_rounds:
                convergence["status"] = "exhausted"
                convergence["last_status"] = "exhausted"
                _review_freeze(state, reason="review-convergence-rounds-exhausted")
                state["phase"] = "review_convergence_exhausted"
            else:
                convergence["status"] = "pending"
                convergence["last_status"] = "remediation-required"
                _review_freeze(state, reason="review-convergence-actionable-findings")
                state["phase"] = "review_convergence"
        else:
            convergence["status"] = "converged"
            convergence["last_status"] = "converged"
            _review_freeze(state, reason="review-convergence-converged")
            state["phase"] = "awaiting_manual_final_review"
            state["needs_review"] = False
        save_state(repo, state)
    payload_status = (
        str(convergence.get("status") or "")
        if not args.dry_run or idempotent
        else ("pending" if not completeness.complete or actionable > 0 else "converged")
    )
    payload = {
        "status": payload_status,
        "target_sha": target,
        "manifest": str(manifest_path.relative_to(repo)),
        "manifest_complete": completeness.complete,
        "manifest_issues": list(completeness.issues),
        "verified_actionable_findings": actionable,
        "release_blocking_findings": release_blocking,
        "fix_round": round_number,
        "max_fix_rounds": max_rounds,
        "automatic_reviewer_started": False,
        "dry_run": bool(args.dry_run),
    }
    print_policy_payload(payload, as_json=bool(args.json), label="review convergence recorded")
    if not completeness.complete:
        return 2
    if actionable > 0 and round_number >= max_rounds:
        return 2
    return 0


def canonical_scope_digest(value: Any, field_name: str) -> str:
    text = str(value or "").strip().lower()
    if re.fullmatch(r"[0-9a-f]{64}", text):
        return f"sha256:{text}"
    if re.fullmatch(r"sha256:[0-9a-f]{64}", text):
        return text
    raise HLoopError(f"{field_name} must be a SHA-256 digest")


def _review_reopen_scope_amendment(
    repo: Path, state: dict[str, Any], args: argparse.Namespace
) -> tuple[dict[str, Any] | None, Path | None]:
    scope_actions = {"disable-feature", "mark-experimental", "scope-amend"}
    scope_fields_present = any(
        getattr(args, name, None)
        for name in (
            "scope_kind",
            "scope_digest",
            "scope_source",
            "scope_revision",
            "source_snapshot_revision",
            "source_digests",
            "scope_reason",
            "scope_basis_ref",
        )
    )
    if args.action not in scope_actions:
        if scope_fields_present:
            raise HLoopError(
                "scope amendment fields require disable-feature, mark-experimental, or scope-amend"
            )
        return None, None

    scope = release_scope_from_state(state)
    if scope.status != "locked":
        raise HLoopError("scope-changing review reopen requires a locked release scope")
    kind = str(
        getattr(args, "scope_kind", None)
        or ("scope-change" if args.action != "scope-amend" else "scope-change")
    )
    if args.action in {"disable-feature", "mark-experimental"} and kind != "scope-change":
        raise HLoopError(f"{args.action} requires a scope-change amendment")
    reason = str(getattr(args, "scope_reason", None) or "").strip()
    if not reason:
        raise HLoopError("scope-changing review reopen requires --scope-reason")
    source_refs = _arg_list(args, "scope_source") or list(scope.source_refs)
    sources = read_scope_sources(repo, source_refs)
    existing_amendments = {ref: True for ref in scope.amendment_refs}
    amendment_dir = loop_path(repo) / "release-scope" / "amendments"
    if amendment_dir.exists():
        existing_amendments.update({path.stem: True for path in amendment_dir.glob("A[0-9][0-9][0-9].json")})
    amendment_id = next_id("A", existing_amendments)
    amendment_user_input = args.user_input_id if kind == "scope-change" else ""
    try:
        amendment = hloop_release_scope.create_amendment(
            scope,
            amendment_id=amendment_id,
            kind=kind,
            reason=reason,
            new_source_contents=sources,
            basis_refs=_arg_list(args, "scope_basis_ref"),
            user_input_id=amendment_user_input,
            affected_task_ids=_arg_list(args, "scope_affected_task_id"),
            created_at=now_iso(),
            captured_input_ids=state.get("inputs_index"),
        )
    except hloop_release_scope.ReleaseScopeError as exc:
        raise HLoopError(f"cannot create review-reopen amendment: {exc}") from exc

    if args.scope_revision is not None and args.scope_revision != amendment.new_scope_revision:
        raise HLoopError("--scope-revision does not match the actual source amendment")
    if (
        args.source_snapshot_revision is not None
        and args.source_snapshot_revision != amendment.new_source_snapshot_revision
    ):
        raise HLoopError(
            "--source-snapshot-revision does not match the actual source amendment"
        )
    if args.scope_digest is not None and canonical_scope_digest(
        args.scope_digest, "--scope-digest"
    ) != amendment.new_scope_digest:
        raise HLoopError("--scope-digest does not match the actual source amendment")
    if args.source_digests:
        try:
            provided_digests = json.loads(args.source_digests)
        except json.JSONDecodeError as exc:
            raise HLoopError(f"--source-digests must be a JSON object: {exc}") from exc
        if not isinstance(provided_digests, dict):
            raise HLoopError("--source-digests must be a JSON object")
        normalized_digests = {
            str(key): canonical_scope_digest(value, f"--source-digests[{key}]")
            for key, value in provided_digests.items()
        }
        if normalized_digests != dict(amendment.new_source_digests):
            raise HLoopError("--source-digests does not match the actual source contents")

    record = amendment.to_record()
    record["reopen_action"] = args.action
    record["reopen_user_input_id"] = args.user_input_id
    return record, amendment_dir / f"{amendment_id}.json"


def _restore_review_reopen_path(path: Path, previous: bytes | None) -> None:
    if previous is None:
        try:
            path.unlink()
        except FileNotFoundError:
            return
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(previous)


def _persist_review_reopen(
    repo: Path,
    candidate: dict[str, Any],
    amendment_record: dict[str, Any],
    amendment_path: Path,
) -> None:
    state_file = state_path(repo)
    previous_state = state_file.read_bytes()
    previous_amendment = amendment_path.read_bytes() if amendment_path.exists() else None
    if previous_amendment is not None:
        raise HLoopError(f"review-reopen amendment artifact already exists: {amendment_path}")
    try:
        write_text(
            amendment_path,
            json.dumps(amendment_record, ensure_ascii=False, indent=2) + "\n",
            durable=True,
        )
        _record_scope_expansion_metric(candidate, amendment_record)
        save_state(repo, candidate)
    except Exception as exc:
        try:
            _restore_review_reopen_path(amendment_path, previous_amendment)
            state_file.write_bytes(previous_state)
        except Exception as rollback_exc:
            raise HLoopError(
                f"review reopen persistence failed and rollback failed: {exc}; {rollback_exc}"
            ) from exc
        raise HLoopError(f"review reopen persistence failed: {exc}") from exc


def cmd_review_reopen(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    amendment_record, amendment_path = _review_reopen_scope_amendment(repo, state, args)
    scope_amendment = amendment_record
    result = hloop_certification.reopen_review(
        state,
        action=args.action,
        user_input_id=args.user_input_id,
        authorized_extra_rounds=int(args.authorized_extra_rounds or 0),
        authorization_input_id=args.authorization_input_id,
        scope_amendment=scope_amendment,
    )
    payload = {
        "accepted": result.accepted,
        "action": args.action,
        "source_phase": result.validation.source_phase,
        "issues": list(result.issues),
        "dry_run": bool(args.dry_run),
    }
    if amendment_record is not None and amendment_path is not None:
        payload["amendment"] = amendment_record
        payload["artifact"] = str(amendment_path)
    if result.accepted and not args.dry_run:
        candidate = dict(result.state)
        # certification.py uses this transient marker to explain an
        # invalidation; STATE.json has a deliberately narrower enum.
        manual = candidate.get("manual_final_review")
        if isinstance(manual, dict) and manual.get("status") == "invalidated":
            manual["invalidated_status"] = "invalidated"
            manual["status"] = "pending"
        if amendment_record is not None and amendment_path is not None:
            # ``certification.reopen_review`` clears the certification model,
            # while the CLI owns the broader readiness projection.  Reuse the
            # same invalidation boundary as ``release-scope amend`` so a
            # scope-changing reopen cannot retain a stale target, convergence
            # identity, or manual-final evidence.  Preserve the command's
            # explicit next phase after the shared reset.
            amendment_id = str(amendment_record.get("amendment_id") or "scope")
            invalidate_review_gates_for_change(
                candidate,
                reason=f"review-reopen-scope-amendment:{amendment_id}",
                target_sha=current_integration_target(repo, candidate),
            )
            candidate["phase"] = (
                "review_readiness"
                if args.action == "scope-amend"
                else "review_convergence"
            )
            _persist_review_reopen(repo, candidate, amendment_record, amendment_path)
        else:
            save_state(repo, candidate)
        journal(repo, f"Applied review reopen action `{args.action}` from `{result.validation.source_phase}`.")
        payload["phase"] = candidate.get("phase")
        payload["dispatch_freeze"] = candidate.get("dispatch_freeze")
    print_policy_payload(payload, as_json=bool(args.json), label="review reopen")
    return 0 if result.accepted else 2


def cmd_final_review_prepare(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    ensure_loop_dirs(repo)
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    convergence = state.get("review_convergence")
    if not isinstance(convergence, dict) or convergence.get("status") != "converged":
        raise HLoopError("final review requires converged pre-final review evidence")
    target = str(convergence.get("target_sha") or "")
    current = current_integration_target(repo, state)
    if not target or target != current:
        raise HLoopError(
            f"final review target SHA is stale: converged={target or 'missing'} current={current or 'missing'}"
        )
    deferred_follow_ups, _recorded_follow_ups = _require_deferred_follow_up_completeness(
        repo, state
    )
    certification_id = str(getattr(args, "certification_id", None) or _next_certification_id(state))
    paths = _final_paths(repo)
    plan, group = _final_certification_plan(
        repo,
        state,
        target,
        certification_id=certification_id,
        base_sha=str(convergence.get("base_sha") or ""),
        mode=getattr(args, "mode", None),
        providers=getattr(args, "providers", None),
        probe_count=getattr(args, "probe_count", None),
        probes_per_provider=getattr(args, "probes_per_provider", None),
    )
    review_manifest = hloop_review.ReviewManifest(
        review_id="R001",
        plan=group,
        lane_results=(),
        findings=(),
        verification_plan=hloop_review.plan_verification(group, ()),
        verifications=(),
    )
    final_manifest = hloop_certification.FinalReviewManifest.from_review_manifest(
        plan, review_manifest, verified_actionable_findings=0, patch_verdict="passed"
    )
    if not args.dry_run:
        state["defer_follow_up_fingerprints"] = sorted(deferred_follow_ups)
        _write_json_artifact(paths["plan"], plan.to_record())
        _write_json_artifact(paths["manifest"], final_manifest.to_record())
        write_text(
            paths["report"],
            frontmatter(
                {
                    "protocol": plan.protocol,
                    "certification_id": plan.certification_id,
                    "prepared_plan_digest": plan.digest,
                    "base_sha": plan.base_sha,
                    "target_sha": plan.target_sha,
                    "scope_revision": plan.scope_revision,
                    "source_snapshot_revision": plan.source_snapshot_revision,
                    "source_digest": plan.source_digest,
                    "lane_count": len(plan.lane_plan),
                    "lane_names": [],
                    "lane_outcomes": [],
                    "coordinator_session_id": "",
                    "diff_inventory": [],
                    "verification_records": [],
                    "verification_shortfall": "",
                    "incomplete_findings": [],
                    "manifest_complete": False,
                    "verified_actionable_findings": "",
                    "findings": [],
                    "residual_risks": [],
                    "follow_up_refs": [],
                    "patch_verdict": "",
                    "completed_at": "",
                }
            )
            + "\n# Manual Final Review\n\n"
            f"Certification: `{certification_id}`\n\n"
            "Replace this template with the completed lane, inventory, verification, risk, "
            "follow-up, verdict, and timestamp evidence before running `hloop final-review record`.\n",
        )
        manual = state.setdefault("manual_final_review", {})
        manual.update(
            {
                "status": "prepared",
                "certification_id": certification_id,
                "target_sha": target,
                "prepared_plan": str(paths["plan"].relative_to(repo)),
                "prepared_plan_digest": plan.digest,
                "manifest": str(paths["manifest"].relative_to(repo)),
                "report": str(paths["report"].relative_to(repo)),
                "manifest_complete": False,
                "shortfall_count": None,
                "verified_actionable_findings": None,
                "release_blocking_findings": None,
                "lane_completed_count": 0,
                "lane_count": len(plan.lane_plan),
                "prepared_at": now_iso(),
            }
        )
        _review_freeze(state, reason="manual-final-review-prepared")
        state["phase"] = "awaiting_manual_final_review"
        state["needs_review"] = False
        save_state(repo, state)
        journal(repo, f"Prepared manual final review `{certification_id}` for `{target}`.")
    payload = {
        "status": "prepared",
        "certification_id": certification_id,
        "target_sha": target,
        "plan": str(paths["plan"].relative_to(repo)),
        "manifest": str(paths["manifest"].relative_to(repo)),
        "report": str(paths["report"].relative_to(repo)),
        "plan_digest": plan.digest,
        "automatic_reviewer_started": False,
        "dry_run": bool(args.dry_run),
    }
    print_policy_payload(payload, as_json=bool(args.json), label="manual final review prepared")
    return 0


def cmd_final_review_record(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    manual = state.get("manual_final_review")
    if not isinstance(manual, dict) or not manual.get("prepared_plan"):
        raise HLoopError("manual final review must be prepared before record")
    paths = _final_paths(repo)
    plan_path = safe_repo_path(repo, str(manual.get("prepared_plan")), default_loop_path=False)
    manifest_path = (
        safe_repo_path(repo, args.manifest, default_loop_path=True)
        if getattr(args, "manifest", None)
        else safe_repo_path(repo, str(manual.get("manifest") or paths["manifest"]), default_loop_path=False)
    )
    report_path = (
        safe_repo_path(repo, args.report, default_loop_path=True)
        if getattr(args, "report", None)
        else safe_repo_path(repo, str(manual.get("report") or paths["report"]), default_loop_path=False)
    )
    try:
        plan = hloop_certification.CertificationPlan.from_record(json.loads(read_text(plan_path)))
        evidence = hloop_certification.FinalReviewManifest.from_record(
            json.loads(read_text(manifest_path))
        )
    except (OSError, json.JSONDecodeError, TypeError, ValueError, KeyError, hloop_certification.CertificationModelError) as exc:
        raise HLoopError(f"invalid manual final review artifact: {exc}") from exc
    current = current_integration_target(repo, state)
    scope = release_scope_from_state(state)
    allow_legacy = scope.status == "legacy-unlocked"
    accepted_risk_authorizations = _resolve_review_accepted_risk_authorizations(
        state, evidence.review_manifest
    )
    validation = hloop_certification.validate_final_review(
        plan,
        evidence,
        current_target_sha=current,
        allow_legacy=allow_legacy,
        accepted_risk_authorizations=accepted_risk_authorizations,
    )
    policy_issues = [
        issue for issue in validation.issues if issue.startswith("policy:")
    ]
    if policy_issues:
        raise HLoopError(
            "manual final review disposition policy: " + "; ".join(policy_issues)
        )
    actionable = evidence.recomputed_verified_actionable_count_for_scope(
        allow_legacy=allow_legacy
    )
    release_blocking = evidence.recomputed_verified_release_blocking_count_for_scope(
        allow_legacy=allow_legacy
    )
    if not report_path.is_file() or not read_text(report_path).strip():
        raise HLoopError(f"manual final review report is missing or empty: {report_path}")
    if report_path.resolve() != paths["report"].resolve():
        raise HLoopError("manual final review report must use reviews/final/FINAL.md")
    report_issues = _manual_final_report_issues(
        repo,
        plan,
        evidence,
        report_path,
        allow_legacy=allow_legacy,
    )
    validation_issues = sorted(set((*validation.issues, *report_issues)))
    report_values: dict[str, list[str]] = {}
    if not report_issues:
        try:
            report_record = read_frontmatter(report_path)
        except (OSError, HLoopError):
            report_record = {}
        report_values, _ = _manual_final_report_list_values(report_record)
    status = validation.status
    if report_issues and status == "passed":
        status = "incomplete"
    if not args.dry_run:
        persist_finding_inventory(
            state,
            evidence.review_manifest,
            source_ref=str(manifest_path.relative_to(repo)),
        )
        state["accepted_risk_authorizations"] = {
            fingerprint: authorization.to_record()
            for fingerprint, authorization in accepted_risk_authorizations.items()
        }
        manual["status"] = status
        manual["certification_id"] = plan.certification_id
        manual["target_sha"] = plan.target_sha
        manual["prepared_plan"] = str(plan_path.relative_to(repo))
        manual["prepared_plan_digest"] = plan.digest
        manual["manifest"] = str(manifest_path.relative_to(repo))
        manual["report"] = str(report_path.relative_to(repo))
        manual["manifest_complete"] = evidence.completeness.complete
        manual["shortfall_count"] = len(evidence.review_manifest.verification_plan.shortfalls)
        manual["verified_actionable_findings"] = actionable
        manual["release_blocking_findings"] = release_blocking
        manual["accepted_risk_authorizations"] = {
            fingerprint: authorization.to_record()
            for fingerprint, authorization in accepted_risk_authorizations.items()
        }
        manual["validation_issues"] = validation_issues
        manual.setdefault("attempt_history", []).append(
            {
                "certification_id": plan.certification_id,
                "status": status,
                "target_sha": plan.target_sha,
                "issues": validation_issues,
                "recorded_at": now_iso(),
            }
        )
        manual["incomplete_attempt_count"] = sum(
            1
            for item in manual["attempt_history"]
            if isinstance(item, Mapping) and item.get("status") == "incomplete"
        )
        manual["lane_count"] = len(plan.lane_plan)
        manual["lane_completed_count"] = sum(
            1
            for result in evidence.review_manifest.lane_results
            if result.status == "completed"
        )
        for field_name in _MANUAL_FINAL_REPORT_LIST_ALIASES:
            if field_name in report_values:
                manual[field_name] = report_values[field_name]
            else:
                manual.pop(field_name, None)
        if status == "passed":
            state["phase"] = "manual_final_review_passed"
        elif status == "incomplete":
            state["phase"] = "manual_final_review_incomplete"
            _review_freeze(state, reason="manual-final-review-incomplete")
        else:
            state["phase"] = "manual_final_review_failed"
            _review_freeze(state, reason="manual-final-review-failed")
        save_state(repo, state)
        journal(repo, f"Recorded manual final review `{plan.certification_id}` with status `{status}`.")
    payload = {
        "status": status,
        "certification_id": plan.certification_id,
        "target_sha": plan.target_sha,
        "current_target_sha": current,
        "manifest_complete": evidence.completeness.complete,
        "verified_actionable_findings": actionable,
        "release_blocking_findings": release_blocking,
        "accepted_risks": [
            authorization.to_record()
            for authorization in accepted_risk_authorizations.values()
        ],
        "residual_risks": report_values.get("residual_risks", []),
        "follow_up_refs": report_values.get("follow_up_refs", []),
        "issues": validation_issues,
        "plan": str(plan_path.relative_to(repo)),
        "manifest": str(manifest_path.relative_to(repo)),
        "report": str(report_path.relative_to(repo)),
        "dry_run": bool(args.dry_run),
    }
    print_policy_payload(payload, as_json=bool(args.json), label="manual final review recorded")
    return 0 if status == "passed" and not report_issues and validation.passed else 2


def cmd_final_review_status(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = load_state(repo)
    manual = state.get("manual_final_review") if isinstance(state.get("manual_final_review"), dict) else {}
    paths = _final_paths(repo)
    target = current_integration_target(repo, state)
    payload = {
        "status": manual.get("status", "pending"),
        "certification_id": manual.get("certification_id", ""),
        "target_sha": manual.get("target_sha", ""),
        "current_target_sha": target,
        "target_sha_drift": bool(manual.get("target_sha") and manual.get("target_sha") != target),
        "plan": manual.get("prepared_plan") or str(paths["plan"].relative_to(repo)),
        "manifest": manual.get("manifest") or str(paths["manifest"].relative_to(repo)),
        "report": manual.get("report") or str(paths["report"].relative_to(repo)),
        "manifest_complete": manual.get("manifest_complete"),
        "shortfall_count": manual.get("shortfall_count"),
        "verified_actionable_findings": manual.get("verified_actionable_findings"),
        "release_blocking_findings": manual.get("release_blocking_findings"),
        "lane_completed_count": manual.get("lane_completed_count", 0),
        "lane_count": manual.get("lane_count", 0),
        "incomplete_attempt_count": manual.get("incomplete_attempt_count", 0),
        "dispatch_freeze": dispatch_freeze_record(state),
        "phase": state.get("phase"),
    }
    print_policy_payload(payload, as_json=bool(args.json), label="manual final review status")
    return 0


def advancing_commit_count(repo: Path, old_sha: str, new_sha: str) -> int | None:
    if not old_sha or not new_sha or not is_ancestor(repo, old_sha, new_sha):
        return None
    proc = run_cmd(
        [TRUSTED_GIT_PATH, "-C", str(repo), "rev-list", "--count", f"{old_sha}..{new_sha}"],
        check=False,
    )
    if proc.returncode != 0:
        return None
    try:
        return int((proc.stdout or "").strip())
    except ValueError:
        return None


def final_gate_from_state(state: dict[str, Any]) -> FinalGateArm | None:
    record = state.get("final_gate")
    if not isinstance(record, dict):
        return None
    try:
        return FinalGateArm(
            generation=normalize_int(record.get("generation"), 0),
            status=str(record.get("status") or ""),
            target_sha=str(record.get("target_sha") or ""),
            armed_at=str(record.get("armed_at") or ""),
            armed_by=str(record.get("armed_by") or ""),
            disarmed_at=str(record.get("disarmed_at") or ""),
            disarmed_by=str(record.get("disarmed_by") or ""),
            disarm_reason=str(record.get("disarm_reason") or ""),
        )
    except ValueError:
        return None


def final_gate_conditions(state: dict[str, Any]) -> FinalGateConditions:
    batches = state.get("batches", {})
    current_id = str(state.get("current_batch_id") or "")
    closed_batches = [
        batch
        for batch in batches.values()
        if isinstance(batch, dict) and str(batch.get("status") or "") in {"closed", "abandoned"}
    ]
    batch_closed = not current_id and bool(closed_batches)
    review_triage_complete = not any(
        agent_gate_status(review) in {"running", "reported", "reported_unharvested"}
        for review in state.get("reviews", {}).values()
    )
    return FinalGateConditions(
        current_batch_closed=batch_closed,
        review_triage_complete=review_triage_complete,
        pending_fix_task_drafts=tuple(normalize_list(state.get("pending_fix_task_drafts"))),
    )


def disarm_final_gate_for_new_task(state: dict[str, Any], task_id: str) -> None:
    current = final_gate_from_state(state)
    if current is None or current.status != "armed":
        return
    state["final_gate"] = disarm_final_gates(
        current,
        disarmed_by=os.environ.get("HERDR_PANE_ID") or "manager",
        disarmed_at=now_iso(),
        reason=f"new task created: {task_id}",
    ).to_record()


def cmd_final_gates_arm(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    state = preflight_loop(repo, require_integration_branch=True, mark_blocked=False)
    if not all_tasks_merged(state):
        raise HLoopError("cannot arm final gates before all tasks are merged")
    running = running_agent_ids(state)
    if running:
        raise HLoopError("cannot arm final gates while roles are running: " + ", ".join(running))
    target = current_integration_target(repo, state)
    try:
        armed = arm_final_gates(
            final_gate_from_state(state),
            target_sha=target,
            armed_by=args.armed_by or os.environ.get("HERDR_PANE_ID") or "manager",
            armed_at=now_iso(),
            conditions=final_gate_conditions(state),
        )
    except LifecycleInvariantError as exc:
        raise HLoopError("cannot arm final gates: " + "; ".join(item.message for item in exc.issues)) from exc
    state["final_gate"] = armed.to_record()
    save_state(repo, state)
    journal(repo, f"Armed final gates generation `{armed.generation}` for `{target}`.")
    print(f"final gates armed for {target} (generation {armed.generation})")
    return 0


def gate_evidence_for_resume(state: dict[str, Any]) -> tuple[GateEvidence, ...]:
    validation = state.get("last_validation", {})
    validation_results = validation.get("results", [])
    validation_passed = bool(validation_results) and all(
        item.get("result") == "passed" for item in validation_results
    )

    def latest_closed_record(records: dict[str, Any]) -> dict[str, Any]:
        for record in reversed(list(records.values())):
            if isinstance(record, dict) and agent_gate_status(record) == "triaged":
                return record
        return {}

    review_record = latest_closed_record(state.get("reviews", {}))
    gap_record = latest_closed_record(state.get("gaps", {}))
    manager_qa_status = str(state.get("manager_qa_status") or "")
    manager_qa_passed = manager_qa_status in MANAGER_QA_PASSING_STATUSES
    return (
        GateEvidence(
            "validation",
            "passed" if validation_passed else "",
            str(validation.get("head_sha") or ""),
            required=validation_passed,
        ),
        GateEvidence(
            "review",
            "passed" if review_record else "",
            str(review_record.get("closed_head_sha") or review_record.get("head_sha") or ""),
            required=(
                normalize_int(state.get("max_reviewers"), DEFAULT_MAX_REVIEWERS) > 0
                and bool(review_record)
            ),
        ),
        GateEvidence(
            "gap",
            "passed" if gap_record else "",
            str(gap_record.get("closed_head_sha") or gap_record.get("head_sha") or ""),
            required=(
                normalize_int(state.get("max_gap_auditors"), DEFAULT_MAX_GAP_AUDITORS) > 0
                and bool(gap_record)
            ),
        ),
        GateEvidence(
            "manager-qa",
            manager_qa_status if manager_qa_passed else "",
            str(state.get("manager_qa_head_sha") or state.get("completion_target_sha") or ""),
            passing_statuses=("passed", "accepted-risk", "not-required"),
            required=state_manager_qa_profile(state) != "none" and manager_qa_passed,
        ),
    )


def lifecycle_resume_requirements(repo: Path, state: dict[str, Any]) -> list[dict[str, str]]:
    target = current_integration_target(repo, state)
    if not target:
        return []
    blockers = [
        f"decision {decision_id}" for decision_id in pending_blocking_user_decisions(state)
    ]
    if state.get("active_merge"):
        blockers.append("active merge transaction")
    requirements = compute_resume_requirements(
        current_target_sha=target,
        gates=gate_evidence_for_resume(state),
        active_blockers=blockers,
        dirty_paths=unsafe_dirty_paths(repo),
        running_roles=running_agent_ids(state),
    )
    return [
        {
            "code": item.code,
            "subject": item.subject,
            "reason": item.reason,
            "target_sha": item.target_sha,
            "observed_sha": item.observed_sha,
        }
        for item in requirements
    ]


def review_after_merges(state: dict[str, Any]) -> int:
    return max(1, normalize_int(state.get("review_after_merges"), DEFAULT_REVIEW_AFTER_MERGES))


def gap_after_merges(state: dict[str, Any]) -> int:
    return max(1, normalize_int(state.get("gap_after_merges"), DEFAULT_GAP_AFTER_MERGES))


def final_strict_gate_armed(state: dict[str, Any]) -> bool:
    """Whether the Manager has explicitly armed the final strict gates.

    Cadence review/gap gates during ongoing dispatch are unaffected by this;
    only the "all tasks are merged" final-completion trigger requires it, so
    a single explicit `hloop final-gates arm` -- not just merging the last
    task -- decides when strict final review/gap replace the periodic cadence.
    """

    final_gate = final_gate_from_state(state)
    return final_gate is not None and final_gate.status == "armed"


def should_open_review_gate(state: dict[str, Any]) -> bool:
    if int(state.get("max_reviewers", DEFAULT_MAX_REVIEWERS)) <= 0:
        return False
    policy = review_policy_record(state)
    convergence = state.get("review_convergence")
    manual = state.get("manual_final_review")
    if manual_final_review_required(state) and (
        isinstance(convergence, dict)
        and convergence.get("status") in {"prepared", "converged", "exhausted"}
        or isinstance(manual, dict)
        and manual.get("status") in {"prepared", "running", "passed", "failed", "incomplete"}
    ):
        # The explicit convergence/final-review commands own these gates; a
        # normal tick must never silently replace a fixed-target plan.
        return False
    if state.get("needs_review") or pending_review_exists(state):
        return False
    if policy.get("cadence") == "batch" and isinstance(state.get("review_policy"), dict):
        if current_batch_id(state) or not closed_batch_tasks_merged(state):
            return False
        if not last_validation_passed(state):
            return False
        count = normalize_int(state.get("unreviewed_merge_count"), 0)
        return count > 0 and not final_strict_gate_armed(state)
    count = normalize_int(state.get("unreviewed_merge_count"), 0)
    if count >= review_after_merges(state):
        return True
    if not all_tasks_merged(state) or not final_strict_gate_armed(state):
        return False
    return count > 0 or not review_gate_passed(state)


def should_open_gap_gate(state: dict[str, Any]) -> bool:
    if int(state.get("max_gap_auditors", DEFAULT_MAX_GAP_AUDITORS)) <= 0:
        return False
    if state.get("needs_gap_check") or pending_gap_exists(state):
        return False
    count = normalize_int(state.get("ungapped_merge_count"), 0)
    if count >= gap_after_merges(state):
        return True
    if not all_tasks_merged(state) or not final_strict_gate_armed(state):
        return False
    return count > 0 or not gap_gate_passed(state)


def review_wait_ms(args: argparse.Namespace, state: dict[str, Any]) -> int:
    raw = getattr(args, "review_wait_ms", None)
    if raw is None:
        raw = state.get("review_wait_ms", DEFAULT_REVIEW_WAIT_MS)
    try:
        return max(0, int(raw))
    except (TypeError, ValueError) as exc:
        raise HLoopError(f"invalid review_wait_ms: {raw}") from exc


def gap_wait_ms(args: argparse.Namespace, state: dict[str, Any]) -> int:
    raw = getattr(args, "gap_wait_ms", None)
    if raw is None:
        raw = state.get("gap_wait_ms", DEFAULT_GAP_WAIT_MS)
    try:
        return max(0, int(raw))
    except (TypeError, ValueError) as exc:
        raise HLoopError(f"invalid gap_wait_ms: {raw}") from exc


def wait_for_running_review(
    repo: Path,
    state: dict[str, Any],
    review_id: str,
    review: dict[str, Any],
    wait_ms: int,
) -> bool:
    path = review_artifact_path(repo, review_id, review)
    if artifact_readiness(repo, state, review_id, "reviewer", review, path)[0]:
        return True
    pane_id = str(review.get("pane_id") or "")
    if wait_ms <= 0 or not pane_id or os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        return False
    proc = run_cmd(
        [
            "herdr",
            "wait",
            "output",
            pane_id,
            "--match",
            f"HERDR_LOOP_REVIEW_DONE:{review_id}:",
            "--source",
            "recent-unwrapped",
            "--timeout",
            str(wait_ms),
        ],
        check=False,
    )
    if proc.returncode == 0:
        review["last_wait_result"] = "done-marker"
    else:
        review["last_wait_result"] = "timeout"
    review["last_waited_at"] = now_iso()
    return artifact_readiness(repo, state, review_id, "reviewer", review, path)[0]


def wait_for_running_gap(
    repo: Path,
    state: dict[str, Any],
    gap_id: str,
    gap: dict[str, Any],
    wait_ms: int,
) -> bool:
    path = gap_artifact_path(repo, gap_id, gap)
    if artifact_readiness(repo, state, gap_id, "gap", gap, path)[0]:
        return True
    pane_id = str(gap.get("pane_id") or "")
    if wait_ms <= 0 or not pane_id or os.environ.get("HERDR_ENV") != "1" or not command_exists("herdr"):
        return False
    proc = run_cmd(
        [
            "herdr",
            "wait",
            "output",
            pane_id,
            "--match",
            f"HERDR_LOOP_GAP_DONE:{gap_id}:",
            "--source",
            "recent-unwrapped",
            "--timeout",
            str(wait_ms),
        ],
        check=False,
    )
    if proc.returncode == 0:
        gap["last_wait_result"] = "done-marker"
    else:
        gap["last_wait_result"] = "timeout"
    gap["last_waited_at"] = now_iso()
    return artifact_readiness(repo, state, gap_id, "gap", gap, path)[0]


def state_value(state: dict[str, Any], key: str, default: str) -> str:
    value = str(state.get(key) or default)
    return value


def state_worker_qa_profile(state: dict[str, Any]) -> str:
    return str(
        state.get("worker_qa_profile")
        or state.get("qa_profile")
        or DEFAULT_WORKER_QA_PROFILE
    )


def state_manager_qa_profile(state: dict[str, Any]) -> str:
    return str(state.get("manager_qa_profile") or DEFAULT_MANAGER_QA_PROFILE)


def args_worker_qa_profile(args: argparse.Namespace) -> str:
    return str(
        getattr(args, "worker_qa_profile", None)
        or getattr(args, "qa_profile", None)
        or DEFAULT_WORKER_QA_PROFILE
    )


def manager_qa_required(state: dict[str, Any]) -> bool:
    return state_manager_qa_profile(state) != "none"


def manager_qa_passed(state: dict[str, Any]) -> bool:
    if not manager_qa_required(state):
        return True
    target = str(state.get("completion_target_sha") or state.get("integration_head_sha") or "")
    return str(state.get("manager_qa_status") or "") in MANAGER_QA_PASSING_STATUSES and (
        not target or str(state.get("manager_qa_head_sha") or "") == target
    )


def state_list(state: dict[str, Any], key: str, default: list[str]) -> list[str]:
    return normalize_list(state.get(key)) or list(default)


def worker_protocol_text(protocol: str, worker_qa_profile: str, base_ref: str) -> str:
    if protocol == "codex-impl":
        return f"""Compatibility mode:
- You may use $codex-impl for this bounded task.
- Manager has fixed kickoff choices for this task:
  - implementation gap-check count: 1
  - review/fix loop limit: skip review unless this task explicitly requires it
  - Worker QA profile: {worker_qa_profile}
  - QA target diff: this task branch against {base_ref}
- Do not ask the user for codex-impl preflight choices; Manager already owns them.
"""
    return f"""HLoop Worker Protocol:
1. Re-read MISSION, PLAN, DECISIONS, PROFILE, and your task contract.
2. Inspect the current code enough to verify the task is still valid.
3. Compare the task acceptance criteria against the implementation before editing.
4. Implement the smallest coherent change inside your write scope.
5. Self-review the diff for correctness, product behavior, security/privacy, data integrity, UX, and validation risk.
6. Run repository-appropriate validation for the changed surface and the task validation minimum.
7. Apply Worker QA profile `{worker_qa_profile}`:
   - `repo-default`: choose the repo's documented local checks, scripts, or CI-equivalent commands.
   - `local`: run local app/API/browser checks when the touched workflow is runnable.
   - `staging` or `preview`: collect evidence only when the target URL/credentials are already available in the task or PROFILE; otherwise report blocked QA explicitly.
   - `custom`: follow PROFILE.md and task instructions exactly.
   - `none`: record why QA is intentionally skipped.
8. Write the result artifact and commit your branch.

Manager final QA is a separate gate. Do not treat staging/preview final QA as your task's done condition unless the task contract explicitly says so.

Do not invoke another broad implementation orchestration skill unless the task explicitly opts into one.
"""


def review_protocol_text(
    protocol: str,
    lanes: list[str],
    worker_qa_profile: str,
    manager_qa_profile: str,
    branch_strategy: str,
) -> str:
    lane_lines = "\n".join(f"- {lane}" for lane in lanes)
    if protocol == "codex-review-multi-v2":
        return f"""Compatibility mode:
- You may use $codex-review-multi-v2, but still produce the HLoop artifact and Fix Task Candidates section.
- Review lanes requested by Manager:
{lane_lines}
- Branch strategy: {branch_strategy}
- Worker QA profile to assess: {worker_qa_profile}
- Manager final QA profile to assess: {manager_qa_profile}
"""
    return f"""HLoop Native Review Protocol:
Review the integration result as a Manager gate, not as a generic code review. Use these lanes:
{lane_lines}

Mandatory review sequence:
1. Build the review inventory:
   - `git diff --name-status <base-branch>...<integration-branch>`
   - `git diff --stat <base-branch>...<integration-branch>`
   - task/result artifacts, validation logs, and PROFILE/PLAN/DECISIONS.
2. Read changed files plus the nearest callers, callees, tests, schemas, migrations, generated-code sources, and CI/workflow files needed to verify behavior.
3. Cross-check each Worker result against actual changed files, write scopes, validation commands, Worker QA profile `{worker_qa_profile}`, and acceptance criteria.
4. For every candidate finding, prove the trigger path in the current code. Discard it if the scenario is speculative, pre-existing and unrelated, or unsupported by code evidence.
5. For validation or QA gaps, name the exact missing evidence and the product risk it leaves open. Separate Worker-local QA gaps from Manager final QA gaps.
6. Prefer fewer high-confidence findings over broad checklists.

Lane meanings:
- `integration-contract`: task/result artifacts, write-scope boundaries, merge safety, generated-code boundaries, and state consistency.
- `correctness`: user-visible behavior, edge cases, API/schema contracts, backward compatibility, and repository conventions.
- `risk`: security, auth/authorization, privacy, tenant scope, data integrity, concurrency, idempotency, migrations, performance, rollback, and observability.
- `validation-qa`: whether validation commands, logs, Worker QA profile `{worker_qa_profile}`, Manager final QA profile `{manager_qa_profile}`, and evidence are sufficient for the changed product surface.
- `ux`: visual/interaction/accessibility/copy risks only when UI is touched.
- Custom lane names from PROFILE.md should be interpreted literally and kept actionable.

Branch strategy under review: `{branch_strategy}`. Judge findings against that strategy and the repository's product workflow, not against a fixed branch model.

Do not invoke a generic multi-review skill unless PROFILE.md or the task explicitly opts into one.
"""


def parse_participant_spec(spec: str) -> dict[str, str]:
    raw = str(spec or "").strip()
    if not raw:
        raise HLoopError("advisor participant spec is empty")
    if ":" in raw:
        provider, model = raw.split(":", 1)
    else:
        provider, model = raw, DEFAULT_AGENT_MODEL
    return {
        "provider": normalize_agent_provider(provider),
        "model": normalize_agent_model(model),
    }


def advisor_participants_from_args(args: argparse.Namespace, state: dict[str, Any]) -> list[dict[str, Any]]:
    specs = normalize_list(getattr(args, "participant", None))
    if not specs:
        config = role_agent_config(state, "advisor")
        specs = [f"{config['provider']}:{config['model']}"]
    participants = []
    for index, spec in enumerate(specs, start=1):
        parsed = parse_participant_spec(spec)
        participants.append(
            {
                "participant_id": f"P{index}",
                "provider": parsed["provider"],
                "model": parsed["model"],
                "status": "queued",
            }
        )
    return participants


def render_advisor_prompt(
    advice_id: str,
    participant: dict[str, Any],
    advice_state: dict[str, Any],
    state: dict[str, Any],
    output_rel: Path,
    head_sha: str = "",
    report_credential_file: str = "",
    task_contract_digest: str = "",
    attempt_id: str = "",
) -> str:
    participant_id = str(participant.get("participant_id") or "P1")
    provider = str(participant.get("provider") or DEFAULT_AGENT_PROVIDER)
    model = str(participant.get("model") or DEFAULT_AGENT_MODEL)
    topic = str(advice_state.get("topic") or "")
    mode = str(advice_state.get("mode") or DEFAULT_ADVISOR_MODE)
    max_rounds = advisor_max_rounds(state, advice_state)
    dialogue_round = int(participant.get("dialogue_round") or (1 if mode == "dialogue" else 0))
    sources = normalize_list(advice_state.get("source_refs"))
    source_lines = "\n".join(f"- {item}" for item in sources) or "- No specific source artifact was provided."
    peer_paths = [
        str(item.get("advice_path"))
        for item in advice_state.get("participants", [])
        if item.get("participant_id") != participant_id and item.get("advice_path")
    ]
    peer_lines = "\n".join(f"- {item}" for item in peer_paths) or "- No peer advice artifact is available yet."
    return f"""You are Advisor {advice_id}/{participant_id}.

You are an opt-in consultation agent for the HLoop Manager.

HLoop skill version: {SKILL_VERSION}
In your first progress message, state `herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Advisor {advice_id}/{participant_id}` before investigation.

Agent backend:
- provider: {provider}
- model: {model}

Consultation mode: {mode}
Dialogue round: {dialogue_round}
Dialogue max rounds: {max_rounds}

Topic:
{topic}

Read first:
- {LOOP_DIR.as_posix()}/MISSION.md
- {LOOP_DIR.as_posix()}/PLAN.md
- {LOOP_DIR.as_posix()}/PROFILE.md
- {LOOP_DIR.as_posix()}/DECISIONS.md
- {LOOP_DIR.as_posix()}/STATE.json

Source artifacts or code references:
{source_lines}

Peer advice artifacts for bounded cross-model dialogue:
{peer_lines}
{report_contract_text(f"{advice_id}/{participant_id}", attempt_id or f"{advice_id}-{participant_id}-A001", state, report_credential_file=report_credential_file, task_contract_digest=task_contract_digest)}

Rules:
- Do not edit code.
- Do not modify Manager-owned loop files other than your required advice artifact.
- Do not create tasks, close review/gap gates, or make final decisions.
- You may recommend a fix strategy, a better specification shape, accepted-risk rationale, or a decision record.
- If the choice requires user preference, product policy, external approval, secrets, or production risk acceptance, say that Manager must ask the user.
- If the choice can be resolved from repository evidence, plan/spec sources, and existing decisions, give a concrete recommendation.
- In dialogue mode, address peer advice directly when present; otherwise produce an independent first-round memo.
- Do not continue open-ended debate; Manager enforces the dialogue max rounds.

Required output:
- Write only {output_rel.as_posix()}.
- Include frontmatter: advice_id, participant_id, run_id: {str(state.get("run_id") or "")}, skill_version: {SKILL_VERSION}, head_sha: {head_sha}, provider, model, status: advised|blocked|failed.
- Include sections:
  - ## Recommendation
  - ## Reasoning
  - ## Tradeoffs
  - ## Suggested Manager Action
  - ## User Escalation Needed

Final terminal line:
HERDR_LOOP_ADVICE_DONE:{advice_id}:{participant_id}:<advised|blocked|failed>
"""


def report_contract_text(
    role_id: str,
    attempt_id: str,
    state: dict[str, Any],
    *,
    report_credential_file: str,
    task_contract_digest: str,
) -> str:
    if not report_credential_file:
        return ""
    run_id = str(state.get("run_id") or "local")
    credential_ref = shlex.quote(str(report_credential_file))
    return f"""
Reporting: send ack, milestone, attention, and completion reports as your understanding, risk, or progress changes (see skills/herdr-dev-loop/references/report-protocol.md). Every report must include the exact identity below:
```
python3 {Path(__file__).resolve()} {loop_namespace_flag()} agent report \\
  --role-id {role_id} --attempt-id {attempt_id} --run-id {run_id} \\
  --task-contract-digest {task_contract_digest} --report-credential-file {credential_ref} \\
  --invocation-id {attempt_id}:report/0001 \\
  --type ack --stage <stage> --summary '<summary>' --next '<next action>' ...
```
Generate a new shell-safe invocation ID for each logical report. It must start
with an ASCII alphanumeric character and then use only ASCII alphanumerics or
`.`, `_`, `:`, `/`, `-`. Reuse that exact ID for every retry of the same report,
and finish its retry before sending a newer logical report.
After the initial read-only investigation, send the semantic `ack` and stop before material work. Resume only after the Manager explicitly approves that ACK and sends the approval notice. A reject or timeout requires a corrected, new ACK event.
"""


def register_role_report_identity(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    attempt_id: str,
    task_contract_digest: str,
) -> str:
    """Register one fail-closed report identity and return its attempt-scoped token."""

    token, _ = _register_role_report_identity_and_ack_floor(
        repo,
        state,
        role_id=role_id,
        attempt_id=attempt_id,
        task_contract_digest=task_contract_digest,
    )
    return token


def register_role_report_identity_and_ack_floor(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    attempt_id: str,
    task_contract_digest: str,
) -> tuple[Path, int]:
    """Register an identity and persist its credential outside the worktree."""

    token, ack_floor = _register_role_report_identity_and_ack_floor(
        repo,
        state,
        role_id=role_id,
        attempt_id=attempt_id,
        task_contract_digest=task_contract_digest,
    )
    credential_file = write_role_report_credential(
        repo,
        state,
        role_id=role_id,
        attempt_id=attempt_id,
        token=token,
    )
    return credential_file, ack_floor


def _register_role_report_identity_and_ack_floor(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    attempt_id: str,
    task_contract_digest: str,
) -> tuple[str, int]:
    """Register an identity and return its in-memory token and ACK watermark."""

    token = secrets.token_hex(32)
    store = _open_broker_store(repo)
    with store.transaction() as transaction:
        latest_ack = store.latest_role_event(
            transaction,
            run_id=str(state.get("run_id") or "local"),
            role_id=role_id,
            attempt_id=attempt_id,
            report_type="ack",
        )
        store.register_active_role(
            transaction,
            run_id=str(state.get("run_id") or "local"),
            role_id=role_id,
            attempt_id=attempt_id,
            task_contract_digest=task_contract_digest,
            token=token,
        )
    return token, int((latest_ack or {}).get("sequence") or 0)


def rebind_role_report_contract_digest(
    repo: Path,
    state: dict[str, Any],
    *,
    role_id: str,
    attempt_id: str,
    task_contract_digest: str,
) -> int:
    """Append a new digest binding while preserving the attempt's secret token."""

    store = _open_broker_store(repo)
    run_id = str(state.get("run_id") or "local")
    with store.transaction() as transaction:
        current = store._latest_active_role(  # noqa: SLF001 - same-runtime storage contract
            transaction, run_id=run_id, role_id=role_id
        )
        if current is None or not normalize_bool(current.get("active")):
            raise HLoopError(f"active report identity is missing for {role_id}")
        if str(current.get("attempt_id") or "") != attempt_id:
            raise HLoopError(
                f"active report identity attempt mismatch for {role_id}: "
                f"expected {attempt_id}, got {current.get('attempt_id')}"
            )
        latest_ack = store.latest_role_event(
            transaction,
            run_id=run_id,
            role_id=role_id,
            attempt_id=attempt_id,
            report_type="ack",
        )
        transaction.connection.execute(
            """
            INSERT INTO active_roles(
                run_id, role_id, attempt_id, task_contract_digest,
                token_digest, active, registered_at
            ) VALUES (?, ?, ?, ?, ?, 1, ?)
            """,
            (
                run_id,
                role_id,
                attempt_id,
                task_contract_digest.lower(),
                current["token_digest"],
                now_iso(),
            ),
        )
    return int((latest_ack or {}).get("sequence") or 0)


def refresh_running_worker_contract_snapshot(
    repo: Path,
    state: dict[str, Any],
    task_id: str,
    task_state: dict[str, Any],
    *,
    task_contract_digest: str,
) -> None:
    """Refresh the role-visible contract identity without copying Manager state."""

    prompt_raw = str(task_state.get("prompt") or "")
    if prompt_raw:
        prompt = Path(prompt_raw)
        if not prompt.is_file():
            raise HLoopError(f"running Worker prompt is missing: {prompt}")
        prompt_text = read_text(prompt)
        updated_prompt, replacements = re.subn(
            r"(--task-contract-digest )[0-9a-f]{64}",
            rf"\g<1>{task_contract_digest}",
            prompt_text,
        )
        if replacements != 1:
            raise HLoopError(
                f"running Worker prompt has {replacements} task contract digest fields: {prompt}"
            )
        write_text(prompt, updated_prompt)

    if state_persistence(state) != "local-only":
        return
    worktree_raw = str(task_state.get("worktree") or "")
    if not worktree_raw:
        return
    worktree = Path(worktree_raw).resolve()
    if not worktree.is_dir():
        raise HLoopError(f"running Worker worktree is missing: {worktree}")
    visible_task = task_file(worktree, task_id)
    write_text(visible_task, read_text(task_file(repo, task_id)))


def prompt_contract_digest(prompt: str) -> str:
    return hashlib.sha256(prompt.encode("utf-8")).hexdigest()


def render_worker_prompt(
    task_id: str,
    task_meta: dict[str, Any],
    worktree: Path,
    branch: str,
    state: dict[str, Any],
    *,
    report_credential_file: str = "",
    task_contract_digest: str = "",
) -> str:
    worker_protocol = str(task_meta.get("worker_protocol") or state_value(state, "worker_protocol", DEFAULT_WORKER_PROTOCOL))
    if worker_protocol not in WORKER_PROTOCOLS:
        worker_protocol = DEFAULT_WORKER_PROTOCOL
    worker_qa_profile = str(
        task_meta.get("worker_qa_profile")
        or task_meta.get("qa_profile")
        or state_worker_qa_profile(state)
    )
    branch_strategy = state_value(state, "branch_strategy", DEFAULT_BRANCH_STRATEGY)
    base_ref = str(task_meta.get("base_ref") or "the integration branch")
    agent_config = role_agent_config(state, "worker", overrides=task_meta)
    protocol = worker_protocol_text(worker_protocol, worker_qa_profile, base_ref)
    return f"""You are Worker {task_id}.

HLoop skill version: {SKILL_VERSION}
In your first progress message, state `herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Worker {task_id}` before investigation or edits.

You are running in your own git worktree:
{worktree}

Your branch:
{branch}

Read first:
- {LOOP_DIR.as_posix()}/MISSION.md
- {LOOP_DIR.as_posix()}/PLAN.md
- {LOOP_DIR.as_posix()}/PROFILE.md
- {LOOP_DIR.as_posix()}/DECISIONS.md
- {LOOP_DIR.as_posix()}/tasks/{task_id}.md

Loop profile:
- Branch strategy: {branch_strategy}
- Worker protocol: {worker_protocol}
- Worker QA profile: {worker_qa_profile}
- Agent backend: {agent_display(agent_config)}
- Run ID: {str(state.get("run_id") or "")}
- Fixed Worker base SHA: {str(task_meta.get("base_sha") or "")}
{report_contract_text(task_id, str(task_meta.get("attempt_id") or task_id), state, report_credential_file=report_credential_file, task_contract_digest=task_contract_digest)}
{protocol}

Rules:
- Edit only the files allowed by write_allow in {LOOP_DIR.as_posix()}/tasks/{task_id}.md.
- Do not edit {LOOP_DIR.as_posix()}/STATE.json.
- Do not edit Manager-owned files below {LOOP_DIR.as_posix()}: MISSION.md, PLAN.md, PROFILE.md, DECISIONS.md, JOURNAL.md, or USER_ACTION_REQUIRED.md.
- Do not edit other task files or other result directories.
- Do not merge, rebase, or switch to the integration branch.
- If the task needs a specification decision not present in MISSION/PLAN/task, write status: blocked.

Required output:
- Commit product changes first, leaving no unrelated dirty files.
- Generate and commit the result with:
  `python3 {Path(__file__).resolve()} {loop_namespace_flag()} worker finalize {task_id} --status done --validation-command '<command>' --validation-result passed --validation-summary '<summary>'`
- Repeat `--validation-command` and `--validation-result` in matching order for multiple checks.
- For blocked or failed work, use the matching `--status` and `--blocking-question` instead of claiming done.

Before finishing:
- Run relevant tests/build from the task.
- Record exact commands and results in flat frontmatter fields:
  validation_recorded: true
  validation_commands:
    - <command>
  validation_results:
    - <passed|failed|blocked>
  validation_summary: "..."
- Review your own diff.
- Ensure no unrelated changes.

Final terminal line:
HERDR_LOOP_ROLE_DONE:{str(state.get("run_id") or "")}:{task_id}:{str(task_meta.get("attempt_id") or "")}:<done|blocked|failed|partial>
"""


def resolved_reviewer_topology(
    state: dict[str, Any],
    *,
    mode: str | None = None,
    providers: Sequence[str] | None = None,
    probe_count: int | None = None,
    probes_per_provider: int | None = None,
) -> dict[str, Any]:
    """Merge CLI-explicit reviewer topology with the resolved config.

    Explicit CLI values always win. Anything left unset falls back to
    ``resolved_config.reviewer`` (the full hierarchical config precedence
    chain already applied by ``config apply``), with canonical
    ``resolved_config.reviewer.lane_count`` taking precedence over legacy
    review-policy and swarm-probe knobs. An absent canonical value can fall
    back to the legacy policy count; legacy probe fields remain a
    compatibility fallback when the selected lane count is ``auto`` or absent.
    """

    resolved_config = state.get("resolved_config", {})
    if not isinstance(resolved_config, dict):
        resolved_config = {}
    reviewer_config = resolved_config.get("reviewer", {})
    if not isinstance(reviewer_config, dict):
        reviewer_config = {}
    resolved_mode = mode or reviewer_config.get("mode") or state.get("review_mode") or "single"
    if resolved_mode not in hloop_review.REVIEW_MODES:
        raise HLoopError(f"unsupported review mode: {resolved_mode}")
    resolved_providers = list(providers) if providers else reviewer_config.get("providers")
    resolved_probe_count = probe_count
    resolved_probes_per_provider = probes_per_provider
    if resolved_probe_count is None and resolved_probes_per_provider is None:
        lane_count = reviewer_config.get("lane_count")
        if lane_count is None:
            review_config = resolved_config.get("review", {})
            if isinstance(review_config, dict):
                lane_count = review_config.get("lane_count")
            if lane_count is None:
                policy = state.get("review_policy", {})
                if isinstance(policy, dict):
                    lane_count = policy.get("lane_count")
        if resolved_mode in hloop_review.SWARM_MODES and lane_count not in (None, "auto"):
            resolved_probe_count = lane_count
        else:
            # Keep pre-0.5.2 reviewer topology fields working for migrated
            # states while allowing review.py to choose its default when no
            # explicit legacy count exists.
            resolved_probe_count = reviewer_config.get("probe_count")
            resolved_probes_per_provider = reviewer_config.get("probes_per_provider")
    if resolved_probe_count is not None and resolved_probes_per_provider is not None:
        raise HLoopError("set only one of --probe-count or --probes-per-provider")
    return {
        "mode": resolved_mode,
        "providers": resolved_providers or None,
        "probe_count": resolved_probe_count,
        "probes_per_provider": resolved_probes_per_provider,
    }


def review_capacity_evidence(
    review_plan: hloop_review.ReviewGroupPlan,
) -> dict[str, tuple[str, str]]:
    """Real per-provider swarm-concurrency probe evidence for ``review_plan``.

    Checked by ``check_review_capacity`` before any Coordinator pane exists,
    alongside the configured numeric ceiling, so an installed CLI that does
    not verifiably support the plan's concurrency requirements fails closed
    instead of only being compared against a fixed default.
    """

    return {
        provider: hloop_providers.probe_provider_review_capacity(provider)
        for provider in review_plan.providers
    }


def build_reviewer_group_plan(
    mode: str,
    head_sha: str,
    agent_config: dict[str, str],
    *,
    topology: dict[str, Any] | None = None,
) -> hloop_review.ReviewGroupPlan:
    topology = topology or {}
    return hloop_review.plan_review_group(
        mode,
        head_sha=head_sha,
        provider=agent_config["provider"],
        providers=topology.get("providers"),
        model=DEFAULT_AGENT_MODEL,
        models={agent_config["provider"]: agent_config["model"]},
        probe_count=topology.get("probe_count"),
        probes_per_provider=topology.get("probes_per_provider"),
    )


def render_reviewer_prompt(
    review_id: str,
    base_branch: str,
    integration_branch: str,
    state: dict[str, Any],
    agent_config: dict[str, str] | None = None,
    head_sha: str = "",
    review_plan: hloop_review.ReviewGroupPlan | None = None,
    report_credential_file: str = "",
    task_contract_digest: str = "",
    attempt_id: str = "",
) -> str:
    review_protocol = state_value(state, "review_protocol", DEFAULT_REVIEW_PROTOCOL)
    if review_protocol not in REVIEW_PROTOCOLS:
        review_protocol = DEFAULT_REVIEW_PROTOCOL
    worker_qa_profile = state_worker_qa_profile(state)
    manager_qa_profile = state_manager_qa_profile(state)
    branch_strategy = state_value(state, "branch_strategy", DEFAULT_BRANCH_STRATEGY)
    lanes = state_list(state, "review_lanes", DEFAULT_REVIEW_LANES)
    agent_config = agent_config or role_agent_config(state, "reviewer")
    protocol = review_protocol_text(
        review_protocol,
        lanes,
        worker_qa_profile,
        manager_qa_profile,
        branch_strategy,
    )
    mode = review_plan.mode if review_plan is not None else "single"
    if mode == "single":
        output_contract = f"""Output:
- During review, do not write files.
- After review is complete, write only {LOOP_DIR.as_posix()}/reviews/{review_id}.md.
- Include frontmatter: review_id, run_id: {str(state.get("run_id") or "")}, skill_version: {SKILL_VERSION}, base, head, head_sha: {head_sha}, status: reported|blocked|failed.
- If blocked or failed, still write the artifact with the concrete reason.
- Include a `## Fix Task Candidates` section. For every finding that should become a Worker fix task, add:
  `### FTNNN: <title>`, `action: fix_task`, `severity: P0|P1|P2|P3`, non-empty `write_allow:`, non-empty `acceptance:`, and non-empty `rationale:`.
  Also record `fact_status: confirmed`, `origin: introduced|diff-expanded-pre-existing`, `contract_relation: in_scope`, `decision_requirement: none`, `disposition: fix_now`, `release_effect: blocking|non_blocking`, and a non-empty `why_fix_now` plus `requirement_refs` or `scope_refs`.
  Incomplete candidates are rejected by `hloop triage` and will not become tasks.
  If no fix task is needed, write `No fix task candidates.`
"""
    else:
        plan_json = json.dumps(review_plan.to_record(), ensure_ascii=False, indent=2)
        provider_paths = "\n".join(
            f"- {LOOP_DIR.as_posix()}/reviews/{review_id}/providers/{provider}.md"
            for provider in review_plan.providers
        )
        output_contract = f"""Review group mode: {mode}
Target SHA for every lane and verifier: {review_plan.head_sha}

The following plan is immutable for this started review. Run every listed discovery lane with the exact provider, purpose, and agent_label. Swarm providers must launch the listed 4-8 provider-native sub-agents. Do not replace missing lanes with a smaller plan.

```json
{plan_json}
```

Directory artifact contract:
- During investigation, do not write HLoop artifacts.
- After all provider lanes and verifier passes reach a terminal result, write exactly:
  - {LOOP_DIR.as_posix()}/reviews/{review_id}/MANIFEST.json
{provider_paths}
  - {LOOP_DIR.as_posix()}/reviews/{review_id}/FINAL.md
- `MANIFEST.json` must follow `skills/herdr-dev-loop/schemas/review-manifest.schema.json`. Start from the immutable plan above, add each provider's actual `lanes`, normalized `findings`, planned verification assignments and shortfalls, actual verification `records`, and the recomputed `completeness` result. Never claim a missing or failed lane as completed.
- Every provider Markdown must have frontmatter: review_id, run_id: {str(state.get("run_id") or "")}, skill_version: {SKILL_VERSION}, head_sha: {head_sha}, provider, status: reported|blocked|failed. Record lane results, candidates, refutations, and shortfalls for only that provider.
- `FINAL.md` must have frontmatter: review_id, run_id: {str(state.get("run_id") or "")}, skill_version: {SKILL_VERSION}, base, head, head_sha: {head_sha}, status: reported|blocked|failed.
- `FINAL.md` must summarize confirmed, refuted, needs-spec, and insufficient-evidence findings without promoting incomplete evidence.
- Include `## Fix Task Candidates` in `FINAL.md`. A candidate is permitted only when all required manifest verification records for its fingerprint have `fact_status: confirmed`; include `source_finding: <sha256 fingerprint>` plus action, severity, write_allow, acceptance, and rationale. Non-confirmed or unknown fingerprints are rejected by `hloop triage`.
- A task candidate must additionally carry `fact_status: confirmed`, `origin: introduced|diff-expanded-pre-existing`, `contract_relation: in_scope`, `decision_requirement: none`, `disposition: fix_now`, `release_effect: blocking|non_blocking`, a non-empty `why_fix_now`, and `requirement_refs` or `scope_refs`; otherwise `hloop triage` rejects it.
- If no confirmed finding needs a task, write `No fix task candidates.`
- If blocked or failed, still write all available artifacts truthfully; missing data must leave manifest completeness false.
"""
    return f"""You are Reviewer {review_id}.

HLoop skill version: {SKILL_VERSION}
In your first progress message, state `herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Reviewer {review_id}` before investigation.

Compare:
- base branch: {base_branch}
- integration branch: {integration_branch}

You are running in a detached review worktree. Treat the review target as read-only during investigation.

Read:
- {LOOP_DIR.as_posix()}/MISSION.md
- {LOOP_DIR.as_posix()}/PLAN.md
- {LOOP_DIR.as_posix()}/PROFILE.md
- {LOOP_DIR.as_posix()}/DECISIONS.md
- {LOOP_DIR.as_posix()}/STATE.json
- {LOOP_DIR.as_posix()}/tasks/*.md
- {LOOP_DIR.as_posix()}/results/*/result.md
- {LOOP_DIR.as_posix()}/validation/*.log when present

Review profile:
- Branch strategy: {branch_strategy}
- Worker QA profile: {worker_qa_profile}
- Manager final QA profile: {manager_qa_profile}
- Review protocol: {review_protocol}
- Review lanes: {", ".join(lanes)}
- Review mode: {mode}
- Agent backend: {agent_display(agent_config)}
{report_contract_text(review_id, attempt_id or f"{review_id}-A001", state, report_credential_file=report_credential_file, task_contract_digest=task_contract_digest)}

{protocol}

Rules:
- Do not edit code.
- Do not run formatters, generators, migrations, or automatic fix commands.
- Do not commit, merge, rebase, or switch branches.
- Review the integration branch against base.
- For every finding, re-investigate whether it can actually occur in this codebase.
- Do not report vague best-practice issues unless they create concrete risk.
- Prefer concrete code paths, failing scenarios, or missing tests.
- Classify severity as P0/P1/P2/P3.
- Recommend Manager action: fix_task, decision_needed, accepted_risk_candidate, or false_positive_candidate.

{output_contract}

Final terminal line:
HERDR_LOOP_ROLE_DONE:{str(state.get("run_id") or "")}:{review_id}:{review_id}-A001:<reported|blocked|failed>
"""


def render_gap_prompt(
    gap_id: str,
    base_branch: str,
    integration_branch: str,
    spec_sources: list[str],
    state: dict[str, Any] | None = None,
    agent_config: dict[str, str] | None = None,
    head_sha: str = "",
    report_credential_file: str = "",
    task_contract_digest: str = "",
    attempt_id: str = "",
    epoch_execution: hloop_review_epoch.EpochExecutionPlan | None = None,
) -> str:
    agent_config = agent_config or role_agent_config(state or {}, "gap")
    if spec_sources:
        source_lines = "\n".join(f"- {item}" for item in spec_sources)
    else:
        source_lines = "- No extra spec source was configured; use MISSION.md, PLAN.md, DECISIONS.md, tasks, and results as the implementation contract."
    if epoch_execution is None:
        epoch_contract = ""
    else:
        epoch_contract = f"""
Review epoch execution contract:
- The following process plan is immutable. Run every listed process using its exact process kind, agent_label, provider, model, effort, parent, and lane identity.
- All child Agents are already charged to the shared epoch budget. Do not add unplanned audit Agents.
- Only the Coordinator writes the final Gap artifact after every planned child reaches a terminal result.

```json
{json.dumps(epoch_execution.to_record(), ensure_ascii=False, indent=2)}
```
"""
    return f"""You are Gap Auditor {gap_id}.

HLoop skill version: {SKILL_VERSION}
In your first progress message, state `herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Gap Auditor {gap_id}` before investigation.

Purpose:
- Compare the intended plan/spec against the current implementation.
- Find specification coverage gaps, not generic code-review issues.

Compare:
- base branch: {base_branch}
- integration branch: {integration_branch}
- Agent backend: {agent_display(agent_config)}

You are running in a detached gap-audit worktree. Treat the target as read-only during investigation.

Read:
- {LOOP_DIR.as_posix()}/MISSION.md
- {LOOP_DIR.as_posix()}/PLAN.md
- {LOOP_DIR.as_posix()}/DECISIONS.md
- {LOOP_DIR.as_posix()}/tasks/*.md
- {LOOP_DIR.as_posix()}/results/*/result.md

Spec sources:
{source_lines}
{epoch_contract}
{report_contract_text(gap_id, attempt_id or f"{gap_id}-A001", state or {}, report_credential_file=report_credential_file, task_contract_digest=task_contract_digest)}

Rules:
- Do not edit code.
- Do not run formatters, generators, migrations, or automatic fix commands.
- Do not commit, merge, rebase, or switch branches.
- Check whether each planned requirement is implemented, partially implemented, intentionally deferred, obsolete, or blocked by a decision gap.
- Verify every gap against the actual code path or missing artifact.
- Do not report broad best-practice review findings unless they directly prove plan/spec drift.
- Classify each item as implemented, partial, missing, deferred, obsolete-spec, or needs-decision.
- Recommend Manager action: fix_task, decision_needed, accepted_risk_candidate, stale_spec_update, or no_action.

Output:
- During investigation, do not write files.
- After the audit is complete, write only {LOOP_DIR.as_posix()}/gaps/{gap_id}.md.
- Include frontmatter: gap_id, run_id: {str((state or {}).get("run_id") or "")}, skill_version: {SKILL_VERSION}, base, head, head_sha: {head_sha}, status: aligned|gaps-found|blocked|failed, spec_sources, gap_count.
- If blocked or failed, still write the artifact with the concrete reason.
- Include a `## Fix Task Candidates` section. For every missing or partial requirement that should become a Worker fix task, add:
  `### FTNNN: <title>`, `action: fix_task`, `priority: P0|P1|P2|P3`, non-empty `write_allow:`, non-empty `acceptance:`, and non-empty `rationale:`.
  Incomplete candidates are rejected by `hloop triage` and will not become tasks.
  If no fix task is needed, write `No fix task candidates.`

Final terminal line:
HERDR_LOOP_ROLE_DONE:{str((state or {}).get("run_id") or "")}:{gap_id}:{gap_id}-A001:<aligned|gaps-found|blocked|failed>
"""


def version_payload(repo: Path | None = None) -> dict[str, Any]:
    payload: dict[str, Any] = {
        "name": "herdr-dev-loop",
        "runtime_skill_version": SKILL_VERSION,
        "skill_root": str(SKILL_ROOT),
        "namespace": LOOP_NAMESPACE,
        "loop_path": LOOP_DIR.as_posix(),
    }
    if repo is not None:
        payload["legacy_loop_ignored"] = (repo / LEGACY_LOOP_DIR).exists()
    if repo is not None and state_path(repo).exists():
        state = load_state(repo)
        payload["loop_skill_version"] = str(state.get("skill_version") or "unversioned")
        payload["run_id"] = str(state.get("run_id") or "")
        payload["goal_id"] = str(state.get("goal_id") or "")
        payload["version_mismatch"] = payload["loop_skill_version"] not in {
            "unversioned",
            SKILL_VERSION,
        }
    return payload


def cmd_version(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    payload = version_payload(repo)
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(f"herdr-dev-loop {SKILL_VERSION}")
        if "loop_skill_version" in payload:
            print(
                f"loop_skill_version: {payload['loop_skill_version']} "
                f"run_id: {payload.get('run_id') or '-'}"
            )
            if payload.get("version_mismatch"):
                print("warning: runtime and loop skill versions differ")
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    role_state = load_state(repo) if state_path(repo).exists() else {}
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    herdr_skill_candidates = []
    if os.environ.get("HERDR_SKILL_PATH"):
        herdr_skill_candidates.append(Path(os.environ["HERDR_SKILL_PATH"]))
    herdr_skill_candidates.extend(
        [
            Path.home() / ".agents/skills/herdr/SKILL.md",
            codex_home / "skills/herdr/SKILL.md",
            Path.home() / ".codex/skills/herdr/SKILL.md",
        ]
    )
    herdr_skill = next((path for path in herdr_skill_candidates if path.exists()), None)
    checks: dict[str, Any] = {
        "repo": str(repo),
        "herdr_dev_loop": version_payload(repo),
        "HERDR_ENV": os.environ.get("HERDR_ENV"),
        "HERDR_PANE_ID": os.environ.get("HERDR_PANE_ID"),
        "HERDR_WORKSPACE_ID": os.environ.get("HERDR_WORKSPACE_ID"),
        "HERDR_TAB_ID": os.environ.get("HERDR_TAB_ID"),
        "commands": {
            "git": command_exists("git"),
            "herdr": command_exists("herdr"),
            "codex": command_exists("codex"),
            "claude": command_exists("claude"),
        },
        "skills": {
            "herdr": str(herdr_skill or herdr_skill_candidates[0]),
        },
        "optional_skills": {
            "codex-impl": str(codex_home / "skills/codex-impl/SKILL.md"),
            "codex-review-multi-v2": str(
                codex_home / "skills/codex-review-multi-v2/SKILL.md"
            ),
        },
        "warnings": [],
    }
    checks["skills"] = {
        key: {"path": value, "exists": Path(value).exists()}
        for key, value in checks["skills"].items()
    }
    checks["optional_skills"] = {
        key: {"path": value, "exists": Path(value).exists()}
        for key, value in checks["optional_skills"].items()
    }
    checks["skills"]["herdr"]["candidates"] = [str(path) for path in herdr_skill_candidates]
    config_ok = True
    try:
        hloop_config.check_python_capability()
        config_candidate = hloop_config.find_config_file()
        if config_candidate is not None:
            config_data = hloop_config.load_config_file(config_candidate.path)
            hloop_config.validate_config(config_data, base=config_candidate.path.parent)
            validate_config_semantics(config_data)
        checks["config"] = {
            "python": f"{sys.version_info.major}.{sys.version_info.minor}",
            "capability": "supported",
            "path": str(config_candidate.path) if config_candidate else None,
            "valid": True,
        }
    except (hloop_config.ConfigError, HLoopError) as exc:
        config_ok = False
        checks["config"] = {
            "python": f"{sys.version_info.major}.{sys.version_info.minor}",
            "capability": "unsupported-or-invalid",
            "valid": False,
            "error": str(exc),
        }
        checks["warnings"].append(f"config capability check failed: {exc}")
    role_capabilities_ok = True
    role_capabilities: dict[str, Any] = {}
    for role in ("worker", "reviewer", "gap", "advisor"):
        config = role_agent_config(role_state, role)
        runner = str(role_state.get(f"{role}_runner") or "tui")
        try:
            invocation = agent_provider_invocation(
                provider=config["provider"],
                model=config["model"],
                runner=runner,
                sandbox="workspace-write",
                prompt_rel=LOOP_DIR / "prompts" / f"_doctor-{role}.md",
                cwd=repo,
                effort=config.get("effort", DEFAULT_AGENT_EFFORT),
                claude_permission_mode=config.get(
                    "claude_permission_mode", DEFAULT_CLAUDE_PERMISSION_MODE
                ),
            )
            capability = hloop_providers.probe_provider_capability(invocation)
            role_capabilities[role] = capability.as_record()
            if not capability.launch_allowed:
                role_capabilities_ok = False
                checks["warnings"].append(
                    f"{role} provider capability failed: {capability.reason}"
                )
        except (HLoopError, hloop_providers.ProviderError) as exc:
            role_capabilities_ok = False
            role_capabilities[role] = {
                "provider": config.get("provider"),
                "runner": runner,
                "model": config.get("model"),
                "capability": "unsupported",
                "launch_allowed": False,
                "reason": str(exc),
            }
            checks["warnings"].append(f"{role} provider capability failed: {exc}")
    checks["role_capabilities"] = role_capabilities
    topology = resolved_reviewer_topology(role_state)
    review_capacity: dict[str, Any] = {}
    for provider in hloop_review.SUPPORTED_PROVIDERS:
        status, reason = hloop_providers.probe_provider_review_capacity(provider)
        review_capacity[provider] = {
            "capacity_probe": status,
            "reason": reason,
            "ceiling": hloop_providers.review_capacity_ceiling(
                provider, limits=role_state.get("review_capacity_limits")
            ),
        }
        if status in {"unsupported", "unavailable"}:
            checks["warnings"].append(
                f"{provider} review swarm capacity probe failed: {reason}"
            )
    checks["review_capacity"] = {"resolved_mode": topology["mode"], "providers": review_capacity}
    if not checks["skills"]["herdr"]["exists"]:
        checks["warnings"].append("herdr skill file not found; continuing because the herdr CLI is authoritative")
    if checks["herdr_dev_loop"].get("version_mismatch"):
        checks["warnings"].append(
            "runtime herdr-dev-loop version differs from the version pinned when this loop was initialized"
        )
    for key, item in checks["optional_skills"].items():
        if not item["exists"]:
            checks["warnings"].append(
                f"optional compatibility skill `{key}` not found; native hloop protocols do not require it"
            )
    if command_exists("codex"):
        proc = run_cmd(["codex", "--version"], check=False)
        checks["codex_version"] = (proc.stdout or proc.stderr).strip()
    if command_exists("claude"):
        proc = run_cmd(["claude", "--version"], check=False)
        checks["claude_version"] = (proc.stdout or proc.stderr).strip()
    if command_exists("herdr") and os.environ.get("HERDR_ENV") == "1":
        status_proc = run_cmd(["herdr", "status"], check=False)
        checks["herdr_status"] = (status_proc.stdout or status_proc.stderr).strip()
        try:
            current = json_from_cmd(["herdr", "pane", "current", "--current"])
            checks["current_pane_id"] = extract_pane_id(current)
        except HLoopError as exc:
            checks["herdr_error"] = str(exc)
    if getattr(args, "sessions", False):
        try:
            checks["loop_inventory"] = collect_loop_inventory(
                repo,
                probe_panes=True,
                lines=getattr(args, "session_lines", 80),
                include_output=False,
            )
        except HLoopError as exc:
            checks["warnings"].append(f"session inventory unavailable: {exc}")
    herdr_skill_ok = checks["skills"]["herdr"]["exists"] or not args.strict_skills
    required_commands_ok = checks["commands"]["git"] and checks["commands"]["herdr"] and checks["commands"]["codex"]
    ok = (
        checks["HERDR_ENV"] == "1"
        and required_commands_ok
        and herdr_skill_ok
        and config_ok
        and role_capabilities_ok
    )
    checks["ok"] = ok
    if args.json:
        print(json.dumps(checks, ensure_ascii=False, indent=2))
    else:
        for key, value in checks.items():
            print(f"{key}: {value}")
    return 0 if ok else 1


def contract_required_state_fields(text: str) -> list[str]:
    fields: list[str] = []
    in_required = False
    for line in text.splitlines():
        if line.strip() == "Required top-level fields:":
            in_required = True
            continue
        if in_required and line.strip().startswith("Treat `pane_id`"):
            break
        if not in_required:
            continue
        match = re.match(r"^-\s+`([^`]+)`\s*$", line.strip())
        if match:
            fields.append(match.group(1))
    return fields


def openai_yaml_interface_fields(text: str) -> set[str]:
    fields: set[str] = set()
    in_interface = False
    for line in text.splitlines():
        if line.strip() == "interface:":
            in_interface = True
            continue
        if not in_interface:
            continue
        match = re.match(r"^\s{2}([a-zA-Z0-9_]+):\s+.+$", line)
        if match:
            fields.add(match.group(1))
            continue
        if line.strip() and not line.startswith(" "):
            break
    return fields


def schema_has_merge_ready_guard(schema: dict[str, Any]) -> bool:
    all_of = schema.get("allOf")
    if not isinstance(all_of, list):
        return False
    for item in all_of:
        if not isinstance(item, dict):
            continue
        condition = item.get("if", {})
        then = item.get("then", {})
        if not isinstance(condition, dict) or not isinstance(then, dict):
            continue
        if (
            condition.get("properties", {})
            .get("merge_ready", {})
            .get("const")
            is not True
        ):
            continue
        required = set(normalize_list(then.get("required")))
        props = then.get("properties", {})
        if not isinstance(props, dict):
            continue
        validation_items = props.get("validation_results", {}).get("items", {})
        if {
            "status",
            "validation_recorded",
            "validation_commands",
            "validation_results",
        }.issubset(required) and props.get("status", {}).get("const") == "done" and (
            validation_items.get("const") == "passed"
        ):
            return True
    return False


def schema_has_write_allow_guard(schema: dict[str, Any]) -> bool:
    all_of = schema.get("allOf")
    if not isinstance(all_of, list):
        return False
    for item in all_of:
        if not isinstance(item, dict):
            continue
        condition = item.get("if", {})
        then = item.get("then", {})
        if not isinstance(condition, dict) or not isinstance(then, dict):
            continue
        kind = condition.get("properties", {}).get("kind", {})
        write_allow = then.get("properties", {}).get("write_allow", {})
        if kind.get("enum") == ["implementation", "fix"] and write_allow.get("minItems") == 1:
            return True
    return False


def cmd_selftest(args: argparse.Namespace) -> int:
    skill_root = (
        Path(args.skill_dir).resolve()
        if args.skill_dir
        else Path(__file__).resolve().parents[1]
    )
    errors: list[str] = []

    def check(condition: bool, message: str) -> None:
        if not condition:
            errors.append(message)

    skill_md = skill_root / "SKILL.md"
    skill_meta = parse_frontmatter_text(read_text(skill_md))
    check(skill_meta.get("name") == "herdr-dev-loop", "SKILL.md frontmatter name is invalid")
    check(bool(skill_meta.get("description")), "SKILL.md frontmatter description is missing")
    version_path = skill_root / "VERSION"
    version_text = read_text(version_path).strip()
    check(
        bool(re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?", version_text)),
        "VERSION is missing or is not semantic-version shaped",
    )
    if skill_root == SKILL_ROOT:
        check(version_text == SKILL_VERSION, "VERSION differs from the loaded runtime version")

    openai_yaml = skill_root / "agents" / "openai.yaml"
    fields = openai_yaml_interface_fields(read_text(openai_yaml))
    check(
        {"display_name", "short_description", "default_prompt"}.issubset(fields),
        "agents/openai.yaml interface fields are incomplete",
    )

    schema_dir = skill_root / "references" / "schemas"
    schemas: dict[str, dict[str, Any]] = {}
    for path in sorted(schema_dir.glob("*.json")):
        try:
            data = json.loads(read_text(path))
        except json.JSONDecodeError as exc:
            errors.append(f"{path.name} is invalid JSON: {exc}")
            continue
        if not isinstance(data, dict):
            errors.append(f"{path.name} is not a JSON object")
            continue
        schemas[path.name] = data

    # 0.5.2 publishes the manual-final PLAN/MANIFEST entry points beside the
    # runtime review schemas.  Keep the public wrappers lightweight while
    # checking that they resolve to the canonical reference schemas; older
    # installed copies are allowed to retain their historical layout.
    if version_text.startswith("0.5.2"):
        runtime_schema_dir = skill_root / "schemas"
        for name in (
            "final-review-plan.schema.json",
            "final-review-manifest.schema.json",
        ):
            path = runtime_schema_dir / name
            if not path.is_file():
                errors.append(f"schemas/{name} is missing from the 0.5.2 publication")
                continue
            try:
                runtime_schema = json.loads(read_text(path))
            except json.JSONDecodeError as exc:
                errors.append(f"schemas/{name} is invalid JSON: {exc}")
                continue
            check(
                runtime_schema.get("$ref", "").startswith("../references/schemas/final-review-"),
                f"schemas/{name} does not point to the canonical final-review schema",
            )

    state_schema = schemas.get("state.schema.json", {})
    contract_fields = contract_required_state_fields(
        read_text(skill_root / "references" / "artifact-contract.md")
    )
    schema_required = normalize_list(state_schema.get("required"))
    check(bool(contract_fields), "artifact-contract required state fields were not found")
    check(
        set(contract_fields) == set(schema_required),
        "STATE.json required fields differ between artifact-contract.md and state.schema.json",
    )
    check(
        "schema_revision" in set(schema_required),
        "state.schema.json lacks required schema_revision",
    )

    result_schema = schemas.get("result.schema.json", {})
    task_schema = schemas.get("task.schema.json", {})
    review_schema = schemas.get("review.schema.json", {})
    gap_schema = schemas.get("gap.schema.json", {})
    advice_schema = schemas.get("advice.schema.json", {})
    for schema_name, schema in (
        ("state.schema.json", state_schema),
        ("task.schema.json", task_schema),
        ("result.schema.json", result_schema),
        ("review.schema.json", review_schema),
        ("gap.schema.json", gap_schema),
        ("advice.schema.json", advice_schema),
    ):
        check(
            "skill_version" in set(normalize_list(schema.get("required"))),
            f"{schema_name} lacks required skill_version",
        )
    check(schema_has_merge_ready_guard(result_schema), "result.schema.json lacks merge_ready guard")
    validation_result_enum = set(
        normalize_list(
            result_schema.get("properties", {})
            .get("validation_results", {})
            .get("items", {})
            .get("enum")
        )
    )
    check(
        validation_result_enum == WORKER_VALIDATION_RESULTS,
        "result.schema.json validation result enum drifted",
    )
    check(schema_has_write_allow_guard(task_schema), "task.schema.json lacks write_allow guard")
    review_status_enum = set(normalize_list(review_schema.get("properties", {}).get("status", {}).get("enum")))
    gap_status_enum = set(normalize_list(gap_schema.get("properties", {}).get("status", {}).get("enum")))
    advice_status_enum = set(normalize_list(advice_schema.get("properties", {}).get("status", {}).get("enum")))
    check(review_status_enum == REVIEW_ARTIFACT_STATUSES, "review.schema.json status enum drifted")
    check(gap_status_enum == GAP_ARTIFACT_STATUSES, "gap.schema.json status enum drifted")
    check(advice_status_enum == ADVISOR_ARTIFACT_STATUSES, "advice.schema.json status enum drifted")
    check(
        {"run_id", "head_sha"}.issubset(set(normalize_list(review_schema.get("required")))),
        "review.schema.json lacks run/head freshness fields",
    )
    check(
        {"run_id", "head_sha"}.issubset(set(normalize_list(gap_schema.get("required")))),
        "gap.schema.json lacks run/head freshness fields",
    )

    result_meta = parse_frontmatter_text(
        """---
task_id: T001
run_id: run-demo
skill_version: 0.3.0
status: done
merge_ready: true
branch: ai/demo/T001
head_sha: HEAD
base_sha: abc123
changed_files:
  - src/demo.ts
validation_recorded: true
validation_commands:
  - npm test -- tests/demo.test.ts
validation_results:
  - passed
validation_summary: "targeted tests passed"
blocking_questions: []
---
"""
    )
    check(result_meta.get("merge_ready") is True, "sample result merge_ready did not parse")
    check(
        normalize_list(result_meta.get("validation_commands")),
        "sample result validation_commands did not parse as a list",
    )
    inline_list_rejected = False
    try:
        parse_frontmatter_text(
            """---
validation_commands: ["npm test -- --grep foo,bar"]
---
"""
        )
    except HLoopError as exc:
        inline_list_rejected = "inline list unsupported" in str(exc)
    check(inline_list_rejected, "known list fields should reject non-empty inline lists")
    check(
        matches_any("app/[liveId]/page.tsx", ["app/[liveId]/**"]),
        "write_allow matcher does not treat bracket path segments literally",
    )
    check(
        parse_changed_files_name_status("R100\told/path.ts\tnew/path.ts\nD\tgone.ts\n")
        == ["old/path.ts", "new/path.ts", "gone.ts"],
        "name-status changed file parser missed rename/delete paths",
    )
    parsed_task = build_parser().parse_args(
        [
            "task",
            "new",
            "demo task",
            "--write-allow",
            "app/[liveId]/**",
            "--validation-minimum",
            "L1",
            "--validation-minimum",
            "local browser QA",
        ]
    )
    check(
        parsed_task.validation_minimum == ["L1", "local browser QA"],
        "task new did not preserve repeated --validation-minimum values",
    )
    parsed_harvest = build_parser().parse_args(["harvest", "T001"])
    check(parsed_harvest.command == "harvest", "top-level harvest command did not parse")
    parsed_version = build_parser().parse_args(["version", "--json"])
    check(parsed_version.command == "version" and parsed_version.json, "version command did not parse")
    parsed_namespaced = build_parser().parse_args(
        ["--namespace", "feature-x", "version", "--json"]
    )
    check(parsed_namespaced.namespace == "feature-x", "global namespace did not parse")
    parsed_abort = build_parser().parse_args(
        ["agent", "abort", "R001", "--reason", "missing artifact"]
    )
    check(parsed_abort.agent_command == "abort", "agent abort command did not parse")
    parsed_requeue = build_parser().parse_args(
        ["agent", "requeue", "T001", "--reason", "retry"]
    )
    check(parsed_requeue.agent_command == "requeue", "agent requeue command did not parse")
    parsed_experience = build_parser().parse_args(
        ["experience", "recommend", "--command", "pnpm install --frozen-lockfile"]
    )
    check(
        parsed_experience.experience_command == "recommend",
        "experience recommend command did not parse",
    )
    parsed_wait = build_parser().parse_args(["wait", "next"])
    check(parsed_wait.timeout_ms == DEFAULT_WAIT_TIMEOUT_MS, "wait timeout default drifted")
    parsed_update = build_parser().parse_args(
        ["task", "update", "T001", "--add-write-allow", "src/shared/**"]
    )
    check(parsed_update.task_command == "update", "task update command did not parse")
    parsed_finalize = build_parser().parse_args(
        [
            "worker",
            "finalize",
            "T001",
            "--validation-command",
            "npm test",
            "--validation-result",
            "passed",
        ]
    )
    check(parsed_finalize.worker_command == "finalize", "worker finalize command did not parse")
    parsed_finalize_handoff = build_parser().parse_args(
        ["worker", "finalize", "T001", "--status", "done", "--handoff"]
    )
    check(parsed_finalize_handoff.handoff, "worker finalize --handoff did not parse")
    parsed_seal = build_parser().parse_args(
        [
            "worker",
            "seal",
            "T001",
            "--attempt-id",
            "T001-A001",
            "--validation-command",
            "npm test",
            "--validation-summary",
            "passed",
        ]
    )
    check(parsed_seal.worker_command == "seal", "worker seal command did not parse")
    check(parsed_seal.attempt_id == "T001-A001", "worker seal --attempt-id did not parse")
    check(parsed_seal.validation_command == ["npm test"], "worker seal --validation-command did not parse")
    parsed_checkpoint = build_parser().parse_args(["checkpoint", "--message", "ai-loop: checkpoint"])
    check(parsed_checkpoint.command == "checkpoint", "checkpoint command did not parse")
    parsed_rollup = build_parser().parse_args(
        ["checkpoint", "--message", "ai-loop(B001): checkpoint", "--batch", "B001", "--rollup"]
    )
    check(parsed_rollup.batch == "B001" and parsed_rollup.rollup, "checkpoint rollup args did not parse")
    parsed_batch = build_parser().parse_args(["batch", "start", "demo batch", "--id", "B001"])
    check(parsed_batch.batch_command == "start", "batch start command did not parse")
    parsed_mixed_init = build_parser().parse_args(
        [
            "init",
            "--goal",
            "demo",
            "--reviewer-agent-provider",
            "claude",
            "--reviewer-agent-model",
            "opus",
            "--advisor-enabled",
            "--advisor-mode",
            "dialogue",
            "--worktree-root",
            "../wt/demo",
            "--persistence",
            "local-only",
            "--worktree-setup-command",
            "pnpm install --frozen-lockfile",
        ]
    )
    check(parsed_mixed_init.reviewer_agent_provider == "claude", "init reviewer agent provider did not parse")
    check(parsed_mixed_init.worktree_root == "../wt/demo", "init worktree root did not parse")
    check(parsed_mixed_init.persistence == "local-only", "init persistence did not parse")
    check(
        parsed_mixed_init.worktree_setup_command == ["pnpm install --frozen-lockfile"],
        "init worktree setup command did not parse",
    )
    parsed_advisor = build_parser().parse_args(
        [
            "advisor",
            "request",
            "--topic",
            "choose fix strategy",
            "--mode",
            "dialogue",
            "--participant",
            "codex:auto",
            "--participant",
            "claude:opus",
        ]
    )
    check(parsed_advisor.advisor_command == "request", "advisor request command did not parse")
    check(
        parse_participant_spec("claude:opus") == {"provider": "claude", "model": "opus"},
        "advisor participant parser drifted",
    )
    worker_prompt = render_worker_prompt(
        "T001",
        {
            "worker_protocol": "native",
            "worker_qa_profile": "none",
            "base_ref": "main",
            "worker_agent_provider": "claude",
            "worker_agent_model": "opus",
        },
        Path("/tmp/hloop-worker"),
        "ai/demo/T001",
        {
            "branch_strategy": "integration",
            "worker_protocol": "native",
            "worker_qa_profile": "none",
            "worker_agent_provider": "codex",
            "worker_agent_model": "auto",
        },
    )
    check(
        "- Agent backend: claude:opus" in worker_prompt,
        "worker prompt ignored task-level worker agent backend override",
    )
    check("worker finalize T001" in worker_prompt, "worker prompt omitted deterministic finalizer")
    check(
        f"herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Worker T001" in worker_prompt,
        "worker prompt omitted first-message version identity",
    )
    report_contract = report_contract_text(
        "T001",
        "T001-A001",
        {"run_id": "run-selftest"},
        report_credential_file="/tmp/hloop-report-credential.json",
        task_contract_digest=hashlib.sha256(b"T001").hexdigest(),
    )
    check(
        "--invocation-id T001-A001:report/0001" in report_contract
        and "ASCII alphanumeric character" in report_contract,
        "report contract omitted caller-stable invocation ID",
    )
    review_override_prompt = render_reviewer_prompt(
        "R999",
        "main",
        "ai/demo/integration",
        {
            "reviewer_agent_provider": "claude",
            "reviewer_agent_model": "opus",
            "worker_qa_profile": "none",
            "manager_qa_profile": "none",
            "branch_strategy": "integration",
            "review_protocol": "native",
            "review_lanes": DEFAULT_REVIEW_LANES,
        },
        agent_config={"provider": "codex", "model": "auto", "fallback_provider": "codex"},
    )
    check(
        "- Agent backend: codex" in review_override_prompt,
        "reviewer prompt ignored start-level agent backend override",
    )
    check(
        f"herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Reviewer R999" in review_override_prompt,
        "reviewer prompt omitted first-message version identity",
    )
    gap_override_prompt = render_gap_prompt(
        "G999",
        "main",
        "ai/demo/integration",
        ["spec/demo.md"],
        {"gap_agent_provider": "claude", "gap_agent_model": "opus"},
        agent_config={"provider": "codex", "model": "auto", "fallback_provider": "codex"},
    )
    check(
        "- Agent backend: codex" in gap_override_prompt,
        "gap prompt ignored start-level agent backend override",
    )
    check(
        f"herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Gap Auditor G999" in gap_override_prompt,
        "gap prompt omitted first-message version identity",
    )
    advisor_state = {"advisor_max_rounds": 2}
    peer_advice = {
        "mode": "dialogue",
        "max_rounds": 2,
        "topic": "compare fix strategy",
        "participants": [
            {
                "participant_id": "P1",
                "provider": "codex",
                "model": "auto",
                "advice_path": (LOOP_DIR / "advice" / "A001-P1.md").as_posix(),
            },
            {"participant_id": "P2", "provider": "claude", "model": "opus"},
        ],
    }
    peer_participant = peer_advice["participants"][1]
    prepare_advisor_dialogue_start(advisor_state, peer_advice, peer_participant)
    peer_prompt = render_advisor_prompt(
        "A001",
        peer_participant,
        peer_advice,
        advisor_state,
        LOOP_DIR / "advice" / "A001-P2.md",
    )
    check(
        (LOOP_DIR / "advice" / "A001-P1.md").as_posix() in peer_prompt
        and "Dialogue max rounds: 2" in peer_prompt,
        "advisor dialogue prompt did not include peer artifact and round bound",
    )
    check(
        f"herdr-dev-loop {SKILL_VERSION} / namespace {LOOP_NAMESPACE} / Advisor A001/P2" in peer_prompt,
        "advisor prompt omitted first-message version identity",
    )
    check(
        artifact_identity_error(
            {"run_id": "run-new"},
            "R001",
            "reviewer",
            {"head_sha": "new-head"},
            {"review_id": "R001", "run_id": "run-old", "head_sha": "new-head"},
        )
        == "run_id mismatch",
        "artifact freshness check accepted an older run",
    )
    check(
        artifact_identity_error(
            {"run_id": "run-new", "skill_version": SKILL_VERSION},
            "R001",
            "reviewer",
            {"head_sha": "new-head", "skill_version": SKILL_VERSION},
            {
                "review_id": "R001",
                "run_id": "run-new",
                "skill_version": "0.0.0",
                "head_sha": "new-head",
            },
        )
        == "skill_version mismatch",
        "artifact freshness check accepted a different skill version",
    )
    check(
        configured_worktree_path(
            Path("/tmp/repo"), {"worktree_root": "/tmp/wt/demo"}, "T001", "repo.t001"
        )
        == Path("/tmp/wt/demo/T001"),
        "configured worktree root was not applied",
    )
    limit_participant = {
        "participant_id": "P1",
        "manager_messages": [{"delivery_status": "delivered"}],
    }
    advisor_limit_rejected = False
    try:
        enforce_advisor_message_round_limit(
            advisor_state,
            {"mode": "dialogue", "max_rounds": 2},
            limit_participant,
        )
    except HLoopError as exc:
        advisor_limit_rejected = "follow-up limit reached" in str(exc)
    check(advisor_limit_rejected, "advisor dialogue follow-up limit was not enforced")
    check(
        "claude --print" in agent_command_for_prompt(
            provider="claude",
            model="opus",
            runner="exec",
            sandbox="workspace-write",
            prompt_rel=LOOP_DIR / "prompts" / "A001-P1.advisor.md",
            cwd=skill_root,
            output_rel=LOOP_DIR / "advice" / "A001-P1.md",
        ),
        "claude exec command rendering drifted",
    )
    parsed_pump = build_parser().parse_args(["pump"])
    check(parsed_pump.sleep_ms == DEFAULT_PUMP_SLEEP_MS, "pump sleep default drifted")
    check(
        not hasattr(build_parser().parse_args(["tick", "--once"]), "mode")
        and not hasattr(parsed_pump, "mode"),
        "tick/pump unexpectedly define merge mode; cmd_merge must use a safe optional lookup",
    )
    check(
        normalize_validation_log_output("line with spaces  \nnext\t \r\n") == "line with spaces\nnext\n",
        "validation log normalization did not trim trailing whitespace",
    )
    message_state: dict[str, Any] = {}
    record_manager_message(
        message_state,
        "argv",
        "hello",
        delivery_status="undelivered",
        delivery_error="Codex is still working",
        pending_path=(LOOP_DIR / "inbox" / "pending" / "example.md").as_posix(),
    )
    check(
        message_state.get("manager_messages", [{}])[-1].get("delivery_status") == "undelivered"
        and message_state.get("manager_messages", [{}])[-1].get("digest"),
        "manager message delivery status/digest was not recorded",
    )
    check(
        item_artifact_state(
            {
                "role": "worker",
                "status": "merged",
                "cleanup_done": True,
                "artifact": {
                    "state": "missing",
                    "status": "done",
                    "committed_path": (LOOP_DIR / "results" / "T001" / "result.md").as_posix(),
                },
            }
        )
        == "cleaned/done/committed",
        "merged cleaned Worker artifact display is misleading",
    )

    review_meta = parse_frontmatter_text(
        """---
review_id: R001
run_id: run-demo
skill_version: 0.3.0
base: main
head_sha: abc123
head: ai/demo/integration
status: reported
---
"""
    )
    check(
        str(review_meta.get("status")) in REVIEW_ARTIFACT_STATUSES,
        "sample review artifact status is invalid",
    )

    gap_meta = parse_frontmatter_text(
        """---
gap_id: G001
run_id: run-demo
skill_version: 0.3.0
base: main
head_sha: abc123
head: ai/demo/integration
status: aligned
gap_count: 0
---
"""
    )
    check(str(gap_meta.get("status")) in GAP_ARTIFACT_STATUSES, "sample gap artifact status is invalid")

    batch_meta = parse_frontmatter_text(
        """---
id: B001
title: Demo batch
status: active
task_ids:
  - T001
checkpoint_mode: rollup
---
"""
    )
    check(batch_meta.get("id") == "B001", "sample batch artifact id did not parse")
    check(normalize_list(batch_meta.get("task_ids")) == ["T001"], "sample batch task_ids did not parse")

    valid_fix_candidates, rejected_fix_candidates = extract_fix_task_candidates(
        """## Fix Task Candidates

### FT001: Fix valid path
action: fix_task
priority: P1
write_allow:
  - `src/example/**` if this source remains scoped
acceptance:
  - Regression is fixed.
rationale: The reviewed path can fail.

### FT002: Missing required fields
action: fix_task
priority: P1
acceptance:
  - Something improves.
""",
        "R001",
    )
    check(len(valid_fix_candidates) == 1, "valid fix task candidate was not accepted")
    check(len(rejected_fix_candidates) == 1, "invalid fix task candidate was not rejected")
    check(
        valid_fix_candidates[0].get("write_allow") == ["src/example/**"],
        "triage did not normalize a Markdown code-span path",
    )
    draft_text = render_fix_task_draft(
        "review",
        "R001",
        LOOP_DIR / "reviews" / "R001.md",
        valid_fix_candidates,
        rejected_fix_candidates,
    )
    check("## Rejected Candidates" in draft_text, "triage draft did not include rejected candidates")

    reliability_codes = {
        item["code"]
        for item in agent_contract_issues(
            skill_root,
            role="worker",
            agent_id="T999",
            agent={
                "status": "result_reported",
                "sandbox": "danger-full-access",
                "prompt": "/tmp/manual-prompt.md",
                "worktree": "/tmp/manual-worker",
                "head_sha": "manager-working-tree",
                "merge_ready": True,
                "integration_method": "manager_manual_apply_after_worker_quota_failure",
                "result_path": str(skill_root / LOOP_DIR / "results" / "T999" / "result.md"),
            },
        )
    }
    check("unsafe-agent-sandbox" in reliability_codes, "reliability audit missed unsafe sandbox")
    check("non-hloop-prompt" in reliability_codes, "reliability audit missed non-hloop prompt")
    check("untrusted-worker-head" in reliability_codes, "reliability audit missed untrusted Worker head")
    check(
        "merge-ready-without-committed-result" in reliability_codes,
        "reliability audit missed missing committed result path",
    )

    result = {"ok": not errors, "skill_root": str(skill_root), "errors": errors}
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    elif errors:
        for error in errors:
            print(f"selftest: {error}", file=sys.stderr)
    else:
        print("selftest ok")
    return 0 if not errors else 1


def cmd_init(args: argparse.Namespace) -> int:
    repo = repo_root(Path(args.repo).resolve())
    config_resolution, config_candidate = resolve_init_config(args, repo)
    archived_loop: Path | None = None
    base = args.base or current_branch(repo) or "main"
    goal_id = args.goal_id or slugify(args.goal, 32)
    run_id = new_run_id(goal_id)
    integration = args.integration or f"ai/{goal_id}/integration"
    worktree_root = resolve_worktree_root(repo, getattr(args, "worktree_root", None))
    experience = load_worktree_experience(repo)
    setup_commands = args.worktree_setup_command or normalize_list(
        experience.get("recommended_commands")
    )
    worker_setup_commands = args.worker_setup_command or setup_commands
    reviewer_setup_commands = args.reviewer_setup_command or []
    gap_setup_commands = args.gap_setup_command or []
    advisor_setup_commands = args.advisor_setup_command or []
    for role, commands in (
        ("worker", worker_setup_commands),
        ("reviewer", reviewer_setup_commands),
        ("gap", gap_setup_commands),
        ("advisor", advisor_setup_commands),
    ):
        for command in commands:
            marker = unsafe_setup_command(command)
            if marker:
                raise HLoopError(f"unsafe {role} setup command: contains `{marker}`")
    if args.persistence == "local-only":
        ensure_local_only_git_excludes(repo)
    worker_qa_profile = args_worker_qa_profile(args)
    manager_qa_profile = str(
        getattr(args, "manager_qa_profile", None) or DEFAULT_MANAGER_QA_PROFILE
    )
    worker_agent_provider = normalize_agent_provider(getattr(args, "worker_agent_provider", None))
    worker_agent_model = normalize_agent_model(getattr(args, "worker_agent_model", None))
    reviewer_agent_provider = normalize_agent_provider(getattr(args, "reviewer_agent_provider", None))
    reviewer_agent_model = normalize_agent_model(getattr(args, "reviewer_agent_model", None))
    gap_agent_provider = normalize_agent_provider(getattr(args, "gap_agent_provider", None))
    gap_agent_model = normalize_agent_model(getattr(args, "gap_agent_model", None))
    advisor_agent_provider = normalize_agent_provider(getattr(args, "advisor_agent_provider", None))
    advisor_agent_model = normalize_agent_model(getattr(args, "advisor_agent_model", None))
    advisor_enabled = normalize_bool(getattr(args, "advisor_enabled", DEFAULT_ADVISOR_ENABLED))
    advisor_mode = str(getattr(args, "advisor_mode", DEFAULT_ADVISOR_MODE) or DEFAULT_ADVISOR_MODE)
    if args.create_branch:
        if branch_exists(repo, integration):
            git(repo, ["switch", integration])
        else:
            git(repo, ["switch", "-c", integration, base])

    if args.force and loop_path(repo).exists():
        archived_loop = archive_existing_loop(repo)
    ensure_loop_dirs(repo)

    mission = loop_path(repo) / "MISSION.md"
    plan = loop_path(repo) / "PLAN.md"
    profile = loop_path(repo) / "PROFILE.md"
    decisions = loop_path(repo) / "DECISIONS.md"
    user_action = loop_path(repo) / "USER_ACTION_REQUIRED.md"
    journal_path = loop_path(repo) / "JOURNAL.md"
    if not mission.exists() or args.force:
        write_text(
            mission,
            f"""# Mission

## Goal
{args.goal}

## Context
TBD by Manager.

## Constraints
- Use Herdr-managed panes only when `HERDR_ENV=1`.
- Persist loop state in `{LOOP_DIR.as_posix()}`.
- Stop on blocking specification decisions.

## Non-goals
- Do not run unbounded autonomous loops.

## Done when
- All planned tasks are merged into `{integration}`.
- Required validation passes.
- No blocking plan/spec implementation gap remains.
- No blocking review finding remains.

## Base branch
{base}

## Integration branch
{integration}

## Validation levels
- L0: format / lint / typecheck
- L1: relevant unit tests
- L2: full build / full test
- L3: e2e or manual verification
""",
        )
    if not profile.exists() or args.force:
        lanes = args.review_lane or DEFAULT_REVIEW_LANES
        write_text(
            profile,
            f"""# Loop Profile

Manager-owned project profile for branch strategy, implementation protocol, review strategy, Worker QA, and final Manager QA.

## Loop Identity

- Namespace: `{LOOP_NAMESPACE}`
- Path: `{LOOP_DIR.as_posix()}`
- Persistence: `{args.persistence}`
- Config: `{str(config_candidate.path) if config_candidate else "built-in defaults"}`

Legacy `.ai/loop` state is ignored. `local-only` copies Manager artifacts into role worktrees and keeps them out of integration commits; `branch-history` requires committed Manager snapshots.

## Worktree Setup Commands
{chr(10).join(f"- `{item}`" for item in setup_commands) if setup_commands else "None configured."}

Execution outcomes accumulate in `{EXPERIENCE_DIR.as_posix()}/worktree-setup.json`.

## Branch Strategy
{args.branch_strategy}

- `integration`: hloop manages one integration branch plus one branch/worktree per Worker task.
- `pr-per-task`: Manager may keep Worker branches PR-oriented; use hloop artifacts as coordination gates and adapt merge/publish steps in PLAN.
- `custom`: product-specific branch rules in PLAN override default branch assumptions. Keep safety gates explicit.

## Worker Protocol
{args.worker_protocol}

- `native`: Workers follow the HLoop Worker Protocol embedded in their prompt.
- `codex-impl`: compatibility mode only; use when Manager intentionally wants the external skill's preflight/review/QA behavior.

## Review Protocol
{args.review_protocol}

- `native`: Reviewers use HLoop review lanes tuned for Manager gating, task artifacts, validation evidence, and product risk.
- `codex-review-multi-v2`: compatibility mode only; still require HLoop artifact shape and Fix Task Candidates.

## Review Lanes
{chr(10).join(f"- {item}" for item in lanes)}

## Agent Backends

- Worker default: provider `{worker_agent_provider}`, model `{worker_agent_model}`
- Reviewer default: provider `{reviewer_agent_provider}`, model `{reviewer_agent_model}`
- Gap Auditor default: provider `{gap_agent_provider}`, model `{gap_agent_model}`
- Advisor default: provider `{advisor_agent_provider}`, model `{advisor_agent_model}`

Codex is the default fallback provider for every role. Use role-specific provider/model settings when the Manager intentionally wants Claude, Codex, or a mixed model review strategy. Manager is always the agent currently using this skill; hloop only spawns subordinate role agents.

Advisor is opt-in only. It must not run from pump/tick unless Manager explicitly starts an advice request.

Advisor enabled: `{str(advisor_enabled).lower()}`
Advisor mode: `{advisor_mode}`

## Specification Scout
{args.specification_scout}

- `auto`: run once before implementation dispatch when requirements or tasks expose specification risk.
- `always`: run once before the first implementation dispatch.
- `off`: skip automatic Scout dispatch, while finish still checks unresolved decisions.

## Worktree Root
{str(worktree_root) if worktree_root else "default sibling paths"}

When configured, all Worker, Reviewer, Gap Auditor, and Advisor worktrees are created below this directory.

## Worker QA Profile
{worker_qa_profile}

- `repo-default`: choose repository-native checks from scripts, CI, docs, or existing QA artifacts.
- `local`: run local app/API/browser checks when the touched workflow is runnable.
- `staging`: use staging only when credentials and URLs are already available.
- `preview`: use PR/preview only when a URL is already available or discoverable from repo tooling.
- `custom`: follow the QA section in PLAN exactly.
- `none`: record the reason QA is intentionally skipped.

## Manager Final QA Profile
{manager_qa_profile}

- `none`: no separate Manager final QA gate.
- `repo-default`: Manager records final repository-appropriate evidence after integration/review/gap gates pass.
- `local`: Manager records final local app/API/browser evidence after the combined implementation is assembled.
- `staging`: Manager records staging URL, data setup, cleanup, screenshots/logs, and blockers before final completion.
- `preview`: Manager records PR/preview URL evidence before final completion.
- `custom`: Manager follows the final QA section in PLAN exactly.
""",
        )
    if not plan.exists() or args.force:
        write_text(
            plan,
            f"""# Plan

## Strategy
TBD by Manager.

## Branch strategy
Follow `{LOOP_DIR.as_posix()}/PROFILE.md`. If the product needs PR-per-task, release-branch, or custom flow, record the exact merge/publish handoff here before dispatching Workers.

## Task graph
- Add tasks with `hloop task new`.

## Parallelization rules
- Run Workers in parallel only when their `write_allow` patterns do not overlap.

## Validation plan
- Run task-specific validation before merge.
- Run integration validation after each merge.

## Worker QA plan
- Workers follow `{LOOP_DIR.as_posix()}/PROFILE.md` Worker QA profile unless a task overrides it.
- Worker QA evidence belongs in each task result artifact.

## Manager final QA plan
- Manager follows `{LOOP_DIR.as_posix()}/PROFILE.md` Manager Final QA profile after the combined implementation is ready.
- Manager final QA evidence belongs in `{LOOP_DIR.as_posix()}/qa/FINAL.md` and the final report.
- If Manager final QA is staging or preview, record URL, environment, data setup, cleanup, screenshots/logs, and blockers.

## Review plan
- Keep up to 3 Workers running when write scopes do not overlap.
- Run Reviewer frequently after validated integration advances.
- Run Gap Auditor less frequently against original plan/spec sources, and always before final completion when configured.
""",
        )
    if not decisions.exists():
        write_text(
            decisions,
            """# Decisions

Manager-owned record for specification choices that cannot be answered from the original plan/spec alone.

## Pending Decisions

None.

## Accepted Decisions

None.

## Rejected Decisions

None.
""",
        )
    if not user_action.exists():
        write_text(user_action, "# User Action Required\n\nNo blocking user action.\n")
    if not journal_path.exists():
        write_text(journal_path, "# Journal\n")
    state = {
        "state_format_version": STATE_FORMAT_VERSION,
        "schema_revision": STATE_SCHEMA_REVISION,
        "goal_id": goal_id,
        "run_id": run_id,
        "skill_version": SKILL_VERSION,
        "namespace": LOOP_NAMESPACE,
        "loop_path": LOOP_DIR.as_posix(),
        "persistence": args.persistence,
        "config_source": {
            "kind": config_candidate.source if config_candidate else "built-in-default",
            "path": str(config_candidate.path) if config_candidate else "",
        },
        "resolved_config": config_resolution.as_dict(),
        "worktree_setup_commands": worker_setup_commands,
        "worker_setup_commands": worker_setup_commands,
        "reviewer_setup_commands": reviewer_setup_commands,
        "gap_setup_commands": gap_setup_commands,
        "advisor_setup_commands": advisor_setup_commands,
        "min_free_bytes": args.min_free_bytes,
        "min_free_inodes": args.min_free_inodes,
        "phase": "initialized",
        "base_branch": base,
        "integration_branch": integration,
        "worktree_root": str(worktree_root) if worktree_root else "",
        "merge_mode": args.merge_mode,
        "branch_strategy": args.branch_strategy,
        "worker_qa_profile": worker_qa_profile,
        "manager_qa_profile": manager_qa_profile,
        "manager_qa_status": "not-required" if manager_qa_profile == "none" else "pending",
        "manager_qa_evidence_path": (LOOP_DIR / "qa" / "FINAL.md").as_posix(),
        "worker_protocol": args.worker_protocol,
        "review_protocol": args.review_protocol,
        "worker_agent_provider": worker_agent_provider,
        "worker_agent_model": worker_agent_model,
        "worker_agent_effort": args.worker_agent_effort,
        "worker_claude_permission_mode": args.worker_claude_permission_mode,
        "reviewer_agent_provider": reviewer_agent_provider,
        "reviewer_agent_model": reviewer_agent_model,
        "reviewer_agent_effort": args.reviewer_agent_effort,
        "reviewer_claude_permission_mode": args.reviewer_claude_permission_mode,
        "gap_agent_provider": gap_agent_provider,
        "gap_agent_model": gap_agent_model,
        "gap_agent_effort": args.gap_agent_effort,
        "gap_claude_permission_mode": args.gap_claude_permission_mode,
