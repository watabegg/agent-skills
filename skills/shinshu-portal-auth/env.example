# Copy to ~/.config/shinshu-portal-auth/env and run:
# chmod 600 ~/.config/shinshu-portal-auth/env

ACSU_LOGIN_ID=your_acsu_login_id
ACSU_LOGIN_PASSWORD=your_acsu_password
ACSU_LOGIN_MULTIFACTOR=your_wisepoint_image_password

# Optional. If omitted, the script derives:
# ${ACSU_LOGIN_ID}@shinshu-u.ac.jp
SHINSHU_MICROSOFT_UPN=your_acsu_login_id@shinshu-u.ac.jp
